# Changes made on the site, not through the Nightscout API, reach the socket too:
# the site's stores publish each change on the site model events, which the socket follows

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME use_mgdl
POST http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"units": "mg/dL"}
ASSERT_STATUS 200

NAME connect
CONNECT http://{{ .ns_site }}/socket.io/?EIO=3

NAME authorize
EMIT authorize
B {"client":"web","secret":"{{ token }}"}
ACK
ASSERT_EQUALS true "@read"

NAME first_data
WAIT dataUpdate
ASSERT_LENGTH 0 "@sgvs"

NAME create_reading
POST http://{{ site }}/data/glucose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"reading": 140, "reading_type": "sgv", "direction": "Flat"}
ASSERT_STATUS 201
SET reading_id {{ .create_reading.result.id }}

NAME reading_created
WAIT dataUpdate
ASSERT_EQUALS true "@delta"
ASSERT_EQUALS ".reading_id" "@sgvs.0._id"
ASSERT_EQUALS 140 "@sgvs.0.mgdl"

NAME update_reading
POST http://{{ site }}/data/glucose/{{ .reading_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"reading": 150}
ASSERT_STATUS 200

NAME reading_updated
WAIT dataUpdate
ASSERT_EQUALS 150 "@sgvs.0.mgdl"

# As in Nightscout, a removed entry is not sent
NAME delete_reading
DELETE http://{{ site }}/data/glucose/{{ .reading_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME reading_removal_not_sent
COLLECT dataUpdate
T 500ms
ASSERT_LENGTH 0 "@"

# A treatment deleted on the site, as an event group, is sent as removed
NAME post_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Correction Bolus", "insulin": 1.5 }
ASSERT_STATUS 200
SET treatment_id {{ dig "post_treatment.0._id" }}

NAME treatment_added
WAIT dataUpdate
ASSERT_EQUALS ".treatment_id" "@treatments.0._id"

NAME delete_event_group
DELETE http://{{ site }}/data/event-groups/{{ .treatment_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME treatment_removed
WAIT dataUpdate
ASSERT_EQUALS "remove" "@treatments.0.action"
ASSERT_EQUALS ".treatment_id" "@treatments.0._id"
