# xDrip+ sends a blood test only as a meter reading (mbg). As on Nightscout, the /storage socket gives it only to the
# entries, never to the treatments, so AAPS gets no BG Check for it. See docs/clients/aaps.md

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME connect
CONNECT http://{{ site }}/socket.io/?EIO=4
NS /storage
T 5s

NAME subscribe
EMIT subscribe
B {"accessToken":"{{ token }}","collections":["treatments","entries"]}
ACK
ASSERT_EQUALS true "@success"

NAME xdrip_finger_stick
POST http://{{ site }}/api/v1/entries?token={{ token }}
B [{"type":"mbg","mbg":118,"device":"Manual Entry","date":{{ itime 5 }}}]
ASSERT_STATUS 200

NAME entry_created
WAIT create
T 5s
ASSERT_EQUALS "entries" "@colName"
ASSERT_EQUALS "mbg" "@doc.type"
ASSERT_EQUALS 118 "@doc.mbg"

NAME no_bg_check
COLLECT create
T 1s
ASSERT_LENGTH 0 "@"

NAME disconnect
DISCONNECT
