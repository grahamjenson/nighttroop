# A reading sent again with dbAdd, at the date and type of a stored one, by another identity and device, is the same
# reading with the fields sent set over it, as a v1 upload is: AAPS's NSClient uploads readings with dbAdd

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost
SET reading_ms {{ itime 5 }}

NAME login_admin
POST http://{{ site }}/login
H Accept: application/json
B {"name": "admin", "password": "{{ .create_new_site.api_key }}", "totp": "123123"}
ASSERT_STATUS 200
SET jwt {{ .login_admin.token }}

NAME create_second_phone
POST http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "second_phone", "role": "device_pwd_phone"}
ASSERT_STATUS 201
SET phone_token {{ .create_second_phone.result.ns_token }}

NAME xdrip_uploads
POST http://{{ .ns_site }}/api/v1/entries?token={{ token }}
B [{"device": "xDrip-DexcomG6", "type": "sgv", "sgv": 150, "date": {{ .reading_ms }}, "direction": "Flat"}]
ASSERT_STATUS 200
SET reading_id {{ dig "xdrip_uploads.0._id" }}

NAME connect
CONNECT http://{{ .ns_site }}/socket.io/?EIO=3

NAME authorize
EMIT authorize
B {"client":"pump","secret":"{{ .phone_token }}"}
ACK
ASSERT_EQUALS true "@write"

NAME first_data
WAIT dataUpdate

NAME aaps_adds_copy
EMIT dbAdd
B {"collection":"entries","data":{"device":"AAPS-Dexcom","type":"sgv","sgv":152,"direction":"FortyFiveUp","date":{{ .reading_ms }}}}
ACK
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS ".reading_id" "@0._id"
ASSERT_EQUALS 152 "@0.sgv"

NAME copy_sent_on
WAIT dataUpdate
ASSERT_EQUALS 152 "@sgvs.0.mgdl"

NAME one_reading
GET http://{{ .ns_site }}/api/v1/entries/sgv.json?count=10&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS ".reading_id" "@0._id"
ASSERT_EQUALS 152 "@0.sgv"
ASSERT_EQUALS "FortyFiveUp" "@0.direction"
ASSERT_EQUALS "AAPS-Dexcom" "@0.device"

NAME disconnect
DISCONNECT
