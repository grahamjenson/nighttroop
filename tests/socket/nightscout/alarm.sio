# AAPS and the Nightscout web app subscribe to API v3's /alarm namespace for alarms, AAPS with its access token
# and the web app with its API secret or JWT, which it may not have yet

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET read_token {{ .create_new_site.read_only_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME connect_web
CONNECT http://{{ site }}/socket.io/?EIO=4
NS /alarm
T 5s

# The web app before anyone signs in, which may read nothing
NAME no_credentials
EMIT subscribe
B {"secret":null}
ACK
ASSERT_EQUALS true "@success"
ASSERT_EQUALS false "@read"

NAME bad_secret
EMIT subscribe
B {"secret":"nope-0123456789abcdef"}
ACK
ASSERT_EQUALS false "@success"
ASSERT_EQUALS "Missing or bad accessToken" "@message"

NAME good_secret
EMIT subscribe
B {"secret":"{{ token }}"}
ACK
ASSERT_EQUALS true "@success"
ASSERT_EQUALS "Subscribed for alarms" "@message"
ASSERT_EQUALS true "@read"

NAME bye_web
DISCONNECT

# AAPS's NSClient v3 is a Socket.IO v2 client in some versions, with an access token
NAME connect_native
CONNECT http://{{ site }}/socket.io/?EIO=3
NS /alarm
T 5s

NAME bad_access_token
EMIT subscribe
B {"accessToken":"nope-0123456789abcdef"}
ACK
ASSERT_EQUALS false "@success"

NAME access_token
EMIT subscribe
B {"accessToken":"{{ token }}"}
ACK
ASSERT_EQUALS true "@success"
ASSERT_EQUALS "Subscribed for alarms" "@message"

NAME bye_native
DISCONNECT

# A socket gets its own identity's alarms: the PWD phone turns on its urgent low, and a reading under it starts
NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME urgent_low_on
PATCH http://{{ site }}/api/v3/settings/alarm_urgent_low_enabled
H Authorization: Bearer {{ jwt }}
B { "value": true }
ASSERT_STATUS 200

NAME connect_alarms
CONNECT http://{{ site }}/socket.io/?EIO=4
NS /alarm
T 5s

NAME subscribe_alarms
EMIT subscribe
B {"accessToken":"{{ token }}"}
ACK
ASSERT_EQUALS true "@success"

NAME post_low
POST http://{{ site }}/api/v1/entries?token={{ token }}
B [{"type":"sgv","sgv":50,"date":{{ itime 0 }}}]
ASSERT_STATUS 200

RUN_BACKGROUND_JOBS

NAME urgent_alarm
WAIT urgent_alarm
T 5s
ASSERT_EQUALS 2 "@level"
ASSERT_EQUALS "Urgent LOW" "@title"
ASSERT_EQUALS "default" "@group"

# An ack, as Nightscout's of a level, group and silence time, snoozes it, which clears it
NAME ack
EMIT ack
ARGS [2, "default", 1800000]

RUN_BACKGROUND_JOBS

NAME cleared
WAIT clear_alarm
T 5s
ASSERT_EQUALS true "@clear"

# The site's events say the ack snoozed the urgent alarms of the default group, which its admin can read
NAME login_admin
POST http://{{ .create_new_site.site_subdomain }}.localhost/login
H Accept: application/json
B {"name": "admin", "password": "{{ .create_new_site.api_key }}", "totp": "123123"}
ASSERT_STATUS 200
SET admin_jwt {{ .login_admin.token }}

NAME ack_snoozed_event
GET http://{{ .create_new_site.site_subdomain }}.localhost/logs/events?type=alarm_snoozed
H Authorization: Bearer {{ .admin_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "nightscout" "@result.0.attributes.by"
ASSERT_EQUALS "urgent_low" "@result.0.attributes.types.0"

NAME bye_alarms
DISCONNECT

# Another identity's socket gets none of the PWD phone's alarms, such as the clear of turning it off
NAME connect_read_only
CONNECT http://{{ site }}/socket.io/?EIO=4
NS /alarm
T 5s

NAME subscribe_read_only
EMIT subscribe
B {"accessToken":"{{ read_token }}"}
ACK
ASSERT_EQUALS true "@success"

NAME urgent_low_off
PATCH http://{{ site }}/api/v3/settings/alarm_urgent_low_enabled
H Authorization: Bearer {{ jwt }}
B { "value": false }
ASSERT_STATUS 200

RUN_BACKGROUND_JOBS

NAME read_only_gets_nothing
COLLECT clear_alarm
T 500ms
ASSERT_LENGTH 0 "@"

NAME bye_read_only
DISCONNECT
