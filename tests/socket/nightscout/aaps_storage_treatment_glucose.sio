# A treatment's glucose is the treatment's, as on Nightscout: the /storage socket gives AAPS a Carb Correction with its
# glucose as a treatment only, never as an entry, also when the site changes the glucose, and a client's first
# dataUpdate has no sgv or mbg of it. See docs/clients/aaps.md

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost
SET site_url {{ .create_new_site.site_subdomain }}.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME connect
CONNECT http://{{ site }}/socket.io/?EIO=4
NS /storage
T 5s

NAME subscribe
EMIT subscribe
B {"accessToken":"{{ token }}","collections":["treatments","entries"]}
ACK
ASSERT_EQUALS true "@success"

NAME carb_correction
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B [{"eventType":"Carb Correction","carbs":5,"glucose":255,"units":"mg/dl","created_at":"{{ time 5 }}"}]
ASSERT_STATUS 200

NAME treatment_created
WAIT create
T 5s
ASSERT_EQUALS "treatments" "@colName"
ASSERT_EQUALS 255 "@doc.glucose"

NAME no_entry
COLLECT create
T 1s
ASSERT_LENGTH 0 "@"

NAME site_reading
GET http://{{ .site_url }}/data/glucose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
SET reading_id {{ dig "site_reading.result.items.0.id" }}

NAME site_changes_reading
POST http://{{ .site_url }}/data/glucose/{{ .reading_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "Rechecked"}
ASSERT_STATUS 200

NAME no_entry_update
COLLECT update
T 1s
ASSERT_LENGTH 0 "@"

NAME disconnect
DISCONNECT

NAME connect_main
CONNECT http://{{ site }}/socket.io/?EIO=4
T 5s

NAME authorize
EMIT authorize
B {"client":"web","history":1,"secret":"{{ token }}"}

NAME first_data
WAIT dataUpdate
T 5s
ASSERT_LENGTH 1 "@treatments"
ASSERT_LENGTH 0 "@sgvs"
ASSERT_LENGTH 0 "@mbgs"

NAME disconnect_main
DISCONNECT
