// On a server that sends email, a control admin sends a site with a verified email one of the pre-built emails
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo

// Site Emails, in the menu, lists the sites with a verified email, and never the address
CLICK #control--menu
CLICK #control--site-emails-button
ASSERT_STATUS 200
ASSERT_PATH /site-emails
ASSERT_TITLE Site Emails · Nighttroop Control
ASSERT_NOT_VISIBLE #control--site-emails--off
ASSERT_VISIBLE #control--site-email--emailsit >> text=emailsit
ASSERT_NOT_VISIBLE #control--site-emails >> text=sam@example.com

// The emails are a list to pick from, with no text to write
ASSERT_NOT_VISIBLE #control--site-emails textarea
SCREENSHOT site_emails

// It asks first, then sends the email picked
INPUT #control--site-email--emailsit--email storage
CLICK_ASKS #control--site-email--emailsit--send
CLICK #confirm--ok
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE The email was sent.

// A site is sent one email a day
CLICK_ASKS #control--site-email--emailsit--send
CLICK #confirm--ok
ASSERT_TEXT_VISIBLE Too Many Requests

// The site's events say an email was sent to it
GOTO {{ .control_url }}/events
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Site emailed
