GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #name admin
INPUT #password password
INPUT #control--login--otp-1 123123
CLICK #control--login-button
ASSERT_VISIBLE #control--nav--logo

// An admin can create a site at an ID they pick, such as a vanity one for a special user
ASSERT_PATH /
ASSERT_VISIBLE #control--sites--create--id
SCREENSHOT create_site_form

// The form only takes 8 lowercase letters, so the browser does not send anything else
INPUT #control--sites--create--id Vanity1
CLICK #control--sites--create--submit
ASSERT_VISIBLE #control--sites--create--id:invalid
ASSERT_NOT_VISIBLE #control--site--created

// A good ID creates the site, and its credentials are shown, once
INPUT #control--sites--create--id vanitybd
CLICK #control--sites--create--submit
ASSERT_STATUS 201
ASSERT_VISIBLE #control--site--created
ASSERT_TEXT_VISIBLE Save your credentials somewhere safe
ASSERT_TEXT_VISIBLE vanitybd.localhost
SCREENSHOT create_site_created

// The same ID again is refused, as it is taken
CLICK #control--site--created--close
ASSERT_NOT_VISIBLE #control--site--created
CLICK #control--sites--create--submit
ASSERT_STATUS 409
ASSERT_VISIBLE #toaster [data-tui-toast][data-variant="error"]:has-text("that site ID is taken")
