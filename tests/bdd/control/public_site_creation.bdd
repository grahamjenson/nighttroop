GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo

// The public can create sites from the home page until an admin turns it off
ASSERT_PATH /
ASSERT_TEXT_VISIBLE The public can create sites from the home page.
CLICK #control--sites--public-creation--toggle
ASSERT_STATUS 200
ASSERT_VISIBLE #toaster [data-tui-toast]:has-text("Public site creation turned off")
ASSERT_TEXT_VISIBLE Public site creation is off
SCREENSHOT public_creation_off

// The home page then says so, with no button to create a site
GOTO {{ server_url }}/
ASSERT_STATUS 200
ASSERT_VISIBLE #public--create-site-off
ASSERT_NOT_VISIBLE #public--create-site-button
SCREENSHOT home_creation_off

// An admin can still create a site
GOTO {{ .control_url }}/
INPUT #control--sites--create--id nopublic
CLICK #control--sites--create--submit
ASSERT_STATUS 201
ASSERT_VISIBLE #control--site--created
CLICK #control--site--created--close

// Turned back on, the home page creates sites again
CLICK #control--sites--public-creation--toggle
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE The public can create sites from the home page.
GOTO {{ server_url }}/
ASSERT_VISIBLE #public--create-site-button
CLICK #public--create-site-button
ASSERT_STATUS 200
ASSERT_VISIBLE #public--site-info--totp
