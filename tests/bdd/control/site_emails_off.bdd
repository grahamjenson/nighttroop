// A server that sends no email says so on Site Emails, and has nothing to send
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo
GOTO {{ .control_url }}/site-emails
ASSERT_STATUS 200
ASSERT_VISIBLE #control--site-emails--off >> text=This server sends no email.
ASSERT_VISIBLE #control--site-emails--none >> text=No site has a verified email.
ASSERT_NOT_VISIBLE #control--site-emails button
SCREENSHOT site_emails_off
