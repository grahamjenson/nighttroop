// A server that sends no email says so on a site's page, and has nothing to send
INCLUDE steps/new_site_admin.steps
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo
GOTO {{ .control_url }}/sites/{{ .create_new_site.site_subdomain }}
ASSERT_STATUS 200
ASSERT_VISIBLE #control--site--action-email >> text=This server sends no email.
ASSERT_NOT_VISIBLE #control--site--email-send
SCREENSHOT site_email_off
