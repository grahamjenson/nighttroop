// Signing in spends the login limiters, so the page has some kept
GOTO {{ .control_url }}/login
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #controlSitesTable

// The control site shows the rate limits in groups of what they protect, each with a line that says what that is
CLICK #control--menu
CLICK #control--rate-limits-button
ASSERT_STATUS 200
ASSERT_PATH /rate-limits
ASSERT_VISIBLE #control--rate-limits--group--server h2 >> text=Server
ASSERT_VISIBLE #control--rate-limits--group--server >> text=Every request to the server
ASSERT_VISIBLE #control--rate-limits--group--sign_in h2 >> text=Sign in
ASSERT_VISIBLE #control--rate-limits--group--site_create h2 >> text=Site creation
ASSERT_VISIBLE #control--rate-limits--group--site_data h2 >> text=Site reads and writes
ASSERT_VISIBLE #control--rate-limits--group--site_actions h2 >> text=Site actions
ASSERT_VISIBLE #control--rate-limits--group--connectors h2 >> text=Connectors
ASSERT_VISIBLE #control--rate-limits--group--connectors #control--rate-settings--connector_sync >> text=CONNECTOR_SYNC_PER_MINUTE_LIMIT/_BURST
// Every limit is in a group, and so is every kind of rate limiter
ASSERT_COUNT #control--rate-settings [id$="--per_minute"] 17
ASSERT_COUNT #control--rate-settings [id$="--bar"] 20
ASSERT_VISIBLE #control--rate-limits--group--site_actions #control--rate-settings--site_backfill >> text=SITE_BACKFILL_PER_MINUTE_LIMIT/_BURST

// Under each limit are the rate limiters that use it, what one is kept for, and how many times its rate they have
ASSERT_VISIBLE #control--rate-limits--group--server #control--rate-settings--global + #control--rate-limits--global + #control--rate-limits--control
ASSERT_VISIBLE #control--rate-limits--global >> text=Every request
ASSERT_VISIBLE #control--rate-limits--control >> text=signed out
ASSERT_VISIBLE #control--rate-limits--group--site_data #control--rate-settings--site_get + #control--rate-limits--site_get + #control--rate-limits--identity_get
ASSERT_VISIBLE #control--rate-limits--site_get >> text=Site, 4× the limit
ASSERT_VISIBLE #control--rate-limits--identity_get td:nth-child(2):text-is("Identity")
ASSERT_VISIBLE #control--rate-limits--group--sign_in #control--rate-limits--login_name >> text=Sign ins to a name
ASSERT_VISIBLE #control--rate-limits--group--sign_in #control--rate-limits--login_ip >> text=Sign ins from an IP
ASSERT_VISIBLE #control--rate-limits--group--site_actions #control--rate-limits--site_download
// Each rate limiter's bar is how much of its burst the most used one has spent
ASSERT_DRAWN #control--rate-limits--login_ip--bar
ASSERT_DRAWN #control--rate-limits--login_name--bar
// A name's logins from every IP have their own rate, far above an IP's, so one IP cannot lock others out
ASSERT_VISIBLE #control--rate-settings--login_name >> text=SITE_LOGIN_NAME_PER_MINUTE_LIMIT/_BURST
ASSERT_VISIBLE #control--rate-settings--login_name >> text=Sign ins to a name, from every IP
// A site flagged for abuse has its own far lower writes limit
ASSERT_VISIBLE #control--rate-limits--site_post_flagged >> text=A site's writes, flagged for abuse
ASSERT_VISIBLE #control--rate-settings--site_post_flagged >> text=SITE_POST_FLAGGED_PER_MINUTE_LIMIT/_BURST
// A limit not set here shows its env default as it is
ASSERT_VISIBLE #control--rate-settings--site_push--default:not(.line-through) >> text=Env default: 10 / min, burst 30
ASSERT_NOT_VISIBLE #control--rate-settings--site_push--set
SCREENSHOT rate_limits

// An admin sets a rate limit in place of its env variable's, and every limiter of its kind uses it at once
ASSERT_VISIBLE #control--rate-settings--site_push >> text=SITE_PUSH_PER_MINUTE_LIMIT/_BURST
INPUT #control--rate-settings--site_push--per_minute 20
INPUT #control--rate-settings--site_push--burst 40
CLICK #control--rate-settings--save
ASSERT_TEXT_VISIBLE Rate limits saved
// Its toast is a success toast like every page's, with a bar of the time it has left
ASSERT_COUNT #toaster [data-tui-toast][data-variant="success"]:has-text("Rate limits saved") .toast-progress 1
// It stands out: it says "set here", and its env default is struck through
ASSERT_VISIBLE #control--rate-settings--site_push--set >> text=set here
ASSERT_VISIBLE #control--rate-settings--site_push--default.line-through >> text=Env default: 10 / min, burst 30
ASSERT_VISIBLE #control--rate-limits--site_push td:nth-child(4):has-text("40")
SCREENSHOT rate_limits_set

// The rate limiters are read again every 10 seconds, which leaves a rate being typed as it is
HOLD /rate-limits
INPUT #control--rate-settings--site_report_print--burst 7
WAIT_VISIBLE 15 #control--rate-limits--refresh.htmx-request ~ #control--rate-settings #control--rate-settings--save
RELEASE /rate-limits
ASSERT_VISIBLE #control--rate-limits--refresh:not(.htmx-request) ~ #control--rate-settings #control--rate-settings--save
ASSERT_TEXT_EQUALS #control--rate-settings--site_report_print--burst 7

// A rate that would refuse every request is refused
INPUT #control--rate-settings--site_push--burst 0
CLICK #control--rate-settings--save
ASSERT_TEXT_VISIBLE site_push needs a rate above 0

// Setting it back to its env default uses the env's again
INPUT #control--rate-settings--site_push--per_minute 10
INPUT #control--rate-settings--site_push--burst 30
INPUT #control--rate-settings--site_report_print--burst 10
CLICK #control--rate-settings--save
ASSERT_NOT_VISIBLE #control--rate-settings--site_push--set
ASSERT_VISIBLE #control--rate-settings--site_push--default:not(.line-through)

// On a phone the page is no wider than the window: each group's table scrolls sideways in its card. The window is
// tall enough for all of it, so fitting it checks only its width.
WINDOW 390x4000
GOTO {{ .control_url }}/rate-limits
ASSERT_STATUS 200
ASSERT_VISIBLE #control--rate-limits--group--site_actions h2 >> text=Site actions
// The table can be wider than its card, which scrolls it, so its first cell is checked
ASSERT_VISIBLE #control--rate-settings--site_push td >> nth=0
ASSERT_FITS
SCREENSHOT rate_limits_phone
