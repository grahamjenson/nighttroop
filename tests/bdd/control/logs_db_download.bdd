GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #controlSitesTable

// The control admin's logs page has Download Logs DB, a link to a copy of the whole logs DB, as one SQLite file, to
// read the requests staging captured
CLICK #control--menu
CLICK #control--logs-button
ASSERT_PATH /logs
ASSERT_VISIBLE #controlLogsTable
ASSERT_VISIBLE #control--logs-db--download[href="/logs-db"][download]
ASSERT_TEXT_VISIBLE Download Logs DB
SCREENSHOT logs_db_download

// The events and errors pages, also from the logs DB, have it too
CLICK #control--menu
CLICK #control--events-button
ASSERT_PATH /events
ASSERT_VISIBLE #control--logs-db--download[href="/logs-db"][download]
CLICK #control--menu
CLICK #control--errors-button
ASSERT_PATH /errors
ASSERT_VISIBLE #control--logs-db--download[href="/logs-db"][download]
