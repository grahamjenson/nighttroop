// Tab goes from the name to the password, then to the code, skipping the button that shows the password
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
// Before signing in there is no header, as its menu is of pages that need a signed in admin
ASSERT_NOT_VISIBLE #control--nav--logo
ASSERT_NOT_VISIBLE #control--menu
// Password managers fill the name and password, never the code, which is one-time
ASSERT_VISIBLE #control--login--name[autocomplete="username"]
ASSERT_VISIBLE #control--login--password[autocomplete="current-password"]
ASSERT_VISIBLE #control--login--otp-1[autocomplete="one-time-code"]
CLICK #control--login--name
PRESS Tab
ASSERT_VISIBLE #control--login--password:focus
PRESS Tab
ASSERT_VISIBLE #control--login--otp-1:focus
SCREENSHOT login_tab_to_code

// The button still shows the password when clicked
INPUT #control--login--password password
CLICK #control--login--password ~ button
ASSERT_VISIBLE #control--login--password[type="text"]
