INCLUDE steps/new_site_admin.steps
ASSERT_PATH /
// A site with nothing to say has no banners
ASSERT_NOT_VISIBLE #site--banners

// A control admin writes a banner for this site
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo
GOTO {{ .control_url }}/banners
ASSERT_STATUS 200
INPUT #control--banners--add--message This site is archived in 7 days if it is not used.
INPUT #control--banners--add--sites {{ .create_new_site.site_subdomain }}
INPUT #control--banners--add--level warning
INPUT #control--banners--add--days 7
CLICK #control--banners--add--submit
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE The banner was added.

// The site's pages show it under the header, as a warning, on every page
GOTO {{ .site_url }}/
ASSERT_STATUS 200
ASSERT_VISIBLE #site--banners >> text=This site is archived in 7 days if it is not used.
ASSERT_VISIBLE #site--banners .text-amber-800
SCREENSHOT site_banner
GOTO {{ .site_url }}/settings/account
ASSERT_STATUS 200
ASSERT_VISIBLE #site--banners >> text=This site is archived in 7 days if it is not used.

// A warning cannot be hidden. A banner that is information can: the admin adds one
ASSERT_NOT_VISIBLE #site--banners button
GOTO {{ .control_url }}/banners
INPUT #control--banners--add--message Nighttroop has a new report this week.
INPUT #control--banners--add--sites {{ .create_new_site.site_subdomain }}
INPUT #control--banners--add--level info
INPUT #control--banners--add--days 7
CLICK #control--banners--add--submit
ASSERT_STATUS 201
GOTO {{ .site_url }}/
ASSERT_STATUS 200
ASSERT_VISIBLE #site--banners .text-blue-700 >> text=Nighttroop has a new report this week.
ASSERT_COUNT #site--banners button 1
SCREENSHOT site_banner_hide

// Hide takes it away, and it stays hidden on the next page. The warning stays.
CLICK #site--banners button >> text=Hide
ASSERT_NOT_VISIBLE #site--banners >> text=Nighttroop has a new report this week.
ASSERT_VISIBLE #site--banners >> text=This site is archived in 7 days if it is not used.
GOTO {{ .site_url }}/settings/account
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--banners >> text=Nighttroop has a new report this week.
ASSERT_VISIBLE #site--banners >> text=This site is archived in 7 days if it is not used.

// Deleted by the admin, the warning is gone from the site, and with every banner gone or hidden there is no strip
GOTO {{ .control_url }}/banners
CLICK_ASKS #control--banners--table tr:has-text("archived in 7 days") button
CLICK #confirm--ok
ASSERT_TEXT_VISIBLE The banner was deleted.
GOTO {{ .site_url }}/
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--banners
