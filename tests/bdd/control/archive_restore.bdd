// The control admin archives a site on a server with S3, and restores it from the archive kept here
GOTO {{ .control_url }}/login
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo

// A site no one has used is disabled first, as only a disabled site is archived
GOTO {{ .control_url }}/sites/archivme
CLICK #control--site--disable
ASSERT_TEXT_VISIBLE Site Disabled
ASSERT_TEXT_EQUALS #control--site--state Disabled

// Archiving keeps a compressed copy of its DB here and in S3, asking first (the test accepts)
ASSERT_VISIBLE #control--site--action-archive >> text=Keeps a compressed copy of its DB in the backup folder here and in S3, then deletes its DB. It needs S3.
CLICK #control--site--archive
ASSERT_TEXT_VISIBLE Site Archived
ASSERT_TEXT_EQUALS #control--site--state Archived

// The archived sites page lists it, with a button to restore it
GOTO {{ .control_url }}/archived-sites
ASSERT_VISIBLE #control--archived-site--archivme
ASSERT_VISIBLE #control--archived-site--archivme--hydrate
SCROLL -3000
SCREENSHOT archived

// Restoring it, asking first (the test accepts), brings it back live from its archive here
CLICK #control--archived-site--archivme--hydrate
ASSERT_TEXT_VISIBLE Site Restored: archivme is live again
GOTO {{ .control_url }}/sites/archivme
ASSERT_TEXT_EQUALS #control--site--state Live
ASSERT_VISIBLE #control--site--events--table td >> text=Site archived
ASSERT_VISIBLE #control--site--events--table td >> text=Site restored
SCROLL -3000
SCREENSHOT restored
