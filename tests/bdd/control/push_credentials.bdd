GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo

// A site to add a push credential to
INPUT #control--sites--create--id pushkeys
CLICK #control--sites--create--submit
ASSERT_VISIBLE #control--site--created
CLICK #control--site--created--close

// Push Credentials is every site's push credentials, and those for every site, never with their keys
CLICK #control--menu
ASSERT_VISIBLE #control--push-credentials-button
CLICK #control--push-credentials-button
ASSERT_STATUS 200
ASSERT_PATH /push-credentials
ASSERT_TEXT_VISIBLE A key is never shown again once added.
ASSERT_VISIBLE #control--push-credentials--table

// An admin adds an Apple push key to a site, as its admin would; one for every site cannot be added yet
CLICK #control--push-credential--add
ASSERT_VISIBLE #control--push-credential--create--modal
ASSERT_TEXT_VISIBLE One for every site cannot be added yet.
INPUT #control--push-credential--create--site-id pushkeys
INPUT #control--push-credential--create--name Control Loop
INPUT #control--push-credential--create--team-or-project-id TEAM123456
INPUT #control--push-credential--create--key-id ABC123DEFG
INPUT #control--push-credential--create--bundle-ids com.TEAM123456.loopkit.Loop
CLICK #control--push-credential--create--apps--loop
INPUT #control--push-credential--create--secret {{ "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgofoAD0qFTDB8eVl2\nLKYt19HfOaUvrvTYGMMR98DDoDihRANCAAROFNjYuI2rlnHoAy4UP4PVhQiFxz1L\nSaETlxByVnuzazzPdJ6qtAO+GOvUV5lPZn62Rv3vFb9ozLi/OFfob09a\n-----END PRIVATE KEY-----\n" }}
CLICK #control--push-credential--create--name
SCREENSHOT push_credential_add
CLICK #control--push-credential--create--submit
ASSERT_STATUS 201
ASSERT_NOT_VISIBLE #control--push-credential--create--modal
ASSERT_VISIBLE #control--push-credentials--table tr:has(td:text-is("Control Loop")) >> text="pushkeys"
ASSERT_VISIBLE #control--push-credentials--table tr:has(td:text-is("Control Loop")) >> text="Key ABC123DEFG"
SCREENSHOT push_credentials

// A site that is not live is refused, leaving the modal open to fix
CLICK #control--push-credential--add
INPUT #control--push-credential--create--site-id nosuchst
INPUT #control--push-credential--create--name Lost Loop
INPUT #control--push-credential--create--team-or-project-id TEAM123456
INPUT #control--push-credential--create--key-id ABC123DEFG
CLICK #control--push-credential--create--apps--loop
INPUT #control--push-credential--create--secret not a key
CLICK #control--push-credential--create--submit
ASSERT_TEXT_VISIBLE there is no live site with that ID
ASSERT_VISIBLE #control--push-credential--create--modal
CLICK #control--push-credential--create--modal--close
ASSERT_NOT_VISIBLE #control--push-credential--create--modal

// It is kept: the page shows it again, without its key
GOTO {{ .control_url }}/push-credentials
ASSERT_STATUS 200
ASSERT_VISIBLE #control--push-credentials--table >> text="Control Loop"
ASSERT_NOT_VISIBLE #control--push-credentials--table >> text="Lost Loop"

// Deleting asks first (the test accepts), then removes it
CLICK #control--push-credentials--table tbody tr:has(td:text-is("Control Loop")) >> button[title=Delete]
ASSERT_TEXT_VISIBLE Push Credential Deleted
ASSERT_NOT_VISIBLE #control--push-credentials--table >> text="Control Loop"
