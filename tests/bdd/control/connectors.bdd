// A new site with virtual connector, so there is a connector with reports to see
GOTO {{ server_url}}/
ASSERT_STATUS 200
CLICK "Create Site"
ASSERT_STATUS 200
// It opens the new site's own address, which shows its credentials
ASSERT_PATH /welcome
ASSERT_VISIBLE #public--copy-button
// Login is offered once a code from the authenticator app has been checked
INPUT #public--site-info--totp 123123
CLICK #public--totp-check-button
ASSERT_VISIBLE #public--totp-checked
CLICK #public--login-button
ASSERT_NEW_PAGE
INPUT #site--login--name admin
INPUT #site--login--password password
CLICK #site--login-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"
CLICK #site--nav--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated
// A Nightscout connector with details that do not work, so a source has failed
INPUT #site--settings--nightscout-connector--url         http://will_not_pass_the_test.test
INPUT #site--settings--nightscout-connector--password    not_a_token
// Typing a new source's details turns it on
CLICK #site--settings--nightscout-connector--url
ASSERT_VISIBLE #site--settings--nightscout-connector--enable:checked
CLICK #site--settings--nightscout-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS

GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #controlSitesTable

// The control site shows every site's connectors, most recently attempted first
CLICK #control--menu
CLICK #control--connectors-button
ASSERT_STATUS 200
ASSERT_PATH /connectors
ASSERT_VISIBLE #controlConnectorsTable
ASSERT_TEXT_VISIBLE the most recently failed first
ASSERT_TEXT_VISIBLE Showing 1 to
ASSERT_TEXT_VISIBLE virtual
// A source that has failed has its failed count in red
ASSERT_VISIBLE #controlConnectorsTable td:last-child span.text-red-700 >> nth=0
// The Nightscout source failed before it ever synced, so it was turned off, and says so in amber
ASSERT_VISIBLE #controlConnectorsTable tr:has-text("nightscout") span.text-amber-800:text-is("disabled after failing")
// Counts are whole numbers, never written like 1e+04
ASSERT_VISIBLE #controlConnectorsTable tr:has-text("nightscout") td:last-child span:text-matches("^[0-9]+$")
SCREENSHOT connectors

// Clicking a source shows its reports
CLICK #controlConnectorsTable tbody tr >> nth=0
ASSERT_VISIBLE #control--connector--details
ASSERT_TEXT_VISIBLE Successes In A Row
ASSERT_TEXT_VISIBLE Success EMA
// Counts and durations are whole numbers, and the averages have one decimal place
ASSERT_VISIBLE #control--connector--details dt:text-is("Total Syncs") + dd:text-matches("^[0-9]+$")
ASSERT_VISIBLE #control--connector--details dt:text-is("Total EMA") + dd:text-matches("^[0-9]+[.][0-9]$")
// The longest details still leave Close where it can be clicked
ASSERT_VISIBLE #control--connector--details--close
SCREENSHOT connector_details

CLICK #control--connector--details--close
ASSERT_NOT_VISIBLE #control--connector--details
