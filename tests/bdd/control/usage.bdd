// A site used by its admin, so the server has some activity to show
INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE #site--summary

GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #name admin
INPUT #password password
INPUT #control--login--otp-1 123123
CLICK #control--login-button
ASSERT_VISIBLE #control--nav--logo

// The usage page shows the active sites and users, the use since start, the server's resources and the most asked
// for routes, and asks for itself again every 10 seconds
CLICK #control--menu
CLICK #control--usage-button
ASSERT_PATH /usage
ASSERT_VISIBLE #control--usage[hx-trigger="every 10s"]
ASSERT_VISIBLE #control--usage--sites-day
ASSERT_NOT_VISIBLE #control--usage--sites-day >> text=/^0$/
ASSERT_VISIBLE #control--usage--users-week
// The site made above was created today, so this week and this month too
ASSERT_NOT_VISIBLE #control--usage--created-today >> text=/^0$/
ASSERT_NOT_VISIBLE #control--usage--created-week >> text=/^0$/
ASSERT_NOT_VISIBLE #control--usage--created-month >> text=/^0$/
ASSERT_VISIBLE #control--usage--requests-per-site
// The CPU is as htop shows it, 100% for each core, in the last 5 seconds
ASSERT_VISIBLE #control--usage--cpu >> text=/%$/
ASSERT_VISIBLE #control--usage--cpu + div >> text=/^of \d+00% for \d+ cores?, last 5 seconds$/
// The memory is all the OS counts for the server, with SQLite's, which is outside Go's heap
ASSERT_VISIBLE #control--usage--memory + div >> text=/in Go's heap, the rest mostly SQLite$/
// The DBs' size, and the space left on their disk
ASSERT_VISIBLE #control--usage--disk
// Once the resources are checked their graph has the same title, so the first is the tile
ASSERT_VISIBLE #control--usage >> text=/^DB disk used$/i >> nth=0
ASSERT_VISIBLE #control--usage--disk + div >> text=/free on disk$/
ASSERT_VISIBLE #control--usage--routes td >> text=/^site GET \/$/
// Only signed in requests are counted, so no static file, unmatched or public page is
ASSERT_NOT_VISIBLE #control--usage--routes td >> text=/static files|unmatched|^public /
SCREENSHOT usage
