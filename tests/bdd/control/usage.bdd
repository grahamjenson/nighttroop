// A site used by its admin, so the server has some activity to show
INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE #site--summary

GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo

// The usage page shows the active sites and users, the use since start, the server's resources and the most asked
// for routes, and asks for itself again every 10 seconds
CLICK #control--menu
CLICK #control--usage-button
ASSERT_PATH /usage
ASSERT_VISIBLE #control--usage[hx-trigger="every 10s"]
ASSERT_VISIBLE #control--usage--sites-day
ASSERT_NOT_VISIBLE #control--usage--sites-day >> text=/^0$/
ASSERT_VISIBLE #control--usage--users-week
// The site made above was created today, so this week and this month too
ASSERT_NOT_VISIBLE #control--usage--created-today >> text=/^0$/
ASSERT_NOT_VISIBLE #control--usage--created-week >> text=/^0$/
ASSERT_NOT_VISIBLE #control--usage--created-month >> text=/^0$/
ASSERT_VISIBLE #control--usage--requests-per-site
// The CPU is as htop shows it, 100% for each core, in the last 5 seconds
ASSERT_VISIBLE #control--usage--cpu >> text=/%$/
ASSERT_VISIBLE #control--usage--cpu + div >> text=/^of \d+00% for \d+ cores?, last 5 seconds$/
// The memory is all the OS counts for the server, with SQLite's, which is outside Go's heap
ASSERT_VISIBLE #control--usage--memory + div >> text=/in Go's heap, the rest mostly SQLite$/
// The DBs' size, and the space left on their disk
ASSERT_VISIBLE #control--usage--disk
ASSERT_VISIBLE #control--usage >> text=/^DB disk used$/i
// The server's uptime is beside the range toggles
ASSERT_VISIBLE #control--usage--uptime
ASSERT_VISIBLE #control--usage--disk + div >> text=/free on disk$/
ASSERT_VISIBLE #control--usage--routes td >> text=/^site GET \/$/
// Only signed in requests are counted, so no static file, unmatched or public page is
ASSERT_NOT_VISIBLE #control--usage--routes td >> text=/static files|unmatched|^public /
// The DB queries whose sampled runs took the longest in all, by their DB and name; which they are depends on what else
// the test server ran
ASSERT_VISIBLE #control--usage--queries
ASSERT_TEXT_VISIBLE Slowest queries
ASSERT_NOT_VISIBLE #control--usage--queries td >> text=No queries sampled yet.
ASSERT_VISIBLE #control--usage--queries td >> text=/^(site|control|jobs|logs|live)db\.\S/ >> nth=0
ASSERT_VISIBLE #control--usage--queries th >> text=/^p95 ms$/
SCREENSHOT usage

// The resources are checked every 30 seconds, from soon after the server starts: the CPU, memory, goroutines and DB
// disk, each in a graph under its figure now. Hovering a graph shows the check nearest the pointer, and how long ago it was.
RUN_BACKGROUND_JOBS
GOTO {{ .control_url }}/usage
ASSERT_VISIBLE #control--usage--resources-goroutines
ASSERT_VISIBLE #control--usage--resources-goroutines-latest >> text=/^\d+$/
// Each resource's figure now and its graph are in one block
ASSERT_VISIBLE #control--usage--cpu ~ div #control--usage--resources-cpu
ASSERT_VISIBLE #control--usage--memory ~ div #control--usage--resources-memory
ASSERT_VISIBLE #control--usage--goroutines ~ div #control--usage--resources-goroutines
ASSERT_VISIBLE #control--usage--disk ~ div #control--usage--resources-disk
ASSERT_NOT_VISIBLE #control--usage--resources-cpu-hover-59
HOVER #control--usage--resources-cpu-hover-59 >> xpath=..
ASSERT_VISIBLE #control--usage--resources-cpu-hover-59 >> text=/^\d+% · \d+m ago$/
SCREENSHOT usage_hover

// The resource graphs show the last hour, or the last day or 3 days picked with the toggles above them. The page's
// refresh keeps the range picked, and a range it does not know shows the last hour.
ASSERT_VISIBLE #control--usage--resources-range.segmented > #control--usage--resources-range-hour.bg-primary
CLICK #control--usage--resources-range-3days
ASSERT_VISIBLE #control--usage--resources-range-3days.bg-primary
ASSERT_NOT_VISIBLE #control--usage--resources-range-hour.bg-primary
ASSERT_VISIBLE #control--usage[hx-get="/usage?resources=3days"]
ASSERT_VISIBLE #control--usage--resources-goroutines
SCREENSHOT usage_3days
CLICK #control--usage--resources-range-day
ASSERT_VISIBLE #control--usage--resources-range-day.bg-primary
ASSERT_VISIBLE #control--usage[hx-get="/usage?resources=day"]
GOTO {{ .control_url }}/usage?resources=week
ASSERT_VISIBLE #control--usage--resources-range-hour.bg-primary

// Each of the server's own DBs shows its size, as a site's does, with no limit, and its largest tables with their
// records, size and share, as the resource check last measured them: the control DB, the logs with the events, the
// jobs, and the live DB, which is in memory, so measured by its tables
ASSERT_VISIBLE #control--usage--control--db-size >> text=/^\d+\.\d\d$/
ASSERT_NOT_VISIBLE #control--usage--control--db-limit
ASSERT_VISIBLE #control--usage--control--db-tables li >> nth=0 >> text=/[\d,]+ records? · \d+\.\d\d MB · \d+%$/
ASSERT_VISIBLE #control--usage--logs--db-tables
ASSERT_VISIBLE #control--usage--jobs--db-tables
ASSERT_VISIBLE #control--usage--live--db-size >> text=/^\d+\.\d\d$/
ASSERT_VISIBLE #control--usage--live >> text=/in memory$/
SCREENSHOT usage_server_dbs

// At its top, an admin's buttons open Go's profiles (pprof) and runtime stats (vars) in a new tab
ASSERT_VISIBLE #control--usage--pprof[href="/debug/pprof/"][target="_blank"]
ASSERT_VISIBLE #control--usage--vars[href="/debug/vars"][target="_blank"]
GOTO {{ .control_url }}/debug/pprof/
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE goroutine
GOTO {{ .control_url }}/debug/vars
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE memstats

// The header links the pages an admin opens most, each with its icon, one click away
GOTO {{ .control_url }}/
ASSERT_STATUS 200
ASSERT_DRAWN #control--nav--usage > svg
CLICK #control--nav--usage
ASSERT_PATH /usage
ASSERT_VISIBLE #control--usage--sites-day
CLICK #control--nav--jobs
ASSERT_PATH /jobs
CLICK #control--nav--events
ASSERT_PATH /events
CLICK #control--nav--errors
ASSERT_PATH /errors
CLICK #control--nav--sites
ASSERT_PATH /sites
SCREENSHOT header_links

// Scrolled down a long page, the header is still at the top of the window, with its links and menu working
CLICK #control--nav--usage
ASSERT_PATH /usage
ASSERT_VISIBLE #control--nav.sticky
SCROLL 600
ASSERT_VISIBLE #control--nav--sites
CLICK #control--menu
ASSERT_VISIBLE #control--jobs-button
PRESS Escape
// Back at the top for the screenshot, as a screenshot of a scrolled page draws the header where the window was
SCROLL -600
SCREENSHOT header

// The header marks the link of the page shown, as the pages open, and of a page under it, as a site is under Sites
CLICK #control--nav--usage
ASSERT_PATH /usage
ASSERT_VISIBLE #control--nav--usage[aria-current="page"]
ASSERT_COUNT #control--nav--links [aria-current="page"] 1
CLICK #control--nav--jobs
ASSERT_PATH /jobs
ASSERT_VISIBLE #control--nav--jobs[aria-current="page"]
ASSERT_COUNT #control--nav--links [aria-current="page"] 1
GOTO {{ .control_url }}/
ASSERT_STATUS 200
ASSERT_VISIBLE #control--nav--sites[aria-current="page"]
SCREENSHOT header_current
