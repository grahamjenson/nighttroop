// The control admin signs in to a server with two sites unavailable, as their DBs could not be opened or restored, so
// every control page names them, with why, each linked to its page
GOTO {{ .control_url }}/login
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo
ASSERT_VISIBLE #control--status-banner--unavailable
ASSERT_TEXT_VISIBLE Sites unavailable, as their DBs could not be opened or restored (2):
ASSERT_VISIBLE #control--status-banner--unavailable--amissing
ASSERT_VISIBLE #control--status-banner--unavailable >> text=/amissing\s*\(DB missing\)/
ASSERT_VISIBLE #control--status-banner--unavailable >> text=/brokensi\s*\(DB does not open\)/

// The sites list, the dashboard, marks each unavailable site
ASSERT_PATH /
ASSERT_VISIBLE #control--site--amissing--unavailable
ASSERT_VISIBLE #control--site--brokensi--unavailable
SCREENSHOT dashboard

// A site's name in the banner opens its page
CLICK #control--status-banner--unavailable--amissing
ASSERT_PATH /sites/amissing
ASSERT_VISIBLE #control--status-banner--unavailable
ASSERT_VISIBLE #control--site--unavailable
SCREENSHOT site_page

// Its page offers to make it a new, empty DB, as for a site created just before a crash, which has no backup. Making it
// asks first (the test accepts), then the site is served again: it is no longer unavailable, and its events say so.
ASSERT_VISIBLE #control--site--action-new-empty-db >> text=as for a site created just before a crash
CLICK #control--site--new-empty-db
ASSERT_TEXT_VISIBLE New Empty DB Made
ASSERT_NOT_VISIBLE #control--site--unavailable
ASSERT_VISIBLE #control--site--events--table td >> text=Site DB made empty
// The banner, on every page, names only the other site
GOTO {{ .control_url }}/sites/amissing
ASSERT_TEXT_VISIBLE Sites unavailable, as their DBs could not be opened or restored (1):
ASSERT_NOT_VISIBLE #control--status-banner--unavailable--amissing
SCREENSHOT new_empty_db
