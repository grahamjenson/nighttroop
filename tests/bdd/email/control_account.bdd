// On a server that sends email, a control admin gives an email of their own on Account
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo

CLICK #control--menu
CLICK #control--account-button
ASSERT_PATH /account
ASSERT_VISIBLE #site--account--email >> text=Your own email. You need none.
ASSERT_NOT_VISIBLE #site--account--email-current

// Saving an email sends it a link, and it is not verified until the link is opened
INPUT #site--account--email-input sam@example.com
CLICK #site--account--email-save
ASSERT_TEXT_VISIBLE A link was sent to the email.
ASSERT_VISIBLE #site--account--email-current >> text=sam@example.com
ASSERT_VISIBLE #site--account--email-not-verified >> text=Not verified
SCREENSHOT control_email_not_verified

// An admin is sent one link an hour
INPUT #site--account--email-input pat@example.com
CLICK #site--account--email-save
ASSERT_TEXT_VISIBLE Too Many Requests
ASSERT_VISIBLE #site--account--email-current >> text=sam@example.com

// The email stays after the page opens again, and the admin removes it
GOTO {{ .control_url }}/account
ASSERT_VISIBLE #site--account--email-current >> text=sam@example.com
CLICK_ASKS #site--account--email-remove
ASSERT_TEXT_VISIBLE Remove your email?
CLICK #confirm--ok
ASSERT_TEXT_VISIBLE The email was removed.
ASSERT_NOT_VISIBLE #site--account--email-current
