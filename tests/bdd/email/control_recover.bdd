// On a server that sends email, a control admin whose email is verified recovers a forgotten password by it
GOTO {{ .control_url }}/login
ASSERT_STATUS 200
CLICK #control--login--recover
ASSERT_PATH /login/recover
INPUT #control--recover--email sam@example.com
CLICK #control--recover--send
ASSERT_TEXT_VISIBLE If this is the verified email of an admin, a link was sent to it.
SCREENSHOT recover

// The link opens a page whose button gives the admin a new password, shown once, to sign in with again
GOTO {{ .resend_url }}/link
ASSERT_PATH /login/recover/password
ASSERT_TEXT_VISIBLE You still need the code from your authenticator app to sign in.
SCREENSHOT new_password
CLICK #control--recover--password
ASSERT_TEXT_EQUALS #site--identities--credentials--title Credentials for admin
ASSERT_VISIBLE #site--identities--signed-out
SCREENSHOT recovered
CLICK #site--identities--sign-in-again
ASSERT_PATH /login
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo
