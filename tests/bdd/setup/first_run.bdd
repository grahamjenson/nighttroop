// A new server has no control admin, so every page goes to the control site's setup page
GOTO {{ server_url }}/
ASSERT_PATH /setup
ASSERT_VISIBLE #control--setup--code
ASSERT_VISIBLE .setup-target h2:text-is("Set up Nighttroop")
// Its card is in the middle of a grey page filling the window above the footer, as the control login's is, with
// nothing to scroll
ASSERT_FITS
SCREENSHOT setup

// A wrong setup code is refused, in an error toast
INPUT #control--setup--code notthecode
CLICK #control--setup--submit
ASSERT_STATUS 401
ASSERT_VISIBLE #toaster [data-tui-toast][data-variant="error"]:has-text("That is not the setup code in the server's logs.")
SCREENSHOT wrong_code

// The code from the server's logs shows the control admin's login, with its TOTP secret's QR code
INPUT #control--setup--code {{ .setup_code }}
CLICK #control--setup--submit
ASSERT_STATUS 200
ASSERT_VISIBLE #control--setup--password
ASSERT_VISIBLE #control--setup--totp-secret
// Its QR code holds the otpauth:// URI an authenticator app adds the control admin from
ASSERT_VISIBLE #control--setup--qrcode[title^="otpauth://totp/Nighttroop:"][title*="@control."][title*="?issuer=Nighttroop&secret="]
ASSERT_TEXT_VISIBLE Scan with an authenticator app, such as
ASSERT_VISIBLE #control--setup--authenticator--google[target="_blank"]
SCREENSHOT credentials

// It is only saved with a code from that TOTP secret, so the login cannot be lost unsaved
INPUT #control--setup--otp-1 111111
CLICK #control--setup--confirm
ASSERT_STATUS 401
ASSERT_VISIBLE #toaster [data-tui-toast][data-variant="error"]:has-text("That code is not from the TOTP secret shown.")

// Entering the setup code again shows a new login to save, its code boxes empty. Tests' TOTP codes are always 123123
GOTO {{ .control_url }}/setup
INPUT #control--setup--code {{ .setup_code }}
CLICK #control--setup--submit
ASSERT_STATUS 200
INPUT #control--setup--otp-1 123123
CLICK #control--setup--confirm
ASSERT_STATUS 200
ASSERT_VISIBLE #control--setup--complete
ASSERT_VISIBLE #control--setup--complete h2:text-is("Nighttroop is set up")
SCREENSHOT complete

// The control admin logs in with it, and tests' passwords are always password
CLICK #control--setup--login
ASSERT_PATH /login
INPUT #control--login--name admin
INPUT #control--login--password password
TYPE #control--login--otp-1 123123
ASSERT_VISIBLE #control--nav--logo
ASSERT_VISIBLE .uppercase:text-is("Nighttroop Control")

// Setup is done, so its page is gone and the public site can be used
GOTO {{ .control_url }}/setup
ASSERT_STATUS 404
GOTO {{ server_url }}/
ASSERT_VISIBLE #public--create-site-button
