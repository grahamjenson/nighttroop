GOTO {{ server_url}}/
ASSERT_STATUS           200
ASSERT_VISIBLE          "Create Site"
ASSERT_TEXT_EQUALS      #create-site-button Create Site

CLICK "Create Site"
ASSERT_STATUS 200
SET token #token
SET site #subdomain

CLICK #login-button
ASSERT_NEW_PAGE
ASSERT_VISIBLE #name

INPUT #name admin
INPUT #password password

CLICK #login-button
ASSERT_STATUS 200

// Pretty JS input is annoying here
INPUT #otp-1 123123

CLICK #login-button
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"