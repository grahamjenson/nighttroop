GOTO "http://localhost/"
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200
ASSERT {{ assertVisible #copy-button }}
SET token "{{ dig "#token" }}"
SET site "{{ dig "#subdomain" }}"

CLICK "Login"
ASSERT_STATUS 200


INPUT #username admin
INPUT #password password

CLICK #submit
ASSERT_STATUS 200



INPUT #totp 123456

CLICK "Submit" 
ASSERT_STATUS 200
ASSERT_VISIBLE #profile

ASSERT {{ assertContains "#profile" }}
ASSERT {{ assertContains "#settings" }}
ASSERT {{ assertEquals #subdomain site }}