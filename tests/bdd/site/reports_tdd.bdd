INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The Reports hub has TDD, the total daily dose of the month to today, which a new site has no days with insulin for:
// its table still lists each of the 30 days, with no dose, today first and marked so far. Its arrows beside the dates go
// to the month before, and the month after is disabled, as it has not been
CLICK #site--nav--reports
CLICK #site--reports--tdd-menu-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /reports/tdd
ASSERT_TITLE TDD · Nighttroop
ASSERT_VISIBLE #site--reports--tdd--previous
ASSERT_DRAWN #site--reports--tdd--next[disabled]
ASSERT_VISIBLE #site--reports--tdd--empty
ASSERT_TEXT_EQUALS #site--reports--tdd--days 0
ASSERT_TEXT_EQUALS #site--reports--tdd--mean –
ASSERT_COUNT #site--reports--tdd--table tbody tr 30
// Each day's basal, boluses and total are dashes, as none had insulin
ASSERT_COUNT #site--reports--tdd--table tbody td:text-is("–") 90
ASSERT_VISIBLE #site--reports--tdd--table tbody tr >> nth=0 >> #site--reports--tdd--so-far >> text=so far
ASSERT_COUNT #site--reports--tdd--so-far 1

// The Reports hub opens on the summaries, whose tab marks it, and its TDD tab opens TDD again
CLICK #site--nav--reports
ASSERT_STATUS 200
ASSERT_PATH /reports
ASSERT_VISIBLE #site--reports--summaries-button[aria-current="page"]
CLICK #site--reports--tdd-menu-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /reports/tdd
ASSERT_VISIBLE #site--reports--tdd-menu-button[aria-current="page"]

// Virtual connector writes its last 30 minutes, then each backfill the day before its oldest reading (tests backfill a
// day), with doses and the basal in force, so three backfills fill the last three days
CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS

// A new timezone builds the last 7 days again, with the backfilled doses in them
GOTO /settings
ASSERT_STATUS 200
INPUT #site--settings--site--timezone Etc/UTC
CLICK #site--settings--site--save
ASSERT_TEXT_VISIBLE Settings Saved
RUN_BACKGROUND_JOBS

// The report draws a bar of each day of the month to today with insulin, a couple of pixels apart, with the mean,
// lowest and highest daily dose of the days before today, today left out as it is not over, and a table of each day's
// dose, newest first
GOTO /reports/tdd
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--reports--tdd--empty
ASSERT_DRAWN #site--reports--tdd--chart svg
ASSERT_DRAWN #site--reports--tdd--chart >> text=/^\d+ U$/ >> nth=-1
ASSERT_VISIBLE #site--reports--tdd--days >> text=/^[234]$/
ASSERT_VISIBLE #site--reports--tdd--mean >> text=/^\d+(\.\d+)? U$/
ASSERT_VISIBLE #site--reports--tdd--lowest >> text=/^\d+(\.\d+)? U$/
ASSERT_VISIBLE #site--reports--tdd--highest >> text=/^\d+(\.\d+)? U$/
ASSERT_COUNT #site--reports--tdd--table tbody tr 30
ASSERT_VISIBLE #site--reports--tdd--table tbody tr >> nth=0 >> td >> nth=-1 >> text=/^\d+(\.\d+)? U$/
// Each day's dose is split into its basal and boluses, in the table and as the bar's two parts, named in a legend
ASSERT_VISIBLE #site--reports--tdd--table thead >> text=Basal
ASSERT_VISIBLE #site--reports--tdd--table thead >> text=Bolus
ASSERT_COUNT #site--reports--tdd--table tbody tr >> nth=0 >> td >> text=/^\d+(\.\d+)? U$/ 3
ASSERT_COUNT #site--reports--tdd--table tbody tr >> nth=1 >> td >> text=/^\d+(\.\d+)? U$/ 3
ASSERT_DRAWN #site--reports--tdd--chart >> text=Basal
ASSERT_DRAWN #site--reports--tdd--chart >> text=Bolus
// Today, the first row, is marked so far, and its bar, paler, is labelled so far; the help says basal is estimated and
// today is left out of the numbers above
ASSERT_VISIBLE #site--reports--tdd--table tbody tr >> nth=0 >> #site--reports--tdd--so-far >> text=so far
ASSERT_COUNT #site--reports--tdd--so-far 1
ASSERT_DRAWN #site--reports--tdd--chart >> text=so far
ASSERT_VISIBLE #site--reports--tdd--help >> text=/Basal is estimated/
ASSERT_VISIBLE #site--reports--tdd--help >> text=/Today, paler and marked so far, is not over/
SCREENSHOT report_tdd

// The arrow before the dates goes to the month before, which the backfilled days are not in, and the one after back,
// back returning to the month before too
CLICK #site--reports--tdd--previous
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_COUNT #site--reports--tdd--table tbody tr 30
ASSERT_VISIBLE #site--reports--tdd--empty
ASSERT_VISIBLE #site--reports--tdd--next
// Today is not in it, so nothing is marked so far, and the help only says basal is estimated
ASSERT_NOT_VISIBLE #site--reports--tdd--so-far
ASSERT_NOT_VISIBLE #site--reports--tdd--help >> text=/Today/
SCREENSHOT report_tdd_previous
CLICK #site--reports--tdd--next
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /reports/tdd
ASSERT_NOT_VISIBLE #site--reports--tdd--empty
ASSERT_DRAWN #site--reports--tdd--next[disabled]
CLICK_BACK
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--tdd--empty

// A month ending after today, which has not been, or more than a year ago, which is not kept, is refused
GOTO /reports/tdd?end=2999-01-01
ASSERT_STATUS 400
GOTO /reports/tdd?end=2000-01-01
ASSERT_STATUS 400

// On a phone the report is no wider than the window, its buttons wrapping. The window is tall enough for the whole
// page, so fitting it checks only its width.
WINDOW 390x2400
GOTO /reports/tdd
ASSERT_STATUS 200
ASSERT_DRAWN #site--reports--tdd--chart svg
ASSERT_FITS
SCREENSHOT report_tdd_phone
