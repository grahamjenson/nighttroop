INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The Reports hub has TDD, the total daily dose of the week before today at first, which a new site has no past
// days for: its table still lists each of the 7 days, with no dose
CLICK #site--nav--reports
CLICK #site--reports--tdd-menu-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /reports/tdd
ASSERT_TITLE TDD · Nighttroop
ASSERT_VISIBLE #site--reports--tdd--range-week.bg-primary
ASSERT_VISIBLE #site--reports--tdd--empty
ASSERT_TEXT_EQUALS #site--reports--tdd--days 0
ASSERT_TEXT_EQUALS #site--reports--tdd--mean –
ASSERT_COUNT #site--reports--tdd--table tbody tr 7
ASSERT_COUNT #site--reports--tdd--table tbody td:text-is("–") 7

// The Reports hub opens on AGP, whose tab marks it, and its TDD tab opens TDD again
CLICK #site--nav--reports
ASSERT_STATUS 200
ASSERT_PATH /reports
ASSERT_VISIBLE #site--reports--agp-button[aria-current="page"]
CLICK #site--reports--tdd-menu-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /reports/tdd
ASSERT_VISIBLE #site--reports--tdd-menu-button[aria-current="page"]

// Virtual connector writes its last 30 minutes, then each backfill the day before its oldest reading (tests backfill a
// day), with doses and the basal in force, so three backfills fill the last three days
CLICK #site--nav--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS

// A new timezone builds the last 7 days again, with the backfilled doses in them
GOTO /settings
ASSERT_STATUS 200
INPUT #site--settings--site--timezone Etc/UTC
CLICK #site--settings--site--save
ASSERT_TEXT_VISIBLE Settings Saved
RUN_BACKGROUND_JOBS

// The report draws a bar of each day of the week before today with insulin, today left out as it is not over, with their
// mean, lowest and highest daily dose, and a table of each day's dose, newest first
GOTO /reports/tdd
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--reports--tdd--empty
ASSERT_DRAWN #site--reports--tdd--chart svg
ASSERT_DRAWN #site--reports--tdd--chart >> text=/^\d+ U$/ >> nth=-1
ASSERT_VISIBLE #site--reports--tdd--days >> text=/^[34]$/
ASSERT_VISIBLE #site--reports--tdd--mean >> text=/^\d+(\.\d+)? U$/
ASSERT_VISIBLE #site--reports--tdd--lowest >> text=/^\d+(\.\d+)? U$/
ASSERT_VISIBLE #site--reports--tdd--highest >> text=/^\d+(\.\d+)? U$/
ASSERT_COUNT #site--reports--tdd--table tbody tr 7
ASSERT_VISIBLE #site--reports--tdd--table tbody tr >> nth=0 >> text=/^\d+(\.\d+)? U$/
SCREENSHOT report_tdd

// The range buttons show the fortnight or the month before today, and back returns to the range before
CLICK #site--reports--tdd--range-month
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_VISIBLE #site--reports--tdd--range-month.bg-primary
ASSERT_COUNT #site--reports--tdd--table tbody tr 30
ASSERT_DRAWN #site--reports--tdd--chart svg
SCREENSHOT report_tdd_month
CLICK #site--reports--tdd--range-fortnight
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--tdd--range-fortnight.bg-primary
ASSERT_COUNT #site--reports--tdd--table tbody tr 14
CLICK_BACK
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--tdd--range-month.bg-primary
ASSERT_COUNT #site--reports--tdd--table tbody tr 30

// On a phone the report is no wider than the window, its buttons wrapping. The window is tall enough for the whole
// page, so fitting it checks only its width.
WINDOW 390x1600
GOTO /reports/tdd
ASSERT_STATUS 200
ASSERT_DRAWN #site--reports--tdd--chart svg
ASSERT_FITS
SCREENSHOT report_tdd_phone
