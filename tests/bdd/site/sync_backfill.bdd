INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_PATH /settings/sync

// A sync that is not saved and on cannot be backfilled
CLICK #site--settings--nightscout-sync--backfill
ASSERT_TEXT_VISIBLE turn on and save this sync before backfilling it
ASSERT_VISIBLE #toaster [data-tui-toast][data-variant="error"]:has-text("turn on and save this sync")

// Virtual sync's first run writes its last 30 minutes, all on the first page of 100 readings
CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
RUN_BACKGROUND_JOBS

GOTO /data/glucose?limit=100
ASSERT_STATUS 200
ASSERT_VISIBLE #glucoseReadingsTable
ASSERT_NOT_VISIBLE #site--glucose--next

// Backfilling says what it will fetch, and asking again before it has run starts nothing
CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-sync--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
ASSERT_TEXT_VISIBLE Fetching records from
SCREENSHOT sync_backfill_started
// The toast goes to the toaster, leaving the button as it was
ASSERT_TEXT_EQUALS #site--settings--virtual-sync--backfill Backfill
CLICK #site--settings--virtual-sync--backfill
ASSERT_TEXT_VISIBLE A backfill of this sync is already running

// Once it has run, the day before the first reading (tests backfill a day) fills more pages of readings
RUN_BACKGROUND_JOBS
GOTO /data/glucose?limit=100
ASSERT_STATUS 200
ASSERT_VISIBLE #site--glucose--next

// The sync page shows how the virtual sync has synced, how often and why, its backfill, and its recent events
CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--virtual-sync--status
ASSERT_TEXT_EQUALS #site--settings--virtual-sync--status--last-success just now
ASSERT_TEXT_EQUALS #site--settings--virtual-sync--status--last-failure Never
ASSERT_TEXT_EQUALS #site--settings--virtual-sync--status--interval 1 min (Default)
ASSERT_TEXT_VISIBLE records in
CLICK #site--settings--virtual-sync--history summary
ASSERT_TEXT_VISIBLE Sync backfilled
SCREENSHOT sync_status
