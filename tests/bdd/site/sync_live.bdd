INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_PATH /settings/sync
// The page listens for its syncs' changes, shown Live beside its title
ASSERT_VISIBLE #mainForm h1 + #site--settings--sync--live

CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_TEXT_VISIBLE Sync Updated

// Without going to the page again, its status shows the sync as it runs
RUN_BACKGROUND_JOBS
ASSERT_VISIBLE #site--settings--virtual-sync--status--last-success:has-text("just now")
ASSERT_VISIBLE #site--settings--virtual-sync--status--totals:has-text("1 worked")

// A history that is open stays open as a backfill finishes, and shows it
CLICK #site--settings--virtual-sync--history summary
CLICK #site--settings--virtual-sync--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS
ASSERT_VISIBLE #site--settings--virtual-sync--history[open]:has-text("Sync backfilled")
ASSERT_VISIBLE #site--settings--virtual-sync--status--backfill:has-text("records in")
SCREENSHOT sync_live
