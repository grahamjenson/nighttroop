GOTO {{ server_url}}/
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200

// Login is offered once a code from the authenticator app has been checked
INPUT #public--site-info--totp 123123
CLICK #public--totp-check-button
ASSERT_VISIBLE #public--totp-checked
CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_PATH /

// Virtual sync is turned on, but has not run yet
CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

CLICK #site--nav--home
ASSERT_NEW_URL
ASSERT_TEXT_VISIBLE No glucose readings in this time
ASSERT_VISIBLE #site--summary--live

// In the background, the summary's stream is closed, so readings the sync writes are not shown
BACKGROUND
RUN_BACKGROUND_JOBS
ASSERT_TEXT_VISIBLE No glucose readings in this time

// Back in the foreground, the stream reconnects, and the summary reloads to show what it missed
FOREGROUND
ASSERT_VISIBLE #site--summary--live
ASSERT_VISIBLE #site--summary--glucose--reading
ASSERT_NOT_VISIBLE "No glucose readings in this time"
ASSERT_PATH /
SCREENSHOT summary_reconnected
