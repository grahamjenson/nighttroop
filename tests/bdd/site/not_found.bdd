GOTO {{ server_url}}/
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"


// An address with no collection shows the site's not found page, with a way back
GOTO /data/nope
ASSERT_STATUS 404
ASSERT_VISIBLE #site--not-found
ASSERT_TEXT_EQUALS #site--not-found--message There is no nope here
SCREENSHOT not_found

// A collection asked for something it cannot do says so
GOTO /settings/sync/virtual
ASSERT_STATUS 405
ASSERT_TEXT_EQUALS #site--not-found--message sync cannot be read here

CLICK #site--not-found--home
ASSERT_NEW_URL
ASSERT_VISIBLE #site--summary--hours
