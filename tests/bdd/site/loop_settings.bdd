INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// Loop settings are in the Data hub under Presets, and a new site has none
CLICK #site--nav--data
ASSERT_VISIBLE #site--presets--loop-settings-button
CLICK #site--presets--loop-settings-button
ASSERT_STATUS 200
ASSERT_PATH /presets/loop-settings
ASSERT_VISIBLE #presets--loop-settings--empty
SCREENSHOT loop_settings_empty

// Virtual connector uploads a profile with Loop's settings, as Loop does
CLICK #site--settings-menu
CLICK #site--nav--menu--connectors
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS

GOTO /presets/loop-settings
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1
ASSERT_VISIBLE #loopSettingsTable td >> text=/^Loop$/
ASSERT_VISIBLE #loopSettingsTable td >> text=/^Profile$/
ASSERT_VISIBLE #loopSettingsTable td >> text=/^virtual:/
SCREENSHOT loop_settings

// Clicking them shows the settings as they were sent, to inspect
CLICK #loopSettingsTable tbody tr >> nth=0
ASSERT_VISIBLE #presets--loop-settings--details
ASSERT_TEXT_VISIBLE Loop Settings
ASSERT_VISIBLE #presets--loop-settings--json >> text=/"maximumBolus": 10/
ASSERT_VISIBLE #presets--loop-settings--json >> text=/"dosingStrategy": "automaticBolus"/
ASSERT_TEXT_VISIBLE First Seen
SCREENSHOT loop_settings_details
CLICK #presets--loop-settings--details--close
ASSERT_NOT_VISIBLE #presets--loop-settings--details

// Deleting asks first (the test accepts), then removes the row without opening its details
CLICK #loopSettingsTable tbody tr >> nth=0 >> button[title=Delete]
ASSERT_TEXT_VISIBLE Loop Settings Deleted
ASSERT_NOT_VISIBLE #presets--loop-settings--details

// The deleted settings stay gone after a reload, and the profile they came with is kept
GOTO /presets/loop-settings
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE No loop settings here.
GOTO /presets/profiles
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1
