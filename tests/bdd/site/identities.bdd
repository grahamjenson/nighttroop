INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--identities-button
ASSERT_STATUS 200
ASSERT_PATH /settings/identities
ASSERT_TEXT_VISIBLE Admins & Users
ASSERT_TEXT_VISIBLE PWD Phone
// Column names are in title case like the others
ASSERT_NOT_VISIBLE #main-content >> text=Created at
ASSERT_VISIBLE #main-content th >> text=Created >> nth=0
// The forms to add a user or a device label what each input takes, like the data pages
ASSERT_VISIBLE #identities_table label[for="name-createIdentityFormusersTable"]:has-text("Name")
ASSERT_VISIBLE #identities_table label[for="select-form-createIdentityFormusersTable"]:has-text("Role")
ASSERT_VISIBLE #identities_table label[for="name-createIdentityFormdevicesTable"]:has-text("Name")
// The role cards are neutral, as red, blue and green are for errors, information and success
ASSERT_VISIBLE #identities_table .border-gray-200>h2.text-brand-night:text-is("Admin")
ASSERT_VISIBLE #identities_table .border-gray-200>h2.text-brand-night:text-is("Device")
ASSERT_NOT_VISIBLE #identities_table .bg-red-50
SCREENSHOT identities

// A name longer than the database keeps is refused in its own words, which the toast leaves to the Errors page
INPUT #name-createIdentityFormusersTable {{ repeat "a" 40 }}
CLICK "Add User"
ASSERT_STATUS 400
ASSERT_TEXT_VISIBLE Something went wrong.
ASSERT_VISIBLE #toaster >> text=Errors page
ASSERT_NOT_VISIBLE #toaster >> text=CHECK constraint failed
SCREENSHOT identity_error_recorded
CLICK #toaster >> text=Errors page
ASSERT_PATH /logs/errors
ASSERT_VISIBLE #siteErrorsTable >> text=CHECK constraint failed
SCREENSHOT identity_error_on_errors_page
GOTO /settings/identities
ASSERT_STATUS 200

// Adding a user without choosing a role makes a User, not an Admin
ASSERT_TEXT_EQUALS #select-form-createIdentityFormusersTable User
INPUT #name-createIdentityFormusersTable nurse
CLICK "Add User"
ASSERT_STATUS 201
CLICK "I Have Saved These"
CLICK #site--identities--close
ASSERT_TEXT_EQUALS #usersTable>tbody>tr:has-text("nurse")>td:nth-child(2) User
SCREENSHOT identities_user_created

// Adding a device shows its credentials once
INPUT #name-createIdentityFormdevicesTable kitchen
CLICK "Add Device"
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE I Have Saved These
SCREENSHOT identities_device_created

// The credentials are a dialog over the page and its header, named for the new identity
ASSERT_VISIBLE #site--identities--credentials.z-50
ASSERT_VISIBLE #site--identities--credentials [role=dialog][aria-labelledby="site--identities--credentials--title"]
ASSERT_TEXT_EQUALS #site--identities--credentials--title Credentials for kitchen
// Saying they are saved is a confirmation, not something to be wary of, so it is the primary button, not red
ASSERT_VISIBLE #site--identities--saved-these.bg-primary

// Each credential has its own copy button
ASSERT_VISIBLE #site--identities--created--password + [data-copy-button]
ASSERT_VISIBLE #site--identities--created--ns-token + [data-copy-button]

// Saying they are saved warns they are never shown again, before closing them
CLICK "I Have Saved These"
ASSERT_VISIBLE #site--identities--saved-warning >> text=never shown again
ASSERT_VISIBLE #site--identities--created--password
ASSERT_VISIBLE #site--identities--close.bg-primary
SCREENSHOT identities_saved_warning
CLICK #site--identities--saved-back
ASSERT_NOT_VISIBLE #site--identities--saved-warning

// Escape, or pressing beside them, does not close them but warns the same way, so they are not lost by a slip
PRESS Escape
ASSERT_VISIBLE #site--identities--saved-warning
ASSERT_VISIBLE #site--identities--created--password
CLICK #site--identities--saved-back
CLICK_CORNER #site--identities--credentials
ASSERT_VISIBLE #site--identities--saved-warning
ASSERT_VISIBLE #site--identities--created--password
CLICK #site--identities--close
ASSERT_NOT_VISIBLE #site--identities--created--password
ASSERT_TEXT_VISIBLE kitchen

// Opening the page again lists the new device
GOTO /settings/identities
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE kitchen

// A device can be turned off and back on
CLICK #site--identities--kitchen--enabled
ASSERT_TEXT_VISIBLE kitchen disabled
CLICK #site--identities--kitchen--enabled
ASSERT_TEXT_VISIBLE kitchen enabled
SCREENSHOT identities_actions

// A user that cannot be added says why, beside the toasts already shown rather than in place of them
INPUT #name-createIdentityFormusersTable nurse
CLICK "Add User"
ASSERT_STATUS 409
ASSERT_TEXT_VISIBLE kitchen enabled
ASSERT_COUNT #toaster > * 3

// Deleting asks first (the test accepts), then removes the row
CLICK #site--identities--kitchen--manage
CLICK #site--identities--kitchen--delete
ASSERT_TEXT_VISIBLE Identity Deleted
ASSERT_NOT_VISIBLE #site--identities--kitchen--enabled
SCREENSHOT identities_device_deleted
