GOTO {{ server_url}}/
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200

// Login is offered once a code from the authenticator app has been checked
INPUT #public--site-info--totp 123123
CLICK #public--totp-check-button
ASSERT_VISIBLE #public--totp-checked
CLICK #public--login-button
ASSERT_NEW_PAGE
ASSERT_PATH /login

// Double click login with the wrong password: both errors stack, newest on top
INPUT #site--login--name admin
INPUT #site--login--password wrongpassword

CLICK #site--login-button
ASSERT_STATUS 401
CLICK #site--login-button
ASSERT_STATUS 401

SCREENSHOT stack_toast

// Five failed logins in a row: at most three toasts take space, and the newest is still on top
CLICK #site--login-button
ASSERT_STATUS 401
CLICK #site--login-button
ASSERT_STATUS 401
CLICK #site--login-button
ASSERT_STATUS 401
CLICK #site--login-button
ASSERT_STATUS 401
CLICK #site--login-button
ASSERT_STATUS 401
ASSERT_VISIBLE #toaster>[data-tui-toast]:last-child
ASSERT_COUNT #toaster>[data-tui-toast] 3
SCREENSHOT toasts_at_most_three
