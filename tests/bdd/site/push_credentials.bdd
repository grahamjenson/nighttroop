INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// A new site has no push credentials
CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--push-button
CLICK #site--settings--push-button
ASSERT_STATUS 200
ASSERT_PATH /settings/push-credentials
ASSERT_VISIBLE #site--push-credential--empty
SCREENSHOT push_credentials_empty

// An admin adds the Apple push key for the Loop they build: its IDs, the apps it pushes to and the .p8 file pasted in
CLICK #site--push-credential--add
ASSERT_VISIBLE #site--push-credential--create--modal
ASSERT_TEXT_VISIBLE It is kept encrypted and never shown again.
INPUT #site--push-credential--create--name My Loop
INPUT #site--push-credential--create--team-or-project-id TEAM123456
INPUT #site--push-credential--create--key-id ABC123DEFG
INPUT #site--push-credential--create--bundle-ids com.TEAM123456.loopkit.Loop, com.TEAM123456.LoopCaregiver
CLICK #site--push-credential--create--apps--loop
INPUT #site--push-credential--create--secret {{ "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgofoAD0qFTDB8eVl2\nLKYt19HfOaUvrvTYGMMR98DDoDihRANCAAROFNjYuI2rlnHoAy4UP4PVhQiFxz1L\nSaETlxByVnuzazzPdJ6qtAO+GOvUV5lPZn62Rv3vFb9ozLi/OFfob09a\n-----END PRIVATE KEY-----\n" }}
CLICK #site--push-credential--create--name
SCREENSHOT push_credential_add
CLICK #site--push-credential--create--submit
ASSERT_STATUS 201
ASSERT_NOT_VISIBLE #site--push-credential--create--modal
ASSERT_NOT_VISIBLE #site--push-credential--empty
ASSERT_VISIBLE #pushCredentialsTable >> text="My Loop"
ASSERT_VISIBLE #pushCredentialsTable >> text="Apple (APNs)"
ASSERT_VISIBLE #pushCredentialsTable >> text="Key ABC123DEFG"
ASSERT_VISIBLE #pushCredentialsTable >> text="com.TEAM123456.loopkit.Loop, com.TEAM123456.LoopCaregiver"
SCREENSHOT push_credentials

// A key that is not a .p8 file is refused, leaving the modal open to fix
CLICK #site--push-credential--add
INPUT #site--push-credential--create--name Bad Key
INPUT #site--push-credential--create--team-or-project-id TEAM123456
INPUT #site--push-credential--create--key-id ABC123DEFG
CLICK #site--push-credential--create--apps--loop
INPUT #site--push-credential--create--secret not a key
CLICK #site--push-credential--create--submit
ASSERT_TEXT_VISIBLE the APNs key is not a .p8 file
ASSERT_VISIBLE #site--push-credential--create--modal
CLICK #site--push-credential--create--modal--close
ASSERT_NOT_VISIBLE #site--push-credential--create--modal

// It is kept: the page shows it again, without its key
CLICK #site--settings-menu
CLICK #site--settings--push-button
ASSERT_STATUS 200
ASSERT_VISIBLE #pushCredentialsTable >> text="My Loop"
ASSERT_NOT_VISIBLE #pushCredentialsTable >> text="Bad Key"

// Deleting asks first (the test accepts), then removes it
CLICK #pushCredentialsTable tbody tr:has(td:text-is("My Loop")) >> button[title=Delete]
ASSERT_TEXT_VISIBLE Push Credential Deleted
ASSERT_NOT_VISIBLE #pushCredentialsTable >> text="My Loop"
SCREENSHOT push_credential_deleted
