INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// A device's client is picked before its role, as a loop's device must be the PWD phone
CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--identities-button
ASSERT_STATUS 200
CLICK #site--identities--add-device-button
CLICK #site--identities--add-device--form label:has(#site--identities--add-device--client-trio)
ASSERT_VISIBLE #site--identities--add-device--form label:has(#site--identities--add-device--role-device_pwd_phone:checked)
ASSERT_VISIBLE #site--identities--add-device--form label:has(#site--identities--add-device--role-device_read:disabled)
SCREENSHOT client_role_forced

// Another client leaves the role to be picked
CLICK #site--identities--add-device--form label:has(#site--identities--add-device--client-nightguard)
ASSERT_VISIBLE #site--identities--add-device--form label:has(#site--identities--add-device--role-device_read:enabled)
CLICK #site--identities--add-device--form label:has(#site--identities--add-device--client-trio)
ASSERT_VISIBLE #site--identities--add-device--form label:has(#site--identities--add-device--role-device_pwd_phone:checked)
ASSERT_VISIBLE #site--identities--add-device--form label:has(#site--identities--add-device--role-device_read:disabled)

// The device is made a PWD phone
INPUT #site--identities--add-device--name trio
CLICK #site--identities--add-device--submit
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE Setting up Trio
CLICK "I Have Saved These"
CLICK #site--identities--close
ASSERT_VISIBLE #devicesTable tr:has(td:text-is("trio")) >> text=PWD Phone

// A caregiver's app, such as Nightguard, is a Caregiver device: the roles table says it cannot change readings
ASSERT_VISIBLE #site--identities--role--device_read_write >> text=Cannot change readings.
CLICK #site--identities--add-device-button
CLICK #site--identities--add-device--form label:has(#site--identities--add-device--client-nightguard)
CLICK #site--identities--add-device--form label:has(#site--identities--add-device--role-device_read_write)
ASSERT_VISIBLE #site--identities--add-device--form label:has(#site--identities--add-device--role-device_read_write:checked)
INPUT #site--identities--add-device--name watch
CLICK #site--identities--add-device--submit
ASSERT_STATUS 201
CLICK "I Have Saved These"
CLICK #site--identities--close
ASSERT_VISIBLE #devicesTable tr:has(td:text-is("watch")) >> text=Caregiver
SCREENSHOT caregiver_device
