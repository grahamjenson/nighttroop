INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// A device is added for the Nightscout client it will be used in
CLICK #site--settings-menu
CLICK #site--settings--identities-button
ASSERT_STATUS 200
ASSERT_VISIBLE #identities_table label[for="client-createIdentityFormdevicesTable"]:has-text("Client")
INPUT #name-createIdentityFormdevicesTable watch
CLICK #client-createIdentityFormdevicesTable
CLICK #identities_table [role="option"][data-tui-selectbox-value="nightguard"]
CLICK "Add Device"
ASSERT_STATUS 201

// Its credentials say how to set that client up: the client's menus and fields in bold, and its URL with the token
// filled in, with a button to copy it, and that it gets mg/dL
ASSERT_TEXT_VISIBLE Setting up Nightguard
ASSERT_VISIBLE #site--identities--created--guide .font-semibold >> text=Configuration
ASSERT_VISIBLE #site--identities--created--guide code >> text=/\?token=/
ASSERT_VISIBLE #site--identities--created--guide code + [data-copy-button]
ASSERT_VISIBLE #site--identities--created--units
SCREENSHOT device_client_guide
SAVE_TEXT #site--identities--created--site site_url
SAVE_TEXT #site--identities--created--ns-token watch_token
CLICK "I Have Saved These"
CLICK #site--identities--close

// A device for AAPS is told to set its URL and token, each with its own copy button
INPUT #name-createIdentityFormdevicesTable loop_phone
CLICK #client-createIdentityFormdevicesTable
CLICK #identities_table [role="option"][data-tui-selectbox-value="aaps"]
CLICK "Add Device"
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE Setting up AAPS
ASSERT_VISIBLE #site--identities--created--guide .font-semibold >> text=NS access token
ASSERT_VISIBLE #site--identities--created--guide-1-5 + [data-copy-button]
ASSERT_VISIBLE #site--identities--created--guide-2-3 + [data-copy-button]
SCREENSHOT device_client_guide_aaps
CLICK "I Have Saved These"
CLICK #site--identities--close

// A device for xDrip4iOS is told where its URL and token go, how to upload or only follow, and that it gets mg/dL
// On a taller window, so its whole guide is in the modal
WINDOW 1280x1000
INPUT #name-createIdentityFormdevicesTable iphone
CLICK #client-createIdentityFormdevicesTable
CLICK #identities_table [role="option"][data-tui-selectbox-value="xdrip4ios"]
CLICK "Add Device"
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE Setting up xDrip4iOS
ASSERT_VISIBLE #site--identities--created--guide .font-semibold >> text=API_SECRET
ASSERT_VISIBLE #site--identities--created--guide .font-semibold >> text=Follower
ASSERT_VISIBLE #site--identities--created--guide-0-7 + [data-copy-button]
ASSERT_VISIBLE #site--identities--created--guide-1-5 + [data-copy-button]
ASSERT_TEXT_VISIBLE xDrip4iOS needs mg/dL
SCREENSHOT device_client_guide_xdrip4ios
SAVE_TEXT #site--identities--created--ns-token iphone_token
CLICK "I Have Saved These"
CLICK #site--identities--close

// A device for T1D Carer is told where its URL and token go, each with its own copy button, and that it gets mg/dL
INPUT #name-createIdentityFormdevicesTable carer_phone
CLICK #client-createIdentityFormdevicesTable
CLICK #identities_table [role="option"][data-tui-selectbox-value="t1dcarer"]
CLICK "Add Device"
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE Setting up T1D Carer
ASSERT_VISIBLE #site--identities--created--guide .font-semibold >> text=Nightscout URL
ASSERT_VISIBLE #site--identities--created--guide-1-3 + [data-copy-button]
ASSERT_VISIBLE #site--identities--created--guide-2-3 + [data-copy-button]
ASSERT_TEXT_VISIBLE T1D Carer needs mg/dL
SCREENSHOT device_client_guide_t1dcarer
CLICK "I Have Saved These"
CLICK #site--identities--close

// A device for any other client gets mg/dL too, as Nightscout clients expect
INPUT #name-createIdentityFormdevicesTable display
CLICK #client-createIdentityFormdevicesTable
CLICK #identities_table [role="option"][data-tui-selectbox-value="other"]
CLICK "Add Device"
ASSERT_STATUS 201
ASSERT_VISIBLE #site--identities--created--units >> text=This device's own units are mg/dL
SCREENSHOT device_client_guide_other
SAVE_TEXT #site--identities--created--ns-token display_token
CLICK "I Have Saved These"
CLICK #site--identities--close

// So the Nightscout API gives the device mg/dL, though the site is in mmol/L
GOTO {{ replace ".localhost" ".ns.localhost" .site_url }}/api/v1/status.json?token={{ .watch_token }}
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE mg/dl

GOTO {{ replace ".localhost" ".ns.localhost" .site_url }}/api/v1/status.json?token={{ .iphone_token }}
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE mg/dl

GOTO {{ replace ".localhost" ".ns.localhost" .site_url }}/api/v1/status.json?token={{ .display_token }}
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE mg/dl
