// A new site's credentials are shown on the site's own address, where its admin logs in
GOTO {{ server_url }}/
ASSERT_STATUS 200
CLICK "Create Site"
ASSERT_PATH /welcome
ASSERT_VISIBLE #public--site-info--backup-key
ASSERT_VISIBLE #public--logo
ASSERT_NOT_VISIBLE #public--features
SAVE_TEXT #public--site-info--url site_url

// They are shown once: the ID that shows them is dropped from the address, so opening the page again says so, and
// that the backup key gets new admin credentials on the recover page
GOTO {{ .site_url }}/welcome
ASSERT_STATUS 200
ASSERT_VISIBLE #public--welcome-gone
ASSERT_NOT_VISIBLE #public--site-info--backup-key
ASSERT_NOT_VISIBLE #public--features
SCREENSHOT welcome_gone
CLICK #public--welcome-gone--recover-link
ASSERT_PATH /recover
