INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// The settings say how the Nightscout API writes each units, Nighttroop's way by default, for a client that reads
// only one spelling
CLICK #site--settings-menu
CLICK #site--settings--settings-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--site--units_mgdl_label
ASSERT_VISIBLE #site--settings--site--units_mmol_label
ASSERT_VISIBLE #site--settings--identity--units_mmol_label
ASSERT_TEXT_EQUALS #site--settings--site--units_mgdl_label>option[value=""] Default (mg/dL)
ASSERT_TEXT_EQUALS #site--settings--site--units_mmol_label>option[value="mmol"] mmol
SCREENSHOT units_labels

// The site can write mmol/L as mmol, which its identities follow
INPUT #site--settings--site--units_mmol_label mmol
CLICK #site--settings--site--save
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Settings Saved

CLICK #site--settings-menu
CLICK #site--settings--settings-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--site--units_mmol_label:has(option[value="mmol"][selected])
ASSERT_VISIBLE #site--settings--identity--units_mmol_label:has(option[value=""][selected]:text-is("Site setting (mmol)"))
SCREENSHOT units_labels_saved
