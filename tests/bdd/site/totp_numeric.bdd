// A TOTP code is only digits, so letters typed into a code are dropped and the digits around them still check
GOTO {{ server_url }}/
ASSERT_STATUS 200
CLICK "Create Site"
ASSERT_STATUS 200
// It opens the new site's own address, which shows its credentials
ASSERT_PATH /welcome
ASSERT_VISIBLE #public--copy-button
TYPE #public--site-info--totp 1a2b3c123
CLICK #public--totp-check-button
ASSERT_VISIBLE #public--totp-checked
CLICK #public--login-button
ASSERT_NEW_PAGE
INPUT #site--login--name admin
INPUT #site--login--password password
CLICK #site--login-button
ASSERT_STATUS 200

// The code's boxes take only the digits typed, and log in once they are full
TYPE #site--login--otp-1 1a2 b3
ASSERT_PATH /login
SCREENSHOT totp_numeric_digits_only
TYPE #site--login--otp-1 1x2y3
ASSERT_NEW_URL
ASSERT_PATH /
