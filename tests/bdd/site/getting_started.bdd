INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// A new site has no readings, so rather than an empty summary its admin is shown how to set it up
ASSERT_VISIBLE #site--getting-started
ASSERT_TEXT_VISIBLE Welcome to your Nighttroop site
ASSERT_VISIBLE #site--getting-started--data
ASSERT_VISIBLE #site--getting-started--ns-url
ASSERT_VISIBLE #site--getting-started--identities
ASSERT_VISIBLE #site--getting-started--settings
ASSERT_VISIBLE #site--getting-started--alarms
ASSERT_NOT_VISIBLE #site--summary--glucose
SCREENSHOT getting_started

// Each step opens the page it is done on, and the guide is always in the menu to come back to
CLICK #site--getting-started--sync-link
ASSERT_PATH /settings/sync
ASSERT_VISIBLE #site--settings--virtual-sync--enable

CLICK #site--settings-menu
CLICK #site--getting-started-button
ASSERT_PATH /getting-started
ASSERT_VISIBLE #site--getting-started
CLICK #site--getting-started--identities-link
ASSERT_PATH /settings/identities
ASSERT_TEXT_VISIBLE Admins & Users

CLICK #site--settings-menu
CLICK #site--getting-started-button
CLICK #site--getting-started--settings-link
ASSERT_PATH /settings
ASSERT_VISIBLE #site--settings--delete

CLICK #site--settings-menu
CLICK #site--getting-started-button
CLICK #site--getting-started--alarms-link
ASSERT_PATH /settings/alarms
ASSERT_VISIBLE #alarm_settings_page h2:text-is("Lows")

// The guide's own page, from the menu
CLICK #site--settings-menu
CLICK #site--getting-started-button
ASSERT_PATH /getting-started
ASSERT_VISIBLE #site--getting-started--data
SCREENSHOT getting_started_page
