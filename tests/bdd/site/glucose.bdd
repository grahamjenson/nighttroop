GOTO {{ server_url}}/
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
INPUT #site--login--otp-1 123123

CLICK #site--login-totp-button
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"

// Virtual sync writes the last 30 minutes of glucose readings, 6 of them, on its first run
CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
RUN_BACKGROUND_JOBS

CLICK #site--settings-menu
CLICK #site--data--glucose-button
ASSERT_STATUS 200
ASSERT_PATH /data/glucose
ASSERT_VISIBLE #glucoseReadingsTable
ASSERT_TEXT_VISIBLE Showing 1 to 6
// Readings are in the settings' units, mmol/L by default
ASSERT_TEXT_VISIBLE mmol/L
ASSERT_NOT_VISIBLE #site--glucose--next
ASSERT_NOT_VISIBLE #site--glucose--previous
SCREENSHOT glucose_readings

// Clicking a reading shows all its details
CLICK #glucoseReadingsTable tbody tr >> nth=0
ASSERT_VISIBLE #site--glucose--details
ASSERT_TEXT_VISIBLE virtual_sync
SCREENSHOT glucose_reading_details

CLICK #site--glucose--details--close
ASSERT_NOT_VISIBLE #site--glucose--details

// A reading typed in is a meter reading in mmol/L, added to the top of the table
INPUT #site--glucose--create--reading 7.9
INPUT #site--glucose--create--notes Finger prick
CLICK #site--glucose--create--submit
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE mbg
SCREENSHOT glucose_reading_created

// Its details can be edited, which updates its row
CLICK "mbg"
ASSERT_VISIBLE #site--glucose--details
ASSERT_TEXT_VISIBLE Finger prick
SCREENSHOT glucose_reading_edit
INPUT #site--glucose--edit--reading 8.6
INPUT #site--glucose--edit--notes Rechecked
CLICK #site--glucose--edit--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Glucose Reading Updated
ASSERT_NOT_VISIBLE #site--glucose--details
ASSERT_TEXT_VISIBLE 8.6
SCREENSHOT glucose_reading_updated

// The edit is saved
CLICK "mbg"
ASSERT_TEXT_VISIBLE 8.6 mmol/L
ASSERT_TEXT_VISIBLE Rechecked
CLICK #site--glucose--details--close

// Choosing mg/dL shows the same reading in mg/dL
CLICK #site--settings-menu
CLICK #site--settings--settings-button
ASSERT_STATUS 200
INPUT #site--settings--identity--units mg/dL
CLICK #site--settings--identity--save
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Settings Saved
CLICK #site--settings-menu
CLICK #site--data--glucose-button
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE mg/dL
ASSERT_TEXT_VISIBLE 155
// The new reading's label says which units to type it in
ASSERT_TEXT_VISIBLE Reading (mg/dL)
SCREENSHOT glucose_readings_mgdl

// A page of one reading pages through them, newest first
GOTO /data/glucose?limit=1
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1
ASSERT_NOT_VISIBLE #site--glucose--previous

CLICK #site--glucose--next
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 2 to 2
SCREENSHOT glucose_readings_paged

CLICK #site--glucose--previous
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1

// Deleting asks first (the test accepts), then removes the row without opening its details
CLICK #site--settings-menu
CLICK #site--data--glucose-button
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 7
CLICK #glucoseReadingsTable tbody tr >> nth=0 >> button[title=Delete]
ASSERT_TEXT_VISIBLE Glucose Reading Deleted
ASSERT_NOT_VISIBLE #site--glucose--details
SCREENSHOT glucose_reading_deleted

// The deleted reading stays gone after a reload
CLICK #site--settings-menu
CLICK #site--data--glucose-button
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 6
