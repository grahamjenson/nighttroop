INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// Virtual connector writes the last 30 minutes of glucose readings, 6 of them, on its first run
CLICK #site--nav--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS

GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_PATH /data/glucose
ASSERT_VISIBLE #glucoseReadingsTable
ASSERT_TEXT_VISIBLE Showing 1 to 6
// Readings are in the settings' units, mmol/L by default
ASSERT_TEXT_VISIBLE mmol/L
ASSERT_NOT_VISIBLE #site--glucose--next
ASSERT_NOT_VISIBLE #site--glucose--previous
SCREENSHOT glucose_readings
// A row's delete icon is grey, so a table is not a column of red, and turns red as it is pointed at
ASSERT_VISIBLE #glucoseReadingsTable tbody tr >> nth=0 >> [id$="--delete"]:has(svg.text-gray-400)
HOVER #glucoseReadingsTable tbody tr >> nth=0 >> [id$="--delete"]
SCREENSHOT glucose_reading_delete_pointed_at

// Clicking a reading shows all its details
CLICK #glucoseReadingsTable tbody tr >> nth=0
ASSERT_VISIBLE #site--glucose--details
ASSERT_TEXT_VISIBLE virtual_connector
// Its type and trend read as they do in the table
ASSERT_VISIBLE #site--glucose--details >> text=Sensor
ASSERT_NOT_VISIBLE #site--glucose--details >> text=sgv
SCREENSHOT glucose_reading_details

CLICK #site--glucose--details--close
ASSERT_NOT_VISIBLE #site--glucose--details

// A reading typed in is a meter reading in mmol/L, added to the top of the table
CLICK #site--glucose--add
// Adding opens a modal of all its fields, each saying what it is and whether it is required
ASSERT_VISIBLE #site--glucose--create--modal
ASSERT_TEXT_VISIBLE The glucose measured, in your units.
ASSERT_TEXT_VISIBLE Required
ASSERT_VISIBLE #site--glucose--create--reading-type
ASSERT_VISIBLE #site--glucose--create--direction
// Its type and trend are offered as the table shows them, not as Nightscout's mbg and sgv
ASSERT_TEXT_EQUALS #site--glucose--create--reading-type>option[value=mbg] Meter
ASSERT_TEXT_EQUALS #site--glucose--create--reading-type>option[value=sgv] Sensor
ASSERT_TEXT_EQUALS #site--glucose--create--direction>option[value=FortyFiveUp] ↗ FortyFiveUp
SCREENSHOT glucose_reading_add
// A type is picked by what it reads as
INPUT #site--glucose--create--reading-type Meter
INPUT #site--glucose--create--reading 7.9
INPUT #site--glucose--create--notes Finger prick
CLICK #site--glucose--create--submit
ASSERT_STATUS 201
// The count under the table counts it straight away, without a reload
ASSERT_TEXT_VISIBLE Showing 1 to 7
// It is shown as from a meter, beside the sensor's readings with their trend arrows
ASSERT_TEXT_VISIBLE Meter
ASSERT_TEXT_VISIBLE Sensor
ASSERT_VISIBLE #glucoseReadingsTable span[title]:not([title="-"]) >> nth=0
SCREENSHOT glucose_reading_created

// Its details can be edited, which updates its row
CLICK "Meter"
ASSERT_VISIBLE #site--glucose--details
ASSERT_TEXT_VISIBLE Finger prick
SCREENSHOT glucose_reading_edit
INPUT #site--glucose--edit--reading 8.6
INPUT #site--glucose--edit--notes Rechecked
CLICK #site--glucose--edit--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Glucose Reading Updated
ASSERT_NOT_VISIBLE #site--glucose--details
ASSERT_TEXT_VISIBLE 8.6
SCREENSHOT glucose_reading_updated

// The edit is saved
CLICK "Meter"
ASSERT_TEXT_VISIBLE 8.6 mmol/L
ASSERT_TEXT_VISIBLE Rechecked

// Notes longer than the database keeps are refused in its own words, which the toast leaves to the Errors page
INPUT #site--glucose--edit--notes {{ repeat "a" 1100 }}
CLICK #site--glucose--edit--submit
ASSERT_STATUS 400
ASSERT_TEXT_VISIBLE Something went wrong.
ASSERT_VISIBLE #toaster >> text=Errors page
ASSERT_NOT_VISIBLE #toaster >> text=CHECK constraint failed
SCREENSHOT glucose_reading_error_recorded
CLICK #toaster >> text=Errors page
ASSERT_PATH /logs/errors
ASSERT_VISIBLE #siteErrorsTable >> text=CHECK constraint failed
SCREENSHOT glucose_reading_error_on_errors_page

// Choosing mg/dL shows the same reading in mg/dL
CLICK #site--nav--settings
ASSERT_STATUS 200
INPUT #site--settings--identity--units mg/dL
CLICK #site--settings--identity--save
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Settings Saved
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE mg/dL
ASSERT_TEXT_VISIBLE 155
SCREENSHOT glucose_readings_mgdl
// A new reading's label says which units to type it in
CLICK #site--glucose--add
ASSERT_TEXT_VISIBLE Reading (mg/dL)
CLICK #site--glucose--create--modal--close
ASSERT_NOT_VISIBLE #site--glucose--create--modal
// Its details offer it to edit as it is shown, not with the decimals left from converting it from mmol/L
CLICK "Meter"
ASSERT_VISIBLE #site--glucose--edit--reading[value="155"]
SCREENSHOT glucose_reading_edit_mgdl
CLICK #site--glucose--details--close

// A page of one reading pages through them, newest first
GOTO /data/glucose?limit=1
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1
ASSERT_NOT_VISIBLE #site--glucose--previous

CLICK #site--glucose--next
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 2 to 2
SCREENSHOT glucose_readings_paged

CLICK #site--glucose--previous
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1

// Deleting asks first (the test accepts), then removes the row without opening its details
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 7
CLICK #glucoseReadingsTable tbody tr >> nth=0 >> button[title=Delete]
ASSERT_TEXT_VISIBLE Glucose Reading Deleted
ASSERT_NOT_VISIBLE #site--glucose--details
// The count under the table stops counting it straight away, without a reload
ASSERT_TEXT_VISIBLE Showing 1 to 6
SCREENSHOT glucose_reading_deleted

// The deleted reading stays gone after a reload
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 6
