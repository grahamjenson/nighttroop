INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// A new site has no site or sensor changes
CLICK #site--nav--data
ASSERT_VISIBLE #site--data--component-events-button
CLICK #site--data--component-events-button
ASSERT_STATUS 200
ASSERT_PATH /data/component-events
ASSERT_VISIBLE #site--component-event--empty
SCREENSHOT component_events_empty

// A change typed in happens now, added to the top of the table
CLICK #site--component-event--add
// Adding opens a modal of all its fields, each saying what it is and whether it is required
ASSERT_VISIBLE #site--component-event--create--modal
ASSERT_TEXT_VISIBLE What was changed, started or filled.
ASSERT_TEXT_VISIBLE Required
ASSERT_VISIBLE #site--component-event--create--transmitter-id
SCREENSHOT component_event_add
INPUT #site--component-event--create--event-type Sensor Change
INPUT #site--component-event--create--sensor-code 1234
INPUT #site--component-event--create--notes Left arm
CLICK #site--component-event--create--submit
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE Left arm
ASSERT_NOT_VISIBLE #site--component-event--empty
CLICK #site--component-event--add
INPUT #site--component-event--create--event-type Site Change
INPUT #site--component-event--create--notes New pod
CLICK #site--component-event--create--submit
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE New pod
SCREENSHOT component_events

// Clicking a change shows all its details, which can be edited
CLICK #componentEventsTable tbody tr >> nth=1
ASSERT_VISIBLE #site--component-event--details
ASSERT_TEXT_VISIBLE Sensor Change
SCREENSHOT component_event_details
INPUT #site--component-event--edit--transmitter-id 8G1234
INPUT #site--component-event--edit--notes Right arm
CLICK #site--component-event--edit--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Change Updated
ASSERT_NOT_VISIBLE #site--component-event--details
ASSERT_TEXT_VISIBLE Right arm
SCREENSHOT component_event_updated

// On a phone the edit form is one column in its modal, so each input, with its label, and Save can be seen and tapped
WINDOW 390x844
CLICK #componentEventsTable tbody tr >> nth=1
ASSERT_VISIBLE #site--component-event--details
ASSERT_VISIBLE #site--component-event--edit label[for=site--component-event--edit--sensor-code] >> text=Sensor code
ASSERT_VISIBLE #site--component-event--edit label[for=site--component-event--edit--transmitter-id] >> text=Transmitter ID
ASSERT_VISIBLE #site--component-event--edit label[for=site--component-event--edit--notes] >> text=Notes
// Notes is on a line below the sensor code, rather than all of them squashing into one row
ASSERT_VISIBLE #site--component-event--edit--notes:below(#site--component-event--edit--sensor-code)
ASSERT_VISIBLE #site--component-event--edit--submit
SCREENSHOT component_event_details_phone
CLICK #site--component-event--details--close
ASSERT_NOT_VISIBLE #site--component-event--details
WINDOW 1280x720

// A page of one change pages through them, newest first
GOTO /data/component-events?limit=1
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1
ASSERT_TEXT_VISIBLE New pod
CLICK #site--component-event--next
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 2 to 2
ASSERT_TEXT_VISIBLE Right arm
CLICK #site--component-event--previous
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1

// Deleting asks first (the test accepts), then removes the row without opening its details
GOTO /data/component-events
ASSERT_STATUS 200
CLICK #componentEventsTable tbody tr >> nth=0 >> button[title=Delete]
ASSERT_TEXT_VISIBLE Change Deleted
ASSERT_NOT_VISIBLE #site--component-event--details
SCREENSHOT component_event_deleted

// The deleted change stays gone after a reload
GOTO /data/component-events
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 1
