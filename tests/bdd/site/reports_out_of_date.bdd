INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The virtual connector fills its last 30 minutes, which are today's, so yesterday's report is up to date
CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS
GOTO /reports/overview/day-{{ date -1 }}
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--reports--out-of-date

// A backfill writes yesterday, so its overview and AGP say they are being updated, until they are built again
GOTO /settings/connectors
CLICK #site--settings--virtual-connector--backfill
RUN_BACKGROUND_JOBS
GOTO /reports/overview/day-{{ date -1 }}
ASSERT_VISIBLE #site--reports--out-of-date >> text=Data in this report changed since it was worked out, so it is being updated.
SCREENSHOT out_of_date
GOTO /reports/agp/day-{{ date -1 }}
ASSERT_VISIBLE #site--reports--out-of-date

// A finished backfill has its days built on the next run, without waiting for the site's data to go quiet
RUN_BACKGROUND_JOBS
GOTO /reports/overview/day-{{ date -1 }}
ASSERT_NOT_VISIBLE #site--reports--out-of-date
ASSERT_VISIBLE #site--overview--mean >> text=/^\d+\.\d$/
ASSERT_NO_PAGE_ERRORS
