GOTO {{ server_url}}/
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
INPUT #site--login--otp-1 123123

CLICK #site--login-totp-button
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"

// One settings page shows an admin the site's settings, which start on the defaults, beside their own
CLICK #site--settings-menu
CLICK #site--settings--settings-button
ASSERT_STATUS 200
ASSERT_PATH /settings
ASSERT_TEXT_VISIBLE Settings
ASSERT_VISIBLE #site--settings--site--units
ASSERT_VISIBLE #site--settings--identity--units
SCREENSHOT site_settings

INPUT #site--settings--site--units mg/dL
INPUT #site--settings--site--date_format DD/MM/YYYY
INPUT #site--settings--site--timezone Pacific/Auckland
CLICK #site--settings--site--save
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Settings Saved

// The saved values are shown when the page is opened again, and the admin's own settings follow the site's
CLICK #site--settings-menu
CLICK #site--settings--settings-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--site--units:has(option[value="mg/dL"][selected])
ASSERT_VISIBLE #site--settings--site--date_format:has(option[value="DD/MM/YYYY"][selected])
ASSERT_VISIBLE #site--settings--identity--units:has(option[value=""][selected]:text-is("Site setting (mg/dL)"))
SCREENSHOT site_settings_saved

// Saving their own settings leaves the site's as they are
INPUT #site--settings--identity--week_start_day sunday
CLICK #site--settings--identity--save
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Settings Saved
SCREENSHOT identity_settings_saved

CLICK #site--settings-menu
CLICK #site--settings--settings-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--identity--week_start_day:has(option[value="sunday"][selected])
ASSERT_VISIBLE #site--settings--site--week_start_day:has(option[value=""][selected])
ASSERT_VISIBLE #site--settings--site--units:has(option[value="mg/dL"][selected])

// A bad value is refused
INPUT #site--settings--identity--timezone Mars/Olympus
CLICK #site--settings--identity--save
ASSERT_STATUS 400
ASSERT_TEXT_VISIBLE invalid timezone

// It is shown as an error toast, not as bare text
ASSERT_VISIBLE #toaster [data-tui-toast][data-variant="error"]:has-text("invalid timezone")
SCREENSHOT invalid_timezone_toast
