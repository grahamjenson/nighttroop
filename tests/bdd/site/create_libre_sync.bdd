GOTO {{ server_url}}/
ASSERT_STATUS           200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button

CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /settings/sync


ASSERT_VISIBLE #site--settings--libre-sync--enable
ASSERT_VISIBLE #site--settings--libre-sync--email
ASSERT_VISIBLE #site--settings--libre-sync--password
ASSERT_VISIBLE #site--settings--libre-sync--region
ASSERT_VISIBLE #site--settings--libre-sync--delete
ASSERT_VISIBLE #site--settings--libre-sync--submit

// Under go test only valid-libre-user@example.com logs in, and LibreLinkUp is never called
INPUT #site--settings--libre-sync--email follower@example.com
INPUT #site--settings--libre-sync--password libre-pass
INPUT #site--settings--libre-sync--region EU
CLICK #site--settings--libre-sync--enable
CLICK #site--settings--libre-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

RUN_BACKGROUND_JOBS

// The first sync fails, turns syncing off and says why, keeping the details to fix
CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button
CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--libre-sync--errors
ASSERT_TEXT_VISIBLE libre authentication failed: invalid email or password
ASSERT_VISIBLE #site--settings--libre-sync--email[value="follower@example.com"]
ASSERT_VISIBLE #site--settings--libre-sync--region:has(option[value="EU"]:checked)
ASSERT_VISIBLE #site--settings--libre-sync--enable:not(:checked)
SCREENSHOT libre_sync_first_sync_failed

// Saving working details clears the error and turns syncing back on
INPUT #site--settings--libre-sync--email valid-libre-user@example.com
CLICK #site--settings--libre-sync--enable
CLICK #site--settings--libre-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button
CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--settings--libre-sync--errors
ASSERT_VISIBLE #site--settings--libre-sync--email[value="valid-libre-user@example.com"]
ASSERT_VISIBLE #site--settings--libre-sync--enable:checked
SCREENSHOT libre_sync_saved

// Deleting leaves the page in place, with the Libre form rendered unset again
CLICK #site--settings--libre-sync--delete
ASSERT_TEXT_VISIBLE Sync Deleted
ASSERT_PATH /settings/sync
ASSERT_VISIBLE #site--settings--libre-sync--email:not([value*="valid-libre"])
ASSERT_VISIBLE #site--settings--libre-sync--region:has(option[value="GLOBAL"]:checked)
