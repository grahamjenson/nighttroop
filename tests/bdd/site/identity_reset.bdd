INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// An admin resets a device's password from Users & Devices, and stays signed in
CLICK #site--nav--settings
CLICK #site--settings--identities-button
ASSERT_PATH /settings/identities
// Each identity's actions are in its Manage menu, each labelled. The admin's own password and TOTP are reset from the
// settings page instead, so they are greyed out in its menu
CLICK #site--identities--admin--manage
ASSERT_TEXT_VISIBLE Reset password
ASSERT_DRAWN #site--identities--admin--reset-password[disabled]
ASSERT_DRAWN #site--identities--admin--reset-totp[disabled]
SCREENSHOT identity_manage_menu
PRESS Escape
// A device has no TOTP to reset
CLICK #site--identities--pwd_phone--manage
ASSERT_NOT_VISIBLE #site--identities--pwd_phone--reset-totp
CLICK #site--identities--pwd_phone--reset-password
ASSERT_STATUS 200
ASSERT_VISIBLE #site--identities--created--password
ASSERT_VISIBLE #site--identities--created--ns-token
ASSERT_NOT_VISIBLE #site--identities--signed-out
SCREENSHOT identity_password_reset
CLICK "I Have Saved These"
CLICK #site--identities--close
ASSERT_NOT_VISIBLE #site--identities--created--password
ASSERT_VISIBLE #site--identities--pwd_phone--manage

// Add a user, to sign in as later
INPUT #name-createIdentityFormusersTable carer
CLICK #select-form-createIdentityFormusersTable
CLICK #identities_table [role="option"][data-tui-selectbox-value="user"]
CLICK "Add User"
ASSERT_STATUS 201
SAVE_TEXT #site--identities--created--site site_url
SAVE_TEXT #site--identities--created--password carer_password
CLICK "I Have Saved These"
CLICK #site--identities--close

// The settings page warns that resetting your own password or TOTP signs you out
CLICK #site--nav--settings
ASSERT_PATH /settings
ASSERT_TEXT_VISIBLE Resetting your password or TOTP signs you out
ASSERT_VISIBLE #site--settings--reset-password
ASSERT_VISIBLE #site--settings--reset-totp
SCREENSHOT settings_credentials

// Resetting your own TOTP signs you out and shows the new secret, to sign in again with
CLICK #site--settings--reset-totp
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE You have been signed out
// The new secret's QR code holds the otpauth:// URI an authenticator app adds it from
ASSERT_VISIBLE #qrcode[title^="otpauth://totp/Nighttroop:admin@"][title*="?issuer=Nighttroop&secret="]
ASSERT_VISIBLE #site--identities--created--authenticator >> text=Scan with an authenticator app
ASSERT_VISIBLE #site--identities--created--authenticator--2fas[target="_blank"]
// It is also text, in fours, to copy bare, and tapping the QR code opens an authenticator app with it
ASSERT_TEXT_EQUALS #site--identities--created--totp-text Fake TOTP Secr etFo rDev Only
ASSERT_VISIBLE #site--identities--created--totp-link[href^="otpauth://totp/Nighttroop:admin@"][href$="secret=FakeTOTPSecretForDevOnly"]
ASSERT_VISIBLE #site--identities--created--totp-copy
ASSERT_NOT_VISIBLE #site--identities--created--password
SCREENSHOT settings_totp_reset
SAVE_VALUE #site--identities--created--totp-value admin_totp_secret
// Signed out, Escape does not close them either, leaving Sign In Again the way on
PRESS Escape
ASSERT_VISIBLE #site--identities--signed-out
ASSERT_VISIBLE #site--identities--sign-in-again
CLICK #site--identities--sign-in-again
ASSERT_PATH /login
INPUT #site--login--name admin
INPUT #site--login--password password
CLICK #site--login-button
ASSERT_STATUS 200
// A code made from the secret shown signs in
TYPE #site--login--otp-1 {{ totp .admin_totp_secret }}
ASSERT_NEW_URL
ASSERT_PATH /

// A user resets their own password from the settings page, which has no TOTP for them
CLICK #site--settings-menu
CLICK #site--settings--logout-button
ASSERT_NEW_URL
ASSERT_PATH /login
INPUT #site--login--name carer
INPUT #site--login--password {{ .carer_password }}
CLICK #site--login-button
ASSERT_NEW_URL
CLICK #site--nav--settings
ASSERT_TEXT_VISIBLE Resetting your password or TOTP signs you out
ASSERT_NOT_VISIBLE #site--settings--reset-totp
CLICK #site--settings--reset-password
ASSERT_TEXT_VISIBLE You have been signed out
SCREENSHOT settings_password_reset
SAVE_TEXT #site--identities--created--password carer_new_password

// Signed out, the site sends them to sign in, where the new password works
GOTO {{ .site_url }}/settings
ASSERT_PATH /login
INPUT #site--login--name carer
INPUT #site--login--password {{ .carer_new_password }}
CLICK #site--login-button
ASSERT_NEW_URL
ASSERT_PATH /
