INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The virtual connector writes readings, treatments and device reports, so the site's DB has data to show
CLICK #site--nav--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS

// An admin's My Account shows the site's DB size against its limit, measured as it opens, and where its data builds up,
// by table, as the control site's page of it does
CLICK #site--settings-menu
CLICK #site--settings--account-button
ASSERT_STATUS 200
ASSERT_PATH /settings/account
ASSERT_VISIBLE #site--account--db-size >> text=/^\d+\.\d\d$/
ASSERT_VISIBLE #site--account--db-limit >> text=of its 20.00 MB limit
ASSERT_DRAWN #site--account--db-used
ASSERT_VISIBLE #site--account--db-table--Other
ASSERT_VISIBLE #site--account--db-table--device_reports
ASSERT_VISIBLE #site--account--truncate-card >> text=Readings, treatments, profiles and everything else are kept.
SCREENSHOT account_storage

// Truncating, after confirming (the test accepts), clears and thins the device reports, and shows the storage again
// with the DB's new size
CLICK #site--account--truncate
ASSERT_TEXT_VISIBLE Site Truncated
ASSERT_VISIBLE #site--account--db-size >> text=/^\d+\.\d\d$/
ASSERT_VISIBLE #site--account--db-table--Other
ASSERT_NO_PAGE_ERRORS

// The site's events record who truncated it
GOTO /logs/events
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Site truncated
