INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The menu opens the reports, at first of the week with yesterday in it, which a new site has no data for
CLICK #site--settings-menu
CLICK #site--reports-button
ASSERT_STATUS 200
ASSERT_PATH /reports
ASSERT_TITLE Reports · Nighttroop
ASSERT_TEXT_EQUALS #site--reports--days 0
ASSERT_TEXT_EQUALS #site--reports--time-in-range –

// Virtual sync fills the last 30 minutes with readings, treatments and device statuses
CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
RUN_BACKGROUND_JOBS

// Today's report has today so far, its time in range and insulin, and there is no report after it
GOTO /reports/day-{{ date 0 }}
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--reports--days 1
ASSERT_VISIBLE #site--reports--time-in-range >> text=/^\d+(\.\d)?%$/
ASSERT_VISIBLE #site--reports--daily-dose >> text=/^[\d.]+ U$/
ASSERT_DRAWN #site--reports--next[disabled]
SCREENSHOT report_day

// The other periods ending on the same day have today so far in them
CLICK #site--reports--period-week
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_VISIBLE #site--reports--period-week
ASSERT_VISIBLE #site--reports--time-in-range >> text=/^\d+(\.\d)?%$/
SCREENSHOT report_week
CLICK #site--reports--period-fortnight
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--time-in-range >> text=/^\d+(\.\d)?%$/
CLICK #site--reports--period-month
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--time-in-range >> text=/^\d+(\.\d)?%$/
ASSERT_DRAWN #site--reports--next[disabled]
SCREENSHOT report_month

// The month before has no data, and back returns to this one
CLICK #site--reports--previous
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--reports--days 0
ASSERT_NOT_VISIBLE #site--reports--next[disabled]
CLICK_BACK
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--time-in-range >> text=/^\d+(\.\d)?%$/

// A report that is not a period, or is in the future, is not found
GOTO /reports/year-{{ date 0 }}
ASSERT_STATUS 404
GOTO /reports/day-{{ date 1 }}
ASSERT_STATUS 404
