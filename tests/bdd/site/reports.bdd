INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The menu's Reports group opens the AGP report, at first of the week with yesterday in it, which a new site has no
// glucose for
CLICK #site--settings-menu
ASSERT_TEXT_EQUALS #site--reports--agp-button AGP
CLICK #site--reports--agp-button
ASSERT_STATUS 200
ASSERT_PATH /reports
ASSERT_TITLE AGP · Nighttroop
ASSERT_VISIBLE #site--reports--no-glucose
ASSERT_TEXT_EQUALS #site--reports--days 0
ASSERT_TEXT_EQUALS #site--reports--time-in-range –
// With no days of data its daily dose and carbs are dashes too, not 0 U and 0 g
ASSERT_TEXT_EQUALS #site--reports--daily-dose –
ASSERT_TEXT_EQUALS #site--reports--daily-carbs –
SCREENSHOT report_no_data

// The virtual connector fills the last 30 minutes with readings, treatments and device statuses
CLICK #site--settings-menu
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS

// Today's report draws its glucose over the AGP of the 7 days to it, with the range behind them. Today has data, and
// there is no report after it.
GOTO /reports/day-{{ date 0 }}
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--reports--days 1
ASSERT_VISIBLE #site--reports--time-in-range >> text=/^\d+(\.\d)?%$/
// A day with data has a daily dose and carbs, a real 0 when there were none
ASSERT_VISIBLE #site--reports--daily-dose >> text=/^\d+(\.\d+)? U$/
ASSERT_VISIBLE #site--reports--daily-carbs >> text=/^\d+(\.\d+)? g$/
ASSERT_DRAWN #site--reports--agp svg
ASSERT_DRAWN #site--reports--agp >> text=5–95%
ASSERT_DRAWN #site--reports--agp >> text=25–75%
ASSERT_DRAWN #site--reports--agp >> text=Median
ASSERT_DRAWN #site--reports--agp >> text=Glucose
ASSERT_DRAWN #site--reports--next[disabled]
SCREENSHOT report_day

// The other periods ending on the same day have today so far in them, with no glucose line of their own
CLICK #site--reports--period-week
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_DRAWN #site--reports--agp >> text=Median
ASSERT_NOT_VISIBLE #site--reports--agp >> text=Glucose
SCREENSHOT report_week
CLICK #site--reports--period-fortnight
ASSERT_STATUS 200
ASSERT_DRAWN #site--reports--agp >> text=Median
CLICK #site--reports--period-month
ASSERT_STATUS 200
ASSERT_DRAWN #site--reports--agp >> text=Median
ASSERT_DRAWN #site--reports--next[disabled]
SCREENSHOT report_month

// The month before has no glucose, and back returns to this one
CLICK #site--reports--previous
ASSERT_STATUS 200
ASSERT_VISIBLE #site--reports--no-glucose
ASSERT_NOT_VISIBLE #site--reports--next[disabled]
CLICK_BACK
ASSERT_STATUS 200
ASSERT_DRAWN #site--reports--agp >> text=Median

// A report that is not a period, or is in the future, is not found
GOTO /reports/year-{{ date 0 }}
ASSERT_STATUS 404
GOTO /reports/day-{{ date 1 }}
ASSERT_STATUS 404
