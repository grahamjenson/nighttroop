// A new site's admin can add a passkey straight after creating the site, and sign in with it alone, with no password
// or code
GOTO {{ server_url }}/
ASSERT_STATUS 200
CLICK "Create Site"
ASSERT_STATUS 200

// The link to add a passkey opens the new site, as a passkey is made on the address it signs in to; it is named for
// the admin, nothing about the person
CLICK #public--passkey-button
ASSERT_NEW_URL
ASSERT_VISIBLE #site--passkey--add >> text=Add a passkey for admin
SCREENSHOT passkey_add
// The browser on the site has a passkey authenticator, as a phone has, that verifies the person itself
VIRTUAL_AUTHENTICATOR

// Adding it signs the admin in, to the summary
CLICK #site--passkey--add
ASSERT_NEW_URL
ASSERT_PATH /
ASSERT_VISIBLE #site--summary

// Signed out, the passkey signs the admin back in, from a button on the login page
CLICK #site--settings-menu
CLICK #site--settings--logout-button
ASSERT_NEW_URL
ASSERT_PATH /login
ASSERT_VISIBLE #site--login--passkey
SCREENSHOT login_passkey
CLICK #site--login--passkey
ASSERT_NEW_URL
ASSERT_PATH /
ASSERT_VISIBLE #site--summary
