INCLUDE steps/new_site_admin.steps

// The admin turns on an urgent high over 5.6 mmol/L for themselves, with their high under it
GOTO /settings/alarms
ASSERT_STATUS 200
INPUT #site--alarms--identity--range_high 5.0
INPUT #site--alarms--identity--alarm_urgent_high_enabled true
INPUT #site--alarms--identity--range_urgent_high 5.6
CLICK #site--alarms--identity--save
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Settings Saved

// No alarm is shown before the readings come in
GOTO /
ASSERT_STATUS 200
ASSERT_VISIBLE #site--summary--live
ASSERT_NOT_VISIBLE #site--alarms--alarm-urgent_high

// Once a reading over it comes in, of 15 mmol/L, the open page shows the urgent high, without being reloaded. It is
// sent rather than synced from the virtual connector, whose glucose changes through the day, so is over the urgent
// high only at some times of it.
POST /data/glucose {"reading": 15, "reading_type": "sgv"}
RUN_BACKGROUND_JOBS
ASSERT_VISIBLE #site--alarms--snooze-urgent_high
ASSERT_TEXT_VISIBLE Alarm: Urgent high
ASSERT_PATH /
ASSERT_VISIBLE #site--summary--glucose--reading
SCREENSHOT alarm_banner

// It is under the header on every page, shown as each opens
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_VISIBLE #site--alarms--snooze-urgent_high

// Snoozing it deletes it from the identity's alarms, which quiets it for this identity only, and it stays quiet as
// the readings are checked again
CLICK #site--alarms--snooze-urgent_high
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE #site--alarms--snooze-urgent_high
ASSERT_TEXT_EQUALS #site--alarms--alarm-urgent_high Snoozed: Urgent high
RUN_BACKGROUND_JOBS
GOTO /
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--alarms--alarm-urgent_high Snoozed: Urgent high
ASSERT_NOT_VISIBLE #site--alarms--snooze-urgent_high
SCREENSHOT alarm_banner_snoozed
