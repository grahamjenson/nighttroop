GOTO {{ server_url}}/
ASSERT_STATUS 200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
INPUT #site--login--otp-1 123123

CLICK #site--login-totp-button
ASSERT_NEW_URL
ASSERT_PATH /

// A new site's summary has nothing in it yet
ASSERT_VISIBLE #site--summary
ASSERT_TEXT_EQUALS #site--summary--hours Last 48 hours
ASSERT_TEXT_VISIBLE No glucose readings in this time
ASSERT_TEXT_VISIBLE No treatments in this time
ASSERT_TEXT_EQUALS #site--summary--iob –
SCREENSHOT summary_empty

// Virtual sync fills the last 30 minutes with readings, treatments and device statuses
CLICK #site--settings-menu
CLICK #site--settings--sync-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
RUN_BACKGROUND_JOBS

// A snack and a dose given now, for the graph to mark
CLICK #site--settings-menu
CLICK #site--data--food-button
ASSERT_STATUS 200
INPUT #site--food--create--carbs 15
CLICK #site--food--create--submit
ASSERT_STATUS 201
CLICK #site--settings-menu
CLICK #site--data--insulin-button
ASSERT_STATUS 200
INPUT #site--insulin--create--dose 2.5
CLICK #site--insulin--create--submit
ASSERT_STATUS 201

// The summary shows the latest glucose, the loop's IOB and COB, every treatment and each device's latest status
CLICK #site--nav--home
ASSERT_NEW_URL
ASSERT_PATH /
ASSERT_VISIBLE #site--summary--glucose--reading
SCREENSHOT summary
ASSERT_NOT_VISIBLE #site--summary--iob >> text="–"
ASSERT_NOT_VISIBLE #site--summary--cob >> text="–"
ASSERT_VISIBLE #site--summary--treatments >> text=Temp Basal
ASSERT_VISIBLE #site--summary--treatments >> text=Temp Target
ASSERT_VISIBLE #site--summary--readings tbody tr >> nth=5
ASSERT_VISIBLE #site--summary--devices >> text=virtual://nighttroop
ASSERT_VISIBLE #site--summary--devices >> text=virtual://carer-phone

// The latest glucose, each reading and each treatment say how long ago they were, all within the last half hour here
ASSERT_VISIBLE #site--summary--glucose--ago >> text=/^\d+m ago$/
ASSERT_VISIBLE #site--summary--readings tbody tr >> nth=0 >> text=/^\d+m ago$/
ASSERT_VISIBLE #site--summary--treatments tbody tr >> nth=0 >> text=/^\d+m ago$/

// ECharts draws the graph as an SVG in the browser: carbs and insulin are labelled by their markers, with the rows named down the side.
// These are checked as drawn, as labels can be drawn over each other (virtual sync's meal can be at nearly the same time as
// the one added here), and the sticky header can cover them once the page scrolls.
ASSERT_DRAWN #site--summary--graph svg
ASSERT_DRAWN #site--summary--graph >> text=15g
ASSERT_DRAWN #site--summary--graph >> text=2.5U
ASSERT_DRAWN #site--summary--graph >> text=Carbs
ASSERT_DRAWN #site--summary--graph >> text=Insulin
ASSERT_DRAWN #site--summary--graph >> text=Basal

// The range buttons show the summary over 6 hours to a week, and back returns to the range before
CLICK #site--summary--range-6
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--summary--hours Last 6 hours
ASSERT_VISIBLE #site--summary--graph >> text=2.5U
SCREENSHOT summary_6_hours
CLICK #site--summary--range-168
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--summary--hours Last 168 hours
CLICK_BACK
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--summary--hours Last 6 hours

// A device opens its latest status's details
CLICK #site--summary--devices >> text=virtual://nighttroop
ASSERT_VISIBLE #site--device-status--details
ASSERT_TEXT_VISIBLE Pump Reservoir
