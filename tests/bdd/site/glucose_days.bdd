INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

// A new site has only today, which has no readings, and says so rather than showing only the range
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_VISIBLE #site--glucose--days li:last-child >> text=No readings
ASSERT_NOT_VISIBLE #site--glucose--days li:last-child svg
ASSERT_NOT_VISIBLE #site--glucose--days li:last-child [title="Time in range"]

// Virtual connector writes its last 30 minutes, then a backfill the day before them (tests backfill a day)
CLICK #site--settings-menu
CLICK #site--nav--menu--connectors
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--add
CLICK #site--settings--virtual-connector--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS

// A day is built as it is read, so a new timezone, at the same midnight, has the backfilled readings in its days
GOTO /settings
ASSERT_STATUS 200
INPUT #site--settings--site--timezone Etc/UTC
CLICK #site--settings--site--save
ASSERT_TEXT_VISIBLE Settings Saved
RUN_BACKGROUND_JOBS

// The readings page shows each day's glucose as a small graph, oldest first, from the first day with readings to
// today so far: the backfilled day or two and today. The page is opened afresh, so no toasts cover them.
GOTO /data/glucose?limit=10
ASSERT_STATUS 200
ASSERT_VISIBLE #site--glucose--days
ASSERT_VISIBLE #site--glucose--days >> text=/Last [23] days/
ASSERT_VISIBLE #site--glucose--days li:last-child >> text=Today
// Today and yesterday have readings drawn over the range, and their time in range
ASSERT_DRAWN #site--glucose--days li:last-child svg rect >> nth=1
ASSERT_DRAWN #site--glucose--days li >> nth=-2 >> svg rect >> nth=1
ASSERT_VISIBLE #site--glucose--days li:last-child [title="Time in range"]
ASSERT_NOT_VISIBLE #site--glucose--days li:last-child >> text=No readings
// No day before the first with readings is shown
ASSERT_NOT_VISIBLE #site--glucose--days >> text=No readings
SCREENSHOT glucose_days

// On a phone the days are two to a row. The window is tall enough for the whole page, so fitting it checks only its
// width.
WINDOW 390x2000
GOTO /data/glucose?limit=10
ASSERT_STATUS 200
ASSERT_VISIBLE #site--glucose--days li:last-child >> text=Today
ASSERT_FITS
SCREENSHOT glucose_days_phone
WINDOW 1280x720

// Each day opens its AGP report, which draws that day's glucose, and back returns to the readings
GOTO /data/glucose?limit=10
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Click a day to see its AGP report.
HOVER #site--glucose--days li:last-child a
SCREENSHOT glucose_days_open_report
CLICK #site--glucose--days li >> nth=-2 >> a
ASSERT_PATH /reports/agp/day-{{ date -1 }}
ASSERT_TITLE AGP · Nighttroop
ASSERT_DRAWN #site--agp--day-{{ date -1 }} .site--agp--glucose >> nth=1
CLICK_BACK
ASSERT_PATH /data/glucose
ASSERT_VISIBLE #site--glucose--days

// The days are only on the first page of readings
GOTO /data/glucose?skip=100
ASSERT_STATUS 200
ASSERT_VISIBLE #glucoseReadingsTable
ASSERT_NOT_VISIBLE #site--glucose--days

// The server keeps only the last days as records, so the page says that older days are not listed here, and where they
// are. Device statuses are not packaged, so their page does not say so.
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_VISIBLE #site--glucose--older >> text=Only the last 31 days are listed here.
SCREENSHOT older_days_note
CLICK #site--glucose--older-link
ASSERT_PATH /reports
GOTO /data/device-status
ASSERT_STATUS 200
ASSERT_NOT_VISIBLE "Only the last 31 days are listed here."

// Without a limit the readings are paged 50 at a time, under a box of how many there are over every page, and when
// the earliest and latest of them were
GOTO /data/glucose
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Showing 1 to 50
ASSERT_VISIBLE #site--glucose--next
ASSERT_TEXT_VISIBLE glucose readings
// The earliest and latest are days, without their times: the backfilled day before is days ago, Yesterday unless the
// first 30 minutes began before midnight, when it is the day before that
ASSERT_VISIBLE #site--glucose--earliest:text-matches("^(Yesterday|[A-Z][a-z]{2} \\d{1,2} [A-Z][a-z]{2})$")
ASSERT_TEXT_EQUALS #site--glucose--latest Today
ASSERT_VISIBLE #site--glucose--earliest--ago:has-text("day")
ASSERT_VISIBLE #site--glucose--totals
SCREENSHOT glucose_totals

// The next page is the next 50 older readings, under the same totals
CLICK #site--glucose--next
ASSERT_COUNT #glucoseReadingsTable tbody tr:not([data-empty]) 50
ASSERT_VISIBLE #site--glucose--totals
ASSERT_VISIBLE #site--glucose--newest

// A page of a collection with nothing in it counts none, with no times
GOTO /data/activities
ASSERT_STATUS 200
ASSERT_TEXT_EQUALS #site--activity--total 0
ASSERT_TEXT_VISIBLE activities
ASSERT_NOT_VISIBLE #site--activity--earliest
ASSERT_NOT_VISIBLE #site--activity--latest
SCREENSHOT activities_totals_empty
