INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
ASSERT_PATH /settings/connectors
// The page listens for its syncs' changes, shown Live beside its title
ASSERT_VISIBLE #mainForm h1 + #site--settings--connectors--live

CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated

// Without going to the page again, its status shows the sync as it runs
RUN_BACKGROUND_JOBS
ASSERT_VISIBLE #site--settings--virtual-connector--status--last-success:has-text("just now")
ASSERT_VISIBLE #site--settings--virtual-connector--status--totals:has-text("1 worked")
// with the records it pulled in, in all and in its last sync
ASSERT_VISIBLE #site--settings--virtual-connector--status--records >> text=/^[1-9][0-9]*$/
ASSERT_VISIBLE #site--settings--virtual-connector--status--last-records >> text=/^[1-9][0-9]* records$/

// A history opened while the page is being read again, before what it reads lands, stays open as a backfill finishes,
// and shows it
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
HOLD /settings/connectors
RUN_BACKGROUND_JOBS
ASSERT_HELD /settings/connectors
CLICK #site--settings--virtual-connector--history summary
RELEASE /settings/connectors
ASSERT_VISIBLE #site--settings--virtual-connector--status--backfill:has-text("records in")
ASSERT_VISIBLE #site--settings--virtual-connector--history[open]:has-text("Connector backfilled")
SCREENSHOT connectors_live
