// Every page's footer links to contact, the support email, the terms of service, privacy policy and API docs, each
// opening in a new tab
GOTO {{ server_url }}/
ASSERT_STATUS 200
ASSERT_VISIBLE #footer
ASSERT_VISIBLE #footer--contact[href="mailto:nighttroop@t1d.nz"][target="_blank"]
// This server has no feedback link, see feedback/links.bdd for one that has
ASSERT_NOT_VISIBLE #footer--feedback
ASSERT_NOT_VISIBLE #public--feedback
ASSERT_TEXT_VISIBLE Nighttroop 2026
SCREENSHOT footer

// The terms and privacy policy are generated from their Markdown, with the support email in place
CLICK #footer--terms
ASSERT_NEW_PAGE
ASSERT_PATH /terms
ASSERT_TEXT_VISIBLE TERMS OF SERVICE
ASSERT_VISIBLE #legal a[href="mailto:nighttroop@t1d.nz"] >> nth=0
ASSERT_NOT_VISIBLE #legal >> text=SUPPORT_EMAIL
SCREENSHOT terms

CLICK #footer--privacy
ASSERT_NEW_PAGE
ASSERT_PATH /privacy
ASSERT_TEXT_VISIBLE Consent by Sending Data
ASSERT_VISIBLE #legal a[href="mailto:nighttroop@t1d.nz"] >> nth=0
SCREENSHOT privacy

// The API docs, generated from the OpenAPI schema, list each endpoint, link to it and to the schemas it uses, and link
// to download the schema
CLICK #footer--api-docs
ASSERT_NEW_PAGE
ASSERT_PATH /api-docs
ASSERT_VISIBLE #api-docs h1:has-text("Nighttroop API")
ASSERT_VISIBLE #api-docs--download[href="/openapi.json"]
CLICK #api-docs a[href="#Login"]
ASSERT_VISIBLE #Login h2:has-text("POST /login")
ASSERT_TEXT_VISIBLE Signs an admin
CLICK #Login a[href="#schema-LoginToken"]
ASSERT_VISIBLE #schema-LoginToken
SCREENSHOT api_docs

// A site's pages have the footer too, linking to the site's own copies
INCLUDE steps/new_site_admin.steps
ASSERT_VISIBLE #footer
CLICK #footer--privacy
ASSERT_NEW_PAGE
ASSERT_PATH /privacy
ASSERT_TEXT_VISIBLE PRIVACY POLICY
CLICK #footer--api-docs
ASSERT_NEW_PAGE
ASSERT_PATH /api-docs
ASSERT_VISIBLE #api-docs h1:has-text("Nighttroop API")
