GOTO {{ server_url}}/
ASSERT_STATUS           200
SCREENSHOT home

CLICK "Create Site"
ASSERT_STATUS 200
SCREENSHOT site_create

// Login is offered once a code from the authenticator app has been checked
INPUT #public--site-info--totp 123123
CLICK #public--totp-check-button
ASSERT_VISIBLE #public--totp-checked
CLICK #public--login-button
ASSERT_NEW_PAGE
SCREENSHOT site_login

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200
SCREENSHOT site_login_totp

ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"
SCREENSHOT site_home

// The menu says who is signed in and links to each settings page, every item
// fitting in the menu, none hidden below where it scrolls
CLICK #site--settings-menu
ASSERT_TEXT_VISIBLE Signed in as
ASSERT_VISIBLE #site--data--temp-basals-button
ASSERT_VISIBLE #site--settings--identities-button
ASSERT_VISIBLE #site--settings--sync-button
ASSERT_VISIBLE #site--settings--logout-button
SCREENSHOT site_settings_menu

CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /settings/sync

ASSERT_VISIBLE #site--settings--nightscout-sync--enable
ASSERT_VISIBLE #site--settings--nightscout-sync--url
ASSERT_VISIBLE #site--settings--nightscout-sync--password
ASSERT_VISIBLE #site--settings--nightscout-sync--delete
ASSERT_VISIBLE #site--settings--nightscout-sync--submit

INPUT #site--settings--nightscout-sync--url         http://will_not_pass_the_test.test
INPUT #site--settings--nightscout-sync--password    not_a_token
// Typing turned it on; it stays off here, as its details do not work
CLICK #site--settings--nightscout-sync--enable

CLICK #site--settings--nightscout-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
CLICK #site--settings--virtual-sync--enable
CLICK #site--settings--virtual-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

CLICK #site--nav--home
ASSERT_NEW_URL
ASSERT_PATH /
ASSERT_VISIBLE "Nighttroop"
SCREENSHOT site_summary_virtual
