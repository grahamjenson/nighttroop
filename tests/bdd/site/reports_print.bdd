INCLUDE steps/new_site_admin.steps

// The virtual connector fills its last 30 minutes, and each backfill the day before its oldest reading
CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--connectors-button
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
RUN_BACKGROUND_JOBS
GOTO /reports
CLICK #site--summaries--regenerate
ASSERT_TEXT_VISIBLE Regenerating summaries
RUN_BACKGROUND_JOBS

// The Summaries report opens the printable report in a tab of its own, with none of the site's header
GOTO /reports
CLICK #site--summaries--print
ASSERT_NEW_PAGE
ASSERT_PATH /reports/print
ASSERT_TITLE Report · Nighttroop
ASSERT_NOT_VISIBLE #site--nav--reports
ASSERT_NOT_VISIBLE #site--settings-menu
// Each of this month so far and the 3 months before it is an overview and an AGP report, on a sheet of its own
// The report is long, so its last page is waited for before its pages are counted
ASSERT_VISIBLE #site--print>section:nth-of-type(8)>footer
ASSERT_COUNT #site--print > section 8
// Each page is laid out as Dexcom Clarity's: its report's name, over how many days it is of and its first and last,
// this month's to today
// This month first
ASSERT_TEXT_EQUALS #site--print>section:nth-of-type(1)>header>div>h1 Overview
ASSERT_VISIBLE #site--print>section:nth-of-type(1) .site--print--dates >> text=/^\d+ days • \w{3} 1 \w{3} \d{4} – \w{3} \d+ \w{3} \d{4}$/
ASSERT_TEXT_EQUALS #site--print>section:nth-of-type(2)>header>div>h1 AGP
// with Nighttroop's logo saying it generated it, and at its foot its number and when it was generated
ASSERT_COUNT #site--print > section >> text=Generated by Nighttroop 8
ASSERT_TEXT_EQUALS #site--print>section:nth-of-type(1)>footer>span>.site--print--page 1 of 8
ASSERT_TEXT_EQUALS #site--print>section:nth-of-type(2)>footer>span>.site--print--page 2 of 8
ASSERT_COUNT .site--print--generated 8
ASSERT_VISIBLE .site--print--generated >> nth=0 >> text=/^Generated at: \w{3} \d+ \w{3} \d{4} \d\d:\d\d$/
// This month has the glucose the connector filled, with nothing in the report to click away to
ASSERT_VISIBLE #site--print>section:nth-of-type(1) #site--overview--mean >> text=/^\d+\.\d$/
ASSERT_DRAWN #site--print>section:nth-of-type(2) #site--reports--agp
ASSERT_COUNT #site--print a 0
ASSERT_VISIBLE #site--print--print
SCREENSHOT reports_print

// Printed, each sheet starts a page of its own, with no print button or grey around it
MEDIA print
ASSERT_NOT_VISIBLE #site--print--print
SCREENSHOT reports_print_printed
