INCLUDE steps/new_site_admin.steps
ASSERT_PATH /

// The Reports hub opens on the summaries, a table of each period's kept summaries, which a new site has none of
CLICK #site--nav--reports
ASSERT_STATUS 200
ASSERT_PATH /reports
ASSERT_VISIBLE #site--reports--summaries-button[aria-current="page"]
ASSERT_TITLE Summaries · Nighttroop
ASSERT_VISIBLE #site--summaries--day >> text=No days kept yet.
ASSERT_VISIBLE #site--summaries--month >> text=No months kept yet.
// Each says when its first will show, as a new site has nothing to show yet
ASSERT_VISIBLE #site--summaries--day >> text=the first shows the day after readings arrive
// It shows this month, whose next has not come, and goes back a month at a time to a past month, saying what it has
// none of
ASSERT_DRAWN #site--summaries--next[disabled]
CLICK #site--summaries--previous
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_VISIBLE #site--summaries--day >> text=/^No days kept in \w+ \d{4}\.$/
CLICK #site--summaries--next
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /reports/summaries
ASSERT_VISIBLE #site--summaries--day >> text=No days kept yet.
// A month after this one, or more than a year ago, is refused
GOTO /reports/summaries?month=2000-01
ASSERT_STATUS 400
GOTO /reports
ASSERT_STATUS 200

// The virtual connector fills its last 30 minutes, and a backfill the day before it (tests backfill a day)
CLICK #site--settings-menu
CLICK #site--nav--menu--connectors
ASSERT_STATUS 200
CLICK #site--settings--virtual-connector--enable
CLICK #site--settings--virtual-connector--submit
ASSERT_TEXT_VISIBLE Connector Updated
RUN_BACKGROUND_JOBS
CLICK #site--settings--virtual-connector--backfill
ASSERT_TEXT_VISIBLE Backfilling Virtual
RUN_BACKGROUND_JOBS

// An admin regenerates the summaries, after confirming (the test accepts), which a background job builds again from
// the site's data, so yesterday is kept, with its numbers, and opens its AGP report
GOTO /reports
// It is offered below the summaries, saying when it is wanted, not beside the page's title as its main action
ASSERT_VISIBLE #site--summaries--maintenance >> text=Summaries look wrong
ASSERT_VISIBLE #site--summaries--maintenance #site--summaries--regenerate
SCROLL 3000
SCREENSHOT summaries_regenerate
CLICK #site--summaries--regenerate
ASSERT_TEXT_VISIBLE Regenerating summaries
RUN_BACKGROUND_JOBS
// Yesterday's month, which on the 1st is the month before
GOTO /reports/summaries?month={{ slice (date -1) 0 7 }}
ASSERT_STATUS 200
ASSERT_VISIBLE #site--summaries--day tbody tr:has(a[href="/reports/agp/day-{{ date -1 }}"]) td:nth-child(2):text-is("1")
// Its time below range, in range and above range
ASSERT_VISIBLE #site--summaries--day thead th:nth-child(3):text-is("Below range")
ASSERT_VISIBLE #site--summaries--day thead th:nth-child(5):text-is("Above range")
ASSERT_VISIBLE #site--summaries--day tbody tr:has(a[href="/reports/agp/day-{{ date -1 }}"]) td:nth-child(3) >> text=/^(\d+%|<1%)$/
ASSERT_VISIBLE #site--summaries--day tbody tr:has(a[href="/reports/agp/day-{{ date -1 }}"]) td:nth-child(4) >> text=/^(\d+%|<1%)$/
ASSERT_VISIBLE #site--summaries--day tbody tr:has(a[href="/reports/agp/day-{{ date -1 }}"]) td:nth-child(5) >> text=/^(\d+%|<1%)$/
SCREENSHOT summaries
// The newest day kept is yesterday
CLICK #site--summaries--day tbody tr:first-child a
ASSERT_PATH /reports/agp/day-{{ date -1 }}
ASSERT_TEXT_EQUALS #site--reports--days 1
