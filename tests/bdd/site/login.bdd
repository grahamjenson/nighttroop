GOTO {{ server_url}}/
ASSERT_STATUS           200
ASSERT_VISIBLE          "Create Site"
ASSERT_TEXT_EQUALS      #create-site-button Create Site

CLICK "Create Site"
ASSERT_STATUS 200
SET token #token
SET site #subdomain

CLICK #login-button
ASSERT_NEW_PAGE

// PUT IN THE WRONG password
ASSERT_VISIBLE #name
ASSERT_VISIBLE #password
INPUT #name admin
INPUT #password wrongpassword

CLICK #login-button
ASSERT_STATUS 401

// PUT IN THE WRONG TOTP 
ASSERT_VISIBLE #name
ASSERT_VISIBLE #password
INPUT #name admin
INPUT #password password

CLICK #login-button
ASSERT_STATUS 200
ASSERT_VISIBLE #otp-1

CLICK #login-button
ASSERT_STATUS 401

// PUT IN THE CORRECT LOGIN
ASSERT_VISIBLE #otp-1
INPUT #otp-1 123123

CLICK #login-button
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"


