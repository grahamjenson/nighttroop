GOTO {{ server_url}}/
ASSERT_STATUS           200
ASSERT_VISIBLE          "Create Site"
ASSERT_VISIBLE          #public--logo
ASSERT_TEXT_EQUALS      #public--create-site-button Create Site

SCREENSHOT create_site

CLICK "Create Site"
ASSERT_STATUS 200

// The new site's two steps are the page, under a smaller logo and name
ASSERT_NOT_VISIBLE #public--features
ASSERT_VISIBLE #public--logo
ASSERT_VISIBLE #public--copy-button
SCREENSHOT site_created

// The TOTP secret is only the QR code, the phone's token is not shown, only copied, and the copy buttons say when they
// have copied
ASSERT_NOT_VISIBLE #public--site-info--totp-secret
ASSERT_VISIBLE #qrcode
// The QR code holds the otpauth:// URI an authenticator app adds an account from, not the bare secret it can't
ASSERT_VISIBLE #qrcode[title^="otpauth://totp/Nighttroop:admin@"][title*="?issuer=Nighttroop&secret="]
// Under it, it says to scan it with an authenticator app, linking to a few in new tabs
ASSERT_TEXT_EQUALS #public--site-info--authenticator Scan with an authenticator app, such as Google Authenticator, Microsoft Authenticator or 2FAS
ASSERT_VISIBLE #public--site-info--authenticator--google[target="_blank"]
ASSERT_VISIBLE #public--site-info--authenticator--microsoft[target="_blank"]
ASSERT_VISIBLE #public--site-info--authenticator--2fas[target="_blank"]
ASSERT_NOT_VISIBLE #public--site-info--ns-token
CLICK #public--copy-ns-token
ASSERT_VISIBLE #public--copy-ns-token>span[data-copy-icon-check]
CLICK #public--copy-button
ASSERT_VISIBLE #public--copy-button>span[data-copy-icon-check]

// Login is disabled until a code from the authenticator app matches the TOTP secret, and a wrong code says so. A code is
// checked as soon as its sixth digit is typed, with no click
ASSERT_DRAWN #public--login-button[disabled]
TYPE #public--site-info--totp 000000
ASSERT_VISIBLE #public--totp-failed
ASSERT_DRAWN #public--login-button[disabled]
SCREENSHOT totp_check_failed
PRESS Control+a
PRESS Backspace
TYPE #public--site-info--totp 123123
ASSERT_VISIBLE #public--totp-checked
ASSERT_NOT_VISIBLE #public--login-button[disabled]
SCREENSHOT totp_checked
CLICK #public--login-button
ASSERT_NEW_PAGE
ASSERT_PATH /login

// PUT IN THE WRONG password
ASSERT_VISIBLE #site--login--name
ASSERT_VISIBLE #site--login--password
// Password managers fill the name and password, and the code later is one-time, never a name
ASSERT_VISIBLE #site--login--name[autocomplete="username"]
ASSERT_VISIBLE #site--login--password[autocomplete="current-password"]
INPUT #site--login--name admin
INPUT #site--login--password wrongpassword

CLICK #site--login-button
ASSERT_STATUS 401

// PUT IN THE WRONG TOTP 
ASSERT_VISIBLE #site--login--name
ASSERT_VISIBLE #site--login--password
INPUT #site--login--name admin
INPUT #site--login--password password


CLICK #site--login-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--login--otp-1
ASSERT_VISIBLE #site--login--otp-1[autocomplete="one-time-code"]
ASSERT_PATH /login

CLICK #site--login-totp-button
ASSERT_STATUS 401
ASSERT_PATH /login

// PUT IN THE CORRECT LOGIN
ASSERT_VISIBLE #site--login-totp-button
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"
ASSERT_VISIBLE #site--nav--logo
ASSERT_PATH /


