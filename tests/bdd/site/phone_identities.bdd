INCLUDE steps/new_site_admin.steps

// On a phone the Add User and Add Device forms wrap in their cards, so every input can be seen and tapped, and the
// page is no wider than the window. The window is tall enough for the whole page, so fitting it checks only its width.
WINDOW 390x1600
CLICK #site--settings-menu
CLICK #site--settings--identities-button
ASSERT_STATUS 200
ASSERT_PATH /settings/identities
ASSERT_VISIBLE #name-createIdentityFormusersTable
ASSERT_VISIBLE #select-form-createIdentityFormusersTable
ASSERT_VISIBLE #name-createIdentityFormdevicesTable
ASSERT_VISIBLE #client-createIdentityFormdevicesTable
ASSERT_VISIBLE #select-form-createIdentityFormdevicesTable
ASSERT_VISIBLE #createIdentityFormdevicesTable button[type=submit]
ASSERT_FITS
SCREENSHOT identities_phone

// A device is added from the wrapped form
INPUT #name-createIdentityFormdevicesTable kitchen
CLICK "Add Device"
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE I Have Saved These
