INCLUDE steps/new_site_admin.steps

// On a phone the Add User form wraps in its card, and Add Device is in its card, so every input can be seen and
// tapped, and the page is no wider than the window. The window is tall enough for the whole page, so fitting it checks only its width.
WINDOW 390x1800
CLICK #site--settings-menu
CLICK #site--nav--menu--settings
CLICK #site--settings--identities-button
ASSERT_STATUS 200
ASSERT_PATH /settings/identities
ASSERT_VISIBLE #site--identities--add-user-button
ASSERT_VISIBLE #site--identities--add-device-button
// What each role can do is a block for each role, read in full with nothing cut off: the last cell of the role with
// the most to say is in view
ASSERT_VISIBLE #site--identities--role--device_read_write td >> nth=1 >> text=Cannot change readings.
ASSERT_VISIBLE #site--identities--role--device_read_write td >> nth=3 >> text=api:settings:*
ASSERT_FITS
SCREENSHOT identities_phone

// A device is added from the modal, which shows whole in the window with no scrolling. In a short window its
// credentials fill the window, scrolling, over the header, so their top can be read
WINDOW 390x640
CLICK #site--identities--add-device-button
ASSERT_CONTAINED #site--identities--add-device--submit
ASSERT_VISIBLE #site--identities--add-device--name
SCREENSHOT add_device_phone
CLICK #site--identities--add-device--form label:has(#site--identities--add-device--client-other)
INPUT #site--identities--add-device--name kitchen
CLICK #site--identities--add-device--submit
ASSERT_STATUS 201
ASSERT_TEXT_VISIBLE I Have Saved These
ASSERT_VISIBLE "Save this information in a secure place"
ASSERT_VISIBLE #site--identities--created--username
SCREENSHOT credentials_phone
