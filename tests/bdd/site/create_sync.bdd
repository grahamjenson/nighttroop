GOTO {{ server_url}}/
ASSERT_STATUS           200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #login-button
ASSERT_NEW_PAGE

INPUT #name admin
INPUT #password password

CLICK #login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #otp-1
INPUT #otp-1 123123

CLICK #login-button
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"



