GOTO {{ server_url}}/
ASSERT_STATUS           200

CLICK "Create Site"
ASSERT_STATUS 200

CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button

CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /settings/sync

ASSERT_VISIBLE #site--settings--nightscout-sync--enable
ASSERT_VISIBLE #site--settings--nightscout-sync--url
ASSERT_VISIBLE #site--settings--nightscout-sync--password
ASSERT_VISIBLE #site--settings--nightscout-sync--delete
ASSERT_VISIBLE #site--settings--nightscout-sync--submit

INPUT #site--settings--nightscout-sync--url         http://will_not_pass_the_test.test
INPUT #site--settings--nightscout-sync--password    not_a_token

CLICK #site--settings--nightscout-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
// Turn syncing on with details that do not work: saving no longer checks them,
// the first sync does, and it turns syncing off and says why
CLICK #site--settings--nightscout-sync--enable
CLICK #site--settings--nightscout-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

RUN_BACKGROUND_JOBS

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button

CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--nightscout-sync--errors
ASSERT_TEXT_VISIBLE The first sync failed, so syncing has been turned off
// Its status says when it failed and that it now syncs less often because of the error
ASSERT_TEXT_EQUALS #site--settings--nightscout-sync--status--last-success Never
ASSERT_TEXT_EQUALS #site--settings--nightscout-sync--status--last-failure just now
ASSERT_TEXT_EQUALS #site--settings--nightscout-sync--status--interval 120 s (Error response)
// The Dexcom region looks like the inputs beside it, not greyed out as if it could not be changed
ASSERT_VISIBLE #dex_region
ASSERT_NOT_VISIBLE .bg-gray-100:has(#dex_region)
SCREENSHOT sync_first_sync_failed

// Deleting a source leaves the page in place, with the source's form rendered unset again
CLICK #site--settings--nightscout-sync--delete
ASSERT_TEXT_VISIBLE Sync Deleted
ASSERT_PATH /settings/sync
ASSERT_TEXT_VISIBLE Sync Settings
ASSERT_NOT_VISIBLE #site--settings--nightscout-sync--errors
ASSERT_VISIBLE #site--settings--nightscout-sync--url:not([value*="will_not_pass"])
