GOTO {{ server_url}}/
ASSERT_STATUS           200

CLICK "Create Site"
ASSERT_STATUS 200

// Login is offered once a code from the authenticator app has been checked
INPUT #public--site-info--totp 123123
CLICK #public--totp-check-button
ASSERT_VISIBLE #public--totp-checked
CLICK #public--login-button
ASSERT_NEW_PAGE

INPUT #site--login--name admin
INPUT #site--login--password password

CLICK #site--login-button
ASSERT_STATUS 200

ASSERT_VISIBLE #site--login--otp-1
TYPE #site--login--otp-1 123123
ASSERT_NEW_URL
ASSERT_VISIBLE "Nighttroop"

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button

CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_NEW_URL
ASSERT_PATH /settings/sync

// A test server offers virtual sync, which makes up glucose; a production server does not, which
// TestVirtualSyncIsOnlyOnDevelopmentTestAndStaging checks
ASSERT_VISIBLE #site--settings--virtual-sync--enable
ASSERT_VISIBLE #site--settings--virtual-sync--submit
SCREENSHOT virtual_sync_offered_on_test_server

ASSERT_VISIBLE #site--settings--nightscout-sync--enable
ASSERT_VISIBLE #site--settings--nightscout-sync--url
ASSERT_VISIBLE #site--settings--nightscout-sync--password
ASSERT_VISIBLE #site--settings--nightscout-sync--delete
ASSERT_VISIBLE #site--settings--nightscout-sync--submit

// Typing a new source's details turns it on, as it is easy to forget; unticking it then keeps it off while typing on
INPUT #site--settings--nightscout-sync--url         http://will_not_pass_the_test.test
CLICK #site--settings--nightscout-sync--url
ASSERT_VISIBLE #site--settings--nightscout-sync--enable:checked
CLICK #site--settings--nightscout-sync--enable
ASSERT_VISIBLE #site--settings--nightscout-sync--enable:not(:checked)
INPUT #site--settings--nightscout-sync--password    not_a_token
CLICK #site--settings--nightscout-sync--url
ASSERT_VISIBLE #site--settings--nightscout-sync--enable:not(:checked)

CLICK #site--settings--nightscout-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated
// Turn syncing on with details that do not work: saving no longer checks them,
// the first sync does, and it turns syncing off and says why
CLICK #site--settings--nightscout-sync--enable
CLICK #site--settings--nightscout-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

RUN_BACKGROUND_JOBS

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button

CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--nightscout-sync--errors
ASSERT_TEXT_VISIBLE The first sync failed, so syncing has been turned off
// Its status says when it failed and that it now syncs less often because of the error
ASSERT_TEXT_EQUALS #site--settings--nightscout-sync--status--last-success Never
ASSERT_TEXT_EQUALS #site--settings--nightscout-sync--status--last-failure just now
ASSERT_TEXT_EQUALS #site--settings--nightscout-sync--status--interval 2 min (Error response)
// The Dexcom region looks like the inputs beside it, not greyed out as if it could not be changed
ASSERT_VISIBLE #site--settings--dexcom-sync--region
ASSERT_NOT_VISIBLE .bg-gray-100:has(#site--settings--dexcom-sync--region)
SCREENSHOT sync_first_sync_failed

// Deleting a source leaves the page in place, with the source's form rendered unset again
CLICK #site--settings--nightscout-sync--delete
ASSERT_TEXT_VISIBLE Sync Deleted
ASSERT_PATH /settings/sync
ASSERT_TITLE Sync · Nighttroop
ASSERT_NOT_VISIBLE #site--settings--nightscout-sync--errors
ASSERT_VISIBLE #site--settings--nightscout-sync--url:not([value*="will_not_pass"])

// The Dexcom region is picked from a list like the Libre region, starting outside the United States
ASSERT_VISIBLE #site--settings--dexcom-sync--enable
ASSERT_VISIBLE #site--settings--dexcom-sync--username
ASSERT_VISIBLE #site--settings--dexcom-sync--password
ASSERT_VISIBLE #site--settings--dexcom-sync--delete
ASSERT_VISIBLE #site--settings--dexcom-sync--submit
ASSERT_VISIBLE #site--settings--dexcom-sync--region:has(option[value="OUS"]:checked)

INPUT #site--settings--dexcom-sync--username valid-dexcom-user
INPUT #site--settings--dexcom-sync--password dex-pass
INPUT #site--settings--dexcom-sync--region US
CLICK #site--settings--dexcom-sync--username
ASSERT_VISIBLE #site--settings--dexcom-sync--enable:checked
CLICK #site--settings--dexcom-sync--submit
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE Sync Updated

CLICK #site--settings-menu
ASSERT_VISIBLE #site--settings--sync-button
CLICK #site--settings--sync-button
ASSERT_STATUS 200
ASSERT_VISIBLE #site--settings--dexcom-sync--username[value="valid-dexcom-user"]
ASSERT_VISIBLE #site--settings--dexcom-sync--region:has(option[value="US"]:checked)
SCREENSHOT dexcom_sync_saved

// Deleting renders the Dexcom form unset again, back outside the United States
CLICK #site--settings--dexcom-sync--delete
ASSERT_TEXT_VISIBLE Sync Deleted
ASSERT_VISIBLE #site--settings--dexcom-sync--username:not([value*="valid-dexcom"])
ASSERT_VISIBLE #site--settings--dexcom-sync--region:has(option[value="OUS"]:checked)
