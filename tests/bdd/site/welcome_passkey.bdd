// A new site's welcome page offers to log in with a passkey instead of an authenticator app, beside Login
GOTO {{ server_url }}/
ASSERT_STATUS 200
CLICK "Create Site"
ASSERT_STATUS 200
ASSERT_PATH /welcome
ASSERT_VISIBLE #public--copy-button
ASSERT_VISIBLE #public--passkey-login-button
ASSERT_DRAWN #public--login-button[disabled]
SCROLL 2000
SCREENSHOT welcome_passkey

// The browser has a passkey authenticator, as a phone has, that verifies the person itself. The passkey is made on the
// site's own address, for its admin, and logs the admin in with no password or code
VIRTUAL_AUTHENTICATOR
CLICK #public--passkey-login-button
ASSERT_NEW_URL
ASSERT_PATH /
ASSERT_VISIBLE #site--summary

// It is the admin's passkey, on My Account, and signs the admin back in once signed out
CLICK #site--settings-menu
CLICK #site--settings--account-button
ASSERT_STATUS 200
ASSERT_TEXT_VISIBLE You are signed in as admin
ASSERT_VISIBLE #site--account--passkeys >> text=Not used yet
CLICK #site--settings-menu
CLICK #site--settings--logout-button
ASSERT_NEW_URL
ASSERT_PATH /login
CLICK #site--login--passkey
ASSERT_NEW_URL
ASSERT_PATH /
ASSERT_VISIBLE #site--summary
