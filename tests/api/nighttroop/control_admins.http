INCLUDE steps/control_login.steps

// An admin adds another, whose password and TOTP secret are shown this once
NAME add_admin
POST http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"name": "api_carol", "role": "read"}
ASSERT_STATUS 201
ASSERT_EQUALS "api_carol" "@result.name"
ASSERT_EXISTS "@result.password"
ASSERT_EXISTS "@result.totp_secret"

// Names are unique, and an admin needs a name and a role control has
NAME add_admin_again
POST http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"name": "api_carol", "role": "read"}
ASSERT_STATUS 409

NAME add_admin_unknown_role
POST http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"name": "api_dave", "role": "owner"}
ASSERT_STATUS 400

NAME add_admin_no_name
POST http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"name": "  ", "role": "read"}
ASSERT_STATUS 400

// The admins are listed newest first, with who made them, never their secrets
NAME list_admins
GET http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"
ASSERT_EQUALS "api_carol" "@result.0.name"
ASSERT_EQUALS "read" "@result.0.role"
ASSERT_EQUALS "admin" "@result.0.created_by_identity_name"
ASSERT_EQUALS null "@result.0.password_hash"
ASSERT_EQUALS null "@result.0.totp_secret_enc"
ASSERT_EQUALS "admin" "@result.1.name"
SET carol_id {{ (index .list_admins.result 0).id }}
SET admin_id {{ (index .list_admins.result 1).id }}

// The new admin signs in, but read only it cannot manage the admins
NAME carol_login
POST http://control.localhost/login
H Accept: application/json
B {"name": "api_carol", "password": "{{ .add_admin.result.password }}", "totp": "123123"}
ASSERT_STATUS 200

NAME read_only_cannot_add
POST http://control.localhost/admins
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
H Content-Type: application/json
B {"name": "api_dave", "role": "admin"}
ASSERT_STATUS 403

NAME read_only_cannot_delete
DELETE http://control.localhost/admins/{{ .admin_id }}
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

// Nor can it change the server or its sites, or download a DB, though it can see them
NAME read_only_cannot_reset_totp
POST http://control.localhost/admins/{{ .admin_id }}/totp
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_create_site
POST http://control.localhost/sites
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_change_settings
POST http://control.localhost/settings
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_update_site
POST http://control.localhost/sites/abcdefgh
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_truncate_site
POST http://control.localhost/sites/abcdefgh/truncate
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_download_site_db
GET http://control.localhost/sites/abcdefgh/db
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_reset_site_password
POST http://control.localhost/sites/abcdefgh/identities/1/password
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_reset_site_totp
POST http://control.localhost/sites/abcdefgh/identities/1/totp
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_assume_site_identity
POST http://control.localhost/sites/abcdefgh/identities/1/assume
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_set_rate_limits
POST http://control.localhost/rate-limits
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_download_logs_db
GET http://control.localhost/logs-db
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

// Nor can it add or delete push credentials, or open the form to add one, or send a test push, though it can see them
NAME read_only_cannot_open_push_credential_form
GET http://control.localhost/push-credentials/new
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_add_push_credential
POST http://control.localhost/push-credentials
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
H Content-Type: application/json
B {"site_id": "abcdefgh", "name": "My Loop", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "secret": "not a key"}
ASSERT_STATUS 403

NAME read_only_cannot_delete_push_credential
DELETE http://control.localhost/push-credentials/1
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_cannot_send_test_push
POST http://control.localhost/push-devices/1/test
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 403

NAME read_only_can_see_push_credentials
GET http://control.localhost/push-credentials
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 200

NAME read_only_can_see_push_devices
GET http://control.localhost/push-devices
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 200

NAME read_only_can_see_rate_limits
GET http://control.localhost/rate-limits
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 200

// An admin cannot delete, demote or reset themselves, so control always has an admin who can sign in
NAME cannot_delete_yourself
DELETE http://control.localhost/admins/{{ .admin_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 403

NAME cannot_demote_yourself
POST http://control.localhost/admins/{{ .admin_id }}/role
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"role": "read"}
ASSERT_STATUS 403

NAME cannot_reset_yourself
POST http://control.localhost/admins/{{ .admin_id }}/password
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 403

// Making another an admin signs them out, as their sign in was for their old role
NAME make_carol_admin
POST http://control.localhost/admins/{{ .carol_id }}/role
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"role": "admin"}
ASSERT_STATUS 200
ASSERT_EQUALS "admin" "@result.role"

NAME carol_old_sign_in_refused
GET http://control.localhost/admins
H Authorization: Bearer {{ .carol_login.token }}
H Accept: application/json
ASSERT_STATUS 401

NAME carol_login_as_admin
POST http://control.localhost/login
H Accept: application/json
B {"name": "api_carol", "password": "{{ .add_admin.result.password }}", "totp": "123123"}
ASSERT_STATUS 200

NAME list_admins_changed
GET http://control.localhost/admins
H Authorization: Bearer {{ .carol_login_as_admin.token }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "admin" "@result.0.role"
ASSERT_EQUALS "admin" "@result.0.updated_by_identity_name"

// With two admins, either can make the other read only, and back
NAME carol_demotes_admin
POST http://control.localhost/admins/{{ .admin_id }}/role
H Authorization: Bearer {{ .carol_login_as_admin.token }}
H Accept: application/json
H Content-Type: application/json
B {"role": "read"}
ASSERT_STATUS 200

NAME carol_promotes_admin
POST http://control.localhost/admins/{{ .admin_id }}/role
H Authorization: Bearer {{ .carol_login_as_admin.token }}
H Accept: application/json
H Content-Type: application/json
B {"role": "admin"}
ASSERT_STATUS 200

NAME admin_login_again
POST http://control.localhost/login
H Accept: application/json
B {"name": "admin", "password": "password", "totp": "123123"}
ASSERT_STATUS 200
SET control_jwt {{ .admin_login_again.token }}

// Another's password and TOTP can be reset, each shown once, and each reset signs them out
NAME reset_carol_password
POST http://control.localhost/admins/{{ .carol_id }}/password
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "api_carol" "@result.name"
ASSERT_EXISTS "@result.password"
ASSERT_EQUALS null "@result.totp_secret"

NAME carol_signed_out_by_password_reset
GET http://control.localhost/admins
H Authorization: Bearer {{ .carol_login_as_admin.token }}
H Accept: application/json
ASSERT_STATUS 401

// The admin who reset them is still signed in, and carol signs in again with the new password
NAME admin_still_signed_in
GET http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME carol_login_new_password
POST http://control.localhost/login
H Accept: application/json
B {"name": "api_carol", "password": "{{ .reset_carol_password.result.password }}", "totp": "123123"}
ASSERT_STATUS 200

NAME carol_new_sign_in_works
GET http://control.localhost/admins
H Authorization: Bearer {{ .carol_login_new_password.token }}
H Accept: application/json
ASSERT_STATUS 200

NAME reset_carol_totp
POST http://control.localhost/admins/{{ .carol_id }}/totp
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EXISTS "@result.totp_secret"
ASSERT_EQUALS null "@result.password"

NAME carol_signed_out_by_totp_reset
GET http://control.localhost/admins
H Authorization: Bearer {{ .carol_login_new_password.token }}
H Accept: application/json
ASSERT_STATUS 401

NAME carol_login_new_totp
POST http://control.localhost/login
H Accept: application/json
B {"name": "api_carol", "password": "{{ .reset_carol_password.result.password }}", "totp": "123123"}
ASSERT_STATUS 200

// A role control does not have is refused
NAME unknown_role
POST http://control.localhost/admins/{{ .carol_id }}/role
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
H Content-Type: application/json
B {"role": "owner"}
ASSERT_STATUS 400

// Deleting another signs them out, and they are gone
NAME delete_carol
DELETE http://control.localhost/admins/{{ .carol_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "api_carol" "@result.name"

NAME carol_signed_out
GET http://control.localhost/admins
H Authorization: Bearer {{ .carol_login_new_totp.token }}
H Accept: application/json
ASSERT_STATUS 401

NAME list_admins_after_delete
GET http://control.localhost/admins
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"

NAME delete_carol_again
DELETE http://control.localhost/admins/{{ .carol_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME delete_not_an_id
DELETE http://control.localhost/admins/notanid
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404
