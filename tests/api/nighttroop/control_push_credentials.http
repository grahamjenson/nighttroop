// The control site's admin adds push credentials to any site, lists every site's and deletes any, never with secrets
INCLUDE steps/new_site_admin.steps
INCLUDE steps/control_login.steps

// One for every site, with no site, is refused until the server limits what it can push to
NAME refuse_for_every_site
POST http://control.localhost/push-credentials
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"name": "Everyone's Loop", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "bundle_ids": ["com.TEAM123456.loopkit.Loop"], "secret": "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgofoAD0qFTDB8eVl2\nLKYt19HfOaUvrvTYGMMR98DDoDihRANCAAROFNjYuI2rlnHoAy4UP4PVhQiFxz1L\nSaETlxByVnuzazzPdJ6qtAO+GOvUV5lPZn62Rv3vFb9ozLi/OFfob09a\n-----END PRIVATE KEY-----\n"}
ASSERT_STATUS 400
ASSERT_CONTAINS "a credential for every site cannot be added" "@message"

NAME refuse_unknown_site
POST http://control.localhost/push-credentials
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"site_id": "nosuchsite", "name": "My Loop", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "secret": "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgofoAD0qFTDB8eVl2\nLKYt19HfOaUvrvTYGMMR98DDoDihRANCAAROFNjYuI2rlnHoAy4UP4PVhQiFxz1L\nSaETlxByVnuzazzPdJ6qtAO+GOvUV5lPZn62Rv3vFb9ozLi/OFfob09a\n-----END PRIVATE KEY-----\n"}
ASSERT_STATUS 400
ASSERT_CONTAINS "there is no live site with that ID" "@message"

// A site's is checked as its admin's is
NAME refuse_bad_p8
POST http://control.localhost/push-credentials
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"site_id": "{{ .create_new_site.site_subdomain }}", "name": "Bad", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "secret": "not a key"}
ASSERT_STATUS 400
ASSERT_CONTAINS "not a .p8 file" "@message"

NAME create_for_site
POST http://control.localhost/push-credentials
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"site_id": "{{ .create_new_site.site_subdomain }}", "name": "My Loop", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "bundle_ids": ["com.TEAM123456.loopkit.Loop"], "secret": "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgofoAD0qFTDB8eVl2\nLKYt19HfOaUvrvTYGMMR98DDoDihRANCAAROFNjYuI2rlnHoAy4UP4PVhQiFxz1L\nSaETlxByVnuzazzPdJ6qtAO+GOvUV5lPZn62Rv3vFb9ozLi/OFfob09a\n-----END PRIVATE KEY-----\n"}
ASSERT_STATUS 201
ASSERT_EXISTS "@result.site_id"
ASSERT_EQUALS "My Loop" "@result.name"
ASSERT_EQUALS "admin" "@result.created_by_identity_name"
ASSERT_EQUALS null "@result.secret"
SET credential_id {{ .create_for_site.result.id }}

// The control site lists every site's, newest first, never with their secrets
NAME control_lists
GET http://control.localhost/push-credentials
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "My Loop" "@result.0.name"
ASSERT_EXISTS "@result.0.site_id"
ASSERT_EQUALS null "@result.0.secret"

NAME control_gets
GET http://control.localhost/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "ABC123DEFG" "@result.key_id"
ASSERT_EQUALS null "@result.secret"

// The site's admin has it as their own
NAME site_lists
GET http://{{ site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "My Loop" "@result.name"

// Deleting it stops pushes using it, on the site too
NAME control_deletes
DELETE http://control.localhost/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_on_site
GET http://{{ site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME delete_again
DELETE http://control.localhost/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

// A site's admin cannot reach the control site's
NAME site_admin_cannot_list
GET http://control.localhost/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 401
