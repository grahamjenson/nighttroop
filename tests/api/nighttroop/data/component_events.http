INCLUDE steps/new_site.steps

NAME no_component_events
GET http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result.items"

// A site change from the Nightscout API is listed, with the pump it names
NAME create_ns_site_change
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Site Change", "created_at": "{{ time 5 }}", "pumpType": "Omnipod", "pumpSerial": "P123", "notes": "New pod" }
ASSERT_STATUS 200

NAME list_component_events
GET http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS "Site Change" "@result.items.0.event_type"
ASSERT_EQUALS "Omnipod" "@result.items.0.pump_type"
ASSERT_EQUALS "P123" "@result.items.0.pump_serial"
ASSERT_EQUALS "New pod" "@result.items.0.notes"

//////
// CREATE AND UPDATE
//////

// A change typed in happens now and is by whoever is signed in
NAME create_component_event
POST http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"event_type": "Sensor Change", "sensor_code": "1234", "notes": "Left arm", "id": "chosen-id", "created_by_identity_name": "someone else"}
ASSERT_STATUS 201
ASSERT_EQUALS "Sensor Change" "@result.event_type"
ASSERT_EQUALS "1234" "@result.sensor_code"
ASSERT_EQUALS "Left arm" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.created_by_identity_name"
ASSERT_EXISTS "@result.occurred_at"
SET created_id {{ .create_component_event.result.id }}

NAME created_component_event_has_new_id
GET http://{{ site }}/data/component-events/chosen-id
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME get_component_event
GET http://{{ site }}/data/component-events/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "1234" "@result.sensor_code"

// Newest first, so the one happening now is before the one from the Nightscout API
NAME first_page
GET http://{{ site }}/data/component-events?limit=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS "Sensor Change" "@result.items.0.event_type"

NAME second_page
GET http://{{ site }}/data/component-events?limit=1&skip=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS "Site Change" "@result.items.0.event_type"

NAME create_component_event_no_type
POST http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"sensor_code": "1234"}
ASSERT_STATUS 400
ASSERT_CONTAINS "event_type must be one of" "@message"

NAME create_component_event_other_type
POST http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"event_type": "Meal Bolus"}
ASSERT_STATUS 400
ASSERT_CONTAINS "event_type must be one of" "@message"

NAME create_component_event_code_too_long
POST http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"event_type": "Sensor Change", "sensor_code": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
ASSERT_STATUS 400

// Only the fields sent change
NAME update_component_event_transmitter
POST http://{{ site }}/data/component-events/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"transmitter_id": "8G1234", "event_type": "Sensor Start"}
ASSERT_STATUS 200
ASSERT_EQUALS "Sensor Start" "@result.event_type"
ASSERT_EQUALS "8G1234" "@result.transmitter_id"
ASSERT_EQUALS "1234" "@result.sensor_code"
ASSERT_EQUALS "Left arm" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.updated_by_identity_name"

NAME update_component_event_other_type
POST http://{{ site }}/data/component-events/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"event_type": "Note"}
ASSERT_STATUS 400
ASSERT_CONTAINS "event_type must be one of" "@message"

NAME update_unknown_component_event
POST http://{{ site }}/data/component-events/not-a-component-event
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "nothing here"}
ASSERT_STATUS 404

//////
// DELETE
//////

NAME delete_component_event
DELETE http://{{ site }}/data/component-events/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_component_event_not_found
GET http://{{ site }}/data/component-events/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_component_event_not_listed
GET http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"

NAME delete_unknown_component_event
DELETE http://{{ site }}/data/component-events/not-a-component-event
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404
