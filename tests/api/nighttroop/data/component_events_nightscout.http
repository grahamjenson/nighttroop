INCLUDE steps/new_site.steps

// Sensor and site changes from Nightscout apps name no pump, and are kept as changes all the same, so the summary and
// Nightscout's sensor and cannula ages have them
NAME create_ns_changes
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B [{"eventType": "Sensor Start", "created_at": "{{ time 10 }}", "notes": "Left arm"}, {"eventType": "Site Change", "created_at": "{{ time 5 }}", "enteredBy": "Loop", "notes": "Right thigh"}]
ASSERT_STATUS 200

NAME ns_changes_listed
GET http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result.items"
ASSERT_EQUALS "Site Change" "@result.items.0.event_type"
ASSERT_EQUALS "Right thigh" "@result.items.0.notes"
ASSERT_EQUALS "Sensor Start" "@result.items.1.event_type"
ASSERT_EQUALS "Left arm" "@result.items.1.notes"

// A bolus that names no pump has no change
NAME create_ns_bolus
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B [{"eventType": "Correction Bolus", "created_at": "{{ time 1 }}", "insulin": 1}]
ASSERT_STATUS 200

NAME bolus_not_listed
GET http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result.items"

// AAPS names the pump on every treatment. A temp basal that names it has no change either: its pump is kept on its
// event group, and comes back as sent
NAME create_ns_temp_basal_with_pump
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B [{"eventType": "Temp Basal", "created_at": "{{ time 2 }}", "absolute": 0.5, "duration": 30, "pumpId": "4102", "pumpSerial": "AAPS1234", "pumpType": "DANA_I"}]
ASSERT_STATUS 200
SET temp_basal_id {{ dig "create_ns_temp_basal_with_pump.0._id" }}

NAME temp_basal_not_listed
GET http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result.items"

NAME temp_basal_group_has_pump
GET http://{{ site }}/data/event-groups/{{ .temp_basal_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS null "@result.component_event_id"
ASSERT_EQUALS "4102" "@result.pump_id"
ASSERT_EQUALS "AAPS1234" "@result.pump_serial"
ASSERT_EQUALS "DANA_I" "@result.pump_type"

NAME temp_basal_pump_returned
GET http://{{ .ns_site }}/api/v1/treatments/{{ .temp_basal_id }}?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS "4102" "@0.pumpId"
ASSERT_EQUALS "AAPS1234" "@0.pumpSerial"
ASSERT_EQUALS "DANA_I" "@0.pumpType"
