INCLUDE steps/new_site.steps

NAME no_temp_basals
GET http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result.items"

// A temp basal from the Nightscout API is listed
NAME create_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Temp Basal", "created_at": "{{ time 5 }}", "absolute": 0.85, "rate": 0.85, "duration": 60, "reason": "Loop" }
ASSERT_STATUS 200

NAME list_temp_basals
GET http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS 0.85 "@result.items.0.rate"
ASSERT_EQUALS 60 "@result.items.0.duration_minutes"

//////
// CREATE AND UPDATE
//////

// A temp basal typed in starts now, by whoever is signed in
NAME create_temp_basal
POST http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"rate": 1.2, "duration_minutes": 30, "notes": "Sick day", "id": "chosen-id", "created_by_identity_name": "someone else"}
ASSERT_STATUS 201
ASSERT_EQUALS 1.2 "@result.rate"
ASSERT_EQUALS 30 "@result.duration_minutes"
ASSERT_EQUALS "Sick day" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.created_by_identity_name"
ASSERT_EXISTS "@result.occurred_at"
SET created_id {{ .create_temp_basal.result.id }}

NAME created_temp_basal_has_new_id
GET http://{{ site }}/data/temp-basals/chosen-id
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME get_temp_basal
GET http://{{ site }}/data/temp-basals/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 1.2 "@result.rate"

// Newest first, so the one starting now is before the one from the Nightscout API
NAME first_page
GET http://{{ site }}/data/temp-basals?limit=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS 1.2 "@result.items.0.rate"

NAME second_page
GET http://{{ site }}/data/temp-basals?limit=1&skip=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS 0.85 "@result.items.0.rate"

NAME create_temp_basal_without_rate
POST http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"duration_minutes": 30}
ASSERT_STATUS 400
ASSERT_CONTAINS "rate is required" "@message"

NAME create_temp_basal_too_high
POST http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"rate": 500, "duration_minutes": 30}
ASSERT_STATUS 400

NAME create_temp_basal_too_long
POST http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"rate": 1, "duration_minutes": 2000}
ASSERT_STATUS 400
ASSERT_CONTAINS "duration_minutes must be from 1 to 1440" "@message"

// A temp basal is at least 1% of the scheduled basal, as on the page
NAME create_temp_basal_too_low_percent
POST http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"rate": 0, "multiplier": 0.001, "duration_minutes": 30}
ASSERT_STATUS 400
ASSERT_CONTAINS "multiplier must be from 0.01 to 11" "@message"

// Only the fields sent change
NAME update_temp_basal_notes
POST http://{{ site }}/data/temp-basals/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "Exercise"}
ASSERT_STATUS 200
ASSERT_EQUALS 1.2 "@result.rate"
ASSERT_EQUALS 30 "@result.duration_minutes"
ASSERT_EQUALS "Exercise" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.updated_by_identity_name"

// A suspended basal is 0 U/hr
NAME update_temp_basal_to_zero
POST http://{{ site }}/data/temp-basals/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"rate": 0, "duration_minutes": 45}
ASSERT_STATUS 200
ASSERT_EQUALS 0 "@result.rate"
ASSERT_EQUALS 45 "@result.duration_minutes"
ASSERT_EQUALS "Exercise" "@result.notes"

NAME update_temp_basal_too_high
POST http://{{ site }}/data/temp-basals/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"rate": 500}
ASSERT_STATUS 400

NAME update_unknown_temp_basal
POST http://{{ site }}/data/temp-basals/not-a-temp-basal
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "nothing here"}
ASSERT_STATUS 404

//////
// DELETE
//////

NAME delete_temp_basal
DELETE http://{{ site }}/data/temp-basals/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_temp_basal_not_found
GET http://{{ site }}/data/temp-basals/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_temp_basal_not_listed
GET http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"

NAME delete_unknown_temp_basal
DELETE http://{{ site }}/data/temp-basals/not-a-temp-basal
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

// A Nightscout percent is the change from the basal, -50 for half, as AAPS sends it, which the site keeps as a multiplier
// of the basal, 0.5, and the Nightscout API returns as sent
NAME create_percent_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Temp Basal", "created_at": "{{ time -5 }}", "rate": 0.4, "percent": -50, "duration": 30 }
ASSERT_STATUS 200
ASSERT_EQUALS -50 "@0.percent"

NAME list_percent_temp_basal
GET http://{{ site }}/data/temp-basals
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 0.5 "@result.items.0.multiplier"
ASSERT_EQUALS 0.4 "@result.items.0.rate"
