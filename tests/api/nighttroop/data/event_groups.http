INCLUDE steps/new_site.steps

NAME no_event_groups
GET http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

// Treatments from the Nightscout API are event groups, each with its events
NAME create_meal_bolus
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Meal Bolus", "created_at": "{{ time 10 }}", "carbs": 40, "insulin": 4, "notes": "Lunch" }
ASSERT_STATUS 200

NAME create_temp_basal
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Temp Basal", "created_at": "{{ time 5 }}", "absolute": 0.85, "rate": 0.85, "duration": 60 }
ASSERT_STATUS 200

NAME list_event_groups
GET http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"
ASSERT_EQUALS "Temp Basal" "@result.0.group_type"
ASSERT_EQUALS 0.85 "@result.0.temp_basal.absolute"
ASSERT_EQUALS "Meal Bolus" "@result.1.group_type"
ASSERT_EQUALS 4 "@result.1.insulin_dose.dose"
ASSERT_EQUALS 40 "@result.1.food_intake.carbs"
ASSERT_EQUALS "Lunch" "@result.1.notes"
SET meal_id {{ dig "list_event_groups.result.1.id" }}

NAME page_event_groups
GET http://{{ site }}/data/event-groups?limit=1&skip=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "Meal Bolus" "@result.0.group_type"

NAME get_event_group
GET http://{{ site }}/data/event-groups/{{ .meal_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "Meal Bolus" "@result.group_type"
ASSERT_EQUALS 4 "@result.insulin_dose.dose"

NAME get_unknown_event_group
GET http://{{ site }}/data/event-groups/not-a-group
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

//////
// DELETE
//////

// Deleting a group deletes its events too, so none are left behind
NAME delete_event_group
DELETE http://{{ site }}/data/event-groups/{{ .meal_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_event_group_not_found
GET http://{{ site }}/data/event-groups/{{ .meal_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_event_group_not_listed
GET http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"

NAME deleted_insulin_not_listed
GET http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

NAME deleted_food_not_listed
GET http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

NAME deleted_treatment_gone_from_nightscout
GET http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"

NAME delete_unknown_event_group
DELETE http://{{ site }}/data/event-groups/not-a-group
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

//////
// GROUPING EVENTS
//////

// Food and insulin from the site's own pages are in no group, so can be grouped
NAME create_food_to_group
POST http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"carbs": 30, "name": "Toast"}
ASSERT_STATUS 201
SET food_id {{ .create_food_to_group.result.id }}

NAME create_insulin_to_group
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 3}
ASSERT_STATUS 201
SET insulin_id {{ .create_insulin_to_group.result.id }}

// The events that can be grouped are those within an hour of now in no other group: not the temp basal, whose
// treatment is its group, nor the deleted meal's
NAME events_to_group
GET http://{{ site }}/data/event-groups/choices?group_type=Meal+Bolus
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"
ASSERT_EQUALS "insulin_dose_id" "@result.0.kind"
ASSERT_EQUALS 3 "@result.0.amount"
ASSERT_EQUALS "food_intake_id" "@result.1.kind"
ASSERT_EQUALS "Toast" "@result.1.detail"
ASSERT_EQUALS false "@result.1.picked"

// Only the kinds of event the type of group can have are offered: a carb correction is only food
NAME events_for_the_type
GET http://{{ site }}/data/event-groups/choices?group_type=Carb+Correction
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "food_intake_id" "@result.0.kind"

NAME choices_need_a_known_type
GET http://{{ site }}/data/event-groups/choices?group_type=Nope
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 400

NAME new_needs_a_known_type
GET http://{{ site }}/data/event-groups/new?group_type=Nope
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 400

// Events from a day ago are not near now
NAME no_events_to_group_a_day_ago
GET http://{{ site }}/data/event-groups/choices?group_type=Meal+Bolus&occurred_at={{ itime 1440 }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

NAME create_needs_a_type
POST http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"food_intake_id": "{{ .food_id }}"}
ASSERT_STATUS 400
ASSERT_EQUALS "Missing required field group_type" "@message"

NAME create_needs_an_event
POST http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"group_type": "Meal Bolus"}
ASSERT_STATUS 400
ASSERT_EQUALS "Pick at least one event to group" "@message"

NAME create_refuses_a_kind_the_type_cannot_have
POST http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"group_type": "Carb Correction", "food_intake_id": "{{ .food_id }}", "insulin_dose_id": "{{ .insulin_id }}"}
ASSERT_STATUS 400
ASSERT_EQUALS "Carb Correction cannot have insulin_dose_id" "@message"

NAME create_refuses_an_unknown_type
POST http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"group_type": "Nope", "food_intake_id": "{{ .food_id }}"}
ASSERT_STATUS 400
ASSERT_EQUALS "Unknown event group type Nope" "@message"

NAME create_event_group
POST http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"group_type": "Meal Bolus", "food_intake_id": "{{ .food_id }}", "insulin_dose_id": "{{ .insulin_id }}", "notes": "Breakfast"}
ASSERT_STATUS 201
ASSERT_EQUALS "Meal Bolus" "@result.group_type"
ASSERT_EQUALS 30 "@result.food_intake.carbs"
ASSERT_EQUALS 3 "@result.insulin_dose.dose"
ASSERT_EQUALS "Breakfast" "@result.notes"
ASSERT_EXISTS "@result.occurred_at"
SET group_id {{ .create_event_group.result.id }}

// Grouped, its events are not offered for another group, and cannot be put in one
NAME grouped_events_not_offered
GET http://{{ site }}/data/event-groups/choices?group_type=Meal+Bolus
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

NAME event_in_only_one_group
POST http://{{ site }}/data/event-groups
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"group_type": "Carb Correction", "food_intake_id": "{{ .food_id }}"}
ASSERT_STATUS 409
ASSERT_EQUALS "An event picked is already in another event group" "@message"

// Editing the group offers its own events, already picked
NAME events_for_the_group
GET http://{{ site }}/data/event-groups/choices?group_type=Meal+Bolus&group_id={{ .group_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"
ASSERT_EQUALS true "@result.0.picked"
ASSERT_EQUALS true "@result.1.picked"

// The group is a treatment in Nightscout, with its events
NAME grouped_in_nightscout
GET http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS "Meal Bolus" "@0.eventType"
ASSERT_EQUALS 30 "@0.carbs"
ASSERT_EQUALS 3 "@0.insulin"

// Editing sets its events to those sent, keeping its notes, and an event taken out is in no group again
NAME update_event_group
POST http://{{ site }}/data/event-groups/{{ .group_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"group_type": "Carb Correction", "food_intake_id": "{{ .food_id }}"}
ASSERT_STATUS 200
ASSERT_EQUALS "Carb Correction" "@result.group_type"
ASSERT_EQUALS 30 "@result.food_intake.carbs"
ASSERT_EQUALS null "@result.insulin_dose"
ASSERT_EQUALS "Breakfast" "@result.notes"

NAME taken_out_offered_again
GET http://{{ site }}/data/event-groups/choices?group_type=Meal+Bolus
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "insulin_dose_id" "@result.0.kind"

// An edit without a type keeps the group's, which cannot have insulin
NAME update_refuses_a_kind_the_type_cannot_have
POST http://{{ site }}/data/event-groups/{{ .group_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"food_intake_id": "{{ .food_id }}", "insulin_dose_id": "{{ .insulin_id }}"}
ASSERT_STATUS 400
ASSERT_EQUALS "Carb Correction cannot have insulin_dose_id" "@message"

NAME update_needs_an_event
POST http://{{ site }}/data/event-groups/{{ .group_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "No events"}
ASSERT_STATUS 400
ASSERT_EQUALS "Pick at least one event to group" "@message"

NAME unknown_collection
GET http://{{ site }}/data/nope
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404
ASSERT_EQUALS "There is no nope here" "@message"
