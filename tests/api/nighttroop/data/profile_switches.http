INCLUDE steps/new_site.steps

NAME no_profile_switches
GET http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result.items"

// A profile switch from the Nightscout API is listed, with its profile's schedules
NAME create_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Profile Switch", "created_at": "{{ time 5 }}", "profile": "Weekend", "percentage": 110, "timeshift": -60, "duration": 60, "profileJson": "{\"units\":\"mg/dL\",\"dia\":5,\"timezone\":\"UTC\",\"sens\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":50}],\"carbratio\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10}],\"basal\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":0.8}],\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":100}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":120}]}" }
ASSERT_STATUS 200

NAME list_profile_switches
GET http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS "Weekend" "@result.items.0.name"
ASSERT_EQUALS 1.1 "@result.items.0.multiplier"
ASSERT_EQUALS -60 "@result.items.0.timeshift"
ASSERT_EQUALS 60 "@result.items.0.duration_minutes"
ASSERT_EQUALS 5 "@result.items.0.dia"
ASSERT_CONTAINS "0.8" "@result.items.0.basal_rates_json"
SET ns_id {{ dig "list_profile_switches.result.items.0.id" }}

//////
// CREATE AND UPDATE
//////

// A profile switch typed in happens now and is by whoever is signed in
NAME create_profile_switch
POST http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Sick Day", "multiplier": 1.2, "timeshift": 30, "duration_minutes": 0, "notes": "Flu", "id": "chosen-id", "created_by_identity_name": "someone else"}
ASSERT_STATUS 201
ASSERT_EQUALS "Sick Day" "@result.name"
ASSERT_EQUALS 1.2 "@result.multiplier"
ASSERT_EQUALS 30 "@result.timeshift"
ASSERT_EQUALS 0 "@result.duration_minutes"
ASSERT_EQUALS "Flu" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.created_by_identity_name"
ASSERT_EXISTS "@result.occurred_at"
SET created_id {{ .create_profile_switch.result.id }}

NAME created_profile_switch_has_new_id
GET http://{{ site }}/data/profile-switches/chosen-id
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME get_profile_switch
GET http://{{ site }}/data/profile-switches/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "Sick Day" "@result.name"

// Newest first, so the one happening now is before the one from the Nightscout API
NAME first_page
GET http://{{ site }}/data/profile-switches?limit=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS "Sick Day" "@result.items.0.name"

NAME second_page
GET http://{{ site }}/data/profile-switches?limit=1&skip=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS "Weekend" "@result.items.0.name"

NAME create_profile_switch_no_name
POST http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"multiplier": 1}
ASSERT_STATUS 400
ASSERT_CONTAINS "name is required" "@message"

NAME create_profile_switch_name_too_long
POST http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
ASSERT_STATUS 400
ASSERT_CONTAINS "name must be at most 64 characters" "@message"

NAME create_profile_switch_bad_multiplier
POST http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Huge", "multiplier": 10}
ASSERT_STATUS 400
ASSERT_CONTAINS "multiplier must be from 0.1 to 5" "@message"

NAME create_profile_switch_bad_timeshift
POST http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Jet Lag", "timeshift": 2000}
ASSERT_STATUS 400
ASSERT_CONTAINS "timeshift must be from -1440 to 1440 minutes" "@message"

NAME create_profile_switch_too_long
POST http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Forever", "duration_minutes": 20000}
ASSERT_STATUS 400
ASSERT_CONTAINS "duration must be from 0 to 10080 minutes" "@message"

// Only the fields sent change, and a duration can go back to 0, until the next switch
NAME update_profile_switch
POST http://{{ site }}/data/profile-switches/{{ .ns_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"multiplier": 0.9, "timeshift": 0, "duration_minutes": 0}
ASSERT_STATUS 200
ASSERT_EQUALS "Weekend" "@result.name"
ASSERT_EQUALS 0.9 "@result.multiplier"
ASSERT_EQUALS 0 "@result.timeshift"
ASSERT_EQUALS 0 "@result.duration_minutes"
ASSERT_CONTAINS "0.8" "@result.basal_rates_json"
ASSERT_EQUALS "pwd_phone" "@result.updated_by_identity_name"

NAME update_profile_switch_bad_multiplier
POST http://{{ site }}/data/profile-switches/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"multiplier": 0.05}
ASSERT_STATUS 400

NAME update_unknown_profile_switch
POST http://{{ site }}/data/profile-switches/not-a-profile-switch
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "nothing here"}
ASSERT_STATUS 404

//////
// DELETE
//////

NAME delete_profile_switch
DELETE http://{{ site }}/data/profile-switches/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_profile_switch_not_found
GET http://{{ site }}/data/profile-switches/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_profile_switch_not_listed
GET http://{{ site }}/data/profile-switches
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"

NAME delete_unknown_profile_switch
DELETE http://{{ site }}/data/profile-switches/not-a-profile-switch
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404
