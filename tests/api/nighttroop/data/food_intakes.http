NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME no_food_intakes
GET http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

// Carbs from the Nightscout API are listed
NAME create_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Carb Correction", "created_at": "{{ time 5 }}", "carbs": 15 }
ASSERT_STATUS 200

NAME list_food_intakes
GET http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS 15 "@result.0.carbs"

//////
// CREATE AND UPDATE
//////

// Food typed in is eaten now, by whoever is signed in
NAME create_food_intake
POST http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"carbs": 45, "name": "Sandwich", "notes": "Lunch", "id": "chosen-id", "created_by_identity_name": "someone else"}
ASSERT_STATUS 201
ASSERT_EQUALS 45 "@result.carbs"
ASSERT_EQUALS "Sandwich" "@result.name"
ASSERT_EQUALS "Lunch" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.created_by_identity_name"
ASSERT_EXISTS "@result.occurred_at"
SET created_id {{ .create_food_intake.result.id }}

NAME created_food_intake_has_new_id
GET http://{{ site }}/data/food/chosen-id
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME get_food_intake
GET http://{{ site }}/data/food/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 45 "@result.carbs"

// Newest first, so the one eaten now is before the one from the Nightscout API
NAME first_page
GET http://{{ site }}/data/food?limit=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS 45 "@result.0.carbs"

NAME second_page
GET http://{{ site }}/data/food?limit=1&skip=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS 15 "@result.0.carbs"

NAME create_food_intake_without_carbs
POST http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "no carbs"}
ASSERT_STATUS 400

NAME create_food_intake_too_high
POST http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"carbs": 5000}
ASSERT_STATUS 400
ASSERT_CONTAINS "must be from 0 to 1000 g" "@message"

NAME create_food_intake_negative_fat
POST http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"carbs": 20, "fat": -1}
ASSERT_STATUS 400

// Only the fields sent change
NAME update_food_intake_notes
POST http://{{ site }}/data/food/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "Dinner"}
ASSERT_STATUS 200
ASSERT_EQUALS 45 "@result.carbs"
ASSERT_EQUALS "Dinner" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.updated_by_identity_name"

NAME update_food_intake_carbs
POST http://{{ site }}/data/food/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"carbs": 0, "protein": 20}
ASSERT_STATUS 200
ASSERT_EQUALS 0 "@result.carbs"
ASSERT_EQUALS 20 "@result.protein"
ASSERT_EQUALS "Sandwich" "@result.name"
ASSERT_EQUALS "Dinner" "@result.notes"

NAME update_food_intake_too_high
POST http://{{ site }}/data/food/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"carbs": 5000}
ASSERT_STATUS 400

NAME update_unknown_food_intake
POST http://{{ site }}/data/food/not-a-food-intake
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "nothing here"}
ASSERT_STATUS 404

//////
// DELETE
//////

NAME delete_food_intake
DELETE http://{{ site }}/data/food/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_food_intake_not_found
GET http://{{ site }}/data/food/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_food_intake_not_listed
GET http://{{ site }}/data/food
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"

NAME delete_unknown_food_intake
DELETE http://{{ site }}/data/food/not-a-food-intake
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404
