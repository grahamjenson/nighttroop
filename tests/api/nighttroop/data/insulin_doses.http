INCLUDE steps/new_site.steps

NAME no_insulin_doses
GET http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result.items"

// A bolus from the Nightscout API is listed
NAME create_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Correction Bolus", "created_at": "{{ time 5 }}", "insulin": 2.5 }
ASSERT_STATUS 200

NAME list_insulin_doses
GET http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS 2.5 "@result.items.0.dose"

//////
// CREATE AND UPDATE
//////

// A dose typed in is given now, by whoever is signed in
NAME create_insulin_dose
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 4, "notes": "Lunch", "id": "chosen-id", "created_by_identity_name": "someone else"}
ASSERT_STATUS 201
ASSERT_EQUALS 4 "@result.dose"
ASSERT_EQUALS "Lunch" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.created_by_identity_name"
ASSERT_EXISTS "@result.occurred_at"
SET created_id {{ .create_insulin_dose.result.id }}

NAME created_insulin_dose_has_new_id
GET http://{{ site }}/data/insulin/chosen-id
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME get_insulin_dose
GET http://{{ site }}/data/insulin/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 4 "@result.dose"

// Newest first, so the one given now is before the one from the Nightscout API
NAME first_page
GET http://{{ site }}/data/insulin?limit=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS 4 "@result.items.0.dose"

NAME second_page
GET http://{{ site }}/data/insulin?limit=1&skip=1
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"
ASSERT_EQUALS 2.5 "@result.items.0.dose"

NAME create_insulin_dose_without_dose
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "no dose"}
ASSERT_STATUS 400
ASSERT_CONTAINS "dose must not be 0" "@message"

NAME create_insulin_dose_too_high
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 500}
ASSERT_STATUS 400

NAME create_insulin_dose_too_low
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": -500}
ASSERT_STATUS 400

// A negative dose takes insulin entered by mistake back off insulin on board
NAME create_insulin_dose_negative
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": -1.5}
ASSERT_STATUS 201
ASSERT_EQUALS -1.5 "@result.dose"

NAME delete_negative_insulin_dose
DELETE http://{{ site }}/data/insulin/{{ .create_insulin_dose_negative.result.id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

// Only the fields sent change
NAME update_insulin_dose_notes
POST http://{{ site }}/data/insulin/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "Dinner"}
ASSERT_STATUS 200
ASSERT_EQUALS 4 "@result.dose"
ASSERT_EQUALS "Dinner" "@result.notes"
ASSERT_EQUALS "pwd_phone" "@result.updated_by_identity_name"

NAME update_insulin_dose_dose
POST http://{{ site }}/data/insulin/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 5.5}
ASSERT_STATUS 200
ASSERT_EQUALS 5.5 "@result.dose"
ASSERT_EQUALS "Dinner" "@result.notes"

NAME update_insulin_dose_too_high
POST http://{{ site }}/data/insulin/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 500}
ASSERT_STATUS 400

NAME update_unknown_insulin_dose
POST http://{{ site }}/data/insulin/not-a-dose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"notes": "nothing here"}
ASSERT_STATUS 404

//////
// DELETE
//////

NAME delete_insulin_dose
DELETE http://{{ site }}/data/insulin/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_insulin_dose_not_found
GET http://{{ site }}/data/insulin/{{ .created_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_insulin_dose_not_listed
GET http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result.items"

NAME delete_unknown_insulin_dose
DELETE http://{{ site }}/data/insulin/not-a-dose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

//////
// COMBO BOLUS
//////

// A combo bolus's Nightscout insulin is its dose given at once, and its splitNow and splitExt the percents of its dose
// and its extended dose, given over its duration after it
NAME create_combo_bolus_treatment
POST http://{{ .ns_site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Combo Bolus", "created_at": "{{ time -5 }}", "insulin": 3, "splitNow": 75, "splitExt": 25, "duration": 60 }
ASSERT_STATUS 200
ASSERT_EQUALS 75 "@0.splitNow"
ASSERT_EQUALS 25 "@0.splitExt"

NAME list_combo_bolus
GET http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 3 "@result.items.0.dose"
ASSERT_EQUALS 1 "@result.items.0.extended_dose"
ASSERT_EQUALS 60 "@result.items.0.extended_duration_minutes"

// One added on the site can be all extended, with no dose at once
NAME create_extended_dose
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 0, "extended_dose": 2, "extended_duration_minutes": 120}
ASSERT_STATUS 201
ASSERT_EQUALS 0 "@result.dose"
ASSERT_EQUALS 2 "@result.extended_dose"
ASSERT_EQUALS 120 "@result.extended_duration_minutes"

// An extended dose or duration far outside real use is refused, also when it is all that is changed
NAME create_extended_dose_too_much
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 2, "extended_dose": 501}
ASSERT_STATUS 400
ASSERT_CONTAINS "extended_dose must be from 0 to 500" "@message"

NAME update_extended_duration_too_long
POST http://{{ site }}/data/insulin/{{ .create_extended_dose.result.id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"extended_duration_minutes": 20000}
ASSERT_STATUS 400
ASSERT_CONTAINS "extended_duration_minutes must be from 0 to 10080" "@message"
