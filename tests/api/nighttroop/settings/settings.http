NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

// Signed in as the PWD phone, which is not an admin
NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

//////
// SITE SETTINGS are for admins only
//////

NAME get_site_settings_not_admin
GET http://{{ site }}/settings/site
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 403

NAME update_site_settings_not_admin
POST http://{{ site }}/settings/site
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"units": "mg/dL"}
ASSERT_STATUS 403

//////
// IDENTITY SETTINGS
//////

// Nothing is set yet, so everything follows the site, which follows the defaults
NAME get_identity_settings
GET http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "mmol/L" "@result.inherited.units"
ASSERT_EQUALS "UTC" "@result.inherited.timezone"
ASSERT_EQUALS "YYYY-MM-DD" "@result.inherited.date_format"

// The settings page is the identity's settings; only an admin's page also shows the site's
NAME get_settings_page_not_admin
GET http://{{ site }}/settings
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "mmol/L" "@result.inherited.units"

// A setting that is not on the page, which must survive the page's updates
NAME set_bolus_dia_through_nightscout
PATCH http://{{ .ns_site }}/api/v3/settings/bolus_dia_hours
H Authorization: Bearer {{ jwt }}
B {"value": 5}
ASSERT_STATUS 200

NAME update_identity_settings
POST http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"units": "mg/dL", "timezone": "Pacific/Auckland", "date_format": "DD/MM/YYYY", "week_start_day": "sunday"}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.units"
ASSERT_EQUALS "Pacific/Auckland" "@result.timezone"
ASSERT_EQUALS "DD/MM/YYYY" "@result.date_format"
ASSERT_EQUALS "sunday" "@result.week_start_day"

NAME identity_settings_saved
GET http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.units"
ASSERT_EQUALS "sunday" "@result.week_start_day"

NAME nightscout_sees_identity_units
GET http://{{ .ns_site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.value"

NAME other_settings_kept
GET http://{{ .ns_site }}/api/v3/settings/bolus_dia_hours
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 5 "@result.value"

// A setting not sent stays as it is, and an empty one goes back to following the site
NAME clear_identity_units
POST http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"units": ""}
ASSERT_STATUS 200
ASSERT_EQUALS "sunday" "@result.week_start_day"

NAME nightscout_sees_site_units_again
GET http://{{ .ns_site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mmol/L" "@result.value"

NAME bad_timezone
POST http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"timezone": "Mars/Olympus"}
ASSERT_STATUS 400
ASSERT_CONTAINS "invalid timezone" "@message"

NAME bad_date_format
POST http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"date_format": "YY"}
ASSERT_STATUS 400
ASSERT_CONTAINS "invalid date format" "@message"
