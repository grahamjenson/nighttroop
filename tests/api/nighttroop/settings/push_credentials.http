// A site admin keeps the credentials pushes to their own builds of apps, such as Loop, are sent with
INCLUDE steps/new_site_admin.steps

NAME no_push_credentials
GET http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

// An APNs key is its team ID, key ID and .p8 file; it is never returned
NAME create_apns_key
POST http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "My Loop", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "bundle_ids": ["com.TEAM123456.loopkit.Loop"], "secret": "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgofoAD0qFTDB8eVl2\nLKYt19HfOaUvrvTYGMMR98DDoDihRANCAAROFNjYuI2rlnHoAy4UP4PVhQiFxz1L\nSaETlxByVnuzazzPdJ6qtAO+GOvUV5lPZn62Rv3vFb9ozLi/OFfob09a\n-----END PRIVATE KEY-----\n"}
ASSERT_STATUS 201
ASSERT_EQUALS "My Loop" "@result.name"
ASSERT_EQUALS "apns" "@result.provider"
ASSERT_EQUALS "loop" "@result.apps.0"
ASSERT_EQUALS "com.TEAM123456.loopkit.Loop" "@result.bundle_ids.0"
ASSERT_EQUALS "admin" "@result.created_by_identity_name"
ASSERT_EQUALS null "@result.secret"
SET credential_id {{ .create_apns_key.result.id }}

NAME list_push_credentials
GET http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "My Loop" "@result.0.name"
ASSERT_EQUALS null "@result.0.secret"

NAME get_push_credential
GET http://{{ site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "ABC123DEFG" "@result.key_id"
ASSERT_EQUALS null "@result.secret"

// What is not a credential is refused
NAME refuse_bad_p8
POST http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Bad", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"], "secret": "not a key"}
ASSERT_STATUS 400
ASSERT_CONTAINS "not a .p8 file" "@message"

NAME refuse_unknown_app
POST http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Bad", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["nope"], "secret": "x"}
ASSERT_STATUS 400
ASSERT_CONTAINS "unknown or repeated app" "@message"

NAME refuse_no_secret
POST http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "Bad", "provider": "apns", "team_or_project_id": "TEAM123456", "key_id": "ABC123DEFG", "apps": ["loop"]}
ASSERT_STATUS 400

// Only an admin manages them: the PWD phone cannot see them
NAME phone_jwt
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET phone_jwt {{ .phone_jwt.token }}

NAME phone_cannot_list
GET http://{{ site }}/settings/push-credentials
H Authorization: Bearer {{ .phone_jwt }}
H Accept: application/json
ASSERT_STATUS 403

// Another site's admin cannot reach them
NAME create_other_site
POST http://localhost/site
ASSERT_STATUS 200
SET other_site {{ .create_other_site.site_subdomain }}.localhost

NAME other_admin_login
POST http://{{ .other_site }}/login
H Accept: application/json
B {"name": "admin", "password": "{{ .create_other_site.api_key }}", "totp": "123123"}
ASSERT_STATUS 200
SET other_jwt {{ .other_admin_login.token }}

NAME other_site_cannot_get
GET http://{{ .other_site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ .other_jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME other_site_cannot_delete
DELETE http://{{ .other_site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ .other_jwt }}
H Accept: application/json
ASSERT_STATUS 404

// Deleting one removes it, so pushes no longer use it
NAME delete_push_credential
DELETE http://{{ site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_push_credential
GET http://{{ site }}/settings/push-credentials/{{ .credential_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404
