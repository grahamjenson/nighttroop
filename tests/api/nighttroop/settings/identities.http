NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

// Logged in as the PWD phone device
NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

// A new site has an admin, the PWD phone and a read only device, newest first
NAME list_identities
GET http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 3 "@result"
ASSERT_EQUALS "device_pwd_phone" "@result.1.role"
ASSERT_EQUALS true "@result.1.current_identity"
ASSERT_EQUALS "admin" "@result.2.role"
SET self_id {{ dig "list_identities.result.1.id" }}
SET admin_id {{ dig "list_identities.result.2.id" }}

NAME create_device
POST http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "kitchen", "role": "device_read"}
ASSERT_STATUS 201
ASSERT_EQUALS "kitchen" "@result.name"
ASSERT_EQUALS true "@result.enabled"
ASSERT_EXISTS "@result.password"
ASSERT_EXISTS "@result.ns_token"
SET device_id {{ .create_device.result.id }}
SET device_token {{ .create_device.result.ns_token }}

NAME create_device_same_name
POST http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "kitchen", "role": "device_read"}
ASSERT_STATUS 409

NAME create_device_unknown_role
POST http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "lounge", "role": "superuser"}
ASSERT_STATUS 400
ASSERT_CONTAINS "Unknown role" "@message"

// Credentials are only shown when the identity is created
NAME get_device
GET http://{{ site }}/settings/identities/{{ .device_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "kitchen" "@result.name"
ASSERT_EQUALS "device_read" "@result.role"
ASSERT_EQUALS false "@result.current_identity"

NAME device_token_works
GET http://{{ .ns_site }}/api/v1/entries?token={{ .device_token }}
ASSERT_STATUS 200

NAME disable_device
POST http://{{ site }}/settings/identities/{{ .device_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": false}
ASSERT_STATUS 200
ASSERT_EQUALS "kitchen" "@result.name"
ASSERT_EQUALS false "@result.enabled"

NAME disabled_device_token_rejected
GET http://{{ .ns_site }}/api/v1/entries?token={{ .device_token }}
ASSERT_STATUS 401

NAME enable_device
POST http://{{ site }}/settings/identities/{{ .device_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": true}
ASSERT_STATUS 200
ASSERT_EQUALS true "@result.enabled"

NAME delete_device
DELETE http://{{ site }}/settings/identities/{{ .device_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME deleted_device_not_found
GET http://{{ site }}/settings/identities/{{ .device_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME deleted_device_token_rejected
GET http://{{ .ns_site }}/api/v1/entries?token={{ .device_token }}
ASSERT_STATUS 401

// A deleted identity keeps its row, and its name, for the audit trail
NAME create_device_reuse_name
POST http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "kitchen", "role": "device_read"}
ASSERT_STATUS 409

NAME delete_unknown_identity
DELETE http://{{ site }}/settings/identities/999999999
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 404

// An identity cannot lock itself out
NAME delete_self
DELETE http://{{ site }}/settings/identities/{{ .self_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 400
ASSERT_CONTAINS "you cannot disable or delete yourself" "@message"

NAME disable_self
POST http://{{ site }}/settings/identities/{{ .self_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": false}
ASSERT_STATUS 400

// The site must keep an enabled admin
NAME delete_last_admin
DELETE http://{{ site }}/settings/identities/{{ .admin_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 400
ASSERT_CONTAINS "at least one enabled admin" "@message"

NAME disable_last_admin
POST http://{{ site }}/settings/identities/{{ .admin_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": false}
ASSERT_STATUS 400
ASSERT_CONTAINS "at least one enabled admin" "@message"
