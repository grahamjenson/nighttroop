NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME create_nightscout_sync
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "http://ns.example.test", "password": "a-token", "enabled": true}
ASSERT_STATUS 200
ASSERT {{ assertEquals "http://ns.example.test" "@result.url_or_username" }}

NAME update_nightscout_sync_bad_url
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "not a url", "enabled": true}
ASSERT_STATUS 400
ASSERT {{ assertContains "not a valid URL" "@message" }}

NAME create_dexcom_sync
POST http://{{ site }}/settings/sync/dexcom
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "dex-user", "password": "dex-pass", "region": "US", "enabled": false}
ASSERT_STATUS 200
ASSERT {{ assertEquals "US" "@result.region" }}

NAME create_virtual_sync
POST http://{{ site }}/settings/sync/virtual
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": true}
ASSERT_STATUS 200
ASSERT {{ assertEquals true "@result.enabled" }}

NAME virtual_entries_seeded
GET http://{{ .ns_site }}/api/v1/entries?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertLength 6 "@" }}
ASSERT {{ assertEquals "virtual://nighttroop" "@0.device" }}

NAME virtual_devicestatus_seeded
GET http://{{ .ns_site }}/api/v1/devicestatus?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertLength 6 "@" }}

NAME virtual_treatments_seeded
GET http://{{ .ns_site }}/api/v1/treatments?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertLength 3 "@" }}

NAME virtual_profile_seeded
GET http://{{ .ns_site }}/api/v1/profile?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Virtual" "@0.defaultProfile" }}

NAME enable_virtual_sync_again_is_idempotent
POST http://{{ site }}/settings/sync/virtual
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": true}
ASSERT_STATUS 200

NAME virtual_entries_not_duplicated
GET http://{{ .ns_site }}/api/v1/entries?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertLength 6 "@" }}
