INCLUDE steps/new_site_admin.steps

NAME create_nightscout_sync_unreachable
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "http://bad.nightscout.test", "password": "a-token", "enabled": true}
ASSERT_STATUS 200

RUN_BACKGROUND_JOBS

// Saving does not check the details; the first sync does, and turns syncing off when it fails
NAME nightscout_first_sync_failed
GET http://{{ site }}/settings/sync
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS false "@result.0.enabled"
ASSERT_CONTAINS "The first sync failed, so syncing has been turned off" "@result.0.previous_sync_errors.0"

NAME create_nightscout_sync
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "http://valid.nightscout.test", "password": "a-token", "enabled": true}
ASSERT_STATUS 200
ASSERT_EQUALS "http://valid.nightscout.test" "@result.url_or_username"

RUN_BACKGROUND_JOBS

// Saving again clears the error and turns syncing back on
NAME nightscout_reenabled
GET http://{{ site }}/settings/sync
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS true "@result.0.enabled"

NAME update_nightscout_sync_bad_url
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "not a url", "enabled": true}
ASSERT_STATUS 400
ASSERT_CONTAINS "not a valid URL" "@message"
ASSERT_CONTAINS "Nightscout URL must use HTTPS. Nightscout URL cannot have a path." "@message"

NAME update_nightscout_sync_unreachable
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "http://bad.nightscout.test", "enabled": true}
ASSERT_STATUS 200

RUN_BACKGROUND_JOBS

// It failed before, so the retry waits out the backoff: the bad details are not tried yet
NAME nightscout_retry_waits_for_backoff
GET http://{{ site }}/settings/sync
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS true "@result.0.enabled"

NAME update_nightscout_sync_keeps_stored_password
POST http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "http://valid.nightscout.test", "password": "********", "enabled": true}
ASSERT_STATUS 200

NAME create_dexcom_sync_bad_login
POST http://{{ site }}/settings/sync/dexcom
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "dex-user", "password": "dex-pass", "region": "US", "enabled": true}
ASSERT_STATUS 200

RUN_BACKGROUND_JOBS

// Sources are listed by type, so dexcom is first
NAME dexcom_first_sync_failed
GET http://{{ site }}/settings/sync
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS false "@result.0.enabled"
ASSERT_CONTAINS "dexcom authentication failed" "@result.0.previous_sync_errors.0"

NAME create_dexcom_sync
POST http://{{ site }}/settings/sync/dexcom
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"url_or_username": "valid-dexcom-user", "password": "dex-pass", "region": "US", "enabled": true}
ASSERT_STATUS 200
ASSERT_EQUALS "US" "@result.region"

NAME create_virtual_sync
POST http://{{ site }}/settings/sync/virtual
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": true}
ASSERT_STATUS 200
ASSERT_EQUALS true "@result.enabled"

RUN_BACKGROUND_JOBS

NAME virtual_entries_seeded
GET http://{{ .ns_site }}/api/v1/entries?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 6 "@"
ASSERT_EQUALS "virtual://nighttroop" "@0.device"

// Two devices report every 5 minutes
NAME virtual_devicestatus_seeded
GET http://{{ .ns_site }}/api/v1/devicestatus?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 12 "@"

// The window always starts with a temp basal, temp target and profile switch. Meals and
// corrections land on set slots of the glucose wave, so whether they fall in this window
// depends on the clock; background/sync/virtual_test.go checks them with a fixed clock.
NAME virtual_temp_basal_seeded
GET http://{{ .ns_site }}/api/v1/treatments?find[eventType]=Temp%20Basal&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"

NAME virtual_temp_target_seeded
GET http://{{ .ns_site }}/api/v1/treatments?find[eventType]=Temporary%20Target&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"

NAME virtual_profile_switch_seeded
GET http://{{ .ns_site }}/api/v1/treatments?find[eventType]=Profile%20Switch&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"

NAME virtual_profile_seeded
GET http://{{ .ns_site }}/api/v1/profile?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS "Virtual" "@0.defaultProfile"

NAME enable_virtual_sync_again_is_idempotent
POST http://{{ site }}/settings/sync/virtual
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": true}
ASSERT_STATUS 200

RUN_BACKGROUND_JOBS

NAME virtual_entries_not_duplicated
GET http://{{ .ns_site }}/api/v1/entries?count=50&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 6 "@"

// Deleting a source turns it off and clears its details, leaving the others
NAME delete_nightscout_sync
DELETE http://{{ site }}/settings/sync/nightscout
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200

NAME nightscout_sync_deleted
GET http://{{ site }}/settings/sync
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "nightscout" "@result.1.type"
ASSERT_EQUALS false "@result.1.enabled"
