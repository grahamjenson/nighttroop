// A site starts in the time zone and language of the browser that created it, with its country's units and formats
NAME create_new_site
POST http://localhost/site?timezone=America/New_York&language=en-US
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME get_identity_settings
GET http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.inherited.units"
ASSERT_EQUALS "America/New_York" "@result.inherited.timezone"
ASSERT_EQUALS "en-US" "@result.inherited.language"
ASSERT_EQUALS "MM/DD/YYYY" "@result.inherited.date_format"
ASSERT_EQUALS "hh:mm a" "@result.inherited.time_format"
ASSERT_EQUALS "sunday" "@result.inherited.week_start_day"

// A time zone and language that are not valid still create the site, in en-NZ with the default formats
NAME create_invalid_site
POST http://localhost/site?timezone=Mars/Olympus&language=not!a!language
ASSERT_STATUS 200
SET token {{ .create_invalid_site.pwd_nstoken }}
SET site {{ .create_invalid_site.site_subdomain }}.localhost
SET ns_site {{ .create_invalid_site.site_subdomain }}.ns.localhost

NAME jwtauth_invalid
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth_invalid.token }}

NAME get_invalid_identity_settings
GET http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "mmol/L" "@result.inherited.units"
ASSERT_EQUALS "UTC" "@result.inherited.timezone"
ASSERT_EQUALS "en-NZ" "@result.inherited.language"
ASSERT_EQUALS "YYYY-MM-DD" "@result.inherited.date_format"
