INCLUDE steps/control_login.steps

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET site_id {{ .create_new_site.site_subdomain }}
SET token {{ .create_new_site.pwd_nstoken }}

// The control API sees every site, newest first
NAME list_sites
GET http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EXISTS "@result.0.id"
ASSERT_EXISTS "@result.0.state"
ASSERT_EXISTS "@result.0.created_at"

NAME list_sites_paged
GET http://control.localhost/sites?limit=1&skip=1
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"

NAME list_sites_bad_limit
GET http://control.localhost/sites?limit=lots
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 400

// Sites can be ordered by how long since they were written to, the first to archive, or by their DB size
NAME list_sites_by_last_write
GET http://control.localhost/sites?order=last_write
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EXISTS "@result.0.id"

NAME list_sites_by_db_size
GET http://control.localhost/sites?order=db_size&limit=1
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"

NAME list_sites_bad_order
GET http://control.localhost/sites?order=name
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 400
ASSERT_EQUALS "sites can be ordered by last_write or db_size" "@message"

NAME get_site
GET http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "live" "@result.state"
ASSERT_EXISTS "@result.batch"

NAME get_unknown_site
GET http://control.localhost/sites/not-a-site
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

// Only signed in control identities can see sites
NAME list_sites_without_login
GET http://control.localhost/sites
H Accept: application/json
ASSERT_STATUS 401

//////
// DISABLE
//////

NAME change_site_to_other_state
POST http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "deleted"}
ASSERT_STATUS 400
ASSERT_CONTAINS "can only be changed to disabled or archived" "@message"

NAME archive_live_site
POST http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "archived"}
ASSERT_STATUS 400
ASSERT_CONTAINS "only a disabled site can be archived" "@message"

NAME site_served_before_disable
GET http://{{ .site_id }}.ns.localhost/api/v1/status.json?token={{ token }}
ASSERT_STATUS 200

NAME disable_site
POST http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "disabled"}
ASSERT_STATUS 200
ASSERT_EQUALS "disabled" "@result.state"
ASSERT_EXISTS "@result.disabled_at"

// A disabled site is no longer served, but the control API still sees it
NAME site_not_served_after_disable
GET http://{{ .site_id }}.ns.localhost/api/v1/status.json?token={{ token }}
ASSERT_STATUS 404

NAME disabled_site_still_listed
GET http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "disabled" "@result.state"

NAME disable_site_again
POST http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "disabled"}
ASSERT_STATUS 400
ASSERT_CONTAINS "only a live site can be disabled" "@message"

//////
// TRUNCATE
//////

// Only a site over its DB size limit is truncated
NAME truncate_site_within_limit
POST http://control.localhost/sites/{{ .site_id }}/truncate
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 400
ASSERT_CONTAINS "only a site over its DB size limit can be truncated" "@message"

NAME truncate_unknown_site
POST http://control.localhost/sites/not-a-site/truncate
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

//////
// ARCHIVE
//////

// Archiving uploads the site to S3 before deleting it here, so without S3 it is refused and the site is kept
NAME archive_site_without_s3
POST http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "archived"}
ASSERT_STATUS 400
ASSERT_CONTAINS "a site can only be archived when S3 is connected" "@message"

NAME site_kept_without_s3
GET http://control.localhost/sites/{{ .site_id }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "disabled" "@result.state"

NAME disable_unknown_site
POST http://control.localhost/sites/not-a-site
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "disabled"}
ASSERT_STATUS 404

//////
// CREATE a site at an ID the admin picks, such as a vanity one for a special user
//////

NAME create_vanity_site
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"id": "vanityaa"}
ASSERT_STATUS 201
ASSERT_CONTAINS "vanityaa." "@result.url"
ASSERT_CONTAINS "vanityaa.ns." "@result.pwd_ns_url"
ASSERT_EXISTS "@result.admin_password"
ASSERT_EXISTS "@result.admin_totp_secret"
ASSERT_EXISTS "@result.pwd_ns_token"
ASSERT_EXISTS "@result.read_only_ns_token"
ASSERT_EXISTS "@result.backup_key"

// It is a site like any other: its admin logs in with the password it was given
NAME login_vanity_site_admin
POST http://vanityaa.localhost/login
H Accept: application/json
B {"name": "admin", "password": "{{ .create_vanity_site.result.admin_password }}", "totp": "123123"}
ASSERT_STATUS 200

NAME vanity_site_listed
GET http://control.localhost/sites/vanityaa
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "live" "@result.state"

// An ID that is taken is refused
NAME create_vanity_site_taken
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"id": "vanityaa"}
ASSERT_STATUS 409

// An ID must be 8 lowercase letters, like every site's
NAME create_site_id_too_short
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"id": "vanity"}
ASSERT_STATUS 400

NAME create_site_id_too_long
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"id": "vanityabc"}
ASSERT_STATUS 400

NAME create_site_id_uppercase
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"id": "Vanityab"}
ASSERT_STATUS 400

NAME create_site_id_digits
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"id": "vanity12"}
ASSERT_STATUS 400

NAME create_site_id_missing
POST http://control.localhost/sites
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
B {"state": "live"}
ASSERT_STATUS 400
