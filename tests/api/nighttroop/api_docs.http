// Every host serves the OpenAPI schema its API docs show, so a client or a person can read it
NAME get_openapi
GET http://localhost/openapi.json
ASSERT_STATUS 200
ASSERT_EQUALS "application/json" "#Content-Type.0"
ASSERT_EQUALS "Nighttroop" "@info.title"
ASSERT_EXISTS "@paths./site"

NAME create_site_for_api_docs
POST http://localhost/site
ASSERT_STATUS 200
// The site's URL and its Nightscout URL, so a client does not build them
ASSERT_CONTAINS "localhost" "@url"
ASSERT_CONTAINS "ns.localhost" "@pwd_ns_url"

NAME get_site_openapi
GET http://{{ .create_site_for_api_docs.site_subdomain }}.localhost/openapi.json
ASSERT_STATUS 200
ASSERT_EQUALS "Nighttroop" "@info.title"

// The docs page, Redoc's page of it, is served as HTML, showing only its own images, not Redocly's logo from their CDN,
// and, as every page, framed by no other page
NAME get_api_docs
GET http://localhost/api-docs
ASSERT_STATUS 200
ASSERT_EQUALS "text/html; charset=utf-8" "#Content-Type.0"
ASSERT_EQUALS "frame-ancestors 'none'; img-src 'self' data:" "#Content-Security-Policy.0"
