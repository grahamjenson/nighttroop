NAME control_login
POST http://control.localhost/login
H Accept: application/json
B {"name": "admin", "password": "password", "totp": "123123"}
ASSERT_STATUS 200
SET control_jwt {{ .control_login.token }}

NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET site_id {{ .create_new_site.site_subdomain }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME create_other_site
POST http://localhost/site
ASSERT_STATUS 200
SET other_site_id {{ .create_other_site.site_subdomain }}

// A site's identities are listed newest first, with who they are and when they were used, never their secrets
NAME list_identities
GET http://control.localhost/sites/{{ .site_id }}/identities
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 3 "@result"
ASSERT_EQUALS "read_only" "@result.0.name"
ASSERT_EQUALS "pwd_phone" "@result.1.name"
ASSERT_EQUALS "device_pwd_phone" "@result.1.role"
ASSERT_EQUALS false "@result.1.has_totp"
ASSERT_EQUALS "admin" "@result.2.name"
ASSERT_EQUALS true "@result.2.has_totp"
ASSERT_EQUALS true "@result.2.enabled"
SET pwd_id {{ (index .list_identities.result 1).id }}
SET admin_id {{ (index .list_identities.result 2).id }}

NAME list_identities_unknown_site
GET http://control.localhost/sites/notasite/identities
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

// Resetting the admin's password gives a new one, which it logs in with, recorded as changed by the control admin
NAME reset_admin_password
POST http://control.localhost/sites/{{ .site_id }}/identities/{{ .admin_id }}/password
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "admin" "@result.name"
ASSERT_EXISTS "@result.password"

NAME login_with_new_password
POST http://{{ .site }}/login
H Accept: application/json
B {"name": "admin", "password": "{{ .reset_admin_password.result.password }}", "totp": "123123"}
ASSERT_STATUS 200

NAME reset_recorded
GET http://control.localhost/sites/{{ .site_id }}/identities
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "admin" "@result.2.updated_by_identity_name"

// A device's new password comes with the Nightscout token made from it, which the phone then uses
NAME reset_pwd_password
POST http://control.localhost/sites/{{ .site_id }}/identities/{{ .pwd_id }}/password
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EXISTS "@result.ns_token"

NAME use_new_ns_token
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ .reset_pwd_password.result.ns_token }}
ASSERT_STATUS 200

// The admin logs in with TOTP, so it can have a new TOTP secret
NAME reset_admin_totp
POST http://control.localhost/sites/{{ .site_id }}/identities/{{ .admin_id }}/totp
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EXISTS "@result.totp_secret"

// The PWD phone does not log in with TOTP, so it has none to reset
NAME reset_pwd_totp_refused
POST http://control.localhost/sites/{{ .site_id }}/identities/{{ .pwd_id }}/totp
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 400

// An identity is only found in its own site
NAME reset_other_sites_identity
POST http://control.localhost/sites/{{ .other_site_id }}/identities/{{ .admin_id }}/password
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME reset_unknown_identity
POST http://control.localhost/sites/{{ .site_id }}/identities/notanid/password
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404
