NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME login_admin
POST http://{{ site }}/login
H Accept: application/json
B {"name": "admin", "password": "{{ .create_new_site.api_key }}", "totp": "123123"}
ASSERT_STATUS 200
SET jwt {{ .login_admin.token }}

NAME create_user
POST http://{{ site }}/settings/identities
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"name": "carer", "role": "user"}
ASSERT_STATUS 201
SET user_id {{ .create_user.result.id }}
SET user_password {{ .create_user.result.password }}

NAME login_user
POST http://{{ site }}/login
H Accept: application/json
B {"name": "carer", "password": "{{ .user_password }}"}
ASSERT_STATUS 200
ASSERT_EXISTS "@token"

NAME disable_user
POST http://{{ site }}/settings/identities/{{ .user_id }}
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"enabled": false}
ASSERT_STATUS 200

// A disabled identity cannot log in, even with the right password
NAME login_disabled_user
POST http://{{ site }}/login
H Accept: application/json
B {"name": "carer", "password": "{{ .user_password }}"}
ASSERT_STATUS 401
