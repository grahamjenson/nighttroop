INCLUDE steps/new_site.steps
INCLUDE steps/control_login.steps

// A site's PWD phone registers Loop for pushes
NAME register_loop
POST http://{{ site }}/settings/push-registrations
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"app": "loop", "provider": "apns", "bundle_id": "com.TEAM123456.loopkit.Loop", "production": true, "token": "c1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"}
ASSERT_STATUS 201
SET registration_id {{ .register_loop.result.id }}

// The control site lists every site's registrations, or one site's, newest first, with their site and identity,
// never the token
NAME control_push_devices
GET http://control.localhost/push-devices?site={{ .create_new_site.site_subdomain }}
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EXISTS "@result.0.site_id"
ASSERT_EQUALS "pwd_phone" "@result.0.identity_name"
ASSERT_EQUALS "loop" "@result.0.app"
ASSERT_EQUALS null "@result.0.token"

// Its admin can test any of them, which needs a credential for the app, which the site has none of
NAME control_test_push
POST http://control.localhost/push-devices/{{ .registration_id }}/test
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 400
ASSERT_CONTAINS "no push credential for the app loop" "@message"

NAME control_test_unknown_push
POST http://control.localhost/push-devices/999999/test
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 404

NAME control_push_devices_signed_out
GET http://control.localhost/push-devices
H Accept: application/json
ASSERT_STATUS 401
