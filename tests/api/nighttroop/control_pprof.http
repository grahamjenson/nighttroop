INCLUDE steps/control_login.steps

// A control admin reads Go's runtime stats, with its memory, and its profiles, to see where memory and CPU go
NAME vars
GET http://control.localhost/debug/vars
H Authorization: Bearer {{ .control_jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EXISTS "@memstats.HeapAlloc"

NAME heap_profile
GET http://control.localhost/debug/pprof/heap
H Authorization: Bearer {{ .control_jwt }}
ASSERT_STATUS 200

NAME goroutines
GET http://control.localhost/debug/pprof/goroutine?debug=1
H Authorization: Bearer {{ .control_jwt }}
ASSERT_STATUS 200

// Anyone not signed in cannot. A read only admin cannot either (TestControlReadOnlyIdentityCannotChangeTheServer)
NAME signed_out
GET http://control.localhost/debug/pprof/heap
H Accept: application/json
ASSERT_STATUS 401
