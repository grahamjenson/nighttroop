NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.localhost
SET ns_site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ .ns_site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}



#### Get Summary
NAME get_summary_v2
GET http://{{ site }}/summary
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// A new site's summary covers the last 48 hours and has nothing in it
NAME empty_summary
GET http://{{ site }}/summary
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 48 "@result.hours"
ASSERT_EQUALS "mmol/L" "@result.units"
ASSERT_LENGTH 0 "@result.glucose_readings"
ASSERT_LENGTH 0 "@result.device_statuses"

NAME create_reading_for_summary
POST http://{{ site }}/data/glucose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"reading": 6.5}
ASSERT_STATUS 201

NAME summary_has_reading
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 6 "@result.hours"
ASSERT_LENGTH 1 "@result.glucose_readings"
ASSERT_EQUALS 6.5 "@result.glucose_readings.0.reading"

// A summary goes back at most a week
NAME summary_at_most_a_week
GET http://{{ site }}/summary?hours=1000
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 168 "@result.hours"

NAME summary_bad_hours
GET http://{{ site }}/summary?hours=lots
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 400

