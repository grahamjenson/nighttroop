INCLUDE steps/new_site.steps



#### Get Summary
NAME get_summary_v2
GET http://{{ site }}/summary
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// A new site's summary covers the last 48 hours and has nothing in it
NAME empty_summary
GET http://{{ site }}/summary
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 48 "@result.0.hours"
ASSERT_EQUALS "mmol/L" "@result.0.units"
ASSERT_LENGTH 0 "@result.0.glucose_readings"
ASSERT_LENGTH 0 "@result.0.device_statuses"
// Its minutes cover the 48 hours, each null as no profile, temp target or temp basal is in force
ASSERT_LENGTH 2881 "@result.0.minutes"
ASSERT_EQUALS null "@result.0.minutes.0.low_target"
ASSERT_EQUALS null "@result.0.minutes.2880.basal"

NAME create_reading_for_summary
POST http://{{ site }}/data/glucose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"reading": 6.5}
ASSERT_STATUS 201

NAME summary_has_reading
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 6 "@result.0.hours"
ASSERT_LENGTH 1 "@result.0.glucose_readings"
ASSERT_EQUALS 6.5 "@result.0.glucose_readings.0.reading"

// A temp target is in force in the summary's latest minute, in the settings' units
NAME create_temp_target_for_summary
POST http://{{ site }}/data/temp-targets
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"low_target": 5, "high_target": 6, "duration_minutes": 30}
ASSERT_STATUS 201

NAME summary_has_temp_target_minutes
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 361 "@result.0.minutes"
ASSERT_EQUALS null "@result.0.minutes.0.low_target"
ASSERT_EQUALS 5 "@result.0.minutes.360.low_target"
ASSERT_EQUALS 6 "@result.0.minutes.360.high_target"

// A summary goes back at most a week
NAME summary_at_most_a_week
GET http://{{ site }}/summary?hours=1000
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 168 "@result.0.hours"

NAME summary_bad_hours
GET http://{{ site }}/summary?hours=lots
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 400


// A summary's low and high alarms are the alarm settings', in its units, outside which a reading is out of range: by
// default 72 and 180 mg/dL
NAME summary_default_alarms
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 3.996 "@result.0.low_alarm"
ASSERT_EQUALS 9.99 "@result.0.high_alarm"

// The alarms are set through Nightscout, as the site's pages do not show them
NAME set_identity_units
POST http://{{ site }}/settings/identity
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"units": "mg/dL"}
ASSERT_STATUS 200

NAME set_identity_low_alarm
PATCH http://{{ .ns_site }}/api/v3/settings/range_low_mgdl
H Authorization: Bearer {{ jwt }}
B {"value": 80}
ASSERT_STATUS 200

NAME set_identity_high_alarm
PATCH http://{{ .ns_site }}/api/v3/settings/range_high_mgdl
H Authorization: Bearer {{ jwt }}
B {"value": 150}
ASSERT_STATUS 200

NAME summary_has_identity_alarms
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.0.units"
ASSERT_EQUALS 80 "@result.0.low_alarm"
ASSERT_EQUALS 150 "@result.0.high_alarm"

// Today's time in range is the percent of its readings from the low to the high alarm, the 117 mg/dL reading in it.
// Yesterday has no readings or insulin, and there has been no sensor or site change yet.
NAME summary_today_in_range
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 100 "@result.0.today.time_in_range"
ASSERT_EQUALS 0 "@result.0.today.total_daily_dose"
ASSERT_EQUALS null "@result.0.yesterday.time_in_range"
ASSERT_EQUALS 0 "@result.0.yesterday.total_daily_dose"
ASSERT_EQUALS null "@result.0.sensor_started_at"
ASSERT_EQUALS null "@result.0.site_changed_at"

// A low reading takes half today's readings out of range, and a dose is in today's total daily dose
NAME create_low_reading_for_summary
POST http://{{ site }}/data/glucose
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"reading": 60}
ASSERT_STATUS 201

NAME create_dose_for_summary
POST http://{{ site }}/data/insulin
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"dose": 2.5}
ASSERT_STATUS 201

// A sensor start and a site change are when the sensor was started and the site last changed
NAME sensor_start_for_summary
POST http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"event_type": "Sensor Start", "notes": "Left arm"}
ASSERT_STATUS 201

NAME site_change_for_summary
POST http://{{ site }}/data/component-events
H Authorization: Bearer {{ jwt }}
H Accept: application/json
B {"event_type": "Site Change", "notes": "Right thigh"}
ASSERT_STATUS 201

NAME summary_today_out_of_range
GET http://{{ site }}/summary
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 50 "@result.0.today.time_in_range"
ASSERT_EQUALS 2.5 "@result.0.today.total_daily_dose"
ASSERT_EQUALS null "@result.0.yesterday.time_in_range"
ASSERT_EXISTS "@result.0.sensor_started_at"
ASSERT_EXISTS "@result.0.site_changed_at"

// The summary over 6 hours looks the days up, as it is shorter than them
NAME summary_short_has_days
GET http://{{ site }}/summary?hours=6
H Authorization: Bearer {{ jwt }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 50 "@result.0.today.time_in_range"
ASSERT_EQUALS 2.5 "@result.0.today.total_daily_dose"
