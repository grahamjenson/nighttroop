INCLUDE steps/new_ns_site.steps
INCLUDE steps/ns_units_mgdl.steps

// xDrip+ sends a blood test only as a meter reading (mbg). As on Nightscout, it is only an entry: API v3 gives it with
// the entries, never with the treatments, so AAPS (which takes finger sticks from BG Check treatments) does not get it.
// A careportal BG Check is a treatment, with its own reading.

NAME xdrip_finger_stick
POST http://{{ site }}/api/v1/entries
H api-secret: {{ sha1 token }}
B [{"type": "mbg", "mbg": 118, "device": "Manual Entry", "date": {{ itime 20 }}}]
ASSERT_STATUS 200
SET reading_id {{ dig "xdrip_finger_stick.0._id" }}

// AAPS's first load
NAME aaps_first_load
GET http://{{ site }}/api/v3/treatments?sort=created_at&created_at$gt={{ time 60 }}&limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

// AAPS's later loads
NAME aaps_history
GET http://{{ site }}/api/v3/treatments/history/0?limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

// The reading's identifier with "finger" after it is a treatment of none, as any unknown identifier
NAME read_by_identifier
GET http://{{ site }}/api/v3/treatments/{{ .reading_id }}finger
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

// The meter reading is an entry
NAME v3_entry
GET http://{{ site }}/api/v3/entries/{{ .reading_id }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mbg" "@result.type"
ASSERT_EQUALS 118 "@result.mbg"

// A careportal BG Check is a treatment, with its own reading
NAME careportal_bg_check
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "BG Check", "glucose": 110, "glucoseType": "Finger", "units": "mg/dl", "created_at": "{{ time 10 }}", "enteredBy": "careportal"}
ASSERT_STATUS 200

// xDrip+ downloads it and sends its reading back as its own mbg, which is the BG Check's reading
NAME xdrip_echo
POST http://{{ site }}/api/v1/entries
H api-secret: {{ sha1 token }}
B [{"type": "mbg", "mbg": 110, "device": "careportal via Nightscout", "date": {{ dig "careportal_bg_check.0.date" }}}]
ASSERT_STATUS 200

NAME only_the_treatment
GET http://{{ site }}/api/v3/treatments?sort=created_at&created_at$gt={{ time 60 }}&limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS 110 "@result.0.glucose"
ASSERT_EQUALS "careportal" "@result.0.enteredBy"

// API v1 is the same: the meter reading is an entry, not a treatment
NAME v1_only_treatments
GET http://{{ site }}/api/v1/treatments.json
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS 110 "@0.glucose"

// A delete of the reading's identifier with "finger" after it finds no treatment, and the reading stays
NAME aaps_deletes_finger_stick
DELETE http://{{ site }}/api/v3/treatments/{{ .reading_id }}finger
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

NAME reading_kept
GET http://{{ site }}/api/v1/entries.json?find[type]=mbg
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS 110 "@0.mbg"
ASSERT_EQUALS 118 "@1.mbg"

NAME history_only_the_treatment
GET http://{{ site }}/api/v3/treatments/history/0?limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS 110 "@result.0.glucose"
ASSERT_EQUALS true "@result.0.isValid"
