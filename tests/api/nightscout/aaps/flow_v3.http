NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"

// We need to check that all return values satisfy the core/nssdk models

// First AAPS will call status to check if logged in and other stats

NAME get_status
GET http://{{ site }}/api/v3/status 
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// Then call lastModified to see if it needs to download any new data
NAME get_last_modified
GET http://{{ site }}/api/v3/lastModified
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EXISTS "@result.collections"
ASSERT_EXISTS "@result.collections.entries"
ASSERT_EXISTS "@result.collections.treatments"
ASSERT_EXISTS "@result.collections.food"
ASSERT_EXISTS "@result.collections.devicestatus"
ASSERT_EXISTS "@result.collections.devicestatus"

// grabs the food
NAME get_food
GET http://{{ site }}/api/v3/food?limit=1000
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// Not sure what it is doing here, probably checking past devicestatuses
// TODO
NAME get_devicestatus_history
GET http://{{ site }}/api/v3/devicestatus/history/{{ itime 5 }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// Adds all the entries
NAME add_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": 1787481585647,
    "device": "Random",
    "direction": "FortyFiveUp",
    "filtered": 0.0,
    "isReadOnly": false,
    "isValid": true,
    "sgv": 196.41645726265494,
    "type": "sgv",
    "unfiltered": 0.0,
    "units": "mg/dl",
    "utcOffset": 720
 }
ASSERT_STATUS 201
ASSERT_EQUALS 196.416 "@result.sgv"
ASSERT_EQUALS "sgv" "@result.type"
ASSERT_EQUALS 720 "@result.utcOffset"
ASSERT_EXISTS "@result.identifier"
ASSERT_EXISTS "@result.date"
ASSERT_EQUALS "AAPS" "@result.app"
ASSERT_EQUALS "Random" "@result.device"
ASSERT_EQUALS "FortyFiveUp" "@result.direction"
ASSERT_EQUALS 0.0 "@result.filtered"
ASSERT_EQUALS 0.0 "@result.unfiltered"
ASSERT_EQUALS true "@result.isValid"
ASSERT_EQUALS false "@result.isReadOnly"
ASSERT_EQUALS "mg/dL" "@result.units"

