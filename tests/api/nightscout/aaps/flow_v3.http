NAME add_profile
POST http://{{ site }}/api/v3/profile
H Authorization: Bearer {{ jwt }}
B {
    "defaultProfile": "FirstProfile",
    "date": 1787480950196,
    "created_at": "2026-08-23T10:29:10.1960000Z",
    "startDate": "2026-08-23T10:29:10.1960000Z",
    "store": {
        "FirstProfile": {
            "dia": 5,
            "carbratio": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 10
                },
                {
                    "time": "01:00",
                    "timeAsSeconds": 3600,
                    "value": 10
                }
            ],
            "sens": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 10
                },
                {
                    "time": "01:00",
                    "timeAsSeconds": 3600,
                    "value": 10
                }
            ],
            "basal": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
