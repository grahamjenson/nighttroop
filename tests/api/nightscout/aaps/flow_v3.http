// This I think runs until there are no more treatments, as like a sync method
// This should actually work
NAME get_treatments_from_history_new
GET http://{{ site }}/api/v3/treatments/history/{{ itime 0 }}?limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"


NAME get_treatments_from_history_old
GET http://{{ site }}/api/v3/treatments/history/{{ itime 30 }}?limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 21 "@result"


/////
// SYNC
/////

NAME get_entries_since
GET http://{{ site }}/api/v3/entries?sort=date&date$gt=1778970005948&limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_treatments_since
GET http://{{ site }}/api/v3/treatments?sort=created_at&created_at$gt=2026-05-16T22:20:07.238Z&limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_profile_since
GET http://{{ site }}/api/v3/profile?sort$desc=date&limit=1
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200


////
// Adding stuff
////

NAME delete_unknown_treatment
DELETE http://{{ site }}/api/v3/treatments/NOT_REAL_ID
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

NAME create_carbs_meal_bolus
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "carbs": 25.0,
    "date": {{ itime 0 }},
    "eventType": "Meal Bolus",
    "isReadOnly": false,
    "isValid": false,
    "notes": "",
    "utcOffset": 720
 }
ASSERT_STATUS 201
ASSERT_EQUALS "Meal Bolus" "@result.eventType"
ASSERT_EQUALS 25.0 "@result.carbs"
