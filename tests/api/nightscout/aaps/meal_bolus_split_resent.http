INCLUDE steps/new_ns_site.steps
INCLUDE steps/ns_units_mgdl.steps

// A Meal Bolus AAPS changed or deleted the carbs of, which made them their own treatment (meal_bolus_split.http), is
// sent again by xDrip+, as it does when the treatment is edited or its upload queue sends it again. Its carbs go to the
// carbs treatment, so API v1 and v3 give the meal's carbs once.
SET meal_at {{ time 20 }}
SET second_meal_at {{ time 10 }}
SET between {{ time 15 }}
SET between_ms {{ itime 15 }}

NAME xdrip_meal_bolus
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "<none>", "enteredBy": "xdrip", "uuid": "0b6c6f1e-3c1d-4d6e-9a51-2f6a1b9c7d21",
   "_id": "6a1b2c3d4e5f60718293a4b5", "insulin": 1, "carbs": 12, "created_at": "{{ .meal_at }}"}
ASSERT_STATUS 200

NAME aaps_changes_carbs
PATCH http://{{ site }}/api/v3/treatments/6a1b2c3d4e5f60718293a4b5carbs
H Authorization: Bearer {{ jwt }}
B {"carbs": 18}
ASSERT_STATUS 200

NAME xdrip_sends_again
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "<none>", "enteredBy": "xdrip", "uuid": "0b6c6f1e-3c1d-4d6e-9a51-2f6a1b9c7d21",
   "_id": "6a1b2c3d4e5f60718293a4b5", "insulin": 1, "carbs": 12, "created_at": "{{ .meal_at }}"}
ASSERT_STATUS 200

// The carbs sent last are kept once, as in Nightscout, and the insulin is given without carbs
NAME v1_two_treatments
GET http://{{ site }}/api/v1/treatments.json
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"

NAME v1_carbs_once
GET http://{{ site }}/api/v1/treatments.json?find[eventType]=Carb%20Correction
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS 12 "@0.carbs"

NAME v1_insulin_without_carbs
GET http://{{ site }}/api/v1/treatments.json?find[eventType]=Meal%20Bolus
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS 1 "@0.insulin"
ASSERT_EQUALS null "@0.carbs"

NAME v3_carbs_once
GET http://{{ site }}/api/v3/treatments?limit=10&eventType=Carb%20Correction
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "6a1b2c3d4e5f60718293a4b5carbs" "@result.0.identifier"
ASSERT_EQUALS 12 "@result.0.carbs"

NAME v3_two_treatments
GET http://{{ site }}/api/v3/treatments?limit=10
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"

// xDrip+ sends it with the carbs changed there: the carbs treatment takes them
NAME xdrip_changes_carbs
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "<none>", "enteredBy": "xdrip", "uuid": "0b6c6f1e-3c1d-4d6e-9a51-2f6a1b9c7d21",
   "_id": "6a1b2c3d4e5f60718293a4b5", "insulin": 1, "carbs": 25, "created_at": "{{ .meal_at }}"}
ASSERT_STATUS 200

NAME v3_carbs_changed
GET http://{{ site }}/api/v3/treatments/6a1b2c3d4e5f60718293a4b5carbs
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 25 "@result.carbs"

NAME v3_insulin_still_without_carbs
GET http://{{ site }}/api/v3/treatments/6a1b2c3d4e5f60718293a4b5
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 1 "@result.insulin"
ASSERT_EQUALS null "@result.carbs"

// AAPS deletes the carbs of another, and xDrip+ sends it again: they stay deleted
NAME xdrip_second_meal_bolus
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "<none>", "enteredBy": "xdrip", "uuid": "5d0e2a7b-8f3c-4b1a-a6d2-9e4f7c1b3a58",
   "_id": "7b2c3d4e5f60718293a4b5c6", "insulin": 2, "carbs": 30, "created_at": "{{ .second_meal_at }}"}
ASSERT_STATUS 200

NAME aaps_deletes_carbs
DELETE http://{{ site }}/api/v3/treatments/7b2c3d4e5f60718293a4b5c6carbs
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME xdrip_sends_second_again
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "<none>", "enteredBy": "xdrip", "uuid": "5d0e2a7b-8f3c-4b1a-a6d2-9e4f7c1b3a58",
   "_id": "7b2c3d4e5f60718293a4b5c6", "insulin": 2, "carbs": 30, "created_at": "{{ .second_meal_at }}"}
ASSERT_STATUS 200

NAME v1_no_deleted_carbs
GET http://{{ site }}/api/v1/treatments.json?find[created_at][$gte]={{ .between }}
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS 2 "@0.insulin"
ASSERT_EQUALS null "@0.carbs"

NAME v3_no_deleted_carbs
GET http://{{ site }}/api/v3/treatments?limit=10&date$gte={{ .between_ms }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS "7b2c3d4e5f60718293a4b5c6" "@result.0.identifier"
ASSERT_EQUALS null "@result.0.carbs"

NAME v3_carbs_deleted
GET http://{{ site }}/api/v3/treatments/7b2c3d4e5f60718293a4b5c6carbs
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 410

// History has the carbs once, deleted, as a read by their identifier says
NAME history_carbs_once
GET http://{{ site }}/api/v3/treatments/history/0?limit=10
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 4 "@result"
ASSERT_EQUALS "7b2c3d4e5f60718293a4b5c6carbs" "@result.2.identifier"
ASSERT_EQUALS false "@result.2.isValid"
ASSERT_EQUALS "7b2c3d4e5f60718293a4b5c6" "@result.3.identifier"
ASSERT_EQUALS true "@result.3.isValid"
ASSERT_EQUALS null "@result.3.carbs"

// xDrip+ sends it with other carbs: the carbs stay deleted, as AAPS deleted them and the loop would dose for them
NAME xdrip_changes_deleted_carbs
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
B {"eventType": "<none>", "enteredBy": "xdrip", "uuid": "5d0e2a7b-8f3c-4b1a-a6d2-9e4f7c1b3a58",
   "_id": "7b2c3d4e5f60718293a4b5c6", "insulin": 2, "carbs": 20, "created_at": "{{ .second_meal_at }}"}
ASSERT_STATUS 200

NAME v3_carbs_still_deleted
GET http://{{ site }}/api/v3/treatments/7b2c3d4e5f60718293a4b5c6carbs
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 410

NAME v1_still_no_carbs
GET http://{{ site }}/api/v1/treatments.json?find[created_at][$gte]={{ .between }}
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS 2 "@0.insulin"
ASSERT_EQUALS null "@0.carbs"

NAME v3_still_no_carbs
GET http://{{ site }}/api/v3/treatments?limit=10&date$gte={{ .between_ms }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@result"
ASSERT_EQUALS null "@result.0.carbs"

// A treatment given carbs again on API v3, once its carbs are their own treatment, gives one carbs part there
NAME aaps_gives_insulin_carbs
PATCH http://{{ site }}/api/v3/treatments/6a1b2c3d4e5f60718293a4b5
H Authorization: Bearer {{ jwt }}
B {"carbs": 5}
ASSERT_STATUS 200

NAME v3_one_carbs_part
GET http://{{ site }}/api/v3/treatments?limit=10&date$lt={{ .between_ms }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"
