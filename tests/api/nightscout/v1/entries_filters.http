NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME create_sgv_and_mbg
POST http://{{ site }}/api/v1/entries?token={{ token }}
B [{ "sgv": 101, "type": "sgv", "dateString": "{{ time 2 }}" }, { "mbg": 120, "type": "mbg", "dateString": "{{ time 1 }}" }]
ASSERT_STATUS 200

// The type in the path filters, whatever else is in the query
NAME get_sgv_only
GET http://{{ site }}/api/v1/entries/sgv?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS "sgv" "@0.type"

NAME get_mbg_only
GET http://{{ site }}/api/v1/entries/mbg?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS "mbg" "@0.type"

NAME slice_mbg_only
GET http://{{ site }}/api/v1/slice/entries/dateString/mbg/2?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS "mbg" "@0.type"

// A filter on a field Nighttroop cannot filter on matches nothing, rather than being ignored and matching everything
NAME unknown_filter_matches_nothing
GET http://{{ site }}/api/v1/entries?find[noise]=1&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@"

NAME unknown_filter_with_known_ones_matches_nothing
GET http://{{ site }}/api/v1/entries?find[type]=sgv&find[$and][0][device][$ne]=xDrip&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@"

// A parameter that is not a filter, like a cache buster, is still ignored
NAME unknown_parameter_ignored
GET http://{{ site }}/api/v1/entries?_=12345&token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"

// History only has what changed since the time in the path
NAME history_since_before
GET http://{{ site }}/api/v3/entries/history/{{ itime 60 }}?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result"

NAME history_since_after
GET http://{{ site }}/api/v3/entries/history/{{ itime -60 }}?token={{ token }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"
