/////
// GET
//////
NAME get_treatments_v1
GET http://{{ site }}/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS "Meal Bolus" "@0.eventType"
ASSERT_EXISTS "@0.created_at"
ASSERT_EQUALS 10 "@0.glucose"
ASSERT_EQUALS "Sensor" "@0.glucoseType"
ASSERT_EQUALS 45 "@0.carbs"
ASSERT_EQUALS 4.2 "@0.insulin"
ASSERT_EQUALS "Here are some notes" "@0.notes"
ASSERT_EQUALS "lunch" "@0.reason"
ASSERT_EXISTS "@0._id"
ASSERT_EXISTS "@0.utcOffset"

NAME get_treatments_type_v1
GET http://{{ site }}/api/v1/treatments/Meal%20Bolus?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS "Meal Bolus" "@0.eventType"
ASSERT_EQUALS 10 "@0.glucose"
ASSERT_EQUALS "Sensor" "@0.glucoseType"

NAME put_update_treatments_v1
PUT http://{{ site }}/api/v1/treatments?token={{ token }}
B {
  "_id": "{{ dig "create_meal_bolus_v1.0._id" }}",
  "eventType": "Meal Bolus",
  "notes": "Updated from put_update_treatments_v1"
  }
ASSERT_STATUS 200

NAME get_treatments_after_updates_v1
GET http://{{ site }}/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS "Updated from put_update_treatments_v1" "@0.notes"

NAME put_create_treatments_v1
PUT http://{{ site }}/api/v1/treatments?token={{ token }}
B {
  "_id": "myveryownid",
  "eventType": "Meal Bolus",
  "notes": "Updated from put_create_treatments_v1"
  }
ASSERT_STATUS 200
ASSERT_EQUALS "Updated from put_create_treatments_v1" "@notes"
ASSERT_EQUALS "myveryownid" "@_id"

NAME get_treatments_after_user_id_create_v1
GET http://{{ site }}/api/v1/treatments/myveryownid?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS "Updated from put_create_treatments_v1" "@0.notes"

NAME put_create_uuid_treatments_v1
PUT http://{{ site }}/api/v1/treatments?token={{ token }}
B { "_id": "0b9e2c4a-6f1d-4e8b-9a37-5c2d8e1f4a60", "eventType": "Note", "notes": "uuid identifier" }
ASSERT_STATUS 200
ASSERT_EQUALS "0b9e2c4a-6f1d-4e8b-9a37-5c2d8e1f4a60" "@_id"

NAME get_uuid_treatments_v3
GET http://{{ site }}/api/v3/treatments/0b9e2c4a-6f1d-4e8b-9a37-5c2d8e1f4a60
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "uuid identifier" "@result.notes"


////////
// FULL TESTS
////////

# Announcement TreatmentEventType = "Announcement"
# return site.EventGroupsBundle{
# 	EventGroup:        eventGroup,
# 	NotificationEvent: notificationEvent,
# }

NAME create_full_announcement_v1
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Announcement",
  "created_at": "{{ time 0 }}",
  "notes": "Announcement",
  "reason": "reason",
  "name": "Name"
 }
ASSERT_STATUS 200
ASSERT_EQUALS "Announcement" "@0.eventType"
ASSERT_EXISTS "@0.created_at"
ASSERT_EQUALS "Announcement" "@0.notes"
ASSERT_EQUALS "reason" "@0.reason"
ASSERT_EQUALS "Name" "@0.name"


# Note         TreatmentEventType = "Note"
# return site.EventGroupsBundle{
# 	EventGroup:     eventGroup,
# 	GlucoseReading: glucoseReading,
# 	InsulinDose:    insulinDose,
# 	FoodIntake:     foodIntake,
# 	ProfileSwitch:  profileSwitch,
# 	Activity:       activity,
# 	ComponentEvent: componentEvent,
# }
// A minute ago, so it is never taken for put_create_uuid_treatments_v1's Note, which the server dated now: a Note at
// the same millisecond is a duplicate, and that one lands on a whole second about once in a thousand runs
NAME create_full_note_v1
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Note",
  "created_at": "{{ time 1 }}",
  "notes": "Note",
  "reason": "reason",
  
  "glucose": 5.5,
  "glucoseType": "Sensor",
  "units": "mmol/L",

  "insulin": 1.2,
  "type": "Bolus",
  "splitNow": 70,
  "splitExt": 30,

  "name": "Hells Pizza",
  "foodType": "Pizza",
  "category": "Fast Food",
  "subcategory": "Italian",

  "carbs": 45,
  "preBolus": 10,
  "absorptionTime": 120,

  "protein": 20,
  "fat": 10,
  "fibre": 5,
  "energy": 300,
  "portions": 2,

  "profile": "Weekend",
  "profileJson": "{\"units\":\"mmol/L\",\"dia\":6,\"timezone\":\"Pacific/Kwajalein\",\"sens\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":20}],\"carbratio\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":20}],\"basal\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":0.2}],\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":5.5}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":7}]}",
  "duration": 90,
  "percentage": 50,
  "timeshift": 1,

  "activityType": "Running",
  "calories": 500,
  "steps": 10000,
  "heartRate": 120,

  "sensorCode": "ABC123",
  "transmitterId": "XYZ789",
  "pumpId": "PUMP123",
  "pumpSerial": "SERIAL123",
  "pumpType": "Insulin Pump"
  
 }
ASSERT_STATUS 200
ASSERT_EQUALS "Note" "@0.eventType"
ASSERT_EXISTS "@0.created_at"
ASSERT_EQUALS "Note" "@0.notes"
ASSERT_EQUALS "reason" "@0.reason"
ASSERT_EQUALS 5.5 "@0.glucose"
ASSERT_EQUALS "Sensor" "@0.glucoseType"
ASSERT_EQUALS "mmol/L" "@0.units"
ASSERT_EQUALS 1.2 "@0.insulin"
ASSERT_EQUALS "Bolus" "@0.type"
ASSERT_EQUALS 70 "@0.splitNow"
ASSERT_EQUALS 30 "@0.splitExt"
ASSERT_EQUALS "Hells Pizza" "@0.name"
ASSERT_EQUALS "Pizza" "@0.foodType"
ASSERT_EQUALS "Fast Food" "@0.category"
ASSERT_EQUALS "Italian" "@0.subcategory"
ASSERT_EQUALS 45 "@0.carbs"
ASSERT_EQUALS 10 "@0.preBolus"
ASSERT_EQUALS 120 "@0.absorptionTime"
ASSERT_EQUALS 20 "@0.protein"
ASSERT_EQUALS 10 "@0.fat"
ASSERT_EQUALS 5 "@0.fibre"
ASSERT_EQUALS 300 "@0.energy"
ASSERT_EQUALS 2 "@0.portions"
ASSERT_EQUALS "Weekend" "@0.profile"
ASSERT_EQUALS "{\"units\":\"mmol/L\",\"dia\":6,\"timezone\":\"Pacific/Kwajalein\",\"sens\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":20}],\"carbratio\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":20}],\"basal\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":0.2}],\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":5.5}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":7}]}" "@0.profileJson"
ASSERT_EQUALS 90 "@0.duration"
ASSERT_EQUALS 50 "@0.percentage"
ASSERT_EQUALS 1 "@0.timeshift"
ASSERT_EQUALS "Running" "@0.activityType"
ASSERT_EQUALS 500 "@0.calories"
ASSERT_EQUALS 10000 "@0.steps"
ASSERT_EQUALS 120 "@0.heartRate"
ASSERT_EQUALS "ABC123" "@0.sensorCode"
ASSERT_EQUALS "XYZ789" "@0.transmitterId"
ASSERT_EQUALS "PUMP123" "@0.pumpId"
ASSERT_EQUALS "SERIAL123" "@0.pumpSerial"
ASSERT_EQUALS "Insulin Pump" "@0.pumpType"



