NAME create_full_calibration_v1
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Calibration",
  "created_at": "{{ time 0 }}",
  "notes": "Calibration",
  "reason": "reason",

  "glucose": 5.5,
  "glucoseType": "Sensor",
  "units": "mmol/L",

    "sensorCode": "ABC123",
  "transmitterId": "XYZ789",
  "pumpId": "PUMP123",
  "pumpSerial": "SERIAL123",
  "pumpType": "Insulin Pump"
 }
ASSERT_STATUS 200
