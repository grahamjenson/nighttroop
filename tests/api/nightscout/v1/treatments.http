POST http://{{ site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Prime",
  "created_at": "{{ time 0 }}",
  "notes": "Prime",
  "reason": "reason",

    "sensorCode": "ABC123",
  "transmitterId": "XYZ789",
  "pumpId": "PUMP123",
  "pumpSerial": "SERIAL123",
  "pumpType": "Insulin Pump"
 }
ASSERT_STATUS 200
ASSERT_EQUALS "Prime" "@0.eventType"
ASSERT_EXISTS "@0.created_at"
ASSERT_EQUALS "Prime" "@0.notes"
ASSERT_EQUALS "reason" "@0.reason"
ASSERT_EQUALS "ABC123" "@0.sensorCode"
ASSERT_EQUALS "XYZ789" "@0.transmitterId"
ASSERT_EQUALS "PUMP123" "@0.pumpId"
ASSERT_EQUALS "SERIAL123" "@0.pumpSerial"
ASSERT_EQUALS "Insulin Pump" "@0.pumpType"


