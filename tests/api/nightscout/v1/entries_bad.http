
NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"

/////
// Create
//////

NAME create_bad_entry_direction_too_long_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"app":"","date":1787481585647,"direction":"thisstringislongerthanisallowedsoIthinkitshouldcorrectlyerror","sgv":196,"type":"sgv"}
ASSERT_STATUS 400
ASSERT_CONTAINS "length(direction) <= 16" "@message"

NAME create_bad_entry_no_type_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"app":"","date":1787481585647, "type": "bad"}
ASSERT_STATUS 400
ASSERT_CONTAINS "type" "@message"

NAME create_bad_entry_dateString_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"app":"","date":1787481585647, "type": "bad", "dateString": "notARealTime"}
ASSERT_STATUS 400
ASSERT_CONTAINS "date string" "@message"

// Glucose far outside real use is refused, as the site API does
NAME create_bad_entry_sgv_too_high_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B [{"type":"sgv","sgv":5000,"date":{{ itime 0 }}}]
ASSERT_STATUS 400
ASSERT_CONTAINS "at most 1000 mg/dL" "@message"

NAME create_bad_entry_mbg_too_high_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"type":"mbg","mbg":1001,"date":{{ itime 1 }}}
ASSERT_STATUS 400

// Checked in mg/dL, so 60 mmol/L is over 1000 mg/dL
NAME create_bad_entry_mmol_too_high_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"type":"sgv","sgv":60,"units":"mmol/L","date":{{ itime 2 }}}
ASSERT_STATUS 400

NAME create_bad_entry_sgv_zero_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"type":"sgv","sgv":0,"date":{{ itime 3 }}}
ASSERT_STATUS 400

NAME create_bad_entry_sgv_negative_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"type":"sgv","sgv":-5,"date":{{ itime 4 }}}
ASSERT_STATUS 400

NAME create_bad_entry_no_glucose_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"type":"sgv","date":{{ itime 5 }}}
ASSERT_STATUS 400

NAME create_entry_at_max_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B {"type":"sgv","sgv":1000,"date":{{ itime 6 }}}
ASSERT_STATUS 200
ASSERT_EQUALS 1000 "@0.sgv"

NAME bad_entries_not_stored_v1
GET http://{{ site }}/api/v1/entries?token={{ token }}&find[date][$gte]={{ itime 7 }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"

/////
// Read
/////

NAME get_entries_404_v1
GET http://{{ site }}/api/v1/entries/not_a_id?token={{ token }}
ASSERT_STATUS 404
ASSERT_CONTAINS "record not found" "@message"


/////
// Update
/////

NAME create_entry_for_bad_tests_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B { "sgv": 101, "type": "sgv", "device": "my-device", "app": "my-app", "dateString": "2024-06-05T12:00:00+12:00" }
ASSERT_STATUS 200
ASSERT_EQUALS 101 "@0.sgv"
ASSERT_EQUALS "sgv" "@0.type"
ASSERT_EXISTS "@0._id"
ASSERT_EXISTS "@0.utcOffset"

NAME bad_update_but_change_device_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "device": "not-device", "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_EQUALS "Field device cannot be modified by the client" "@message"
ASSERT_EQUALS 400 "@status"

// Bad data on a replace is a 400, as it is on create
NAME bad_update_direction_too_long_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "device": "my-device", "app": "my-app", "dateString": "2024-06-05T12:00:00+12:00", "direction": "thisstringislongerthanisallowedsoIthinkitshouldcorrectlyerror", "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_CONTAINS "length(direction) <= 16" "@message"

NAME bad_update_sgv_too_high_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "device": "my-device", "app": "my-app", "dateString": "2024-06-05T12:00:00+12:00", "sgv": 5000, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_CONTAINS "at most 1000 mg/dL" "@message"

NAME bad_update_but_change_app_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "app": "not-app", "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_EQUALS "Field app cannot be modified by the client" "@message"
ASSERT_EQUALS 400 "@status"

NAME bad_update_but_change_subject_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "subject": "not-subject", "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_EQUALS "Field subject cannot be modified by the client" "@message"
ASSERT_EQUALS 400 "@status"

NAME bad_update_but_change_date_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "date": 1234567890, "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_EQUALS "Field date cannot be modified by the client" "@message"
ASSERT_EQUALS 400 "@status"

NAME bad_update_but_change_utcOffset_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "utcOffset": 1234567890, "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_EQUALS "Field utcOffset cannot be modified by the client" "@message"
ASSERT_EQUALS 400 "@status"

NAME bad_update_but_change_identifier_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_for_bad_tests_v1.0._id" }}", "identifier": "not-identifier", "sgv": 104, "type": "sgv" }
ASSERT_STATUS 400
ASSERT_EQUALS "Field identifier cannot be modified by the client" "@message"
ASSERT_EQUALS 400 "@status"