NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}

//////
// CREATE
//////

NAME create_entry_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B { "sgv": 101, "type": "sgv"}
ASSERT_STATUS 200
ASSERT {{ assertEquals 101 "@0.sgv" }}
ASSERT {{ assertEquals "sgv" "@0.type" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME create_full_entry_v1
POST http://{{ site }}/api/v1/entries?token={{ token}}
B {
    "sgv": 100,
    "type": "sgv",
    "app": "test-app",
    "direction": "Flat",
    "trend": 3,
    "dateString": "{{ time 0 }}",
    "filtered": 139.2,
    "unfiltered": 141.7, 
    "rssi": -62, 
    "noise": 1 
 }
ASSERT_STATUS 200
ASSERT {{ assertEquals 100 "@0.sgv" }}
ASSERT {{ assertEquals "sgv" "@0.type" }}
ASSERT {{ assertEquals "test-app" "@0.app" }}
ASSERT {{ assertEquals "Flat" "@0.direction" }}
ASSERT {{ assertEquals 3 "@0.trend" }}
ASSERT {{ assertExists "@0.dateString" }}
ASSERT {{ assertEquals 139.2 "@0.filtered" }}
ASSERT {{ assertEquals 141.7 "@0.unfiltered" }}
ASSERT {{ assertEquals -62 "@0.rssi" }}
ASSERT {{ assertEquals 1 "@0.noise" }}



///////
// READ
///////

NAME get_entries_v1
GET http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 101 "@0.sgv" }}
ASSERT {{ assertEquals "sgv" "@0.type" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME get_entries_type_v1
GET http://{{ site }}/api/v1/entries/sgv?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 101 "@0.sgv" }}
ASSERT {{ assertEquals "sgv" "@0.type" }}

//////
// OTHER
//////

NAME create_other_entry_v1
POST http://{{ .site }}/api/v1/entries?token={{ token}}
B {"sgv": 100, "date": 1767355994, "dateString": "2026-01-02T12:13:14Z", "type": "sgv" }
ASSERT_STATUS 200
ASSERT {{ assertEquals 100 "@0.sgv" }}


NAME get_entries_current_v1
GET http://{{ site }}/api/v1/entries/current?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertExists "@0._id" }}


NAME get_entries_count_v1
GET http://{{ site }}/api/v1/count/entries/where?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 3 "@count" }}

NAME get_entries_times_v1
GET http://{{ site }}/api/v1/times/2026-01-02?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertLength 1 "@" }}

NAME get_entries_slice_v1
GET http://{{ site }}/api/v1/slice/entries/dateString/sgv/2026-01?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertExists "@0._id" }}



NAME get_entries_echo_v1
GET http://{{ .site }}/api/v1/echo/entries/sgv?token={{ token }}&find[sgv][$gte]=100
ASSERT_STATUS 200
ASSERT {{ assertExists "@query" }}


/////
// UPDATE
/////

NAME update_entries_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "{{ dig "create_entry_v1.0._id" }}", "sgv": 102, "type": "sgv" }
ASSERT_STATUS 200
ASSERT {{ assertEquals 102 "@sgv" }}

NAME get_entries_after_put_v1
GET http://{{ site }}/api/v1/entries/sgv?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 102 "@0.sgv" }}
ASSERT {{ assertEquals "sgv" "@0.type" }}

NAME update_entries_force_create_v1
PUT http://{{ site }}/api/v1/entries?token={{ token }}
B { "_id": "MyVeryOwnID", "sgv": 102, "type": "sgv" }
ASSERT_STATUS 200
ASSERT {{ assertEquals 102 "@sgv" }}

///////
// DELETE
///////

NAME delete_entries_v1
DELETE http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 1 "@deletedCount" }}

NAME delete_entries_again_v1
DELETE http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 0 "@deletedCount" }}

NAME get_soft_deleted_entry_v1
GET http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 404

NAME get_soft_deleted_entry_with_allow_deleted_v1
GET http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}&includeDeleted=true
ASSERT_STATUS 200
ASSERT {{ assertEquals 102 "@0.sgv" }}


NAME delete_entries_permanent_v1
DELETE http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}&permanent=true
ASSERT_STATUS 200
ASSERT {{ assertEquals 1 "@deletedCount" }}

NAME delete_entries_permanent_again_v1
DELETE http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}&permanent=true
ASSERT_STATUS 200
ASSERT {{ assertEquals 0 "@deletedCount" }}

NAME get_soft_deleted_entry_with_allow_deleted_v1
GET http://{{ site }}/api/v1/entries/{{ dig "create_entry_v1.0._id" }}?token={{ token }}&includeDeleted=true
ASSERT_STATUS 404

NAME delete_entries_by_type_v1
DELETE http://{{ site }}/api/v1/entries/sgv?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 3 "@deletedCount" }}


NAME delete_entries_by_type_again_v1
DELETE http://{{ site }}/api/v1/entries/sgv?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 0 "@deletedCount" }}


NAME delete_entries_permanent_by_type_v1
DELETE http://{{ site }}/api/v1/entries/sgv?token={{ token }}&permanent=true
ASSERT_STATUS 200
ASSERT {{ assertEquals 3 "@deletedCount" }}

NAME delete_entries_permanent_by_type_again_v1
DELETE http://{{ site }}/api/v1/entries/sgv?token={{ token }}&permanent=true
ASSERT_STATUS 200
ASSERT {{ assertEquals 0 "@deletedCount" }}