INCLUDE steps/new_ns_site.steps

// Some clients find treatments since a time given only to the minute, without a zone, which is UTC as the
// created_at it is compared with is
NAME create_treatment
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Correction Bolus", "insulin": 1.5, "created_at": "2025-03-04T10:30:00.000Z" }
ASSERT_STATUS 200

// As the client sends it, with its brackets encoded
NAME find_since_the_minute_before
GET http://{{ site }}/api/v1/treatments.json?token={{ token }}&find%5Bcreated_at%5D%5B$gte%5D=2025-03-04T10:29&count=1000
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS "Correction Bolus" "@0.eventType"

NAME find_since_the_minute_after
GET http://{{ site }}/api/v1/treatments.json?token={{ token }}&find[created_at][$gte]=2025-03-04T10:31&count=1000
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@"

// A minute with a zone is that time in its zone
NAME find_since_the_minute_before_in_a_zone
GET http://{{ site }}/api/v1/treatments.json?token={{ token }}&find[created_at][$gte]=2025-03-04T23:29%2B13:00&count=1000
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
