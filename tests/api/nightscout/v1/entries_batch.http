NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

// A batch of 100 entries is the uploader batch size and is accepted
NAME create_entries_batch_at_cap_v1
POST http://{{ site }}/api/v1/entries?token={{ token }}
B [{"type":"sgv","sgv":100,"date":{{ itime 1 }}},{"type":"sgv","sgv":100,"date":{{ itime 2 }}},{"type":"sgv","sgv":100,"date":{{ itime 3 }}},{"type":"sgv","sgv":100,"date":{{ itime 4 }}},{"type":"sgv","sgv":100,"date":{{ itime 5 }}},{"type":"sgv","sgv":100,"date":{{ itime 6 }}},{"type":"sgv","sgv":100,"date":{{ itime 7 }}},{"type":"sgv","sgv":100,"date":{{ itime 8 }}},{"type":"sgv","sgv":100,"date":{{ itime 9 }}},{"type":"sgv","sgv":100,"date":{{ itime 10 }}},{"type":"sgv","sgv":100,"date":{{ itime 11 }}},{"type":"sgv","sgv":100,"date":{{ itime 12 }}},{"type":"sgv","sgv":100,"date":{{ itime 13 }}},{"type":"sgv","sgv":100,"date":{{ itime 14 }}},{"type":"sgv","sgv":100,"date":{{ itime 15 }}},{"type":"sgv","sgv":100,"date":{{ itime 16 }}},{"type":"sgv","sgv":100,"date":{{ itime 17 }}},{"type":"sgv","sgv":100,"date":{{ itime 18 }}},{"type":"sgv","sgv":100,"date":{{ itime 19 }}},{"type":"sgv","sgv":100,"date":{{ itime 20 }}},{"type":"sgv","sgv":100,"date":{{ itime 21 }}},{"type":"sgv","sgv":100,"date":{{ itime 22 }}},{"type":"sgv","sgv":100,"date":{{ itime 23 }}},{"type":"sgv","sgv":100,"date":{{ itime 24 }}},{"type":"sgv","sgv":100,"date":{{ itime 25 }}},{"type":"sgv","sgv":100,"date":{{ itime 26 }}},{"type":"sgv","sgv":100,"date":{{ itime 27 }}},{"type":"sgv","sgv":100,"date":{{ itime 28 }}},{"type":"sgv","sgv":100,"date":{{ itime 29 }}},{"type":"sgv","sgv":100,"date":{{ itime 30 }}},{"type":"sgv","sgv":100,"date":{{ itime 31 }}},{"type":"sgv","sgv":100,"date":{{ itime 32 }}},{"type":"sgv","sgv":100,"date":{{ itime 33 }}},{"type":"sgv","sgv":100,"date":{{ itime 34 }}},{"type":"sgv","sgv":100,"date":{{ itime 35 }}},{"type":"sgv","sgv":100,"date":{{ itime 36 }}},{"type":"sgv","sgv":100,"date":{{ itime 37 }}},{"type":"sgv","sgv":100,"date":{{ itime 38 }}},{"type":"sgv","sgv":100,"date":{{ itime 39 }}},{"type":"sgv","sgv":100,"date":{{ itime 40 }}},{"type":"sgv","sgv":100,"date":{{ itime 41 }}},{"type":"sgv","sgv":100,"date":{{ itime 42 }}},{"type":"sgv","sgv":100,"date":{