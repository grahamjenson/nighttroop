ASSERT_CONTAINS "\"value\":5.55" "@result.profileJson"

### Glucose Settings

# Units are taken in any spelling, and written as Nightscout writes them, mg/dl or mmol
NAME create_mmol_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 1 }},
    "eventType": "BG Check",
    "glucose": 7,
    "units": "mmol/L",
    "created_at": "{{ time 1 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mmol" "@result.units"
ASSERT_EQUALS 7 "@result.glucose"

NAME create_mgdl_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 2 }},
    "eventType": "BG Check",
    "glucose": 70,
    "units": "mg/dL",
    "created_at": "{{ time 2 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mmol" "@result.units"
ASSERT_EQUALS 3.885 "@result.glucose"

NAME create_unlabeled_mmol_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 3 }},
    "eventType": "BG Check",
    "glucose": 7,
    "created_at": "{{ time 3 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mmol" "@result.units"
ASSERT_EQUALS 7 "@result.glucose"

NAME create_unlabeled_mgdl_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 4 }},
    "eventType": "BG Check",
    "glucose": 70,
    "created_at": "{{ time 4 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mmol" "@result.units"
ASSERT_EQUALS 3.885 "@result.glucose"

# GET

######
# NOW CHANGE TO MGDL
######

INCLUDE steps/ns_units_mgdl.steps


NAME get_profile_switch_mmol
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mmol_profile_switch.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_CONTAINS "\"units\":\"mg/dL\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":108.108" "@result.profileJson"
ASSERT_CONTAINS "\"value\":144.144" "@result.profileJson"

NAME get_profile_switch_mgdl
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mgdl_profile_switch.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_CONTAINS "\"units\":\"mg/dL\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":70" "@result.profileJson"
ASSERT_CONTAINS "\"value\":100" "@result.profileJson"


NAME get_profile_switch_unlabeled_mmol
GET http://{{ site }}/api/v3/treatments/{{ dig "create_unlabeled_mmol_profile_switch.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_CONTAINS "\"units\":\"mg/dL\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":108.108" "@result.profileJson"
ASSERT_CONTAINS "\"value\":144.144" "@result.profileJson"

NAME get_profile_switch_unlabeled_mgdl
GET http://{{ site }}/api/v3/treatments/{{ dig "create_unlabeled_mgdl_profile_switch.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_CONTAINS "\"units\":\"mg/dL\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":70" "@result.profileJson"
ASSERT_CONTAINS "\"value\":100" "@result.profileJson"


# Glucose 

NAME get_glucose_reading_mmol
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mmol_bg_check.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dl" "@result.units"
ASSERT_EQUALS 126.126 "@result.glucose"

NAME get_glucose_reading_mgdl
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mgdl_bg_check.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dl" "@result.units"
ASSERT_EQUALS 70 "@result.glucose"

NAME get_unlabeled_glucose_reading_mmol
GET http://{{ site }}/api/v3/treatments/{{ dig "create_unlabeled_mmol_bg_check.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dl" "@result.units"
ASSERT_EQUALS 126.126 "@result.glucose"

NAME get_unlabeled_glucose_reading_mgdl
GET http://{{ site }}/api/v3/treatments/{{ dig "create_unlabeled_mgdl_bg_check.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dl" "@result.units"
ASSERT_EQUALS 70 "@result.glucose"