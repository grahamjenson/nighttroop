### Glucose Settings

NAME create_mmol_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 1 }},
    "eventType": "BG Check",
    "glucose": 7,
    "units": "mmol/L",
    "created_at": "{{ time 1 }}"
 }
ASSERT_STATUS 201
ASSERT {{ assertEquals "mmol/L" "@result.units" }}
ASSERT {{ assertEquals 7 "@result.glucose" }}

NAME create_mgdl_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 2 }},
    "eventType": "BG Check",
    "glucose": 70,
    "units": "mg/dL",
    "created_at": "{{ time 2 }}"
 }
ASSERT_STATUS 201
ASSERT {{ assertEquals "mmol/L" "@result.units" }}
ASSERT {{ assertEquals 3.885 "@result.glucose" }}

NAME create_unlabeled_mmol_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 3 }},
    "eventType": "BG Check",
    "glucose": 7,
    "created_at": "{{ time 3 }}"
 }
ASSERT_STATUS 201
ASSERT {{ assertEquals "mmol/L" "@result.units" }}
ASSERT {{ assertEquals 7 "@result.glucose" }}

NAME create_unlabeled_mgdl_bg_check
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
