    "timeshift": 0,
    "utcOffset": 720,
    "created_at": "{{ time 2 }}"
 }
ASSERT_STATUS 201
ASSERT_CONTAINS "\"units\":\"mmol/L\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":6" "@result.profileJson"
ASSERT_CONTAINS "\"value\":8" "@result.profileJson"

NAME create_unlabeled_mgdl_profile_switch
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 3 }},
    "eventType": "Profile Switch",
    "originalProfileName": "SamDash-2025",
    "percentage": 120,
    "profile": "SamDash-2025(120%)",
    "profileJson": "{\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":70}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":100}]}",
    "timeshift": 0,
    "utcOffset": 720,
    "created_at": "{{ time 3 }}"
 }
ASSERT_STATUS 201
