    "date": {{ itime 4 }},
    "eventType": "BG Check",
    "glucose": 70,
    "created_at": "{{ time 4 }}"
 }
ASSERT_STATUS 201
ASSERT {{ assertEquals "mmol/L" "@result.units" }}
ASSERT {{ assertEquals 3.885 "@result.glucose" }}

# GET

######
# NOW CHANGE TO MGDL
######

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}


NAME get_profile_switch_mmol
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mmol_profile_switch.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertContains "\"units\":\"mg/dL\"" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":108.108" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":144.144" "@result.profileJson"}}

NAME get_profile_switch_mgdl
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mgdl_profile_switch.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertContains "\"units\":\"mg/dL\"" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":70" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":100" "@result.profileJson"}}


