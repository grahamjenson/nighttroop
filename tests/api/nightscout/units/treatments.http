### Temp Targets and therapy events

# A temp target's targets are kept and given back in mg/dL, with units saying so, as a client reading one with no
# units on an mmol/L site would read 90 as mmol/L; one sent in mmol/L is converted

NAME create_mmol_temp_target
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 5 }},
    "eventType": "Temporary Target",
    "duration": 60,
    "reason": "Activity",
    "targetBottom": 6,
    "targetTop": 8,
    "units": "mmol",
    "created_at": "{{ time 5 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mg/dL" "@result.units"
ASSERT_EQUALS 108.108 "@result.targetBottom"
ASSERT_EQUALS 144.144 "@result.targetTop"

NAME create_mgdl_temp_target
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 6 }},
    "eventType": "Temporary Target",
    "duration": 60,
    "reason": "Automation",
    "targetBottom": 90,
    "targetTop": 90,
    "units": "mg/dl",
    "created_at": "{{ time 6 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mg/dl" "@result.units"
ASSERT_EQUALS 90 "@result.targetBottom"
ASSERT_EQUALS 90 "@result.targetTop"

NAME create_unlabeled_mmol_temp_target
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 7 }},
    "eventType": "Temporary Target",
    "duration": 60,
    "targetBottom": 6,
    "targetTop": 8,
    "created_at": "{{ time 7 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mg/dl" "@result.units"
ASSERT_EQUALS 108.108 "@result.targetBottom"
ASSERT_EQUALS 144.144 "@result.targetTop"

