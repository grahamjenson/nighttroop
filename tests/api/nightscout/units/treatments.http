NAME create_mgdl_note
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 9 }},
    "eventType": "Note",
    "notes": "A note",
    "units": "mg/dl",
    "created_at": "{{ time 9 }}"
 }
ASSERT_STATUS 201
ASSERT_EQUALS "mg/dl" "@result.units"

