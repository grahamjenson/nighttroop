INCLUDE steps/new_ns_site.steps

NAME check_default_is_mmol
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mmol/L" "@result.value"
ASSERT_EQUALS "string" "@result.type"


#########
# Treatments
#########

# The Nightscout API gives treatments' glucose and profile targets in mg/dL, whatever the identity's units



### Profile Switchs

NAME create_mmol_profile_switch
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 0 }},
    "eventType": "Profile Switch",
    "originalProfileName": "TestDash-2025",
    "percentage": 120,
    "profile": "TestDash-2025(120%)",
    "profileJson": "{\"units\":\"mmol\",\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":6}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":8}]}",
    "timeshift": 0,
    "utcOffset": 720,
    "created_at": "{{ time 0 }}"
 }
ASSERT_STATUS 201
ASSERT_CONTAINS "\"units\":\"mg/dL\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":108.108" "@result.profileJson"
ASSERT_CONTAINS "\"value\":144.144" "@result.profileJson"

NAME create_mgdl_profile_switch
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 1 }},
    "eventType": "Profile Switch",
    "originalProfileName": "TestDash-2025",
    "percentage": 120,
    "profile": "TestDash-2025(120%)",
    "profileJson": "{\"units\":\"mgdl\",\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":70}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":100}]}",
    "timeshift": 0,
    "utcOffset": 720,
    "created_at": "{{ time 1 }}"
 }
ASSERT_STATUS 201
ASSERT_CONTAINS "\"units\":\"mg/dL\"" "@result.profileJson"
ASSERT_CONTAINS "\"value\":70" "@result.profileJson"
ASSERT_CONTAINS "\"value\":100" "@result.profileJson"

