NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME check_default_is_mmol
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mmol/L" "@result.value" }}
ASSERT {{ assertEquals "string" "@result.type" }}


#########
# Treatments
#########



### Profile Switchs

NAME create_mmol_profile_switch
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 0 }},
    "eventType": "Profile Switch",
    "originalProfileName": "SamDash-2025",
    "percentage": 120,
    "profile": "SamDash-2025(120%)",
    "profileJson": "{\"units\":\"mmol\",\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":6}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":8}]}",
    "timeshift": 0,
    "utcOffset": 720,
    "created_at": "{{ time 0 }}"
 }
ASSERT_STATUS 201
ASSERT {{ assertContains "\"units\":\"mmol/L\"" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":6" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":8" "@result.profileJson"}}

NAME create_mgdl_profile_switch
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": {{ itime 1 }},
    "eventType": "Profile Switch",
    "originalProfileName": "SamDash-2025",
    "percentage": 120,
    "profile": "SamDash-2025(120%)",
    "profileJson": "{\"units\":\"mgdl\",\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":70}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":100}]}",
    "timeshift": 0,
    "utcOffset": 720,
    "created_at": "{{ time 1 }}"
 }
ASSERT_STATUS 201
ASSERT {{ assertContains "\"units\":\"mmol/L\"" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":3.885" "@result.profileJson"}}
ASSERT {{ assertContains "\"value\":5.55" "@result.profileJson"}}

