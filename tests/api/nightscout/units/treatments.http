# Glucose 

NAME get_glucose_reading_mmol
GET http://{{ site }}/api/v3/treatments/{{ dig "create_mmol_bg_check.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "mg/dL" "@result.units" }}
ASSERT {{ assertEquals 126.126 "@result.glucose" }}

