NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

# ensure settings is correct

NAME check_default_is_mmol
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mmol/L" "@result.value" }}
ASSERT {{ assertEquals "string" "@result.type" }}

#########
# Glucose Readings
#########

# Rules of Units
# Writing glucose readings will not be effected by the users settings
# Reading glucose readings will reflect the users settings


### WRITE

# We Create 4 different Entries
# Labeled and Unlabeled, MGDL and MMOL

NAME create_unlabeled_mmol_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 4.2, "type": "sgv", "date": {{ itime 0 }}}
ASSERT_STATUS 201
ASSERT {{ assertEquals 4.2 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}

NAME create_unlabeled_mgdl_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 108, "type": "sgv", "date": {{ itime 1 }}}
ASSERT_STATUS 201
ASSERT {{ assertEquals 5.994 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}

NAME create_mgdl_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 180, "type": "sgv", "units": "mg/dL", "date": {{ itime 2 }}}
ASSERT_STATUS 201
ASSERT {{ assertEquals 9.99 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}

NAME create_mmoll_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 15.1, "type": "sgv", "units": "mmol/L", "date": {{ itime 3 }}}
ASSERT_STATUS 201
ASSERT {{ assertEquals 15.1 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}


### READ

# We check that all the values are correct

# SET TO MG/DL
NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}


NAME get_unlabeled_mmol_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_unlabeled_mmol_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 75.676 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mg/dL" "@result.units" }}


NAME get_unlabeled_mgdl_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_unlabeled_mgdl_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 108 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mg/dL" "@result.units" }}

NAME get_labeled_mgdl_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_mgdl_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 180 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mg/dL" "@result.units" }}


NAME get_labeled_mmol_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_mmoll_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 272.072 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mg/dL" "@result.units" }}




# SET TO MMMOL/L

NAME update_unit_to_mmol
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mmol/L"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mmol/L" "@result.value" }}


NAME get_unlabeled_mmol_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_unlabeled_mmol_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 4.2 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}


NAME get_unlabeled_mgdl_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_unlabeled_mgdl_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 5.994 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}

NAME get_labeled_mgdl_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_mgdl_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 9.99 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}


NAME get_labeled_mmol_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_mmoll_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 15.1 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.units" }}