ASSERT_EQUALS 4.44 "@result.store.Default.target_high.0.value"

#####
# Now Fetch as MGDL
#####

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"


NAME get_labeled_mmol
GET http://{{ site }}/api/v3/profiles/{{ dig "create_profile_labeled_mmol.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.units"
ASSERT_EQUALS 72.072 "@result.store.Default.target_low.0.value"
ASSERT_EQUALS 90.09 "@result.store.Default.target_high.0.value"

NAME get_labeled_mg_dl
GET http://{{ site }}/api/v3/profiles/{{ dig "create_profile_labeled_mg_dl.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.units"
ASSERT_EQUALS 70 "@result.store.Default.target_low.0.value"
ASSERT_EQUALS 80 "@result.store.Default.target_high.0.value"


