INCLUDE steps/new_ns_site.steps


#########
# Settings
#########

NAME get_unit_settings
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mmol/L" "@result.value"

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"

NAME update_unit_to_mmol_wrong_spelling
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mmol"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mmol/L" "@result.value"

NAME update_unit_to_mgdl_wrong_spelling
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mgdl"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"


NAME update_unit_to_completely_wrong
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "tons"}
ASSERT_STATUS 400






