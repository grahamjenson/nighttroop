// Trio in mmol/L uploads its profile with units "mmol", and its targets and sensitivities in mmol/L (uploadProfiles
// in NightscoutManager.swift); its override presets' targets are as stored, in mg/dL. Nightscout's API gives glucose
// in mg/dL, so every glucose in the profile comes back converted and labelled mg/dL, in the echo, the profiles, the
// current profile and API v3, whatever the identity's units
INCLUDE steps/new_ns_site.steps

NAME trio_upload_profile_mmol
POST http://{{ site }}/api/v1/profile.json
H api-secret: {{ sha1 token }}
H Content-Type: application/json
B {
  "defaultProfile" : "default", "startDate" : "{{ date -1 }}T12:20:00.000Z", "mills" : {{ dayms -1 740 }}, "units" : "mmol", "enteredBy" : "Trio",
  "store" : { "default" : {
    "dia" : 6, "carbs_hr" : 21, "delay" : 0, "timezone" : "Pacific/Auckland",
    "target_low" : [ { "time" : "00:00", "value" : 5.5, "timeAsSeconds" : 0 } ],
    "target_high" : [ { "time" : "00:00", "value" : 5.6, "timeAsSeconds" : 0 } ],
    "sens" : [ { "time" : "00:00", "value" : 2.8, "timeAsSeconds" : 0 }, { "time" : "06:00", "value" : 2.2, "timeAsSeconds" : 21600 } ],
    "basal" : [ { "time" : "00:00", "value" : 0.8, "timeAsSeconds" : 0 }, { "time" : "06:00", "value" : 1.05, "timeAsSeconds" : 21600 } ],
    "carbratio" : [ { "time" : "00:00", "value" : 10, "timeAsSeconds" : 0 } ],
    "units" : "mmol"
  } },
  "bundleIdentifier" : "org.nightscout.ABC123.trio", "deviceToken" : "a1b2c3", "isAPNSProduction" : false,
  "overridePresets" : [ { "name" : "Sport", "duration" : 60, "percentage" : 80, "target" : 140 } ],
  "teamID" : "ABC123", "expirationDate" : "2027-01-01T00:00:00.000Z"
}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@0.units"
ASSERT_EQUALS "mg/dL" "@0.store.default.units"
ASSERT_EQUALS 99.099 "@0.store.default.target_low.0.value"
ASSERT_EQUALS 100.901 "@0.store.default.target_high.0.value"
ASSERT_EQUALS 50.45 "@0.store.default.sens.0.value"
ASSERT_EQUALS 39.64 "@0.store.default.sens.1.value"
ASSERT_EQUALS 0.8 "@0.store.default.basal.0.value"
ASSERT_EQUALS 1.05 "@0.store.default.basal.1.value"
ASSERT_EQUALS 10 "@0.store.default.carbratio.0.value"
ASSERT_EQUALS 140 "@0.overridePresets.0.target"

NAME trio_import_profile_mmol
GET http://{{ site }}/api/v1/profile.json?count=1
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS ".trio_upload_profile_mmol.0._id" "@0._id"
ASSERT_EQUALS "mg/dL" "@0.units"
ASSERT_EQUALS "mg/dL" "@0.store.default.units"
ASSERT_EQUALS 99.099 "@0.store.default.target_low.0.value"
ASSERT_EQUALS 100.901 "@0.store.default.target_high.0.value"
ASSERT_EQUALS 50.45 "@0.store.default.sens.0.value"
ASSERT_EQUALS 39.64 "@0.store.default.sens.1.value"
ASSERT_EQUALS 10 "@0.store.default.carbratio.0.value"
ASSERT_EQUALS 140 "@0.overridePresets.0.target"

NAME trio_current_profile_mmol
GET http://{{ site }}/api/v1/profile/current
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_EQUALS ".trio_upload_profile_mmol.0._id" "@_id"
ASSERT_EQUALS "mg/dL" "@units"
ASSERT_EQUALS "mg/dL" "@store.default.units"
ASSERT_EQUALS 99.099 "@store.default.target_low.0.value"
ASSERT_EQUALS 100.901 "@store.default.target_high.0.value"
ASSERT_EQUALS 50.45 "@store.default.sens.0.value"
ASSERT_EQUALS 39.64 "@store.default.sens.1.value"
ASSERT_EQUALS 140 "@overridePresets.0.target"

NAME trio_v3_profile_mmol
GET http://{{ site }}/api/v3/profile/{{ dig "trio_upload_profile_mmol.0._id" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@result.units"
ASSERT_EQUALS "mg/dL" "@result.store.default.units"
ASSERT_EQUALS 99.099 "@result.store.default.target_low.0.value"
ASSERT_EQUALS 100.901 "@result.store.default.target_high.0.value"
ASSERT_EQUALS 50.45 "@result.store.default.sens.0.value"
ASSERT_EQUALS 39.64 "@result.store.default.sens.1.value"

// A follower whose identity is in mg/dL reads the same mg/dL profile
INCLUDE steps/ns_units_mgdl.steps

NAME trio_current_profile_mmol_as_mgdl
GET http://{{ site }}/api/v1/profile/current
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_EQUALS "mg/dL" "@units"
ASSERT_EQUALS "mg/dL" "@store.default.units"
ASSERT_EQUALS 99.099 "@store.default.target_low.0.value"
ASSERT_EQUALS 50.45 "@store.default.sens.0.value"
ASSERT_EQUALS 39.64 "@store.default.sens.1.value"
