INCLUDE steps/new_ns_site.steps

// A temp basal sent only as a percent, as Nightscout reads one, is the profile's basal at its start changed by the
// percent: here 0.5 U/hr from midnight and 0.8 U/hr from 2am UTC

// Before any profile there is no basal to take the percent of, so it has no rate
NAME percent_before_profile_v1
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B {"eventType": "Temp Basal", "created_at": "2025-12-01T01:00:00.000Z", "percent": -50, "duration": 30}
ASSERT_STATUS 200
ASSERT_EQUALS 0 "@0.absolute"
ASSERT_EQUALS -50 "@0.percentage"

NAME create_percent_profile_v1
POST http://{{ site }}/api/v1/profiles?token={{ token }}
B {
    "units": "mg/dL",
    "startDate": "2026-01-01T00:00:00.000Z",
    "defaultProfile": "Default",
    "store": {
        "Default": {
            "dia": "5",
            "units": "mg/dL",
            "sens": [{"value": "110", "time": "00:00", "timeAsSeconds": "0"}],
            "target_low": [{"value": "100", "time": "00:00", "timeAsSeconds": "0"}],
            "target_high": [{"value": "100", "time": "00:00", "timeAsSeconds": "0"}],
            "carbratio": [{"value": "33", "time": "00:00", "timeAsSeconds": "0"}],
            "basal": [
                {"value": "0.5", "time": "00:00", "timeAsSeconds": "0"},
                {"value": "0.8", "time": "02:00", "timeAsSeconds": "7200"}
            ],
            "timezone": "UTC"
        }
    }
  }
ASSERT_STATUS 200

NAME percent_temp_basal_v1
POST http://{{ site }}/api/v1/treatments?token={{ token }}
B {"eventType": "Temp Basal", "created_at": "2026-03-01T01:00:00.000Z", "percent": -50, "duration": 30}
ASSERT_STATUS 200
ASSERT_EQUALS 0.25 "@0.absolute"
ASSERT_EQUALS 0.25 "@0.rate"
ASSERT_EQUALS -50 "@0.percentage"

NAME get_percent_temp_basal_v1
GET http://{{ site }}/api/v1/treatments/{{ dig "percent_temp_basal_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT_EQUALS 0.25 "@0.absolute"
ASSERT_EQUALS -50 "@0.percentage"

// From the schedule's 2am its next rate
NAME percent_temp_basal_v3
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {"eventType": "Temp Basal", "date": 1772332200000, "percent": 50, "duration": 30}
ASSERT_STATUS 201
ASSERT_EQUALS 1.2 "@result.absolute"

NAME get_percent_temp_basal_v3
GET http://{{ site }}/api/v3/treatments/{{ dig "percent_temp_basal_v3.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 1.2 "@result.absolute"
ASSERT_EQUALS 50 "@result.percentage"

// A rate sent with the percent is kept, rather than taken from the profile
NAME rate_and_percent_temp_basal_v3
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {"eventType": "Temp Basal", "date": 1772334000000, "percent": 50, "rate": 0.9, "duration": 30}
ASSERT_STATUS 201
ASSERT_EQUALS 0.9 "@result.absolute"
ASSERT_EQUALS 50 "@result.percentage"
