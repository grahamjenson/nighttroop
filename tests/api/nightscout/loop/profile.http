INCLUDE steps/new_ns_site.steps



NAME create_profile_v1
POST http://{{ site }}/api/v1/profiles?token={{ token }}
B {
    "_id": "5ca1ab1e0000000000000001",
    "defaultProfile": "loopProfile",
    "store": {
        "loopProfile": {
            "sens": [{"value": 50,"timeAsSeconds": 0,"time": "00:00"}],
            "basal": [{"value": 1,"timeAsSeconds": 0,"time": "00:00"},{"timeAsSeconds": 14400,"time": "04:00","value": 1},{"time": "06:00","timeAsSeconds": 21600,"value": 1},{"timeAsSeconds": 36000,"time": "10:00","value": 1}],
            "carbratio": [{"time": "00:00","value": 10,"timeAsSeconds": 0},{"value": 10,"time": "08:30","timeAsSeconds": 30600},{"timeAsSeconds": 41400,"time": "11:30","value": 10}],
            "carbs_hr": "0",
            "dia": 6,
            "target_high": [
                {
                    "timeAsSeconds": 0,
                    "time": "00:00",
                    "value": 120
                },
                {
                    "time": "08:00",
                    "timeAsSeconds": 28800,
                    "value": 120
                }
            ],
            "target_low": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 100
                },
                {
                    "time": "08:00",
                    "value": 100,
                    "timeAsSeconds": 28800
                }
            ],
            "units": "mg/dL",
            "delay": "0",
            "timezone": "ETC/GMT+0"
        }
    },
    "loopSettings": {
        "dosingEnabled": true,
        "dosingStrategy": "automaticBolus",
        "bundleIdentifier": "com.example.loopkit.Loop",
        "maximumBasalRatePerHour": 4,
        "maximumBolus": 10,
        "minimumBGGuard": 70,
        "deviceToken": "asd",
        "overridePresets": [
            {
                "symbol": "🏐",
                "name": "b",
                "insulinNeedsScaleFactor": 0.5,
                "targetRange": [
                    150,
                    180
                ],
                "duration": 0
            }
        ],
        "preMealTargetRange": [
            80,
            90
        ]
    },
    "startDate": "2025-01-01T00:00:00Z",
    "mills": "1735689600000",
    "enteredBy": "Loop",
    "units": "mg/dL"
 }
ASSERT_STATUS 200



NAME create_profile_v3
POST http://{{ site }}/api/v3/profiles
H Authorization: Bearer {{ jwt }}
B {
    "defaultProfile": "loopProfile",
    "store": {
        "loopProfile": {
            "sens": [ { "value": 50, "timeAsSeconds": 0, "time": "00:00" } ],
            "basal": [{"value": 1,"timeAsSeconds": 0,"time": "00:00"},{"timeAsSeconds": 14400,"time": "04:00","value": 1},{"time": "06:00","timeAsSeconds": 21600,"value": 1},{"timeAsSeconds": 36000,"time": "10:00","value": 1}],
            "carbratio": [{"time": "00:00","value": 10,"timeAsSeconds": 0},{"value": 10,"time": "08:30","timeAsSeconds": 30600},{"timeAsSeconds": 41400,"time": "11:30","value": 10}],
            "carbs_hr": "0",
            "dia": 6,
            "target_high": [{"timeAsSeconds": 0,"time": "00:00","value": 120},{"time": "08:00","timeAsSeconds": 28800,"value": 120}],
            "target_low": [{"time": "00:00","timeAsSeconds": 0,"value": 100},{"time": "08:00","value": 100,"timeAsSeconds": 28800}],
            "units": "mg/dL",
            "delay": "0",
            "timezone": "ETC/GMT+0"
        }
    },
    "loopSettings": {
        "dosingEnabled": true,
        "dosingStrategy": "automaticBolus",
        "bundleIdentifier": "com.example.loopkit.Loop",
        "maximumBasalRatePerHour": 4,
        "maximumBolus": 10,
        "minimumBGGuard": 70,
        "deviceToken": "asddsfdfgghfghfghaswqeadssawqqweasddsfdfgghfghfghaswqeadssawqqwe",
        "overridePresets": [
            {
                "symbol": "🏐",
                "name": "b",
                "insulinNeedsScaleFactor": 0.5,
                "targetRange": [
                    150,
                    180
                ],
                "duration": 0
            }
        ],
        "preMealTargetRange": [
            80,
            90
        ]
    },
    "startDate": "{{ time 0 }}",
    "units": "mg/dL"
 }
ASSERT_STATUS 201
ASSERT_EQUALS 6 "@result.store.loopProfile.dia"
ASSERT_EQUALS true "@result.loopSettings.dosingEnabled"
ASSERT_EQUALS "automaticBolus" "@result.loopSettings.dosingStrategy"
ASSERT_EQUALS "com.example.loopkit.Loop" "@result.loopSettings.bundleIdentifier"
ASSERT_EQUALS 4 "@result.loopSettings.maximumBasalRatePerHour"
ASSERT_EQUALS 10 "@result.loopSettings.maximumBolus"
ASSERT_EQUALS 70 "@result.loopSettings.minimumBGGuard"
ASSERT_EQUALS "asddsfdfgghfghfghaswqeadssawqqweasddsfdfgghfghfghaswqeadssawqqwe" "@result.loopSettings.deviceToken"
ASSERT_EQUALS "🏐" "@result.loopSettings.overridePresets.0.symbol"
ASSERT_EQUALS "b" "@result.loopSettings.overridePresets.0.name"
ASSERT_EQUALS 0.5 "@result.loopSettings.overridePresets.0.insulinNeedsScaleFactor"
ASSERT_EQUALS 150 "@result.loopSettings.overridePresets.0.targetRange.0"
ASSERT_EQUALS 180 "@result.loopSettings.overridePresets.0.targetRange.1"
ASSERT_EQUALS 0 "@result.loopSettings.overridePresets.0.duration"
ASSERT_EQUALS 80 "@result.loopSettings.preMealTargetRange.0"
ASSERT_EQUALS 90 "@result.loopSettings.preMealTargetRange.1"


######
# NightscoutService's uploadSettingsData posts an array of ProfileSet.dictionaryRepresentation to /api/v1/profile,
# with no _id, and needs a 200 and an array of as many objects as it sent. Its fetchStoredTherapySettings, when Loop
# is set up from Nightscout, gets /api/v1/profile/current, which must be one profile set, not an array of them.
# ProfileSet(rawValue:) needs _id, startDate as an ISO date, units, enteredBy, defaultProfile, store, and
# loopSettings with dosingEnabled and overridePresets. Each profile needs its timezone as Loop sent it (ETC/GMT-12),
# dia, and sens, carbratio, basal, target_low and target_high with timeAsSeconds and value.
######
INCLUDE steps/new_ns_site.steps
INCLUDE steps/ns_units_mgdl.steps

# A new site has no profile set, so its current one is null, as in Nightscout, not an empty list
NAME loop_fetch_current_profile_none
GET http://{{ site }}/api/v1/profile/current
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_EQUALS null "@"

NAME loop_upload_settings
POST http://{{ site }}/api/v1/profile
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [{"defaultProfile": "Default", "startDate": "{{ time 40 }}", "mills": "1793600000000", "units": "mg/dL", "enteredBy": "Loop", "isAPNSProduction": true,
    "loopSettings": {"dosingEnabled": true, "overridePresets": [{"duration": 3600, "symbol": "🏃", "targetRange": [140, 160], "insulinNeedsScaleFactor": 0.8, "name": "Running"}], "scheduleOverride": {"name": "Workout", "symbol": "🏃", "duration": 3600, "targetRange": [150, 180], "insulinNeedsScaleFactor": 0.5}, "minimumBGGuard": 75, "preMealTargetRange": [80, 85], "maximumBasalRatePerHour": 4, "maximumBolus": 10, "deviceToken": "abcd", "dosingStrategy": "automaticBolus", "bundleIdentifier": "com.X.loopkit.Loop"},
    "store": {"Default": {"dia": 6, "carbs_hr": "0", "delay": "0", "timezone": "ETC/GMT-12", "target_low": [{"time": "00:00", "value": 100, "timeAsSeconds": 0}], "target_high": [{"time": "00:00", "value": 110, "timeAsSeconds": 0}], "sens": [{"time": "00:00", "value": 40, "timeAsSeconds": 0}], "basal": [{"time": "00:00", "value": 0.8, "timeAsSeconds": 0}, {"time": "06:30", "value": 1.05, "timeAsSeconds": 23400}], "carbratio": [{"time": "00:00", "value": 10, "timeAsSeconds": 0}], "units": "mg/dL"}}}]
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EXISTS "@0._id"

NAME loop_fetch_current_profile
GET http://{{ site }}/api/v1/profile/current
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS ".loop_upload_settings.0._id" "@_id"
ASSERT_EQUALS ".loop_upload_settings.0.startDate" "@startDate"
ASSERT_EQUALS "mg/dL" "@units"
ASSERT_EQUALS "Default" "@defaultProfile"
ASSERT_EQUALS "Loop" "@enteredBy"
ASSERT_EQUALS true "@loopSettings.dosingEnabled"
ASSERT_EQUALS "Running" "@loopSettings.overridePresets.0.name"
ASSERT_EQUALS 3600 "@loopSettings.overridePresets.0.duration"
ASSERT_EQUALS 80 "@loopSettings.preMealTargetRange.0"
ASSERT_EQUALS "Workout" "@loopSettings.scheduleOverride.name"
ASSERT_EQUALS "🏃" "@loopSettings.scheduleOverride.symbol"
ASSERT_EQUALS 3600 "@loopSettings.scheduleOverride.duration"
ASSERT_EQUALS 150 "@loopSettings.scheduleOverride.targetRange.0"
ASSERT_EQUALS 180 "@loopSettings.scheduleOverride.targetRange.1"
ASSERT_EQUALS 0.5 "@loopSettings.scheduleOverride.insulinNeedsScaleFactor"
ASSERT_EQUALS "ETC/GMT-12" "@store.Default.timezone"
ASSERT_EQUALS 6 "@store.Default.dia"
ASSERT_EQUALS 23400 "@store.Default.basal.1.timeAsSeconds"
ASSERT_EQUALS 1.05 "@store.Default.basal.1.value"
ASSERT_EQUALS 40 "@store.Default.sens.0.value"
ASSERT_EQUALS 10 "@store.Default.carbratio.0.value"
ASSERT_EQUALS 100 "@store.Default.target_low.0.value"
ASSERT_EQUALS 110 "@store.Default.target_high.0.value"

# NightscoutKit's fetchProfiles (not used by Loop itself): find[startDate] between two ISO dates, and count
NAME nightscoutkit_fetch_profiles
GET http://{{ site }}/api/v1/profiles?find[startDate][$gte]={{ time 60 }}&find[startDate][$lte]={{ time 0 }}&count=10
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS ".loop_upload_settings.0._id" "@0._id"
ASSERT_EQUALS "Loop" "@0.enteredBy"


######
# Loop in mmol/L sends its profile and loopSettings in mmol/L. The API gives them back in mmol/L, as sent, as Nightscout
# does: Loop checks a remote command's hash of the profile's values against its own, and LoopFollow reads the units.
# Its sensitivities, targets, suspend threshold, pre-meal range and override presets' ranges are all as sent.
######

NAME loop_upload_settings_mmol
POST http://{{ site }}/api/v1/profile
H api-secret: {{ sha1 token }}
H Content-Type: application/json
B [{"defaultProfile": "Default", "startDate": "{{ time 30 }}", "units": "mmol/L", "enteredBy": "Loop",
    "loopSettings": {"dosingEnabled": true, "overridePresets": [{"duration": 3600, "symbol": "🏃", "targetRange": [7.8, 8.9], "insulinNeedsScaleFactor": 0.8, "name": "Running"}], "scheduleOverride": {"name": "Workout", "symbol": "🏃", "duration": 3600, "targetRange": [8.3, 10.0], "insulinNeedsScaleFactor": 0.5}, "minimumBGGuard": 4.4406, "preMealTargetRange": [4.44, 5.6], "maximumBasalRatePerHour": 4, "maximumBolus": 10, "dosingStrategy": "automaticBolus", "bundleIdentifier": "com.X.loopkit.Loop"},
    "store": {"Default": {"dia": 6, "timezone": "ETC/GMT-13", "target_low": [{"time": "00:00", "value": 5.6, "timeAsSeconds": 0}], "target_high": [{"time": "00:00", "value": 6.7, "timeAsSeconds": 0}], "sens": [{"time": "00:00", "value": 2.8, "timeAsSeconds": 0}], "basal": [{"time": "00:00", "value": 0.8, "timeAsSeconds": 0}], "carbratio": [{"time": "00:00", "value": 10, "timeAsSeconds": 0}], "units": "mmol/L"}}}]
ASSERT_STATUS 200

NAME loop_fetch_current_profile_mmol
GET http://{{ site }}/api/v1/profile/current
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_EQUALS ".loop_upload_settings_mmol.0._id" "@_id"
ASSERT_EQUALS "mmol/L" "@units"
ASSERT_EQUALS "mmol/L" "@store.Default.units"
ASSERT_EQUALS 2.8 "@store.Default.sens.0.value"
ASSERT_EQUALS 5.6 "@store.Default.target_low.0.value"
ASSERT_EQUALS 6.7 "@store.Default.target_high.0.value"
ASSERT_EQUALS 0.8 "@store.Default.basal.0.value"
ASSERT_EQUALS 10 "@store.Default.carbratio.0.value"
ASSERT_EQUALS 4.4406 "@loopSettings.minimumBGGuard"
ASSERT_EQUALS 4.44 "@loopSettings.preMealTargetRange.0"
ASSERT_EQUALS 5.6 "@loopSettings.preMealTargetRange.1"
ASSERT_EQUALS 7.8 "@loopSettings.overridePresets.0.targetRange.0"
ASSERT_EQUALS 8.9 "@loopSettings.overridePresets.0.targetRange.1"
ASSERT_EQUALS 0.8 "@loopSettings.overridePresets.0.insulinNeedsScaleFactor"
ASSERT_EQUALS 8.3 "@loopSettings.scheduleOverride.targetRange.0"
ASSERT_EQUALS 10 "@loopSettings.scheduleOverride.targetRange.1"
ASSERT_EQUALS 3600 "@loopSettings.scheduleOverride.duration"
ASSERT_EQUALS 4 "@loopSettings.maximumBasalRatePerHour"

# The profile list, as NightscoutKit's fetchProfiles and LoopFollow read it, has the same values
NAME loop_fetch_profiles_mmol
GET http://{{ site }}/api/v1/profile?count=1
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS ".loop_upload_settings_mmol.0._id" "@0._id"
ASSERT_EQUALS "mmol/L" "@0.units"
ASSERT_EQUALS "mmol/L" "@0.store.Default.units"
ASSERT_EQUALS 2.8 "@0.store.Default.sens.0.value"
ASSERT_EQUALS 5.6 "@0.store.Default.target_low.0.value"
ASSERT_EQUALS 6.7 "@0.store.Default.target_high.0.value"
ASSERT_EQUALS 4.4406 "@0.loopSettings.minimumBGGuard"
ASSERT_EQUALS 4.44 "@0.loopSettings.preMealTargetRange.0"
ASSERT_EQUALS 5.6 "@0.loopSettings.preMealTargetRange.1"
ASSERT_EQUALS 7.8 "@0.loopSettings.overridePresets.0.targetRange.0"
ASSERT_EQUALS 8.9 "@0.loopSettings.overridePresets.0.targetRange.1"
ASSERT_EQUALS 8.3 "@0.loopSettings.scheduleOverride.targetRange.0"
ASSERT_EQUALS 10 "@0.loopSettings.scheduleOverride.targetRange.1"

# A profile sent with no enteredBy or app says who uploaded it, the identity
NAME upload_profile_no_entered_by
POST http://{{ site }}/api/v1/profile
H api-secret: {{ sha1 token }}
B [{"defaultProfile": "Default", "startDate": "{{ time 20 }}", "units": "mg/dL", "store": {"Default": {"dia": 6, "units": "mg/dL"}}}]
ASSERT_STATUS 200
ASSERT_EQUALS "pwd_phone" "@0.enteredBy"

# One sent with no enteredBy but its app, as AAPS sends its profile store, is entered by its app, as a treatment is
NAME upload_profile_app_no_entered_by
POST http://{{ site }}/api/v1/profile
H api-secret: {{ sha1 token }}
B [{"defaultProfile": "Default", "startDate": "{{ time 18 }}", "units": "mg/dL", "app": "AAPS", "store": {"Default": {"dia": 6, "units": "mg/dL"}}}]
ASSERT_STATUS 200
ASSERT_EQUALS "AAPS" "@0.enteredBy"
