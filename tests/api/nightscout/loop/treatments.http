INCLUDE steps/new_ns_site.steps
INCLUDE steps/ns_units_mgdl.steps

# Loop posts treatments as an array to /api/v1/treatments (NightscoutClient.upload), and needs a 200 and an array of
# as many objects as it sent. It keeps each carb entry's returned _id (NightscoutService's ObjectIdCache), to PUT and
# DELETE it later. created_at and timestamp are the same ISO date without fractional seconds, and a nil field is left
# out.

######
# Carbs: create, then update and delete by the _id Nighttroop returned
######

NAME loop_create_carbs
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [{"created_at": "{{ time 70 }}", "timestamp": "{{ time 70 }}", "enteredBy": "loop://iPhone", "eventType": "Carb Correction", "carbs": 20, "absorptionTime": 180, "foodType": "🍕", "syncIdentifier": "6B9F1A1C-2D3E-4F50-8A1B-2C3D4E5F6071", "userEnteredAt": "{{ time 70 }}", "userLastModifiedAt": "{{ time 70 }}"}]
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EXISTS "@0._id"
ASSERT_EQUALS 20 "@0.carbs"
ASSERT_EQUALS 180 "@0.absorptionTime"
SET carbs_id {{ dig "loop_create_carbs.0._id" }}
# The update sends the carbs' own time back, as Loop does, not a time made again, which a second later would differ
SET carbs_at {{ dig "loop_create_carbs.0.created_at" }}

# NightscoutClient.modifyTreatments: PUT /api/v1/treatments with the _id in the body
NAME loop_update_carbs
PUT http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B {"_id": "{{ .carbs_id }}", "created_at": "{{ .carbs_at }}", "timestamp": "{{ .carbs_at }}", "enteredBy": "loop://iPhone", "eventType": "Carb Correction", "carbs": 25, "absorptionTime": 120, "foodType": "🍕", "syncIdentifier": "6B9F1A1C-2D3E-4F50-8A1B-2C3D4E5F6071", "userEnteredAt": "{{ .carbs_at }}", "userLastModifiedAt": "{{ time 65 }}"}
ASSERT_STATUS 200
ASSERT_EQUALS ".carbs_id" "@_id"
ASSERT_EQUALS 25 "@carbs"
ASSERT_EQUALS 120 "@absorptionTime"

######
# Doses (DoseEntry.treatment), pump events (Site Change, an alarm's Note), a CGM's Sensor Start, and the Note of a
# remote command that failed
######

NAME loop_create_doses_and_events
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [
    {"created_at": "{{ time 69 }}", "timestamp": "{{ time 69 }}", "enteredBy": "loop://iPhone", "eventType": "Correction Bolus", "type": "normal", "insulin": 1.5, "programmed": 1.5, "unabsorbed": 0, "duration": 0, "automatic": false, "syncIdentifier": "626f6c757320312e3520323032362d31312d30325430383a35313a30305a", "insulinType": "Humalog"},
    {"created_at": "{{ time 68 }}", "timestamp": "{{ time 68 }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 0.5, "absolute": 0.5, "duration": 30, "amount": 0.25, "automatic": true, "syncIdentifier": "74656d70426173616c20302e3520323032362d31312d30325430383a35323a30305a", "insulinType": "Humalog"},
    {"created_at": "{{ time 67 }}", "timestamp": "{{ time 67 }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 0, "absolute": 0, "duration": 4.5, "automatic": true, "syncIdentifier": "73757370656e6420302e3020323032362d31312d30325430383a35333a30305a", "reason": "suspend"},
    {"created_at": "{{ time 66 }}", "timestamp": "{{ time 66 }}", "enteredBy": "loop://iPhone", "eventType": "Site Change", "notes": "Pod Replaced"},
    {"created_at": "{{ time 66 }}", "timestamp": "{{ time 66 }}", "enteredBy": "loop://iPhone", "eventType": "Sensor Start", "notes": "SensorID: 8ABC12"},
    {"created_at": "{{ time 65 }}", "timestamp": "{{ time 65 }}", "enteredBy": "loop://iPhone", "eventType": "Note", "notes": "Occlusion detected"},
    {"created_at": "{{ time 64 }}", "timestamp": "{{ time 64 }}", "enteredBy": "Loop Remote Action Error", "eventType": "Note", "notes": "Bolus exceeds maximum\n{\"remote-bolus\":\"1.0\"}"}
  ]
ASSERT_STATUS 200
ASSERT_LENGTH 7 "@"
ASSERT_EQUALS "Correction Bolus" "@0.eventType"
ASSERT_EQUALS 1.5 "@0.insulin"
ASSERT_EQUALS "Temp Basal" "@1.eventType"
ASSERT_EQUALS 0.5 "@1.absolute"
ASSERT_EQUALS 30 "@1.duration"
ASSERT_EQUALS "suspend" "@2.reason"
ASSERT_EQUALS 0 "@2.absolute"
ASSERT_EQUALS "Site Change" "@3.eventType"
ASSERT_EQUALS "Sensor Start" "@4.eventType"
ASSERT_EQUALS "Occlusion detected" "@5.notes"

# A dose's syncIdentifier is its pump event's raw data in hex (LoopKit's NewPumpEvent). For Omnipod (OmniBLE and
# OmniKit) that is the hex of "<doseType> <units> <ISO date>", 60 to 70 characters, so two temp basals of the same rate
# share their first 36 characters, "tempBasal 0.5 202". They are different doses, and must not be kept as one.
NAME loop_create_same_rate_temp_basals
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [
    {"created_at": "{{ time 150 }}", "timestamp": "{{ time 150 }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 0.5, "absolute": 0.5, "duration": 5, "amount": 0.04, "automatic": true, "syncIdentifier": "74656d70426173616c20302e3520323032362d31312d30325430383a35373a30305a", "insulinType": "Humalog"},
    {"created_at": "{{ time 145 }}", "timestamp": "{{ time 145 }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 0.5, "absolute": 0.5, "duration": 30, "amount": 0.25, "automatic": true, "syncIdentifier": "74656d70426173616c20302e3520323032362d31312d30325430393a30323a30305a", "insulinType": "Humalog"}
  ]
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS 5 "@0.duration"
ASSERT_EQUALS 30 "@1.duration"

NAME same_rate_temp_basals_both_kept
GET http://{{ site }}/api/v1/treatments?find[eventType]=Temp+Basal&find[created_at][$gte]={{ time 160 }}&find[created_at][$lte]={{ time 140 }}&count=10
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS 30 "@0.duration"
ASSERT_EQUALS 5 "@1.duration"

# A dose still going, a bolus being delivered or a temp basal, is posted with what was planned, and posted again with
# the same date and syncIdentifier when it ends (InsulinDeliveryStore.addDoseEntries). As in Nightscout, the second
# replaces the first, so a dose ended early keeps what was delivered.
SET bolus_at {{ time 200 }}
SET temp_basal_at {{ time 199 }}

NAME loop_create_doses_going
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [
    {"created_at": "{{ .bolus_at }}", "timestamp": "{{ .bolus_at }}", "enteredBy": "loop://iPhone", "eventType": "Correction Bolus", "type": "normal", "insulin": 2, "programmed": 2, "unabsorbed": 0, "duration": 1, "automatic": false, "syncIdentifier": "626f6c757320322e3020323032362d31312d30325430353a30303a30305a", "insulinType": "Humalog"},
    {"created_at": "{{ .temp_basal_at }}", "timestamp": "{{ .temp_basal_at }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 1.2, "absolute": 1.2, "duration": 30, "amount": 0.6, "automatic": true, "syncIdentifier": "74656d70426173616c20312e3220323032362d31312d30325430353a30313a30305a", "insulinType": "Humalog"}
  ]
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS 2 "@0.insulin"
ASSERT_EQUALS 30 "@1.duration"
SET bolus_id {{ dig "loop_create_doses_going.0._id" }}
SET temp_basal_id {{ dig "loop_create_doses_going.1._id" }}

NAME loop_create_doses_ended
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [
    {"created_at": "{{ .bolus_at }}", "timestamp": "{{ .bolus_at }}", "enteredBy": "loop://iPhone", "eventType": "Correction Bolus", "type": "normal", "insulin": 0.8, "programmed": 2, "unabsorbed": 0, "duration": 0.4, "automatic": false, "syncIdentifier": "626f6c757320322e3020323032362d31312d30325430353a30303a30305a", "insulinType": "Humalog"},
    {"created_at": "{{ .temp_basal_at }}", "timestamp": "{{ .temp_basal_at }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 1.2, "absolute": 1.2, "duration": 10, "amount": 0.2, "automatic": true, "syncIdentifier": "74656d70426173616c20312e3220323032362d31312d30325430353a30313a30305a", "insulinType": "Humalog"}
  ]
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS ".bolus_id" "@0._id"
ASSERT_EQUALS 0.8 "@0.insulin"
ASSERT_EQUALS ".temp_basal_id" "@1._id"
ASSERT_EQUALS 10 "@1.duration"

NAME doses_ended_replaced_not_duplicated
GET http://{{ site }}/api/v1/treatments?find[created_at][$gte]={{ time 201 }}&find[created_at][$lte]={{ time 198 }}&count=10
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS ".temp_basal_id" "@0._id"
ASSERT_EQUALS 10 "@0.duration"
ASSERT_EQUALS 1.2 "@0.rate"
ASSERT_EQUALS ".bolus_id" "@1._id"
ASSERT_EQUALS 0.8 "@1.insulin"

NAME doses_ended_modified
GET http://{{ site }}/api/v3/treatments/{{ .temp_basal_id }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 10 "@result.duration"
SET doses_ended_since {{ addms (dig "doses_ended_modified.result.srvModified") 1 }}

# The ended doses sent again, as they were, change nothing
NAME loop_create_doses_ended_again
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [
    {"created_at": "{{ .bolus_at }}", "timestamp": "{{ .bolus_at }}", "enteredBy": "loop://iPhone", "eventType": "Correction Bolus", "type": "normal", "insulin": 0.8, "programmed": 2, "unabsorbed": 0, "duration": 0.4, "automatic": false, "syncIdentifier": "626f6c757320322e3020323032362d31312d30325430353a30303a30305a", "insulinType": "Humalog"},
    {"created_at": "{{ .temp_basal_at }}", "timestamp": "{{ .temp_basal_at }}", "enteredBy": "loop://iPhone", "eventType": "Temp Basal", "temp": "absolute", "rate": 1.2, "absolute": 1.2, "duration": 10, "amount": 0.2, "automatic": true, "syncIdentifier": "74656d70426173616c20312e3220323032362d31312d30325430353a30313a30305a", "insulinType": "Humalog"}
  ]
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS 10 "@1.duration"

NAME doses_ended_again_unchanged
GET http://{{ site }}/api/v3/treatments/history/{{ .doses_ended_since }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@result"

######
# Overrides (OverrideTreatment): Loop sets _id to the override's syncIdentifier, a UUID, and posts it again when it
# changes, such as ending early. It deletes an override by that UUID.
######

NAME loop_create_overrides
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [
    {"_id": "2C7A1F3B-9D8E-4A6B-B5C4-1E2F3A4B5C6D", "created_at": "{{ time 63 }}", "timestamp": "{{ time 63 }}", "enteredBy": "Loop", "eventType": "Temporary Override", "reason": "🏃 Running", "duration": 60, "insulinNeedsScaleFactor": 0.8, "correctionRange": [140, 160]},
    {"_id": "3D8B2F4C-0E9F-4B7C-86D5-2F3A4B5C6D7E", "created_at": "{{ time 62 }}", "timestamp": "{{ time 62 }}", "enteredBy": "Loop (via remote command)", "eventType": "Temporary Override", "reason": "Custom Override", "durationType": "indefinite", "remoteAddress": "caregiver", "insulinNeedsScaleFactor": 1.2, "correctionRange": [90, 100]}
  ]
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS "2C7A1F3B-9D8E-4A6B-B5C4-1E2F3A4B5C6D" "@0._id"
ASSERT_EQUALS "Temporary Override" "@0.eventType"
ASSERT_EQUALS "🏃 Running" "@0.reason"
ASSERT_EQUALS 60 "@0.duration"
ASSERT_EQUALS 0.8 "@0.insulinNeedsScaleFactor"
ASSERT_EQUALS 140 "@0.correctionRange.0"
ASSERT_EQUALS 160 "@0.correctionRange.1"
ASSERT_EQUALS "3D8B2F4C-0E9F-4B7C-86D5-2F3A4B5C6D7E" "@1._id"
# An indefinite override is kept as the longest a temp target can be, a week, and given back as indefinite
ASSERT_EQUALS 10080 "@1.duration"
ASSERT_EQUALS "indefinite" "@1.durationType"
ASSERT_EQUALS 1.2 "@1.insulinNeedsScaleFactor"

# Ended early, it is posted again with the same _id, and its fractional minutes
NAME loop_update_override
POST http://{{ site }}/api/v1/treatments
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
B [{"_id": "2C7A1F3B-9D8E-4A6B-B5C4-1E2F3A4B5C6D", "created_at": "{{ time 63 }}", "timestamp": "{{ time 63 }}", "enteredBy": "Loop", "eventType": "Temporary Override", "reason": "🏃 Running", "duration": 12.483333333333333, "insulinNeedsScaleFactor": 0.8, "correctionRange": [140, 160]}]
ASSERT_STATUS 200
ASSERT_LENGTH 1 "@"
ASSERT_EQUALS "2C7A1F3B-9D8E-4A6B-B5C4-1E2F3A4B5C6D" "@0._id"
ASSERT_EQUALS 12 "@0.duration"

NAME override_updated_not_duplicated
GET http://{{ site }}/api/v1/treatments?find[eventType]=Temporary+Override&count=10
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"
ASSERT_EQUALS 12 "@1.duration"

# NightscoutClient.deleteTreatmentsById: DELETE /api/v1/treatments/<uuid>, with no body
NAME loop_delete_override
DELETE http://{{ site }}/api/v1/treatments/3D8B2F4C-0E9F-4B7C-86D5-2F3A4B5C6D7E
H api-secret: {{ sha1 token }}
H Content-Type: application/json
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 1 "@deletedCount"

# NightscoutClient.deleteTreatmentsByObjectId: DELETE /api/v1/treatments/<the _id it was given>
NAME loop_delete_carbs
DELETE http://{{ site }}/api/v1/treatments/{{ .carbs_id }}
H api-secret: {{ sha1 token }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_EQUALS 1 "@deletedCount"

######
# NightscoutKit's fetchTreatments (not used by Loop itself): find[created_at] between two ISO dates, and count.
# created_at is when the treatment happened, not when it was uploaded.
######

NAME nightscoutkit_fetch_treatments
GET http://{{ site }}/api/v1/treatments?find[created_at][$gte]={{ time 120 }}&find[created_at][$lte]={{ time 30 }}&count=100
H api-secret: {{ sha1 token }}
H Accept: application/json
ASSERT_STATUS 200
ASSERT_LENGTH 8 "@"
ASSERT_EQUALS "Temporary Override" "@0.eventType"
ASSERT_EQUALS "2C7A1F3B-9D8E-4A6B-B5C4-1E2F3A4B5C6D" "@0._id"
ASSERT_EQUALS "Correction Bolus" "@7.eventType"
ASSERT_EXISTS "@7._id"
ASSERT_EXISTS "@7.created_at"
ASSERT_EXISTS "@7.enteredBy"
# NightscoutTreatment drops one without a timestamp, a bolus without its type, insulin, programmed and duration,
# and a temp basal without its rate, temp and duration
ASSERT_LENGTH 20 "@7.timestamp"
ASSERT_EQUALS "normal" "@7.type"
ASSERT_EQUALS 1.5 "@7.insulin"
ASSERT_EQUALS 1.5 "@7.programmed"
ASSERT_EQUALS 0 "@7.duration"
ASSERT_EQUALS "Temp Basal" "@6.eventType"
ASSERT_LENGTH 20 "@6.timestamp"
ASSERT_EQUALS 0.5 "@6.rate"
ASSERT_EQUALS "absolute" "@6.temp"
ASSERT_EQUALS 30 "@6.duration"

NAME nightscoutkit_fetch_treatments_count
GET http://{{ site }}/api/v1/treatments?find[created_at][$gte]={{ time 120 }}&find[created_at][$lte]={{ time 30 }}&count=2
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@"

NAME nightscoutkit_fetch_treatments_none_uploaded_now
GET http://{{ site }}/api/v1/treatments?find[created_at][$gte]={{ time 20 }}&count=100
H api-secret: {{ sha1 token }}
ASSERT_STATUS 200
ASSERT_LENGTH 0 "@"
