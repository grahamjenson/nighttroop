INCLUDE steps/new_ns_site.steps

NAME create_activity
POST http://{{ site }}/api/v3/activity
H Authorization: Bearer {{ jwt }}
B {"activityType": "exercise", "notes": "run"}
ASSERT_STATUS 201
SET activity_id {{ dig "create_activity.result.identifier" }}

// A value the database refuses is the client's error, for a patch as it is for a create or replace
NAME patch_activity_type_too_long
PATCH http://{{ site }}/api/v3/activity/{{ .activity_id }}
H Authorization: Bearer {{ jwt }}
B {"activityType": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
ASSERT_STATUS 400

NAME create_activity_type_too_long
POST http://{{ site }}/api/v3/activity
H Authorization: Bearer {{ jwt }}
B {"activityType": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "notes": "run"}
ASSERT_STATUS 400

// The failed patch changed nothing
NAME activity_unchanged
GET http://{{ site }}/api/v3/activity/{{ .activity_id }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "run" "@result.notes"
