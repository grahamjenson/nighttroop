NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200
SET token {{ .create_new_site.pwd_nstoken }}
SET site {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200
SET jwt {{ .jwtauth.token }}

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"

//////
// CREATE
//////


NAME create_entry_v3
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 101, "type": "sgv" }
ASSERT_STATUS 201
ASSERT_EQUALS 101 "@result.sgv"
ASSERT_EQUALS "sgv" "@result.type"
ASSERT_EXISTS "@result.identifier"
ASSERT_EXISTS "@result.date"
ASSERT_EXISTS "@result.subject"
ASSERT_EXISTS "@result.utcOffset"
ASSERT_EXISTS "@result.srvCreated"
ASSERT_EXISTS "@result.srvModified"


//////
// READ
//////

NAME get_entry_v3
GET http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 101 "@result.sgv"
ASSERT_EQUALS "sgv" "@result.type"

NAME search_gt_sgv_v3
GET http://{{ site }}/api/v3/entries?sgv[gt]=100
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 101 "@result.0.sgv"
ASSERT_EQUALS "sgv" "@result.0.type"

NAME get_404_entry_v3
GET http://{{ site }}/api/v3/entries/NonExistentID
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

//////
// UPDATE
//////

NAME put_entry_v3
PUT http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
H Authorization: Bearer {{ jwt }}
B { "sgv": 102, "type": "sgv" }
ASSERT_STATUS 200
ASSERT_EQUALS 102 "@result.sgv"
ASSERT_EQUALS "sgv" "@result.type"

NAME check_put_entry_v3
GET http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 102 "@result.sgv"
ASSERT_EQUALS "sgv" "@result.type"

NAME patch_entry_v3
PATCH http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
H Authorization: Bearer {{ jwt }}
B { "sgv": 103, "type": "sgv" }
ASSERT_STATUS 200

NAME check_patch_entry_v3
GET http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS 103 "@result.sgv"
ASSERT_EQUALS "sgv" "@result.type"

NAME update_entries_force_create_v3
PUT http://{{ site }}/api/v3/entries/AnotherFunID
H Authorization: Bearer {{ jwt }}
B { "sgv": 104, "type": "sgv" }
ASSERT_STATUS 201
ASSERT_EQUALS 104 "@result.sgv"
ASSERT_EQUALS "AnotherFunID" "@result.identifier"

NAME update_put_entries_v3
PUT http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
B {"sgv": 104, "app": "test-app", "date": {{ dig "put_entry_v3.result.date" }}}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

//////
// DELETE
//////

NAME delete_soft_entry_v3
DELETE http://{{ site }}/api/v3/entries/{{ dig "create_entry_v3.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
