INCLUDE steps/new_ns_site.steps

# Returns all the settings
NAME get_all_settings_v3
GET http://{{ site }}/api/v3/settings
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_settings_unit_v3
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mmol/L" "@result.value"
ASSERT_EQUALS "string" "@result.type"

# A body of JSON null is refused like any other bad body, by a replace and a patch
NAME put_null_setting_v3
PUT http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B null
ASSERT_STATUS 400

NAME patch_null_setting_v3
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B null
ASSERT_STATUS 400

# Returns all the 
NAME create_settings_v3
POST http://{{ site }}/api/v3/settings
H Authorization: Bearer {{ jwt }}
B {"identifier": "units", "type": "string", "value": "mg/dL" }
ASSERT_STATUS 201
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"
ASSERT_EQUALS "string" "@result.type"

NAME create_patch_settings_v3
PATCH http://{{ site }}/api/v3/settings/alarm_low_enabled
H Authorization: Bearer {{ jwt }}
B { "value": true }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "alarm_low_enabled" "@result.identifier"
ASSERT_EQUALS true "@result.value"
ASSERT_EQUALS "boolean" "@result.type"

# A setting Nighttroop does not have is not found (a create of one is refused), rather than answered as set with an
# empty document
NAME put_unknown_setting_v3
PUT http://{{ site }}/api/v3/settings/not_a_setting
H Authorization: Bearer {{ jwt }}
B { "type": "string", "value": "x" }
ASSERT_STATUS 404

NAME create_unknown_setting_v3
POST http://{{ site }}/api/v3/settings
H Authorization: Bearer {{ jwt }}
B { "identifier": "not_a_setting", "type": "string", "value": "x" }
ASSERT_STATUS 400

NAME delete_unknown_setting_v3
DELETE http://{{ site }}/api/v3/settings/not_a_setting
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

NAME get_unknown_setting_v3
GET http://{{ site }}/api/v3/settings/not_a_setting
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

#####
# READ
#####

NAME get_unit_settings_v3
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"

NAME get_timezone_settings_v3
GET http://{{ site }}/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "timezone" "@result.identifier"
ASSERT_EQUALS "string" "@result.type"
ASSERT_EQUALS "UTC" "@result.value"

NAME get_language_settings_v3
GET http://{{ site }}/api/v3/settings/language
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "language" "@result.identifier"
ASSERT_EQUALS "string" "@result.type"
ASSERT_EQUALS "en-NZ" "@result.value"

####
# UPDATE
####

#patch
NAME update_patch_settings_v3
PATCH http://{{ site }}/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
B {"value":  "Europe/London"}
ASSERT_STATUS 200
ASSERT_EQUALS "timezone" "@result.identifier"
ASSERT_EQUALS "Europe/London" "@result.value"

####
# Parsing different types
####

NAME put_with_parsing_types_alarm_low_enabled
PUT http://{{ site }}/api/v3/settings/alarm_low_enabled
H Authorization: Bearer {{ jwt }}
B { "value": "false" }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "alarm_low_enabled" "@result.identifier"
ASSERT_EQUALS false "@result.value"
ASSERT_EQUALS "boolean" "@result.type"

NAME put_with_parsing_types_units
PUT http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B { "value": "mgdl" }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_EQUALS "units" "@result.identifier"
ASSERT_EQUALS "mg/dL" "@result.value"

#####
# DELETE/CLEAN UP
#####

# DELETING A USER SETTING SHOULD REVERT TO THE DEFAULT VALUE WHEN GETTING
NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/alarm_low_enabled
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

