ASSERT_EQUALS "boolean" "@result.type"
ASSERT_EQUALS true "@result.value"

NAME put_alarm_device_battery_low_percent_settings_v3
PUT http://{{ site }}/api/v3/settings/alarm_device_battery_low_percent
H Authorization: Bearer {{ jwt }}
B { "value": 32 }
ASSERT_STATUS 200
ASSERT_EQUALS "alarm_device_battery_low_percent" "@result.identifier"
ASSERT_EQUALS "number" "@result.type"
ASSERT_EQUALS 32 "@result.value"

NAME put_alarm_device_battery_low_minutes_settings_v3
PUT http://{{ site }}/api/v3/settings/alarm_device_battery_low_minutes
H Authorization: Bearer {{ jwt }}
B { "value": 45 }
ASSERT_STATUS 200
ASSERT_EQUALS "alarm_device_battery_low_minutes" "@result.identifier"
ASSERT_EQUALS "number" "@result.type"
ASSERT_EQUALS 45 "@result.value"

NAME put_alarm_device_battery_low_devices_settings_v3
PUT http://{{ site }}/api/v3/settings/alarm_device_battery_low_devices
H Authorization: Bearer {{ jwt }}
B { "value": ["openaps://pixel", "SugarPixel"] }
ASSERT_STATUS 200
ASSERT_EQUALS "alarm_device_battery_low_devices" "@result.identifier"
ASSERT_EQUALS "array" "@result.type"
ASSERT_EQUALS "openaps://pixel" "@result.value.0"
ASSERT_EQUALS "SugarPixel" "@result.value.1"

// The devices are stored, so reading them again gives them back
NAME get_alarm_device_battery_low_devices_saved_settings_v3
GET http://{{ site }}/api/v3/settings/alarm_device_battery_low_devices
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT_LENGTH 2 "@result.value"
ASSERT_EQUALS "SugarPixel" "@result.value.1"

