NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}

//////
// CREATE
//////


NAME create_entry_v1
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 101, "type": "sgv" }
ASSERT_STATUS 201
ASSERT {{ assertEquals 101 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertExists "@result.identifier" }}
ASSERT {{ assertExists "@result.date" }}
ASSERT {{ assertExists "@result.subject" }}
ASSERT {{ assertExists "@result.utcOffset" }}
ASSERT {{ assertExists "@result.srvCreated" }}
ASSERT {{ assertExists "@result.srvModified" }}


//////
// READ
//////

NAME get_entry_v1
GET http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 101 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}

NAME search_gt_sgv_v1
GET http://{{ site }}/api/v3/entries?sgv[gt]=100
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 101 "@result.0.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.0.type" }}

NAME get_404_entry_v1
GET http://{{ site }}/api/v3/entries/NonExistentID
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 404

//////
// UPDATE
//////

NAME put_entry_v1
PUT http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
H Authorization: Bearer {{ jwt }}
B { "sgv": 102, "type": "sgv" }
ASSERT_STATUS 200
ASSERT {{ assertEquals 102 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}

NAME check_put_entry_v1
GET http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 102 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}

NAME patch_entry_v1
PATCH http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
H Authorization: Bearer {{ jwt }}
B { "sgv": 103, "type": "sgv" }
ASSERT_STATUS 200

NAME check_patch_entry_v1
GET http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 103 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}

NAME update_entries_force_create_v3
PUT http://{{ site }}/api/v3/entries/AnotherFunID
H Authorization: Bearer {{ jwt }}
B { "sgv": 104, "type": "sgv" }
ASSERT_STATUS 201
ASSERT {{ assertEquals 104 "@result.sgv" }}
ASSERT {{ assertEquals "AnotherFunID" "@result.identifier" }}

NAME update_put_entries_v3
PUT http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
B {"sgv": 104, "app": "test-app", "date": {{ dig "put_entry_v1.result.date" }}}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

//////
// DELETE
//////

NAME delete_soft_entry_v1
DELETE http://{{ site }}/api/v3/entries/{{ dig "create_entry_v1.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
