NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}

NAME jwtauth
GET http://{{ .site }}.ns.localhost/api/v2/authorization/request/token={{ .token }}
ASSERT_STATUS 200


# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}




# Returns all the settings
NAME get_all_settings_v3
GET http://{{ .site }}.ns.localhost/api/v3/settings
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_settings_unit_v3
GET http://{{ .site }}.ns.localhost/api/v3/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mmol/L" "@result.value" }}
ASSERT {{ assertEquals "string" "@result.type" }}

# Returns all the 
NAME create_settings_v3
POST http://{{ .site }}.ns.localhost/api/v3/settings
H Authorization: Bearer {{ jwt }}
B { "app": "asd", "identifier": "units", "type": "string", "value": "mmol/L" }
ASSERT_STATUS 200
ASSERT {{ assertEquals "mg/dL" "@result.value" }}
ASSERT {{ assertEquals "units" "@result.type" }}

NAME create_put_settings_v3
PUT http://{{ .site }}.ns.localhost/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"app": "asd", "value": "mg/dL"}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}
ASSERT {{ assertEquals "units" "@result.type" }}

NAME create_put_default_timezone_settings_v3
PUT http://{{ .site }}.ns.localhost/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
B {"app": "asd", "value": "America/New_York"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "default_timezone" "@result.identifier" }}
ASSERT {{ assertEquals "America/New_York" "@result.value" }}
ASSERT {{ assertEquals "timezone" "@result.type" }}

#####
# READ 
#####

NAME get_unit_settings_v3
GET http://{{ .site }}.ns.localhost/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}

NAME get_default_settings_v3
GET http://{{ .site }}.ns.localhost/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "timezone" "@result.identifier" }}
ASSERT {{ assertEquals "timezone" "@result.type" }}
ASSERT {{ assertEquals "America/New_York" "@result.value" }}

NAME get_default_settings_v3
GET http://{{ .site }}.ns.localhost/api/v3/settings/language
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "language" "@result.identifier" }}
ASSERT {{ assertEquals "language" "@result.type" }}
ASSERT {{ assertEquals "en" "@result.value" }}
####
# UPDATE
####

#patch
NAME update_patch_settings_v3
PATCH http://{{ .site }}.ns.localhost/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
B {"value":  "Europe/London"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "timezone" "@result.identifier" }}
ASSERT {{ assertEquals "Europe/London" "@result.value" }}


#####
# DELETE/CLEAN UP
#####

# DELETING A USER SETTING SHOULD REVERT TO THE DEFAULT VALUE WHEN GETTING
NAME delete_settings_v3
DELETE http://{{ .site }}.ns.localhost/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_unit_after_delete_ settings_v3
GET http://{{ .site }}.ns.localhost/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "default_units" "@result.identifier" }}
ASSERT {{ assertEquals "units" "@result.type" }}
ASSERT {{ assertEquals "mmol/L" "@result.value" }}