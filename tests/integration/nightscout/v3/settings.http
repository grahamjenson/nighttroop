NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}



# Returns all the settings
NAME get_all_settings_v3
GET http://{{ site }}/api/v3/settings
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_settings_unit_v3
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mmol/L" "@result.value" }}
ASSERT {{ assertEquals "string" "@result.type" }}

# Returns all the 
NAME create_settings_v3
POST http://{{ site }}/api/v3/settings
H Authorization: Bearer {{ jwt }}
B {"identifier": "units", "type": "string", "value": "mg/dL" }
ASSERT_STATUS 201
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}
ASSERT {{ assertEquals "string" "@result.type" }}

NAME create_put_settings_v3
PUT http://{{ site }}/api/v3/settings/bolus_onset_minutes
H Authorization: Bearer {{ jwt }}
B { "value": 30 }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "bolus_onset_minutes" "@result.identifier" }}
ASSERT {{ assertEquals 30 "@result.value" }}
ASSERT {{ assertEquals "number" "@result.type" }}

NAME create_patch_settings_v3
PATCH http://{{ site }}/api/v3/settings/alarm_low_enabled
H Authorization: Bearer {{ jwt }}
B { "value": true }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "alarm_low_enabled" "@result.identifier" }}
ASSERT {{ assertEquals true "@result.value" }}
ASSERT {{ assertEquals "boolean" "@result.type" }}


#####
# READ 
#####

NAME get_unit_settings_v3
GET http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}

NAME get_timezone_settings_v3
GET http://{{ site }}/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "timezone" "@result.identifier" }}
ASSERT {{ assertEquals "string" "@result.type" }}
ASSERT {{ assertEquals "UTC" "@result.value" }}

NAME get_language_settings_v3
GET http://{{ site }}/api/v3/settings/language
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "language" "@result.identifier" }}
ASSERT {{ assertEquals "string" "@result.type" }}
ASSERT {{ assertEquals "en-NZ" "@result.value" }}

####
# UPDATE
####

#patch
NAME update_patch_settings_v3
PATCH http://{{ site }}/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
B {"value":  "Europe/London"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "timezone" "@result.identifier" }}
ASSERT {{ assertEquals "Europe/London" "@result.value" }}

####
# Parsing different types
####


NAME put_with_parsing_types_alarm_low_enabled
PUT http://{{ site }}/api/v3/settings/alarm_low_enabled
H Authorization: Bearer {{ jwt }}
B { "value": "false" }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "alarm_low_enabled" "@result.identifier" }}
ASSERT {{ assertEquals false "@result.value" }}
ASSERT {{ assertEquals "boolean" "@result.type" }}

NAME put_with_parsing_types_units
PUT http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B { "value": "mgdl" }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}

NAME put_with_parsing_types_bolus_onset_minutes
PUT http://{{ site }}/api/v3/settings/bolus_onset_minutes
H Authorization: Bearer {{ jwt }}
B { "value": "15" }
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "bolus_onset_minutes" "@result.identifier" }}
ASSERT {{ assertEquals 15 "@result.value" }}

#####
# DELETE/CLEAN UP
#####

# DELETING A USER SETTING SHOULD REVERT TO THE DEFAULT VALUE WHEN GETTING
NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/timezone
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/bolus_onset_minutes
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME delete_settings_v3
DELETE http://{{ site }}/api/v3/settings/alarm_low_enabled
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200


