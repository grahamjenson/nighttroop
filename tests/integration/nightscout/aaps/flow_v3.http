NAME add_treatment_profile_switch
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": 1787480957000,
    "duration": 0,
    "eventType": "Profile Switch",
    "isReadOnly": false,
    "isValid": true,
    "originalDuration": 0,
    "originalProfileName": "FirstProfile",
    "percentage": 100,
    "profile": "FirstProfile",
    "profileJson": "{\"units\":\"mmol\",\"dia\":5,\"timezone\":\"Pacific\\/Kwajalein\",\"sens\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10},{\"time\":\"01:00\",\"timeAsSeconds\":3600,\"value\":10}],\"carbratio\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10},{\"time\":\"01:00\",\"timeAsSeconds\":3600,\"value\":10}],\"basal\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":0.6},{\"time\":\"01:00\",\"timeAsSeconds\":3600,\"value\":0.54}],\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":6}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10}]}",
    "timeshift": 0,
    "utcOffset": 720
 }
ASSERT_STATUS 201

NAME add_treatment_profile_switch_note
