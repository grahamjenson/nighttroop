NAME add_device_status
POST http://{{ site }}/api/v3/devicestatus
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "configuration": {
        "aps": "SMB",
        "apsConfiguration": {
            "use_dynamic_sensitivity": false,
            "DynISFAdjust": 100
        },
        "insulin": 2,
        "insulinConfiguration": {},
        "overviewConfiguration": {
            "units": "mmol",
            "eatingsoon_duration": 45,
            "eatingsoon_target": 90,
            "activity_duration": 90,
            "activity_target": 140,
            "hypo_duration": 60,
            "hypo_target": 160,
            "low_mark": 4,
            "high_mark": 10,
            "statuslights_cage_warning": 48,
            "statuslights_cage_critical": 72,
            "statuslights_iage_warning": 72,
            "statuslights_iage_critical": 144,
            "statuslights_sage_warning": 216,
            "statuslights_sage_critical": 240,
            "statuslights_sbat_warning": 25,
            "statuslights_sbat_critical": 5,
            "statuslights_bage_warning": 216,
            "statuslights_bage_critical": 240,
            "statuslights_res_warning": 80,
            "statuslights_res_critical": 10,
            "statuslights_bat_warning": 51,
            "statuslights_bat_critical": 26,
            "boluswizard_percentage": 100,
            "used_autosens_on_main_phone": false
        },
        "pump": "Generic AAPS",
        "safetyConfiguration": {
            "age": "teenage",
            "treatmentssafety_maxbolus": 3,
            "treatmentssafety_maxcarbs": 48
        },
        "sensitivity": 2,
        "sensitivityConfiguration": {
            "openaps_smb_min_5m_carbimpact": 8,
            "absorption_cutoff": 6,
            "autosens_min": 0.7,
            "autosens_max": 1.2
        },
        "smoothing": "NoSmoothingPlugin",
        "version": "3.3.1.0"
    },
    "date": 1787481213748,
    "device": "openaps://Google sdk_gphone64_arm64",
    "isCharging": false,
    "openaps": {},
    "pump": {
        "battery": {},
        "status": {}
    },
    "uploader": {},
    "uploaderBattery": 100
 }
ASSERT_STATUS 201


NAME add_profile
POST http://{{ site }}/api/v3/profile
H Authorization: Bearer {{ jwt }}
B {
    "defaultProfile": "FirstProfile",
    "date": 1787480950196,
    "created_at": "2026-08-23T10:29:10.1960000Z",
    "startDate": "2026-08-23T10:29:10.1960000Z",
    "store": {
        "FirstProfile": {
            "dia": 5,
            "carbratio": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 10
                },
                {
                    "time": "01:00",
                    "timeAsSeconds": 3600,
                    "value": 10
                }
            ],
            "sens": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 10
                },
                {
                    "time": "01:00",
                    "timeAsSeconds": 3600,
                    "value": 10
                }
            ],
            "basal": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 0.6
                },
                {
                    "time": "01:00",
                    "timeAsSeconds": 3600,
                    "value": 0.54
                }
            ],
            "target_low": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 6
                }
            ],
            "target_high": [
                {
                    "time": "00:00",
                    "timeAsSeconds": 0,
                    "value": 10
                }
            ],
            "units": "mmol",
            "timezone": "Pacific/Auckland"
        }
    },
    "app": "AAPS"
 }
ASSERT_STATUS 201

// This I think runs until there are no more treatments, as like a sync method
// This should actually work
NAME get_treatments_from_history_new
GET http://{{ site }}/api/v3/treatments/history/{{ itime 0 }}?limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertLength 0 "@result" }}


NAME get_treatments_from_history_old
GET http://{{ site }}/api/v3/treatments/history/{{ itime 30 }}?limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertLength 6 "@result" }}


/////
// SYNC
/////

NAME get_entries_since
GET http://{{ site }}/api/v3/entries?sort=date&date$gt=1778970005948&limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_treatments_since
GET http://{{ site }}/api/v3/treatments?sort=created_at&created_at$gt=2026-05-16T22:20:07.238Z&limit=500
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

NAME get_profile_since
GET http://{{ site }}/api/v3/profile?sort$desc=date&limit=1
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
