NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}

// We need to check that all return values satisfy the core/nssdk models

// First AAPS will call status to check if logged in and other stats

NAME get_status
GET http://{{ site }}/api/v3/status 
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// Then call lastModified to see if it needs to download any new data
NAME get_last_modified
GET http://{{ site }}/api/v3/lastModified
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertExists "@result.collections" }}
ASSERT {{ assertExists "@result.collections.entries" }}
ASSERT {{ assertExists "@result.collections.treatments" }}
ASSERT {{ assertExists "@result.collections.food" }}
ASSERT {{ assertExists "@result.collections.devicestatus" }}
ASSERT {{ assertExists "@result.collections.devicestatus" }}

// grabs the food
NAME get_food
GET http://{{ site }}/api/v3/food?limit=1000
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// Not sure what it is doing here, probably checking past devicestatuses
// TODO
NAME get_devicestatus_history
GET http://{{ site }}/api/v3/devicestatus/history/{{ itime 5 }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200

// Adds all the entries
NAME add_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "date": 1787481585647,
    "device": "Random",
    "direction": "FortyFiveUp",
    "filtered": 0.0,
    "isReadOnly": false,
    "isValid": true,
    "sgv": 196.41645726265494,
    "type": "sgv",
    "unfiltered": 0.0,
    "units": "mg/dl",
    "utcOffset": 720
 }
ASSERT_STATUS 201
ASSERT {{ assertEquals 196.41645726265494 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}
ASSERT {{ assertEquals 720 "@result.utcOffset" }}
ASSERT {{ assertExists "@result.identifier" }}
ASSERT {{ assertExists "@result.date" }}
ASSERT {{ assertEquals "AAPS" "@result.app" }}
ASSERT {{ assertEquals "Random" "@result.device" }}
ASSERT {{ assertEquals "FortyFiveUp" "@result.direction" }}
ASSERT {{ assertEquals 0.0 "@result.filtered" }}
ASSERT {{ assertEquals 0.0 "@result.unfiltered" }}
ASSERT {{ assertEquals true "@result.isValid" }}
ASSERT {{ assertEquals false "@result.isReadOnly" }}


NAME add_treatment_cc
POST http://{{ site }}/api/v3/treatments
H Authorization: Bearer {{ jwt }}
B {
    "app": "AAPS",
    "carbs": 5.0,
    "date": 1787483317000,
    "eventType": "Carb Correction",
    "isReadOnly": false,
    "isValid": true,
    "notes": "",
    "utcOffset": 720
 }
ASSERT_STATUS 201

