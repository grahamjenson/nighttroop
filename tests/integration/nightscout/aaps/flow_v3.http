    "originalTimeshift": 0,
    "profileJson": "{\"units\":\"mmol\",\"dia\":5,\"timezone\":\"Pacific\\/Kwajalein\",\"sens\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10}],\"carbratio\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10}],\"basal\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":0.6},{\"time\":\"01:00\",\"timeAsSeconds\":3600,\"value\":0.54}],\"target_low\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":6}],\"target_high\":[{\"time\":\"00:00\",\"timeAsSeconds\":0,\"value\":10}]}",
    "utcOffset": 720
 }
