NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}.ns.localhost

NAME jwtauth
GET http://{{ site }}/api/v2/authorization/request/token={{ token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}

#########
# Glucose Readings
#########


# Rules of Units
# Writing glucose readings will not be effected by the users settings
# Reading glucose readings will reflect the users settings


### WRITE

NAME create_unlabeled_mmol_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 4.2, "type": "sgv", "date": {{ itime 0 }}}
ASSERT_STATUS 201

NAME create_unlabeled_mgdl_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 108, "type": "sgv", "date": {{ itime 1 }}}
ASSERT_STATUS 201

NAME create_mgdl_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 180, "type": "sgv", "units": "mg/dL", "date": {{ itime 2 }}}
ASSERT_STATUS 201

NAME create_mmoll_entry
POST http://{{ site }}/api/v3/entries
H Authorization: Bearer {{ jwt }}
B { "sgv": 15.1, "type": "sgv", "units": "mmol/L", "date": {{ itime 3 }}}
ASSERT_STATUS 201


### READ

NAME update_unit_to_mgdl
PATCH http://{{ site }}/api/v3/settings/units
H Authorization: Bearer {{ jwt }}
B {"value":  "mg/dL"}
ASSERT_STATUS 200
ASSERT {{ assertEquals "units" "@result.identifier" }}
ASSERT {{ assertEquals "mg/dL" "@result.value" }}


NAME get_unlabeled_entry
GET http://{{ site }}/api/v3/entries/{{ dig "create_unlabeled_mgdl_entry.result.identifier" }}
H Authorization: Bearer {{ jwt }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 108 "@result.sgv" }}
ASSERT {{ assertEquals "sgv" "@result.type" }}



