######
# TEST SETUP
######

NAME create_treatmentses_v1
POST http://{{ .site }}.ns.localhost/api/v1/treatments?token={{ token }}
B [
  {
    "eventType": "Profile Switch",
    "created_at": "{{ time 9 }}",
    "notes": "Profile Switch 1"
  },
  {
    "eventType": "Profile Switch",
    "created_at": "{{ time 9 }}",
    "notes": "Profile Switch 2"
  },
  {
    "eventType": "Note",
    "created_at": "{{ time 12 }}",
    "notes": "Note 1"
  },
  {
    "eventType": "Note",
    "created_at": "{{ time 13 }}",
    "notes": "Note 2"
  }
 ]
ASSERT_STATUS 200