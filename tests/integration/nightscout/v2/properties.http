NAME get_properties_v2
GET http://{{ .site }}.ns.localhost/api/v2/properties?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 87 "@upbat.min.battery" }}
ASSERT {{ assertEquals 1.5 "@openaps.lastIOB.iob" }}
ASSERT {{ assertEquals 1.5 "@openaps.lastSuggested.IOB" }}
ASSERT {{ assertEquals 1.5 "@iob.iob" }}
ASSERT {{ assertEquals 1.2 "@iob.treatmentIob" }}
ASSERT {{ assertEquals 0.3 "@openaps.lastIOB.basaliob" }}
ASSERT {{ assertEquals 0.3 "@iob.basaliob" }}
ASSERT {{ assertEquals 12 "@openaps.lastSuggested.COB" }}
ASSERT {{ assertEquals 12 "@cob.cob" }}
ASSERT {{ assertEquals 1721123 "@cage.treatmentDate" }}
ASSERT {{ assertEquals 1720123 "@sage.Sensor Change.treatmentDate" }}