NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}

NAME jwtauth
GET http://{{ .site }}.ns.localhost/api/v2/authorization/request/token={{ .token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}

//////
// CREATE
//////


NAME create_devicestatus_v1
POST http://{{ .site }}.ns.localhost/api/v1/devicestatus?token={{ token }}
B {
    "app": "AAPS",
    "configuration": {},
    "isCharging": true,
    "openaps": {
      "iob": {
        "iob": 1.127,
        "basaliob": -0.444,
        "activity": 0.0109,
        "time": "2026-08-16T09:34:46.679Z"
      },
      "suggested": {
          "predBGs": {
              "IOB": [ 150, 144, 138, 132, 126, 120, 115, 109, 104, 99, 94, 89, 85, 80, 76, 71, 67, 62, 58, 53, 49, 44, 40, 39]
          },
          "COB": 12.03
      }
    },
    "pump": {
      "battery": {},
      "clock": "2026-08-16T09:35:04.092Z",
      "reservoir": 46,
      "status": {
        "status": "normal"
      }
    },
    "uploader": {},
    "uploaderBattery": 90,
    "utcOffset": 720,
    "created_at": "{{ time 0 }}"
  }
ASSERT_STATUS 200

NAME create_treatmentses_v1
POST http://{{ .site }}.ns.localhost/api/v1/treatments?token={{ token }}
B [
    {
        "eventType": "Insulin Change",
        "pumpSerial": "4241",
        "pumpType": "OMNIPOD_DASH",
        "created_at": "{{ time 1 }}",
        "notes": "Profile Switch 1"
    },
    {
        "eventType": "Sensor Change",
        "created_at": "{{ time 1 }}"
    }
 ]
ASSERT_STATUS 200


NAME get_properties_v2
GET http://{{ .site }}.ns.localhost/api/v2/properties?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 90 "@upbat.min.battery" }}
ASSERT {{ assertEquals 1.127 "@iob.iob" }}
ASSERT {{ assertEquals 1.571 "@iob.treatmentIob" }}
ASSERT {{ assertEquals -0.444 "@iob.basaliob" }}
ASSERT {{ assertEquals 12.03 "@cob.cob" }}






