NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}

NAME jwtauth
GET http://{{ .site }}.ns.localhost/api/v2/authorization/request/token={{ .token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}

//////
// CREATE
//////


NAME create_devicestatus_v1
POST http://{{ .site }}.ns.localhost/api/v1/devicestatus?token={{ token }}
B {
  "device": "aaps",
  "created_at": "{{ time 0 }}",

  "uploader": {
    "battery": 87,
    "batteryVoltage": 4.05
  },


  "pump": {
    "clock": "2026-06-16T08:42:15Z",
    "reservoir": 97.4,
    "battery": {
      "percent": 68,
      "voltage": 1.42
    },
    "status": {
      "bolusing": false,
      "suspended": false
    }
  },

  "openaps": {
    "enacted": {
      "timestamp": "2026-06-16T08:42:00Z",
      "rate": 1.2,
      "duration": 30
    },
    "suggested": {
      "timestamp": "2026-06-16T08:41:55Z",
      "rate": 1.2,
      "duration": 30,
      "reason": "Eventual BG 126"
    }
  }
 }
ASSERT_STATUS 201
ASSERT {{ assertEquals "iphone" "@result.device" }}
ASSERT {{ assertExists "@result.identifier" }}
ASSERT {{ assertExists "@result.date" }}
ASSERT {{ assertExists "@result.subject" }}
ASSERT {{ assertExists "@result.utcOffset" }}
ASSERT {{ assertExists "@result.srvCreated" }}
ASSERT {{ assertExists "@result.srvModified" }}


// {
