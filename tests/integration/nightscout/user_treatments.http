NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}

NAME jwtauth
GET http://{{ .site }}.ns.localhost/api/v2/authorization/request/token={{ .token }}
ASSERT_STATUS 200

# Auth with JWT
NAME jwt
SET {{ .jwtauth.token }}

NAME create_treatments_v1
POST http://{{ .site }}.ns.localhost/api/v1/treatments?token={{ token }}
B {
  "eventType": "Meal Bolus",
  "created_at": "{{ time 0 }}",

  "glucose": 148,
  "glucoseType": "Sensor",

  "carbs": 45,
  "insulin": 4.2,

  "duration": 0,

  "notes": "Lunch pasta + insulin pre-bolus",
  "enteredBy": "aaps-loop",

  "treatments": "treatments_1",
  "percentage": 10,
  "absolute": null,

  "reason": "lunch",
  "targetTop": 110,
  "targetBottom": 85
 }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}


NAME get_treatments_v1
GET http://{{ .site }}.ns.localhost/api/v1/treatments/{{ dig "create_treatments_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}