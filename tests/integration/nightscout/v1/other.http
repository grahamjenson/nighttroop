NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}

NAME status_v1
GET http://{{ .site }}.ns.localhost/api/v1/status?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "ok" "@status" }}