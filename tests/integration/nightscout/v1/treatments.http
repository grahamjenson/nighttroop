NAME create_full_pump_battery_change_v1
POST http://{{ .site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Pump Battery Change",
  "created_at": "{{ time 0 }}",
  "notes": "Pump Battery Change"
 }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Pump Battery Change" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals "Pump Battery Change" "@0.notes" }}

