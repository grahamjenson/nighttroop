    "enteredBy": "Loop",
    "notes": "Automatic correction"
  },

  {
    "eventType": "Meal Bolus",
    "created_at": "{{ time 33 }}",
    "carbs": 95,
    "insulin": 9.5,
    "enteredBy": "AndroidAPS",
    "notes": "Pizza"
  }
 ]
ASSERT_STATUS 200


/////
// GET
//////
NAME get_treatments_v1
GET http://{{ .site }}/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}
ASSERT {{ assertEquals 45 "@0.carbs" }}
ASSERT {{ assertEquals 4.2 "@0.insulin" }}
ASSERT {{ assertEquals "Here are some notes" "@0.notes" }}
ASSERT {{ assertEquals "lunch" "@0.reason" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME get_treatments_type_v1
GET http://{{ .site }}/api/v1/treatments/Meal%20Bolus?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}

NAME put_update_treatments_v1
PUT http://{{ .site }}/api/v1/treatments?token={{ token }}
B {
  "_id": "{{ dig "create_meal_bolus_v1.0._id" }}",
  "eventType": "Meal Bolus",
  "notes": "Updated from put_update_treatments_v1"
  }
ASSERT_STATUS 200

NAME get_treatments_after_updates_v1
GET http://{{ .site }}/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Updated from put_update_treatments_v1" "@0.notes" }}

NAME put_create_treatments_v1
PUT http://{{ .site }}/api/v1/treatments?token={{ token }}
B {
  "_id": "myveryownid",
  "eventType": "Meal Bolus",
  "notes": "Updated from put_create_treatments_v1"
  }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Updated from put_create_treatments_v1" "@notes" }}
ASSERT {{ assertEquals "myveryownid" "@_id" }}

NAME get_treatments_after_user_id_create_v1
GET http://{{ .site }}/api/v1/treatments/myveryownid?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Updated from put_create_treatments_v1" "@0.notes" }}


