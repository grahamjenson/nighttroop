NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}

NAME create_meal_bolus_v1
POST http://{{ .site }}.ns.localhost/api/v1/treatments?token={{ token }}
B {
  "eventType": "Meal Bolus",
  "created_at": "{{ time 0 }}",

  "glucose": 148,
  "glucoseType": "Sensor",

  "carbs": 45,
  "insulin": 4.2,

  "notes": "Here are some notes",
  "reason": "lunch"
 }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}
ASSERT {{ assertEquals 45 "@0.carbs" }}
ASSERT {{ assertEquals 4.2 "@0.insulin" }}
ASSERT {{ assertEquals "Here are some notes" "@0.notes" }}
ASSERT {{ assertEquals "lunch" "@0.reason" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME create_minimal_meal_bolus_v1
POST http://{{ .site }}.ns.localhost/api/v1/treatments?token={{ token }}
B { "eventType": "Meal Bolus", "insulin": 4.2 }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals 4.2 "@0.insulin" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME get_treatments_v1
GET http://{{ .site }}.ns.localhost/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}
ASSERT {{ assertEquals 45 "@0.carbs" }}
ASSERT {{ assertEquals 4.2 "@0.insulin" }}
ASSERT {{ assertEquals "Here are some notes" "@0.notes" }}
ASSERT {{ assertEquals "lunch" "@0.reason" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME get_treatments_type_v1
GET http://{{ .site }}.ns.localhost/api/v1/treatments/Meal%20Bolus?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "Sensor" "@0.glucoseType" }}

NAME update_treatments_v1
PUT http://{{ .site }}.ns.localhost/api/v1/treatments?token={{ token }}
B {
  "_id": "{{ dig "create_meal_bolus_v1.0._id" }}",
  "notes": "Updated notes"
  }
ASSERT_STATUS 200

NAME update_treatments_v1
PUT http://{{ .site }}.ns.localhost/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
B {
  "reason": "Updated reason"
  }
ASSERT_STATUS 200

NAME get_treatments_after_updates_v1
GET http://{{ .site }}.ns.localhost/api/v1/treatments/{{ dig "create_meal_bolus_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Updated notes" "@0.notes" }}
ASSERT {{ assertEquals "Updated reason" "@0.reason" }}
