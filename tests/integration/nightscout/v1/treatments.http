NAME create_new_site
POST http://localhost/site
ASSERT_STATUS 200

# Assign the token to a variable
NAME token
SET {{ .create_new_site.pwd_nstoken }}

NAME site
SET {{ .create_new_site.site_subdomain }}.ns.localhost

/////
// CREATE
//////
NAME create_meal_bolus_v1
POST http://{{ .site }}/api/v1/treatments?token={{ token }}
B {
  "eventType": "Meal Bolus",
  "created_at": "{{ time 0 }}",

  "glucose": 148,
  "glucoseType": "Sensor",

  "carbs": 45,
  "insulin": 4.2,

  "notes": "Here are some notes",
  "reason": "lunch"
 }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Meal Bolus" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals 148 "@0.glucose" }}
ASSERT {{ assertEquals "sgv" "@0.glucoseType" }}
ASSERT {{ assertEquals 45 "@0.carbs" }}
ASSERT {{ assertEquals 4.2 "@0.insulin" }}
ASSERT {{ assertEquals "Here are some notes" "@0.notes" }}
ASSERT {{ assertEquals "lunch" "@0.reason" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME create_minimal_correction_bolus_v1
POST http://{{ .site }}/api/v1/treatments?token={{ token }}
B { "eventType": "Correction Bolus", "insulin": 4.2 }
ASSERT_STATUS 200
ASSERT {{ assertEquals "Correction Bolus" "@0.eventType" }}
ASSERT {{ assertExists "@0.created_at" }}
ASSERT {{ assertEquals 4.2 "@0.insulin" }}
ASSERT {{ assertExists "@0._id" }}
ASSERT {{ assertExists "@0.utcOffset" }}

NAME create_treatmentses_v1
POST http://{{ .site }}/api/v1/treatments?token={{ token }}
B [
  {
    "eventType": "Announcement",
    "created_at": "{{ time 9 }}",
    "notes": "School swimming lesson today."
  },
  {
    "eventType": "BG Check",
    "created_at": "{{ time 11 }}",
    "glucose": 6.8,
    "glucoseType": "Finger"
  },
  {
    "eventType": "Bolus Wizard",
    "created_at": "{{ time 12 }}",
    "carbs": 48,
    "insulin": 4.2,
    "glucose": 9.1,
    "glucoseType": "Finger"
  },
  {
    "eventType": "Carb Correction",
    "created_at": "{{ time 13 }}",
    "carbs": 12,
    "notes": "Treated mild low"
  },
  {
    "eventType": "Combo Bolus",
    "created_at": "{{ time 14 }}",
    "carbs": 65,
    "insulin": 6.5,
    "splitNow": 50,
    "splitExt": 50,
    "duration": 120
  },
  {
    "eventType": "Correction Bolus",
    "created_at": "{{ time 15 }}",
    "insulin": 1.4,
    "glucose": 13.7
  },
  {
    "eventType": "D.A.D. Alert",
    "created_at": "{{ time 16 }}",
    "notes": "Missed meal bolus detected."
  },
  {
    "eventType": "Exercise",
