///////
// READ
///////

NAME get_profiles_type_v1
GET http://{{ site }}/api/v1/profiles/{{ dig "create_profile_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals "Default" "@0.defaultProfile" }}
ASSERT {{ assertEquals "mg/dL" "@0.units" }}
ASSERT {{ assertEquals "US/Eastern" "@0.store.Default.timezone" }}
ASSERT {{ assertEquals 0.35 "@0.store.Default.basal.0.value" }}
ASSERT {{ assertEquals "Pacific/Honolulu" "@0.store.Work.timezone" }}

/////
// UPDATE
/////


///////
// DELETE
///////

NAME delete_entries_v1
DELETE http://{{ site }}/api/v1/profiles/{{ dig "create_profile_v1.0._id" }}?token={{ token }}
ASSERT_STATUS 200
ASSERT {{ assertEquals 1 "@deletedCount" }}