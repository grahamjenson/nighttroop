{
  "openapi": "3.0.3",
  "info": {
    "title": "Nighttroop",
    "version": "0.1.0",
    "description": "Nighttroop's JSON API. POST /site is on the public host (https://<host>); /api/... is the Nightscout API, on a site's Nightscout host (https://<site>.ns.<host>); everything else is on a site's host (https://<site>.<host>) with a JWT from POST /login. Times are milliseconds since the epoch, and glucose is in the units of the signed in identity's settings; a Nightscout document says its units in its units field."
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/site": {
      "post": {
        "operationId": "CreateSite",
        "summary": "Creates a site, on the public host, and gives its credentials once",
        "security": [],
        "responses": {
          "200": { "description": "The new site", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedSite" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/login": {
      "post": {
        "operationId": "Login",
        "summary": "Signs an admin (with TOTP) or user in, for a JWT",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": {
          "200": { "description": "Signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginToken" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/summary": {
      "get": {
        "operationId": "GetSummary",
        "summary": "The site's summary over the last hours (48 by default, a week at most)",
        "parameters": [{ "name": "hours", "in": "query", "schema": { "type": "integer", "format": "int64" } }],
        "responses": {
          "200": { "description": "The summary, as a list of one", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SummaryList" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/data/glucose": {
      "get": {
        "operationId": "ListGlucoseReadings",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Skip" }],
        "responses": { "200": { "$ref": "#/components/responses/GlucoseReadingList" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "operationId": "CreateGlucoseReading",
        "requestBody": { "$ref": "#/components/requestBodies/GlucoseReadingBody" },
        "responses": { "201": { "$ref": "#/components/responses/GlucoseReadingResult" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/data/glucose/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "operationId": "GetGlucoseReading",
        "responses": { "200": { "$ref": "#/components/responses/GlucoseReadingResult" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "operationId": "UpdateGlucoseReading",
        "requestBody": { "$ref": "#/components/requestBodies/GlucoseReadingBody" },
        "responses": { "200": { "$ref": "#/components/responses/GlucoseReadingResult" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "DeleteGlucoseReading",
        "responses": { "200": { "$ref": "#/components/responses/Deleted" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/data/insulin": {
      "get": {
        "operationId": "ListInsulinDoses",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Skip" }],
        "responses": { "200": { "$ref": "#/components/responses/InsulinDoseList" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "operationId": "CreateInsulinDose",
        "requestBody": { "$ref": "#/components/requestBodies/InsulinDoseBody" },
        "responses": { "201": { "$ref": "#/components/responses/InsulinDoseResult" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/data/insulin/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "operationId": "GetInsulinDose",
        "responses": { "200": { "$ref": "#/components/responses/InsulinDoseResult" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "operationId": "UpdateInsulinDose",
        "requestBody": { "$ref": "#/components/requestBodies/InsulinDoseBody" },
        "responses": { "200": { "$ref": "#/components/responses/InsulinDoseResult" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "DeleteInsulinDose",
        "responses": { "200": { "$ref": "#/components/responses/Deleted" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/data/food": {
      "get": {
        "operationId": "ListFoodIntakes",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Skip" }],
        "responses": { "200": { "$ref": "#/components/responses/FoodIntakeList" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "operationId": "CreateFoodIntake",
        "requestBody": { "$ref": "#/components/requestBodies/FoodIntakeBody" },
        "responses": { "201": { "$ref": "#/components/responses/FoodIntakeResult" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/data/food/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "operationId": "GetFoodIntake",
        "responses": { "200": { "$ref": "#/components/responses/FoodIntakeResult" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "post": {
        "operationId": "UpdateFoodIntake",
        "requestBody": { "$ref": "#/components/requestBodies/FoodIntakeBody" },
        "responses": { "200": { "$ref": "#/components/responses/FoodIntakeResult" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "operationId": "DeleteFoodIntake",
        "responses": { "200": { "$ref": "#/components/responses/Deleted" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/v2/authorization/request/{token}": {
      "get": {
        "operationId": "NsV2Authorize",
        "summary": "Exchanges a device's Nightscout token for a JWT",
        "security": [],
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "A JWT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NsAuthorization" } } } }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v3/authorization/request/{token}": {
      "get": {
        "operationId": "NsV3Authorize",
        "summary": "Exchanges a device's Nightscout token for a JWT",
        "security": [],
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "A JWT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NsAuthorization" } } } }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v1/status": {
      "get": { "operationId": "NsV1Status", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsObject" } } }
    },
    "/api/v1/versions": {
      "get": { "operationId": "NsV1Versions", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsDocuments" } } }
    },
    "/api/v1/verifyauth": {
      "get": { "operationId": "NsV1VerifyAuth", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsObject" } } }
    },
    "/api/v1/experiments/test": {
      "get": { "operationId": "NsV1ExperimentsTest", "summary": "How Loop checks its API secret: 200 when it can upload treatments", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v1/{collection}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": {
        "operationId": "NsV1Search",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsCount" }, { "$ref": "#/components/parameters/Skip" }, { "$ref": "#/components/parameters/NsSort" }, { "$ref": "#/components/parameters/NsSortDesc" }, { "$ref": "#/components/parameters/NsFields" }, { "$ref": "#/components/parameters/NsDateGte" }, { "$ref": "#/components/parameters/NsDateLte" }],
        "responses": { "200": { "$ref": "#/components/responses/NsDocuments" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "post": {
        "operationId": "NsV1Create",
        "summary": "Creates one document or each in an array, and returns those created",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/NsDocuments" },
        "responses": { "200": { "$ref": "#/components/responses/NsDocuments" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "put": {
        "operationId": "NsV1ReplaceByBody",
        "summary": "Replaces the document with the _id in the body",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/NsDocument" },
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "delete": {
        "operationId": "NsV1DeleteByQuery",
        "summary": "Soft deletes the entries a search with the query finds, at most 1000, as xDrip4iOS deletes readings; only entries, and any other filter or one without a date is a 400",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsFindType" }, { "$ref": "#/components/parameters/NsFindDateGte" }, { "$ref": "#/components/parameters/NsFindDateLte" }, { "$ref": "#/components/parameters/NsFindDateIn" }],
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v1/{collection}/current": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": { "operationId": "NsV1Current", "summary": "The newest document, in a list of one; for profile, as in Nightscout, the profile set itself", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsDocuments" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v1/{collection}/{identifier}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }, { "$ref": "#/components/parameters/NsIdentifier" }],
      "get": {
        "operationId": "NsV1Get",
        "summary": "The document with the identifier, or the documents of a type, such as sgv",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsCount" }, { "$ref": "#/components/parameters/NsFields" }],
        "responses": { "200": { "$ref": "#/components/responses/NsDocuments" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "put": {
        "operationId": "NsV1Replace",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/NsDocument" },
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "delete": {
        "operationId": "NsV1Delete",
        "summary": "Deletes the document with the identifier, or the documents of a type",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsPermanent" }],
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v1/slice/{collection}/{field}/{type}/{prefix}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": {
        "operationId": "NsV1Slice",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "name": "field", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "type", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "prefix", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/NsCount" }],
        "responses": { "200": { "$ref": "#/components/responses/NsDocuments" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v1/count/{collection}/where": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": {
        "operationId": "NsV1Count",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsDateGte" }, { "$ref": "#/components/parameters/NsDateLte" }],
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v1/times/{prefix}": {
      "get": {
        "operationId": "NsV1Times",
        "summary": "The entries whose dateString starts with the prefix, such as 2026-10",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "name": "prefix", "in": "path", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/NsCount" }],
        "responses": { "200": { "$ref": "#/components/responses/NsDocuments" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v1/echo/{collection}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": { "operationId": "NsV1Echo", "summary": "How a search of the collection is understood, without running it", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsObject" } } }
    },
    "/api/v2/properties": {
      "get": { "operationId": "NsV2Properties", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v2/properties/{names}": {
      "get": {
        "operationId": "NsV2PropertiesNamed",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "name": "names", "in": "path", "required": true, "description": "Comma separated, such as bgnow,delta", "schema": { "type": "string" } }],
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v2/summary": {
      "get": { "operationId": "NsV2Summary", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v2/authorization/debug/check/{permission}": {
      "get": {
        "operationId": "NsV2CheckPermission",
        "summary": "Whether the token or JWT has a permission, such as api:settings:create: 200 when it has, 403 when not",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "name": "permission", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v3/version": {
      "get": { "operationId": "NsV3Version", "security": [], "responses": { "200": { "$ref": "#/components/responses/NsV3Result" } } }
    },
    "/api/v3/status": {
      "get": { "operationId": "NsV3Status", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsV3Result" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v3/test": {
      "get": { "operationId": "NsV3Test", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsV3Result" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v3/lastModified": {
      "get": { "operationId": "NsV3LastModified", "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }], "responses": { "200": { "$ref": "#/components/responses/NsV3Result" }, "default": { "$ref": "#/components/responses/NsError" } } }
    },
    "/api/v3/{collection}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": {
        "operationId": "NsV3Search",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Skip" }, { "$ref": "#/components/parameters/NsSort" }, { "$ref": "#/components/parameters/NsSortDesc" }, { "$ref": "#/components/parameters/NsFields" }, { "$ref": "#/components/parameters/NsDateGte" }, { "$ref": "#/components/parameters/NsDateLte" }],
        "responses": { "200": { "$ref": "#/components/responses/NsV3Documents" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "post": {
        "operationId": "NsV3Create",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/NsDocument" },
        "responses": { "200": { "$ref": "#/components/responses/NsV3Document" }, "201": { "$ref": "#/components/responses/NsV3Document" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v3/{collection}/history/{since}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }],
      "get": {
        "operationId": "NsV3History",
        "summary": "The documents changed since a time, the oldest change first, including deletions",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "name": "since", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "$ref": "#/components/responses/NsV3Documents" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    },
    "/api/v3/{collection}/{identifier}": {
      "parameters": [{ "$ref": "#/components/parameters/NsCollection" }, { "$ref": "#/components/parameters/NsIdentifier" }],
      "get": {
        "operationId": "NsV3Read",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsFields" }],
        "responses": { "200": { "$ref": "#/components/responses/NsV3Document" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "put": {
        "operationId": "NsV3Replace",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/NsDocument" },
        "responses": { "200": { "$ref": "#/components/responses/NsV3Document" }, "201": { "$ref": "#/components/responses/NsV3Document" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "patch": {
        "operationId": "NsV3Patch",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/NsDocument" },
        "responses": { "200": { "$ref": "#/components/responses/NsV3Document" }, "default": { "$ref": "#/components/responses/NsError" } }
      },
      "delete": {
        "operationId": "NsV3Delete",
        "security": [{ "bearerAuth": [] }, { "nsToken": [] }, { "nsApiSecret": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NsPermanent" }],
        "responses": { "200": { "$ref": "#/components/responses/NsObject" }, "default": { "$ref": "#/components/responses/NsError" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "nsToken": { "type": "apiKey", "in": "query", "name": "token", "description": "A device's Nightscout token" },
      "nsApiSecret": { "type": "apiKey", "in": "header", "name": "api-secret", "description": "The SHA-1 hex of a device's Nightscout token" }
    },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "description": "At most 1000", "schema": { "type": "integer", "format": "int64" } },
      "Skip": { "name": "skip", "in": "query", "schema": { "type": "integer", "format": "int64" } },
      "NsCollection": { "name": "collection", "in": "path", "required": true, "schema": { "type": "string", "enum": ["entries", "treatments", "devicestatus", "profile", "food", "settings", "activity"] } },
      "NsIdentifier": { "name": "identifier", "in": "path", "required": true, "schema": { "type": "string" } },
      "NsCount": { "name": "count", "in": "query", "description": "How many documents, at most 1000", "schema": { "type": "integer", "format": "int64" } },
      "NsSort": { "name": "sort", "in": "query", "description": "A field to sort by, ascending", "schema": { "type": "string" } },
      "NsSortDesc": { "name": "sort$desc", "in": "query", "description": "A field to sort by, descending", "schema": { "type": "string" } },
      "NsFields": { "name": "fields", "in": "query", "description": "Comma separated fields to return", "schema": { "type": "string" } },
      "NsDateGte": { "name": "date$gte", "in": "query", "description": "Documents from this time, in milliseconds", "schema": { "type": "integer", "format": "int64" } },
      "NsDateLte": { "name": "date$lte", "in": "query", "description": "Documents up to this time, in milliseconds", "schema": { "type": "integer", "format": "int64" } },
      "NsFindType": { "name": "find[type]", "in": "query", "description": "Documents of this type, such as sgv", "schema": { "type": "string" } },
      "NsFindDateGte": { "name": "find[date][$gte]", "in": "query", "description": "Documents from this time, in milliseconds", "schema": { "type": "integer", "format": "int64" } },
      "NsFindDateLte": { "name": "find[date][$lte]", "in": "query", "description": "Documents up to this time, in milliseconds", "schema": { "type": "integer", "format": "int64" } },
      "NsFindDateIn": { "name": "find[date][$in][]", "in": "query", "description": "Documents at exactly these times, in milliseconds", "schema": { "type": "array", "items": { "type": "integer", "format": "int64" } } },
      "NsPermanent": { "name": "permanent", "in": "query", "description": "Deletes the row instead of marking it deleted", "schema": { "type": "boolean" } }
    },
    "requestBodies": {
      "GlucoseReadingBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GlucoseReading" } } } },
      "InsulinDoseBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InsulinDose" } } } },
      "FoodIntakeBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FoodIntake" } } } },
      "NsDocument": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NsDocument" } } } },
      "NsDocuments": { "required": true, "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/NsDocument" } } } } }
    },
    "responses": {
      "Error": { "description": "An error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Deleted": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "description": "deleted" } } } } } },
      "GlucoseReadingResult": { "description": "A reading", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "$ref": "#/components/schemas/GlucoseReading" } } } } } },
      "GlucoseReadingList": { "description": "Readings, newest first", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "type": "array", "items": { "$ref": "#/components/schemas/GlucoseReading" } } } } } } },
      "InsulinDoseResult": { "description": "A dose", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "$ref": "#/components/schemas/InsulinDose" } } } } } },
      "InsulinDoseList": { "description": "Doses, newest first", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "type": "array", "items": { "$ref": "#/components/schemas/InsulinDose" } } } } } } },
      "FoodIntakeResult": { "description": "A food intake", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "$ref": "#/components/schemas/FoodIntake" } } } } } },
      "FoodIntakeList": { "description": "Food intakes, newest first", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "type": "array", "items": { "$ref": "#/components/schemas/FoodIntake" } } } } } } },
      "NsError": { "description": "A Nightscout error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NsObject": { "description": "A Nightscout response", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "NsDocuments": { "description": "Documents, newest first", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/NsDocument" } } } } },
      "NsV3Result": { "description": "An API v3 result", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": {} } } } } },
      "NsV3Document": { "description": "A document", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "identifier": { "type": "string" }, "lastModified": { "type": "integer", "format": "int64" }, "isDeduplication": { "type": "boolean" }, "result": { "$ref": "#/components/schemas/NsDocument" } } } } } },
      "NsV3Documents": { "description": "Documents", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "integer" }, "result": { "type": "array", "items": { "$ref": "#/components/schemas/NsDocument" } } } } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "status": { "type": "integer" }, "message": { "type": "string" } }
      },
      "CreatedSite": {
        "type": "object",
        "required": ["site_subdomain", "api_key", "totp_secret", "backup_key", "pwd_nstoken", "read_only_nstoken"],
        "properties": {
          "site_subdomain": { "type": "string" },
          "api_key": { "type": "string", "description": "The admin's password" },
          "totp_secret": { "type": "string", "description": "The admin's TOTP secret" },
          "backup_key": { "type": "string", "description": "Gets a new admin login on the recover page; it works once" },
          "pwd_nstoken": { "type": "string", "description": "The PWD phone's Nightscout token" },
          "read_only_nstoken": { "type": "string", "description": "The read only device's Nightscout token" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["name", "password"],
        "properties": {
          "name": { "type": "string" },
          "password": { "type": "string" },
          "totp": { "type": "string", "description": "A code from the authenticator app, for an admin" }
        }
      },
      "LoginToken": {
        "type": "object",
        "required": ["token", "expires_at"],
        "properties": {
          "token": { "type": "string", "description": "A JWT, sent as Authorization: Bearer <token>" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "Units": { "type": "string", "enum": ["mg/dL", "mmol/L"] },
      "Record": {
        "type": "object",
        "description": "What every record has. Read only fields are set by the server, which ignores them if sent.",
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "notes": { "type": "string" },
          "reason": { "type": "string" },
          "raw_json_data": { "type": "string", "readOnly": true },
          "utc_offset_minutes": { "type": "integer", "format": "int64" },
          "occurred_at": { "type": "integer", "format": "int64", "description": "Now, if not sent when creating" },
          "created_at": { "type": "integer", "format": "int64", "readOnly": true },
          "updated_at": { "type": "integer", "format": "int64", "readOnly": true },
          "created_by_app_name": { "type": "string", "readOnly": true },
          "created_by_device_name": { "type": "string", "readOnly": true },
          "created_by_identity_name": { "type": "string", "readOnly": true },
          "updated_by_identity_name": { "type": "string", "readOnly": true }
        }
      },
      "GlucoseReading": {
        "allOf": [
          { "$ref": "#/components/schemas/Record" },
          {
            "type": "object",
            "properties": {
              "reading": { "type": "number", "format": "double", "description": "In units" },
              "units": { "$ref": "#/components/schemas/Units" },
              "reading_type": { "type": "string", "description": "sgv from a sensor or mbg from a meter" },
              "original_units": { "$ref": "#/components/schemas/Units" },
              "measurement_method": { "type": "string" },
              "delta": { "type": "number", "format": "double" },
              "direction": { "type": "string" },
              "noise": { "type": "number", "format": "double" },
              "filtered": { "type": "number", "format": "double" },
              "unfiltered": { "type": "number", "format": "double" },
              "rssi": { "type": "number", "format": "double" }
            }
          }
        ]
      },
      "InsulinDose": {
        "allOf": [
          { "$ref": "#/components/schemas/Record" },
          {
            "type": "object",
            "properties": {
              "dose": { "type": "number", "format": "double", "description": "Units of insulin" },
              "dose_type": { "type": "string" },
              "split_now": { "type": "number", "format": "double" },
              "split_ext": { "type": "number", "format": "double" }
            }
          }
        ]
      },
      "FoodIntake": {
        "allOf": [
          { "$ref": "#/components/schemas/Record" },
          {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "food_type": { "type": "string" },
              "category": { "type": "string" },
              "subcategory": { "type": "string" },
              "absorption_time_minutes": { "type": "integer", "format": "int64" },
              "pre_bolus": { "type": "number", "format": "double" },
              "carbs": { "type": "number", "format": "double", "description": "Grams" },
              "fat": { "type": "number", "format": "double" },
              "protein": { "type": "number", "format": "double" },
              "fibre": { "type": "number", "format": "double" },
              "energy": { "type": "number", "format": "double" },
              "portions": { "type": "number", "format": "double" }
            }
          }
        ]
      },
      "CleanGlucoseReading": {
        "allOf": [
          { "$ref": "#/components/schemas/GlucoseReading" },
          {
            "type": "object",
            "properties": {
              "source": { "type": "string", "description": "direct, or the sync that wrote it: nightscout, dexcom, libre or virtual" },
              "diff_per_5m": { "type": "number", "format": "double" }
            }
          }
        ]
      },
      "Summary": {
        "type": "object",
        "description": "The parts of the summary described here; the rest is kept in AdditionalProperties",
        "additionalProperties": true,
        "properties": {
          "hours": { "type": "integer", "format": "int64" },
          "since": { "type": "integer", "format": "int64" },
          "units": { "$ref": "#/components/schemas/Units" },
          "range_low": { "type": "number", "format": "double" },
          "range_high": { "type": "number", "format": "double" },
          "glucose_readings": { "type": "array", "items": { "$ref": "#/components/schemas/CleanGlucoseReading" } },
          "insulin_doses": { "type": "array", "items": { "$ref": "#/components/schemas/InsulinDose" } },
          "food_intakes": { "type": "array", "items": { "$ref": "#/components/schemas/FoodIntake" } }
        }
      },
      "NsAuthorization": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "A JWT, sent as Authorization: Bearer <token>" },
          "sub": { "type": "string" },
          "permissionGroups": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "iat": { "type": "integer", "format": "int64" },
          "exp": { "type": "integer", "format": "int64" }
        }
      },
      "NsDocument": {
        "type": "object",
        "description": "A Nightscout document, such as an entry or treatment; the fields named here are common to most, the rest are kept in AdditionalProperties",
        "additionalProperties": true,
        "properties": {
          "_id": { "type": "string" },
          "identifier": { "type": "string" },
          "type": { "type": "string" },
          "eventType": { "type": "string" },
          "date": { "type": "integer", "format": "int64" },
          "dateString": { "type": "string" },
          "created_at": { "type": "string" },
          "sgv": { "type": "number", "format": "double", "description": "In units" },
          "mbg": { "type": "number", "format": "double", "description": "In units" },
          "units": { "type": "string", "description": "The units of sgv and mbg, the identity's; a treatment's glucose is in the units it was sent in, written as sent, else the identity's" },
          "direction": { "type": "string" },
          "insulin": { "type": "number", "format": "double" },
          "carbs": { "type": "number", "format": "double" },
          "notes": { "type": "string" },
          "enteredBy": { "type": "string" },
          "device": { "type": "string" },
          "utcOffset": { "type": "integer", "format": "int64" },
          "srvModified": { "type": "integer", "format": "int64" },
          "srvCreated": { "type": "integer", "format": "int64" },
          "isValid": { "type": "boolean" }
        }
      },
      "SummaryList": {
        "type": "object",
        "properties": { "status": { "type": "integer" }, "result": { "type": "array", "items": { "$ref": "#/components/schemas/Summary" } } }
      }
    }
  }
}
