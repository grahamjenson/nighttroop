package modal

import "nighttroop.t1d.nz/server/components/ui/button"

type Props struct {
	// ID is the modal's, and with "--close" its Close button's
	ID       string
	Title    string
	Subtitle string
	// Actions are shown before the Close button
	Actions templ.Component
}

// Modal shows its children over the page in #modal-container. Close, Escape or pressing beside it empties the container.
// Its body scrolls when it is taller than the window, keeping its actions and Close in view.
// It is a dialog named by its title, which takes the focus when it opens, so Tab goes through its form and a screen
// reader reads it, and gives the focus back to what opened it, such as a row, when it closes. That is found again by
// its ID when it was replaced, as an edited row is. Tab past its last control, Close, goes round to its first, and
// Shift+Tab before its first to Close, so the focus never goes to the page behind it.
// trapTab keeps Tab among the dialog's controls that can be seen, going round from its last to its first and back
const trapTab = `if (event.key !== 'Tab') return;
const controls = [...this.querySelectorAll('a[href], button, input, select, textarea, summary, [tabindex="0"]')]
	.filter(c => !c.disabled && c.type !== 'hidden' && c.getClientRects().length);
if (!controls.length) return;
const first = controls[0], last = controls[controls.length - 1];
if (event.shiftKey && (document.activeElement === first || document.activeElement === this)) { last.focus(); event.preventDefault(); }
else if (!event.shiftKey && document.activeElement === last) { first.focus(); event.preventDefault(); }`

templ Modal(p Props) {
	<div
		id={ p.ID }
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
		hx-get="/empty"
		hx-target="#modal-container"
		hx-swap="innerHTML"
		hx-trigger="mousedown from:self, keyup[key=='Escape'] from:body"
		hx-on::after:init="if (event.target === this) this.opener = document.activeElement"
		hx-on::before:cleanup="if (event.target === this && this.opener) (document.getElementById(this.opener.id) || this.opener).focus()"
	>
		<div
			role="dialog"
			aria-modal="true"
			aria-labelledby={ p.ID + "--title" }
			tabindex="-1"
			autofocus
			hx-on:keydown={ templ.JSUnsafeFuncCall(trapTab) }
			class="flex max-h-full w-full max-w-2xl flex-col rounded-lg bg-white shadow-lg outline-none"
		>
			<div class="overflow-y-auto px-6 pt-6">
				<h2 id={ p.ID + "--title" } class="text-lg font-semibold">{ p.Title }</h2>
				if p.Subtitle != "" {
					<p class="text-sm text-gray-500">{ p.Subtitle }</p>
				}
				{ children... }
			</div>
			<div class="flex justify-end gap-2 px-6 py-4">
				if p.Actions != nil {
					@p.Actions
				}
				@button.Button(button.Props{
					ID:      p.ID + "--close",
					Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"hx-get":    "/empty",
						"hx-target": "#modal-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					Close
				}
			</div>
		</div>
	</div>
}

// Detail is one label and value pair in a modal's details list
templ Detail(label string, value string) {
	<dt class="text-gray-500">{ label }</dt>
	<dd class="break-all">{ value }</dd>
}

// DetailIfSet is a Detail left out when it has no value, shown as "" or "-"
templ DetailIfSet(label string, value string) {
	if value != "" && value != "-" {
		@Detail(label, value)
	}
}

// Section heads the details after it in a modal's details list, such as the record's own
templ Section(title string) {
	<dt role="heading" aria-level="3" class="col-span-2 mt-3 border-t border-gray-100 pt-3 font-medium text-gray-900">{ title }</dt>
}

// Submit is a modal's action submitting its form, by the form's ID, as Save, beside Close at its foot where a modal's
// actions are looked for, rather than in the middle of its details
templ Submit(form, label string) {
	@button.Button(button.Props{ID: form + "--submit", Type: button.TypeSubmit, Form: form}) {
		{ label }
	}
}
