package testsite

import (
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// Banner is across the top of every page of a staging server, a test site, so nobody takes it for a real one or keeps
// anything they need on it
templ Banner() {
	if httputils.TestSite(ctx) {
		<div id="test-site-banner" role="alert" class="border-b-4 border-amber-500 bg-amber-100 px-4 py-6 text-center text-amber-800">
			<p class="text-3xl font-extrabold uppercase tracking-wide">{ i18n.T(ctx, "common.test_site.title") }</p>
			<p class="mx-auto mt-2 max-w-3xl text-lg font-medium">
				{ i18n.T(ctx, "common.test_site.warning") }
			</p>
		</div>
	}
}
