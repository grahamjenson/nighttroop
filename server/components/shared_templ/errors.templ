package shared_templ

templ Fail() {
	@Base("Error") {
		<div class="max-w-md mx-auto mt-20 p-6 bg-white rounded shadow">
			<h1 class="text-2xl font-bold mb-4">An error occurred</h1>
			<p class="text-gray-700">Sorry, something went wrong. Please try again later.</p>
		</div>
	}
}

templ Success() {
	@Base("Success") {
		<div class="max-w-md mx-auto mt-20 p-6 bg-green-100 rounded shadow">
			<h1 class="text-2xl font-bold mb-4">Success!</h1>
			<p class="text-green-700">Your request was successful.</p>
		</div>
	}
}
