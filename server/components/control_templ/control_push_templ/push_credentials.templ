package control_push_templ

import (
	"context"
	"strconv"
	"strings"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/site_templ/site_settings_templ"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// PushCredentials is every site's push credentials, and those for every site, newest first, never with their secrets,
// with, for an admin, a button to add one to a site and each one's to delete it
templ PushCredentials(credentials []*controlmodels.PushCredential) {
	<div id="control--push-credentials" class="mx-auto max-w-6xl space-y-6">
		@heading.PageWith(i18n.T(ctx, "control.push_credentials.title"), addButton(ctx)) {
			{ i18n.T(ctx, "control.push_credentials.intro") }
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{ID: "control--push-credentials--table", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						for _, head := range []string{"control.push_credentials.site", "control.push_credentials.name", "control.push_credentials.service",
							"control.push_credentials.team_or_project", "control.push_credentials.apps", "control.push_credentials.bundle_ids",
							"control.push_credentials.added_by"} {
							@table.Head() {
								{ i18n.T(ctx, head) }
							}
						}
						@table.Head() {
							<span class="sr-only">{ i18n.T(ctx, "control.push_credentials.actions") }</span>
						}
					}
				}
				@table.Body() {
					for _, credential := range credentials {
						@PushCredentialRow(credential)
					}
					@pager.Empty("control--push-credential--empty", 8, i18n.T(ctx, "control.push_credentials.empty"))
				}
			}
		</section>
		<div id="modal-container"></div>
	</div>
}

// addButton is, for an admin, the button to add a credential to a site, as a read only identity cannot
func addButton(ctx context.Context) templ.Component {
	if !httputils.IsControlAdmin(ctx) {
		return templ.NopComponent
	}
	return addmodal.Open("control--push-credential--add", "/push-credentials/new", i18n.T(ctx, "control.push_credentials.add"))
}

// PushCredentialRow is a credential, without its secret, whose site it is, and for an admin a button to delete it
templ PushCredentialRow(credential *controlmodels.PushCredential) {
	{{ id := "control--push-credential--" + strconv.FormatInt(credential.ID, 10) }}
	@table.Row(table.RowProps{ID: id}) {
		@table.Cell() {
			if credential.SiteID == nil {
				{ i18n.T(ctx, "control.push_credentials.every_site") }
			} else {
				{ *credential.SiteID }
			}
		}
		@table.Cell() {
			{ credential.Name }
		}
		@table.Cell() {
			{ site_settings_templ.PushProviders[string(credential.Provider)] }
		}
		@table.Cell() {
			{ credential.TeamOrProjectID }
			if credential.KeyID != nil {
				<span class="block text-xs text-gray-500">{ i18n.T(ctx, "control.push_credentials.key", i18n.Data{"KeyID": *credential.KeyID}) }</span>
			}
		}
		@table.Cell() {
			{ strings.Join(credential.Apps, ", ") }
		}
		@table.Cell() {
			if len(credential.BundleIDs) == 0 {
				{ i18n.T(ctx, "control.push_credentials.any_bundle") }
			} else {
				{ strings.Join(credential.BundleIDs, ", ") }
			}
		}
		@table.Cell() {
			{ credential.CreatedByIdentityName }
		}
		if httputils.IsControlAdmin(ctx) {
			@table.DeleteCell(id+"--delete", "/push-credentials/"+strconv.FormatInt(credential.ID, 10), i18n.T(ctx, "control.push_credentials.delete_confirm"))
		} else {
			@table.Cell()
		}
	}
}

// pushCredentialForm adds a credential to a site: the site's own form, with the site it is for first
func pushCredentialForm(ctx context.Context) addmodal.Props {
	form := site_settings_templ.PushCredentialFormIn(ctx)
	form.ID, form.Path, form.Target = "control--push-credential--create", "/push-credentials", "#control--push-credentials--table tbody"
	form.Fields = append([]addmodal.Field{{Name: "site_id", Label: i18n.T(ctx, "control.push_credentials.site"), Required: true, Kind: addmodal.Text, Max: "32",
		Help: i18n.T(ctx, "control.push_credentials.site_help")}}, form.Fields...)
	form.Extra = site_settings_templ.PushCredentialExtra(form.ID)
	return form
}

// PushCredentialNew is the modal to add a credential to a site in, putting its row at the top of the table
templ PushCredentialNew() {
	@addmodal.Modal(pushCredentialForm(ctx))
}

templ PushCredentialDeleted() {
	@successtoast.Toast(i18n.T(ctx, "control.push_credentials.deleted"))
}
