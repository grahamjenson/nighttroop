package control_push_templ

import (
	"strconv"
	"strings"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/site_templ/site_settings_templ"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// PushCredentials is every site's push credentials, and those for every site, newest first, never with their secrets,
// with a button to add one to a site and each one's to delete it
templ PushCredentials(credentials []*controlmodels.PushCredential) {
	<div id="control--push-credentials" class="mx-auto max-w-6xl space-y-6">
		@heading.PageWith("Push Credentials", addmodal.Open("control--push-credential--add", "/push-credentials/new", "Add Push Credential")) {
			The keys pushes are sent to apps with: each site's own, and those for every site, newest first. A key is never
			shown again once added.
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{ID: "control--push-credentials--table", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						for _, head := range []string{"Site", "Name", "Service", "Team or Project", "Apps", "Bundle IDs", "Added By"} {
							@table.Head() {
								{ head }
							}
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, credential := range credentials {
						@PushCredentialRow(credential)
					}
					@pager.Empty("control--push-credential--empty", 8, "No push credentials yet.")
				}
			}
		</section>
		<div id="modal-container"></div>
	</div>
}

// PushCredentialRow is a credential, without its secret, whose site it is, and a button to delete it
templ PushCredentialRow(credential *controlmodels.PushCredential) {
	{{ id := "control--push-credential--" + strconv.FormatInt(credential.ID, 10) }}
	@table.Row(table.RowProps{ID: id}) {
		@table.Cell() {
			if credential.SiteID == nil {
				Every site
			} else {
				{ *credential.SiteID }
			}
		}
		@table.Cell() {
			{ credential.Name }
		}
		@table.Cell() {
			{ site_settings_templ.PushProviders[string(credential.Provider)] }
		}
		@table.Cell() {
			{ credential.TeamOrProjectID }
			if credential.KeyID != nil {
				<span class="block text-xs text-gray-500">Key { *credential.KeyID }</span>
			}
		}
		@table.Cell() {
			{ strings.Join(credential.Apps, ", ") }
		}
		@table.Cell() {
			if len(credential.BundleIDs) == 0 {
				Any
			} else {
				{ strings.Join(credential.BundleIDs, ", ") }
			}
		}
		@table.Cell() {
			{ credential.CreatedByIdentityName }
		}
		@table.DeleteCell(id+"--delete", "/push-credentials/"+strconv.FormatInt(credential.ID, 10), "Delete this push credential? Pushes sent with it will stop.")
	}
}

// pushCredentialForm adds a credential to a site: the site's own form, with the site it is for first
func pushCredentialForm() addmodal.Props {
	form := site_settings_templ.PushCredentialForm
	form.ID, form.Path, form.Target = "control--push-credential--create", "/push-credentials", "#control--push-credentials--table tbody"
	form.Fields = append([]addmodal.Field{{Name: "site_id", Label: "Site", Required: true, Kind: addmodal.Text, Max: "32",
		Help: "The site's ID. One for every site cannot be added yet."}}, form.Fields...)
	form.Extra = site_settings_templ.PushCredentialExtra(form.ID)
	return form
}

// PushCredentialNew is the modal to add a credential to a site in, putting its row at the top of the table
templ PushCredentialNew() {
	@addmodal.Modal(pushCredentialForm())
}

templ PushCredentialDeleted() {
	@successtoast.Toast("Push Credential Deleted")
}
