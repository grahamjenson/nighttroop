package control_site_emails_templ

import (
	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// emailLabels are the ids of each pre-built email's name
var emailLabels = map[string]string{
	"archive": "control.site_emails.archive.label", "storage": "control.site_emails.storage.label", "contact": "control.site_emails.contact.label",
}

// SiteEmails is the sites with a verified email. An admin picks one of the pre-built emails and sends it to a site.
// A server that sends no email says so, and has no Send.
templ SiteEmails(sites []*controlmodels.VerifiedSite, working bool) {
	<div id="control--site-emails" class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "control.site_emails.title")) {
			{ i18n.T(ctx, "control.site_emails.intro") }
		}
		if !working {
			<p id="control--site-emails--off" class="rounded-md border border-amber-500/20 bg-amber-500/10 px-4 py-3 text-sm text-amber-800">
				{ i18n.T(ctx, "control.site_emails.off") }
			</p>
		}
		if len(sites) == 0 {
			<p id="control--site-emails--none" class="text-sm text-muted-foreground">{ i18n.T(ctx, "control.site_emails.none") }</p>
		} else {
			@table.Table(table.Props{ID: "control--site-emails--table"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, "control.site_emails.site") }
						}
						@table.Head() {
							{ i18n.T(ctx, "control.site_emails.verified") }
						}
						@table.Head() {
							{ i18n.T(ctx, "control.site_emails.email") }
						}
					}
				}
				@table.Body() {
					for _, site := range sites {
						@table.Row(table.RowProps{ID: "control--site-email--" + site.SiteID}) {
							@table.Cell() {
								@nav.Link("control--site-email--"+site.SiteID+"--site", "/sites/"+site.SiteID, "underline") {
									{ site.SiteID }
								}
							}
							@table.Cell() {
								{ display.DateTime(&site.EmailVerifiedAt) }
							}
							@table.Cell() {
								if working && httputils.IsControlAdmin(ctx) {
									@sendForm(site.SiteID)
								}
							}
						}
					}
				}
			}
		}
	</div>
}

// sendForm picks one of the pre-built emails and, after a question, sends it to the site
templ sendForm(siteID string) {
	<form
		class="flex items-center gap-2"
		hx-post={ "/site-emails/" + siteID }
		hx-swap="none"
		hx-confirm={ i18n.T(ctx, "control.site_emails.send_confirm") }
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		<select id={ "control--site-email--" + siteID + "--email" } name="email" aria-label={ i18n.T(ctx, "control.site_emails.email") } class="h-9 rounded-md border border-gray-200 bg-white px-3 text-sm">
			for _, email := range controlmodels.SiteEmails {
				<option value={ email }>{ i18n.T(ctx, emailLabels[email]) }</option>
			}
		</select>
		@button.Button(button.Props{ID: "control--site-email--" + siteID + "--send", Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
			@icon.Send()
			{ i18n.T(ctx, "control.site_emails.send") }
		}
	</form>
}

// Sent says the email was sent
templ Sent() {
	@successtoast.OOB(i18n.T(ctx, "control.site_emails.sent"))
}
