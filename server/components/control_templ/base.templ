package control_templ

import (
	"nighttroop.t1d.nz/server/components/confirm"
	"context"
	"fmt"

	"nighttroop.t1d.nz/server/components/footer"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/testsite"
	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/dropdown"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/label"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/config"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

templ ControlBase() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			// No settle delay: htmx's CSS transitions give a swapped input its old attributes until it settles, which empties
			// the focused one, such as a date picked or a search sent with Enter
			<meta name="htmx-config" content="defaultSettleDelay:0"/>
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/logo.png"/>
			<!-- Tailwind CSS -->
			<link href="/style_gen.css" rel="stylesheet"/>
			<script src="/htmx.js"></script>
			@copybutton.Script()
			@input.Script()
			@label.Script()
			@dropdown.Script()
			@inputotp.Script()
			@checkbox.Script()
			@selectbox.Script()
			@toast.Script()
			<script src="/qrcode.js"></script>
		</head>
		<body class="min-h-screen flex flex-col">
			@testsite.Banner()
			<div id="toaster" class="mb-3"></div>
			@confirm.Dialog()
			// The header's menu and the status are for a signed in admin, so the login and setup pages have neither
			{{ controlContext := httputils.GetControlContext(ctx) }}
			{{ signedIn := controlContext != nil && controlContext.IdentityModel != nil }}
			if signedIn {
				@Header()
				@StatusBanner(controlContext.ServerStatus)
			}
			// Signed out, the login and setup pages fill it, edge to edge
			<div
				id="main-content"
				class={ "flex-1", templ.KV("container center-container d-flex align-items-center justify-content-center py-4 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8", signedIn), templ.KV("flex flex-col", !signedIn) }
			>
				{ children... }
			</div>
			@footer.Footer()
			// After the page's own title, so it names the tab only when the page has none, see heading.Page
			<title>{ i18n.T(ctx, "control.base.title") }</title>
		</body>
	</html>
}

// StatusBanner warns control admins about optional services that are not working, resources running high, and sites
// near or at the limit MAX_SITES sets
templ StatusBanner(status config.ServerStatus) {
	if !status.S3Working || !status.SentryWorking || len(status.HighResources) > 0 || status.SitesNearLimit() {
		<div id="control--status-banner" class="bg-amber-500/10 border-b border-amber-500/20 text-amber-800 text-sm" role="alert">
			<div class="mx-auto max-w-7xl px-4 py-2 sm:px-6 lg:px-8">
				if !status.S3Working {
					<p id="control--status-banner--s3"><strong>{ i18n.T(ctx, "control.status_banner.s3_title") }</strong> { i18n.T(ctx, "control.status_banner.s3_text") }</p>
				}
				if !status.SentryWorking {
					<p id="control--status-banner--sentry"><strong>{ i18n.T(ctx, "control.status_banner.sentry_title") }</strong> { i18n.T(ctx, "control.status_banner.sentry_text") }</p>
				}
				for _, level := range status.HighResources {
					<p id={ "control--status-banner--" + level.Resource }><strong>{ resourceTitle(ctx, level) }:</strong> { resourceWarning(ctx, level) }</p>
				}
				if status.SitesNearLimit() {
					<p id="control--status-banner--sites">
						<strong>{ sitesTitle(ctx, status) }:</strong> { i18n.T(ctx, "control.status_banner.sites_text", i18n.Data{"SiteCount": status.Sites, "MaxSites": status.MaxSites}) }
					</p>
				}
			</div>
		</div>
	}
}

func sitesTitle(ctx context.Context, status config.ServerStatus) string {
	if status.SitesAtLimit() {
		return i18n.T(ctx, "control.status_banner.sites_at_limit")
	}
	return i18n.T(ctx, "control.status_banner.sites_near_limit")
}

// resourceTitles are the ids of each resource's title
var resourceTitles = map[string]string{
	"memory": "control.status_banner.memory_high", "disk": "control.status_banner.disk_high", "cpu": "control.status_banner.cpu_high",
}

func resourceTitle(ctx context.Context, level config.ResourceLevel) string {
	return i18n.T(ctx, resourceTitles[level.Resource])
}

// resourceWarning says how high a resource was at the last check: the CPU's seconds at 100%, the memory used and the
// disk free, in bytes where its total is known
func resourceWarning(ctx context.Context, level config.ResourceLevel) string {
	value, limit := fmt.Sprintf("%.0f", level.Value), fmt.Sprintf("%.0f", level.Limit)
	switch {
	case level.Resource == "cpu":
		return i18n.T(ctx, "control.status_banner.cpu_warning", i18n.Data{"CPUSeconds": value, "WarnAt": limit})
	case level.Total == nil:
		return i18n.T(ctx, "control.status_banner.percent_warning", i18n.Data{"UsedPercent": value, "WarnAt": limit})
	case level.Resource == "disk":
		free := *level.Total * (100 - level.Value) / 100
		return i18n.T(ctx, "control.status_banner.disk_warning", i18n.Data{"FreeBytes": display.Bytes(free), "TotalBytes": display.Bytes(*level.Total)})
	}
	return i18n.T(ctx, "control.status_banner.memory_warning", i18n.Data{"UsedBytes": display.Bytes(*level.Total*level.Value/100), "TotalBytes": display.Bytes(*level.Total)})
}

templ FullPage(content templ.Component) {
	@ControlBase() {
		@content
	}
}

templ menuItem(id string, path string, label string, itemIcon func(...icon.Props) templ.Component) {
	@dropdown.Item(dropdown.ItemProps{
		ID:   id,
		Href: "#",
		Attributes: nav.Attributes(path),
	}) {
		<span class="flex items-center">
			@itemIcon(icon.Props{Class: "size-4 mr-2"})
			{ label }
		</span>
	}
}

templ Header() {
	<nav class="bg-brand-night border-b border-white/10 shadow-sm">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex h-16 items-center justify-between">
				<!-- Brand -->
				<a href="/" class="flex items-center gap-2 text-white font-bold tracking-wide uppercase">
					<img id="control--nav--logo" src="/logo.svg" alt="" class="size-8"/>
					{ i18n.T(ctx, "control.base.title") }
				</a>
				<!-- Right side -->
				<div class="flex items-center gap-4">
					@dropdown.Dropdown(dropdown.Props{ID: "control--menu"}) {
						@dropdown.Trigger() {
							<button class="flex items-center justify-center size-9 rounded-full bg-gray-800 hover:bg-gray-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
								<span class="sr-only">{ i18n.T(ctx, "control.menu.open") }</span>
								@icon.Settings(icon.Props{Class: "size-6 text-white"})
							</button>
						}
						// As tall as the window allows, and two columns wide as the site's menu is, so every page in it shows without
						// scrolling it
						@dropdown.Content(dropdown.ContentProps{
							Class: "w-56 sm:w-[30rem] sm:max-w-[calc(100vw-2rem)] max-h-[calc(100vh-5rem)]",
						}) {
							// Security and users on the left, and jobs, logs and logout on the right
							<div class="sm:grid sm:grid-cols-2 sm:gap-x-1">
								<div>
									@dropdown.Label() {
										{ i18n.T(ctx, "control.menu.security") }
									}
									@dropdown.Group() {
										@menuItem("control--account-button", "/account", i18n.T(ctx, "control.menu.account"), icon.UserCog)
										@menuItem("control--admins-button", "/admins", i18n.T(ctx, "control.menu.admins"), icon.ShieldUser)
									}
									@dropdown.Separator()
									@dropdown.Label() {
										{ i18n.T(ctx, "control.menu.users") }
									}
									@dropdown.Group() {
										@menuItem("control--usage-button", "/usage", i18n.T(ctx, "control.menu.usage"), icon.Gauge)
										@menuItem("control--rate-limits-button", "/rate-limits", i18n.T(ctx, "control.menu.rate_limits"), icon.Timer)
										@menuItem("control--sites-button", "/sites", i18n.T(ctx, "control.menu.sites"), icon.Users)
										@menuItem("control--archived-sites-button", "/archived-sites", i18n.T(ctx, "control.menu.archived_sites"), icon.Archive)
										@menuItem("control--connectors-button", "/connectors", i18n.T(ctx, "control.menu.connectors"), icon.Plug)
										@menuItem("control--push-devices-button", "/push-devices", i18n.T(ctx, "control.menu.push_devices"), icon.Send)
										@menuItem("control--push-credentials-button", "/push-credentials", i18n.T(ctx, "control.menu.push_credentials"), icon.KeyRound)
									}
								</div>
								<div>
									@dropdown.Separator(dropdown.SeparatorProps{Class: "sm:hidden"})
									@dropdown.Label() {
										{ i18n.T(ctx, "control.menu.jobs") }
									}
									@dropdown.Group() {
										@menuItem("control--job-stats-button", "/job-stats", i18n.T(ctx, "control.menu.job_stats"), icon.ChartColumn)
										@menuItem("control--jobs-button", "/jobs", i18n.T(ctx, "control.menu.jobs"), icon.ListChecks)
									}
									@dropdown.Separator()
									@dropdown.Label() {
										{ i18n.T(ctx, "control.menu.logs") }
									}
									@dropdown.Group() {
										@menuItem("control--events-button", "/events", i18n.T(ctx, "control.menu.events"), icon.Activity)
										@menuItem("control--errors-button", "/errors", i18n.T(ctx, "control.menu.errors"), icon.TriangleAlert)
										@menuItem("control--logs-button", "/logs", i18n.T(ctx, "control.menu.logs"), icon.ScrollText)
										@dropdown.Separator()
										@dropdown.Item(dropdown.ItemProps{
											Href: "#",
											Attributes: templ.Attributes{
												"hx-post":   "/logout",
												"hx-target": "body",

												"hx-swap": "outerHTML",
											},
										}) {
											<span class="flex items-center">
												@icon.LogOut(icon.Props{Class: "size-4 mr-2"})
												{ i18n.T(ctx, "control.menu.logout") }
											</span>
										}
									}
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</nav>
}
