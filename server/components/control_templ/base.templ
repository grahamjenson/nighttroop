package control_templ

import (
	"fmt"

	"nighttroop.t1d.nz/server/components/footer"
	"nighttroop.t1d.nz/server/components/testsite"
	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/dropdown"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/label"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/config"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
)

templ ControlBase() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/logo.png"/>
			<!-- Tailwind CSS -->
			<link href="/style_gen.css" rel="stylesheet"/>
			<script src="/htmx.js"></script>
			@copybutton.Script()
			@input.Script()
			@label.Script()
			@dropdown.Script()
			@inputotp.Script()
			@checkbox.Script()
			@selectbox.Script()
			@toast.Script()
			<script src="/qrcode.js"></script>
		</head>
		<body class="min-h-screen flex flex-col">
			@testsite.Banner()
			<div id="toaster" class="mb-3"></div>
			// The header's menu and the status are for a signed in admin, so the login and setup pages have neither
			if controlContext := httputils.GetControlContext(ctx); controlContext != nil && controlContext.IdentityModel != nil {
				@Header()
				@StatusBanner(controlContext.ServerStatus)
			}
			<div
				id="main-content"
				class="flex-1 container center-container d-flex align-items-center justify-content-center py-4 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
			>
				<div id="error-container" class="mt-3"></div>
				{ children... }
			</div>
			@footer.Footer()
			// After the page's own title, so it names the tab only when the page has none, see heading.Page
			<title>Nighttroop Control</title>
		</body>
	</html>
}

// StatusBanner warns control admins about optional services that are not working, resources running high, and sites
// near or at the limit MAX_SITES sets
templ StatusBanner(status config.ServerStatus) {
	if !status.S3Working || !status.SentryWorking || len(status.HighResources) > 0 || status.SitesNearLimit() {
		<div id="control--status-banner" class="bg-amber-500/10 border-b border-amber-500/20 text-amber-800 text-sm" role="alert">
			<div class="mx-auto max-w-7xl px-4 py-2 sm:px-6 lg:px-8">
				if !status.S3Working {
					<p id="control--status-banner--s3"><strong>S3 not connected:</strong> backups are not being stored.</p>
				}
				if !status.SentryWorking {
					<p id="control--status-banner--sentry"><strong>Sentry not connected:</strong> errors are not being reported.</p>
				}
				for _, level := range status.HighResources {
					<p id={ "control--status-banner--" + level.Resource }><strong>{ resourceTitle(level) }:</strong> { resourceWarning(level) }</p>
				}
				if status.SitesNearLimit() {
					<p id="control--status-banner--sites">
						<strong>{ sitesTitle(status) }:</strong> { fmt.Sprintf("%d of the %d MAX_SITES allows.", status.Sites, status.MaxSites) }
					</p>
				}
			</div>
		</div>
	}
}

func sitesTitle(status config.ServerStatus) string {
	if status.SitesAtLimit() {
		return "Sites at their limit"
	}
	return "Sites near their limit"
}

func resourceTitle(level config.ResourceLevel) string {
	return map[string]string{"memory": "Memory high", "disk": "Disk high", "cpu": "CPU high"}[level.Resource]
}

// resourceWarning says how high a resource was at the last check: the CPU's seconds at 100%, the memory used and the
// disk free, in bytes where its total is known
func resourceWarning(level config.ResourceLevel) string {
	switch {
	case level.Resource == "cpu":
		return fmt.Sprintf("at 100%% for %.0f seconds, and %.0f or more warns.", level.Value, level.Limit)
	case level.Total == nil:
		return fmt.Sprintf("%.0f%% used, and %.0f%% or more warns.", level.Value, level.Limit)
	case level.Resource == "disk":
		free := *level.Total * (100 - level.Value) / 100
		return fmt.Sprintf("%s free of %s.", display.Bytes(free), display.Bytes(*level.Total))
	}
	return fmt.Sprintf("%s used of %s.", display.Bytes(*level.Total*level.Value/100), display.Bytes(*level.Total))
}

templ FullPage(content templ.Component) {
	@ControlBase() {
		@content
	}
}

templ menuItem(id string, path string, label string, itemIcon func(...icon.Props) templ.Component) {
	@dropdown.Item(dropdown.ItemProps{
		ID:   id,
		Href: "#",
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		<span class="flex items-center">
			@itemIcon(icon.Props{Class: "size-4 mr-2"})
			{ label }
		</span>
	}
}

templ Header() {
	<nav class="bg-brand-night border-b border-white/10 shadow-sm">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex h-16 items-center justify-between">
				<!-- Brand -->
				<a href="/" class="flex items-center gap-2 text-white font-bold tracking-wide uppercase">
					<img id="control--nav--logo" src="/logo.svg" alt="" class="size-8"/>
					NightTroop Control
				</a>
				<!-- Right side -->
				<div class="flex items-center gap-4">
					@dropdown.Dropdown(dropdown.Props{ID: "control--menu"}) {
						@dropdown.Trigger() {
							<button class="flex items-center justify-center size-9 rounded-full bg-gray-800 hover:bg-gray-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
								<span class="sr-only">Open user menu</span>
								@icon.Settings(icon.Props{Class: "size-6 text-white"})
							</button>
						}
						// As tall as the window allows, and two columns wide as the site's menu is, so every page in it shows without
						// scrolling it
						@dropdown.Content(dropdown.ContentProps{
							Class: "w-56 sm:w-[30rem] sm:max-w-[calc(100vw-2rem)] max-h-[calc(100vh-5rem)]",
						}) {
							// Security and users on the left, and jobs, logs and logout on the right
							<div class="sm:grid sm:grid-cols-2 sm:gap-x-1">
								<div>
									@dropdown.Label() {
										Security
									}
									@dropdown.Group() {
										@dropdown.Item(dropdown.ItemProps{
											Href: "#",
										}) {
											<span class="flex items-center">
												@icon.UserCog(icon.Props{Class: "size-4 mr-2"})
												Account
											</span>
										}
									}
									@dropdown.Separator()
									@dropdown.Label() {
										Users
									}
									@dropdown.Group() {
										@menuItem("control--usage-button", "/usage", "Usage", icon.Gauge)
										@menuItem("control--rate-limits-button", "/rate-limits", "Rate Limits", icon.Timer)
										@menuItem("control--sites-button", "/sites", "Sites", icon.Users)
										@menuItem("control--archived-sites-button", "/archived-sites", "Archived Sites", icon.Archive)
										@menuItem("control--sync-sources-button", "/sync-sources", "Sync Sources", icon.RefreshCw)
										@menuItem("control--push-devices-button", "/push-devices", "Push Devices", icon.Send)
									}
								</div>
								<div>
									@dropdown.Separator(dropdown.SeparatorProps{Class: "sm:hidden"})
									@dropdown.Label() {
										Jobs
									}
									@dropdown.Group() {
										@menuItem("control--job-stats-button", "/job-stats", "Job Stats", icon.ChartColumn)
										@menuItem("control--jobs-button", "/jobs", "Jobs", icon.ListChecks)
									}
									@dropdown.Separator()
									@dropdown.Label() {
										Logs
									}
									@dropdown.Group() {
										@menuItem("control--events-button", "/events", "Events", icon.Activity)
										@menuItem("control--errors-button", "/errors", "Errors", icon.TriangleAlert)
										@menuItem("control--logs-button", "/logs", "Logs", icon.ScrollText)
										@dropdown.Separator()
										@dropdown.Item(dropdown.ItemProps{
											Href: "#",
											Attributes: templ.Attributes{
												"hx-post":   "/logout",
												"hx-target": "body",

												"hx-swap": "outerHTML",
											},
										}) {
											<span class="flex items-center">
												@icon.LogOut(icon.Props{Class: "size-4 mr-2"})
												Logout
											</span>
										}
									}
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</nav>
}
