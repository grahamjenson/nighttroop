package control_rate_limits_templ

import (
	"context"
	"fmt"
	"strconv"

	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/config"
	"nighttroop.t1d.nz/utils/i18n"
)

// labels are the ids of what each kind of rate limiter limits
var labels = map[string]string{
	"global":                 "control.rate_limits.limiter_global",
	"control":                "control.rate_limits.limiter_control",
	"global_ip":              "control.rate_limits.limiter_global_ip",
	"site_create":            "control.rate_limits.limiter_site_create",
	"site_create_ip":         "control.rate_limits.limiter_site_create_ip",
	"login_name":             "control.rate_limits.limiter_login_name",
	"login_ip":               "control.rate_limits.limiter_login_ip",
	"site_unauth":            "control.rate_limits.limiter_site_unauth",
	"site_get":               "control.rate_limits.limiter_site_get",
	"site_post":              "control.rate_limits.limiter_site_post",
	"site_post_flagged":      "control.rate_limits.limiter_site_post_flagged",
	"identity_get":           "control.rate_limits.limiter_identity_get",
	"identity_post":          "control.rate_limits.limiter_identity_post",
	"site_update_connectors": "control.rate_limits.limiter_site_update_connectors",
	"site_identity_create":   "control.rate_limits.limiter_site_identity_create",
	"site_download":          "control.rate_limits.limiter_site_download",
	"site_report_print":      "control.rate_limits.limiter_site_report_print",
	"site_push":              "control.rate_limits.limiter_site_push",
}

// settingLabels are the ids of what each rate limit setting limits
var settingLabels = map[string]string{
	"global":                 "control.rate_limits.setting_global",
	"global_ip":              "control.rate_limits.setting_global_ip",
	"site_create":            "control.rate_limits.setting_site_create",
	"site_create_ip":         "control.rate_limits.setting_site_create_ip",
	"login":                  "control.rate_limits.setting_login",
	"login_name":             "control.rate_limits.setting_login_name",
	"site_unauth":            "control.rate_limits.setting_site_unauth",
	"site_get":               "control.rate_limits.setting_site_get",
	"site_post":              "control.rate_limits.setting_site_post",
	"site_post_flagged":      "control.rate_limits.setting_site_post_flagged",
	"site_update_connectors": "control.rate_limits.setting_site_update_connectors",
	"site_identity_create":   "control.rate_limits.setting_site_identity_create",
	"site_download":          "control.rate_limits.setting_site_download",
	"site_report_print":      "control.rate_limits.setting_site_report_print",
	"site_push":              "control.rate_limits.setting_site_push",
}

func number(n float64) string { return strconv.FormatFloat(n, 'f', -1, 64) }

// pers are the ids of what one of each kind of rate limiter is kept for
var pers = map[string]string{
	"server":   "control.rate_limits.per_server",
	"ip":       "control.rate_limits.per_ip",
	"site":     "control.rate_limits.per_site",
	"identity": "control.rate_limits.per_identity",
	"login":    "control.rate_limits.per_login",
	"site_ip":  "control.rate_limits.per_site_ip",
}

// cells are a kind of rate limiter's row: what it limits, per what, its rate and burst, how many are kept, how full the
// most used is and how many would refuse
func cells(ctx context.Context, s config.RateLimiterStats) []string {
	return []string{i18n.T(ctx, labels[s.Name]), i18n.T(ctx, pers[s.Per]), number(s.PerMinute), fmt.Sprint(s.Burst),
		fmt.Sprint(s.Tracked), fmt.Sprintf("%.0f%%", s.FullestPercent), fmt.Sprint(s.Limited)}
}

// cellClass right aligns the numbers, and colours the last two amber once the most used limiter has spent half its
// burst, and red while any would refuse
func cellClass(s config.RateLimiterStats, i int) string {
	switch {
	case i < 2:
		return ""
	case i < 5:
		return "text-right tabular-nums"
	case s.Limited > 0:
		return "text-right tabular-nums font-semibold text-red-700"
	case s.FullestPercent >= 50:
		return "text-right tabular-nums font-semibold text-amber-800"
	}
	return "text-right tabular-nums"
}

// RateLimits shows each rate limit, which an admin can change, then each kind of rate limiter, its rate and burst,
// and how close the ones kept are to refusing, which is read again every 10 seconds
templ RateLimits(stats []config.RateLimiterStats, settings []config.RateSetting, admin bool) {
	<div class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "control.rate_limits.title")) {
			{ i18n.T(ctx, "control.rate_limits.intro") }
		}
		@card.Card(card.Props{}) {
			@RateSettings(settings, admin)
		}
		@card.Card(card.Props{}) {
			@RateLimitStats(stats, false)
		}
	</div>
}

// RateLimitStats is each kind of rate limiter, its rate and burst, and how close the ones kept are to refusing, read
// again every 10 seconds, or out of band as the rates are saved
templ RateLimitStats(stats []config.RateLimiterStats, oob bool) {
	<section
		id="control--rate-limits"
		hx-get="/rate-limits"
		hx-trigger="every 10s"
		hx-select="#control--rate-limits"
		hx-target="this"
		hx-swap="outerHTML"
		if oob {
			hx-swap-oob="true"
		}
	>
		@table.Table(table.Props{ID: "controlRateLimitsTable", Class: "rounded-lg border border-gray-200"}) {
			@table.Header() {
				@table.Row() {
					for i, head := range []string{"control.rate_limits.limiter", "control.rate_limits.per", "control.rate_limits.rate", "control.rate_limits.burst",
						"control.rate_limits.kept", "control.rate_limits.fullest", "control.rate_limits.refusing"} {
						@table.Head(table.HeadProps{Class: cellClass(config.RateLimiterStats{}, i)}) {
							{ i18n.T(ctx, head) }
						}
					}
				}
			}
			@table.Body() {
				for _, s := range stats {
					@table.Row(table.RowProps{ID: "control--rate-limits--" + s.Name}) {
						for i, cell := range cells(ctx, s) {
							@table.Cell(table.CellProps{Class: cellClass(s, i)}) {
								{ cell }
							}
						}
					}
				}
			}
		}
	</section>
}

// RateSettings is each rate limit, its env variable and default, and its rate now, which an admin can change: one
// set to its default, or left blank, uses the env's from then on
templ RateSettings(settings []config.RateSetting, admin bool) {
	<form
		id="control--rate-settings"
		hx-post="/rate-limits"
		hx-target="this"
		hx-swap="outerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		@table.Table(table.Props{Class: "rounded-lg border border-gray-200"}) {
			@table.Header() {
				@table.Row() {
					for _, head := range []string{"control.rate_limits.limit", "control.rate_limits.env", "control.rate_limits.env_default",
						"control.rate_limits.rate", "control.rate_limits.burst"} {
						@table.Head() {
							{ i18n.T(ctx, head) }
						}
					}
				}
			}
			@table.Body() {
				for _, s := range settings {
					@table.Row(table.RowProps{ID: "control--rate-settings--" + s.Name}) {
						@table.Cell() {
							{ i18n.T(ctx, settingLabels[s.Name]) }
							if s.Set {
								<span class="ml-1 text-xs font-semibold text-primary">{ i18n.T(ctx, "control.rate_limits.set_here") }</span>
							}
						}
						@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
							{ s.Env + "_LIMIT/_BURST" }
						}
						@table.Cell(table.CellProps{Class: "tabular-nums"}) {
							{ number(s.Default.PerMinute) + ", " + fmt.Sprint(s.Default.Burst) }
						}
						for _, field := range []struct{ name, value string }{{"per_minute", number(s.Rate.PerMinute)}, {"burst", fmt.Sprint(s.Rate.Burst)}} {
							@table.Cell(table.CellProps{Class: "w-32"}) {
								@input.Input(input.Props{ID: "control--rate-settings--" + s.Name + "--" + field.name, Name: s.Name + "-" + field.name,
									Type: input.TypeNumber, Value: field.value, Readonly: !admin, Attributes: templ.Attributes{"min": "0", "step": "any"}})
							}
						}
					}
				}
			}
		}
		if admin {
			<div class="mt-4 flex justify-end">
				@button.Button(button.Props{ID: "control--rate-settings--save", Type: button.TypeSubmit}) {
					{ i18n.T(ctx, "control.rate_limits.save") }
				}
			</div>
		}
	</form>
}

// RateSettingsSaved is the rate limits as saved, the limiters' rates now, and a toast saying so
templ RateSettingsSaved(settings []config.RateSetting, stats []config.RateLimiterStats) {
	@RateSettings(settings, true)
	@RateLimitStats(stats, true)
	@successtoast.OOB(i18n.T(ctx, "control.rate_limits.saved"))
}
