	"fmt"
	"slices"
	"strconv"

	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/badge"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/config"
	"nighttroop.t1d.nz/utils/i18n"
	"nighttroop.t1d.nz/utils/templui/utils"
)

// labels are the ids of what each kind of rate limiter limits
var labels = map[string]string{
	"global":                 "control.rate_limits.limiter_global",
	"control":                "control.rate_limits.limiter_control",
	"global_ip":              "control.rate_limits.limiter_global_ip",
	"site_create":            "control.rate_limits.limiter_site_create",
	"site_create_ip":         "control.rate_limits.limiter_site_create_ip",
	"login_name":             "control.rate_limits.limiter_login_name",
	"login_ip":               "control.rate_limits.limiter_login_ip",
	"site_unauth":            "control.rate_limits.limiter_site_unauth",
	"site_get":               "control.rate_limits.limiter_site_get",
	"site_post":              "control.rate_limits.limiter_site_post",
	"site_post_flagged":      "control.rate_limits.limiter_site_post_flagged",
	"identity_get":           "control.rate_limits.limiter_identity_get",
	"identity_post":          "control.rate_limits.limiter_identity_post",
	"site_update_connectors": "control.rate_limits.limiter_site_update_connectors",
	"site_identity_create":   "control.rate_limits.limiter_site_identity_create",
	"site_download":          "control.rate_limits.limiter_site_download",
	"site_report_print":      "control.rate_limits.limiter_site_report_print",
	"site_push":              "control.rate_limits.limiter_site_push",
}

// settingLabels are the ids of what each rate limit setting limits
var settingLabels = map[string]string{
	"global":                 "control.rate_limits.setting_global",
	"global_ip":              "control.rate_limits.setting_global_ip",
	"site_create":            "control.rate_limits.setting_site_create",
	"site_create_ip":         "control.rate_limits.setting_site_create_ip",
	"login":                  "control.rate_limits.setting_login",
	"login_name":             "control.rate_limits.setting_login_name",
	"site_unauth":            "control.rate_limits.setting_site_unauth",
	"site_get":               "control.rate_limits.setting_site_get",
	"site_post":              "control.rate_limits.setting_site_post",
	"site_post_flagged":      "control.rate_limits.setting_site_post_flagged",
	"site_update_connectors": "control.rate_limits.setting_site_update_connectors",
	"site_identity_create":   "control.rate_limits.setting_site_identity_create",
	"site_download":          "control.rate_limits.setting_site_download",
	"site_report_print":      "control.rate_limits.setting_site_report_print",
	"site_push":              "control.rate_limits.setting_site_push",
}

func number(n float64) string { return strconv.FormatFloat(n, 'f', -1, 64) }

// pers are the ids of what one of each kind of rate limiter is kept for
var pers = map[string]string{
	"server":   "control.rate_limits.per_server",
	"ip":       "control.rate_limits.per_ip",
	"site":     "control.rate_limits.per_site",
	"identity": "control.rate_limits.per_identity",
	"login":    "control.rate_limits.per_login",
	"site_ip":  "control.rate_limits.per_site_ip",
}

// groups are the rate limit settings in groups of what they protect, each with the ids of its title and note
var groups = []struct {
	name, title, note string
	settings          []string
}{
	{"server", "control.rate_limits.group_server", "control.rate_limits.group_server_note", []string{"global", "global_ip"}},
	{"sign_in", "control.rate_limits.group_sign_in", "control.rate_limits.group_sign_in_note", []string{"login", "login_name", "site_unauth"}},
	{"site_create", "control.rate_limits.group_site_create", "control.rate_limits.group_site_create_note", []string{"site_create", "site_create_ip"}},
	{"site_data", "control.rate_limits.group_site_data", "control.rate_limits.group_site_data_note", []string{"site_get", "site_post", "site_post_flagged"}},
	{"site_actions", "control.rate_limits.group_site_actions", "control.rate_limits.group_site_actions_note",
		[]string{"site_update_connectors", "site_identity_create", "site_download", "site_report_print", "site_push"}},
}

// level is how close a kind of rate limiter is to refusing: 2 while any would refuse, 1 once the most used has spent
// half its burst, else 0
func level(s config.RateLimiterStats) int {
	switch {
	case s.Limited > 0:
		return 2
	case s.FullestPercent >= 50:
		return 1
	}
	return 0
}

// groupLevel is the highest level of the rate limiters that use the group's settings
func groupLevel(stats []config.RateLimiterStats, settings []string) int {
	highest := 0
	for _, s := range stats {
		if slices.Contains(settings, s.Setting) {
			highest = max(highest, level(s))
		}
	}
	return highest
}

// levelClasses are the colours of a rate limiter's bar, and of its fullest and refusing, at each level
var levelClasses = []struct{ bar, text string }{
	{"bg-primary", ""}, {"bg-amber-500", "font-semibold text-amber-800"}, {"bg-red-600", "font-semibold text-red-700"},
}

// headClasses are the widths of a group's columns, the same in every group so they line up, and right align the numbers
var headClasses = []string{"", "w-32", "w-32 text-right", "w-32 text-right", "w-14 text-right", "w-32", "w-20 text-right"}

// RateLimits shows the rate limits in groups of what they protect. Under each setting, which an admin can change, are
// the kinds of rate limiter that use it, with their rate and burst now and how close the ones kept are to refusing,
// read again every 10 seconds.
templ RateLimits(stats []config.RateLimiterStats, settings []config.RateSetting, admin bool) {
	<div class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "control.rate_limits.title")) {
			{ i18n.T(ctx, "control.rate_limits.intro") }
		}
		// Only the parts marked data-rate-limits-live are swapped in, so rates being typed are left as they are
		<div id="control--rate-limits--refresh" hx-get="/rate-limits" hx-trigger="every 10s" hx-select-oob="[data-rate-limits-live]" hx-swap="none"></div>
		@RateSettings(settings, stats, admin)
	</div>
}

// groupStatus is a marker beside a group's title while any of its rate limiters is nearly full or would refuse
templ groupStatus(name string, stats []config.RateLimiterStats, settings []string) {
	<span id={ "control--rate-limits--group--" + name + "--status" } data-rate-limits-live>
		switch groupLevel(stats, settings) {
			case 2:
				@badge.Badge(badge.Props{Variant: badge.VariantError}) {
					{ i18n.T(ctx, "control.rate_limits.refusing") }
				}
			case 1:
				@badge.Badge(badge.Props{Variant: badge.VariantWarning}) {
					{ i18n.T(ctx, "control.rate_limits.nearly_full") }
				}
		}
	</span>
}

// settingRow is a rate limit setting: what it limits, its env variables and default, struck through while an admin
// has set it here, and its rate and burst now, which an admin can change
templ settingRow(s config.RateSetting, admin bool) {
	@table.Row(table.RowProps{ID: "control--rate-settings--" + s.Name, Class: utils.TwMerge("border-t-2", utils.If(s.Set, "bg-primary/5"))}) {
		@table.Cell(table.CellProps{Class: utils.TwMerge("whitespace-normal border-l-4 border-l-transparent", utils.If(s.Set, "border-l-primary"))}) {
			<div class="font-medium text-gray-900">
				{ i18n.T(ctx, settingLabels[s.Name]) }
				if s.Set {
					@badge.Badge(badge.Props{ID: "control--rate-settings--" + s.Name + "--set", Variant: badge.VariantPrimary, Class: "ml-1"}) {
						{ i18n.T(ctx, "control.rate_limits.set_here") }
					}
				}
			</div>
			<div class="break-all font-mono text-xs text-gray-500">{ s.Env + "_LIMIT/_BURST" }</div>
			<div id={ "control--rate-settings--" + s.Name + "--default" } class={ "text-xs tabular-nums text-gray-500", templ.KV("line-through", s.Set) }>
				{ i18n.T(ctx, "control.rate_limits.env_default_of", i18n.Data{"Rate": number(s.Default.PerMinute), "Burst": s.Default.Burst}) }
			</div>
		}
		@table.Cell()
		for _, field := range []struct{ name, value string }{{"per_minute", number(s.Rate.PerMinute)}, {"burst", fmt.Sprint(s.Rate.Burst)}} {
			@table.Cell() {
				@input.Input(input.Props{ID: "control--rate-settings--" + s.Name + "--" + field.name, Name: s.Name + "-" + field.name,
					Type: input.TypeNumber, Class: "text-right", Value: field.value, Readonly: !admin, Attributes: templ.Attributes{"min": "0", "step": "any"}})
			}
		}
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "3"}})
	}
}

// limiterRow is a kind of rate limiter that uses a setting: what one is kept for and how many times the setting's rate
// it has, its rate and burst now, how many are kept, how much of its burst the most used has spent, and how many would
// refuse. It is read again every 10 seconds.
templ limiterRow(s config.RateLimiterStats) {
	{{ colours := levelClasses[level(s)] }}
	<tr id={ "control--rate-limits--" + s.Name } data-rate-limits-live class={ "border-b text-gray-600", templ.KV("bg-amber-100", level(s) == 1), templ.KV("bg-red-100", level(s) == 2) }>
		@table.Cell(table.CellProps{Class: "whitespace-normal pl-6"}) {
			{ "↳ " + i18n.T(ctx, labels[s.Name]) }
		}
		@table.Cell(table.CellProps{Class: "whitespace-nowrap"}) {
			{ i18n.T(ctx, pers[s.Per]) + utils.If(s.Scale > 1, ", "+i18n.T(ctx, "control.rate_limits.scale", i18n.Data{"Scale": s.Scale})) }
		}
		for _, cell := range []string{number(s.PerMinute), fmt.Sprint(s.Burst), fmt.Sprint(s.Tracked)} {
			@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
				{ cell }
			}
		}
		@table.Cell() {
			<div class="flex items-center gap-2">
				<div class="h-2 w-20 overflow-hidden rounded-full bg-gray-200">
					<div id={ "control--rate-limits--" + s.Name + "--bar" } class={ "h-full min-w-[2px] rounded-full", colours.bar } style={ fmt.Sprintf("width: %.0f%%", s.FullestPercent) }></div>
				</div>
				<span class={ "tabular-nums", colours.text }>{ fmt.Sprintf("%.0f%%", s.FullestPercent) }</span>
			</div>
		}
		@table.Cell(table.CellProps{Class: utils.TwMerge("text-right tabular-nums", colours.text)}) {
			{ fmt.Sprint(s.Limited) }
		}
	</tr>
}

// RateSettings is a card for each group of rate limits, saying what they protect, with each setting and the kinds of
// rate limiter that use it. An admin can change each setting: one set to its default, or left blank, uses the env's
// from then on.
templ RateSettings(settings []config.RateSetting, stats []config.RateLimiterStats, admin bool) {
	<form
		id="control--rate-settings"
		class="space-y-6"
		hx-post="/rate-limits"
		hx-target="this"
		hx-swap="outerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		for _, group := range groups {
			@card.Card(card.Props{ID: "control--rate-limits--group--" + group.name, Title: i18n.T(ctx, group.title),
				Note: i18n.T(ctx, group.note), Action: groupStatus(group.name, stats, group.settings)}) {
				@table.Table(table.Props{ID: "control--rate-limits--group--" + group.name + "--table", Class: "min-w-[60rem] table-fixed"}) {
					@table.Header() {
						@table.Row() {
							for i, head := range []string{"control.rate_limits.limit", "control.rate_limits.per", "control.rate_limits.rate", "control.rate_limits.burst",
								"control.rate_limits.kept", "control.rate_limits.fullest", "control.rate_limits.refusing"} {
								@table.Head(table.HeadProps{Class: headClasses[i]}) {
									{ i18n.T(ctx, head) }
								}
							}
						}
					}
					@table.Body() {
						for _, name := range group.settings {
							if i := slices.IndexFunc(settings, func(s config.RateSetting) bool { return s.Name == name }); i >= 0 {
								@settingRow(settings[i], admin)
							}
							for _, s := range stats {
								if s.Setting == name {
									@limiterRow(s)
								}
							}
						}
					}
				}
			}
		}
		if admin {
			<div class="flex justify-end">
				@button.Button(button.Props{ID: "control--rate-settings--save", Type: button.TypeSubmit}) {
					@icon.Save()
					{ i18n.T(ctx, "control.rate_limits.save") }
				}
			</div>
		}
	</form>
}

// RateSettingsSaved is the rate limits as saved, with the limiters' rates now, and a toast saying so
templ RateSettingsSaved(settings []config.RateSetting, stats []config.RateLimiterStats) {
	@RateSettings(settings, stats, true)
	@successtoast.OOB(i18n.T(ctx, "control.rate_limits.saved"))
}
