package control_rate_limits_templ

import (
	"fmt"
	"strconv"

	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/config"
)

// labels say what each kind of rate limiter limits
var labels = map[string]string{
	"global": "Every request but the control site's", "control": "The control site's, signed out", "global_ip": "Requests from an IP", "site_create": "Sites created",
	"site_create_ip": "Sites created from an IP", "login_name": "Logins to a name", "login_ip": "Logins from an IP",
	"site_unauth": "Requests to a site before signing in", "site_get": "A site's reads", "site_post": "A site's writes",
	"identity_get": "An identity's reads", "identity_post": "An identity's writes", "site_update_connectors": "A site's connector changes",
	"site_identity_create": "A site's identities created", "site_download": "A site's downloads", "site_report_print": "A site's printable reports", "site_push": "A site's pushes",
}

// settingLabels say what each rate limit setting limits
var settingLabels = map[string]string{
	"global": "Every request, and the control site's signed out", "global_ip": "Requests from an IP", "site_create": "Sites created",
	"site_create_ip": "Sites created from an IP", "login": "Logins from an IP", "login_name": "Logins to a name, from every IP", "site_unauth": "Requests to a site before signing in",
	"site_get": "A site's and an identity's reads", "site_post": "A site's and an identity's writes", "site_update_connectors": "A site's connector changes",
	"site_identity_create": "A site's identities created", "site_download": "A site's downloads", "site_report_print": "A site's printable reports", "site_push": "A site's pushes",
}

func number(n float64) string { return strconv.FormatFloat(n, 'f', -1, 64) }

// pers say what one of each kind of rate limiter is kept for
var pers = map[string]string{"server": "Server", "ip": "IP", "site": "Site", "identity": "Identity", "login": "Login name",
	"site_ip": "IP on a site"}

// cells are a kind of rate limiter's row: what it limits, per what, its rate and burst, how many are kept, how full the
// most used is and how many would refuse
func cells(s config.RateLimiterStats) []string {
	return []string{labels[s.Name], pers[s.Per], number(s.PerMinute), fmt.Sprint(s.Burst),
		fmt.Sprint(s.Tracked), fmt.Sprintf("%.0f%%", s.FullestPercent), fmt.Sprint(s.Limited)}
}

// cellClass right aligns the numbers, and colours the last two amber once the most used limiter has spent half its
// burst, and red while any would refuse
func cellClass(s config.RateLimiterStats, i int) string {
	switch {
	case i < 2:
		return ""
	case i < 5:
		return "text-right tabular-nums"
	case s.Limited > 0:
		return "text-right tabular-nums font-semibold text-red-700"
	case s.FullestPercent >= 50:
		return "text-right tabular-nums font-semibold text-amber-800"
	}
	return "text-right tabular-nums"
}

// RateLimits shows each rate limit, which an admin can change, then each kind of rate limiter, its rate and burst,
// and how close the ones kept are to refusing, which is read again every 10 seconds
templ RateLimits(stats []config.RateLimiterStats, settings []config.RateSetting, admin bool) {
	<div class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Rate Limits") {
			How close the server's rate limiters are to refusing requests, checked every 10 seconds. One is kept for each
			server, IP, site or identity, and refills at its rate up to its burst. Each rate is its env variable's unless
			an admin sets it here.
		}
		@card.Card(card.Props{}) {
			@RateSettings(settings, admin)
		}
		@card.Card(card.Props{}) {
			@RateLimitStats(stats, false)
		}
	</div>
}

// RateLimitStats is each kind of rate limiter, its rate and burst, and how close the ones kept are to refusing, read
// again every 10 seconds, or out of band as the rates are saved
templ RateLimitStats(stats []config.RateLimiterStats, oob bool) {
	<section
		id="control--rate-limits"
		hx-get="/rate-limits"
		hx-trigger="every 10s"
		hx-select="#control--rate-limits"
		hx-target="this"
		hx-swap="outerHTML"
		if oob {
			hx-swap-oob="true"
		}
	>
		@table.Table(table.Props{ID: "controlRateLimitsTable", Class: "rounded-lg border border-gray-200"}) {
			@table.Header() {
				@table.Row() {
					for i, head := range []string{"Limiter", "Per", "Rate / min", "Burst", "Kept", "Fullest", "Refusing"} {
						@table.Head(table.HeadProps{Class: cellClass(config.RateLimiterStats{}, i)}) {
							{ head }
						}
					}
				}
			}
			@table.Body() {
				for _, s := range stats {
					@table.Row(table.RowProps{ID: "control--rate-limits--" + s.Name}) {
						for i, cell := range cells(s) {
							@table.Cell(table.CellProps{Class: cellClass(s, i)}) {
								{ cell }
							}
						}
					}
				}
			}
		}
	</section>
}

// RateSettings is each rate limit, its env variable and default, and its rate now, which an admin can change: one
// set to its default, or left blank, uses the env's from then on
templ RateSettings(settings []config.RateSetting, admin bool) {
	<form
		id="control--rate-settings"
		hx-post="/rate-limits"
		hx-target="this"
		hx-swap="outerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		@table.Table(table.Props{Class: "rounded-lg border border-gray-200"}) {
			@table.Header() {
				@table.Row() {
					for _, head := range []string{"Limit", "Env", "Env default", "Rate / min", "Burst"} {
						@table.Head() {
							{ head }
						}
					}
				}
			}
			@table.Body() {
				for _, s := range settings {
					@table.Row(table.RowProps{ID: "control--rate-settings--" + s.Name}) {
						@table.Cell() {
							{ settingLabels[s.Name] }
							if s.Set {
								<span class="ml-1 text-xs font-semibold text-primary">set here</span>
							}
						}
						@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
							{ s.Env + "_LIMIT/_BURST" }
						}
						@table.Cell(table.CellProps{Class: "tabular-nums"}) {
							{ number(s.Default.PerMinute) + ", " + fmt.Sprint(s.Default.Burst) }
						}
						for _, field := range []struct{ name, value string }{{"per_minute", number(s.Rate.PerMinute)}, {"burst", fmt.Sprint(s.Rate.Burst)}} {
							@table.Cell(table.CellProps{Class: "w-32"}) {
								@input.Input(input.Props{ID: "control--rate-settings--" + s.Name + "--" + field.name, Name: s.Name + "-" + field.name,
									Type: input.TypeNumber, Value: field.value, Readonly: !admin, Attributes: templ.Attributes{"min": "0", "step": "any"}})
							}
						}
					}
				}
			}
		}
		if admin {
			<div class="mt-4 flex justify-end">
				@button.Button(button.Props{ID: "control--rate-settings--save", Type: button.TypeSubmit}) {
					Save
				}
			</div>
		}
	</form>
}

// RateSettingsSaved is the rate limits as saved, the limiters' rates now, and a toast saying so
templ RateSettingsSaved(settings []config.RateSetting, stats []config.RateLimiterStats) {
	@RateSettings(settings, true)
	@RateLimitStats(stats, true)
	@successtoast.OOB("Rate limits saved")
}
