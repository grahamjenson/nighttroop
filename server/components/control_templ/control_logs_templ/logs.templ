package control_logs_templ

import (
	"context"

	"nighttroop.t1d.nz/data/db"
	dataevents "nighttroop.t1d.nz/data/events"
	"nighttroop.t1d.nz/server/components/filter"
	"nighttroop.t1d.nz/server/components/footer"
	"encoding/json"
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/apiutils/apiquery"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
)

func formatDate(ms int64) string {
	return time.UnixMilli(ms).Format("2006-01-02 15:04:05")
}

// orServer is the row's site, or that it is the server's own
func orServer(siteID *string) string {
	if siteID == nil {
		return "server"
	}
	return *siteID
}

// duration is how long an event took, or a dash when it happened at a moment
func duration(event *controlmodels.Event) string {
	if event.FinishedAt == nil {
		return "-"
	}
	return display.Duration(*event.FinishedAt - event.StartedAt)
}

// attributes are a row's attributes as JSON, indented to read
func attributes(raw json.RawMessage) string {
	indented, err := json.MarshalIndent(raw, "", "  ")
	if err != nil {
		return string(raw)
	}
	return string(indented)
}

// isAdmin is whether the control identity is an admin, who can download the logs DB
func isAdmin(ctx context.Context) bool {
	controlContext := httputils.GetControlContext(ctx)
	return controlContext != nil && controlContext.IdentityModel != nil && controlContext.IdentityModel.Role == consts.ControlRoleAdmin
}

// page heads a page of rows with its title and description, and for an admin a download of the whole logs DB, and
// pages it
templ page(id string, title string, description string, path string, pagePath string, count int, skip int64, limit int64) {
	<div id={ id } class="mx-auto max-w-5xl space-y-6">
		<div class="flex flex-wrap items-start justify-between gap-4">
			@heading.Page(title) {
				{ description }
			}
			if isAdmin(ctx) {
				@button.Button(button.Props{
					ID:         "control--logs-db--download",
					Href:       "/logs-db",
					Variant:    button.VariantOutline,
					Attributes: templ.Attributes{"download": "", "title": "A copy of the logs DB, with every site's events, errors and logs, as one SQLite file"},
				}) {
					Download Logs DB
				}
			}
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			{ children... }
			@pager.Pager(pager.Props{ID: "control-" + path, Path: pagePath, Count: count, Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

templ rowLink(id string, path string) {
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    path,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		{ children... }
	}
}

templ empty(columns string, what string) {
	<tr><td colspan={ columns } class="p-4 text-sm text-gray-500">No { what } here.</td></tr>
}

templ attributesDetail(id string, raw json.RawMessage) {
	if len(raw) > 0 {
		<pre id={ id } class="mt-4 max-h-64 overflow-auto whitespace-pre-wrap break-all rounded bg-gray-50 p-2 text-xs">{ attributes(raw) }</pre>
	}
}

var detail = modal.Detail

// ids are the site, request and job a page's rows can be narrowed to
func ids(q *apiquery.Query) []filter.ID {
	return []filter.ID{{Name: "site_id", Label: "Site ID", Value: q.SiteID}, {Name: "request_id", Label: "Request ID", Value: q.RequestID}, {Name: "job_id", Label: "Job ID", Value: q.JobID}}
}

// idDetail is a row's request or job, when it has one, linking to the page's rows with it
templ idDetail(id string, label string, path string, name string, value *string) {
	if value != nil {
		{{ link := filter.PagePath(path, nil, nil, filter.ID{Name: name, Value: value}) }}
		<dt class="text-gray-500">{ label }</dt>
		<dd class="break-all">
			<a id={ id } href={ templ.SafeURL(link) } hx-get={ link } hx-target="#main-content" hx-push-url="true" hx-swap="innerHTML" class="text-primary underline">{ *value }</a>
		</dd>
	}
}

// idDetails are a row's request and job, each linking to the rows of path with it
templ idDetails(id string, path string, requestID *string, jobID *string) {
	@idDetail(id+"--request-id", "Request", path, "request_id", requestID)
	@idDetail(id+"--job-id", "Job", path, "job_id", jobID)
}

// EventsTable shows one page of events, the newest first
templ EventsTable(events []*controlmodels.Event, q *apiquery.Query) {
	// Sign ins are from where DB-IP estimates
	@footer.DBIPCredit()
	@page("events_table", "Events", "What happened to each site and the server, newest first. Click an event to see its details.", "/events", filter.PagePath("/events", q.Type, q.Search, ids(q)...), len(events), q.Skip, q.Limit) {
		@filter.Filter(filter.Props{ID: "control--events--filter", Path: "/events", All: "All events", Types: dataevents.PersistedNames(), Selected: q.Type, Search: q.Search, IDs: ids(q)})
		@EventsList("controlEventsTable", events)
	}
}

// EventsList is a table of events, newest first, each opening its details
templ EventsList(id string, events []*controlmodels.Event) {
	@table.Table(table.Props{ID: id, Class: "rounded-lg border border-gray-200"}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Event
				}
				@table.Head() {
					Site
				}
				@table.Head() {
					Started
				}
				@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
					Duration
				}
			}
		}
		@table.Body() {
			if len(events) == 0 {
				@empty("4", "events")
			}
			for _, event := range events {
				@rowLink(fmt.Sprintf("control--event--%d", event.ID), fmt.Sprintf("/events/%d", event.ID)) {
					@table.Cell() {
						{ display.Name(event.Name) }
					}
					@table.Cell() {
						{ orServer(event.SiteID) }
					}
					@table.Cell() {
						<span title={ formatDate(event.StartedAt) }>{ display.Ago(&event.StartedAt, time.Now()) }</span>
					}
					@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
						{ duration(event) }
					}
				}
			}
		}
	}
}

templ EventModal(event *controlmodels.Event) {
	// Sign ins are from where DB-IP estimates
	@footer.DBIPCredit()
	@modal.Modal(modal.Props{ID: "control--event--details", Title: display.Name(event.Name), Subtitle: formatDate(event.StartedAt)}) {
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@detail("Site", orServer(event.SiteID))
			@detail("Started", formatDate(event.StartedAt))
			if event.FinishedAt != nil {
				@detail("Finished", formatDate(*event.FinishedAt))
			}
			@detail("Duration", duration(event))
			@idDetails("control--event", "/events", event.RequestID, event.JobID)
		</dl>
		@attributesDetail("control--event--attributes", event.Attributes)
	}
}

// ErrorsTable shows one page of errors, the newest first
templ ErrorsTable(errors []*controlmodels.Error, q *apiquery.Query) {
	@page("errors_table", "Errors", "What failed for each site and the server, newest first. Click an error to see its details.", "/errors", filter.PagePath("/errors", q.Type, q.Search, ids(q)...), len(errors), q.Skip, q.Limit) {
		@filter.Filter(filter.Props{ID: "control--errors--filter", Path: "/errors", All: "All errors", Types: db.ErrorKinds, Selected: q.Type, Search: q.Search, IDs: ids(q)})
		@ErrorsList("controlErrorsTable", errors)
	}
}

// ErrorsList is a table of errors, newest first, each opening its details
templ ErrorsList(id string, errors []*controlmodels.Error) {
	@table.Table(table.Props{ID: id, Class: "rounded-lg border border-gray-200"}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Error
				}
				@table.Head() {
					Site
				}
				@table.Head() {
					When
				}
			}
		}
		@table.Body() {
			if len(errors) == 0 {
				@empty("3", "errors")
			}
			for _, e := range errors {
				@rowLink(fmt.Sprintf("control--error--%d", e.ID), fmt.Sprintf("/errors/%d", e.ID)) {
					@table.Cell() {
						<span class="block max-w-md truncate text-red-700">{ e.Message }</span>
					}
					@table.Cell() {
						{ orServer(e.SiteID) }
					}
					@table.Cell() {
						<span title={ formatDate(e.CreatedAt) }>{ display.Ago(&e.CreatedAt, time.Now()) }</span>
					}
				}
			}
		}
	}
}

templ ErrorModal(e *controlmodels.Error) {
	@modal.Modal(modal.Props{ID: "control--error--details", Title: "Error", Subtitle: formatDate(e.CreatedAt)}) {
		<p class="mt-2 break-all text-sm text-red-700">{ e.Message }</p>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@detail("Site", orServer(e.SiteID))
			@idDetails("control--error", "/errors", e.RequestID, e.JobID)
		</dl>
		@attributesDetail("control--error--attributes", e.Attributes)
	}
}

// LogsTable shows one page of logs, the newest first
templ LogsTable(logs []*controlmodels.Log, q *apiquery.Query) {
	@page("logs_table", "Logs", "Messages logged for each site and the server, newest first. Click a log to see its details.", "/logs", filter.PagePath("/logs", nil, q.Search, ids(q)...), len(logs), q.Skip, q.Limit) {
		@filter.Filter(filter.Props{ID: "control--logs--filter", Path: "/logs", Search: q.Search, IDs: ids(q)})
		@table.Table(table.Props{ID: "controlLogsTable", Class: "rounded-lg border border-gray-200"}) {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Level
					}
					@table.Head() {
						Message
					}
					@table.Head() {
						Site
					}
					@table.Head() {
						When
					}
				}
			}
			@table.Body() {
				if len(logs) == 0 {
					@empty("4", "logs")
				}
				for _, log := range logs {
					@rowLink(fmt.Sprintf("control--log--%d", log.ID), fmt.Sprintf("/logs/%d", log.ID)) {
						@table.Cell() {
							{ log.Level }
						}
						@table.Cell() {
							<span class="block max-w-md truncate">{ log.Message }</span>
						}
						@table.Cell() {
							{ orServer(log.SiteID) }
						}
						@table.Cell() {
							<span title={ formatDate(log.CreatedAt) }>{ display.Ago(&log.CreatedAt, time.Now()) }</span>
						}
					}
				}
			}
		}
	}
}

templ LogModal(log *controlmodels.Log) {
	@modal.Modal(modal.Props{ID: "control--log--details", Title: log.Level, Subtitle: formatDate(log.CreatedAt)}) {
		<p class="mt-2 break-all text-sm">{ log.Message }</p>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@detail("Site", orServer(log.SiteID))
			@idDetails("control--log", "/logs", log.RequestID, log.JobID)
		</dl>
		@attributesDetail("control--log--attributes", log.Attributes)
	}
}
