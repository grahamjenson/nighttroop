package control_dashboard_templ

import (
	"nighttroop.t1d.nz/server/components/control_templ"
	"nighttroop.t1d.nz/utils/httputils"
)

templ Dashboard(controlContext *httputils.ControlContext) {
	@control_templ.ControlBase() {
		<div class="text-center">
			<h1 class="text-4xl font-bold mb-4">Welcome to the NightTroop Control Dashboard</h1>
			<p class="text-lg text-gray-600">Use the navigation above to manage your account and users.</p>
		</div>
	}
}
