package control_job_stats_templ

import (
	"context"
	"fmt"
	"math"
	"strings"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/control_templ/control_jobs_templ"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

// dayQueueJob splits the stats' YYYY-MM-DD::queue::job key into its parts
func dayQueueJob(stats *controlmodels.JobStatsDaily) (string, string, string) {
	parts := strings.SplitN(stats.DayQueueJob, "::", 3)
	for len(parts) < 3 {
		parts = append(parts, "-")
	}
	return parts[0], parts[1], parts[2]
}

// meanDuration is the jobs' mean time from being fetched to finishing
func meanDuration(ctx context.Context, stats *controlmodels.JobStatsDaily) string {
	if stats.TotalJobs == 0 {
		return "-"
	}
	return display.Duration(ctx, int64(math.Round(stats.DurationSum / float64(stats.TotalJobs))))
}

// stdDevDuration is how much the jobs' durations spread around their mean
func stdDevDuration(ctx context.Context, stats *controlmodels.JobStatsDaily) string {
	if stats.TotalJobs == 0 {
		return "-"
	}
	n := float64(stats.TotalJobs)
	mean := stats.DurationSum / n
	return display.Duration(ctx, int64(math.Round(math.Sqrt(max(stats.DurationSquaredSum/n-mean*mean, 0)))))
}

// JobStatsTable shows one page of daily job totals, newest day first, with buttons to the pages either side
templ JobStatsTable(stats []*controlmodels.JobStatsDaily, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "job_stats_table",
		Title:       i18n.T(ctx, "control.job_stats.title"),
		Description: i18n.T(ctx, "control.job_stats.intro"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:     "controlJobStatsTable",
			Static: true,
			Rows:   len(stats),
			Empty:  i18n.T(ctx, "control.job_stats.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "control.job_stats.day")}, {Label: i18n.T(ctx, "control.job_stats.queue")}, {Label: i18n.T(ctx, "control.job_stats.job")}, {Label: i18n.T(ctx, "control.job_stats.jobs"), Numeric: true},
				{Label: i18n.T(ctx, "control.job_stats.succeeded"), Numeric: true}, {Label: i18n.T(ctx, "control.job_stats.failed"), Numeric: true},
				{Label: i18n.T(ctx, "control.job_stats.mean_duration"), Numeric: true},
			},
		},
		Pager: &pager.Props{ID: "control--job-stats", Path: "/job-stats", Count: len(stats), Skip: skip, Limit: limit},
	}) {
		for _, s := range stats {
			@jobStatsRow(s)
		}
	}
}

templ jobStatsRow(stats *controlmodels.JobStatsDaily) {
	{{ day, queue, job := dayQueueJob(stats) }}
	@table.ModalRow("", "/job-stats/"+stats.DayQueueJob) {
		@table.Cell() {
			{ day }
		}
		@table.Cell() {
			{ queue }
		}
		@table.Cell() {
			{ job }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(stats.TotalJobs) }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(stats.TotalSuccess) }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(stats.TotalFailed) }
		}
		@table.Cell(table.NumCell) {
			{ meanDuration(ctx, stats) }
		}
	}
}

// JobStatsModal shows a day's totals for a job, the distinct errors its failures had, and links to the logs of its last
// failed runs
templ JobStatsModal(stats *controlmodels.JobStatsDaily) {
	{{ day, queue, job := dayQueueJob(stats) }}
	@modal.Modal(modal.Props{ID: "control--job-stats--details", Title: queue + " / " + job}) {
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@modal.Detail(i18n.T(ctx, "control.job_stats.day"), day)
			@modal.Detail(i18n.T(ctx, "control.job_stats.jobs"), fmt.Sprint(stats.TotalJobs))
			@modal.Detail(i18n.T(ctx, "control.job_stats.succeeded"), fmt.Sprint(stats.TotalSuccess))
			@modal.Detail(i18n.T(ctx, "control.job_stats.failed"), fmt.Sprint(stats.TotalFailed))
			@modal.Detail(i18n.T(ctx, "control.job_stats.mean_duration"), meanDuration(ctx, stats))
			@modal.Detail(i18n.T(ctx, "control.job_stats.std_dev_duration"), stdDevDuration(ctx, stats))
			@modal.Detail(i18n.T(ctx, "control.job_stats.updated"), display.DateTime(&stats.UpdatedAt))
		</dl>
		<h3 class="mt-4 text-sm font-semibold">{ i18n.T(ctx, "control.job_stats.errors") }</h3>
		if len(stats.Errors) == 0 {
			<p class="mt-1 text-sm text-gray-500">{ i18n.T(ctx, "control.job_stats.no_errors") }</p>
		} else {
			<ul id="control--job-stats--errors" class="mt-1 max-h-48 list-disc space-y-1 overflow-y-auto pl-5 text-sm text-red-700">
				for _, e := range stats.Errors {
					<li class="break-all">{ e }</li>
				}
			</ul>
		}
		if len(stats.FailedRunIDs) > 0 {
			<h3 class="mt-4 text-sm font-semibold">{ i18n.T(ctx, "control.job_stats.failed_runs") }</h3>
			<p class="mt-1 text-xs text-gray-500">{ i18n.T(ctx, "control.job_stats.failed_runs_note") }</p>
			<ul id="control--job-stats--failed-runs" class="mt-1 max-h-48 list-disc space-y-1 overflow-y-auto pl-5 text-sm">
				for i := range stats.FailedRunIDs {
					<li>
						@control_jobs_templ.RunLogsLink(fmt.Sprintf("control--job-stats--failed-run--%d", i), stats.FailedRunIDs[len(stats.FailedRunIDs)-1-i])
					</li>
				}
			</ul>
		}
	}
}
