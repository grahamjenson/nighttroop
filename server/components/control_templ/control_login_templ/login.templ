package control_login_templ

import (
	"nighttroop.t1d.nz/server/components/control_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
)

templ Login() {
	@control_templ.ControlBase() {
		// Its height is the form's, not the window's, so with the header and footer the page needs no scrolling
		<div class="flex flex-col justify-center items-center px-6 py-6 lg:px-8">
			<div class="p-8 login-form-target rounded-lg shadow-2xl w-full max-w-96">
				<!-- Form updated with POST method -->
				<form
					hx-post="/login"
					hx-target="closest .login-form-target"
					hx-swap="outerHTML"
					hx-status:4xx="target:#error-container"
					hx-status:5xx="target:#error-container"
				>
					<div class="text-center mb-6">
						<img src="/logo.svg" alt="" class="mx-auto mb-3 size-16"/>
						<h2 class="font-bold text-2xl">NightTroop Login</h2>
					</div>
					<!-- Username -->
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{
							For: "name",
						}) {
							Name
						}
						@input.Input(input.Props{
							ID:          "name",
							Type:        "text",
							Name:        "name",
							Placeholder: "admin",
							Required:    true,
							Attributes:  templ.Attributes{"autocomplete": "username", "autocapitalize": "none"},
						})
					}
					<div class="mt-4"></div>
					<!-- Password -->
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{
							For: "password",
						}) {
							Password
						}
						@input.Input(input.Props{
							ID:          "password",
							Type:        "password",
							Name:        "password",
							Placeholder: "••••••••",
							Required:    true,
							Attributes:  templ.Attributes{"autocomplete": "current-password"},
						})
					}
					<div class="mt-4"></div>
					@form.Item() {
						@form.Label(form.LabelProps{
							For: "otp-form",
						}) {
							Verification Code
						}
						@inputotp.InputOTP(inputotp.Props{
							ID:       "otp-form",
							HasError: true,
							Form:     "otp",
							Name:     "totp",
						}) {
							@inputotp.Group() {
								@inputotp.Slot(inputotp.SlotProps{
									Index:   0,
									InputID: "control--login--otp-1",
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 1,
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 2,
								})
								@inputotp.Separator()
								@inputotp.Slot(inputotp.SlotProps{
									Index: 3,
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 4,
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 5,
								})
							}
						}
						@form.Description() {
							Enter the 6-digit TOTP code
						}
					}
					<div class="mt-4"></div>
					<!-- Submit Button -->
					@button.Button(button.Props{
						ID:    "control--login-button",
						Type:  button.TypeSubmit,
						Class: "w-full py-3 px-4 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg shadow-sm transition-colors cursor-pointer",
					}) {
						Log In
					}
				</form>
			</div>
		</div>
	}
}
