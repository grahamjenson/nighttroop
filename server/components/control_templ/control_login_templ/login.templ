package control_login_templ

import (
	"nighttroop.t1d.nz/server/components/site_templ/site_login_templ"
	"nighttroop.t1d.nz/server/components/control_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/toast"
)

templ Login() {
	@control_templ.ControlBase() {
		// Its height is the form's, not the window's, so with the header and footer the page needs no scrolling
		<div class="flex flex-col justify-center items-center px-6 py-6 lg:px-8">
			<div class="p-8 login-form-target rounded-lg shadow-2xl w-full max-w-96">
				<!-- Form updated with POST method -->
				<form
					id="otp"
					hx-post="/login"
					hx-target="closest .login-form-target"
					hx-swap="outerHTML"
					hx-status:4xx="target:#toaster swap:beforeend"
					hx-status:5xx="target:#toaster swap:beforeend"
				>
					<div class="text-center mb-6">
						<img src="/logo.svg" alt="" class="mx-auto mb-3 size-16"/>
						<h2 class="font-bold text-2xl">Nighttroop Login</h2>
					</div>
					<!-- Username -->
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{
							For: "control--login--name",
						}) {
							Name
						}
						@input.Input(input.Props{
							ID:         "control--login--name",
							Type:       "text",
							Name:       "name",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "username", "autocapitalize": "none"},
						})
					}
					<div class="mt-4"></div>
					<!-- Password -->
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{
							For: "control--login--password",
						}) {
							Password
						}
						@input.Input(input.Props{
							ID:         "control--login--password",
							Type:       "password",
							Name:       "password",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "current-password"},
						})
					}
					<div class="mt-4"></div>
					@form.Item() {
						@form.Label(form.LabelProps{
							For: "control--login--otp",
						}) {
							Verification Code
						}
						@inputotp.InputOTP(inputotp.Props{
							ID:   "control--login--otp",
							Form: "otp",
							Name: "totp",
						}) {
							@inputotp.Group() {
								@inputotp.Slot(inputotp.SlotProps{
									Index:   0,
									InputID: "control--login--otp-1",
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 1,
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 2,
								})
								@inputotp.Separator()
								@inputotp.Slot(inputotp.SlotProps{
									Index: 3,
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 4,
								})
								@inputotp.Slot(inputotp.SlotProps{
									Index: 5,
								})
							}
						}
						@form.Description() {
							Enter the 6-digit TOTP code
						}
					}
					<div class="mt-4"></div>
					<!-- Submit Button -->
					@button.Button(button.Props{
						ID:    "control--login-button",
						Type:  button.TypeSubmit,
						Class: "w-full py-3 px-4 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg shadow-sm transition-colors cursor-pointer",
					}) {
						Log in
					}
				</form>
				@site_login_templ.PasskeyLogin("control--login")
				<script>
					// Logs in as soon as the code's last digit is typed or pasted, once the name and password are in. It
					// waits a tick for the code's slots to fill its value, and does not send the same code twice, so a
					// wrong code is not sent again on its own. After a failed attempt its inputs are marked invalid, until
					// it is sent again.
					(function () {
						const form = document.getElementById("otp");
						const code = document.getElementById("control--login--otp");
						const filled = (id) => document.getElementById(id).value !== "";
						let sent = "";
						const sendWhenFull = () => setTimeout(() => {
							if (/^\d{6}$/.test(code.value) && code.value !== sent && filled("control--login--name") && filled("control--login--password")) {
								sent = code.value;
								form.requestSubmit();
							}
						}, 0);
						// Only the code's own slots, so typing the name or password does not send it
						const slots = document.getElementById("control--login--otp-container");
						slots.addEventListener("input", sendWhenFull);
						slots.addEventListener("paste", sendWhenFull);
						const invalid = (failed) => form.querySelectorAll("input:not([type=hidden])").forEach((input) =>
							failed ? input.setAttribute("aria-invalid", "true") : input.removeAttribute("aria-invalid"));
						form.addEventListener("htmx:response:error", () => invalid(true));
						form.addEventListener("htmx:before:request", () => invalid(false));
					})();
				</script>
			</div>
		</div>
	}
}

// LoginError is a failed login's toast, saying why without saying how far the login got
templ LoginError(message string) {
	@toast.Toast(toast.Props{
		Description: message,
		Variant:     toast.VariantError,
		Position:    toast.PositionTopCenter,
		Dismissible: true,
		Icon:        true,
	})
}
