package control_sites_templ

import (
	"context"
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/site_templ/site_settings_templ"
	"nighttroop.t1d.nz/server/components/ui/alert"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// SiteIdentities is a site's identities, with buttons for an admin to reset one's password, or its TOTP when it logs in
// with one, or sign in to the site as it. The new credentials are shown above the table, once.
templ SiteIdentities(siteID string, identities []*controlmodels.SiteIdentity) {
	<div id="control--site--identities--reset"></div>
	@table.Table(table.Props{ID: "control--site--identities--table", Class: "rounded-lg border border-gray-200 text-sm"}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					{ i18n.T(ctx, "control.site_identities.name") }
				}
				// On a phone only the name, with the rest under it, and the actions fit beside each other
				@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
					{ i18n.T(ctx, "control.site_identities.role") }
				}
				@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
					{ i18n.T(ctx, "control.site_identities.enabled") }
				}
				@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
					{ i18n.T(ctx, "control.site_identities.totp") }
				}
				@table.Head(table.HeadProps{Class: "hidden sm:table-cell"}) {
					{ i18n.T(ctx, "control.site_identities.last_seen") }
				}
				if httputils.IsControlAdmin(ctx) {
					@table.Head() {
						{ i18n.T(ctx, "control.site_identities.actions") }
					}
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@table.Row(table.RowProps{ID: fmt.Sprintf("control--site--identity--%d", identity.ID)}) {
					@table.Cell() {
						<span title={ i18n.T(ctx, "control.site_identities.created_by", i18n.Data{"CreatedAt": display.DateTime(&identity.CreatedAt), "CreatorName": identity.CreatedByIdentityName}) }>{ identity.Name }</span>
						<div id={ fmt.Sprintf("control--site--identity--%d--summary", identity.ID) } class="mt-0.5 text-xs text-gray-500 sm:hidden">{ identitySummary(ctx, identity) }</div>
					}
					@table.Cell(table.CellProps{Class: "hidden sm:table-cell"}) {
						{ site_settings_templ.RoleLabel(ctx, string(identity.Role)) }
					}
					@table.Cell(table.CellProps{Class: "hidden sm:table-cell"}) {
						{ yesNo(ctx, identity.Enabled) }
					}
					@table.Cell(table.CellProps{Class: "hidden sm:table-cell"}) {
						{ yesNo(ctx, identity.HasTotp) }
					}
					@table.Cell(table.CellProps{Class: "hidden sm:table-cell"}) {
						<span title={ display.DateTime(identity.LastSeenAt) }>{ display.Ago(ctx, identity.LastSeenAt, time.Now()) }</span>
					}
					if httputils.IsControlAdmin(ctx) {
						@table.Cell() {
							// Each action has its own column, so the same action lines up down the table; on a phone they stack
							<div class="grid gap-1 sm:grid-cols-3">
								@resetButton(siteID, identity, "password", i18n.T(ctx, "control.site_identities.reset_password"), i18n.T(ctx, "control.site_identities.reset_password_confirm", i18n.Data{"IdentityName": identity.Name}))
								if identity.HasTotp {
									@resetButton(siteID, identity, "totp", i18n.T(ctx, "control.site_identities.reset_totp"), i18n.T(ctx, "control.site_identities.reset_totp_confirm", i18n.Data{"IdentityName": identity.Name}))
								} else {
									<span></span>
								}
								@assumeButton(siteID, identity)
							</div>
						}
					}
				}
			}
		}
	}
}

func yesNo(ctx context.Context, yes bool) string {
	if yes {
		return i18n.T(ctx, "control.site_identities.answer_yes")
	}
	return i18n.T(ctx, "control.site_identities.answer_no")
}

// resetButton resets what of an identity, its password or totp, after asking to confirm
templ resetButton(siteID string, identity *controlmodels.SiteIdentity, what string, label string, confirm string) {
	<form
		hx-post={ fmt.Sprintf("/sites/%s/identities/%d/%s", siteID, identity.ID, what) }
		hx-target="#control--site--identities--reset"
		hx-swap="innerHTML"
		hx-confirm={ confirm }
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		@button.Button(button.Props{ID: fmt.Sprintf("control--site--identity--%d--reset-%s", identity.ID, what), Type: button.TypeSubmit,
			Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
			{ label }
		}
	</form>
}

// SiteIdentityReset shows an identity's new credentials after a reset, which are shown only this once
templ SiteIdentityReset(credentials *controlmodels.SiteIdentityCredentials) {
	@alert.Alert(alert.Props{ID: "control--site--identity-reset", Variant: alert.VariantWarning, Class: "mt-2",
		Title: i18n.T(ctx, "control.site_identities.new_credentials", i18n.Data{"IdentityName": credentials.Name})}) {
		<dl class="mt-2 grid grid-cols-[8rem_1fr] gap-x-4 gap-y-1 font-mono text-gray-900">
			if credentials.Password != nil {
				@modal.Detail(i18n.T(ctx, "control.site_identities.password"), *credentials.Password)
			}
			if credentials.NSToken != nil {
				@modal.Detail(i18n.T(ctx, "control.site_identities.ns_token"), *credentials.NSToken)
			}
			if credentials.TotpSecret != nil {
				@modal.Detail(i18n.T(ctx, "control.site_identities.totp_secret"), *credentials.TotpSecret)
			}
		</dl>
	}
}

// assumeButton signs the admin in to the site as an identity, after asking to confirm, in a new tab: control sends the
// tab on to a link to the site, good once and for a minute, which signs it in
templ assumeButton(siteID string, identity *controlmodels.SiteIdentity) {
	<form
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/sites/%s/identities/%d/assume", siteID, identity.ID)) }
		target="_blank"
		data-confirm={ i18n.T(ctx, "control.site_identities.assume_confirm", i18n.Data{"IdentityName": identity.Name}) }
		onsubmit="return confirm(this.dataset.confirm);"
	>
		@button.Button(button.Props{ID: fmt.Sprintf("control--site--identity--%d--assume", identity.ID), Type: button.TypeSubmit,
			Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
			{ i18n.T(ctx, "control.site_identities.assume") }
		}
	</form>
}

// identitySummary is what a phone shows of an identity under its name, for the columns it has no room for: its role,
// whether it is enabled and has TOTP, and when it was last seen
func identitySummary(ctx context.Context, identity *controlmodels.SiteIdentity) string {
	summary := site_settings_templ.RoleLabel(ctx, string(identity.Role))
	if !identity.Enabled {
		summary += " · " + i18n.T(ctx, "control.site_identities.summary_disabled")
	}
	if identity.HasTotp {
		summary += " · " + i18n.T(ctx, "control.site_identities.totp")
	}
	if identity.LastSeenAt != nil && *identity.LastSeenAt != 0 {
		seen := display.Ago(ctx, identity.LastSeenAt, time.Now())
		return summary + " · " + i18n.T(ctx, "control.site_identities.summary_seen", i18n.Data{"SeenAgo": seen})
	}
	return summary + " · " + i18n.T(ctx, "control.site_identities.summary_never_seen")
}
