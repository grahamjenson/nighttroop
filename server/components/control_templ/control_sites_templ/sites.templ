package control_sites_templ

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/models/publicmodels"
	"nighttroop.t1d.nz/server/components/control_templ/control_logs_templ"
	"nighttroop.t1d.nz/server/components/footer"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/public_templ"
	"nighttroop.t1d.nz/server/components/stat"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
)

// inactive is whether a live site has not been written to or seen in the configured days, so it can be disabled
func inactive(ctx context.Context, site *controlmodels.Site) bool {
	controlContext := httputils.GetControlContext(ctx)
	if site.State != "live" || controlContext == nil || controlContext.ControlDB == nil {
		return false
	}
	return site.Inactive(controlContext.ControlDB.ServerConfig.DisableAfterInactivityDays, time.Now())
}

// isAdmin is whether the control identity is an admin, who can create sites
func isAdmin(ctx context.Context) bool {
	controlContext := httputils.GetControlContext(ctx)
	return controlContext != nil && controlContext.IdentityModel != nil && controlContext.IdentityModel.Role == consts.ControlRoleAdmin
}

// formatDate shows an optional time in ms, or a dash when it is not set
func formatDate(ms *int64) string {
	if ms == nil {
		return "-"
	}
	return time.UnixMilli(*ms).Format("2006-01-02 15:04:05")
}

// siteOrders are the ways the sites can be ordered, by their order query value
var siteOrders = []struct{ order, label string }{
	{"", "Newest"},
	{"last_write", "Longest Since Written"},
	{"db_size", "Largest DB"},
}

// SitesTable shows one page of sites in order, newest first by default, with buttons to reorder them and to the
// pages either side
templ SitesTable(sites []*controlmodels.Site, skip int64, limit int64, order string) {
	<div id="sites_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Sites") {
			Every site. Click a site to open its page.
		}
		if isAdmin(ctx) {
			<div class="grid gap-4 md:grid-cols-2">
				@createSiteForm()
				@PublicSiteCreation(httputils.GetControlContext(ctx).ControlDB.PublicSiteCreation(ctx))
			</div>
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<div id="control--sites--order" class="mb-4 flex flex-wrap justify-end gap-2">
				for _, siteOrder := range siteOrders {
					@sitesPageButton("control--sites--order-"+orDefault(siteOrder.order), siteOrder.label, 0, limit, siteOrder.order, siteOrder.order != order)
				}
			</div>
			@table.Table(table.Props{ID: "controlSitesTable", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Site
						}
						@table.Head() {
							State
						}
						@table.Head() {
							Created
						}
						@table.Head() {
							Last Seen
						}
						@table.Head() {
							Last Write
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							DB Size (MB)
						}
					}
				}
				@table.Body() {
					if len(sites) == 0 {
						<tr><td colspan="6" class="p-4 text-sm text-gray-500">No sites here.</td></tr>
					}
					for _, site := range sites {
						@siteRow(site)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "control--sites", Path: "/sites?order=" + order, Count: len(sites), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// orDefault names the default order, which has no order query value
func orDefault(order string) string {
	if order == "" {
		return "created"
	}
	return order
}

// sitesPageButton goes to a page of the sites in an order, outlined unless it is the order shown
templ sitesPageButton(id string, label string, skip int64, limit int64, order string, outline bool) {
	{{ variant := button.VariantDefault }}
	if outline {
		{{ variant = button.VariantOutline }}
	}
	{{ path := fmt.Sprintf("/sites?skip=%d&limit=%d", skip, limit) }}
	if order != "" {
		{{ path += "&order=" + order }}
	}
	@button.Button(button.Props{
		ID:      id,
		Variant: variant,
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

// createSiteForm creates a site at an ID an admin picks, such as a vanity one for a special user: 8 lowercase
// letters, like every site's
templ createSiteForm() {
	<form
		id="control--sites--create"
		class="flex flex-col gap-3 rounded-xl border border-gray-200 p-4 shadow-sm"
		hx-post="/sites"
		hx-target="#modal-container"
		hx-swap="innerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		@actionTitle("Create a site", icon.Plus, "At an ID you pick, such as a vanity one, shown with its credentials once.")
		<div class="flex flex-wrap items-end gap-2">
			@field.Field("control--sites--create--id", fmt.Sprintf("New site ID (%d lowercase letters)", utils.SITE_ID_LENGTH), "w-full sm:w-64") {
				@input.Input(input.Props{
					ID:          "control--sites--create--id",
					Name:        "id",
					Placeholder: "mynewnts",
					Required:    true,
					Attributes: templ.Attributes{
						"pattern": fmt.Sprintf("[a-z]{%d}", utils.SITE_ID_LENGTH), "minlength": utils.SITE_ID_LENGTH, "maxlength": utils.SITE_ID_LENGTH,
						"title": fmt.Sprintf("%d lowercase letters, a to z", utils.SITE_ID_LENGTH), "autocomplete": "off", "spellcheck": "false",
						"autocapitalize": "none",
						// Capitals are lowered and anything but a to z is dropped as it is typed or pasted, so only letters
						// a site ID can have ever go in
						"oninput": templ.JSUnsafeFuncCall("this.value = this.value.toLowerCase().replace(/[^a-z]/g, '')"),
					},
				})
			}
			@button.Button(button.Props{ID: "control--sites--create--submit", Type: button.TypeSubmit}) {
				Create Site
			}
		</div>
	</form>
}

// PublicSiteCreation says whether the public can create sites from the home page, with a button to turn it the other
// way. An admin can create sites here either way.
templ PublicSiteCreation(on bool) {
	<form
		id="control--sites--public-creation"
		class="flex flex-col gap-3 rounded-xl border border-gray-200 p-4 shadow-sm"
		hx-post="/settings"
		hx-swap="outerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		<input type="hidden" name="public_site_creation" value={ strconv.FormatBool(!on) }/>
		@actionTitle("Public site creation", icon.Globe, "")
		<p id="control--sites--public-creation--state" class="flex-1 text-sm text-gray-500">
			if on {
				The public can create sites from the home page.
			} else {
				Public site creation is off: the home page cannot create sites, but an admin can create them here.
			}
		</p>
		@button.Button(button.Props{ID: "control--sites--public-creation--toggle", Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "w-fit"}) {
			if on {
				Turn Off Public Site Creation
			} else {
				Turn On Public Site Creation
			}
		}
	</form>
}

// PublicSiteCreationChanged replaces the public site creation switch, with a toast saying which way it was turned
templ PublicSiteCreationChanged(on bool) {
	@PublicSiteCreation(on)
	<div hx-swap-oob="beforeend:#toaster">
		@toast.Toast(toast.Props{
			Title:       "Success",
			Description: map[bool]string{true: "Public site creation turned on", false: "Public site creation turned off"}[on],
			Variant:     toast.VariantSuccess,
			Position:    toast.PositionTopCenter,
			Duration:    5000,
			Dismissible: true,
			Icon:        true,
		})
	</div>
}

// SiteCreated shows a site an admin created, with its credentials, which are shown only this once
templ SiteCreated(info publicmodels.NewSiteInfo) {
	@modal.Modal(modal.Props{ID: "control--site--created", Title: "Site Created", Subtitle: info.URL}) {
		@public_templ.CreateSiteInfo(info)
	}
}

// SiteNotCreated is a toast saying why a site could not be created, such as its ID being taken
templ SiteNotCreated(message string) {
	@toast.Toast(toast.Props{Title: "Site Not Created", Description: message, Variant: toast.VariantError, Position: toast.PositionTopCenter,
		Dismissible: true, Icon: true})
}

templ siteRow(site *controlmodels.Site) {
	@table.Row(table.RowProps{
		ID:    "control--site--" + site.ID,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":      "/sites/" + site.ID,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		@table.Cell() {
			{ site.ID }
		}
		@table.Cell() {
			{ display.Name(site.State) }
			if inactive(ctx, site) {
				<span id={ "control--site--" + site.ID + "--inactive" } class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">inactive</span>
			}
		}
		@table.Cell() {
			{ formatDate(&site.CreatedAt) }
		}
		@table.Cell() {
			<span title={ formatDate(site.LastSeenAt) }>{ display.Ago(site.LastSeenAt, time.Now()) }</span>
		}
		@table.Cell() {
			<span title={ formatDate(site.LastWriteAt) }>{ display.Ago(site.LastWriteAt, time.Now()) }</span>
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ sizeMB(site.EstimatedDbSizeKb) }
			if site.Oversized() {
				<span class="ml-2 rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800">over limit</span>
			}
		}
	}
}

// stateClasses colour a site's state badge: live in the theme's colour, disabled as a warning, and gone grey
var stateClasses = map[string]string{"live": "bg-primary/10 text-primary", "disabled": "bg-amber-100 text-amber-800"}

func stateClass(state string) string {
	if class, ok := stateClasses[state]; ok {
		return class
	}
	return "bg-gray-100 text-gray-700"
}

// lifecycle is when the site was made, its batch, and when it was disabled, archived or deleted, if it was
func lifecycle(site *controlmodels.Site) string {
	text := "Created " + formatDate(&site.CreatedAt) + " · Batch " + site.Batch
	for _, at := range []struct {
		what string
		ms   *int64
	}{{"Disabled", site.DisabledAt}, {"Archived", site.ArchivedAt}, {"Deleted", site.DeletedAt}} {
		if at.ms != nil {
			text += " · " + at.what + " " + formatDate(at.ms)
		}
	}
	return text
}

// usedPercent is how much of its DB size limit the site uses, when both are known
func usedPercent(site *controlmodels.Site) (int64, bool) {
	if site.EstimatedDbSizeKb == nil || site.MaxDbSizeKbLimit == nil || *site.MaxDbSizeKbLimit <= 0 {
		return 0, false
	}
	return *site.EstimatedDbSizeKb * 100 / *site.MaxDbSizeKbLimit, true
}

// usedClass colours how much of its limit a site uses, by the icon beside it: red over the limit, amber nearing it
func usedClass(percent int64) string {
	switch {
	case percent > 100:
		return "text-red-600"
	case percent >= 80:
		return "text-amber-800"
	}
	return "text-gray-500"
}

// dbPart is a share of a site's DB: one of its largest tables, or the rest of them together, with its colour
type dbPart struct {
	Name    string
	Bytes   int64
	Percent float64
	Class   string
}

// partClasses shade the largest tables darkest, one hue so the key reads by name, not by colour alone
var partClasses = []string{"bg-brand-night", "bg-brand-night/75", "bg-brand-night/55", "bg-brand-night/40", "bg-brand-night/25"}

// dbParts are the largest tables of a site's DB, largest first, each with its share of the DB, and the rest of them
// together as Other
func dbParts(tables []*controlmodels.SiteTable) []dbPart {
	total, parts := totalBytes(tables), []dbPart{}
	if total <= 0 {
		return parts
	}
	share := func(name string, bytes int64, class string) dbPart {
		return dbPart{name, bytes, float64(bytes) * 100 / float64(total), class}
	}
	for i, table := range tables {
		if i == len(partClasses) {
			return append(parts, share("Other", totalBytes(tables[i:]), "bg-gray-300"))
		}
		parts = append(parts, share(table.Name, table.Bytes, partClasses[i]))
	}
	return parts
}

// measuredBy is the site with its DB's size from its tables when the resource check has not measured it yet
func measuredBy(site *controlmodels.Site, tables []*controlmodels.SiteTable) *controlmodels.Site {
	if site.EstimatedDbSizeKb != nil || len(tables) == 0 {
		return site
	}
	measured, kb := *site, totalBytes(tables)/1024
	measured.EstimatedDbSizeKb = &kb
	return &measured
}

// totalBytes are the bytes the tables take together
func totalBytes(tables []*controlmodels.SiteTable) int64 {
	total := int64(0)
	for _, table := range tables {
		total += table.Bytes
	}
	return total
}

// partText is a part's size and share of the DB, as "1.25 MB · 40%"
func partText(part dbPart) string {
	return fmt.Sprintf("%.2f MB · %.0f%%", float64(part.Bytes)/1024/1024, part.Percent)
}

// barWidth is how much of the bar the DB fills: its share of its limit, at most all of it, or all of it with no limit
func barWidth(site *controlmodels.Site) int64 {
	if percent, ok := usedPercent(site); ok {
		return min(percent, 100)
	}
	return 100
}

// ago is how long ago a time in ms was, or Never
func ago(ms *int64) string {
	return display.Ago(ms, time.Now())
}

// identityTypes are how many of the identities are people (admins and users) and how many devices
func identityTypes(identities []*controlmodels.SiteIdentity) string {
	devices := 0
	for _, identity := range identities {
		if identity.Role.GetType() == consts.IdentityTypeDevice {
			devices++
		}
	}
	people, peopleWord, devicesWord := len(identities)-devices, "people", "devices"
	if people == 1 {
		peopleWord = "person"
	}
	if devices == 1 {
		devicesWord = "device"
	}
	return fmt.Sprintf("%d %s, %d %s", people, peopleWord, devices, devicesWord)
}

// lastError is how long ago the site's latest error was, or None
func lastError(errors []*controlmodels.Error) string {
	if len(errors) == 0 {
		return "None"
	}
	return ago(&errors[0].CreatedAt)
}

// siteURL is the site's own address, to open it
func siteURL(ctx context.Context, siteID string) string {
	controlContext := httputils.GetControlContext(ctx)
	if controlContext == nil || controlContext.ControlDB == nil {
		return ""
	}
	return controlContext.ControlDB.ServerConfig.SiteURL(siteID)
}

// SitePage is a site's own page, laid out like a site's summary: its state and when it changed, a grid of what can be
// done to it, its DB size against its limit, tiles of when it was last used, its identities and its last
// error, then its identities, which an admin can reset or sign in to the site as, and its latest events and errors
templ SitePage(page *controlmodels.SitePage) {
	{{ site := page.Site }}
	@heading.Title(site.ID)
	<div id="control--site--page" class="mx-auto w-full max-w-5xl space-y-4 py-4">
		<div>
			<div class="flex flex-wrap items-center gap-2">
				<h1 class="font-mono text-2xl font-bold">{ site.ID }</h1>
				<span id="control--site--state" class={ "rounded-full px-2 py-0.5 text-xs font-medium", stateClass(site.State) }>{ display.Name(site.State) }</span>
				if inactive(ctx, site) {
					<span id="control--site--inactive" class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">Inactive</span>
				}
				if site.Oversized() {
					<span id="control--site--over-limit" class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">Over limit</span>
				}
			</div>
			<p id="control--site--lifecycle" class="mt-1 text-sm text-gray-500">{ lifecycle(site) }</p>
		</div>
		@siteActions(site)
		@dbSize(site, page.Tables)
		<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
			@stat.Tile("control--site--last-seen", "Last seen", ago(site.LastSeenAt), icon.Eye)
			@stat.Tile("control--site--last-write", "Last write", ago(site.LastWriteAt), icon.PenLine)
			@stat.Tile("control--site--identity-count", "Identities", fmt.Sprint(len(page.Identities)), icon.Users) {
				<div id="control--site--identity-types" class="text-xs text-gray-500">{ identityTypes(page.Identities) }</div>
			}
			@stat.Tile("control--site--last-error", "Last error", lastError(page.Errors), icon.TriangleAlert)
		</div>
		@stat.Section("Identities", "", "", "") {
			@SiteIdentities(site.ID, page.Identities)
		}
		<div class="grid gap-4 lg:grid-cols-2">
			@stat.Section("Latest Events", "control--site--events--all", "See all", "/events?site_id="+site.ID) {
				@control_logs_templ.EventsList("control--site--events--table", page.Events)
			}
			@stat.Section("Latest Errors", "control--site--errors--all", "See all", "/errors?site_id="+site.ID) {
				@control_logs_templ.ErrorsList("control--site--errors--table", page.Errors)
			}
		</div>
		<div id="modal-container"></div>
	</div>
}

// dbSize is the site's DB size, large, against its limit, with a bar of how much of the limit it uses, split by its
// largest tables, and a key of them under it. A DB the resource check has not measured yet is measured by its tables.
templ dbSize(site *controlmodels.Site, tables []*controlmodels.SiteTable) {
	{{ parts, site := dbParts(tables), measuredBy(site, tables) }}
	<div id="control--site--db" class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		<div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-gray-500">
			@icon.Database(icon.Props{Class: "size-4"})
			DB size
		</div>
		<div class="mt-1 flex flex-wrap items-baseline gap-2">
			if site.EstimatedDbSizeKb != nil {
				<span id="control--site--db-size" class="text-5xl font-extrabold tracking-tight tabular-nums">{ sizeMB(site.EstimatedDbSizeKb) }</span>
				<span class="text-lg text-gray-500">MB</span>
			} else {
				<span id="control--site--db-size" class="text-2xl font-bold text-gray-400">Not measured yet</span>
			}
			if site.MaxDbSizeKbLimit != nil {
				<span id="control--site--db-limit" class="text-sm text-gray-500">of its { sizeMB(site.MaxDbSizeKbLimit) } MB limit</span>
			}
		</div>
		{{ percent, measured := usedPercent(site) }}
		if measured || len(parts) > 0 {
			<div class="mt-4 h-3 w-full rounded-full bg-gray-100">
				<div id="control--site--db-used" class="flex h-full gap-[2px]" style={ fmt.Sprintf("width: %d%%", barWidth(site)) }>
					for i, part := range parts {
						<div id={ "control--site--db-part--" + part.Name } aria-label={ part.Name + ": " + partText(part) } class={ "group relative h-full min-w-[2px]", part.Class, templ.KV("rounded-l-full", i == 0), templ.KV("rounded-r-full", i == len(parts)-1) } style={ fmt.Sprintf("flex: %d 1 0%%", part.Bytes) }>
							// A tooltip naming the table shows over its part on hover, kept inside the bar at its ends
							<div id={ "control--site--db-part--" + part.Name + "--tooltip" } class={ "pointer-events-none absolute bottom-full z-10 mb-2 hidden whitespace-nowrap rounded-md border border-gray-200 bg-white px-2 py-1 text-xs text-gray-700 shadow-md group-hover:block", templ.KV("left-0", i == 0), templ.KV("right-0", i > 0 && i == len(parts)-1), templ.KV("left-1/2 -translate-x-1/2", i > 0 && i < len(parts)-1) }>
								<span class="font-mono font-semibold">{ part.Name }</span>
								<span class="tabular-nums text-gray-500">{ partText(part) }</span>
							</div>
						</div>
					}
					if len(parts) == 0 {
						<div class="h-full flex-1 rounded-full bg-brand-night"></div>
					}
				</div>
			</div>
		}
		if measured {
			<div id="control--site--db-percent" class={ "mt-1 flex items-center gap-1 text-xs", usedClass(percent) }>
				if percent >= 80 {
					@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
				}
				{ fmt.Sprintf("%d%% of its limit used", percent) }
			</div>
		} else if site.EstimatedDbSizeKb == nil {
			<div class="mt-1 text-xs text-gray-500">The resource check measures each site's DB</div>
		}
		if len(parts) > 0 {
			<ul id="control--site--db-tables" class="mt-4 gap-x-6 space-y-1 text-sm text-gray-700 sm:columns-2">
				for _, part := range parts {
					<li id={ "control--site--db-table--" + part.Name } class="flex break-inside-avoid items-center gap-2">
						<span class={ "size-3 shrink-0 rounded-sm", part.Class }></span>
						<span class="truncate font-mono text-xs">{ part.Name }</span>
						<span class="ml-auto shrink-0 text-xs tabular-nums text-gray-500">{ partText(part) }</span>
					</li>
				}
			</ul>
		}
	</div>
}

// siteActions are a grid of what can be done to the site, each saying what it does: open it, and for an admin, download
// a copy of its DB while it is here, disable it once no one has used it for a while, truncate it while it is over its
// DB size limit, and archive it once it is disabled. One that cannot be done yet says when it can, in place of its button.
templ siteActions(site *controlmodels.Site) {
	<section id="control--site--actions" class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500">Actions</h2>
		<div class="grid gap-3 sm:grid-cols-2">
			{{ url := siteURL(ctx, site.ID) }}
			@actionCard("control--site--action-open", "Open Site", "Opens the site in a new tab.", unless(url != "" && site.State == "live", "Only a live site is served."), icon.ExternalLink) {
				@footer.NewTabLink("control--site--open", url, "inline-flex w-full items-center justify-center gap-1.5 rounded-md border border-gray-200 bg-white px-3 py-2 text-sm font-medium shadow-sm hover:bg-gray-50") {
					Open Site
					@icon.ExternalLink(icon.Props{Class: "size-4"})
				}
			}
			if isAdmin(ctx) {
				@actionCard("control--site--action-download-db", "Download DB", "Downloads a copy of its DB as it is now, as one SQLite file. Its admins see that you did, in its events.",
					unless(site.State == "live" || site.State == "disabled", "Offered while its DB is here, before it is archived."), icon.Download) {
					@button.Button(button.Props{
						ID:         "control--site--download-db",
						Href:       "/sites/" + site.ID + "/db",
						Variant:    button.VariantOutline,
						Class:      "w-full",
						Attributes: templ.Attributes{"download": ""},
					}) {
						Download DB
					}
				}
				@actionCard("control--site--action-disable", "Disable", "Stops serving the site. Its data is kept.", unless(inactive(ctx, site), disableWhen(ctx, site)), icon.Ban) {
					@siteActionForm("/sites/"+site.ID, "disabled", "Disable this site? It will stop being served.", "control--site--disable", "Disable")
				}
				@actionCard("control--site--action-truncate", "Truncate", "Keeps the loop's predictions and debug output only on each device's newest status, as every 10 minutes, then shrinks its DB.", unless(site.Oversized(), "Offered while it is over its DB size limit."), icon.Scissors) {
					@siteActionForm("/sites/"+site.ID+"/truncate", "", "Truncate this site? Its older loop statuses lose their predictions and debug output, then its DB is shrunk.", "control--site--truncate", "Truncate")
				}
				@actionCard("control--site--action-archive", "Archive", "Uploads its data to S3 and deletes it here.", unless(site.State == "disabled", "Offered once it is disabled."), icon.Archive) {
					@siteActionForm("/sites/"+site.ID, "archived", "Archive this site? Its data is uploaded to S3 and deleted here.", "control--site--archive", "Archive")
				}
			}
		</div>
	</section>
}

// unless is why an action cannot be done, or nothing when it can
func unless(can bool, why string) string {
	if can {
		return ""
	}
	return why
}

// disableWhen is when a site that is not inactive could be disabled
func disableWhen(ctx context.Context, site *controlmodels.Site) string {
	controlContext := httputils.GetControlContext(ctx)
	if site.State == "disabled" {
		return "It is already disabled."
	}
	if site.State != "live" || controlContext == nil || controlContext.ControlDB == nil {
		return "Only a live site can be disabled."
	}
	return fmt.Sprintf("Offered once no one has used it for %d days.", controlContext.ControlDB.ServerConfig.DisableAfterInactivityDays)
}

// actionCard is one action: its name, what it does, and its button, or when it cannot be done, why not
templ actionCard(id, title, description, unavailable string, ic func(...icon.Props) templ.Component) {
	<div id={ id } class="flex flex-col gap-2 rounded-lg border border-gray-200 p-3">
		<div class="flex-1">
			@actionTitle(title, ic, description)
		</div>
		if unavailable != "" {
			<p class="text-xs text-gray-500">{ unavailable }</p>
		} else {
			{ children... }
		}
	</div>
}

// actionTitle names an action with its icon, and says what it does when there is more to say
templ actionTitle(title string, ic func(...icon.Props) templ.Component, description string) {
	<div>
		<div class="flex items-center gap-2 text-sm font-semibold text-gray-900">
			@ic(icon.Props{Class: "size-4"})
			{ title }
		</div>
		if description != "" {
			<p class="mt-1 text-sm text-gray-500">{ description }</p>
		}
	</div>
}

// siteActionForm posts an action on the site, after asking to confirm, setting its state when there is one to set
templ siteActionForm(path, state, confirm, id, label string) {
	<form
		hx-post={ path }
		hx-target="#main-content"
		hx-swap="innerHTML"
		hx-confirm={ confirm }
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		if state != "" {
			<input type="hidden" name="state" value={ state }/>
		}
		@button.Button(button.Props{ID: id, Type: button.TypeSubmit, Variant: button.VariantDestructive, Class: "w-full"}) {
			{ label }
		}
	</form>
}

var siteDetail = modal.Detail

// sizeMB is a size kept in KB as MB, to two places so a small site's is not 0, or - if it is not known
func sizeMB(kb *int64) string {
	if kb == nil {
		return "-"
	}
	return fmt.Sprintf("%.2f", float64(*kb)/1024)
}

// SiteUpdated shows the site's page again, with a toast saying it is disabled or archived
templ SiteUpdated(site *controlmodels.Site) {
	@siteChanged(site, map[string]string{"disabled": "Site Disabled", "archived": "Site Archived"}[site.State])
}

templ SiteTruncated(site *controlmodels.Site) {
	@siteChanged(site, "Site Truncated")
}

// siteChanged loads the site's page again, as it changed, with a toast saying how
templ siteChanged(site *controlmodels.Site, description string) {
	<div hx-get={ "/sites/" + site.ID } hx-trigger="load" hx-target="#main-content" hx-swap="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@toast.Toast(toast.Props{
			Title:       "Success",
			Description: description,
			Variant:     toast.VariantSuccess,
			Position:    toast.PositionTopCenter,
			Duration:    5000,
			Dismissible: true,
			Icon:        true,
		})
	</div>
}
