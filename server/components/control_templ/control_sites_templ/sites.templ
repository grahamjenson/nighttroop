package control_sites_templ

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/models/publicmodels"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/public_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
)

// inactive is whether a live site has not been written to or seen in the configured days, so it can be disabled
func inactive(ctx context.Context, site *controlmodels.Site) bool {
	controlContext := httputils.GetControlContext(ctx)
	if site.State != "live" || controlContext == nil || controlContext.ControlDB == nil {
		return false
	}
	return site.Inactive(controlContext.ControlDB.ServerConfig.DisableAfterInactivityDays, time.Now())
}

// isAdmin is whether the control identity is an admin, who can create sites
func isAdmin(ctx context.Context) bool {
	controlContext := httputils.GetControlContext(ctx)
	return controlContext != nil && controlContext.IdentityModel != nil && controlContext.IdentityModel.Role == consts.ControlRoleAdmin
}

// formatDate shows an optional time in ms, or a dash when it is not set
func formatDate(ms *int64) string {
	if ms == nil {
		return "-"
	}
	return time.UnixMilli(*ms).Format("2006-01-02 15:04:05")
}

// siteOrders are the ways the sites can be ordered, by their order query value
var siteOrders = []struct{ order, label string }{
	{"", "Newest"},
	{"last_write", "Longest Since Written"},
	{"db_size", "Largest DB"},
}

// SitesTable shows one page of sites in order, newest first by default, with buttons to reorder them and to the
// pages either side
templ SitesTable(sites []*controlmodels.Site, skip int64, limit int64, order string) {
	<div id="sites_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Sites") {
			Every site. Click a site to see its details.
		}
		if isAdmin(ctx) {
			@createSiteForm()
			@PublicSiteCreation(httputils.GetControlContext(ctx).ControlDB.PublicSiteCreation(ctx))
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<div id="control--sites--order" class="mb-4 flex flex-wrap justify-end gap-2">
				for _, siteOrder := range siteOrders {
					@sitesPageButton("control--sites--order-"+orDefault(siteOrder.order), siteOrder.label, 0, limit, siteOrder.order, siteOrder.order != order)
				}
			</div>
			@table.Table(table.Props{ID: "controlSitesTable", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Site
						}
						@table.Head() {
							State
						}
						@table.Head() {
							Created
						}
						@table.Head() {
							Last Seen
						}
						@table.Head() {
							Last Write
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							DB Size (MB)
						}
					}
				}
				@table.Body() {
					if len(sites) == 0 {
						<tr><td colspan="6" class="p-4 text-sm text-gray-500">No sites here.</td></tr>
					}
					for _, site := range sites {
						@siteRow(site)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "control--sites", Path: "/sites?order=" + order, Count: len(sites), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// orDefault names the default order, which has no order query value
func orDefault(order string) string {
	if order == "" {
		return "created"
	}
	return order
}

// sitesPageButton goes to a page of the sites in an order, outlined unless it is the order shown
templ sitesPageButton(id string, label string, skip int64, limit int64, order string, outline bool) {
	{{ variant := button.VariantDefault }}
	if outline {
		{{ variant = button.VariantOutline }}
	}
	{{ path := fmt.Sprintf("/sites?skip=%d&limit=%d", skip, limit) }}
	if order != "" {
		{{ path += "&order=" + order }}
	}
	@button.Button(button.Props{
		ID:      id,
		Variant: variant,
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

// createSiteForm creates a site at an ID an admin picks, such as a vanity one for a special user: 8 lowercase
// letters, like every site's
templ createSiteForm() {
	<form
		id="control--sites--create"
		class="flex flex-wrap items-end gap-2 rounded-xl border border-gray-200 p-4 shadow-sm"
		hx-post="/sites"
		hx-target="#modal-container"
		hx-swap="innerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		@field.Field("control--sites--create--id", fmt.Sprintf("New site ID (%d lowercase letters)", utils.SITE_ID_LENGTH), "w-full sm:w-64") {
			@input.Input(input.Props{
				ID:          "control--sites--create--id",
				Name:        "id",
				Placeholder: "mynewnts",
				Required:    true,
				Attributes: templ.Attributes{
					"pattern": fmt.Sprintf("[a-z]{%d}", utils.SITE_ID_LENGTH), "minlength": utils.SITE_ID_LENGTH, "maxlength": utils.SITE_ID_LENGTH,
					"title": fmt.Sprintf("%d lowercase letters, a to z", utils.SITE_ID_LENGTH), "autocomplete": "off", "spellcheck": "false",
					"autocapitalize": "none",
					// Capitals are lowered and anything but a to z is dropped as it is typed or pasted, so only letters
					// a site ID can have ever go in
					"oninput": templ.JSUnsafeFuncCall("this.value = this.value.toLowerCase().replace(/[^a-z]/g, '')"),
				},
			})
		}
		@button.Button(button.Props{ID: "control--sites--create--submit", Type: button.TypeSubmit}) {
			Create Site
		}
	</form>
}

// PublicSiteCreation says whether the public can create sites from the home page, with a button to turn it the other
// way. An admin can create sites here either way.
templ PublicSiteCreation(on bool) {
	<form
		id="control--sites--public-creation"
		class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-gray-200 p-4 shadow-sm"
		hx-post="/settings"
		hx-swap="outerHTML"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
	>
		<input type="hidden" name="public_site_creation" value={ strconv.FormatBool(!on) }/>
		<p id="control--sites--public-creation--state" class="text-sm text-gray-700">
			if on {
				The public can create sites from the home page.
			} else {
				Public site creation is off: the home page cannot create sites, but an admin can create them here.
			}
		</p>
		@button.Button(button.Props{ID: "control--sites--public-creation--toggle", Type: button.TypeSubmit, Variant: button.VariantOutline}) {
			if on {
				Turn Off Public Site Creation
			} else {
				Turn On Public Site Creation
			}
		}
	</form>
}

// PublicSiteCreationChanged replaces the public site creation switch, with a toast saying which way it was turned
templ PublicSiteCreationChanged(on bool) {
	@PublicSiteCreation(on)
	<div hx-swap-oob="beforeend:#toaster">
		@toast.Toast(toast.Props{
			Title:       "Success",
			Description: map[bool]string{true: "Public site creation turned on", false: "Public site creation turned off"}[on],
			Variant:     toast.VariantSuccess,
			Position:    toast.PositionTopCenter,
			Duration:    5000,
			Dismissible: true,
			Icon:        true,
		})
	</div>
}

// SiteCreated shows a site an admin created, with its credentials, which are shown only this once
templ SiteCreated(info publicmodels.NewSiteInfo) {
	@modal.Modal(modal.Props{ID: "control--site--created", Title: "Site Created", Subtitle: info.URL}) {
		@public_templ.CreateSiteInfo(info)
	}
}

// SiteNotCreated is a toast saying why a site could not be created, such as its ID being taken
templ SiteNotCreated(message string) {
	@toast.Toast(toast.Props{Title: "Site Not Created", Description: message, Variant: toast.VariantError, Position: toast.PositionTopCenter,
		Dismissible: true, Icon: true})
}

templ siteRow(site *controlmodels.Site) {
	@table.Row(table.RowProps{
		ID:    "control--site--" + site.ID,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/sites/" + site.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ site.ID }
		}
		@table.Cell() {
			{ display.Name(site.State) }
			if inactive(ctx, site) {
				<span id={ "control--site--" + site.ID + "--inactive" } class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">inactive</span>
			}
		}
		@table.Cell() {
			{ formatDate(&site.CreatedAt) }
		}
		@table.Cell() {
			<span title={ formatDate(site.LastSeenAt) }>{ display.Ago(site.LastSeenAt, time.Now()) }</span>
		}
		@table.Cell() {
			<span title={ formatDate(site.LastWriteAt) }>{ display.Ago(site.LastWriteAt, time.Now()) }</span>
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ sizeMB(site.EstimatedDbSizeKb) }
			if site.Oversized() {
				<span class="ml-2 rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800">over limit</span>
			}
		}
	}
}

// SiteModal shows a site's details, with a link to its own page and its identities, and lets an admin disable it while
// it is live and inactive, and archive it once it is disabled
templ SiteModal(site *controlmodels.Site) {
	@modal.Modal(modal.Props{ID: "control--site--details", Title: site.ID, Actions: siteActions(site)}) {
		@siteDetails(site)
		<a id="control--site--inspect" href={ templ.SafeURL("/sites/" + site.ID + "/inspect") } class="mt-4 inline-block text-sm font-medium text-primary underline">Inspect its identities</a>
	}
}

// SiteInspect is a site's own page: its details, and its identities, which an admin can reset or sign in to the site as
templ SiteInspect(inspect *controlmodels.SiteInspect) {
	<div id="control--site--inspect-page" class="mx-auto max-w-5xl space-y-6">
		@heading.Page(inspect.Site.ID) {
			Inspect the site: its details and every one of its identities.
		}
		@siteDetails(inspect.Site)
		@SiteIdentities(inspect.Site.ID, inspect.Identities)
	</div>
}

// siteDetails is what is known of a site, never its data or secrets
templ siteDetails(site *controlmodels.Site) {
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@siteDetail("State", display.Name(site.State))
			@siteDetail("Batch", site.Batch)
			@siteDetail("DB Size Limit (MB)", sizeMB(site.MaxDbSizeKbLimit))
			@siteDetail("DB Size (MB)", sizeMB(site.EstimatedDbSizeKb))
			@siteDetail("Created", formatDate(&site.CreatedAt))
			@siteDetail("Last Seen", formatDate(site.LastSeenAt))
			@siteDetail("Last Write", formatDate(site.LastWriteAt))
			@siteDetail("Disabled", formatDate(site.DisabledAt))
			@siteDetail("Archived", formatDate(site.ArchivedAt))
			@siteDetail("Deleted", formatDate(site.DeletedAt))
		</dl>
}

// siteActions are the buttons for what an admin can do to a site: disable it once no one has used it for a while,
// truncate it while it is over its DB size limit, and archive it once it is disabled
templ siteActions(site *controlmodels.Site) {
	if inactive(ctx, site) {
		<form
			hx-post={ "/sites/" + site.ID }
			hx-target={ "#control--site--" + site.ID }
			hx-swap="outerHTML"
			hx-confirm="Disable this site? It will stop being served."
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			<input type="hidden" name="state" value="disabled"/>
			@button.Button(button.Props{ID: "control--site--disable", Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
				Disable
			}
		</form>
	}
	if site.Oversized() {
		<form
			hx-post={ "/sites/" + site.ID + "/truncate" }
			hx-target={ "#control--site--" + site.ID }
			hx-swap="outerHTML"
			hx-confirm="Truncate this site? The raw JSON kept of what its old records were sent is cleared, but all its data is kept."
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@button.Button(button.Props{ID: "control--site--truncate", Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
				Truncate
			}
		</form>
	}
	if site.State == "disabled" {
		<form
			hx-post={ "/sites/" + site.ID }
			hx-target={ "#control--site--" + site.ID }
			hx-swap="outerHTML"
			hx-confirm="Archive this site? Its data is uploaded to S3 and deleted here."
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			<input type="hidden" name="state" value="archived"/>
			@button.Button(button.Props{ID: "control--site--archive", Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
				Archive
			}
		</form>
	}
}

var siteDetail = modal.Detail

// sizeMB is a size kept in KB as MB, to two places so a small site's is not 0, or - if it is not known
func sizeMB(kb *int64) string {
	if kb == nil {
		return "-"
	}
	return fmt.Sprintf("%.2f", float64(*kb)/1024)
}

// SiteUpdated replaces the site's row, closes its details and shows a toast saying it is disabled or archived
templ SiteUpdated(site *controlmodels.Site) {
	@siteChanged(site, map[string]string{"disabled": "Site Disabled", "archived": "Site Archived"}[site.State])
}

templ SiteTruncated(site *controlmodels.Site) {
	@siteChanged(site, "Site Truncated")
}

templ siteChanged(site *controlmodels.Site, description string) {
	@siteRow(site)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@toast.Toast(toast.Props{
			Title:       "Success",
			Description: description,
			Variant:     toast.VariantSuccess,
			Position:    toast.PositionTopCenter,
			Duration:    5000,
			Dismissible: true,
			Icon:        true,
		})
	</div>
}
