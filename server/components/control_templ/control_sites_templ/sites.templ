package control_sites_templ

import (
	"context"
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/httputils"
)

// inactive is whether a live site has not been written to or seen in the configured days, so it can be disabled
func inactive(ctx context.Context, site *controlmodels.Site) bool {
	controlContext := httputils.GetControlContext(ctx)
	if site.State != "live" || controlContext == nil || controlContext.ControlDB == nil {
		return false
	}
	return site.Inactive(controlContext.ControlDB.ServerConfig.DisableAfterInactivityDays, time.Now())
}

// formatDate shows an optional time in ms, or a dash when it is not set
func formatDate(ms *int64) string {
	if ms == nil {
		return "-"
	}
	return time.UnixMilli(*ms).Format("2006-01-02 15:04:05")
}

// siteOrders are the ways the sites can be ordered, by their order query value
var siteOrders = []struct{ order, label string }{
	{"", "Newest"},
	{"last_write", "Longest Since Written"},
	{"db_size", "Largest DB"},
}

// SitesTable shows one page of sites in order, newest first by default, with buttons to reorder them and to the
// pages either side
templ SitesTable(sites []*controlmodels.Site, skip int64, limit int64, order string) {
	<div id="sites_table" class="mx-auto max-w-5xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">Sites</h1>
			<p class="mt-1 text-gray-500">Every site. Click a site to see its details.</p>
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<div id="control--sites--order" class="mb-4 flex justify-end gap-2">
				for _, siteOrder := range siteOrders {
					@sitesPageButton("control--sites--order-"+orDefault(siteOrder.order), siteOrder.label, 0, limit, siteOrder.order, siteOrder.order != order)
				}
			</div>
			@table.Table(table.Props{ID: "controlSitesTable", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Site
						}
						@table.Head() {
							State
						}
						@table.Head() {
							Created
						}
						@table.Head() {
							Last Seen
						}
						@table.Head() {
							Last Write
						}
						@table.Head() {
							DB Size (KB)
						}
					}
				}
				@table.Body() {
					if len(sites) == 0 {
						<tr><td colspan="6" class="p-4 text-sm text-gray-500">No sites here.</td></tr>
					}
					for _, site := range sites {
						@siteRow(site)
					}
				}
			}
			<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
				if len(sites) > 0 {
					<span>{ fmt.Sprintf("Showing %d to %d", skip+1, skip+int64(len(sites))) }</span>
				} else {
					<span></span>
				}
				<div class="flex gap-2">
					if skip > 0 {
						@sitesPageButton("control--sites--previous", "Previous", max(skip-limit, 0), limit, order, true)
					}
					if int64(len(sites)) == limit {
						@sitesPageButton("control--sites--next", "Next", skip+limit, limit, order, true)
					}
				</div>
			</div>
		</section>
		<div id="modal-container"></div>
	</div>
}

// orDefault names the default order, which has no order query value
func orDefault(order string) string {
	if order == "" {
		return "created"
	}
	return order
}

// sitesPageButton goes to a page of the sites in an order, outlined unless it is the order shown
templ sitesPageButton(id string, label string, skip int64, limit int64, order string, outline bool) {
	{{ variant := button.VariantDefault }}
	if outline {
		{{ variant = button.VariantOutline }}
	}
	{{ path := fmt.Sprintf("/sites?skip=%d&limit=%d", skip, limit) }}
	if order != "" {
		{{ path += "&order=" + order }}
	}
	@button.Button(button.Props{
		ID:      id,
		Variant: variant,
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

templ siteRow(site *controlmodels.Site) {
	@table.Row(table.RowProps{
		ID:    "control--site--" + site.ID,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/sites/" + site.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ site.ID }
		}
		@table.Cell() {
			{ site.State }
			if inactive(ctx, site) {
				<span id={ "control--site--" + site.ID + "--inactive" } class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">inactive</span>
			}
		}
		@table.Cell() {
			{ formatDate(&site.CreatedAt) }
		}
		@table.Cell() {
			{ formatDate(site.LastSeenAt) }
		}
		@table.Cell() {
			{ formatDate(site.LastWriteAt) }
		}
		@table.Cell() {
			{ orDash(site.EstimatedDbSizeKb) }
			if site.Oversized() {
				<span class="ml-2 rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800">over limit</span>
			}
		}
	}
}

// SiteModal shows a site's details, and lets an admin disable it while it is live and inactive, and archive it once
// it is disabled
templ SiteModal(site *controlmodels.Site) {
	@modal.Modal(modal.Props{ID: "control--site--details", Title: site.ID, Actions: siteActions(site)}) {
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@siteDetail("State", site.State)
			@siteDetail("Batch", site.Batch)
			@siteDetail("DB Size Limit (KB)", orDash(site.MaxDbSizeKbLimit))
			@siteDetail("DB Size (KB)", orDash(site.EstimatedDbSizeKb))
			@siteDetail("Created", formatDate(&site.CreatedAt))
			@siteDetail("Last Seen", formatDate(site.LastSeenAt))
			@siteDetail("Last Write", formatDate(site.LastWriteAt))
			@siteDetail("Disabled", formatDate(site.DisabledAt))
			@siteDetail("Archived", formatDate(site.ArchivedAt))
			@siteDetail("Deleted", formatDate(site.DeletedAt))
		</dl>
	}
}

// siteActions are the buttons for what an admin can do to a site: disable it once no one has used it for a while,
// truncate it while it is over its DB size limit, and archive it once it is disabled
templ siteActions(site *controlmodels.Site) {
	if inactive(ctx, site) {
		<form
			hx-post={ "/sites/" + site.ID }
			hx-target={ "#control--site--" + site.ID }
			hx-swap="outerHTML"
			hx-confirm="Disable this site? It will stop being served."
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			<input type="hidden" name="state" value="disabled"/>
			@button.Button(button.Props{ID: "control--site--disable", Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
				Disable
			}
		</form>
	}
	if site.Oversized() {
		<form
			hx-post={ "/sites/" + site.ID + "/truncate" }
			hx-target={ "#control--site--" + site.ID }
			hx-swap="outerHTML"
			hx-confirm="Truncate this site? The raw JSON kept of what it was sent is cleared, but all its data is kept."
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@button.Button(button.Props{ID: "control--site--truncate", Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
				Truncate
			}
		</form>
	}
	if site.State == "disabled" {
		<form
			hx-post={ "/sites/" + site.ID }
			hx-target={ "#control--site--" + site.ID }
			hx-swap="outerHTML"
			hx-confirm="Archive this site? Its data is uploaded to S3 and deleted here."
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			<input type="hidden" name="state" value="archived"/>
			@button.Button(button.Props{ID: "control--site--archive", Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
				Archive
			}
		</form>
	}
}

var siteDetail = modal.Detail

func orDash(value *int64) string {
	if value == nil {
		return "-"
	}
	return fmt.Sprint(*value)
}

// SiteUpdated replaces the site's row, closes its details and shows a toast saying it is disabled or archived
templ SiteUpdated(site *controlmodels.Site) {
	@siteChanged(site, map[string]string{"disabled": "Site Disabled", "archived": "Site Archived"}[site.State])
}

templ SiteTruncated(site *controlmodels.Site) {
	@siteChanged(site, "Site Truncated")
}

templ siteChanged(site *controlmodels.Site, description string) {
	@siteRow(site)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@toast.Toast(toast.Props{
			Title:       "Success",
			Description: description,
			Variant:     toast.VariantSuccess,
			Position:    toast.PositionTopCenter,
			Duration:    5000,
			Dismissible: true,
			Icon:        true,
		})
	</div>
}
