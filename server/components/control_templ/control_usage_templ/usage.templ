package control_usage_templ

import (
	"fmt"
	"slices"
	"maps"
	"strings"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/stat"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
	"nighttroop.t1d.nz/utils/usage"
)

// meanStd is a mean and standard deviation, shown with what to
func meanStd(stats usage.Stats, show func(float64) string) string {
	return fmt.Sprintf("%s ± %s", show(stats.Mean), show(stats.Std))
}

func count(value float64) string {
	return fmt.Sprintf("%.1f", value)
}

// The resource graphs are drawn in a box graphW wide and graphH high, from 0% at its bottom to its top percent at its
// top: 100% for memory and disk, and 100% for each core for the CPU, as htop shows it
const graphW, graphH = 300.0, 60.0

func graphY(percent float64, top float64) float64 {
	return graphH - graphH*min(max(percent, 0), top)/top
}

// resourcePoints are a graph line's points: each check's value, placed by its time across the checks kept. A check
// without the value, as memory on a Mac, is left out.
func resourcePoints(model controlmodels.Usage, value func(controlmodels.ResourceReading) *float64, top float64) string {
	points := []string{}
	for _, reading := range model.ResourceReadings {
		if v := value(reading); v != nil {
			x := graphW * float64(reading.At-model.ResourcesSince) / float64(max(model.Now-model.ResourcesSince, 1))
			points = append(points, fmt.Sprintf("%.1f,%.1f", x, graphY(*v, top)))
		}
	}
	return strings.Join(points, " ")
}

// latestPercent is the newest check's value, or a dash when it has none
func latestPercent(model controlmodels.Usage, value func(controlmodels.ResourceReading) *float64) string {
	if len(model.ResourceReadings) == 0 || value(model.ResourceReadings[len(model.ResourceReadings)-1]) == nil {
		return "-"
	}
	return fmt.Sprintf("%.0f%%", *value(model.ResourceReadings[len(model.ResourceReadings)-1]))
}

func cpuPercent(r controlmodels.ResourceReading) *float64 { return &r.CPUPercent }
func memoryPercent(r controlmodels.ResourceReading) *float64 { return r.MemoryPercent }
func diskPercent(r controlmodels.ResourceReading) *float64 { return r.DiskPercent }

// Usage is how many use the server and how much, and its resources. It asks for itself again every 10 seconds, and
// swaps in its new numbers.
templ Usage(model controlmodels.Usage) {
	<div
		id="control--usage"
		class="mx-auto max-w-5xl space-y-6"
		hx-get="/usage"
		hx-trigger="every 10s"
		hx-select="#control--usage"
		hx-target="this"
		hx-swap="outerHTML"
	>
		@heading.Page(i18n.T(ctx, "control.usage.title")) {
			{ i18n.T(ctx, "control.usage.intro", i18n.Data{"StartedAgo": display.TimeAgo(ctx, model.SinceStart.Started, model.NowTime())}) }
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.active"), Class: tiles}) {
			@stat.NoteTile("control--usage--sites-day", i18n.T(ctx, "control.usage.sites_today"), fmt.Sprint(model.ActiveSitesDay), i18n.T(ctx, "control.usage.seen_day"))
			@stat.NoteTile("control--usage--sites-week", i18n.T(ctx, "control.usage.sites_week"), fmt.Sprint(model.ActiveSitesWeek), i18n.T(ctx, "control.usage.seen_week"))
			@stat.NoteTile("control--usage--users-day", i18n.T(ctx, "control.usage.users_today"), fmt.Sprint(model.ActiveIdentitiesDay), i18n.T(ctx, "control.usage.people_and_devices"))
			@stat.NoteTile("control--usage--users-week", i18n.T(ctx, "control.usage.users_week"), fmt.Sprint(model.ActiveIdentitiesWeek), i18n.T(ctx, "control.usage.people_and_devices"))
			for _, state := range slices.Sorted(maps.Keys(model.SitesByState)) {
				@stat.NoteTile("control--usage--sites-"+state, i18n.T(ctx, "control.usage.state_sites", i18n.Data{"StateName": display.Name(state)}), fmt.Sprint(model.SitesByState[state]), i18n.T(ctx, "control.usage.in_all"))
			}
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.sites_created"), Class: tiles}) {
			@stat.NoteTile("control--usage--created-today", i18n.T(ctx, "control.usage.today"), fmt.Sprint(model.SitesCreatedToday), i18n.T(ctx, "control.usage.since_midnight"))
			@stat.NoteTile("control--usage--created-week", i18n.T(ctx, "control.usage.this_week"), fmt.Sprint(model.SitesCreatedWeek), i18n.T(ctx, "control.usage.since_monday"))
			@stat.NoteTile("control--usage--created-month", i18n.T(ctx, "control.usage.this_month"), fmt.Sprint(model.SitesCreatedMonth), i18n.T(ctx, "control.usage.since_first"))
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.use_since_start"), Class: tiles}) {
			@stat.NoteTile("control--usage--requests-today", i18n.T(ctx, "control.usage.requests_today"), fmt.Sprint(model.SinceStart.Today.Requests), i18n.T(ctx, "control.usage.requests_week", i18n.Data{"WeekRequests": model.SinceStart.Week.Requests}))
			@stat.NoteTile("control--usage--ingested-today", i18n.T(ctx, "control.usage.ingested_today"), display.Bytes(float64(model.SinceStart.Today.Ingested)), i18n.T(ctx, "control.usage.ingested_week", i18n.Data{"WeekBytes": display.Bytes(float64(model.SinceStart.Week.Ingested))}))
			@stat.NoteTile("control--usage--ingested-total", i18n.T(ctx, "control.usage.ingested_total"), display.Bytes(float64(model.SinceStart.Ingested)), i18n.T(ctx, "control.usage.since_start"))
			@stat.NoteTile("control--usage--requests-per-site", i18n.T(ctx, "control.usage.requests_per_site"), meanStd(model.SinceStart.RequestsPerSiteDay, count), i18n.T(ctx, "control.usage.mean_std", i18n.Data{"SiteDays": model.SinceStart.RequestsPerSiteDay.N}))
			@stat.NoteTile("control--usage--ingested-per-site", i18n.T(ctx, "control.usage.ingested_per_site"), meanStd(model.SinceStart.IngestedPerSiteDay, display.Bytes), i18n.T(ctx, "control.usage.mean_std", i18n.Data{"SiteDays": model.SinceStart.IngestedPerSiteDay.N}))
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.pushes"), Class: tiles}) {
			@stat.NoteTile("control--usage--pushes-today", i18n.T(ctx, "control.usage.pushes_today"), fmt.Sprint(model.Pushes.Today.Sent), i18n.T(ctx, "control.usage.pushes_failed_today", i18n.Data{"FailedCount": model.Pushes.Today.Failed}))
			@stat.NoteTile("control--usage--pushes-week", i18n.T(ctx, "control.usage.pushes_week"), fmt.Sprint(model.Pushes.Week.Sent), i18n.T(ctx, "control.usage.pushes_failed_week", i18n.Data{"FailedCount": model.Pushes.Week.Failed}))
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.server"), Class: tiles}) {
			@stat.NoteTile("control--usage--cpu", i18n.T(ctx, "control.usage.cpu"), fmt.Sprintf("%.1f%%", model.Server.CPUPercent), i18n.T(ctx, "control.usage.cpu_note", i18n.Data{"MaxPercent": 100 * model.Server.CPUs, "CoreCount": model.Server.CPUs}))
			if model.Server.ResidentBytes > 0 {
				// All the process's memory, as the OS counts it: SQLite's is outside Go's
				@stat.NoteTile("control--usage--memory", i18n.T(ctx, "control.usage.memory"), display.Bytes(float64(model.Server.ResidentBytes)), i18n.T(ctx, "control.usage.memory_heap", i18n.Data{"HeapBytes": display.Bytes(float64(model.Server.HeapBytes))}))
			} else {
				@stat.NoteTile("control--usage--memory", i18n.T(ctx, "control.usage.memory"), display.Bytes(float64(model.Server.HeapBytes)), i18n.T(ctx, "control.usage.memory_os", i18n.Data{"SysBytes": display.Bytes(float64(model.Server.SysBytes))}))
			}
			@stat.NoteTile("control--usage--goroutines", i18n.T(ctx, "control.usage.goroutines"), fmt.Sprint(model.Server.Goroutines), i18n.T(ctx, "control.usage.gcs", i18n.Data{"GCCount": model.Server.GCs}))
			@stat.NoteTile("control--usage--disk", i18n.T(ctx, "control.usage.db_disk_used"), display.Bytes(float64(model.Server.DiskUsed)), i18n.T(ctx, "control.usage.disk_free", i18n.Data{"FreeBytes": display.Bytes(float64(model.Server.DiskFree))}))
			@stat.NoteTile("control--usage--uptime", i18n.T(ctx, "control.usage.uptime"), display.Duration(ctx, model.Server.UptimeMs), i18n.T(ctx, "control.usage.since_start"))
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.resources")}) {
			if len(model.ResourceReadings) == 0 {
				<p id="control--usage--resources-empty" class="text-sm text-gray-500">{ i18n.T(ctx, "control.usage.resources_empty") }</p>
			} else {
				<div class="grid gap-3 sm:grid-cols-3">
					@resourceGraph(model, "cpu", i18n.T(ctx, "control.usage.mean_cpu"), cpuPercent, -1, 100*float64(max(model.Server.CPUs, 1)))
					@resourceGraph(model, "memory", i18n.T(ctx, "control.usage.memory_used"), memoryPercent, model.MemoryAlertPercent, 100)
					@resourceGraph(model, "disk", i18n.T(ctx, "control.usage.db_disk_used"), diskPercent, model.DiskAlertPercent, 100)
				</div>
			}
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.routes")}) {
			@table.Table(table.Props{ID: "control--usage--routes", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, "control.usage.route") }
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							{ i18n.T(ctx, "control.usage.requests") }
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							{ i18n.T(ctx, "control.usage.mean_ms") }
						}
					}
				}
				@table.Body() {
					if len(model.SinceStart.Routes) == 0 {
						<tr><td colspan="3" class="p-4 text-sm text-gray-500">{ i18n.T(ctx, "control.usage.no_requests") }</td></tr>
					}
					for _, route := range model.SinceStart.Routes {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
								{ route.Route }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ fmt.Sprint(route.Count) }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ fmt.Sprintf("%.1f", route.MeanMs) }
							}
						}
					}
				}
			}
		}
		@slowestQueries(model)
	</div>
}

// resourceGraph is a small graph of a resource's percent over the checks kept, with a dashed line at the level it
// warns at, unless alertPercent is negative
templ resourceGraph(model controlmodels.Usage, name string, label string, value func(controlmodels.ResourceReading) *float64, alertPercent int, top float64) {
	<div class="rounded-lg border border-gray-200 p-3">
		<div class="flex justify-between text-xs font-semibold uppercase tracking-wide text-gray-500">
			<span>{ label }</span>
			<span id={ "control--usage--resources-" + name + "-latest" } class="tabular-nums">{ latestPercent(model, value) }</span>
		</div>
		<svg id={ "control--usage--resources-" + name } viewBox={ fmt.Sprintf("0 0 %.0f %.0f", graphW, graphH) } preserveAspectRatio="none" class="mt-2 h-16 w-full overflow-visible" role="img" aria-label={ i18n.T(ctx, "control.usage.graph_label", i18n.Data{"GraphName": label}) }>
			<line x1="0" x2={ fmt.Sprint(graphW) } y1={ fmt.Sprint(graphH) } y2={ fmt.Sprint(graphH) } class="stroke-gray-200" vector-effect="non-scaling-stroke"></line>
			if alertPercent >= 0 {
				<line x1="0" x2={ fmt.Sprint(graphW) } y1={ fmt.Sprint(graphY(float64(alertPercent), top)) } y2={ fmt.Sprint(graphY(float64(alertPercent), top)) } class="stroke-amber-500" stroke-dasharray="4 3" vector-effect="non-scaling-stroke"></line>
			}
			<polyline points={ resourcePoints(model, value, top) } fill="none" class="stroke-brand-night" stroke-width="1.5" vector-effect="non-scaling-stroke"></polyline>
		</svg>
		<div class="text-xs text-gray-500">{ i18n.T(ctx, "control.usage.graph_note") }</div>
	</div>
}

// tiles lays out a card's tiles, five to a row on a wide screen
const tiles = "grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"

// numberClass right aligns a column of numbers
func numberClass(number bool) string {
	if number {
		return "text-right tabular-nums"
	}
	return ""
}

// slowestQueries are the DB queries whose sampled runs took the longest in all, where speeding one up saves the most
templ slowestQueries(model controlmodels.Usage) {
	@card.Card(card.Props{Title: i18n.T(ctx, "control.usage.slowest_queries"), Note: i18n.T(ctx, "control.usage.slowest_queries_note", i18n.Data{"SamplePercent": model.QuerySamplePercent})}) {
		@table.Table(table.Props{ID: "control--usage--queries", Class: "rounded-lg border border-gray-200"}) {
			@table.Header() {
				@table.Row() {
					for i, head := range []string{"control.usage.query", "control.usage.runs", "control.usage.mean_ms", "control.usage.p95_ms",
						"control.usage.max_ms", "control.usage.total_ms"} {
						@table.Head(table.HeadProps{Class: numberClass(i > 0)}) {
							{ i18n.T(ctx, head) }
						}
					}
				}
			}
			@table.Body() {
				if len(model.SlowestQueries) == 0 {
					<tr><td colspan="6" class="p-4 text-sm text-gray-500">{ i18n.T(ctx, "control.usage.no_queries") }</td></tr>
				}
				for _, q := range model.SlowestQueries {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
							{ q.DB + "." + q.Query }
						}
						for _, value := range []string{fmt.Sprint(q.Count), fmt.Sprintf("%.1f", q.MeanMs), fmt.Sprintf("%.1f", q.P95Ms), fmt.Sprintf("%.1f", q.MaxMs), fmt.Sprintf("%.0f", q.TotalMs)} {
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ value }
							}
						}
					}
				}
			}
		}
	}
}
