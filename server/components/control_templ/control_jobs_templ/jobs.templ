package control_jobs_templ

import (
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/filter"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

// duration is how long the job took from being fetched to finishing
func duration(job *controlmodels.Job) string {
	if job.ConsumerFetchedAt == 0 || job.FinishedAt == 0 {
		return "-"
	}
	return display.Duration(job.FinishedAt - job.ConsumerFetchedAt)
}

// statusClass shows failed jobs as errors
func statusClass(job *controlmodels.Job) string {
	if job.JobStatus == "failed" {
		return "font-medium text-red-700"
	}
	return ""
}

// JobsTable shows one page of jobs, newest first, with buttons to the pages either side
templ JobsTable(jobs []*controlmodels.Job, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "jobs_table",
		Title:       i18n.T(ctx, "control.jobs.title"),
		Description: i18n.T(ctx, "control.jobs.intro"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:     "controlJobsTable",
			Static: true,
			Rows:   len(jobs),
			Empty:  i18n.T(ctx, "control.jobs.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "control.jobs.id_column"), Numeric: true}, {Label: i18n.T(ctx, "control.jobs.queue")}, {Label: i18n.T(ctx, "control.jobs.job")}, {Label: i18n.T(ctx, "control.jobs.status")},
				{Label: i18n.T(ctx, "control.jobs.created")}, {Label: i18n.T(ctx, "control.jobs.duration"), Numeric: true},
			},
		},
		Pager: &pager.Props{ID: "control--jobs", Path: "/jobs", Count: len(jobs), Skip: skip, Limit: limit},
	}) {
		for _, job := range jobs {
			@jobRow(job)
		}
	}
}

templ jobRow(job *controlmodels.Job) {
	@table.ModalRow(fmt.Sprintf("control--job--%d", job.ID), fmt.Sprintf("/jobs/%d", job.ID)) {
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(job.ID) }
		}
		@table.Cell() {
			{ job.Queue }
		}
		@table.Cell() {
			<span class="block max-w-xs truncate">{ job.Job }</span>
		}
		@table.Cell() {
			<span class={ statusClass(job) }>{ job.JobStatus }</span>
		}
		@table.Cell() {
			<span title={ display.DateTime(&job.CreatedAt) }>{ display.Ago(&job.CreatedAt, time.Now()) }</span>
		}
		@table.Cell(table.NumCell) {
			{ duration(job) }
		}
	}
}

// JobModal shows all of a job's details and the errors its attempts had
templ JobModal(job *controlmodels.Job) {
	@modal.Modal(modal.Props{ID: "control--job--details", Title: i18n.T(ctx, "control.jobs.modal_title", i18n.Data{"JobID": job.ID})}) {
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@modal.Detail(i18n.T(ctx, "control.jobs.queue"), job.Queue)
			@modal.Detail(i18n.T(ctx, "control.jobs.job"), job.Job)
			@modal.Detail(i18n.T(ctx, "control.jobs.status"), job.JobStatus)
			@modal.Detail(i18n.T(ctx, "control.jobs.remaining_attempts"), fmt.Sprint(job.RemainingAttempts))
			@modal.Detail(i18n.T(ctx, "control.jobs.deduping_key"), job.DedupingKey)
			@modal.Detail(i18n.T(ctx, "control.jobs.created"), display.DateTime(&job.CreatedAt))
			@modal.Detail(i18n.T(ctx, "control.jobs.execute_after"), display.DateTime(&job.ExecuteAfter))
			@modal.Detail(i18n.T(ctx, "control.jobs.fetched"), display.DateTime(&job.ConsumerFetchedAt))
			@modal.Detail(i18n.T(ctx, "control.jobs.finished"), display.DateTime(&job.FinishedAt))
			@modal.Detail(i18n.T(ctx, "control.jobs.duration"), duration(job))
			if job.RunID != nil {
				<dt class="text-gray-500">{ i18n.T(ctx, "control.jobs.logs") }</dt>
				<dd>
					@RunLogsLink("control--job--logs", *job.RunID)
				</dd>
			}
		</dl>
		<h3 class="mt-4 text-sm font-semibold">{ i18n.T(ctx, "control.jobs.errors") }</h3>
		if len(job.Errors) == 0 {
			<p class="mt-1 text-sm text-gray-500">{ i18n.T(ctx, "control.jobs.no_errors") }</p>
		} else {
			<ul id="control--job--errors" class="mt-1 max-h-48 list-disc space-y-1 overflow-y-auto pl-5 text-sm text-red-700">
				for _, e := range job.Errors {
					<li class="break-all">{ e }</li>
				}
			</ul>
		}
	}
}

// RunLogsLink goes to the logs of a job's run, by the job_id they have, to see why it failed
templ RunLogsLink(id string, runID string) {
	{{ link := filter.PagePath("/logs", nil, nil, filter.ID{Name: "job_id", Value: &runID}) }}
	@nav.Link(id, link, "break-all text-primary underline") {
		{ runID }
	}
}
