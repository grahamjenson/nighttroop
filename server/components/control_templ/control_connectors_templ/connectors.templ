package control_connectors_templ

import (
	"fmt"
	"strconv"
	"time"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

// orDash shows an optional count or duration as a whole number, e.g. 12345, or a dash when it is not set
func orDash(value *int64) string {
	if value == nil {
		return "-"
	}
	return strconv.FormatInt(*value, 10)
}

// averageOrDash shows an optional average to one decimal place, e.g. 12345.7, or a dash when it is not set
func averageOrDash(value *float64) string {
	if value == nil {
		return "-"
	}
	return strconv.FormatFloat(*value, 'f', 1, 64)
}

// state is whether the source is off, was turned off after failing, is failing or is syncing
func state(source *controlmodels.Connector) string {
	failing := source.ConsecutiveFailedSyncs != nil && *source.ConsecutiveFailedSyncs > 0
	switch {
	case !source.Enabled && failing:
		return "disabled after failing"
	case !source.Enabled:
		return "disabled"
	case failing:
		return "failing"
	}
	return "syncing"
}

// stateLabels are the ids of each state's text
var stateLabels = map[string]string{
	"syncing": "control.connectors.state_syncing", "failing": "control.connectors.state_failing",
	"disabled": "control.connectors.state_disabled", "disabled after failing": "control.connectors.state_disabled_after_failing",
}

func stateClass(source *controlmodels.Connector) string {
	switch state(source) {
	case "failing":
		return "font-medium text-red-700"
	case "disabled after failing":
		return "font-medium text-amber-800"
	case "disabled":
		return "text-gray-500"
	}
	return ""
}

// failedClass makes a source's failed count stand out once it has failed
func failedClass(source *controlmodels.Connector) string {
	if source.TotalFailedSyncs != nil && *source.TotalFailedSyncs > 0 {
		return "font-medium text-red-700"
	}
	return ""
}

// ConnectorsTable shows one page of connectors, the most recently failed first, with buttons to the pages either side
templ ConnectorsTable(sources []*controlmodels.Connector, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "connectors_table",
		Title:       i18n.T(ctx, "control.connectors.title"),
		Description: i18n.T(ctx, "control.connectors.intro"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:     "controlConnectorsTable",
			Static: true,
			Rows:   len(sources),
			Empty:  i18n.T(ctx, "control.connectors.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "control.connectors.site")}, {Label: i18n.T(ctx, "control.connectors.type")}, {Label: i18n.T(ctx, "control.connectors.state")}, {Label: i18n.T(ctx, "control.connectors.last_attempted")},
				{Label: i18n.T(ctx, "control.connectors.last_success")}, {Label: i18n.T(ctx, "control.connectors.succeeded"), Numeric: true}, {Label: i18n.T(ctx, "control.connectors.failed"), Numeric: true},
			},
		},
		Pager: &pager.Props{ID: "control--connectors", Path: "/connectors", Count: len(sources), Skip: skip, Limit: limit},
	}) {
		for _, source := range sources {
			@connectorRow(source)
		}
	}
}

templ connectorRow(source *controlmodels.Connector) {
	@table.ModalRow("", "/connectors/"+source.ID()) {
		@table.Cell() {
			{ source.SiteID }
		}
		@table.Cell() {
			{ string(source.Type) }
		}
		@table.Cell() {
			<span class={ stateClass(source) }>{ i18n.T(ctx, stateLabels[state(source)]) }</span>
		}
		@table.Cell() {
			<span title={ display.DateTime(source.LastAttemptedSync) }>{ display.Ago(ctx, source.LastAttemptedSync, time.Now()) }</span>
		}
		@table.Cell() {
			<span title={ display.DateTime(source.LastSuccessfulSync) }>{ display.Ago(ctx, source.LastSuccessfulSync, time.Now()) }</span>
		}
		@table.Cell(table.NumCell) {
			{ orDash(source.TotalSuccessfulSyncs) }
		}
		@table.Cell(table.NumCell) {
			<span class={ failedClass(source) }>{ orDash(source.TotalFailedSyncs) }</span>
		}
	}
}

// ConnectorModal shows a connector's reports: when it synced, how often, how long it took and its recent errors
templ ConnectorModal(source *controlmodels.Connector) {
	@modal.Modal(modal.Props{ID: "control--connector--details", Title: source.SiteID + " / " + string(source.Type)}) {
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@modal.Detail(i18n.T(ctx, "control.connectors.state"), i18n.T(ctx, stateLabels[state(source)]))
			if source.Region != nil {
				@modal.Detail(i18n.T(ctx, "control.connectors.region"), *source.Region)
			}
			@modal.Detail(i18n.T(ctx, "control.connectors.created"), display.DateTime(&source.CreatedAt))
			@modal.Detail(i18n.T(ctx, "control.connectors.updated"), display.DateTime(&source.UpdatedAt))
			@modal.Detail(i18n.T(ctx, "control.connectors.first_successful_sync"), display.DateTime(source.FirstSuccessfulSyncTime))
			@modal.Detail(i18n.T(ctx, "control.connectors.sync_interval"), fmt.Sprintf("%ds (%s)", source.SyncIntervalSeconds, source.SyncIntervalSecondsReason))
			@modal.Detail(i18n.T(ctx, "control.connectors.last_attempted"), display.DateTime(source.LastAttemptedSync))
			@modal.Detail(i18n.T(ctx, "control.connectors.last_success"), display.DateTime(source.LastSuccessfulSync))
			@modal.Detail(i18n.T(ctx, "control.connectors.last_failure"), display.DateTime(source.LastFailedSync))
			@modal.Detail(i18n.T(ctx, "control.connectors.total_syncs"), orDash(source.TotalSyncs))
			@modal.Detail(i18n.T(ctx, "control.connectors.succeeded"), orDash(source.TotalSuccessfulSyncs))
			@modal.Detail(i18n.T(ctx, "control.connectors.failed"), orDash(source.TotalFailedSyncs))
			@modal.Detail(i18n.T(ctx, "control.connectors.successes_in_a_row"), orDash(source.ConsecutiveSuccessfulSyncs))
			@modal.Detail(i18n.T(ctx, "control.connectors.failures_in_a_row"), orDash(source.ConsecutiveFailedSyncs))
			@modal.Detail(i18n.T(ctx, "control.connectors.last_sync_duration"), orDash(source.LastSyncDuration))
			@modal.Detail(i18n.T(ctx, "control.connectors.total_ema"), averageOrDash(source.TotalEma))
			@modal.Detail(i18n.T(ctx, "control.connectors.success_ema"), averageOrDash(source.SuccessEma))
			@modal.Detail(i18n.T(ctx, "control.connectors.failure_ema"), averageOrDash(source.FailureEma))
		</dl>
		<h3 class="mt-4 text-sm font-semibold">{ i18n.T(ctx, "control.connectors.previous_errors") }</h3>
		if len(source.PreviousSyncErrors) == 0 {
			<p class="mt-1 text-sm text-gray-500">{ i18n.T(ctx, "control.connectors.no_errors") }</p>
		} else {
			<ul id="control--connector--errors" class="mt-1 max-h-48 list-disc space-y-1 overflow-y-auto pl-5 text-sm text-red-700">
				for _, e := range source.PreviousSyncErrors {
					<li class="break-all">{ e }</li>
				}
			</ul>
		}
	}
}
