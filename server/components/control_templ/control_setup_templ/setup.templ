package control_setup_templ

import (
	"nighttroop.t1d.nz/server/components/authenticator"
	"nighttroop.t1d.nz/server/components/control_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
)

// Setup is a new server's first page, asking for the setup code it printed to its logs
templ Setup() {
	@control_templ.ControlBase() {
		<div class="flex flex-col items-center px-6 py-12 bg-slate-50">
			<div class="setup-target p-8 rounded-lg shadow-2xl w-full max-w-lg bg-white">
				<form hx-post="/setup" hx-target="closest .setup-target" hx-swap="outerHTML" hx-status:4xx="target:#error-container swap:innerHTML" hx-status:5xx="target:#error-container swap:innerHTML" class="space-y-4">
					<div class="text-center">
						<img src="/logo.svg" alt="" class="mx-auto mb-3 size-16"/>
						<h2 class="font-bold text-2xl">Set up Nighttroop</h2>
					</div>
					<p class="text-sm text-slate-600">
						Nothing can be used until the control admin is made. The server printed a setup code to its logs
						when it started; with Docker, find it with <code class="font-mono">docker compose logs nighttroop</code>.
					</p>
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{For: "control--setup--code"}) {
							Setup code
						}
						@input.Input(input.Props{ID: "control--setup--code", Name: "code", Required: true, Attributes: templ.Attributes{"autocomplete": "off", "autocapitalize": "none"}})
					}
					@button.Button(button.Props{ID: "control--setup--submit", Type: button.TypeSubmit, Class: "w-full py-3 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg"}) {
						Continue
					}
				</form>
			</div>
		</div>
	}
}

// SetupCredentials shows the control admin's login, which is saved once a code from its TOTP secret is entered. It,
// and SetupComplete, clear the error a wrong code left.
templ SetupCredentials(name, password, totpSecret, totpURI, code string) {
	<div hx-swap-oob="innerHTML:#error-container"></div>
	<div class="setup-target p-8 rounded-lg shadow-2xl w-full max-w-lg bg-white space-y-4">
		<h2 class="font-bold text-2xl">Save the control admin's login</h2>
		<p class="text-sm text-slate-600">It is shown once. Add the TOTP secret to your authenticator app, then enter its code to finish.</p>
		<dl class="divide-y divide-slate-100 rounded-lg border border-slate-200 font-mono text-sm">
			@row("username", "Username", name)
			@row("password", "Password", password)
			@row("totp-secret", "TOTP secret", totpSecret)
		</dl>
		<div class="flex flex-col items-center gap-2">
			<div id="control--setup--qrcode" class="w-fit p-2 rounded-lg border border-slate-200"></div>
			@authenticator.ScanHint("control--setup--authenticator")
		</div>
		<script type="text/javascript">
			new QRCode(document.getElementById("control--setup--qrcode"), { text: "{{ totpURI }}", width: 128, height: 128 });
		</script>
		<form hx-post="/setup/confirm" hx-target="closest .setup-target" hx-swap="outerHTML" hx-status:4xx="target:#error-container swap:innerHTML" hx-status:5xx="target:#error-container swap:innerHTML" class="space-y-4">
			<input type="hidden" name="code" value={ code }/>
			@form.Item() {
				@form.Label(form.LabelProps{For: "control--setup--otp"}) {
					Code from your authenticator app
				}
				@inputotp.InputOTP(inputotp.Props{ID: "control--setup--otp", Name: "totp"}) {
					@inputotp.Group() {
						@inputotp.Slot(inputotp.SlotProps{Index: 0, InputID: "control--setup--otp-1"})
						@inputotp.Slot(inputotp.SlotProps{Index: 1})
						@inputotp.Slot(inputotp.SlotProps{Index: 2})
						@inputotp.Separator()
						@inputotp.Slot(inputotp.SlotProps{Index: 3})
						@inputotp.Slot(inputotp.SlotProps{Index: 4})
						@inputotp.Slot(inputotp.SlotProps{Index: 5})
					}
				}
			}
			@button.Button(button.Props{ID: "control--setup--confirm", Type: button.TypeSubmit, Class: "w-full py-3 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg"}) {
				Finish setup
			}
		</form>
	</div>
}

templ SetupComplete() {
	<div hx-swap-oob="innerHTML:#error-container"></div>
	<div id="control--setup--complete" class="setup-target p-8 rounded-lg shadow-2xl w-full max-w-lg bg-white space-y-4 text-center">
		<h2 class="font-bold text-2xl">Nighttroop is set up</h2>
		<p class="text-sm text-slate-600">Log in with the control admin's login to start creating sites.</p>
		@button.Button(button.Props{ID: "control--setup--login", Href: "/login", Class: "py-3 px-8 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg"}) {
			Log In
		}
	</div>
}

templ SetupFailed(message string) {
	<p id="control--setup--error" class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{ message }</p>
}

templ row(id, label, value string) {
	<div class="grid grid-cols-[8rem_1fr] gap-1 px-4 py-3">
		<dt class="text-slate-400">{ label }</dt>
		<dd id={ "control--setup--" + id } class="break-all text-slate-800 select-all">{ value }</dd>
	</div>
}
