package control_templ

import "nighttroop.t1d.nz/server/components/ui/button"

// Detail is one label and value pair in a details modal's list
templ Detail(label string, value string) {
	<dt class="text-gray-500">{ label }</dt>
	<dd class="break-all">{ value }</dd>
}

// CloseButton closes a details modal by emptying the modal container
templ CloseButton(id string) {
	@button.Button(button.Props{
		ID:      id,
		Variant: button.VariantOutline,
		Attributes: templ.Attributes{
			"hx-get":    "/empty",
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		Close
	}
}
