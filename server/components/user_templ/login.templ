package user_templ

import "nighttroop.t1d.nz/server/components/shared_templ"
import "nighttroop.t1d.nz/server/components/ui/form"
import "nighttroop.t1d.nz/server/components/ui/input"
import "nighttroop.t1d.nz/server/components/ui/button"

templ Login() {
	@shared_templ.Base("NightTroop Login") {
		<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
			<div class="sm:mx-auto sm:w-full sm:max-w-sm">
				<div class="p-8 login-form-target">
					<!-- Form updated with POST method -->
					<form
						hx-post="/login"
						hx-target="closest .login-form-target"
						hx-swap="innerHTML"
						hx-target-error="#error-container"
					>
						<div class="text-center mb-6">
							<h2 class="font-bold text-2xl">Welcome Back</h2>
							<p class="text-gray-500 text-sm">Please enter your details</p>
						</div>
						<!-- Username -->
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "name",
							}) {
								Name
							}
							@input.Input(input.Props{
								Type:        "text",
								Name:        "name",
								Placeholder: "admin",
								Required:    true,
							})
						}
						<!-- Password -->
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "password",
							}) {
								Password
							}
							@input.Input(input.Props{
								Type:        "password",
								Name:        "password",
								Placeholder: "••••••••",
								Required:    true,
							})
						}
						<!-- Submit Button -->
						@button.Button(button.Props{
							Type:  button.TypeSubmit,
							Class: "w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white text-lg font-bold rounded-lg shadow-sm transition-colors cursor-pointer",
						}) {
							Log In
						}
						<div id="error-container" class="mt-3"></div>
					</form>
				</div>
			</div>
		</div>
	}
}

templ LoginTOTP() {
	<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
		<div class="card shadow-sm border-0" style="max-width: 400px; width: 100%;">
			<div class="card-body p-4">
				<!-- Form updated with POST method -->
				<form action="/login_totp" method="POST" class="needs-validation">
					<div class="text-center mb-4">
						<h2 class="fw-bold">Requires TOTP</h2>
					</div>
					<!-- TOTP -->
					<div class="mb-4">
						<label class="form-label small fw-semibold">Authenticator Code</label>
						<input
							type="text"
							name="totp"
							class="form-control form-control-lg text-center letter-spacing-2"
							placeholder="000 000"
							inputmode="numeric"
							pattern="[0-9]*"
							required
						/>
					</div>
					<!-- Submit Button -->
					<button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
						Log In
					</button>
				</form>
			</div>
		</div>
	</div>
}
