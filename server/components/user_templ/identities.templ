package user_templ

import (
	"nighttroop.t1d.nz/data/sql/user"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
	"strconv"
	"time"
)

type UserIdentity struct {
	ID              string
	Name            string
	Created         string
	LastSeen        string
	Role            string
	CurrentIdentity bool
	HasTotpSecret   bool
	NightscoutToken string
	Enabled         bool
}

type RoleOption struct {
	Label string
	Value consts.IdentityRole
}

func IdentityModelToUserIdentity(identity *user.Identity, currentIdentityName string, nightscoutToken string) *UserIdentity {
	lastSeen := "Never"
	if identity.LastSeenAt != nil && *identity.LastSeenAt != 0 {
		lastSeen = time.UnixMilli(*identity.LastSeenAt).Format("2006-01-02 15:04:05")
	}

	return &UserIdentity{
		ID:              strconv.Itoa(int(identity.ID)),
		Name:            identity.Name,
		Created:         time.UnixMilli(identity.CreatedAt).Format("2006-01-02 15:04:05"),
		LastSeen:        lastSeen,
		Role:            string(identity.Role),
		CurrentIdentity: identity.Name == currentIdentityName,
		HasTotpSecret:   identity.TotpSecret != "",
		NightscoutToken: nightscoutToken,
		Enabled:         identity.Enabled,
	}
}

templ Identities(admins []*UserIdentity, users []*UserIdentity, devices []*UserIdentity, syncs []*UserIdentity) {
	@UserBase(UserContext{Subdomain: "example.com"}) {
		@IdentitesTable(admins, users, devices, syncs)
	}
}

templ IdentitesTable(admins []*UserIdentity, users []*UserIdentity, devices []*UserIdentity, syncs []*UserIdentity) {
	<div id="identities_table">
		<div class="mb-4 border-b border-white/10 pb-3">
			<h3 class="text-lg font-semibold">
				Identity Settings
			</h3>
			<p class="mt-2 text-sm text-gray-400 leading-relaxed">
				An identity can write or read your data, like an admin, a user, a device or automation like the sync idetities.
				Each request and piece of data is tagged with the identity so it is important you don't share them.
				All passwords are randomly generated and once displayed here can only be reset by an admin.
				Users and 
				For TOTP passwords, use the button to display the TOTP secret as a QR code. On identities that can access the
				Nightscout API, use "Copy Nightscout Token".
			</p>
		</div>
		<div id="adminsTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Admins</div>
			@buildIdentityTable("adminsTable", admins)
			<div class="border border-black-900"></div>
			@formCreateIdentity("Admin", []RoleOption{{Label: "Admin", Value: consts.IdentityRoleAdmin}})
		</div>
		<div id="usersTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Users</div>
			@buildIdentityTable("usersTable", users)
			<div class="border border-black-900"></div>
			@formCreateIdentity("User", []RoleOption{{Label: "User", Value: consts.IdentityRoleUser}, {Label: "Read", Value: consts.IdentityRoleUserReadOnly}})
		</div>
		<div id="devicesTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Devices</div>
			@buildIdentityTable("devicesTable", devices)
			<div class="border border-black-900"></div>
			@formCreateIdentity("Device", []RoleOption{{Label: "Read", Value: consts.IdentityRoleDeviceRead}, {Label: "Read+Write", Value: consts.IdentityRoleDeviceReadWrite}, {Label: "PWD Phone", Value: consts.IdentityRoleDevicePWDPhone}})
		</div>
		<div id="syncsTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Syncs</div>
			@buildIdentityTable("syncsTable", syncs)
		</div>
		<!-- Error -->
		<div id="error-container" class="mt-4"></div>
		<div id="modal-container"></div>
	</div>
}

templ buildIdentityTable(id string, identities []*UserIdentity) {
	@table.Table(table.Props{
		ID:    id,
		Class: "border border-gray-300 rounded-lg mb-6",
	}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Name 
				}
				@table.Head() {
					Role 
				}
				@table.Head() {
					Created at 
				}
				@table.Head() {
					Last Seen 
				}
				@table.Head() {
					Actions
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@createTableRowForIdentity(identity)
			}
		}
	}
}

templ createTableRowForIdentity(identity *UserIdentity) {
	@table.Row() {
		@table.Cell() {
			{ identity.Name }
		}
		@table.Cell() {
			{ identity.Role }
		}
		@table.Cell() {
			{ identity.Created }
		}
		@table.Cell() {
			{ identity.LastSeen }
		}
		@table.Cell() {
			<!-- actions go here -->
		}
	}
}

templ formCreateIdentity(name string, roles []RoleOption) {
	<div class="flex justify-end items-end mt-4">
		<form
			id="createIdentityForm"
			hx-post="/identities"
			hx-target="#adminsTable tbody"
			hx-swap="beforeend"
			hx-target-error="#error-container"
		>
			<div class="flex w-96 justify-end items-end gap-2">
				@form.Item(form.ItemProps{
					Class: "w-32",
				}) {
					@input.Input(input.Props{
						ID:          "name",
						Type:        "text",
						Name:        "name",
						Placeholder: "Name",
						Required:    true,
					})
				}
				if (len(roles) == 1) {
					<input type="hidden" name="role" value={ string(roles[0].Value) }/>
				} else {
					@form.Item(form.ItemProps{
						Class: "w-32",
					}) {
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:   "select-form",
								Name: "role",
								Form: "createIdentityForm",
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Role",
								})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									for i, role := range roles {
										@selectbox.Item(selectbox.ItemProps{
											Value:    string(role.Value),
											Selected: i == 0,
										}) {
											{ role.Label }
										}
									}
								}
							}
						}
					}
				}
				@form.Item(form.ItemProps{
					Class: "w-32 items-end",
				}) {
					@button.Button(button.Props{
						Type: "submit",
					}) {
						Add { name }
					}
				}
			</div>
		</form>
	</div>
}

templ CreateIdentityResponse(identity *UserIdentity, password string, totpSecret string) {
	@createTableRowForIdentity(identity)
	<div id="modal-container" hx-swap-oob="innerHTML">
		@NewIdentityModal(identity, password, totpSecret)
	</div>
}

templ NewIdentityModal(identity *UserIdentity, password string, totpSecret string) {
	<div
		class="fixed inset-0 bg-black/50 flex items-center justify-center"
	>
		<div class="bg-white rounded-lg p-6 w-full max-w-lg">
			<h2 class="text-lg font-semibold">
				Identity Created
			</h2>
			<div class="mt-4">
				<div>
					Name:
					<code>{ identity.Name }</code>
				</div>
				<div class="mt-2">
					Password:
					<code>{ password }</code>
				</div>
				<div class="mt-2">
					TOTP Secret:
					<code>{ totpSecret }</code>
				</div>
			</div>
			<button
				class="mt-4 btn btn-primary"
				hx-get="/empty"
				hx-target="#modal-container"
				hx-swap="innerHTML"
			>
				I've saved these
			</button>
		</div>
	</div>
}
