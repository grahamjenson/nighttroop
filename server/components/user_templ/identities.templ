package user_templ

import (
	"nighttroop.t1d.nz/data/sql/user"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"strconv"
	"time"
)

type UserIdentity struct {
	ID              string
	Name            string
	Created         string
	LastSeen        string
	Role            string
	CurrentIdentity bool
	HasTotpSecret   bool
	NightscoutToken string
	Enabled         bool
}

func IdentityModelToUserIdentity(identity *user.Identity, currentIdentityName string, nightscoutToken string) *UserIdentity {
	lastSeen := "Never"
	if identity.LastSeenAt != nil && *identity.LastSeenAt != 0 {
		lastSeen = time.UnixMilli(*identity.LastSeenAt).Format("2006-01-02 15:04:05")
	}

	return &UserIdentity{
		ID:              strconv.Itoa(int(identity.ID)),
		Name:            identity.Name,
		Created:         time.UnixMilli(identity.CreatedAt).Format("2006-01-02 15:04:05"),
		LastSeen:        lastSeen,
		Role:            string(identity.Role),
		CurrentIdentity: identity.Name == currentIdentityName,
		HasTotpSecret:   identity.TotpSecret != "",
		NightscoutToken: nightscoutToken,
		Enabled:         identity.Enabled,
	}
}

templ Identities(admins []*UserIdentity, users []*UserIdentity, devices []*UserIdentity, syncs []*UserIdentity) {
	@UserBase(UserContext{Subdomain: "example.com"}) {
		@IdentitesForm(admins, users, devices, syncs)
	}
}

templ IdentitesForm(admins []*UserIdentity, users []*UserIdentity, devices []*UserIdentity, syncs []*UserIdentity) {
	<div id="mainForm">
		<div class="mb-4 border-b border-white/10 pb-3">
			<h3 class="text-lg font-semibold">
				Identity Settings
			</h3>
			<p class="mt-2 text-sm text-gray-400 leading-relaxed">
				An Identity is a user or device that can write or read your data.
				This is where you can manage different identities. We recommend a different identity per device you
				connect to NightTroop. All passwords are randomly generated and can be copied with the "Copy Password" button.
				For TOTP passwords, use the button to display the TOTP secret as a QR code. On identities that can access the
				Nightscout API, use "Copy Nightscout Token".
			</p>
		</div>
		<div id="adminsTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Admins</div>
			@buildIdentityTable(admins)
			@formCreateIdentity("Admin", "admin")
		</div>
		<div id="usersTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Users</div>
			@buildIdentityTable(users)
			@formCreateIdentity("Read User", "read")
			@formCreateIdentity("Read+Write User", "read+write")
		</div>
		<div id="devicesTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Devices</div>
			@buildIdentityTable(devices)
			@formCreateIdentity("Read Device", "read")
			@formCreateIdentity("Read+Write Device", "read+write")
		</div>
		<div id="syncsTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Syncs</div>
			@buildIdentityTable(syncs)
		</div>
		<!-- Error -->
		<div id="error-container" class="mt-4"></div>
	</div>
}

templ buildIdentityTable(identities []*UserIdentity) {
	@table.Table() {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Name 
				}
				@table.Head() {
					Role 
				}
				@table.Head() {
					Created at 
				}
				@table.Head() {
					Last Seen 
				}
				@table.Head() {
					Actions
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@table.Row() {
					@table.Cell() {
						{ identity.Name }
					}
					@table.Cell() {
						{ identity.Role }
					}
					@table.Cell() {
						{ identity.Created }
					}
					@table.Cell() {
						{ identity.LastSeen }
					}
					@table.Cell() {
						<!-- actions go here -->
					}
				}
			}
		}
	}
}

templ formCreateIdentity(name, role string) {
	<div class="flex justify-end mt-4">
		<form
			hx-post="/identities"
			hx-target="#deviceTableBody"
			hx-swap="beforeend"
			hx-on::after-request="if(event.detail.successful) { this.reset(); }"
			hx-target-error="#error-container"
		>
			<input type="hidden" name="role" value={ role }/>
			<div class="flex w-80 items-end gap-2">
				@form.Item(form.ItemProps{
					Class: "w-32",
				}) {
					@input.Input(input.Props{
						ID:          "name",
						Type:        "text",
						Name:        "name",
						Placeholder: "admin",
						Required:    true,
					})
				}
				@form.Item(form.ItemProps{
					Class: "w-32 items-end",
				}) {
					@button.Button(button.Props{
						Type: "submit",
					}) {
						Add { name }
					}
				}
			</div>
		</form>
	</div>
}
