package user_templ

import (
	"nighttroop.t1d.nz/data/sql/user"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
	"strconv"
	"time"
)

type UserIdentity struct {
	ID              string
	Name            string
	Created         string
	LastSeen        string
	Role            string
	CurrentIdentity bool
	HasTotpSecret   bool

	Enabled bool
}

type RoleOption struct {
	Label string
	Value consts.IdentityRole
}

func IdentityModelToUserIdentity(identity *user.Identity, currentIdentityName string) *UserIdentity {
	lastSeen := "Never"
	if identity.LastSeenAt != nil && *identity.LastSeenAt != 0 {
		lastSeen = time.UnixMilli(*identity.LastSeenAt).Format("2006-01-02 15:04:05")
	}

	return &UserIdentity{
		ID:              strconv.Itoa(int(identity.ID)),
		Name:            identity.Name,
		Created:         time.UnixMilli(identity.CreatedAt).Format("2006-01-02 15:04:05"),
		LastSeen:        lastSeen,
		Role:            string(identity.Role),
		CurrentIdentity: identity.Name == currentIdentityName,
		HasTotpSecret:   identity.TotpSecret != "",
		Enabled:         identity.Enabled,
	}
}

templ Identities(users []*UserIdentity, devices []*UserIdentity) {
	@UserBase(UserContext{Subdomain: "example.com"}) {
		@IdentitesTable(users, devices)
	}
}

templ IdentitesTable(users []*UserIdentity, devices []*UserIdentity) {
	<div id="identities_table">
		<div class="mb-4 border-b border-white/10 pb-3">
			<div class="max-w-4xl mx-auto p-6 space-y-6">
				<div class="text-center">
					<h1 class="text-2xl font-bold">Users & Devices </h1>
					<p class="text-gray-500 mt-2">
						Nighttroop uses strict role separation to improve security and reduce credential risk.
					</p>
				</div>
				<!-- Admin -->
				<div class="border rounded-xl p-5 bg-red-50 border-red-200">
					<h2 class="text-lg font-semibold text-red-700">Admin</h2>
					<p class="mt-2 text-gray-700">
						Admins manage the system: they can create and manage users, configure site settings, and maintain the platform.
						For security reasons, admin accounts cannot access the Nightscout API.
					</p>
					<ul class="mt-3 list-disc list-inside text-gray-700 space-y-1">
						<li>Protected with TOTP-based two-factor authentication</li>
						<li>No direct Nightscout API access</li>
						<li>Recovery only via initial backup key</li>
					</ul>
				</div>
				<!-- User -->
				<div class="border rounded-xl p-5 bg-blue-50 border-blue-200">
					<h2 class="text-lg font-semibold text-blue-700">User</h2>
					<p class="mt-2 text-gray-700">
						A user represents a person using the system.
						Users can log in, generate reports, interact with Nighttroop, and use Nightscout features.
					</p>
				</div>
				<!-- Device -->
				<div class="border rounded-xl p-5 bg-green-50 border-green-200">
					<h2 class="text-lg font-semibold text-green-700">Device</h2>
					<p class="mt-2 text-gray-700">
						A device is a connected endpoint such as a phone, SugarPixel, or display.
						It can communicate with the Nightscout API but cannot log into the website.
						It can also have a status, like battery level, to alert on, and recieve notifications once registered.
						The Person With Diabetes (PWD) phone is a special device whose credentials you put into the loop (AAPS, Trio...).
					</p>
				</div>
				<!-- Footer note -->
				<div class="text-sm text-gray-500 text-center pt-2">
					These distinctions enforce strong security boundaries. Each user and device should use separate credentials.
				</div>
			</div>
		</div>
		<div id="usersTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Admins & Users</div>
			@buildIdentityTable("usersTable", users)
			<div class="border border-black-900"></div>
			@formCreateIdentity("usersTable", "User", []RoleOption{{Label: "Admin", Value: consts.IdentityRoleAdmin}, {Label: "User", Value: consts.IdentityRoleUser}, {Label: "Read Only User", Value: consts.IdentityRoleUserReadOnly}})
		</div>
		<div id="devicesTable" class="border border-gray-300 rounded-lg mb-6 p-4">
			<div>Devices</div>
			@buildIdentityTable("devicesTable", devices)
			<div class="border border-black-900"></div>
			@formCreateIdentity("devicesTable", "Device", []RoleOption{{Label: "Read", Value: consts.IdentityRoleDeviceRead}, {Label: "Read+Write", Value: consts.IdentityRoleDeviceReadWrite}, {Label: "PWD Phone", Value: consts.IdentityRoleDevicePWDPhone}})
		</div>
		<!-- Error -->
		<div id="error-container" class="mt-4"></div>
		<div id="modal-container"></div>
	</div>
}

templ buildIdentityTable(id string, identities []*UserIdentity) {
	@table.Table(table.Props{
		ID:    id,
		Class: "border border-gray-300 rounded-lg mb-6",
	}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Name 
				}
				@table.Head() {
					Role 
				}
				@table.Head() {
					Created at 
				}
				@table.Head() {
					Last Seen 
				}
				@table.Head() {
					Actions
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@createTableRowForIdentity(identity)
			}
		}
	}
}

templ createTableRowForIdentity(identity *UserIdentity) {
	@table.Row() {
		@table.Cell() {
			{ identity.Name }
		}
		@table.Cell() {
			{ identity.Role }
		}
		@table.Cell() {
			{ identity.Created }
		}
		@table.Cell() {
			{ identity.LastSeen }
		}
		@table.Cell() {
			<!-- actions go here -->
		}
	}
}

templ formCreateIdentity(tableid string, name string, roles []RoleOption) {
	{{ formID := "createIdentityForm" + tableid }}
	<div class="flex justify-end items-end mt-4">
		<form
			id={ formID }
			hx-post="/identities"
			hx-target={ "#" + tableid + " tbody" }
			hx-swap="beforeend"
			hx-target-error="#error-container"
		>
			<div class="flex w-x1 justify-end items-end gap-2">
				@form.Item(form.ItemProps{
					Class: "w-24",
				}) {
					@input.Input(input.Props{
						ID:          "name-" + formID,
						Type:        "text",
						Name:        "name",
						Placeholder: "Name",
						Required:    true,
					})
				}
				if (len(roles) == 1) {
					<input type="hidden" name="role" value={ string(roles[0].Value) }/>
				} else {
					@form.Item(form.ItemProps{
						Class: "w-40",
					}) {
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:   "select-form-" + formID,
								Name: "role",
								Form: formID,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Role",
								})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									for i, role := range roles {
										@selectbox.Item(selectbox.ItemProps{
											Value:    string(role.Value),
											Selected: i == 0,
										}) {
											{ role.Label }
										}
									}
								}
							}
						}
					}
				}
				@form.Item(form.ItemProps{
					Class: " items-end",
				}) {
					@button.Button(button.Props{
						Type: "submit",
					}) {
						Add { name }
					}
				}
			</div>
		</form>
	</div>
}

templ CreateIdentityResponse(url string, identity *UserIdentity, password string, totpSecret *string, nsToken *string) {
	@createTableRowForIdentity(identity)
	<div id="modal-container" class="w-full" hx-swap-oob="innerHTML">
		@newIdentityModal(url, identity, password, totpSecret, nsToken)
	</div>
}

templ newIdentityModal(url string, identity *UserIdentity, password string, totpSecret *string, nsToken *string) {
	<div class="fixed inset-0 bg-black/50 flex items-center justify-center">
		<div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md flex flex-col items-center justify-center">
			@createdUserInfo(url, identity.Name, password, totpSecret, nsToken)
			@button.Button(button.Props{
				Class:   "mt-4",
				Variant: button.VariantDestructive,
				Attributes: templ.Attributes{
					"hx-get":    "/empty",
					"hx-target": "#modal-container",
					"hx-swap":   "innerHTML",
				},
			}) {
				I Have Saved These
			}
		</div>
	</div>
}

templ createdUserInfo(url string, username string, password string, totpSecret *string, nsToken *string) {
	<div class="text-left w-full max-w-2xl mx-auto space-y-2">
		<div class="flex items-start gap-2 mb-4">
			<p class="font-bold text-green-800">Save this information in a secure place</p>
		</div>
		<div class="relative group rounded-xl border border-slate-200 bg-slate-50 shadow-sm overflow-hidden">
			<div class="flex items-center justify-between border-b border-slate-200 bg-slate-100/70 px-4 py-2.5">
				<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your Credentials</span>
				if totpSecret != nil && nsToken != nil {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password + "\nTOTP Secret: " + *totpSecret + "\nNightscout Token: " + *nsToken }</textarea>
				} else if totpSecret != nil {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password + "\nTOTP Secret: " + *totpSecret }</textarea>
				} else if nsToken != nil {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password + "\nNightscout Token: " + *nsToken }</textarea>
				} else {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password }</textarea>
				}
				<!-- Clear, High-Visibility Copy Button -->
				<div class="inline-flex shadow-sm rounded-lg">
					@copybutton.CopyButton(copybutton.Props{
						TargetID: "textToCopy",
						Class:    "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-medium rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/20",
					})
				</div>
			</div>
			<!-- Monospace Content Area -->
			<div class="p-4 font-mono text-sm text-slate-800 space-y-2 select-all bg-white">
				<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Site:</span><span class="break-all">{ url }</span></div>
				<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Username:</span><span>{ username }</span></div>
				<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Password:</span><span class="break-all">{ password }</span></div>
				if nsToken != nil {
					<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Nightscout Token:</span><span class="break-all">{ *nsToken }</span></div>
				}
				if totpSecret != nil {
					<div class="flex">
						<div class="flex items-start gap-6">
							<!-- Left: label + secret -->
							<div class="flex">
								<span class="w-28 shrink-0 font-medium text-slate-400 select-none">
									TOTP Secret:
								</span>
							</div>
							<!-- Right: QR block -->
							<div class="flex flex-col items-center gap-2">
								<div id="qrcode" class="p-2 bg-white rounded-lg shadow-sm border border-slate-200"></div>
								<span class="text-xs text-slate-400">Scan with authenticator</span>
							</div>
						</div>
						<script type="text/javascript">
							var qrcode = new QRCode(document.getElementById("qrcode"), {
								text: "{{ totpSecret }}",
								width: 128,
								height: 128,
								colorDark : "#000000",
								colorLight : "#ffffff",
								correctLevel : QRCode.CorrectLevel.H
							});
							</script>
					</div>
				}
			</div>
		</div>
	</div>
}
