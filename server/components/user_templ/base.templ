package user_templ

import "nighttroop.t1d.nz/server/components/shared_templ"

type UserContext struct {
	Subdomain string
}

templ UserBase(userContext UserContext) {
	@shared_templ.Base("Nighttroop for " + userContext.Subdomain) {
		@Header()
		<div
			id="main-content"
			class="container center-container d-flex align-items-center justify-content-center py-4"
		>
			{ children... }
		</div>
		@Footer()
	}
}

templ Header() {
	<nav class="navbar navbar-expand-lg navbar-dark glass-nav shadow-sm mb-4">
		<div class="container">
			<a
				class="navbar-brand text-uppercase fw-bold"
				href="/"
			>
				Nighttroop
			</a>
			<button
				class="navbar-toggler"
				type="button"
				data-bs-toggle="collapse"
				data-bs-target="#navbarNav"
			>
				<span class="navbar-toggler-icon"></span>
			</button>
			<div
				class="collapse navbar-collapse"
				id="navbarNav"
			>
				<ul class="navbar-nav ms-auto align-items-center">
					<!-- Dashboard -->
					<li class="nav-item me-lg-2">
						<a
							class="nav-link active"
							href="/"
							aria-label="Dashboard"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								fill="currentColor"
								class="bi bi-house-door-fill"
								viewBox="0 0 16 16"
							>
								<path
									d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5"
								></path>
							</svg>
						</a>
					</li>
					<!-- Profile -->
					<li class="nav-item dropdown">
						<a
							class="nav-link dropdown-toggle d-flex align-items-center"
							href="#"
							id="profileDropdown"
							role="button"
							data-bs-toggle="dropdown"
							aria-expanded="false"
						>
							<div
								class="rounded-circle bg-secondary d-flex align-items-center justify-content-center profile-avatar"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									fill="white"
									class="bi bi-person-fill"
									viewBox="0 0 16 16"
								>
									<path
										d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"
									></path>
								</svg>
							</div>
						</a>
						<ul
							class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow"
							aria-labelledby="profileDropdown"
						>
							<li>
								<h6 class="dropdown-header">
									Settings
								</h6>
							</li>
							<li>
								<a
									class="dropdown-item"
									href="#"
								>
									Account
								</a>
							</li>
							<li>
								<a
									class="dropdown-item"
									href="#"
								>
									Security
								</a>
							</li>
							<li>
								<a
									class="dropdown-item"
									href="#"
								>
									Data
								</a>
							</li>
							<li>
								<a
									class="dropdown-item"
									href="#"
								>
									Reports
								</a>
							</li>
							<li>
								<a
									class="dropdown-item"
									hx-get="/identities"
									hx-target="#main-content"
									hx-push-url="true"
									hx-swap="innerHTML"
								>
									User/Device Identities
								</a>
							</li>
							<li>
								<a
									class="dropdown-item"
									hx-get="/sync_settings"
									hx-target="#main-content"
									hx-push-url="true"
									hx-swap="innerHTML"
								>
									Sync
								</a>
							</li>
							<li>
								<hr class="dropdown-divider"/>
							</li>
							<li>
								<form
									method="POST"
									action="/logout"
									class="px-3 py-1"
								>
									<button
										type="submit"
										class="btn btn-danger btn-sm w-100 text-center"
									>
										Logout
									</button>
								</form>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</nav>
}

templ Footer() {
	<footer class="border-top bg-white py-4 mt-5">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-md-4 text-center text-md-start">
					<span class="text-muted fw-bold">
						© 2026 Nighttroop Application
					</span>
				</div>
				<div class="col-md-4 text-center my-3 my-md-0">
					<ul class="list-inline mb-0">
						<li class="list-inline-item">
							<a
								href="#"
								class="text-muted text-decoration-none footer-link"
							>
								Privacy
							</a>
						</li>
						<li class="list-inline-item mx-3">
							<a
								href="#"
								class="text-muted text-decoration-none footer-link"
							>
								Terms
							</a>
						</li>
						<li class="list-inline-item">
							<a
								href="#"
								class="text-muted text-decoration-none footer-link"
							>
								Support
							</a>
						</li>
					</ul>
				</div>
				<div class="col-md-4 text-center text-md-end">
					<a
						href="#"
						class="text-muted me-3 footer-link"
					>
						GitHub
					</a>
					<a
						href="#"
						class="text-muted footer-link"
					>
						Twitter
					</a>
				</div>
			</div>
		</div>
	</footer>
}
