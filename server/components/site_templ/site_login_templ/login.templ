package site_login_templ

import (
	"nighttroop.t1d.nz/server/components/site_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/toast"
)

templ Login() {
	@site_templ.Base() {
		// It fills the window, so the form is in its middle with nothing to scroll
		<div class="flex flex-1 flex-col justify-center items-center px-6 py-6 lg:px-8 bg-slate-50">
			<div class="p-8 login-form-target rounded-lg shadow-2xl w-full max-w-96">
				<!-- Form updated with POST method -->
				<form
					hx-post="/login"
					hx-target="closest .login-form-target"
					hx-swap="outerHTML"
					hx-status:4xx="target:#toaster swap:beforeend"
					hx-status:5xx="target:#toaster swap:beforeend"
				>
					<div class="text-center mb-6">
						<img src="/logo.svg" alt="" class="mx-auto mb-3 size-16"/>
						<h2 class="font-bold text-2xl">NightTroop Login</h2>
					</div>
					<!-- Username -->
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{
							For: "site--login--name",
						}) {
							Name
						}
						@input.Input(input.Props{
							ID:          "site--login--name",
							Type:        "text",
							Name:        "name",
							Placeholder: "admin",
							Required:    true,
							Attributes: templ.Attributes{
								"autocapitalize": "none",
								"autocorrect":    "off",
								"autofocus":      "true",
							},
						})
					}
					<div class="mt-4"></div>
					<!-- Password -->
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{
							For: "site--login--password",
						}) {
							Password
						}
						@input.Input(input.Props{
							ID:          "site--login--password",
							Type:        "password",
							Name:        "password",
							Placeholder: "••••••••",
							Required:    true,
						})
					}
					<div class="mt-4"></div>
					<!-- Submit Button -->
					@button.Button(button.Props{
						ID:    "site--login-button",
						Type:  button.TypeSubmit,
						Class: "w-full py-3 px-4 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg shadow-sm transition-colors cursor-pointer",
					}) {
						Log In
					}
				</form>
			</div>
		</div>
	}
}

// LoginTOTP is the login's second step, which takes the place of its first's form, so it stays in the window's middle
templ LoginTOTP() {
	<div class="p-8 login-form-target rounded-lg shadow-2xl w-full max-w-96">
			<!-- Form updated with POST method -->
			<form
				id="otp"
				hx-post="/login/totp"
				hx-target="body"
				hx-swap="outerHTML"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
				class="needs-validation"
			>
				<div class="text-center mb-6">
					<img src="/logo.svg" alt="" class="mx-auto mb-3 size-16"/>
					<h2 class="font-bold text-2xl">NightTroop Login</h2>
				</div>
				<!-- TOTP -->
				@form.Item() {
					@form.Label(form.LabelProps{
						For: "otp-form",
					}) {
						Verification Code
					}
					@inputotp.InputOTP(inputotp.Props{
						ID:       "otp-form",
						HasError: true,
						Form:     "otp",
						Name:     "totp",
					}) {
						@inputotp.Group() {
							@inputotp.Slot(inputotp.SlotProps{
								InputID: "site--login--otp-1",
								Index:   0,
								Focus:   true,
							})
							@inputotp.Slot(inputotp.SlotProps{
								InputID: "otp-2",
								Index:   1,
							})
							@inputotp.Slot(inputotp.SlotProps{
								InputID: "otp-3",
								Index:   2,
							})
							@inputotp.Separator()
							@inputotp.Slot(inputotp.SlotProps{
								InputID: "otp-4",
								Index:   3,
							})
							@inputotp.Slot(inputotp.SlotProps{
								InputID: "otp-5",
								Index:   4,
							})
							@inputotp.Slot(inputotp.SlotProps{
								InputID: "otp-6",
								Index:   5,
							})
						}
					}
					@form.Description() {
						Enter the 6-digit TOTP code
					}
				}
				<div class="mt-4"></div>
				<!-- Submit Button -->
				@button.Button(button.Props{
					ID:    "site--login-totp-button",
					Type:  button.TypeSubmit,
					Class: "w-full py-3 px-4 bg-brand-night hover:bg-brand-night/90 text-white text-lg font-bold rounded-lg shadow-sm transition-colors cursor-pointer",
				}) {
					Log In
				}
			</form>
			<script>
				// Logs in as soon as the code's last digit is typed or pasted. It waits a tick for the code's slots to
				// fill its value, and does not send the same code twice, so a wrong code is not sent again on its own.
				(function () {
					const form = document.getElementById("otp");
					const code = document.getElementById("otp-form");
					let sent = "";
					const sendWhenFull = () => setTimeout(() => {
						if (/^\d{6}$/.test(code.value) && code.value !== sent) {
							sent = code.value;
							form.requestSubmit();
						}
					}, 0);
					form.addEventListener("input", sendWhenFull);
					form.addEventListener("paste", sendWhenFull);
				})();
			</script>
	</div>
}

templ LoginError(err string) {
	@toast.Toast(toast.Props{
		Description: err,
		Variant:     toast.VariantError,
		Position:    toast.PositionTopCenter,
		Dismissible: true,
		Icon:        true,
	})
}
