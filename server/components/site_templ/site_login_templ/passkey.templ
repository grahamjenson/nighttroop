package site_login_templ

import (
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/utils/i18n"
)

// PasskeyLogin signs in with any of the site's, or control's, passkeys the browser has, with no name or password
// typed; its elements' IDs start with prefix. Its button is the login's own button's size, outlined so the password
// login stays the first choice.
templ PasskeyLogin(prefix string) {
	<div class="mt-4"></div>
	@button.Button(button.Props{
		ID:         prefix + "--passkey",
		Type:       button.TypeButton,
		Variant:    button.VariantOutline,
		Size:       button.SizeXl,
		FullWidth:  true,
		Class:      "text-primary",
		Attributes: templ.Attributes{"data-passkey-begin": "/login/passkey/begin", "data-passkey-finish": "/login/passkey/finish", "data-passkey-error": prefix + "--passkey-error"},
	}) {
		{ i18n.T(ctx, "site.login.passkey") }
	}
	<p id={ prefix + "--passkey-error" } class="mt-2 text-sm text-red-600"></p>
	@PasskeyScript()
}

// PasskeyScript makes each button with data-passkey-begin ask the browser for a passkey with the options the server
// begins with, then send what it made or signed to finish, going where finish says once done. WebAuthn's binary
// fields travel as base64url. A failure the browser gives no reason for says the passkey did not work, and a server
// that does not answer, as while it restarts, says to try again, in the page's language rather than the browser's
// own, such as Safari's "Load failed".
templ PasskeyScript() {
	<script data-passkey-failed={ i18n.T(ctx, "common.passkey.failed") } data-passkey-unreachable={ i18n.T(ctx, "common.passkey.unreachable") }>
		function passkey(begin, finish, headers, errorID, failed, unreachable) {
			const decode = s => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
			const encode = b => btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
			const fail = message => document.getElementById(errorID).textContent = message;
			// No answer, or one that is not the server's JSON, as a proxy's while it restarts, is the server not reached
			const post = (url, init) => fetch(url, {method: 'POST', ...init}).then(r => r.json()).catch(() => { throw new Error(unreachable); });
			post(begin, {headers}).then(options => {
				const o = options.publicKey;
				if (!o) throw new Error(options.error || unreachable);
				o.challenge = decode(o.challenge);
				(o.excludeCredentials || o.allowCredentials || []).forEach(c => c.id = decode(c.id));
				if (o.user) o.user.id = decode(o.user.id);
				return o.user ? navigator.credentials.create({publicKey: o}) : navigator.credentials.get({publicKey: o});
			}).then(credential => {
				const response = {};
				for (const key of ['clientDataJSON', 'attestationObject', 'authenticatorData', 'signature', 'userHandle']) {
					if (credential.response[key]) response[key] = encode(credential.response[key]);
				}
				const body = JSON.stringify({id: credential.id, rawId: encode(credential.rawId), type: credential.type, response});
				return post(finish, {headers: {...headers, 'Content-Type': 'application/json'}, body});
			}).then(done => {
				if (!done.redirect) throw new Error(done.error || unreachable);
				window.location = done.redirect;
			}).catch(e => fail(e.message || failed));
		}
		{
			const {passkeyFailed, passkeyUnreachable} = document.currentScript.dataset;
			document.querySelectorAll('[data-passkey-begin]').forEach(button => button.addEventListener('click', () => {
				passkey(button.dataset.passkeyBegin, button.dataset.passkeyFinish, {}, button.dataset.passkeyError, passkeyFailed, passkeyUnreachable);
			}));
		}
	</script>
}
