package site_templ

import (
	"slices"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/ui/button"
)

// alarmNames are how the site's pages name each alarm
var alarmNames = map[string]string{
	"urgent_low": "Urgent low", "low": "Low", "predicted_low": "Low predicted", "urgent_high": "Urgent high", "high": "High", "fast_rise": "Rising fast", "fast_drop": "Dropping fast", "no_data": "No data", "device_battery": "Device battery",
}

// Alarms holds the signed in identity's alarm banner under the header on every page, staying in the window when the
// header slides away. The alarms collection's stream
// sends an event as each of the identity's alarms is created, updated or deleted, and the banner is loaded again then,
// and each time it connects.
templ Alarms() {
	<div id="site--alarms" hx-sse:connect="/data/alarms/events">
		<div
			id="site--alarms--content"
			hx-get="/data/alarms"
			hx-trigger="created from:#site--alarms, updated from:#site--alarms, deleted from:#site--alarms, htmx:sse:after:connection from:#site--alarms"
			hx-swap="innerHTML"
		></div>
	</div>
}

// AlarmBanner is the identity's alerting alarms, each with a snooze. When none is alerting it shows the ones that
// are snoozed, quietly, and when none is active it is empty.
templ AlarmBanner(models []*sitemodels.SiteAlarm) {
	{{ alerting := slices.ContainsFunc(models, func(alarm *sitemodels.SiteAlarm) bool { return alarm.Alerting }) }}
	for _, alarm := range models {
		if alarm.Alerting || !alerting {
			@AlarmRow(alarm)
		}
	}
}

// AlarmRow is one alarm in the banner: alerting, red when urgent and amber otherwise, with a button that deletes it
// to snooze it for 30 minutes, or snoozed
templ AlarmRow(alarm *sitemodels.SiteAlarm) {
	if alarm.Alerting {
		<div
			id={ "site--alarms--alarm-" + alarm.ID }
			role="alert"
			class={ "flex items-center justify-between gap-4 px-4 py-3 text-sm font-semibold shadow-sm sm:px-6 lg:px-8",
				templ.KV("bg-red-600 text-white", alarm.Urgent), templ.KV("bg-amber-400 text-gray-900", !alarm.Urgent) }
		>
			<span>Alarm: { alarmNames[alarm.ID] }</span>
			@button.Button(button.Props{
				ID:      "site--alarms--snooze-" + alarm.ID,
				Variant: button.VariantSecondary,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"hx-delete":     "/data/alarms/" + alarm.ID,
					"hx-target":     "#site--alarms--alarm-" + alarm.ID,
					"hx-swap":       "outerHTML",
					"hx-status:4xx": "target:#toaster swap:beforeend",
				},
			}) {
				Snooze 30 min
			}
		</div>
	} else {
		<div id={ "site--alarms--alarm-" + alarm.ID } class="bg-gray-100 px-4 py-1 text-xs text-gray-600 sm:px-6 lg:px-8">
			Snoozed: { alarmNames[alarm.ID] }
		</div>
	}
}
