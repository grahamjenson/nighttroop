package site_templ

import (
	"context"
	"slices"
	"strings"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// alarmNames are the ids of the messages the site's pages name each alarm by
var alarmNames = map[string]string{
	"urgent_low": "site.alarms.urgent_low", "low": "site.alarms.low", "predicted_low": "site.alarms.predicted_low", "urgent_high": "site.alarms.urgent_high",
	"high": "site.alarms.high", "fast_rise": "site.alarms.fast_rise", "fast_drop": "site.alarms.fast_drop", "no_data": "site.alarms.no_data",
	"device_battery": "site.alarms.device_battery",
}

// alarmName is how the site's pages name the alarm, in the context's language, or "" for one they do not name
func alarmName(ctx context.Context, id string) string {
	if name, ok := alarmNames[id]; ok {
		return i18n.T(ctx, name)
	}
	return ""
}

// snoozeEnd is when a snooze ends, in ms, as the identity's, site's or default settings show a time, with no seconds:
// 14:35, or 02:35 PM on a 12 hour clock
func snoozeEnd(ctx context.Context, until int64) string {
	location, layout := time.UTC, time.TimeOnly
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil {
		location, layout = siteContext.GetSettings().Location(), siteContext.GetSettings().TimeLayout()
	}
	return time.UnixMilli(until).In(location).Format(strings.Replace(layout, ":05", "", 1))
}

// Alarms holds the signed in identity's alarm banner under the header on every page. The alarms collection's stream
// sends an event as each of the identity's alarms is created, updated or deleted, and the banner is loaded again then,
// and each time it connects.
templ Alarms() {
	<div id="site--alarms" class="sticky top-14 z-30" hx-sse:connect="/data/alarms/events">
		<div
			id="site--alarms--content"
			hx-get="/data/alarms"
			hx-trigger="created from:#site--alarms, updated from:#site--alarms, deleted from:#site--alarms, htmx:sse:after:connection from:#site--alarms"
			hx-swap="innerHTML"
		></div>
	</div>
}

// AlarmBanner is the identity's alerting alarms, each with a snooze. When none is alerting it shows the ones that
// are snoozed, quietly, and when none is active it is empty.
templ AlarmBanner(models []*sitemodels.SiteAlarm) {
	{{ alerting := slices.ContainsFunc(models, func(alarm *sitemodels.SiteAlarm) bool { return alarm.Alerting }) }}
	for _, alarm := range models {
		if alarm.Alerting || !alerting {
			@AlarmRow(alarm)
		}
	}
}

// AlarmRow is one alarm in the banner: alerting, red when urgent and amber otherwise, with a button that deletes it
// to snooze it for 30 minutes, or snoozed, with when its snooze ends
templ AlarmRow(alarm *sitemodels.SiteAlarm) {
	if alarm.Alerting {
		<div
			id={ "site--alarms--alarm-" + alarm.ID }
			role="alert"
			class={ "flex items-center justify-between gap-4 px-4 py-3 text-sm font-semibold shadow-sm sm:px-6 lg:px-8",
				templ.KV("bg-red-600 text-white", alarm.Urgent), templ.KV("bg-amber-400 text-gray-900", !alarm.Urgent) }
		>
			<span>{ i18n.T(ctx, "site.alarms.alarm", i18n.Data{"AlarmName": alarmName(ctx, alarm.ID)}) }</span>
			@button.Button(button.Props{
				ID:      "site--alarms--snooze-" + alarm.ID,
				Variant: button.VariantSecondary,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"hx-delete":     "/data/alarms/" + alarm.ID,
					"hx-target":     "#site--alarms--alarm-" + alarm.ID,
					"hx-swap":       "outerHTML",
					"hx-status:4xx": "target:#toaster swap:beforeend",
					"hx-status:5xx": "target:#toaster swap:beforeend",
				},
			}) {
				{ i18n.T(ctx, "site.alarms.snooze") }
			}
		</div>
	} else {
		<div id={ "site--alarms--alarm-" + alarm.ID } class="bg-gray-100 px-4 py-1 text-xs text-gray-600 sm:px-6 lg:px-8">
			if alarm.SnoozedUntil != nil {
				{ i18n.T(ctx, "site.alarms.snoozed_until", i18n.Data{"AlarmName": alarmName(ctx, alarm.ID), "Until": snoozeEnd(ctx, *alarm.SnoozedUntil)}) }
			} else {
				{ i18n.T(ctx, "site.alarms.snoozed", i18n.Data{"AlarmName": alarmName(ctx, alarm.ID)}) }
			}
		</div>
	}
}
