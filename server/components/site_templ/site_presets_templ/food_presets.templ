package site_presets_templ

import (
	"context"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// FoodPresetsTable shows one page of food presets, newest first, with buttons to the pages either side
templ FoodPresetsTable(foodPresets []*sitemodels.SiteFoodPreset, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "food_presets_table",
		Title:       i18n.T(ctx, "site.presets.food.title"),
		Description: i18n.T(ctx, "site.presets.food.explanation"),
		Action:      addmodal.Open("presets--food--add", "/presets/food/new", i18n.T(ctx, "site.presets.food.add")),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "foodPresetsTable",
			EmptyID: "presets--food--empty",
			Empty:   i18n.T(ctx, "site.presets.food.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.presets.food.name")}, {Label: i18n.T(ctx, "site.presets.food.carbs"), Numeric: true},
				{Label: i18n.T(ctx, "site.presets.food.absorption"), Numeric: true}, {Label: i18n.T(ctx, "site.presets.food.category")},
				{Actions: true},
			},
		},
		Pager: &pager.Props{ID: "presets--food", Path: "/presets/food", Count: len(foodPresets), Skip: skip, Limit: limit},
	}) {
		for _, foodPreset := range foodPresets {
			@foodPresetRow(foodPreset)
		}
	}
}

// FoodPresetNew adds a food preset with all its fields, putting its row at the top of the table
templ FoodPresetNew() {
	@addmodal.Modal(addmodal.Props{ID: "presets--food--create", Title: i18n.T(ctx, "site.presets.food.add"), Path: "/presets/food",
		Target: "#foodPresetsTable tbody", Submit: i18n.T(ctx, "site.presets.food.add"), Fields: foodPresetFields(ctx)})
}

// foodPresetFields are what a food preset has that a person can type in, as a food intake has, less its time and notes
func foodPresetFields(ctx context.Context) []addmodal.Field {
	return []addmodal.Field{
		{Name: "name", Column: "food_presets.Name", Label: i18n.T(ctx, "site.presets.food.name"), Help: i18n.T(ctx, "site.presets.food.name_help"), Required: true, Kind: addmodal.Text},
		{Name: "carbs", Column: "food_presets.Carbs", Label: i18n.T(ctx, "site.presets.food.carbs"), Help: i18n.T(ctx, "site.presets.food.carbs_help"), Step: "any"},
		{Name: "absorption_time_minutes", Column: "food_presets.AbsorptionTimeMinutes", Label: i18n.T(ctx, "site.presets.food.absorption_time"), Help: i18n.T(ctx, "site.presets.food.absorption_time_help"), Step: "1"},
		{Name: "fat", Column: "food_presets.Fat", Label: i18n.T(ctx, "site.presets.food.fat"), Help: i18n.T(ctx, "site.presets.food.fat_help"), Step: "any"},
		{Name: "protein", Column: "food_presets.Protein", Label: i18n.T(ctx, "site.presets.food.protein"), Help: i18n.T(ctx, "site.presets.food.protein_help"), Step: "any"},
		{Name: "fibre", Column: "food_presets.Fibre", Label: i18n.T(ctx, "site.presets.food.fibre"), Help: i18n.T(ctx, "site.presets.food.fibre_help"), Step: "any"},
		{Name: "energy", Column: "food_presets.Energy", Label: i18n.T(ctx, "site.presets.food.energy"), Help: i18n.T(ctx, "site.presets.food.energy_help"), Step: "any"},
		{Name: "portions", Column: "food_presets.Portions", Label: i18n.T(ctx, "site.presets.food.portions"), Help: i18n.T(ctx, "site.presets.food.portions_help"), Step: "any"},
		{Name: "pre_bolus", Column: "food_presets.PreBolus", Label: i18n.T(ctx, "site.presets.food.pre_bolus"), Help: i18n.T(ctx, "site.presets.food.pre_bolus_help"), Step: "1"},
		{Name: "food_type", Column: "food_presets.FoodType", Label: i18n.T(ctx, "site.presets.food.type"), Help: i18n.T(ctx, "site.presets.food.type_help"), Kind: addmodal.Text,
			Options: []string{"meal", "snack", "hypo treatment"}},
		{Name: "category", Column: "food_presets.Category", Label: i18n.T(ctx, "site.presets.food.category"), Help: i18n.T(ctx, "site.presets.food.category_help"), Kind: addmodal.Text},
		{Name: "subcategory", Column: "food_presets.Subcategory", Label: i18n.T(ctx, "site.presets.food.subcategory"), Help: i18n.T(ctx, "site.presets.food.subcategory_help"), Kind: addmodal.Text},
	}
}

// foodPresetRow opens the food preset's details when clicked.
templ foodPresetRow(foodPreset *sitemodels.SiteFoodPreset) {
	@table.DataRow("presets--food--"+foodPreset.ID, "/presets/food/"+foodPreset.ID, i18n.T(ctx, "site.presets.food.delete_confirm")) {
		@table.Cell() {
			{ orDash(foodPreset.Name) }
		}
		@table.Cell(table.NumCell) {
			{ orDash(foodPreset.Carbs) }
		}
		@table.Cell(table.NumCell) {
			{ orDash(foodPreset.AbsorptionTimeMinutes) }
		}
		@table.Cell() {
			{ orDash(foodPreset.Category) }
		}
	}
}

templ FoodPresetModal(foodPreset *sitemodels.SiteFoodPreset) {
	{{ edit := addmodal.Props{ID: "presets--food--edit", Path: "/presets/food/" + foodPreset.ID, Target: "#presets--food--" + foodPreset.ID, Swap: "outerHTML",
		Submit: i18n.T(ctx, "site.presets.food.save"), Fields: addmodal.Edit(foodPresetFields(ctx), foodPreset, nil)} }}
	@modal.Modal(modal.Props{ID: "presets--food--details", Title: orDash(foodPreset.Name), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@site_data_templ.RecordDetails(site_data_templ.Record{ID: foodPreset.ID, App: foodPreset.CreatedByAppName, Device: foodPreset.CreatedByDeviceName, CreatedBy: foodPreset.CreatedByIdentityName, Created: foodPreset.CreatedAt, Updated: foodPreset.UpdatedAt, UpdatedBy: foodPreset.UpdatedByIdentityName})
		</dl>
	}
}

templ FoodPresetCreated(foodPreset *sitemodels.SiteFoodPreset) {
	@foodPresetRow(foodPreset)
}

// FoodPresetUpdated replaces the food preset's row, closes its details and shows a toast
templ FoodPresetUpdated(foodPreset *sitemodels.SiteFoodPreset) {
	@foodPresetRow(foodPreset)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.presets.food.updated"))
}

templ FoodPresetDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.presets.food.deleted"))
}
