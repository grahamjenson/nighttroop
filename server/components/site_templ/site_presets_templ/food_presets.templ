package site_presets_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// FoodPresetsTable shows one page of food presets, newest first, with buttons to the pages either side
templ FoodPresetsTable(foodPresets []*sitemodels.SiteFoodPreset, skip int64, limit int64) {
	<div id="food_presets_table" class="mx-auto max-w-5xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">Food Presets</h1>
			<p class="mt-1 text-gray-500">
				Foods kept to pick from, with what a portion has. Click one to see and edit it.
			</p>
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@foodPresetCreateForm()
			@table.Table(table.Props{
				ID:    "foodPresetsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Name
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Carbs g
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Absorption (minutes)
						}
						@table.Head() {
							Category
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(foodPresets) == 0 {
						<tr id="presets--food--empty"><td colspan="5" class="p-4 text-sm text-gray-500">No food presets here.</td></tr>
					}
					for _, foodPreset := range foodPresets {
						@foodPresetRow(foodPreset)
					}
				}
			}
			<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
				if len(foodPresets) > 0 {
					<span id="presets--food--showing">{ fmt.Sprintf("Showing %d to %d", skip+1, skip+int64(len(foodPresets))) }</span>
				} else {
					<span></span>
				}
				<div class="flex gap-2">
					if skip > 0 {
						@foodPresetPageButton("presets--food--previous", "Previous", max(skip-limit, 0), limit)
					}
					if int64(len(foodPresets)) == limit {
						@foodPresetPageButton("presets--food--next", "Next", skip+limit, limit)
					}
				</div>
			</div>
		</section>
		<div id="modal-container"></div>
	</div>
}

templ foodPresetPageButton(id string, label string, skip int64, limit int64) {
	@button.Button(button.Props{
		ID:      id,
		Variant: button.VariantOutline,
		Attributes: templ.Attributes{
			"hx-get":      fmt.Sprintf("/presets/food?skip=%d&limit=%d", skip, limit),
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

// foodPresetCreateForm adds a food preset, putting its row at the top of the table
templ foodPresetCreateForm() {
	<form
		id="presets--food--create"
		class="mb-4 flex items-center justify-end gap-2"
		hx-post="/presets/food"
		hx-target="#foodPresetsTable tbody"
		hx-swap="afterbegin"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		hx-on::after:request="if (ctx.response.status < 400) { this.reset(); document.getElementById('presets--food--empty')?.remove() }"
	>
		@foodPresetInputs("presets--food--create", "", "", "")
		@button.Button(button.Props{ID: "presets--food--create--submit", Type: button.TypeSubmit}) {
			Add Food Preset
		}
	</form>
}

templ foodPresetInputs(id string, name string, carbs string, absorption string) {
	<div class="w-48">
		@input.Input(input.Props{ID: id + "--name", Name: "name", Placeholder: "Name", Value: name, Required: true, Attributes: templ.Attributes{"maxlength": "64"}})
	</div>
	<div class="w-28">
		@input.Input(input.Props{
			ID:          id + "--carbs",
			Type:        input.TypeNumber,
			Name:        "carbs",
			Placeholder: "Carbs g",
			Value:       carbs,
			Attributes:  templ.Attributes{"step": "any", "min": "0", "max": "1000"},
		})
	</div>
	<div class="w-36">
		@input.Input(input.Props{
			ID:          id + "--absorption",
			Type:        input.TypeNumber,
			Name:        "absorption_time_minutes",
			Placeholder: "Absorption min",
			Value:       absorption,
			Attributes:  templ.Attributes{"step": "1", "min": "0", "max": "1440"},
		})
	</div>
}

// foodPresetRow opens the food preset's details when clicked. The delete button stops its click reaching the row.
templ foodPresetRow(foodPreset *sitemodels.SiteFoodPreset) {
	{{ id := "presets--food--" + foodPreset.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/presets/food/" + foodPreset.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ orDash(foodPreset.Name) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(foodPreset.Carbs) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(foodPreset.AbsorptionTimeMinutes) }
		}
		@table.Cell() {
			{ orDash(foodPreset.Category) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              "event.stopPropagation()",
						"hx-delete":            "/presets/food/" + foodPreset.ID,
						"hx-confirm":           "Delete this food preset?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": "if (ctx.response.status < 400) this.closest('tr').remove()",
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ FoodPresetModal(foodPreset *sitemodels.SiteFoodPreset) {
	<div id="presets--food--details" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
		<div class="w-full max-w-2xl rounded-lg bg-white p-6 shadow-lg">
			<h2 class="text-lg font-semibold">{ orDash(foodPreset.Name) }</h2>
			<form
				id="presets--food--edit"
				class="mt-4 flex items-center gap-2"
				hx-post={ "/presets/food/" + foodPreset.ID }
				hx-target={ "#presets--food--" + foodPreset.ID }
				hx-swap="outerHTML"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
			>
				@foodPresetInputs("presets--food--edit", orEmpty(foodPreset.Name), orEmpty(foodPreset.Carbs), orEmpty(foodPreset.AbsorptionTimeMinutes))
				@button.Button(button.Props{ID: "presets--food--edit--submit", Type: button.TypeSubmit}) {
					Save
				}
			</form>
			<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
				@presetDetail("ID", foodPreset.ID)
				@presetDetail("Food Type", orDash(foodPreset.FoodType))
				@presetDetail("Category", orDash(foodPreset.Category))
				@presetDetail("Subcategory", orDash(foodPreset.Subcategory))
				@presetDetail("Fat g", orDash(foodPreset.Fat))
				@presetDetail("Protein g", orDash(foodPreset.Protein))
				@presetDetail("Fibre g", orDash(foodPreset.Fibre))
				@presetDetail("Energy", orDash(foodPreset.Energy))
				@presetDetail("Portions", orDash(foodPreset.Portions))
				@presetDetail("Pre Bolus (minutes)", orDash(foodPreset.PreBolus))
				@presetDetail("App", orDash(foodPreset.CreatedByAppName))
				@presetDetail("Device", orDash(foodPreset.CreatedByDeviceName))
				@presetDetail("Created By", foodPreset.CreatedByIdentityName)
				@presetDetail("Created", formatDate(foodPreset.CreatedAt))
				@presetDetail("Updated", formatDate(foodPreset.UpdatedAt))
				@presetDetail("Updated By", orDash(foodPreset.UpdatedByIdentityName))
			</dl>
			if foodPreset.RawJsonData != nil {
				<pre class="mt-4 max-h-48 overflow-auto rounded bg-gray-50 p-2 text-xs">{ *foodPreset.RawJsonData }</pre>
			}
			<div class="mt-4 flex justify-end">
				@button.Button(button.Props{
					ID:      "presets--food--details--close",
					Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"hx-get":    "/empty",
						"hx-target": "#modal-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					Close
				}
			</div>
		</div>
	</div>
}

templ FoodPresetCreated(foodPreset *sitemodels.SiteFoodPreset) {
	@foodPresetRow(foodPreset)
}

// FoodPresetUpdated replaces the food preset's row, closes its details and shows a toast
templ FoodPresetUpdated(foodPreset *sitemodels.SiteFoodPreset) {
	@foodPresetRow(foodPreset)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@presetToast("Food Preset Updated")
	</div>
}

templ FoodPresetDeleted() {
	@presetToast("Food Preset Deleted")
}
