package site_presets_templ

import (
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/badge"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// ProfilePresetsTable shows one page of profiles, newest first, with buttons to the pages either side
templ ProfilePresetsTable(profiles []*sitemodels.SiteProfilePreset, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "profile_presets_table",
		Title:       i18n.T(ctx, "site.presets.profiles.title"),
		Description: i18n.T(ctx, "site.presets.profiles.explanation"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "profilePresetsTable",
			EmptyID: "presets--profiles--empty",
			Empty:   i18n.T(ctx, "site.presets.profiles.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.presets.profiles.name")}, {Label: i18n.T(ctx, "site.presets.profiles.default")},
				{Label: i18n.T(ctx, "site.presets.profiles.dia"), Numeric: true}, {Label: i18n.T(ctx, "site.presets.profiles.device")},
				{Label: i18n.T(ctx, "site.presets.profiles.uploaded")}, {Actions: true},
			},
		},
		Pager: &pager.Props{ID: "presets--profiles", Path: "/presets/profiles", Count: len(profiles), Skip: skip, Limit: limit},
	}) {
		for _, profile := range profiles {
			@profilePresetRow(profile)
		}
	}
}

// profilePresetRow opens the profile's details when clicked.
templ profilePresetRow(profile *sitemodels.SiteProfilePreset) {
	@table.DataRow("presets--profiles--"+profile.ID, "/presets/profiles/"+profile.ID, i18n.T(ctx, "site.presets.profiles.delete_confirm")) {
		@table.Cell() {
			{ orDash(profile.Name) }
		}
		@table.Cell() {
			if profile.IsDefault {
				@badge.Badge(badge.Props{Variant: badge.VariantGold}) {
					{ i18n.T(ctx, "site.presets.profiles.default") }
				}
			}
		}
		@table.Cell(table.NumCell) {
			{ orDash(profile.Dia) }
		}
		@table.Cell() {
			{ orDash(profile.CreatedByDeviceName) }
		}
		@table.Cell() {
			{ formatDate(ctx, profile.OccurredAt) }
		}
	}
}

templ ProfilePresetModal(profile *sitemodels.SiteProfilePreset) {
	{{ units := orEmpty(profile.Units) }}
	@modal.Modal(modal.Props{ID: "presets--profiles--details", Title: orDash(profile.Name), Subtitle: formatDate(ctx, profile.OccurredAt), Actions: modal.Submit("presets--profiles--edit", i18n.T(ctx, "site.presets.profiles.rename"))}) {
		<form
			id="presets--profiles--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/presets/profiles/" + profile.ID }
			hx-target={ "#presets--profiles--" + profile.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@field.Field("presets--profiles--edit--name", i18n.T(ctx, "site.presets.profiles.name"), "w-64") {
				@input.Input(input.Props{ID: "presets--profiles--edit--name", Name: "name", Placeholder: i18n.T(ctx, "site.presets.profiles.name"), Value: orEmpty(profile.Name), Required: true, Attributes: templ.Attributes{"maxlength": "64"}})
			}
		</form>
		<div id="presets--profiles--schedules" class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-5">
			@site_data_templ.ProfileSchedule("presets--profiles--basal-rates", i18n.T(ctx, "site.presets.profiles.basal"), profile.BasalRates, site_data_templ.ScheduleValue)
			@site_data_templ.ProfileSchedule("presets--profiles--carb-ratios", i18n.T(ctx, "site.presets.profiles.carb_ratio"), profile.CarbRatios, site_data_templ.ScheduleValue)
			@site_data_templ.ProfileSchedule("presets--profiles--sensitivities", i18n.T(ctx, "site.presets.profiles.sensitivity", i18n.Data{"GlucoseUnits": units}), profile.Sensitivities, site_data_templ.GlucoseValue(profile.Units))
			@site_data_templ.ProfileSchedule("presets--profiles--targets-low", i18n.T(ctx, "site.presets.profiles.low_target", i18n.Data{"GlucoseUnits": units}), profile.LowTargets, site_data_templ.GlucoseValue(profile.Units))
			@site_data_templ.ProfileSchedule("presets--profiles--targets-high", i18n.T(ctx, "site.presets.profiles.high_target", i18n.Data{"GlucoseUnits": units}), profile.HighTargets, site_data_templ.GlucoseValue(profile.Units))
		</div>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@presetDetail(i18n.T(ctx, "site.presets.profiles.profile_store"), profile.ProfileStoreID)
			@presetDetail(i18n.T(ctx, "site.presets.profiles.dia"), orDash(profile.Dia))
			@presetDetail(i18n.T(ctx, "site.presets.profiles.carbs_per_hour"), orDash(profile.CarbsHr))
			@presetDetail(i18n.T(ctx, "site.presets.profiles.delay"), orDash(profile.Delay))
			@presetDetail(i18n.T(ctx, "site.presets.profiles.timezone"), orDash(profile.Timezone))
			@site_data_templ.RecordDetails(site_data_templ.Record{ID: profile.ID, UtcOffset: profile.UtcOffsetMinutes, App: profile.CreatedByAppName, Device: profile.CreatedByDeviceName, CreatedBy: profile.CreatedByIdentityName, Created: profile.CreatedAt, Updated: profile.UpdatedAt, UpdatedBy: profile.UpdatedByIdentityName})
		</dl>
	}
}

// ProfilePresetUpdated replaces the profile's row, closes its details and shows a toast
templ ProfilePresetUpdated(profile *sitemodels.SiteProfilePreset) {
	@profilePresetRow(profile)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.presets.profiles.renamed"))
}

templ ProfilePresetDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.presets.profiles.deleted"))
}
