package site_presets_templ

import (
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// ProfilePresetsTable shows one page of profiles, newest first, with buttons to the pages either side
templ ProfilePresetsTable(profiles []*sitemodels.SiteProfilePreset, skip int64, limit int64) {
	<div id="profile_presets_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Profiles") {
			The profiles your loop uploaded, with their schedules. Click one to see it or rename it.
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{
				ID:    "profilePresetsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Name
						}
						@table.Head() {
							Default
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							DIA (hours)
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							Uploaded
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, profile := range profiles {
						@profilePresetRow(profile)
					}
					@pager.Empty("presets--profiles--empty", 6, "No profiles here.")
				}
			}
			@pager.Pager(pager.Props{ID: "presets--profiles", Path: "/presets/profiles", Count: len(profiles), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// profilePresetRow opens the profile's details when clicked.
templ profilePresetRow(profile *sitemodels.SiteProfilePreset) {
	@table.DataRow("presets--profiles--"+profile.ID, "/presets/profiles/"+profile.ID, "Delete this profile?") {
		@table.Cell() {
			{ orDash(profile.Name) }
		}
		@table.Cell() {
			if profile.IsDefault {
				<span class="rounded-full bg-brand-gold px-2 py-0.5 text-xs font-semibold text-brand-night">Default</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(profile.Dia) }
		}
		@table.Cell() {
			{ orDash(profile.CreatedByDeviceName) }
		}
		@table.Cell() {
			{ formatDate(ctx, profile.OccurredAt) }
		}
	}
}

// profilePresetFields are what a profile has that a person can change, as the rest comes from the loop that uploaded it
var profilePresetFields = []addmodal.Field{
	{Name: "name", Label: "Name", Help: "What the profile is called, e.g. to switch to it by.", Required: true, Kind: addmodal.Text, Max: "64"},
}

templ ProfilePresetModal(profile *sitemodels.SiteProfilePreset) {
	{{ units := orEmpty(profile.Units) }}
	{{ edit := addmodal.Edit("presets--profiles", "/presets/profiles", profile.ID, profilePresetFields, map[string]string{"name": orEmpty(profile.Name)}) }}
	{{ edit.Submit = "Rename" }}
	@modal.Modal(modal.Props{ID: "presets--profiles--details", Title: orDash(profile.Name), Subtitle: formatDate(ctx, profile.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<div id="presets--profiles--schedules" class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-5">
			@site_data_templ.ProfileSchedule("presets--profiles--basal-rates", "Basal (U/h)", profile.BasalRates, site_data_templ.ScheduleValue)
			@site_data_templ.ProfileSchedule("presets--profiles--carb-ratios", "Carb Ratio (g/U)", profile.CarbRatios, site_data_templ.ScheduleValue)
			@site_data_templ.ProfileSchedule("presets--profiles--sensitivities", "Sensitivity ("+units+"/U)", profile.Sensitivities, site_data_templ.GlucoseValue(profile.Units))
			@site_data_templ.ProfileSchedule("presets--profiles--targets-low", "Low Target ("+units+")", profile.LowTargets, site_data_templ.GlucoseValue(profile.Units))
			@site_data_templ.ProfileSchedule("presets--profiles--targets-high", "High Target ("+units+")", profile.HighTargets, site_data_templ.GlucoseValue(profile.Units))
		</div>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@presetDetail("Profile Store", profile.ProfileStoreID)
			@presetDetail("DIA (hours)", orDash(profile.Dia))
			@presetDetail("Carbs per Hour", orDash(profile.CarbsHr))
			@presetDetail("Delay", orDash(profile.Delay))
			@presetDetail("Timezone", orDash(profile.Timezone))
			@site_data_templ.RecordDetails(site_data_templ.Record{ID: profile.ID, UtcOffset: profile.UtcOffsetMinutes, App: profile.CreatedByAppName, Device: profile.CreatedByDeviceName, CreatedBy: profile.CreatedByIdentityName, Created: profile.CreatedAt, Updated: profile.UpdatedAt, UpdatedBy: profile.UpdatedByIdentityName})
		</dl>
	}
}

// ProfilePresetUpdated replaces the profile's row, closes its details and shows a toast
templ ProfilePresetUpdated(profile *sitemodels.SiteProfilePreset) {
	@profilePresetRow(profile)
	@modal.CloseOOB()
	@successtoast.OOB("Profile Renamed")
}

templ ProfilePresetDeleted() {
	@successtoast.Toast("Profile Deleted")
}
