package site_data_templ

import (
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/utils/i18n"
)

// Record is who and what made a record, and when, each nil one left out
type Record struct {
	ID                     string
	UtcOffset              *int64
	App, Device, UpdatedBy *string
	CreatedBy              string
	Created, Updated       int64
}

// RecordDetails are a record's own details, at the foot of its details modal's list
templ RecordDetails(r Record) {
	@modal.Section(i18n.T(ctx, "site.data.record.section"))
	@readingDetail(i18n.T(ctx, "site.data.record.record_id"), r.ID)
	@readingDetail(i18n.T(ctx, "site.data.record.utc_offset"), orDash(r.UtcOffset))
	@readingDetail(i18n.T(ctx, "site.data.record.app"), orDash(r.App))
	@readingDetail(i18n.T(ctx, "site.data.common.device"), orDash(r.Device))
	@readingDetail(i18n.T(ctx, "site.data.record.created_by"), r.CreatedBy)
	@readingDetail(i18n.T(ctx, "site.data.record.created"), formatReadingDate(ctx, r.Created))
	@readingDetail(i18n.T(ctx, "site.data.record.updated"), formatReadingDate(ctx, r.Updated))
	@readingDetail(i18n.T(ctx, "site.data.record.updated_by"), orDash(r.UpdatedBy))
}
