package site_data_templ

import (
	"context"
	"fmt"
	"slices"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/utils/display"
)

// glucoseDaysHeight is how tall each day's graph is drawn, and its width is its count of 5 minute slots
const glucoseDaysHeight = 100.0

// glucoseDaysAxis is the glucose each day's graph is drawn from and to, the same for every day so they compare: from
// 40 mg/dL to at least 270 mg/dL, or the highest reading, in the settings' units
func glucoseDaysAxis(ctx context.Context, days []*sitemodels.SiteSummaryDaily) (float64, float64) {
	units := glucoseUnits(ctx)
	top := units.FromMGDL(270)
	for _, day := range days {
		for _, value := range day.Glucose {
			if value != nil {
				top = max(top, *value)
			}
		}
	}
	return units.FromMGDL(40), top
}

// glucoseDaysY is how far down a day's graph a glucose value is drawn, kept inside it
func glucoseDaysY(value, bottom, top float64) string {
	return fmt.Sprintf("%.1f", glucoseDaysHeight*(1-display.Scale(value, bottom, top)))
}

// glucoseDaysMark is how tall a reading's mark is on a day's graph
const glucoseDaysMark = 3.0

// glucoseDaysMarkY is how far down a day's graph a reading's mark starts, so all of it is inside the graph: a reading at
// the bottom of the axis, such as a CGM's lowest of 40 mg/dL, sits on the bottom edge rather than below it, unseen
func glucoseDaysMarkY(value, bottom, top float64) string {
	return fmt.Sprintf("%.1f", (glucoseDaysHeight-glucoseDaysMark)*(1-display.Scale(value, bottom, top)))
}

// glucoseDayLabel is a day's weekday and date, or Today for the first, which is today so far
func glucoseDayLabel(day *sitemodels.SiteSummaryDaily, today bool) string {
	if today {
		return "Today"
	}
	date, _ := time.Parse(time.DateOnly, day.Date)
	return date.Format(display.ShortDayLayout)
}

// GlucoseDays are the days' glucose as small graphs of the same scale, oldest first so today is last, each with the
// range shaded and its time in range
templ GlucoseDays(days []*sitemodels.SiteSummaryDaily) {
	{{ bottom, top := glucoseDaysAxis(ctx, days) }}
	{{ low, high := RangeBounds(ctx) }}
	@card.Card(card.Props{ID: "site--glucose--days", Title: glucoseDaysTitle(len(days))}) {
		<ol class="grid grid-cols-2 gap-3 sm:grid-cols-5">
			for i, day := range slices.Backward(days) {
				<li id={ "site--glucose--day--" + day.Date } class="rounded-lg border border-gray-200 p-2">
					<div class="flex items-baseline justify-between text-xs">
						<span class="font-medium text-gray-900">{ glucoseDayLabel(day, i == 0) }</span>
						if day.TimeInRange != nil {
							<span class="tabular-nums text-gray-600" title="Time in range">{ display.Percent(day.TimeInRange) }</span>
						}
					</div>
					<svg class="mt-1 h-16 w-full" viewBox={ fmt.Sprintf("0 0 %d %.0f", max(len(day.Glucose), 1), glucoseDaysHeight) } preserveAspectRatio="none" role="img" aria-label={ "Glucose on " + day.Date }>
						<rect class="fill-glucose-in-range/10" x="0" width="100%" y={ glucoseDaysY(high, bottom, top) } height={ fmt.Sprintf("%.1f", glucoseDaysHeight*(high-low)/(top-bottom)) }></rect>
						for slot, value := range day.Glucose {
							if value != nil {
								<rect class={ GlucoseColours[glucoseRange(ctx, *value)].Fill } x={ fmt.Sprint(slot) } y={ glucoseDaysMarkY(*value, bottom, top) } width="1.5" height={ fmt.Sprint(glucoseDaysMark) }></rect>
							}
						}
					</svg>
				</li>
			}
		</ol>
	}
}

// glucoseDaysTitle names the days shown: Today for a new site's first day, which has no others, or the last n days
func glucoseDaysTitle(n int) string {
	if n == 1 {
		return "Today"
	}
	return fmt.Sprintf("Last %d days", n)
}
