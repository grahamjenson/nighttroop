	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/dropdown"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// eventGroupEvents are the group's events in words, like "4 U insulin", "40 g carbs" and "5.5–6.7 mmol/L temp target for 30 min",
// and a sensor change's sensor code and transmitter
func eventGroupEvents(ctx context.Context, group *sitemodels.SiteEventGroup) []string {
	events := []string{}
	if r := group.GlucoseReading; r != nil {
		events = append(events, i18n.T(ctx, "site.data.event_groups.glucose_event", i18n.Data{"Reading": formatGlucose(ctx, r.Reading, r.Units), "Units": orDash(r.Units)}))
	}
	if d := group.InsulinDose; d != nil {
		events = append(events, i18n.T(ctx, "site.data.event_groups.insulin_event", i18n.Data{"Dose": fmt.Sprintf("%g", d.Dose)}))
	}
	if f := group.FoodIntake; f != nil {
		events = append(events, i18n.T(ctx, "site.data.common.carbs", i18n.Data{"Carbs": orDash(f.Carbs)}))
	}
	if b := group.TempBasal; b != nil {
		events = append(events, i18n.T(ctx, "site.data.event_groups.temp_basal_event", i18n.Data{"Rate": orDash(b.Rate), "Minutes": b.DurationMinutes}))
	}
	if t := group.TempTarget; t != nil {
		events = append(events, i18n.T(ctx, "site.data.event_groups.temp_target_event", i18n.Data{"Low": formatGlucose(ctx, t.LowTarget, t.Units), "High": formatGlucose(ctx, t.HighTarget, t.Units), "Units": orDash(t.Units), "Minutes": t.DurationMinutes}))
	}
	for _, other := range []struct {
		id      *string
		message string
	}{{group.ProfileSwitchID, "site.data.event_groups.profile_switch_event"}, {group.ActivityID, "site.data.event_groups.activity_event"},
		{group.NotificationEventID, "site.data.event_groups.notification_event"}} {
		if other.id != nil {
			events = append(events, i18n.T(ctx, other.message))
		}
	}
	if group.SensorCode != nil {
		events = append(events, i18n.T(ctx, "site.data.event_groups.sensor_code_event", i18n.Data{"Code": *group.SensorCode}))
	}
	if group.TransmitterID != nil {
		events = append(events, i18n.T(ctx, "site.data.event_groups.transmitter_event", i18n.Data{"Transmitter": *group.TransmitterID}))
	}
	return events
}

// EventGroupsTable shows one page of event groups, newest first, with buttons to the pages either side
templ EventGroupsTable(eventGroups []*sitemodels.SiteEventGroup, skip int64, limit int64, before *int64) {
	@listpage.Page(listpage.Props{
		ID:          "event_groups_table",
		Title:       i18n.T(ctx, "site.data.event_groups.title"),
		Description: i18n.T(ctx, "site.data.event_groups.about"),
		Action:      eventGroupAdd(),
		Above:       searchTotals("site--event-group", "site.data.event_groups.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "eventGroupsTable",
			EmptyID: "site--event-group--empty",
			Empty:   i18n.T(ctx, "site.data.event_groups.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: i18n.T(ctx, "site.data.common.type")}, {Label: i18n.T(ctx, "site.data.event_groups.events")}, {Label: i18n.T(ctx, "site.data.common.notes")}, {Label: i18n.T(ctx, "site.data.common.device")},
				{Actions: true},
			},
		},
		Pager: pager.Dated(pager.Props{ID: "site--event-group", Path: "/data/event-groups", Count: len(eventGroups), Skip: skip, Limit: limit}, before, eventGroups, func(row *sitemodels.SiteEventGroup) (int64, string) { return row.OccurredAt, row.ID }),
	}) {
		for _, eventGroup := range eventGroups {
			@eventGroupRow(eventGroup)
		}
	}
}

// eventGroupRow opens the group's details when clicked.
templ eventGroupRow(eventGroup *sitemodels.SiteEventGroup) {
	@table.DataRow("site--event-group--"+eventGroup.ID, "/data/event-groups/"+eventGroup.ID, i18n.T(ctx, "site.data.event_groups.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, eventGroup.OccurredAt) }
		}
		@table.Cell() {
			{ i18n.Stored(ctx, "event_types", eventGroup.GroupType) }
		}
		@table.Cell() {
			{ strings.Join(eventGroupEvents(ctx, eventGroup), ", ") }
		}
		@table.Cell(notesCell) {
			{ orDash(eventGroup.Notes) }
		}
		@table.Cell() {
			{ orDash(eventGroup.CreatedByDeviceName) }
		}
	}
}

// eventGroupAdd is a menu of the types of group, each opening the modal to add one of that type
templ eventGroupAdd() {
	<div>
		@dropdown.Dropdown(dropdown.Props{ID: "site--event-group--add-menu"}) {
			@dropdown.Trigger() {
				@button.Button(button.Props{ID: "site--event-group--add"}) {
					{ i18n.T(ctx, "site.data.event_groups.add") }
					@icon.ChevronDown(icon.Props{Class: "size-4"})
				}
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd}) {
				for _, groupType := range sitemodels.EventGroupTypes {
					@dropdown.Item(dropdown.ItemProps{
						ID: "site--event-group--add--" + strings.ReplaceAll(nightscoutmodels.ToSnakeCase(groupType), "_", "-"),
						Attributes: templ.Attributes{"hx-get": "/data/event-groups/new?group_type=" + url.QueryEscape(groupType),
							"hx-target": "#modal-container", "hx-swap": "innerHTML"},
					}) {
						{ i18n.Stored(ctx, "event_types", groupType) }
					}
				}
			}
		}
	</div>
}

// eventGroupForm adds a group of groupType, or with a group changes it, its events picked from those near its time of
// the kinds its type can have
func eventGroupForm(ctx context.Context, group *sitemodels.SiteEventGroup, groupType string) addmodal.Props {
	p := addmodal.Props{ID: "site--event-group--create", Title: i18n.T(ctx, "site.data.event_groups.add_type", i18n.Data{"Type": i18n.Stored(ctx, "event_types", groupType)}), Path: "/data/event-groups", Target: "#eventGroupsTable tbody",
		Submit: i18n.T(ctx, "site.data.event_groups.add_type", i18n.Data{"Type": i18n.Stored(ctx, "event_types", groupType)})}
	when, reason, notes := time.Now(), "", ""
	choices := "/data/event-groups/choices"
	if group != nil {
		p.ID, p.Path, p.Target, p.Swap, p.Submit = "site--event-group--edit", "/data/event-groups/"+group.ID, "#site--event-group--"+group.ID, "outerHTML", i18n.T(ctx, "site.data.common.save")
		when, reason, notes = time.UnixMilli(group.OccurredAt), orEmpty(group.Reason), orEmpty(group.Notes)
		choices += "?group_id=" + group.ID
		p.Fields = []addmodal.Field{{Name: "group_type", Label: i18n.T(ctx, "site.data.common.type"), Help: i18n.T(ctx, "site.data.event_groups.type_help"), Required: true, Kind: addmodal.Select, Options: sitemodels.EventGroupTypes, Value: groupType,
			OptionLabel: func(t string) string { return i18n.Stored(ctx, "event_types", t) }}}
	}
	p.Extra = eventGroupChoicesLoader(p.ID, choices, group == nil, groupType)
	whenHelp := i18n.T(ctx, "site.data.event_groups.when_help")
	if len(sitemodels.EventGroupTypeKinds[nightscoutmodels.TreatmentEventType(groupType)]) == 0 {
		whenHelp = i18n.T(ctx, "site.data.event_groups.when_help_no_events")
	}
	p.Fields = append(p.Fields, addmodal.Field{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: whenHelp, Kind: addmodal.When, Value: when.In(Location(ctx)).Format("2006-01-02T15:04")})
	// A sensor's start, stop or change can say its code and transmitter
	if slices.Contains(sensorTypes, groupType) {
		sensorCode, transmitterID := "", ""
		if group != nil {
			sensorCode, transmitterID = orEmpty(group.SensorCode), orEmpty(group.TransmitterID)
		}
		p.Fields = append(p.Fields, []addmodal.Field{
			{Name: "sensor_code", Column: "event_groups.SensorCode", Label: i18n.T(ctx, "site.data.event_groups.sensor_code"), Help: i18n.T(ctx, "site.data.event_groups.sensor_code_help"), Kind: addmodal.Text, Value: sensorCode},
			{Name: "transmitter_id", Column: "event_groups.TransmitterID", Label: i18n.T(ctx, "site.data.event_groups.transmitter_id"), Help: i18n.T(ctx, "site.data.event_groups.transmitter_id_help"), Kind: addmodal.Text, Value: transmitterID},
		}...)
	}
	p.Fields = append(p.Fields, []addmodal.Field{
		{Name: "reason", Column: "event_groups.Reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.event_groups.reason_help"), Kind: addmodal.Text, Value: reason},
		{Name: "notes", Column: "event_groups.Notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Value: notes},
	}...)
	return p
}

// eventGroupChoicesLoader loads the events that can be picked, again whenever the form's time or type changes. A new
// group's type is fixed, so is sent from a hidden input.
templ eventGroupChoicesLoader(formID string, path string, creating bool, groupType string) {
	if creating {
		<input type="hidden" id={ formID + "--group-type" } name="group_type" value={ groupType }/>
	}
	<div
		id={ formID + "--events" }
		hx-get={ path }
		hx-trigger={ "load, input delay:300ms from:#" + formID + "--occurred-at, change from:#" + formID + "--group-type" }
		hx-include={ "#" + formID + "--occurred-at, #" + formID + "--group-type" }
		hx-swap="innerHTML"
	>
		<p class="text-sm text-gray-500">{ i18n.T(ctx, "site.data.event_groups.finding_events") }</p>
	</div>
}

// sensorTypes are the changes of a sensor, which can have its code and transmitter
var sensorTypes = []string{nightscoutmodels.SensorStart.String(), nightscoutmodels.SensorStop.String(), nightscoutmodels.SensorChange.String()}

// eventKinds are the kinds of event a group can have one of, by its field for it, with the id of its label
var eventKinds = []struct{ field, label string }{
	{"glucose_reading_id", "site.data.event_groups.glucose_kind"}, {"insulin_dose_id", "site.data.event_groups.insulin_kind"},
	{"food_intake_id", "site.data.event_groups.food_kind"}, {"temp_basal_id", "site.data.event_groups.temp_basal_kind"},
	{"temp_target_id", "site.data.event_groups.temp_target_kind"}, {"profile_switch_id", "site.data.event_groups.profile_switch_kind"},
	{"activity_id", "site.data.event_groups.activity_kind"}, {"notification_event_id", "site.data.event_groups.notification_kind"},
}

// eventChoiceLabel is an event's time, in the time format, and what tells it apart, like "12:30:00 40 g carbs, sandwich"
func eventChoiceLabel(ctx context.Context, choice *sitemodels.SiteEventChoice) string {
	parts := []string{time.UnixMilli(choice.OccurredAt).In(Location(ctx)).Format(timeLayout(ctx))}
	if a := choice.Amount; a != nil {
		switch choice.Kind {
		case "glucose_reading_id", "temp_target_id":
			parts = append(parts, formatGlucose(ctx, *a, glucoseUnits(ctx))+" "+orDash(glucoseUnits(ctx)))
		case "insulin_dose_id":
			parts = append(parts, fmt.Sprintf("%g U", *a))
		case "food_intake_id":
			parts = append(parts, i18n.T(ctx, "site.data.common.carbs", i18n.Data{"Carbs": fmt.Sprintf("%g", *a)}))
		case "temp_basal_id":
			parts = append(parts, fmt.Sprintf("%g U/hr", *a))
		}
	}
	if choice.Minutes != nil {
		parts = append(parts, i18n.T(ctx, "site.data.event_groups.for_minutes", i18n.Data{"Minutes": *choice.Minutes}))
	}
	if choice.Detail != nil && *choice.Detail != "" {
		parts = append(parts, *choice.Detail)
	}
	return strings.Join(parts, " ")
}

// EventGroupChoices is a select of each of the kinds of event, of those from one time to another that can be grouped,
// with the group's own picked
templ EventGroupChoices(editing bool, kinds []string, from int64, to int64, choices []*sitemodels.SiteEventChoice) {
	{{ formID := "site--event-group--create" }}
	if editing {
		{{ formID = "site--event-group--edit" }}
	}
	<p class="mb-2 text-sm font-medium text-gray-700">{ i18n.T(ctx, "site.data.event_groups.events") }</p>
	<p id={ formID + "--events-window" } class="mb-3 text-xs text-gray-500">
		{ i18n.T(ctx, "site.data.event_groups.pick", i18n.Data{"From": time.UnixMilli(from).In(Location(ctx)).Format(dateLayout(ctx) + " " + timeLayout(ctx)),
			"To": time.UnixMilli(to).In(Location(ctx)).Format(timeLayout(ctx))}) }
	</p>
	<div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
		for _, kind := range eventKinds {
			if !slices.Contains(kinds, kind.field) {
				{{ continue }}
			}
			{{ id := formID + "--" + strings.ReplaceAll(kind.field, "_", "-") }}
			<div>
				<label for={ id } class="mb-1 block text-sm font-medium text-gray-700">{ i18n.T(ctx, kind.label) }</label>
				<select id={ id } name={ kind.field } class="h-9 w-full rounded-md border border-gray-200 bg-white px-3 text-sm">
					<option value="">{ i18n.T(ctx, "site.data.event_groups.no_event") }</option>
					for _, choice := range choices {
						if choice.Kind == kind.field {
							<option value={ choice.ID } selected?={ choice.Picked }>{ eventChoiceLabel(ctx, choice) }</option>
						}
					}
				</select>
			</div>
		}
	</div>
}

// EventGroupNoChoices says a type of group, like a change of a sensor, site or pump part, has no events to pick
templ EventGroupNoChoices(editing bool) {
	{{ formID := "site--event-group--create" }}
	if editing {
		{{ formID = "site--event-group--edit" }}
	}
	<p id={ formID + "--no-events" } class="text-sm text-gray-500">{ i18n.T(ctx, "site.data.event_groups.no_events") }</p>
}

// EventGroupNew is the modal to add a group of groupType in, putting the group's row at the top of the table
templ EventGroupNew(groupType string) {
	@addmodal.Modal(eventGroupForm(ctx, nil, groupType))
}

templ EventGroupCreated(eventGroup *sitemodels.SiteEventGroup) {
	@eventGroupRow(eventGroup)
}

// EventGroupUpdated replaces the group's row, closes its details and shows a toast
templ EventGroupUpdated(eventGroup *sitemodels.SiteEventGroup) {
	@eventGroupRow(eventGroup)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.event_groups.updated"))
}

// EventGroupModal is the group's details, and a form to change its type, time and events
templ EventGroupModal(eventGroup *sitemodels.SiteEventGroup) {
	{{ edit := eventGroupForm(ctx, eventGroup, eventGroup.GroupType) }}
	@modal.Modal(modal.Props{ID: "site--event-group--details", Title: i18n.Stored(ctx, "event_types", eventGroup.GroupType), Subtitle: formatReadingDate(ctx, eventGroup.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		<ul id="site--event-group--events" class="mt-4 list-inside list-disc text-sm">
			for _, event := range eventGroupEvents(ctx, eventGroup) {
				<li>{ event }</li>
			}
		</ul>
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail(i18n.T(ctx, "site.data.common.minutes"), orDash(eventGroup.DurationMinutes))
			@readingDetail(i18n.T(ctx, "site.data.common.notes"), orDash(eventGroup.Notes))
			@readingDetail(i18n.T(ctx, "site.data.common.reason"), orDash(eventGroup.Reason))
			@readingDetail(i18n.T(ctx, "site.data.event_groups.pump_id"), orDash(eventGroup.PumpID))
			@readingDetail(i18n.T(ctx, "site.data.event_groups.pump_serial"), orDash(eventGroup.PumpSerial))
			@readingDetail(i18n.T(ctx, "site.data.event_groups.pump_type"), orDash(eventGroup.PumpType))
			@RecordDetails(Record{ID: eventGroup.ID, UtcOffset: eventGroup.UtcOffsetMinutes, App: eventGroup.CreatedByAppName, Device: eventGroup.CreatedByDeviceName, CreatedBy: eventGroup.CreatedByIdentityName, Created: eventGroup.CreatedAt, Updated: eventGroup.UpdatedAt, UpdatedBy: eventGroup.UpdatedByIdentityName})
		</dl>
	}
}

templ EventGroupDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.event_groups.deleted"))
}
