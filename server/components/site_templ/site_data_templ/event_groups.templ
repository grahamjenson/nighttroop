package site_data_templ

import (
	"context"
	"fmt"
	"strings"
	"time"

	"nighttroop.t1d.nz/models/nightscoutmodels"
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// eventGroupEvents are the group's events in words, like "4 U insulin", "40 g carbs" and "5.5–6.7 mmol/L temp target for 30 min"
func eventGroupEvents(group *sitemodels.SiteEventGroup) []string {
	events := []string{}
	if r := group.GlucoseReading; r != nil {
		events = append(events, fmt.Sprintf("%s %s glucose", formatGlucose(r.Reading, r.Units), orDash(r.Units)))
	}
	if d := group.InsulinDose; d != nil {
		events = append(events, fmt.Sprintf("%g U insulin", d.Dose))
	}
	if f := group.FoodIntake; f != nil {
		events = append(events, fmt.Sprintf("%s g carbs", orDash(f.Carbs)))
	}
	if b := group.TempBasal; b != nil {
		events = append(events, fmt.Sprintf("%s U/hr temp basal for %d min", orDash(b.Absolute), b.DurationMinutes))
	}
	if t := group.TempTarget; t != nil {
		events = append(events, fmt.Sprintf("%s–%s %s temp target for %d min", formatGlucose(t.LowTarget, t.Units), formatGlucose(t.HighTarget, t.Units), orDash(t.Units), t.DurationMinutes))
	}
	for _, other := range []struct {
		id   *string
		name string
	}{{group.ProfileSwitchID, "profile switch"}, {group.ComponentEventID, "site or sensor change"}, {group.ActivityID, "activity"}, {group.NotificationEventID, "notification"}} {
		if other.id != nil {
			events = append(events, other.name)
		}
	}
	return events
}

// EventGroupsTable shows one page of event groups, newest first, with buttons to the pages either side
templ EventGroupsTable(eventGroups []*sitemodels.SiteEventGroup, skip int64, limit int64) {
	<div id="event_groups_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Event Groups") {
			Events recorded together, like a meal bolus's food and insulin: Nightscout's treatments. Newest first. Click one to see all its details.
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@addmodal.Open("site--event-group--add", "/data/event-groups/new", "Add Event Group")
			@table.Table(table.Props{
				ID:    "eventGroupsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Events
						}
						@table.Head() {
							Notes
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(eventGroups) == 0 {
						<tr id="site--event-group--empty"><td colspan="6" class="p-4 text-sm text-gray-500">No event groups here.</td></tr>
					}
					for _, eventGroup := range eventGroups {
						@eventGroupRow(eventGroup)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "site--event-group", Path: "/data/event-groups", Count: len(eventGroups), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// eventGroupRow opens the group's details when clicked. The delete button stops its click reaching the row.
templ eventGroupRow(eventGroup *sitemodels.SiteEventGroup) {
	{{ id := "site--event-group--" + eventGroup.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/event-groups/" + eventGroup.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(ctx, eventGroup.OccurredAt) }
		}
		@table.Cell() {
			{ eventGroup.GroupType }
		}
		@table.Cell() {
			{ strings.Join(eventGroupEvents(eventGroup), ", ") }
		}
		@table.Cell() {
			{ orDash(eventGroup.Notes) }
		}
		@table.Cell() {
			{ orDash(eventGroup.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              templ.JSUnsafeFuncCall("event.stopPropagation()"),
						"hx-delete":            "/data/event-groups/" + eventGroup.ID,
						"hx-confirm":           "Delete this event group and all its events?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

// eventGroupTypes are the Nightscout treatment types a group can be
var eventGroupTypes = func() []string {
	types := []string{}
	for _, t := range nightscoutmodels.TreatmentEventTypes {
		types = append(types, string(t))
	}
	return types
}()

// eventGroupForm groups events, or with a group changes its events, which are picked from those near its time
func eventGroupForm(ctx context.Context, group *sitemodels.SiteEventGroup) addmodal.Props {
	p := addmodal.Props{ID: "site--event-group--create", Title: "Add Event Group", Path: "/data/event-groups", Target: "#eventGroupsTable tbody",
		EmptyID: "site--event-group--empty", Submit: "Add Event Group"}
	groupType, when, reason, notes := string(nightscoutmodels.MealBolus), time.Now(), "", ""
	if group != nil {
		p.ID, p.Path, p.Target, p.Swap, p.Submit = "site--event-group--edit", "/data/event-groups/"+group.ID, "#site--event-group--"+group.ID, "outerHTML", "Save"
		groupType, when, reason, notes = group.GroupType, time.UnixMilli(group.OccurredAt), orEmpty(group.Reason), orEmpty(group.Notes)
	}
	choices := "/data/event-groups/choices"
	if group != nil {
		choices += "?group_id=" + group.ID
	}
	p.Extra = eventGroupChoicesLoader(p.ID, choices)
	p.Fields = []addmodal.Field{
		{Name: "group_type", Label: "Type", Help: "What kind of treatment it is, as Nightscout calls it.", Required: true, Kind: addmodal.Select, Options: eventGroupTypes, Value: groupType},
		{Name: "occurred_at", Label: "When", Help: "When it happened. Events within an hour of it can be picked.", Kind: addmodal.When, Value: when.In(Location(ctx)).Format("2006-01-02T15:04")},
		{Name: "reason", Label: "Reason", Help: "Why, e.g. lunch or a low.", Kind: addmodal.Text, Max: "64", Value: reason},
		{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Value: notes},
	}
	return p
}

// eventGroupChoicesLoader loads the events that can be picked, again whenever the form's time changes
templ eventGroupChoicesLoader(formID string, path string) {
	<div
		id={ formID + "--events" }
		hx-get={ path }
		hx-trigger={ "load, input delay:300ms from:#" + formID + "--occurred-at" }
		hx-include={ "#" + formID + "--occurred-at" }
		hx-swap="innerHTML"
	>
		<p class="text-sm text-gray-500">Finding events near this time…</p>
	</div>
}

// eventKinds are the kinds of event a group can have one of, by its field for it
var eventKinds = []struct{ field, label string }{
	{"glucose_reading_id", "Glucose"}, {"insulin_dose_id", "Insulin"}, {"food_intake_id", "Food"},
	{"temp_basal_id", "Temp basal"}, {"temp_target_id", "Temp target"}, {"profile_switch_id", "Profile switch"},
	{"component_event_id", "Site or sensor change"}, {"activity_id", "Activity"}, {"notification_event_id", "Notification"},
}

// eventChoiceLabel is an event's time and what tells it apart, like "12:30 40 g carbs, sandwich"
func eventChoiceLabel(ctx context.Context, choice *sitemodels.SiteEventChoice) string {
	parts := []string{time.UnixMilli(choice.OccurredAt).In(Location(ctx)).Format("15:04")}
	if a := choice.Amount; a != nil {
		switch choice.Kind {
		case "glucose_reading_id", "temp_target_id":
			parts = append(parts, formatGlucose(*a, glucoseUnits(ctx))+" "+orDash(glucoseUnits(ctx)))
		case "insulin_dose_id":
			parts = append(parts, fmt.Sprintf("%g U", *a))
		case "food_intake_id":
			parts = append(parts, fmt.Sprintf("%g g carbs", *a))
		case "temp_basal_id":
			parts = append(parts, fmt.Sprintf("%g U/hr", *a))
		}
	}
	if choice.Minutes != nil {
		parts = append(parts, fmt.Sprintf("for %d min", *choice.Minutes))
	}
	if choice.Detail != nil && *choice.Detail != "" {
		parts = append(parts, *choice.Detail)
	}
	return strings.Join(parts, " ")
}

// EventGroupChoices is a select of each kind of event, of those from one time to another that can be grouped, with the
// group's own picked
templ EventGroupChoices(editing bool, from int64, to int64, choices []*sitemodels.SiteEventChoice) {
	{{ formID := "site--event-group--create" }}
	if editing {
		{{ formID = "site--event-group--edit" }}
	}
	<p class="mb-2 text-sm font-medium text-gray-700">Events</p>
	<p id={ formID + "--events-window" } class="mb-3 text-xs text-gray-500">
		Pick up to one of each kind, from { time.UnixMilli(from).In(Location(ctx)).Format("2006-01-02 15:04") } to { time.UnixMilli(to).In(Location(ctx)).Format("15:04") }.
		Events already in another group are not shown.
	</p>
	<div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
		for _, kind := range eventKinds {
			{{ id := formID + "--" + strings.ReplaceAll(kind.field, "_", "-") }}
			<div>
				<label for={ id } class="mb-1 block text-sm font-medium text-gray-700">{ kind.label }</label>
				<select id={ id } name={ kind.field } class="h-9 w-full rounded-md border border-gray-200 bg-white px-3 text-sm">
					<option value="">None</option>
					for _, choice := range choices {
						if choice.Kind == kind.field {
							<option value={ choice.ID } selected?={ choice.Picked }>{ eventChoiceLabel(ctx, choice) }</option>
						}
					}
				</select>
			</div>
		}
	</div>
}

// EventGroupNew is the modal to group events in, putting the group's row at the top of the table
templ EventGroupNew() {
	@addmodal.Modal(eventGroupForm(ctx, nil))
}

templ EventGroupCreated(eventGroup *sitemodels.SiteEventGroup) {
	@eventGroupRow(eventGroup)
}

// EventGroupUpdated replaces the group's row, closes its details and shows a toast
templ EventGroupUpdated(eventGroup *sitemodels.SiteEventGroup) {
	@eventGroupRow(eventGroup)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@glucoseToast("Event Group Updated")
	</div>
}

// EventGroupModal is the group's details, and a form to change its type, time and events
templ EventGroupModal(eventGroup *sitemodels.SiteEventGroup) {
	{{ edit := eventGroupForm(ctx, eventGroup) }}
	@modal.Modal(modal.Props{ID: "site--event-group--details", Title: eventGroup.GroupType, Subtitle: formatReadingDate(ctx, eventGroup.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		<ul id="site--event-group--events" class="mt-4 list-inside list-disc text-sm">
			for _, event := range eventGroupEvents(eventGroup) {
				<li>{ event }</li>
			}
		</ul>
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Minutes", orDash(eventGroup.DurationMinutes))
			@readingDetail("Notes", orDash(eventGroup.Notes))
			@readingDetail("Reason", orDash(eventGroup.Reason))
			@modal.Section("Record")
			@readingDetail("ID", eventGroup.ID)
			@readingDetail("UTC Offset (minutes)", orDash(eventGroup.UtcOffsetMinutes))
			@readingDetail("App", orDash(eventGroup.CreatedByAppName))
			@readingDetail("Device", orDash(eventGroup.CreatedByDeviceName))
			@readingDetail("Created By", eventGroup.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, eventGroup.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, eventGroup.UpdatedAt))
			@readingDetail("Updated By", orDash(eventGroup.UpdatedByIdentityName))
		</dl>
		@modal.RawJSON("site--event-group--details--raw", eventGroup.RawJsonData)
	}
}

templ EventGroupDeleted() {
	@glucoseToast("Event Group Deleted")
}
