package site_data_templ

import (
	"fmt"
	"strings"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// eventGroupEvents are the group's events in words, like "4 U insulin" and "40 g carbs"
func eventGroupEvents(group *sitemodels.SiteEventGroup) []string {
	events := []string{}
	if r := group.GlucoseReading; r != nil {
		events = append(events, fmt.Sprintf("%s %s glucose", formatGlucose(r.Reading, r.Units), orDash(r.Units)))
	}
	if d := group.InsulinDose; d != nil {
		events = append(events, fmt.Sprintf("%g U insulin", d.Dose))
	}
	if f := group.FoodIntake; f != nil {
		events = append(events, fmt.Sprintf("%s g carbs", orDash(f.Carbs)))
	}
	if b := group.TempBasal; b != nil {
		events = append(events, fmt.Sprintf("%s U/hr temp basal for %d min", orDash(b.Absolute), b.DurationMinutes))
	}
	if t := group.TempTarget; t != nil {
		events = append(events, fmt.Sprintf("%s–%s temp target for %d min", formatGlucose(t.LowTarget, t.Units), formatGlucose(t.HighTarget, t.Units), t.DurationMinutes))
	}
	for _, other := range []struct {
		id   *string
		name string
	}{{group.ProfileSwitchID, "profile switch"}, {group.ComponentEventID, "site or sensor change"}, {group.ActivityID, "activity"}, {group.NotificationEventID, "notification"}} {
		if other.id != nil {
			events = append(events, other.name)
		}
	}
	return events
}

// EventGroupsTable shows one page of event groups, newest first, with buttons to the pages either side
templ EventGroupsTable(eventGroups []*sitemodels.SiteEventGroup, skip int64, limit int64) {
	<div id="event_groups_table" class="mx-auto max-w-5xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">Event Groups</h1>
			<p class="mt-1 text-gray-500">
				Events recorded together, like a meal bolus's food and insulin: Nightscout's treatments. Newest first. Click one to see all its details.
			</p>
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{
				ID:    "eventGroupsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Events
						}
						@table.Head() {
							Notes
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(eventGroups) == 0 {
						<tr id="site--event-group--empty"><td colspan="6" class="p-4 text-sm text-gray-500">No event groups here.</td></tr>
					}
					for _, eventGroup := range eventGroups {
						@eventGroupRow(eventGroup)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "site--event-group", Path: "/data/event-groups", Count: len(eventGroups), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// eventGroupRow opens the group's details when clicked. The delete button stops its click reaching the row.
templ eventGroupRow(eventGroup *sitemodels.SiteEventGroup) {
	{{ id := "site--event-group--" + eventGroup.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/event-groups/" + eventGroup.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(eventGroup.OccurredAt) }
		}
		@table.Cell() {
			{ eventGroup.GroupType }
		}
		@table.Cell() {
			{ strings.Join(eventGroupEvents(eventGroup), ", ") }
		}
		@table.Cell() {
			{ orDash(eventGroup.Notes) }
		}
		@table.Cell() {
			{ orDash(eventGroup.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              "event.stopPropagation()",
						"hx-delete":            "/data/event-groups/" + eventGroup.ID,
						"hx-confirm":           "Delete this event group and all its events?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": "if (ctx.response.status < 400) this.closest('tr').remove()",
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ EventGroupModal(eventGroup *sitemodels.SiteEventGroup) {
	@modal.Modal(modal.Props{ID: "site--event-group--details", Title: eventGroup.GroupType, Subtitle: formatReadingDate(eventGroup.OccurredAt)}) {
		<ul id="site--event-group--events" class="mt-4 list-inside list-disc text-sm">
			for _, event := range eventGroupEvents(eventGroup) {
				<li>{ event }</li>
			}
		</ul>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Minutes", orDash(eventGroup.DurationMinutes))
			@readingDetail("Notes", orDash(eventGroup.Notes))
			@readingDetail("Reason", orDash(eventGroup.Reason))
			@modal.Section("Record")
			@readingDetail("ID", eventGroup.ID)
			@readingDetail("UTC Offset (minutes)", orDash(eventGroup.UtcOffsetMinutes))
			@readingDetail("App", orDash(eventGroup.CreatedByAppName))
			@readingDetail("Device", orDash(eventGroup.CreatedByDeviceName))
			@readingDetail("Created By", eventGroup.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(eventGroup.CreatedAt))
			@readingDetail("Updated", formatReadingDate(eventGroup.UpdatedAt))
			@readingDetail("Updated By", orDash(eventGroup.UpdatedByIdentityName))
		</dl>
		@modal.RawJSON("site--event-group--details--raw", eventGroup.RawJsonData)
	}
}

templ EventGroupDeleted() {
	@glucoseToast("Event Group Deleted")
}
