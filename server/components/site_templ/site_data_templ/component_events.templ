package site_data_templ

import (
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// componentDetail is the sensor code, else the transmitter
func componentDetail(event *sitemodels.SiteComponentEvent) string {
	for _, value := range []*string{event.SensorCode, event.TransmitterID} {
		if value != nil && *value != "" {
			return *value
		}
	}
	return "-"
}

// ComponentEventsTable shows one page of sensor, site and pump changes, newest first, with buttons to the pages either side
templ ComponentEventsTable(events []*sitemodels.SiteComponentEvent, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "component_events_table",
		Title:       "Site & Sensor Changes",
		Description: "Newest first. Click a change to see all its details.",
		Action:      addmodal.Open("site--component-event--add", "/data/component-events/new", "Add Change"),
		Above:       searchTotals("site--component-event", "site or sensor change", "site and sensor changes"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "componentEventsTable",
			EmptyID: "site--component-event--empty",
			Empty:   "No site or sensor changes here.",
			Columns: []table.Column{
				{Label: "Time"}, {Label: "Type"}, {Label: "Sensor"}, {Label: "Notes"}, {Label: "Device"},
				{Actions: true},
			},
		},
		Pager: &pager.Props{ID: "site--component-event", Path: "/data/component-events", Count: len(events), Skip: skip, Limit: limit},
	}) {
		for _, event := range events {
			@componentEventRow(event)
		}
	}
}

// ComponentEventNew adds a site or sensor change with all its fields, putting its row at the top of the table
templ ComponentEventNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--component-event--create", Title: "Add Change", Path: "/data/component-events", Target: "#componentEventsTable tbody",
		Submit: "Add Change", Fields: componentEventFields})
}

// componentEventFields are what a site or sensor change has that a person can type in
var componentEventFields = []addmodal.Field{
	{Name: "event_type", Label: "Change", Help: "What was changed, started or filled.", Required: true, Kind: addmodal.Select, Options: sitemodels.ComponentEventTypes},
	{Name: "occurred_at", Label: "When", Help: "When it was changed, in your timezone. Blank is now.", Kind: addmodal.When},
	{Name: "sensor_code", Label: "Sensor code", Help: "The new sensor's calibration code.", Kind: addmodal.Text, Max: "64"},
	{Name: "transmitter_id", Label: "Transmitter ID", Help: "The sensor's transmitter.", Kind: addmodal.Text, Max: "64"},
	{Name: "reason", Label: "Reason", Help: "Why it was changed, e.g. it fell off.", Kind: addmodal.Text, Max: "64"},
	{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
}

// componentEventRow opens the change's details when clicked.
templ componentEventRow(event *sitemodels.SiteComponentEvent) {
	@table.DataRow("site--component-event--"+event.ID, "/data/component-events/"+event.ID, "Delete this change?") {
		@table.Cell() {
			{ formatReadingDate(ctx, event.OccurredAt) }
		}
		@table.Cell() {
			{ event.EventType }
		}
		@table.Cell() {
			{ componentDetail(event) }
		}
		@table.Cell(notesCell) {
			{ orDash(event.Notes) }
		}
		@table.Cell() {
			{ orDash(event.CreatedByDeviceName) }
		}
	}
}

templ ComponentEventModal(event *sitemodels.SiteComponentEvent) {
	{{ edit := addmodal.Props{ID: "site--component-event--edit", Path: "/data/component-events/" + event.ID, Target: "#site--component-event--" + event.ID, Swap: "outerHTML", Submit: "Save",
		Fields: addmodal.Edit(componentEventFields, event, nil)} }}
	@modal.Modal(modal.Props{ID: "site--component-event--details", Title: event.EventType, Subtitle: formatReadingDate(ctx, event.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@RecordDetails(Record{ID: event.ID, UtcOffset: event.UtcOffsetMinutes, App: event.CreatedByAppName, Device: event.CreatedByDeviceName, CreatedBy: event.CreatedByIdentityName, Created: event.CreatedAt, Updated: event.UpdatedAt, UpdatedBy: event.UpdatedByIdentityName})
		</dl>
	}
}

templ ComponentEventCreated(event *sitemodels.SiteComponentEvent) {
	@componentEventRow(event)
}

// ComponentEventUpdated replaces the change's row, closes its details and shows a toast
templ ComponentEventUpdated(event *sitemodels.SiteComponentEvent) {
	@componentEventRow(event)
	@modal.CloseOOB()
	@successtoast.OOB("Change Updated")
}

templ ComponentEventDeleted() {
	@successtoast.Toast("Change Deleted")
}
