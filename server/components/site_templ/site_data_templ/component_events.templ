package site_data_templ

import (
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// componentDetail is the sensor code, else the transmitter, else the pump type
func componentDetail(event *sitemodels.SiteComponentEvent) string {
	for _, value := range []*string{event.SensorCode, event.TransmitterID, event.PumpType} {
		if value != nil && *value != "" {
			return *value
		}
	}
	return "-"
}

// ComponentEventsTable shows one page of sensor, site and pump changes, newest first, with buttons to the pages either side
templ ComponentEventsTable(events []*sitemodels.SiteComponentEvent, skip int64, limit int64) {
	<div id="component_events_table" class="mx-auto max-w-5xl space-y-6">
		@heading.PageWith("Site & Sensor Changes", addmodal.Open("site--component-event--add", "/data/component-events/new", "Add Change")) {
			Newest first. Click a change to see all its details.
		}
		@searchTotals("site--component-event", "site or sensor change", "site and sensor changes")
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{
				ID:    "componentEventsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Sensor/Pump
						}
						@table.Head() {
							Notes
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, event := range events {
						@componentEventRow(event)
					}
					@pager.Empty("site--component-event--empty", 6, "No site or sensor changes here.")
				}
			}
			@pager.Pager(pager.Props{ID: "site--component-event", Path: "/data/component-events", Count: len(events), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// ComponentEventNew adds a site or sensor change with all its fields, putting its row at the top of the table
templ ComponentEventNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--component-event--create", Title: "Add Change", Path: "/data/component-events", Target: "#componentEventsTable tbody",
		Submit: "Add Change", Fields: componentEventFields})
}

// componentEventFields are what a site or sensor change has that a person can type in
var componentEventFields = []addmodal.Field{
	{Name: "event_type", Label: "Change", Help: "What was changed, started or filled.", Required: true, Kind: addmodal.Select, Options: sitemodels.ComponentEventTypes},
	{Name: "occurred_at", Label: "When", Help: "When it was changed, in your timezone. Blank is now.", Kind: addmodal.When},
	{Name: "sensor_code", Label: "Sensor code", Help: "The new sensor's calibration code.", Kind: addmodal.Text, Max: "64"},
	{Name: "transmitter_id", Label: "Transmitter ID", Help: "The sensor's transmitter.", Kind: addmodal.Text, Max: "64"},
	{Name: "pump_type", Label: "Pump type", Help: "The pump's make or model.", Kind: addmodal.Text, Max: "64"},
	{Name: "pump_serial", Label: "Pump serial", Help: "The pump's serial number.", Kind: addmodal.Text, Max: "32"},
	{Name: "pump_id", Label: "Pump ID", Help: "The pump's ID for the change.", Kind: addmodal.Text, Max: "32"},
	{Name: "reason", Label: "Reason", Help: "Why it was changed, e.g. it fell off.", Kind: addmodal.Text, Max: "64"},
	{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
}

// componentEventRow opens the change's details when clicked.
templ componentEventRow(event *sitemodels.SiteComponentEvent) {
	@table.DataRow("site--component-event--"+event.ID, "/data/component-events/"+event.ID, "Delete this change?") {
		@table.Cell() {
			{ formatReadingDate(ctx, event.OccurredAt) }
		}
		@table.Cell() {
			{ event.EventType }
		}
		@table.Cell() {
			{ componentDetail(event) }
		}
		@table.Cell(notesCell) {
			{ orDash(event.Notes) }
		}
		@table.Cell() {
			{ orDash(event.CreatedByDeviceName) }
		}
	}
}

templ ComponentEventModal(event *sitemodels.SiteComponentEvent) {
	@modal.Modal(modal.Props{ID: "site--component-event--details", Title: event.EventType, Subtitle: formatReadingDate(ctx, event.OccurredAt), Actions: modal.Submit("site--component-event--edit", "Save")}) {
		<form
			id="site--component-event--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/data/component-events/" + event.ID }
			hx-target={ "#site--component-event--" + event.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@field.Field("site--component-event--edit--sensor-code", "Sensor code", "w-40") {
				@input.Input(input.Props{ID: "site--component-event--edit--sensor-code", Name: "sensor_code", Placeholder: "Sensor Code", Value: orEmpty(event.SensorCode), Attributes: templ.Attributes{"maxlength": "64"}})
			}
			@field.Field("site--component-event--edit--transmitter-id", "Transmitter ID", "w-40") {
				@input.Input(input.Props{ID: "site--component-event--edit--transmitter-id", Name: "transmitter_id", Placeholder: "Transmitter ID", Value: orEmpty(event.TransmitterID), Attributes: templ.Attributes{"maxlength": "64"}})
			}
			@field.Field("site--component-event--edit--notes", "Notes", "w-64") {
				@input.Input(input.Props{ID: "site--component-event--edit--notes", Name: "notes", Placeholder: "Notes", Value: orEmpty(event.Notes)})
			}
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Sensor Code", orDash(event.SensorCode))
			@readingDetail("Transmitter ID", orDash(event.TransmitterID))
			@readingDetail("Pump ID", orDash(event.PumpID))
			@readingDetail("Pump Serial", orDash(event.PumpSerial))
			@readingDetail("Pump Type", orDash(event.PumpType))
			@readingDetail("Notes", orDash(event.Notes))
			@readingDetail("Reason", orDash(event.Reason))
			@modal.Section("Record")
			@readingDetail("ID", event.ID)
			@readingDetail("UTC Offset (minutes)", orDash(event.UtcOffsetMinutes))
			@readingDetail("App", orDash(event.CreatedByAppName))
			@readingDetail("Device", orDash(event.CreatedByDeviceName))
			@readingDetail("Created By", event.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, event.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, event.UpdatedAt))
			@readingDetail("Updated By", orDash(event.UpdatedByIdentityName))
		</dl>
	}
}

templ ComponentEventCreated(event *sitemodels.SiteComponentEvent) {
	@componentEventRow(event)
}

// ComponentEventUpdated replaces the change's row, closes its details and shows a toast
templ ComponentEventUpdated(event *sitemodels.SiteComponentEvent) {
	@componentEventRow(event)
	@modal.CloseOOB()
	@successtoast.OOB("Change Updated")
}

templ ComponentEventDeleted() {
	@successtoast.Toast("Change Deleted")
}
