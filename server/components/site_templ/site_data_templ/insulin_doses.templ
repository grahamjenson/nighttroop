package site_data_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// InsulinDosesTable shows one page of insulin doses, newest first, with buttons to the pages either side
templ InsulinDosesTable(insulinDoses []*sitemodels.SiteInsulinDose, skip int64, limit int64) {
	@listpage.Page(listpage.Props{
		ID:          "insulin_doses_table",
		Title:       "Insulin Doses",
		Description: "Newest first. Click an insulin dose to see all its details.",
		Action:      addmodal.Open("site--insulin--add", "/data/insulin/new", "Add Insulin Dose"),
		Above:       searchTotals("site--insulin", "insulin dose", "insulin doses"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "insulinDosesTable",
			EmptyID: "site--insulin--empty",
			Empty:   "No insulin doses here.",
			Columns: []table.Column{
				{Label: "Time"}, {Label: "Units", Numeric: true}, {Label: "Type"}, {Label: "Notes"}, {Label: "Device"},
				{Actions: true},
			},
		},
		Pager: &pager.Props{ID: "site--insulin", Path: "/data/insulin", Count: len(insulinDoses), Skip: skip, Limit: limit},
	}) {
		for _, insulinDose := range insulinDoses {
			@insulinDoseRow(insulinDose)
		}
	}
}

// InsulinDoseNew adds an insulin dose with all its fields, putting its row at the top of the table
templ InsulinDoseNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--insulin--create", Title: "Add Insulin Dose", Path: "/data/insulin", Target: "#insulinDosesTable tbody",
		Submit: "Add Insulin Dose", Fields: insulinDoseFields})
}

// insulinDoseFields are what an insulin dose has that a person can type in
var insulinDoseFields = []addmodal.Field{
	{Name: "dose", Label: "Dose (U)", Help: "Units of insulin given. A negative dose takes back one entered by mistake.", Required: true, Min: "-100", Max: "100", Step: "any"},
	{Name: "occurred_at", Label: "When", Help: "When it was given, in your timezone. Blank is now.", Kind: addmodal.When},
	{Name: "dose_type", Label: "Type", Help: "How it was given, e.g. normal, or SMB for a loop's small automatic bolus.", Kind: addmodal.Text, Max: "32", Options: []string{"normal", "SMB"}},
	{Name: "reason", Label: "Reason", Help: "Why it was given, e.g. a correction or a meal.", Kind: addmodal.Text, Max: "64"},
	{Name: "split_now", Label: "Given at once (%)", Help: "For a combo bolus, the percent of it given straight away, e.g. 70.", Kind: addmodal.Percent, Min: "0", Max: "100"},
	{Name: "split_ext", Label: "Extended (%)", Help: "For a combo bolus, the percent of it given over time, e.g. 30.", Kind: addmodal.Percent, Min: "0", Max: "100"},
	{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
}

templ insulinDoseInputs(id string, dose string, notes string) {
	@field.Field(id+"--dose", "Dose (U)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--dose",
			Type:        input.TypeNumber,
			Name:        "dose",
			Placeholder: "Units",
			Value:       dose,
			Required:    true,
			Attributes:  templ.Attributes{"step": "any", "min": "-100", "max": "100"},
		})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// insulinDoseRow opens the insulin dose's details when clicked.
templ insulinDoseRow(insulinDose *sitemodels.SiteInsulinDose) {
	@table.DataRow("site--insulin--"+insulinDose.ID, "/data/insulin/"+insulinDose.ID, "Delete this insulin dose?") {
		@table.Cell() {
			{ formatReadingDate(ctx, insulinDose.OccurredAt) }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(insulinDose.Dose) }
		}
		@table.Cell() {
			{ orDash(insulinDose.DoseType) }
		}
		@table.Cell(notesCell) {
			{ orDash(insulinDose.Notes) }
		}
		@table.Cell() {
			{ orDash(insulinDose.CreatedByDeviceName) }
		}
	}
}

templ InsulinDoseModal(insulinDose *sitemodels.SiteInsulinDose) {
	@modal.Modal(modal.Props{ID: "site--insulin--details", Title: fmt.Sprintf("%v units", insulinDose.Dose), Subtitle: formatReadingDate(ctx, insulinDose.OccurredAt), Actions: modal.Submit("site--insulin--edit", "Save")}) {
		<form
			id="site--insulin--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/data/insulin/" + insulinDose.ID }
			hx-target={ "#site--insulin--" + insulinDose.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@insulinDoseInputs("site--insulin--edit", fmt.Sprint(insulinDose.Dose), orEmpty(insulinDose.Notes))
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Type", orDash(insulinDose.DoseType))
			@readingDetail("Given at once (%)", percentOr(insulinDose.SplitNow, "-"))
			@readingDetail("Extended (%)", percentOr(insulinDose.SplitExt, "-"))
			@readingDetail("Notes", orDash(insulinDose.Notes))
			@readingDetail("Reason", orDash(insulinDose.Reason))
			@modal.Section("Record")
			@readingDetail("ID", insulinDose.ID)
			@readingDetail("UTC Offset (minutes)", orDash(insulinDose.UtcOffsetMinutes))
			@readingDetail("App", orDash(insulinDose.CreatedByAppName))
			@readingDetail("Device", orDash(insulinDose.CreatedByDeviceName))
			@readingDetail("Created By", insulinDose.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, insulinDose.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, insulinDose.UpdatedAt))
			@readingDetail("Updated By", orDash(insulinDose.UpdatedByIdentityName))
		</dl>
	}
}

templ InsulinDoseCreated(insulinDose *sitemodels.SiteInsulinDose) {
	@insulinDoseRow(insulinDose)
}

// InsulinDoseUpdated replaces the insulin dose's row, closes its details and shows a toast
templ InsulinDoseUpdated(insulinDose *sitemodels.SiteInsulinDose) {
	@insulinDoseRow(insulinDose)
	@modal.CloseOOB()
	@successtoast.OOB("Insulin Dose Updated")
}

templ InsulinDoseDeleted() {
	@successtoast.Toast("Insulin Dose Deleted")
}
