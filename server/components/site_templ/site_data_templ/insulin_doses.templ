package site_data_templ

import (
	"context"
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// InsulinDosesTable shows one page of insulin doses, newest first, with buttons to the pages either side
templ InsulinDosesTable(insulinDoses []*sitemodels.SiteInsulinDose, skip int64, limit int64, before *int64) {
	@listpage.Page(listpage.Props{
		ID:          "insulin_doses_table",
		Title:       i18n.T(ctx, "site.data.insulin_doses.title"),
		Description: i18n.T(ctx, "site.data.insulin_doses.about"),
		Action:      addmodal.Open("site--insulin--add", "/data/insulin/new", i18n.T(ctx, "site.data.insulin_doses.add")),
		Above:       searchTotals("site--insulin", "site.data.insulin_doses.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "insulinDosesTable",
			EmptyID: "site--insulin--empty",
			Empty:   i18n.T(ctx, "site.data.insulin_doses.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: i18n.T(ctx, "site.data.insulin_doses.units"), Numeric: true}, {Label: i18n.T(ctx, "site.data.common.type")}, {Label: i18n.T(ctx, "site.data.common.notes")}, {Label: i18n.T(ctx, "site.data.common.device")},
				{Actions: true},
			},
		},
		Pager: pager.Dated(pager.Props{ID: "site--insulin", Path: "/data/insulin", Count: len(insulinDoses), Skip: skip, Limit: limit}, before, insulinDoses, func(row *sitemodels.SiteInsulinDose) (int64, string) { return row.OccurredAt, row.ID }),
	}) {
		for _, insulinDose := range insulinDoses {
			@insulinDoseRow(insulinDose)
		}
	}
}

// InsulinDoseNew adds an insulin dose with all its fields, putting its row at the top of the table
templ InsulinDoseNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--insulin--create", Title: i18n.T(ctx, "site.data.insulin_doses.add"), Path: "/data/insulin", Target: "#insulinDosesTable tbody",
		Submit: i18n.T(ctx, "site.data.insulin_doses.add"), Fields: insulinDoseFields(ctx)})
}

// insulinDoseFields are what an insulin dose has that a person can type in
func insulinDoseFields(ctx context.Context) []addmodal.Field {
	return []addmodal.Field{
		{Name: "dose", Column: "insulin_doses.Dose", Label: i18n.T(ctx, "site.data.insulin_doses.dose"), Help: i18n.T(ctx, "site.data.insulin_doses.dose_help"), Required: true, Min: "-100", Max: "100", Step: "any"},
		{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: i18n.T(ctx, "site.data.insulin_doses.when_help"), Kind: addmodal.When},
		{Name: "dose_type", Column: "insulin_doses.DoseType", Label: i18n.T(ctx, "site.data.common.type"), Help: i18n.T(ctx, "site.data.insulin_doses.type_help"), Kind: addmodal.Text, Options: []string{"normal", "SMB"}},
		{Name: "reason", Column: "insulin_doses.Reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.insulin_doses.reason_help"), Kind: addmodal.Text},
		{Name: "split_now", Column: "insulin_doses.SplitNow", Label: i18n.T(ctx, "site.data.insulin_doses.split_now"), Help: i18n.T(ctx, "site.data.insulin_doses.split_now_help"), Kind: addmodal.Percent},
		{Name: "split_ext", Column: "insulin_doses.SplitExt", Label: i18n.T(ctx, "site.data.insulin_doses.split_ext"), Help: i18n.T(ctx, "site.data.insulin_doses.split_ext_help"), Kind: addmodal.Percent},
		{Name: "notes", Column: "insulin_doses.Notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Wide: true},
	}
}

// insulinDoseRow opens the insulin dose's details when clicked.
templ insulinDoseRow(insulinDose *sitemodels.SiteInsulinDose) {
	@table.DataRow("site--insulin--"+insulinDose.ID, "/data/insulin/"+insulinDose.ID, i18n.T(ctx, "site.data.insulin_doses.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, insulinDose.OccurredAt) }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(insulinDose.Dose) }
		}
		@table.Cell() {
			{ orDash(insulinDose.DoseType) }
		}
		@table.Cell(notesCell) {
			{ orDash(insulinDose.Notes) }
		}
		@table.Cell() {
			{ orDash(insulinDose.CreatedByDeviceName) }
		}
	}
}

templ InsulinDoseModal(insulinDose *sitemodels.SiteInsulinDose) {
	{{ edit := addmodal.Props{ID: "site--insulin--edit", Path: "/data/insulin/" + insulinDose.ID, Target: "#site--insulin--" + insulinDose.ID, Swap: "outerHTML", Submit: i18n.T(ctx, "site.data.common.save"),
		Fields: addmodal.Edit(insulinDoseFields(ctx), insulinDose, nil)} }}
	@modal.Modal(modal.Props{ID: "site--insulin--details", Title: i18n.T(ctx, "site.data.insulin_doses.details_title", i18n.Data{"Dose": fmt.Sprint(insulinDose.Dose)}), Subtitle: formatReadingDate(ctx, insulinDose.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@RecordDetails(Record{ID: insulinDose.ID, UtcOffset: insulinDose.UtcOffsetMinutes, App: insulinDose.CreatedByAppName, Device: insulinDose.CreatedByDeviceName, CreatedBy: insulinDose.CreatedByIdentityName, Created: insulinDose.CreatedAt, Updated: insulinDose.UpdatedAt, UpdatedBy: insulinDose.UpdatedByIdentityName})
		</dl>
	}
}

templ InsulinDoseCreated(insulinDose *sitemodels.SiteInsulinDose) {
	@insulinDoseRow(insulinDose)
}

// InsulinDoseUpdated replaces the insulin dose's row, closes its details and shows a toast
templ InsulinDoseUpdated(insulinDose *sitemodels.SiteInsulinDose) {
	@insulinDoseRow(insulinDose)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.insulin_doses.updated"))
}

templ InsulinDoseDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.insulin_doses.deleted"))
}
