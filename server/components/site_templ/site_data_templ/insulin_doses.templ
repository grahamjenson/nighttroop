package site_data_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// InsulinDosesTable shows one page of insulin doses, newest first, with buttons to the pages either side
templ InsulinDosesTable(insulinDoses []*sitemodels.SiteInsulinDose, skip int64, limit int64) {
	<div id="insulin_doses_table" class="mx-auto max-w-5xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">Insulin Doses</h1>
			<p class="mt-1 text-gray-500">
				Newest first. Click an insulin dose to see all its details.
			</p>
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@insulinDoseCreateForm()
			@table.Table(table.Props{
				ID:    "insulinDosesTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Units
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Notes
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(insulinDoses) == 0 {
						<tr id="site--insulin--empty"><td colspan="6" class="p-4 text-sm text-gray-500">No insulin doses here.</td></tr>
					}
					for _, insulinDose := range insulinDoses {
						@insulinDoseRow(insulinDose)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "site--insulin", Path: "/data/insulin", Count: len(insulinDoses), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// insulinDoseCreateForm adds an insulin dose given now, putting its row at the top of the table
templ insulinDoseCreateForm() {
	<form
		id="site--insulin--create"
		class="mb-4 flex items-end justify-end gap-2"
		hx-post="/data/insulin"
		hx-target="#insulinDosesTable tbody"
		hx-swap="afterbegin"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		hx-on::after:request="if (ctx.response.status < 400) { this.reset(); document.getElementById('site--insulin--empty')?.remove() }"
	>
		@insulinDoseInputs("site--insulin--create", "", "")
		@button.Button(button.Props{ID: "site--insulin--create--submit", Type: button.TypeSubmit}) {
			Add Insulin Dose
		}
	</form>
}

templ insulinDoseInputs(id string, dose string, notes string) {
	@field.Field(id+"--dose", "Dose (U)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--dose",
			Type:        input.TypeNumber,
			Name:        "dose",
			Placeholder: "Units",
			Value:       dose,
			Required:    true,
			Attributes:  templ.Attributes{"step": "any", "min": "0.01", "max": "100"},
		})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// insulinDoseRow opens the insulin dose's details when clicked. The delete button stops its click reaching the row.
templ insulinDoseRow(insulinDose *sitemodels.SiteInsulinDose) {
	{{ id := "site--insulin--" + insulinDose.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/insulin/" + insulinDose.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(insulinDose.OccurredAt) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ fmt.Sprint(insulinDose.Dose) }
		}
		@table.Cell() {
			{ orDash(insulinDose.DoseType) }
		}
		@table.Cell() {
			{ orDash(insulinDose.Notes) }
		}
		@table.Cell() {
			{ orDash(insulinDose.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              "event.stopPropagation()",
						"hx-delete":            "/data/insulin/" + insulinDose.ID,
						"hx-confirm":           "Delete this insulin dose?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": "if (ctx.response.status < 400) this.closest('tr').remove()",
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ InsulinDoseModal(insulinDose *sitemodels.SiteInsulinDose) {
	@modal.Modal(modal.Props{ID: "site--insulin--details", Title: fmt.Sprintf("%v units", insulinDose.Dose), Subtitle: formatReadingDate(insulinDose.OccurredAt)}) {
		<form
			id="site--insulin--edit"
			class="mt-4 flex items-end gap-2"
			hx-post={ "/data/insulin/" + insulinDose.ID }
			hx-target={ "#site--insulin--" + insulinDose.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@insulinDoseInputs("site--insulin--edit", fmt.Sprint(insulinDose.Dose), orEmpty(insulinDose.Notes))
			@button.Button(button.Props{ID: "site--insulin--edit--submit", Type: button.TypeSubmit}) {
				Save
			}
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Type", orDash(insulinDose.DoseType))
			@readingDetail("Split Now", orDash(insulinDose.SplitNow))
			@readingDetail("Split Extended", orDash(insulinDose.SplitExt))
			@readingDetail("Notes", orDash(insulinDose.Notes))
			@readingDetail("Reason", orDash(insulinDose.Reason))
			@modal.Section("Record")
			@readingDetail("ID", insulinDose.ID)
			@readingDetail("UTC Offset (minutes)", orDash(insulinDose.UtcOffsetMinutes))
			@readingDetail("App", orDash(insulinDose.CreatedByAppName))
			@readingDetail("Device", orDash(insulinDose.CreatedByDeviceName))
			@readingDetail("Created By", insulinDose.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(insulinDose.CreatedAt))
			@readingDetail("Updated", formatReadingDate(insulinDose.UpdatedAt))
			@readingDetail("Updated By", orDash(insulinDose.UpdatedByIdentityName))
		</dl>
		@modal.RawJSON("site--insulin--details--raw", insulinDose.RawJsonData)
	}
}

templ InsulinDoseCreated(insulinDose *sitemodels.SiteInsulinDose) {
	@insulinDoseRow(insulinDose)
}

// InsulinDoseUpdated replaces the insulin dose's row, closes its details and shows a toast
templ InsulinDoseUpdated(insulinDose *sitemodels.SiteInsulinDose) {
	@insulinDoseRow(insulinDose)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@glucoseToast("Insulin Dose Updated")
	</div>
}

templ InsulinDoseDeleted() {
	@glucoseToast("Insulin Dose Deleted")
}
