package site_data_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// NotificationEventsTable shows one page of notifications, newest first, with buttons to the pages either side
templ NotificationEventsTable(events []*sitemodels.SiteNotificationEvent, skip int64, limit int64) {
	<div id="notification_events_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Notifications") {
			Newest first. Click a notification to see all its details.
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@addmodal.Open("site--notification--add", "/data/notifications/new", "Add Notification")
			@table.Table(table.Props{
				ID:    "notificationEventsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Title
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Severity
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(events) == 0 {
						<tr id="site--notification--empty"><td colspan="6" class="p-4 text-sm text-gray-500">No notifications here.</td></tr>
					}
					for _, event := range events {
						@notificationEventRow(event)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "site--notification", Path: "/data/notifications", Count: len(events), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// NotificationEventNew adds a notification with all its fields, putting its row at the top of the table
templ NotificationEventNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--notification--create", Title: "Add Notification", Path: "/data/notifications", Target: "#notificationEventsTable tbody",
		EmptyID: "site--notification--empty", Submit: "Add Notification", Fields: notificationEventFields})
}

// notificationEventFields are what a notification has that a person can type in
var notificationEventFields = []addmodal.Field{
	{Name: "title", Label: "Title", Help: "What it is about, in a few words.", Required: true, Kind: addmodal.Text, Max: "128"},
	{Name: "occurred_at", Label: "When", Help: "When it happened, in your timezone. Blank is now.", Kind: addmodal.When},
	{Name: "severity", Label: "Severity", Help: "How important it is, from 0, the lowest, to 5.", Min: "0", Max: "5", Step: "1"},
	{Name: "notification_type", Label: "Type", Help: "The kind of notification, announcement when left blank.", Kind: addmodal.Text, Max: "32", Options: []string{"announcement", "question"}},
	{Name: "content", Label: "Content", Help: "What it says in full.", Kind: addmodal.Text, Max: "1024", Wide: true},
	{Name: "reason", Label: "Reason", Help: "Why it was sent.", Kind: addmodal.Text, Max: "64"},
	{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
}

templ notificationEventInputs(id string, title string, severity string, notes string) {
	@field.Field(id+"--title", "Title", "w-48") {
		@input.Input(input.Props{ID: id + "--title", Name: "title", Placeholder: "Title", Value: title, Required: true, Attributes: templ.Attributes{"maxlength": "128"}})
	}
	@field.Field(id+"--severity", "Severity (0-5)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--severity",
			Type:        input.TypeNumber,
			Name:        "severity",
			Placeholder: "Severity",
			Value:       severity,
			Attributes:  templ.Attributes{"step": "1", "min": "0", "max": "5"},
		})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// notificationEventRow opens the notification's details when clicked. The delete button stops its click reaching the row.
templ notificationEventRow(event *sitemodels.SiteNotificationEvent) {
	{{ id := "site--notification--" + event.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/notifications/" + event.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(ctx, event.OccurredAt) }
		}
		@table.Cell() {
			{ event.NotificationType }
		}
		@table.Cell() {
			{ event.Title }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ fmt.Sprint(event.Severity) }
		}
		@table.Cell() {
			{ orDash(event.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              templ.JSUnsafeFuncCall("event.stopPropagation()"),
						"hx-delete":            "/data/notifications/" + event.ID,
						"hx-confirm":           "Delete this notification?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ NotificationEventModal(event *sitemodels.SiteNotificationEvent) {
	@modal.Modal(modal.Props{ID: "site--notification--details", Title: fmt.Sprintf("%s: %s", event.NotificationType, event.Title), Subtitle: formatReadingDate(ctx, event.OccurredAt)}) {
		<form
			id="site--notification--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/data/notifications/" + event.ID }
			hx-target={ "#site--notification--" + event.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@notificationEventInputs("site--notification--edit", event.Title, fmt.Sprint(event.Severity), orEmpty(event.Notes))
			@button.Button(button.Props{ID: "site--notification--edit--submit", Type: button.TypeSubmit}) {
				Save
			}
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Severity", fmt.Sprint(event.Severity))
			@readingDetail("Content", orDash(event.Content))
			@readingDetail("Notes", orDash(event.Notes))
			@readingDetail("Reason", orDash(event.Reason))
			@modal.Section("Record")
			@readingDetail("ID", event.ID)
			@readingDetail("UTC Offset (minutes)", orDash(event.UtcOffsetMinutes))
			@readingDetail("App", orDash(event.CreatedByAppName))
			@readingDetail("Device", orDash(event.CreatedByDeviceName))
			@readingDetail("Created By", event.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, event.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, event.UpdatedAt))
			@readingDetail("Updated By", orDash(event.UpdatedByIdentityName))
		</dl>
		@modal.RawJSON("site--notification--details--raw", event.RawJsonData)
	}
}

templ NotificationEventCreated(event *sitemodels.SiteNotificationEvent) {
	@notificationEventRow(event)
}

// NotificationEventUpdated replaces the notification's row, closes its details and shows a toast
templ NotificationEventUpdated(event *sitemodels.SiteNotificationEvent) {
	@notificationEventRow(event)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@glucoseToast("Notification Updated")
	</div>
}

templ NotificationEventDeleted() {
	@glucoseToast("Notification Deleted")
}
