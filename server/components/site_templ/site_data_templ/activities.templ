package site_data_templ

import (
	"context"
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// ActivitiesTable shows one page of activities, newest first, with buttons to the pages either side
templ ActivitiesTable(activities []*sitemodels.SiteActivity, skip int64, limit int64, before *int64) {
	@listpage.Page(listpage.Props{
		ID:          "activities_table",
		Title:       i18n.T(ctx, "site.data.activities.title"),
		Description: i18n.T(ctx, "site.data.activities.about"),
		Action:      addmodal.Open("site--activity--add", "/data/activities/new", i18n.T(ctx, "site.data.activities.add")),
		Above:       searchTotals("site--activity", "site.data.activities.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "activitiesTable",
			EmptyID: "site--activity--empty",
			Empty:   i18n.T(ctx, "site.data.activities.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: i18n.T(ctx, "site.data.common.type")}, {Label: i18n.T(ctx, "site.data.common.name")}, {Label: i18n.T(ctx, "site.data.common.minutes"), Numeric: true}, {Label: i18n.T(ctx, "site.data.common.notes")},
				{Label: i18n.T(ctx, "site.data.common.device")}, {Actions: true},
			},
		},
		Pager: pager.Dated(pager.Props{ID: "site--activity", Path: "/data/activities", Count: len(activities), Skip: skip, Limit: limit}, before, activities, func(row *sitemodels.SiteActivity) (int64, string) { return row.OccurredAt, row.ID }),
	}) {
		for _, activity := range activities {
			@activityRow(activity)
		}
	}
}

// ActivityNew adds an activity with all its fields, putting its row at the top of the table
templ ActivityNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--activity--create", Title: i18n.T(ctx, "site.data.activities.add"), Path: "/data/activities", Target: "#activitiesTable tbody",
		Submit: i18n.T(ctx, "site.data.activities.add"), Fields: activityFields(ctx)})
}

// activityFields are what an activity has that a person can type in
func activityFields(ctx context.Context) []addmodal.Field {
	return []addmodal.Field{
		{Name: "name", Column: "activities.Name", Label: i18n.T(ctx, "site.data.common.name"), Help: i18n.T(ctx, "site.data.activities.name_help"), Required: true, Kind: addmodal.Text},
		{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: i18n.T(ctx, "site.data.activities.when_help"), Kind: addmodal.When},
		{Name: "activity_type", Column: "activities.ActivityType", Label: i18n.T(ctx, "site.data.common.type"), Help: i18n.T(ctx, "site.data.activities.type_help"), Kind: addmodal.Text, Options: []string{"exercise", "walking", "running", "cycling", "swimming"}},
		{Name: "duration_minutes", Column: "activities.DurationMinutes", Label: i18n.T(ctx, "site.data.common.duration_minutes"), Help: i18n.T(ctx, "site.data.activities.duration_help"), Step: "1"},
		{Name: "calories", Column: "activities.Calories", Label: i18n.T(ctx, "site.data.activities.calories"), Help: i18n.T(ctx, "site.data.activities.calories_help"), Step: "1"},
		{Name: "steps", Column: "activities.Steps", Label: i18n.T(ctx, "site.data.activities.steps"), Help: i18n.T(ctx, "site.data.activities.steps_help"), Step: "1"},
		{Name: "heart_rate", Column: "activities.HeartRate", Label: i18n.T(ctx, "site.data.activities.heart_rate"), Help: i18n.T(ctx, "site.data.activities.heart_rate_help"), Step: "1"},
		{Name: "reason", Column: "activities.Reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.activities.reason_help"), Kind: addmodal.Text},
		{Name: "notes", Column: "activities.Notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Wide: true},
	}
}

// activityRow opens the activity's details when clicked.
templ activityRow(activity *sitemodels.SiteActivity) {
	@table.DataRow("site--activity--"+activity.ID, "/data/activities/"+activity.ID, i18n.T(ctx, "site.data.activities.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, activity.OccurredAt) }
		}
		@table.Cell() {
			{ activity.ActivityType }
		}
		@table.Cell() {
			{ orDash(activity.Name) }
		}
		@table.Cell(table.NumCell) {
			{ orDash(activity.DurationMinutes) }
		}
		@table.Cell(notesCell) {
			{ orDash(activity.Notes) }
		}
		@table.Cell() {
			{ orDash(activity.CreatedByDeviceName) }
		}
	}
}

templ ActivityModal(activity *sitemodels.SiteActivity) {
	{{ edit := addmodal.Props{ID: "site--activity--edit", Path: "/data/activities/" + activity.ID, Target: "#site--activity--" + activity.ID, Swap: "outerHTML", Submit: i18n.T(ctx, "site.data.common.save"),
		Fields: addmodal.Edit(activityFields(ctx), activity, nil)} }}
	@modal.Modal(modal.Props{ID: "site--activity--details", Title: fmt.Sprintf("%s: %s", activity.ActivityType, orDash(activity.Name)), Subtitle: formatReadingDate(ctx, activity.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@RecordDetails(Record{ID: activity.ID, UtcOffset: activity.UtcOffsetMinutes, App: activity.CreatedByAppName, Device: activity.CreatedByDeviceName, CreatedBy: activity.CreatedByIdentityName, Created: activity.CreatedAt, Updated: activity.UpdatedAt, UpdatedBy: activity.UpdatedByIdentityName})
		</dl>
	}
}

templ ActivityCreated(activity *sitemodels.SiteActivity) {
	@activityRow(activity)
}

// ActivityUpdated replaces the activity's row, closes its details and shows a toast
templ ActivityUpdated(activity *sitemodels.SiteActivity) {
	@activityRow(activity)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.activities.updated"))
}

templ ActivityDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.activities.deleted"))
}
