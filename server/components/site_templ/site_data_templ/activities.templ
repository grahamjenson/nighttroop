package site_data_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// numberOrEmpty is an optional number for an input, empty when it is not set
func numberOrEmpty(value *int64) string {
	if value == nil {
		return ""
	}
	return fmt.Sprint(*value)
}

// ActivitiesTable shows one page of activities, newest first, with buttons to the pages either side
templ ActivitiesTable(activities []*sitemodels.SiteActivity, skip int64, limit int64) {
	<div id="activities_table" class="mx-auto max-w-5xl space-y-6">
		@heading.PageWith("Activities", addmodal.Open("site--activity--add", "/data/activities/new", "Add Activity")) {
			Newest first. Click an activity to see all its details.
		}
		@searchTotals("site--activity", "activity", "activities")
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{
				ID:    "activitiesTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Name
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Minutes
						}
						@table.Head() {
							Notes
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, activity := range activities {
						@activityRow(activity)
					}
					@pager.Empty("site--activity--empty", 7, "No activities here.")
				}
			}
			@pager.Pager(pager.Props{ID: "site--activity", Path: "/data/activities", Count: len(activities), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// ActivityNew adds an activity with all its fields, putting its row at the top of the table
templ ActivityNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--activity--create", Title: "Add Activity", Path: "/data/activities", Target: "#activitiesTable tbody",
		Submit: "Add Activity", Fields: activityFields})
}

// activityFields are what an activity has that a person can type in
var activityFields = []addmodal.Field{
	{Name: "name", Label: "Name", Help: "What it was, e.g. a run.", Required: true, Kind: addmodal.Text, Max: "64"},
	{Name: "occurred_at", Label: "When", Help: "When it started, in your timezone. Blank is now.", Kind: addmodal.When},
	{Name: "activity_type", Label: "Type", Help: "The kind of activity, exercise when left blank.", Kind: addmodal.Text, Max: "32", Options: []string{"exercise", "walking", "running", "cycling", "swimming"}},
	{Name: "duration_minutes", Label: "Duration (minutes)", Help: "How long it lasted.", Min: "1", Max: "1440", Step: "1"},
	{Name: "calories", Label: "Calories", Help: "Energy it burned, in kcal.", Min: "0", Max: "20000", Step: "1"},
	{Name: "steps", Label: "Steps", Help: "Steps taken during it.", Min: "0", Max: "200000", Step: "1"},
	{Name: "heart_rate", Label: "Heart rate", Help: "Average beats per minute.", Min: "20", Max: "250", Step: "1"},
	{Name: "reason", Label: "Reason", Help: "Why it was done, e.g. training.", Kind: addmodal.Text, Max: "64"},
	{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
}

templ activityInputs(id string, name string, duration string, notes string) {
	@field.Field(id+"--name", "Name", "w-40") {
		@input.Input(input.Props{ID: id + "--name", Name: "name", Placeholder: "Name", Value: name, Required: true, Attributes: templ.Attributes{"maxlength": "64"}})
	}
	@field.Field(id+"--duration", "Duration (min)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--duration",
			Type:        input.TypeNumber,
			Name:        "duration_minutes",
			Placeholder: "Minutes",
			Value:       duration,
			Attributes:  templ.Attributes{"step": "1", "min": "1", "max": "1440"},
		})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// activityRow opens the activity's details when clicked. The delete button stops its click reaching the row.
templ activityRow(activity *sitemodels.SiteActivity) {
	{{ id := "site--activity--" + activity.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/activities/" + activity.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(ctx, activity.OccurredAt) }
		}
		@table.Cell() {
			{ activity.ActivityType }
		}
		@table.Cell() {
			{ orDash(activity.Name) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(activity.DurationMinutes) }
		}
		@table.Cell(notesCell) {
			{ orDash(activity.Notes) }
		}
		@table.Cell() {
			{ orDash(activity.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              templ.JSUnsafeFuncCall("event.stopPropagation()"),
						"hx-delete":            "/data/activities/" + activity.ID,
						"hx-confirm":           "Delete this activity?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: button.DeleteIconClass})
				}
			</div>
		}
	}
}

templ ActivityModal(activity *sitemodels.SiteActivity) {
	@modal.Modal(modal.Props{ID: "site--activity--details", Title: fmt.Sprintf("%s: %s", activity.ActivityType, orDash(activity.Name)), Subtitle: formatReadingDate(ctx, activity.OccurredAt), Actions: modal.Submit("site--activity--edit", "Save")}) {
		<form
			id="site--activity--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/data/activities/" + activity.ID }
			hx-target={ "#site--activity--" + activity.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@activityInputs("site--activity--edit", orEmpty(activity.Name), numberOrEmpty(activity.DurationMinutes), orEmpty(activity.Notes))
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Minutes", orDash(activity.DurationMinutes))
			@readingDetail("Calories", orDash(activity.Calories))
			@readingDetail("Steps", orDash(activity.Steps))
			@readingDetail("Heart Rate", orDash(activity.HeartRate))
			@readingDetail("Notes", orDash(activity.Notes))
			@readingDetail("Reason", orDash(activity.Reason))
			@modal.Section("Record")
			@readingDetail("ID", activity.ID)
			@readingDetail("UTC Offset (minutes)", orDash(activity.UtcOffsetMinutes))
			@readingDetail("App", orDash(activity.CreatedByAppName))
			@readingDetail("Device", orDash(activity.CreatedByDeviceName))
			@readingDetail("Created By", activity.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, activity.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, activity.UpdatedAt))
			@readingDetail("Updated By", orDash(activity.UpdatedByIdentityName))
		</dl>
	}
}

templ ActivityCreated(activity *sitemodels.SiteActivity) {
	@activityRow(activity)
}

// ActivityUpdated replaces the activity's row, closes its details and shows a toast
templ ActivityUpdated(activity *sitemodels.SiteActivity) {
	@activityRow(activity)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@successtoast.Toast("Activity Updated")
	</div>
}

templ ActivityDeleted() {
	@successtoast.Toast("Activity Deleted")
}
