package site_data_templ

import (
	"context"
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// TempBasalsTable shows one page of temp basals, newest first, with buttons to the pages either side
templ TempBasalsTable(tempBasals []*sitemodels.SiteTempBasal, skip int64, limit int64, before *int64) {
	@listpage.Page(listpage.Props{
		ID:          "temp_basals_table",
		Title:       i18n.T(ctx, "site.data.temp_basals.title"),
		Description: i18n.T(ctx, "site.data.temp_basals.about"),
		Action:      addmodal.Open("site--temp-basal--add", "/data/temp-basals/new", i18n.T(ctx, "site.data.temp_basals.add")),
		Above:       searchTotals("site--temp-basal", "site.data.temp_basals.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "tempBasalsTable",
			EmptyID: "site--temp-basal--empty",
			Empty:   i18n.T(ctx, "site.data.temp_basals.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: "U/hr", Numeric: true}, {Label: i18n.T(ctx, "site.data.temp_basals.basal_percent"), Numeric: true},
				{Label: i18n.T(ctx, "site.data.common.minutes"), Numeric: true}, {Label: i18n.T(ctx, "site.data.common.reason")}, {Label: i18n.T(ctx, "site.data.common.device")}, {Actions: true},
			},
		},
		Pager: pager.Dated(pager.Props{ID: "site--temp-basal", Path: "/data/temp-basals", Count: len(tempBasals), Skip: skip, Limit: limit}, before, tempBasals, func(row *sitemodels.SiteTempBasal) (int64, string) { return row.OccurredAt, row.ID }),
	}) {
		for _, tempBasal := range tempBasals {
			@tempBasalRow(tempBasal)
		}
	}
}

// TempBasalNew adds a temp basal with all its fields, putting its row at the top of the table
templ TempBasalNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--temp-basal--create", Title: i18n.T(ctx, "site.data.temp_basals.add"), Path: "/data/temp-basals", Target: "#tempBasalsTable tbody",
		Submit: i18n.T(ctx, "site.data.temp_basals.add"), Fields: tempBasalFields(ctx)})
}

// tempBasalFields are what a temp basal has that a person can type in
func tempBasalFields(ctx context.Context) []addmodal.Field {
	return []addmodal.Field{
		{Name: "rate", Column: "temp_basals.Rate", Label: i18n.T(ctx, "site.data.temp_basals.rate"), Help: i18n.T(ctx, "site.data.temp_basals.rate_help"), Required: true, Max: "50", Step: "any"},
		{Name: "duration_minutes", Column: "temp_basals.DurationMinutes", Label: i18n.T(ctx, "site.data.common.duration_minutes"), Help: i18n.T(ctx, "site.data.temp_basals.duration_help"), Required: true, Min: "1", Max: "1440", Step: "1"},
		{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: i18n.T(ctx, "site.data.temp_basals.when_help"), Kind: addmodal.When},
		{Name: "multiplier", Column: "temp_basals.Multiplier", Label: i18n.T(ctx, "site.data.temp_basals.basal_percent"), Help: i18n.T(ctx, addmodal.MultiplierHelp), Kind: addmodal.Percent, Min: "0.01"},
		{Name: "reason", Column: "temp_basals.Reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.temp_basals.reason_help"), Kind: addmodal.Text},
		{Name: "notes", Column: "temp_basals.Notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Wide: true},
	}
}

// tempBasalRow opens the temp basal's details when clicked.
templ tempBasalRow(tempBasal *sitemodels.SiteTempBasal) {
	@table.DataRow("site--temp-basal--"+tempBasal.ID, "/data/temp-basals/"+tempBasal.ID, i18n.T(ctx, "site.data.temp_basals.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, tempBasal.OccurredAt) }
		}
		@table.Cell(table.NumCell) {
			{ orDash(tempBasal.Rate) }
		}
		@table.Cell(table.NumCell) {
			{ percentOr(tempBasal.Multiplier, "-") }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(tempBasal.DurationMinutes) }
		}
		@table.Cell(notesCell) {
			{ orDash(tempBasal.Reason) }
		}
		@table.Cell() {
			{ orDash(tempBasal.CreatedByDeviceName) }
		}
	}
}

templ TempBasalModal(tempBasal *sitemodels.SiteTempBasal) {
	{{ edit := addmodal.Props{ID: "site--temp-basal--edit", Path: "/data/temp-basals/" + tempBasal.ID, Target: "#site--temp-basal--" + tempBasal.ID, Swap: "outerHTML", Submit: i18n.T(ctx, "site.data.common.save"),
		Fields: addmodal.Edit(tempBasalFields(ctx), tempBasal, nil)} }}
	@modal.Modal(modal.Props{ID: "site--temp-basal--details", Title: i18n.T(ctx, "site.data.temp_basals.details_title", i18n.Data{"Rate": orDash(tempBasal.Rate), "Minutes": tempBasal.DurationMinutes}), Subtitle: formatReadingDate(ctx, tempBasal.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@RecordDetails(Record{ID: tempBasal.ID, UtcOffset: tempBasal.UtcOffsetMinutes, App: tempBasal.CreatedByAppName, Device: tempBasal.CreatedByDeviceName, CreatedBy: tempBasal.CreatedByIdentityName, Created: tempBasal.CreatedAt, Updated: tempBasal.UpdatedAt, UpdatedBy: tempBasal.UpdatedByIdentityName})
		</dl>
	}
}

templ TempBasalCreated(tempBasal *sitemodels.SiteTempBasal) {
	@tempBasalRow(tempBasal)
}

// TempBasalUpdated replaces the temp basal's row, closes its details and shows a toast
templ TempBasalUpdated(tempBasal *sitemodels.SiteTempBasal) {
	@tempBasalRow(tempBasal)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.temp_basals.updated"))
}

templ TempBasalDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.temp_basals.deleted"))
}
