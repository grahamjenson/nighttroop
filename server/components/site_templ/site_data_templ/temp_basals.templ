package site_data_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// TempBasalsTable shows one page of temp basals, newest first, with buttons to the pages either side
templ TempBasalsTable(tempBasals []*sitemodels.SiteTempBasal, skip int64, limit int64) {
	<div id="temp_basals_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Temp Basals") {
			Newest first. Click a temp basal to see all its details.
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@tempBasalCreateForm()
			@table.Table(table.Props{
				ID:    "tempBasalsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							U/hr
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Percent
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Minutes
						}
						@table.Head() {
							Reason
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(tempBasals) == 0 {
						<tr id="site--temp-basal--empty"><td colspan="7" class="p-4 text-sm text-gray-500">No temp basals here.</td></tr>
					}
					for _, tempBasal := range tempBasals {
						@tempBasalRow(tempBasal)
					}
				}
			}
			@pager.Pager(pager.Props{ID: "site--temp-basal", Path: "/data/temp-basals", Count: len(tempBasals), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// tempBasalCreateForm adds a temp basal starting now, putting its row at the top of the table
templ tempBasalCreateForm() {
	<form
		id="site--temp-basal--create"
		class="mb-4 flex items-end justify-end gap-2"
		hx-post="/data/temp-basals"
		hx-target="#tempBasalsTable tbody"
		hx-swap="afterbegin"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		hx-on::after:request="if (ctx.response.status < 400) { this.reset(); document.getElementById('site--temp-basal--empty')?.remove() }"
	>
		@tempBasalInputs("site--temp-basal--create", "", "", "")
		@button.Button(button.Props{ID: "site--temp-basal--create--submit", Type: button.TypeSubmit}) {
			Add Temp Basal
		}
	</form>
}

templ tempBasalInputs(id string, absolute string, duration string, notes string) {
	@field.Field(id+"--absolute", "Rate (U/hr)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--absolute",
			Type:        input.TypeNumber,
			Name:        "absolute",
			Placeholder: "U/hr",
			Value:       absolute,
			Required:    true,
			Attributes:  templ.Attributes{"step": "any", "min": "0", "max": "50"},
		})
	}
	@field.Field(id+"--duration", "Duration (min)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--duration",
			Type:        input.TypeNumber,
			Name:        "duration_minutes",
			Placeholder: "Minutes",
			Value:       duration,
			Required:    true,
			Attributes:  templ.Attributes{"step": "1", "min": "1", "max": "1440"},
		})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// tempBasalRow opens the temp basal's details when clicked. The delete button stops its click reaching the row.
templ tempBasalRow(tempBasal *sitemodels.SiteTempBasal) {
	{{ id := "site--temp-basal--" + tempBasal.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/temp-basals/" + tempBasal.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(ctx, tempBasal.OccurredAt) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(tempBasal.Absolute) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(tempBasal.Percent) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ fmt.Sprint(tempBasal.DurationMinutes) }
		}
		@table.Cell() {
			{ orDash(tempBasal.Reason) }
		}
		@table.Cell() {
			{ orDash(tempBasal.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              "event.stopPropagation()",
						"hx-delete":            "/data/temp-basals/" + tempBasal.ID,
						"hx-confirm":           "Delete this temp basal?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": "if (ctx.response.status < 400) this.closest('tr').remove()",
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ TempBasalModal(tempBasal *sitemodels.SiteTempBasal) {
	@modal.Modal(modal.Props{ID: "site--temp-basal--details", Title: fmt.Sprintf("%s U/hr for %d minutes", orDash(tempBasal.Absolute), tempBasal.DurationMinutes), Subtitle: formatReadingDate(ctx, tempBasal.OccurredAt)}) {
		<form
			id="site--temp-basal--edit"
			class="mt-4 flex items-end gap-2"
			hx-post={ "/data/temp-basals/" + tempBasal.ID }
			hx-target={ "#site--temp-basal--" + tempBasal.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@tempBasalInputs("site--temp-basal--edit", orDash(tempBasal.Absolute), fmt.Sprint(tempBasal.DurationMinutes), orEmpty(tempBasal.Notes))
			@button.Button(button.Props{ID: "site--temp-basal--edit--submit", Type: button.TypeSubmit}) {
				Save
			}
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Percent", orDash(tempBasal.Percent))
			@readingDetail("Notes", orDash(tempBasal.Notes))
			@readingDetail("Reason", orDash(tempBasal.Reason))
			@modal.Section("Record")
			@readingDetail("ID", tempBasal.ID)
			@readingDetail("UTC Offset (minutes)", orDash(tempBasal.UtcOffsetMinutes))
			@readingDetail("App", orDash(tempBasal.CreatedByAppName))
			@readingDetail("Device", orDash(tempBasal.CreatedByDeviceName))
			@readingDetail("Created By", tempBasal.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, tempBasal.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, tempBasal.UpdatedAt))
			@readingDetail("Updated By", orDash(tempBasal.UpdatedByIdentityName))
		</dl>
		@modal.RawJSON("site--temp-basal--details--raw", tempBasal.RawJsonData)
	}
}

templ TempBasalCreated(tempBasal *sitemodels.SiteTempBasal) {
	@tempBasalRow(tempBasal)
}

// TempBasalUpdated replaces the temp basal's row, closes its details and shows a toast
templ TempBasalUpdated(tempBasal *sitemodels.SiteTempBasal) {
	@tempBasalRow(tempBasal)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@glucoseToast("Temp Basal Updated")
	</div>
}

templ TempBasalDeleted() {
	@glucoseToast("Temp Basal Deleted")
}
