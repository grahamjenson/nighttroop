package site_data_templ

import (
	"context"
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

// TempTargetsTable shows one page of temp targets, newest first, with buttons to the pages either side
templ TempTargetsTable(tempTargets []*sitemodels.SiteTempTarget, skip int64, limit int64) {
	{{ units := string(*glucoseUnits(ctx)) }}
	@listpage.Page(listpage.Props{
		ID:          "temp_targets_table",
		Title:       i18n.T(ctx, "site.data.temp_targets.title"),
		Description: i18n.T(ctx, "site.data.temp_targets.about"),
		Action:      addmodal.Open("site--temp-target--add", "/data/temp-targets/new", i18n.T(ctx, "site.data.temp_targets.add")),
		Above:       searchTotals("site--temp-target", "site.data.temp_targets.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "tempTargetsTable",
			EmptyID: "site--temp-target--empty",
			Empty:   i18n.T(ctx, "site.data.temp_targets.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: i18n.T(ctx, "site.data.temp_targets.low", i18n.Data{"Units": units}), Numeric: true},
				{Label: i18n.T(ctx, "site.data.temp_targets.high", i18n.Data{"Units": units}), Numeric: true}, {Label: i18n.T(ctx, "site.data.temp_targets.duration_min"), Numeric: true},
				{Label: i18n.T(ctx, "site.data.common.reason")}, {Label: i18n.T(ctx, "site.data.common.device")}, {Actions: true},
			},
		},
		Pager: &pager.Props{ID: "site--temp-target", Path: "/data/temp-targets", Count: len(tempTargets), Skip: skip, Limit: limit},
	}) {
		for _, tempTarget := range tempTargets {
			@tempTargetRow(tempTarget)
		}
	}
}

// TempTargetNew adds a temp target with all its fields, putting its row at the top of the table
templ TempTargetNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--temp-target--create", Title: i18n.T(ctx, "site.data.temp_targets.add"), Path: "/data/temp-targets", Target: "#tempTargetsTable tbody",
		Submit: i18n.T(ctx, "site.data.temp_targets.add"), Fields: tempTargetFields(ctx)})
}

// tempTargetFields are what a temp target has that a person can type in
func tempTargetFields(ctx context.Context) []addmodal.Field {
	attributes, units := glucoseInputAttributes(ctx), string(*glucoseUnits(ctx))
	low, high := fmt.Sprint(attributes["min"]), fmt.Sprint(attributes["max"])
	return []addmodal.Field{
		{Name: "low_target", Label: i18n.T(ctx, "site.data.temp_targets.low", i18n.Data{"Units": units}), Help: i18n.T(ctx, "site.data.temp_targets.low_help"), Required: true, Min: low, Max: high, Step: "any"},
		{Name: "high_target", Label: i18n.T(ctx, "site.data.temp_targets.high", i18n.Data{"Units": units}), Help: i18n.T(ctx, "site.data.temp_targets.high_help"), Required: true, Min: low, Max: high, Step: "any"},
		{Name: "duration_minutes", Label: i18n.T(ctx, "site.data.common.duration_minutes"), Help: i18n.T(ctx, "site.data.temp_targets.duration_help"), Required: true, Min: "1", Max: "10080", Step: "1"},
		{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: i18n.T(ctx, "site.data.temp_targets.when_help"), Kind: addmodal.When},
		{Name: "insulin_needs_scale_factor", Label: i18n.T(ctx, "site.data.temp_targets.insulin_needs"), Help: i18n.T(ctx, "site.data.temp_targets.insulin_needs_help"), Min: "0", Max: "10", Step: "any"},
		{Name: "reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.temp_targets.reason_help"), Kind: addmodal.Text, Max: "64", Options: []string{"Activity", "Eating Soon", "Hypo"}},
		{Name: "notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Max: "1024", Wide: true},
	}
}

// tempTargetRow opens the temp target's details when clicked.
templ tempTargetRow(tempTarget *sitemodels.SiteTempTarget) {
	@table.DataRow("site--temp-target--"+tempTarget.ID, "/data/temp-targets/"+tempTarget.ID, i18n.T(ctx, "site.data.temp_targets.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, tempTarget.OccurredAt) }
		}
		@table.Cell(table.NumCell) {
			{ formatGlucose(ctx, tempTarget.LowTarget, tempTarget.Units) }
		}
		@table.Cell(table.NumCell) {
			{ formatGlucose(ctx, tempTarget.HighTarget, tempTarget.Units) }
		}
		@table.Cell(table.NumCell) {
			{ fmt.Sprint(tempTarget.DurationMinutes) }
		}
		@table.Cell(notesCell) {
			{ orDash(tempTarget.Reason) }
		}
		@table.Cell() {
			{ orDash(tempTarget.CreatedByDeviceName) }
		}
	}
}

templ TempTargetModal(tempTarget *sitemodels.SiteTempTarget) {
	{{ edit := addmodal.Props{ID: "site--temp-target--edit", Path: "/data/temp-targets/" + tempTarget.ID, Target: "#site--temp-target--" + tempTarget.ID, Swap: "outerHTML", Submit: i18n.T(ctx, "site.data.common.save"),
		Fields: addmodal.Edit(tempTargetFields(ctx), tempTarget, map[string]string{"low_target": display.GlucoseValue(tempTarget.LowTarget, tempTarget.Units), "high_target": display.GlucoseValue(tempTarget.HighTarget, tempTarget.Units)}, "insulin_needs_scale_factor")} }}
	@modal.Modal(modal.Props{ID: "site--temp-target--details", Title: i18n.T(ctx, "site.data.temp_targets.details_title", i18n.Data{"Low": formatGlucose(ctx, tempTarget.LowTarget, tempTarget.Units), "High": formatGlucose(ctx, tempTarget.HighTarget, tempTarget.Units), "Units": orDash(tempTarget.Units), "Minutes": tempTarget.DurationMinutes}), Subtitle: formatReadingDate(ctx, tempTarget.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@addmodal.Detail(edit, "insulin_needs_scale_factor", i18n.T(ctx, "site.data.temp_targets.insulin_needs"), orDash(tempTarget.InsulinNeedsScaleFactor))
			@RecordDetails(Record{ID: tempTarget.ID, UtcOffset: tempTarget.UtcOffsetMinutes, App: tempTarget.CreatedByAppName, Device: tempTarget.CreatedByDeviceName, CreatedBy: tempTarget.CreatedByIdentityName, Created: tempTarget.CreatedAt, Updated: tempTarget.UpdatedAt, UpdatedBy: tempTarget.UpdatedByIdentityName})
		</dl>
	}
}

templ TempTargetCreated(tempTarget *sitemodels.SiteTempTarget) {
	@tempTargetRow(tempTarget)
}

// TempTargetUpdated replaces the temp target's row, closes its details and shows a toast
templ TempTargetUpdated(tempTarget *sitemodels.SiteTempTarget) {
	@tempTargetRow(tempTarget)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.temp_targets.updated"))
}

templ TempTargetDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.temp_targets.deleted"))
}
