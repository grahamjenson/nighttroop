package site_data_templ

import (
	"context"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// ProfileSwitchesTable shows one page of profile switches, newest first, with buttons to the pages either side
templ ProfileSwitchesTable(profileSwitches []*sitemodels.SiteProfileSwitch, skip int64, limit int64, before *int64) {
	@listpage.Page(listpage.Props{
		ID:          "profile_switches_table",
		Title:       i18n.T(ctx, "site.data.profile_switches.title"),
		Description: i18n.T(ctx, "site.data.profile_switches.about"),
		Action:      addmodal.Open("site--profile-switch--add", "/data/profile-switches/new", i18n.T(ctx, "site.data.profile_switches.add")),
		Above:       searchTotals("site--profile-switch", "site.data.profile_switches.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			ID:      "profileSwitchesTable",
			EmptyID: "site--profile-switch--empty",
			Empty:   i18n.T(ctx, "site.data.profile_switches.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: i18n.T(ctx, "site.data.common.name")}, {Label: i18n.T(ctx, "site.data.profile_switches.insulin_percent"), Numeric: true},
				{Label: i18n.T(ctx, "site.data.profile_switches.shift"), Numeric: true}, {Label: i18n.T(ctx, "site.data.common.minutes"), Numeric: true}, {Label: i18n.T(ctx, "site.data.common.device")}, {Actions: true},
			},
		},
		Pager: pager.Dated(pager.Props{ID: "site--profile-switch", Path: "/data/profile-switches", Count: len(profileSwitches), Skip: skip, Limit: limit}, before, profileSwitches, func(row *sitemodels.SiteProfileSwitch) (int64, string) { return row.OccurredAt, row.ID }),
	}) {
		for _, profileSwitch := range profileSwitches {
			@profileSwitchRow(profileSwitch)
		}
	}
}

// ProfileSwitchNew adds a profile switch with all its fields, putting its row at the top of the table
templ ProfileSwitchNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--profile-switch--create", Title: i18n.T(ctx, "site.data.profile_switches.add"), Path: "/data/profile-switches", Target: "#profileSwitchesTable tbody",
		Submit: i18n.T(ctx, "site.data.profile_switches.add"), Fields: profileSwitchFields(ctx)})
}

// profileSwitchFields are what a profile switch has that a person can type in
func profileSwitchFields(ctx context.Context) []addmodal.Field {
	return []addmodal.Field{
		{Name: "name", Column: "profile_switches.Name", Label: i18n.T(ctx, "site.data.profile_switches.profile"), Help: i18n.T(ctx, "site.data.profile_switches.profile_help"), Required: true, Kind: addmodal.Text},
		{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: i18n.T(ctx, "site.data.profile_switches.when_help"), Kind: addmodal.When},
		{Name: "multiplier", Column: "profile_switches.Multiplier", Label: i18n.T(ctx, "site.data.profile_switches.insulin_percent"), Help: i18n.T(ctx, addmodal.MultiplierHelp), Kind: addmodal.Percent, Value: "100"},
		{Name: "timeshift", Column: "profile_switches.Timeshift", Label: i18n.T(ctx, "site.data.profile_switches.shift_minutes"), Help: i18n.T(ctx, "site.data.profile_switches.shift_help"), Step: "1", Value: "0"},
		{Name: "duration_minutes", Column: "profile_switches.DurationMinutes", Label: i18n.T(ctx, "site.data.common.duration_minutes"), Help: i18n.T(ctx, "site.data.profile_switches.duration_help"), Step: "1"},
		{Name: "reason", Column: "profile_switches.Reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.profile_switches.reason_help"), Kind: addmodal.Text},
		{Name: "notes", Column: "profile_switches.Notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Wide: true},
	}
}

// profileSwitchInputs always send a multiplier, shift and minutes, as an empty number is not one
// profileSwitchRow opens the profile switch's details when clicked.
templ profileSwitchRow(profileSwitch *sitemodels.SiteProfileSwitch) {
	@table.DataRow("site--profile-switch--"+profileSwitch.ID, "/data/profile-switches/"+profileSwitch.ID, i18n.T(ctx, "site.data.profile_switches.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, profileSwitch.OccurredAt) }
		}
		@table.Cell() {
			{ profileSwitch.Name }
		}
		@table.Cell(table.NumCell) {
			{ percentOr(profileSwitch.Multiplier, "-") }
		}
		@table.Cell(table.NumCell) {
			{ orDash(profileSwitch.Timeshift) }
		}
		@table.Cell(table.NumCell) {
			{ orDash(profileSwitch.DurationMinutes) }
		}
		@table.Cell() {
			{ orDash(profileSwitch.CreatedByDeviceName) }
		}
	}
}

templ ProfileSwitchModal(profileSwitch *sitemodels.SiteProfileSwitch) {
	{{ siteContext, units := httputils.GetSiteContext(ctx), glucoseUnits(ctx) }}
	{{ unitsLabel := orEmpty(units.Stringp()) }}
	{{ edit := addmodal.Props{ID: "site--profile-switch--edit", Path: "/data/profile-switches/" + profileSwitch.ID, Target: "#site--profile-switch--" + profileSwitch.ID, Swap: "outerHTML", Submit: i18n.T(ctx, "site.data.common.save"),
		Fields: addmodal.Edit(profileSwitchFields(ctx), profileSwitch, nil)} }}
	@modal.Modal(modal.Props{ID: "site--profile-switch--details", Title: i18n.T(ctx, "site.data.profile_switches.details_title", i18n.Data{"Name": profileSwitch.Name, "Percent": percentOr(profileSwitch.Multiplier, "-")}), Subtitle: formatReadingDate(ctx, profileSwitch.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<div id="site--profile-switch--details--schedules" class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-5">
			@ProfileSchedule("site--profile-switch--details--basal-rates", i18n.T(ctx, "site.data.profile_switches.basal_schedule"), sitemodels.ScheduleFromJSON(profileSwitch.BasalRatesJson), ScheduleValue)
			@ProfileSchedule("site--profile-switch--details--carb-ratios", i18n.T(ctx, "site.data.profile_switches.carb_ratio_schedule"), sitemodels.ScheduleFromJSON(profileSwitch.CarbRatiosJson), ScheduleValue)
			@ProfileSchedule("site--profile-switch--details--sensitivities", i18n.T(ctx, "site.data.profile_switches.sensitivity_schedule", i18n.Data{"Units": unitsLabel}), sitemodels.SensitivityScheduleFromJSON(profileSwitch.InsulinSensitivitiesJson, profileSwitch.Units, siteContext), GlucoseValue(units))
			@ProfileSchedule("site--profile-switch--details--targets-low", i18n.T(ctx, "site.data.profile_switches.low_target_schedule", i18n.Data{"Units": unitsLabel}), sitemodels.GlucoseScheduleFromJSON(profileSwitch.TargetsLowJson, siteContext), GlucoseValue(units))
			@ProfileSchedule("site--profile-switch--details--targets-high", i18n.T(ctx, "site.data.profile_switches.high_target_schedule", i18n.Data{"Units": unitsLabel}), sitemodels.GlucoseScheduleFromJSON(profileSwitch.TargetsHighJson, siteContext), GlucoseValue(units))
		</div>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@addmodal.Detail(edit, "dia", i18n.T(ctx, "site.data.profile_switches.dia"), orDash(profileSwitch.Dia))
			@addmodal.Detail(edit, "units", i18n.T(ctx, "site.data.profile_switches.profile_units"), orDash(profileSwitch.Units))
			@addmodal.Detail(edit, "timezone", i18n.T(ctx, "site.data.profile_switches.timezone"), orDash(profileSwitch.Timezone))
			@addmodal.Detail(edit, "carbs_hr", i18n.T(ctx, "site.data.profile_switches.carbs_per_hour"), orDash(profileSwitch.CarbsHr))
			@addmodal.Detail(edit, "delay", i18n.T(ctx, "site.data.profile_switches.delay"), orDash(profileSwitch.Delay))
			@RecordDetails(Record{ID: profileSwitch.ID, UtcOffset: profileSwitch.UtcOffsetMinutes, App: profileSwitch.CreatedByAppName, Device: profileSwitch.CreatedByDeviceName, CreatedBy: profileSwitch.CreatedByIdentityName, Created: profileSwitch.CreatedAt, Updated: profileSwitch.UpdatedAt, UpdatedBy: profileSwitch.UpdatedByIdentityName})
		</dl>
	}
}

templ ProfileSwitchCreated(profileSwitch *sitemodels.SiteProfileSwitch) {
	@profileSwitchRow(profileSwitch)
}

// ProfileSwitchUpdated replaces the profile switch's row, closes its details and shows a toast
templ ProfileSwitchUpdated(profileSwitch *sitemodels.SiteProfileSwitch) {
	@profileSwitchRow(profileSwitch)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.profile_switches.updated"))
}

templ ProfileSwitchDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.profile_switches.deleted"))
}
