package site_data_templ

import (
	"context"
	"fmt"
	"math"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
)

// Location is the timezone of the identity's, site's or default settings, which times are shown in
func Location(ctx context.Context) *time.Location {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil {
		return siteContext.GetSettings().Location()
	}
	return time.UTC
}

// dateLayout is the Go layout of the identity's, site's or default date format
func dateLayout(ctx context.Context) string {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil {
		return siteContext.GetSettings().DateLayout()
	}
	return time.DateOnly
}

// timeLayout is the Go layout of the identity's, site's or default time format
func timeLayout(ctx context.Context) string {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil {
		return siteContext.GetSettings().TimeLayout()
	}
	return time.TimeOnly
}

// formatReadingDate is a time in the settings' timezone, date format and time format
func formatReadingDate(ctx context.Context, ms int64) string {
	return time.UnixMilli(ms).In(Location(ctx)).Format(dateLayout(ctx) + " " + timeLayout(ctx))
}

// FormatDate shows times the same way on other pages
var FormatDate = formatReadingDate

// glucoseUnits are the units glucose is shown and typed in, from the identity's, site's or default settings
func glucoseUnits(ctx context.Context) *consts.Units {
	return sitemodels.ContextUnits(httputils.GetSiteContext(ctx))
}

// formatGlucose shows glucose on the data pages as every page does: mmol/L to one decimal place, mg/dL whole
func formatGlucose(value float64, units *consts.Units) string {
	return display.Glucose(value, units)
}

// glucoseInputAttributes keeps a typed in glucose value within what the store accepts, in the settings' units
func glucoseInputAttributes(ctx context.Context) templ.Attributes {
	return templ.Attributes{"step": "any", "min": "0.1", "max": fmt.Sprint(consts.Round(glucoseUnits(ctx).FromMGDL(1000), 1))}
}

// GlucoseText and GlucoseFill colour a reading "Low", "High" or in range, "", with the theme's glucose colours, as text
// and on a graph, high text in the darker amber that can be read as text
var (
	GlucoseText = map[string]string{"Low": "text-glucose-low", "High": "text-glucose-high-text", "": "text-glucose-in-range"}
	GlucoseFill = map[string]string{"Low": "fill-glucose-low", "High": "fill-glucose-high", "": "fill-glucose-in-range"}
)

// RangeBounds are the range settings, low and high, in the settings' units, for this and other pages' graphs
func RangeBounds(ctx context.Context) (float64, float64) {
	settings, units := httputils.GetSiteContext(ctx).GetSettings(), glucoseUnits(ctx)
	return units.FromMGDL(float64(*settings.GetRangeLowMgdl())), units.FromMGDL(float64(*settings.GetRangeHighMgdl()))
}

// glucoseRange is "Low" or "High" for a reading, in the settings' units, below or above the range settings
func glucoseRange(ctx context.Context, reading float64) string {
	low, high := RangeBounds(ctx)
	return display.GlucoseRange(reading, low, high)
}

// glucoseReadingCell colours an out of range reading's cell, with a title saying whether it is low or high
func glucoseReadingCell(ctx context.Context, reading float64) table.CellProps {
	props := table.CellProps{Class: "text-right tabular-nums"}
	if outOfRange := glucoseRange(ctx, reading); outOfRange != "" {
		props.Class += " font-medium " + GlucoseText[outOfRange]
		props.Attributes = templ.Attributes{"title": outOfRange}
	}
	return props
}

// glucoseRangeMarker marks an out of range reading in words, not only colour: H or L beside it, read out as High or Low
templ glucoseRangeMarker(outOfRange string) {
	if outOfRange != "" {
		<span class="ml-1 text-xs font-semibold" aria-hidden="true">{ outOfRange[:1] }</span>
		<span class="sr-only">{ outOfRange }</span>
	}
}

// directionDetail is a reading's trend as its arrow and Nightscout's name for it, like "↗ FortyFiveUp"
func directionDetail(direction *string) string {
	if direction == nil {
		return "-"
	}
	return display.Direction(direction) + " " + *direction
}

// orDash shows an optional value, or a dash when it is not set
// notesCell is a table cell of free text, like notes, which wraps where every other cell keeps to one line
var notesCell = table.CellProps{Class: "min-w-48 whitespace-normal"}

func orDash[T any](value *T) string {
	if value == nil {
		return "-"
	}
	return fmt.Sprint(*value)
}

// percentOr is a fraction as the percent it is typed in as, e.g. 1.2 as 120, or unset when it has none
func percentOr(fraction *float64, unset string) string {
	if fraction == nil {
		return unset
	}
	return fmt.Sprint(math.Round(*fraction*10000) / 100)
}

// GlucoseReadingsTable shows one page of readings, newest first, with buttons to the pages either side
templ GlucoseReadingsTable(readings []*sitemodels.SiteGlucoseReading, skip int64, limit int64) {
	<div id="glucose_readings_table" class="mx-auto max-w-5xl space-y-6">
		@heading.PageWith("Glucose Readings", addmodal.Open("site--glucose--add", "/data/glucose/new", "Add Reading")) {
			Newest first. Click a reading to see all its details.
		}
		@searchTotals("site--glucose", "glucose reading", "glucose readings")
		if skip == 0 {
			<div id="site--glucose--days-loading" hx-get="/data/summary-daily?limit=10" hx-trigger="load" hx-swap="outerHTML"></div>
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{
				ID:    "glucoseReadingsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							{ string(*glucoseUnits(ctx)) }
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Direction
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, reading := range readings {
						@glucoseReadingRow(reading)
					}
					@pager.Empty("site--glucose--empty", 6, "No glucose readings here.")
				}
			}
			@pager.Pager(pager.Props{ID: "site--glucose", Path: "/data/glucose", Count: len(readings), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// GlucoseReadingNew adds a glucose reading with all its fields, putting its row at the top of the table
templ GlucoseReadingNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--glucose--create", Title: "Add Reading", Path: "/data/glucose", Target: "#glucoseReadingsTable tbody",
		Submit: "Add Reading", Fields: glucoseFields(ctx)})
}

// glucoseFields are what a glucose reading has that a person can type in
func glucoseFields(ctx context.Context) []addmodal.Field {
	attributes, units := glucoseInputAttributes(ctx), string(*glucoseUnits(ctx))
	return []addmodal.Field{
		{Name: "reading", Label: "Reading (" + units + ")", Help: "The glucose measured, in your units.", Required: true, Min: fmt.Sprint(attributes["min"]), Max: fmt.Sprint(attributes["max"]), Step: "any"},
		{Name: "occurred_at", Label: "When", Help: "When it was measured, in your timezone. Blank is now.", Kind: addmodal.When},
		{Name: "reading_type", Label: "Type", Help: "A finger prick meter or a sensor.", Required: true, Kind: addmodal.Select, Options: []string{"mbg", "sgv"}, OptionLabel: display.ReadingType},
		{Name: "measurement_method", Label: "Method", Help: "How it was measured, e.g. a meter.", Kind: addmodal.Text, Max: "32", Options: []string{"meter", "cgm", "manual"}},
		{Name: "direction", Label: "Trend", Help: "Which way it was heading, for a sensor reading.", Kind: addmodal.Select, Options: []string{"DoubleUp", "SingleUp", "FortyFiveUp", "Flat", "FortyFiveDown", "SingleDown", "DoubleDown"},
			OptionLabel: func(direction string) string { return directionDetail(&direction) }},
		{Name: "reason", Label: "Reason", Help: "Why it was measured, e.g. before a meal.", Kind: addmodal.Text, Max: "64"},
		{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
	}
}

templ glucoseInputs(id string, value string, notes string) {
	@field.Field(id+"--reading", "Reading ("+string(*glucoseUnits(ctx))+")", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--reading",
			Type:        input.TypeNumber,
			Name:        "reading",
			Placeholder: string(*glucoseUnits(ctx)),
			Value:       value,
			Required:    true,
			Attributes:  glucoseInputAttributes(ctx),
		})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// glucoseReadingRow opens the reading's details when clicked.
templ glucoseReadingRow(reading *sitemodels.SiteGlucoseReading) {
	@table.DataRow("site--glucose--"+reading.ID, "/data/glucose/"+reading.ID, "Delete this glucose reading?") {
		@table.Cell() {
			{ formatReadingDate(ctx, reading.OccurredAt) }
		}
		@table.Cell(glucoseReadingCell(ctx, reading.Reading)) {
			{ formatGlucose(reading.Reading, reading.Units) }
			@glucoseRangeMarker(glucoseRange(ctx, reading.Reading))
		}
		@table.Cell() {
			{ display.ReadingType(reading.ReadingType) }
		}
		@table.Cell() {
			<span title={ orDash(reading.Direction) }>{ display.Direction(reading.Direction) }</span>
		}
		@table.Cell() {
			{ orDash(reading.CreatedByDeviceName) }
		}
	}
}

templ GlucoseReadingModal(reading *sitemodels.SiteGlucoseReading) {
	@modal.Modal(modal.Props{ID: "site--glucose--details", Title: formatGlucose(reading.Reading, reading.Units) + " " + orDash(reading.Units), Subtitle: formatReadingDate(ctx, reading.OccurredAt), Actions: modal.Submit("site--glucose--edit", "Save")}) {
		<form
			id="site--glucose--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/data/glucose/" + reading.ID }
			hx-target={ "#site--glucose--" + reading.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@glucoseInputs("site--glucose--edit", formatGlucose(reading.Reading, reading.Units), orEmpty(reading.Notes))
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Type", display.ReadingType(reading.ReadingType))
			@readingDetail("Original Units", orDash(reading.OriginalUnits))
			@readingDetail("Measurement Method", orDash(reading.MeasurementMethod))
			@readingDetail("Direction", directionDetail(reading.Direction))
			@readingDetail("Delta", orDash(reading.Delta))
			@readingDetail("Noise", orDash(reading.Noise))
			@readingDetail("Filtered", orDash(reading.Filtered))
			@readingDetail("Unfiltered", orDash(reading.Unfiltered))
			@readingDetail("RSSI", orDash(reading.Rssi))
			@readingDetail("Notes", orDash(reading.Notes))
			@readingDetail("Reason", orDash(reading.Reason))
			@modal.Section("Record")
			@readingDetail("ID", reading.ID)
			@readingDetail("UTC Offset (minutes)", orDash(reading.UtcOffsetMinutes))
			@readingDetail("App", orDash(reading.CreatedByAppName))
			@readingDetail("Device", orDash(reading.CreatedByDeviceName))
			@readingDetail("Created By", reading.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, reading.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, reading.UpdatedAt))
			@readingDetail("Updated By", orDash(reading.UpdatedByIdentityName))
		</dl>
	}
}

var readingDetail = modal.DetailIfSet

func orEmpty(value *string) string {
	if value == nil {
		return ""
	}
	return *value
}

templ GlucoseReadingCreated(reading *sitemodels.SiteGlucoseReading) {
	@glucoseReadingRow(reading)
}

// GlucoseReadingUpdated replaces the reading's row, closes its details and shows a toast
templ GlucoseReadingUpdated(reading *sitemodels.SiteGlucoseReading) {
	@glucoseReadingRow(reading)
	@modal.CloseOOB()
	@successtoast.OOB("Glucose Reading Updated")
}

templ GlucoseReadingDeleted() {
	@successtoast.Toast("Glucose Reading Deleted")
}
