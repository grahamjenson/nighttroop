package site_data_templ

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/httputils"
)

func formatReadingDate(ms int64) string {
	return time.UnixMilli(ms).Format("2006-01-02 15:04:05")
}

// FormatGlucose and FormatDate show glucose and times the same way on other pages
var FormatGlucose, FormatDate = formatGlucose, formatReadingDate

// glucoseUnits are the units glucose is shown and typed in, from the identity's, site's or default settings
func glucoseUnits(ctx context.Context) *consts.Units {
	return sitemodels.ContextUnits(httputils.GetSiteContext(ctx))
}

// formatGlucose shows mmol/L to one decimal place, and mg/dL as a whole number
func formatGlucose(value float64, units *consts.Units) string {
	if units != nil && *units == consts.UnitsMMOLL {
		return strconv.FormatFloat(value, 'f', 1, 64)
	}
	return strconv.FormatFloat(value, 'f', 0, 64)
}

// glucoseInputAttributes keeps a typed in glucose value within what the store accepts, in the settings' units
func glucoseInputAttributes(ctx context.Context) templ.Attributes {
	return templ.Attributes{"step": "any", "min": "0.1", "max": fmt.Sprint(consts.Round(glucoseUnits(ctx).FromMGDL(1000), 1))}
}

// orDash shows an optional value, or a dash when it is not set
func orDash[T any](value *T) string {
	if value == nil {
		return "-"
	}
	return fmt.Sprint(*value)
}

// GlucoseReadingsTable shows one page of readings, newest first, with buttons to the pages either side
templ GlucoseReadingsTable(readings []*sitemodels.SiteGlucoseReading, skip int64, limit int64) {
	<div id="glucose_readings_table" class="mx-auto max-w-5xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">Glucose Readings</h1>
			<p class="mt-1 text-gray-500">
				Newest first. Click a reading to see all its details.
			</p>
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@glucoseCreateForm()
			@table.Table(table.Props{
				ID:    "glucoseReadingsTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head() {
							{ string(*glucoseUnits(ctx)) }
						}
						@table.Head() {
							Type
						}
						@table.Head() {
							Direction
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					if len(readings) == 0 {
						<tr id="site--glucose--empty"><td colspan="6" class="p-4 text-sm text-gray-500">No glucose readings here.</td></tr>
					}
					for _, reading := range readings {
						@glucoseReadingRow(reading)
					}
				}
			}
			<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
				if len(readings) > 0 {
					<span id="site--glucose--showing">{ fmt.Sprintf("Showing %d to %d", skip+1, skip+int64(len(readings))) }</span>
				} else {
					<span></span>
				}
				<div class="flex gap-2">
					if skip > 0 {
						@glucosePageButton("site--glucose--previous", "Previous", max(skip-limit, 0), limit)
					}
					if int64(len(readings)) == limit {
						@glucosePageButton("site--glucose--next", "Next", skip+limit, limit)
					}
				</div>
			</div>
		</section>
		<div id="modal-container"></div>
	</div>
}

templ glucosePageButton(id string, label string, skip int64, limit int64) {
	@button.Button(button.Props{
		ID:      id,
		Variant: button.VariantOutline,
		Attributes: templ.Attributes{
			"hx-get":      fmt.Sprintf("/data/glucose?skip=%d&limit=%d", skip, limit),
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

// glucoseCreateForm adds a reading typed in from a meter, putting its row at the top of the table
templ glucoseCreateForm() {
	<form
		id="site--glucose--create"
		class="mb-4 flex items-center justify-end gap-2"
		hx-post="/data/glucose"
		hx-target="#glucoseReadingsTable tbody"
		hx-swap="afterbegin"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		hx-on::after:request="if (ctx.response.status < 400) { this.reset(); document.getElementById('site--glucose--empty')?.remove() }"
	>
		@glucoseInputs("site--glucose--create", "", "")
		@button.Button(button.Props{ID: "site--glucose--create--submit", Type: button.TypeSubmit}) {
			Add Reading
		}
	</form>
}

templ glucoseInputs(id string, value string, notes string) {
	<div class="w-28">
		@input.Input(input.Props{
			ID:          id + "--reading",
			Type:        input.TypeNumber,
			Name:        "reading",
			Placeholder: string(*glucoseUnits(ctx)),
			Value:       value,
			Required:    true,
			Attributes:  glucoseInputAttributes(ctx),
		})
	</div>
	<div class="w-64">
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	</div>
}

// glucoseReadingRow opens the reading's details when clicked. The delete button stops its click reaching the row.
templ glucoseReadingRow(reading *sitemodels.SiteGlucoseReading) {
	{{ id := "site--glucose--" + reading.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/glucose/" + reading.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(reading.OccurredAt) }
		}
		@table.Cell() {
			{ formatGlucose(reading.Reading, reading.Units) }
		}
		@table.Cell() {
			{ reading.ReadingType }
		}
		@table.Cell() {
			{ orDash(reading.Direction) }
		}
		@table.Cell() {
			{ orDash(reading.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              "event.stopPropagation()",
						"hx-delete":            "/data/glucose/" + reading.ID,
						"hx-confirm":           "Delete this glucose reading?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": "if (ctx.response.status < 400) this.closest('tr').remove()",
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ GlucoseReadingModal(reading *sitemodels.SiteGlucoseReading) {
	@modal.Modal(modal.Props{ID: "site--glucose--details", Title: formatGlucose(reading.Reading, reading.Units) + " " + orDash(reading.Units), Subtitle: formatReadingDate(reading.OccurredAt)}) {
		<form
			id="site--glucose--edit"
			class="mt-4 flex items-center gap-2"
			hx-post={ "/data/glucose/" + reading.ID }
			hx-target={ "#site--glucose--" + reading.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@glucoseInputs("site--glucose--edit", fmt.Sprint(reading.Reading), orEmpty(reading.Notes))
			@button.Button(button.Props{ID: "site--glucose--edit--submit", Type: button.TypeSubmit}) {
				Save
			}
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("ID", reading.ID)
			@readingDetail("Type", reading.ReadingType)
			@readingDetail("Original Units", orDash(reading.OriginalUnits))
			@readingDetail("Measurement Method", orDash(reading.MeasurementMethod))
			@readingDetail("Direction", orDash(reading.Direction))
			@readingDetail("Delta", orDash(reading.Delta))
			@readingDetail("Noise", orDash(reading.Noise))
			@readingDetail("Filtered", orDash(reading.Filtered))
			@readingDetail("Unfiltered", orDash(reading.Unfiltered))
			@readingDetail("RSSI", orDash(reading.Rssi))
			@readingDetail("Notes", orDash(reading.Notes))
			@readingDetail("Reason", orDash(reading.Reason))
			@readingDetail("UTC Offset (minutes)", orDash(reading.UtcOffsetMinutes))
			@readingDetail("App", orDash(reading.CreatedByAppName))
			@readingDetail("Device", orDash(reading.CreatedByDeviceName))
			@readingDetail("Created By", reading.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(reading.CreatedAt))
			@readingDetail("Updated", formatReadingDate(reading.UpdatedAt))
			@readingDetail("Updated By", orDash(reading.UpdatedByIdentityName))
		</dl>
		if reading.RawJsonData != nil {
			<pre class="mt-4 max-h-48 overflow-auto rounded bg-gray-50 p-2 text-xs">{ *reading.RawJsonData }</pre>
		}
	}
}

var readingDetail = modal.Detail

func orEmpty(value *string) string {
	if value == nil {
		return ""
	}
	return *value
}

templ GlucoseReadingCreated(reading *sitemodels.SiteGlucoseReading) {
	@glucoseReadingRow(reading)
}

// GlucoseReadingUpdated replaces the reading's row, closes its details and shows a toast
templ GlucoseReadingUpdated(reading *sitemodels.SiteGlucoseReading) {
	@glucoseReadingRow(reading)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@glucoseToast("Glucose Reading Updated")
	</div>
}

templ GlucoseReadingDeleted() {
	@glucoseToast("Glucose Reading Deleted")
}

templ glucoseToast(description string) {
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   description,
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}
