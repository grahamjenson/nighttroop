package site_data_templ

import (
	"fmt"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// FoodIntakesTable shows one page of food intakes, newest first, with buttons to the pages either side
templ FoodIntakesTable(foodIntakes []*sitemodels.SiteFoodIntake, skip int64, limit int64) {
	<div id="food_intakes_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Food Intakes") {
			Newest first. Click a food intake to see all its details.
		}
		@searchTotals("site--food", "food intake", "food intakes")
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@addmodal.Open("site--food--add", "/data/food/new", "Add Food Intake")
			@table.Table(table.Props{
				ID:    "foodIntakesTable",
				Class: "rounded-lg border border-gray-200",
			}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Time
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Carbs (g)
						}
						@table.Head() {
							Name
						}
						@table.Head() {
							Notes
						}
						@table.Head() {
							Device
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, foodIntake := range foodIntakes {
						@foodIntakeRow(foodIntake)
					}
					@pager.Empty("site--food--empty", 6, "No food intakes here.")
				}
			}
			@pager.Pager(pager.Props{ID: "site--food", Path: "/data/food", Count: len(foodIntakes), Skip: skip, Limit: limit})
		</section>
		<div id="modal-container"></div>
	</div>
}

// FoodIntakeNew adds a food intake with all its fields, putting its row at the top of the table
templ FoodIntakeNew() {
	@addmodal.Modal(addmodal.Props{ID: "site--food--create", Title: "Add Food Intake", Path: "/data/food", Target: "#foodIntakesTable tbody",
		Submit: "Add Food Intake", Fields: foodIntakeFields})
}

// foodIntakeFields are what a food intake has that a person can type in
var foodIntakeFields = []addmodal.Field{
	{Name: "carbs", Label: "Carbs (g)", Help: "Grams of carbohydrate eaten. Negative takes back food entered by mistake.", Required: true, Min: "-1000", Max: "1000", Step: "any"},
	{Name: "occurred_at", Label: "When", Help: "When it was eaten, in your timezone. Blank is now.", Kind: addmodal.When},
	{Name: "name", Label: "Name", Help: "What it was, e.g. a sandwich.", Kind: addmodal.Text, Max: "64"},
	{Name: "absorption_time_minutes", Label: "Absorption time (minutes)", Help: "How long its carbs take to be absorbed.", Min: "0", Max: "1440", Step: "1"},
	{Name: "fat", Label: "Fat (g)", Help: "Grams of fat, which slows absorption.", Min: "-1000", Max: "1000", Step: "any"},
	{Name: "protein", Label: "Protein (g)", Help: "Grams of protein.", Min: "-1000", Max: "1000", Step: "any"},
	{Name: "fibre", Label: "Fibre (g)", Help: "Grams of fibre.", Min: "-1000", Max: "1000", Step: "any"},
	{Name: "energy", Label: "Energy", Help: "Its energy, in kcal or kJ.", Min: "0", Max: "20000", Step: "any"},
	{Name: "portions", Label: "Portions", Help: "How many portions of it were eaten.", Min: "0", Max: "1000", Step: "any"},
	{Name: "pre_bolus", Label: "Pre-bolus (minutes)", Help: "Minutes before eating that its insulin was given.", Min: "-1440", Max: "1440", Step: "1"},
	{Name: "food_type", Label: "Type", Help: "The kind of food, e.g. a meal or a snack.", Kind: addmodal.Text, Max: "32", Options: []string{"meal", "snack", "hypo treatment"}},
	{Name: "category", Label: "Category", Help: "A group it belongs to, e.g. fruit.", Kind: addmodal.Text, Max: "64"},
	{Name: "subcategory", Label: "Subcategory", Help: "A group within its category, e.g. apples.", Kind: addmodal.Text, Max: "64"},
	{Name: "reason", Label: "Reason", Help: "Why it was eaten, e.g. lunch or a low.", Kind: addmodal.Text, Max: "64"},
	{Name: "notes", Label: "Notes", Help: "Anything else to remember about it.", Kind: addmodal.Text, Max: "1024", Wide: true},
}

templ foodIntakeInputs(id string, carbs string, name string, notes string) {
	@field.Field(id+"--carbs", "Carbs (g)", "w-28") {
		@input.Input(input.Props{
			ID:          id + "--carbs",
			Type:        input.TypeNumber,
			Name:        "carbs",
			Placeholder: "Carbs (g)",
			Value:       carbs,
			Required:    true,
			Attributes:  templ.Attributes{"step": "any", "min": "-1000", "max": "1000"},
		})
	}
	@field.Field(id+"--name", "Name", "w-40") {
		@input.Input(input.Props{ID: id + "--name", Name: "name", Placeholder: "Name", Value: name})
	}
	@field.Field(id+"--notes", "Notes", "w-64") {
		@input.Input(input.Props{ID: id + "--notes", Name: "notes", Placeholder: "Notes", Value: notes})
	}
}

// foodIntakeRow opens the food intake's details when clicked. The delete button stops its click reaching the row.
templ foodIntakeRow(foodIntake *sitemodels.SiteFoodIntake) {
	{{ id := "site--food--" + foodIntake.ID }}
	@table.Row(table.RowProps{
		ID:    id,
		Class: "cursor-pointer",
		Attributes: templ.Attributes{
			"hx-get":    "/data/food/" + foodIntake.ID,
			"hx-target": "#modal-container",
			"hx-swap":   "innerHTML",
		},
	}) {
		@table.Cell() {
			{ formatReadingDate(ctx, foodIntake.OccurredAt) }
		}
		@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
			{ orDash(foodIntake.Carbs) }
		}
		@table.Cell() {
			{ orDash(foodIntake.Name) }
		}
		@table.Cell(notesCell) {
			{ orDash(foodIntake.Notes) }
		}
		@table.Cell() {
			{ orDash(foodIntake.CreatedByDeviceName) }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"onclick":              templ.JSUnsafeFuncCall("event.stopPropagation()"),
						"hx-delete":            "/data/food/" + foodIntake.ID,
						"hx-confirm":           "Delete this food intake?",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

templ FoodIntakeModal(foodIntake *sitemodels.SiteFoodIntake) {
	@modal.Modal(modal.Props{ID: "site--food--details", Title: fmt.Sprintf("%s g carbs", orDash(foodIntake.Carbs)), Subtitle: formatReadingDate(ctx, foodIntake.OccurredAt), Actions: modal.Submit("site--food--edit", "Save")}) {
		<form
			id="site--food--edit"
			class="mt-4 flex flex-wrap items-end gap-2"
			hx-post={ "/data/food/" + foodIntake.ID }
			hx-target={ "#site--food--" + foodIntake.ID }
			hx-swap="outerHTML"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@foodIntakeInputs("site--food--edit", orDash(foodIntake.Carbs), orEmpty(foodIntake.Name), orEmpty(foodIntake.Notes))
		</form>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@readingDetail("Name", orDash(foodIntake.Name))
			@readingDetail("Food Type", orDash(foodIntake.FoodType))
			@readingDetail("Category", orDash(foodIntake.Category))
			@readingDetail("Subcategory", orDash(foodIntake.Subcategory))
			@readingDetail("Fat g", orDash(foodIntake.Fat))
			@readingDetail("Protein g", orDash(foodIntake.Protein))
			@readingDetail("Fibre g", orDash(foodIntake.Fibre))
			@readingDetail("Energy", orDash(foodIntake.Energy))
			@readingDetail("Portions", orDash(foodIntake.Portions))
			@readingDetail("Absorption Time (minutes)", orDash(foodIntake.AbsorptionTimeMinutes))
			@readingDetail("Pre Bolus (minutes)", orDash(foodIntake.PreBolus))
			@readingDetail("Notes", orDash(foodIntake.Notes))
			@readingDetail("Reason", orDash(foodIntake.Reason))
			@modal.Section("Record")
			@readingDetail("ID", foodIntake.ID)
			@readingDetail("UTC Offset (minutes)", orDash(foodIntake.UtcOffsetMinutes))
			@readingDetail("App", orDash(foodIntake.CreatedByAppName))
			@readingDetail("Device", orDash(foodIntake.CreatedByDeviceName))
			@readingDetail("Created By", foodIntake.CreatedByIdentityName)
			@readingDetail("Created", formatReadingDate(ctx, foodIntake.CreatedAt))
			@readingDetail("Updated", formatReadingDate(ctx, foodIntake.UpdatedAt))
			@readingDetail("Updated By", orDash(foodIntake.UpdatedByIdentityName))
		</dl>
	}
}

templ FoodIntakeCreated(foodIntake *sitemodels.SiteFoodIntake) {
	@foodIntakeRow(foodIntake)
}

// FoodIntakeUpdated replaces the food intake's row, closes its details and shows a toast
templ FoodIntakeUpdated(foodIntake *sitemodels.SiteFoodIntake) {
	@foodIntakeRow(foodIntake)
	<div id="modal-container" hx-swap-oob="innerHTML"></div>
	<div hx-swap-oob="beforeend:#toaster">
		@successtoast.Toast("Food Intake Updated")
	</div>
}

templ FoodIntakeDeleted() {
	@successtoast.Toast("Food Intake Deleted")
}
