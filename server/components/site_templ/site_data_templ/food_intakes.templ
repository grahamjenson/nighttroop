package site_data_templ

import (
	"context"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/i18n"
)

// FoodIntakesTable shows one page of food intakes, newest first, with buttons to the pages either side
templ FoodIntakesTable(foodIntakes []*sitemodels.SiteFoodIntake, skip int64, limit int64, before *int64) {
	@listpage.Page(listpage.Props{
		ID:          "food_intakes_table",
		Title:       i18n.T(ctx, "site.data.food_intakes.title"),
		Description: i18n.T(ctx, "site.data.food_intakes.about"),
		Action:      addmodal.Open("site--food--add", "/data/food/new", i18n.T(ctx, "site.data.food_intakes.add")),
		Above:       searchTotals("site--food", "site.data.food_intakes.noun"),
		Modal:       true,
		Table: listpage.TableProps{
			EmptyHint: newSiteHint(),
			ID:      "foodIntakesTable",
			EmptyID: "site--food--empty",
			Empty:   i18n.T(ctx, "site.data.food_intakes.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.data.common.time")}, {Label: i18n.T(ctx, "site.data.food_intakes.carbs"), Numeric: true}, {Label: i18n.T(ctx, "site.data.common.name")}, {Label: i18n.T(ctx, "site.data.common.notes")},
				{Label: i18n.T(ctx, "site.data.common.device")}, {Actions: true},
			},
		},
		Pager: pager.Dated(pager.Props{ID: "site--food", Path: "/data/food", Count: len(foodIntakes), Skip: skip, Limit: limit}, before, foodIntakes, func(row *sitemodels.SiteFoodIntake) (int64, string) { return row.OccurredAt, row.ID }),
	}) {
		for _, foodIntake := range foodIntakes {
			@foodIntakeRow(foodIntake)
		}
	}
}

// FoodIntakeNew adds a food intake with all its fields, putting its row at the top of the table. Its fields start at
// the picked food preset's, if there is one.
templ FoodIntakeNew(presets []*sitemodels.SiteFoodPreset, picked *sitemodels.SiteFoodPreset) {
	{{ fields := foodIntakeFields(ctx) }}
	if picked != nil {
		{{ fields = addmodal.Fill(fields, picked, nil) }}
	}
	@addmodal.Modal(addmodal.Props{ID: "site--food--create", Title: i18n.T(ctx, "site.data.food_intakes.add"), Path: "/data/food", Target: "#foodIntakesTable tbody",
		Submit: i18n.T(ctx, "site.data.food_intakes.add"), Fields: fields, Above: foodPresetPicker(presets, picked)})
}

// foodPresetPicker loads the add modal's form again with a food preset's values once one is picked. It is left out
// when the site has no food presets.
templ foodPresetPicker(presets []*sitemodels.SiteFoodPreset, picked *sitemodels.SiteFoodPreset) {
	if len(presets) > 0 {
		<div class="pt-4">
			<label for="site--food--create--preset" class="mb-1 block text-sm font-medium text-gray-700">{ i18n.T(ctx, "site.data.food_intakes.preset") }</label>
			<select
				id="site--food--create--preset"
				name="preset"
				class="h-9 w-full rounded-md border border-gray-200 bg-white px-3 text-sm"
				hx-get="/data/food/new"
				hx-target="#site--food--create"
				hx-select="#site--food--create"
				hx-swap="outerHTML"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
			>
				<option value="">{ i18n.T(ctx, "common.add_modal.none") }</option>
				for _, preset := range presets {
					<option value={ preset.ID } selected?={ picked != nil && picked.ID == preset.ID }>{ presetOption(ctx, preset) }</option>
				}
			</select>
			<p class="mt-1 text-xs text-gray-500">{ i18n.T(ctx, "site.data.food_intakes.preset_help") }</p>
		</div>
	}
}

// presetOption is a food preset as the picker shows it, its name and, if it has them, its carbs
func presetOption(ctx context.Context, preset *sitemodels.SiteFoodPreset) string {
	if preset.Carbs == nil {
		return orDash(preset.Name)
	}
	return orDash(preset.Name) + " (" + i18n.T(ctx, "site.data.common.carbs", i18n.Data{"Carbs": orDash(preset.Carbs)}) + ")"
}

// foodIntakeFields are what a food intake has that a person can type in
func foodIntakeFields(ctx context.Context) []addmodal.Field {
	return []addmodal.Field{
		{Name: "carbs", Column: "food_intakes.Carbs", Label: i18n.T(ctx, "site.data.food_intakes.carbs"), Help: i18n.T(ctx, "site.data.food_intakes.carbs_help"), Required: true, Step: "any"},
		{Name: "occurred_at", Label: i18n.T(ctx, "site.data.common.when"), Help: i18n.T(ctx, "site.data.food_intakes.when_help"), Kind: addmodal.When},
		{Name: "name", Column: "food_intakes.Name", Label: i18n.T(ctx, "site.data.common.name"), Help: i18n.T(ctx, "site.data.food_intakes.name_help"), Kind: addmodal.Text},
		{Name: "absorption_time_minutes", Column: "food_intakes.AbsorptionTimeMinutes", Label: i18n.T(ctx, "site.data.food_intakes.absorption"), Help: i18n.T(ctx, "site.data.food_intakes.absorption_help"), Step: "1"},
		{Name: "fat", Column: "food_intakes.Fat", Label: i18n.T(ctx, "site.data.food_intakes.fat"), Help: i18n.T(ctx, "site.data.food_intakes.fat_help"), Step: "any"},
		{Name: "protein", Column: "food_intakes.Protein", Label: i18n.T(ctx, "site.data.food_intakes.protein"), Help: i18n.T(ctx, "site.data.food_intakes.protein_help"), Step: "any"},
		{Name: "fibre", Column: "food_intakes.Fibre", Label: i18n.T(ctx, "site.data.food_intakes.fibre"), Help: i18n.T(ctx, "site.data.food_intakes.fibre_help"), Step: "any"},
		{Name: "energy", Column: "food_intakes.Energy", Label: i18n.T(ctx, "site.data.food_intakes.energy"), Help: i18n.T(ctx, "site.data.food_intakes.energy_help"), Step: "any"},
		{Name: "portions", Column: "food_intakes.Portions", Label: i18n.T(ctx, "site.data.food_intakes.portions"), Help: i18n.T(ctx, "site.data.food_intakes.portions_help"), Step: "any"},
		{Name: "pre_bolus", Column: "food_intakes.PreBolus", Label: i18n.T(ctx, "site.data.food_intakes.pre_bolus"), Help: i18n.T(ctx, "site.data.food_intakes.pre_bolus_help"), Step: "1"},
		{Name: "food_type", Column: "food_intakes.FoodType", Label: i18n.T(ctx, "site.data.common.type"), Help: i18n.T(ctx, "site.data.food_intakes.type_help"), Kind: addmodal.Text, Options: []string{"meal", "snack", "hypo treatment"}},
		{Name: "category", Column: "food_intakes.Category", Label: i18n.T(ctx, "site.data.food_intakes.category"), Help: i18n.T(ctx, "site.data.food_intakes.category_help"), Kind: addmodal.Text},
		{Name: "subcategory", Column: "food_intakes.Subcategory", Label: i18n.T(ctx, "site.data.food_intakes.subcategory"), Help: i18n.T(ctx, "site.data.food_intakes.subcategory_help"), Kind: addmodal.Text},
		{Name: "reason", Column: "food_intakes.Reason", Label: i18n.T(ctx, "site.data.common.reason"), Help: i18n.T(ctx, "site.data.food_intakes.reason_help"), Kind: addmodal.Text},
		{Name: "notes", Column: "food_intakes.Notes", Label: i18n.T(ctx, "site.data.common.notes"), Help: i18n.T(ctx, "site.data.common.notes_help"), Kind: addmodal.Text, Wide: true},
	}
}

// foodIntakeRow opens the food intake's details when clicked.
templ foodIntakeRow(foodIntake *sitemodels.SiteFoodIntake) {
	@table.DataRow("site--food--"+foodIntake.ID, "/data/food/"+foodIntake.ID, i18n.T(ctx, "site.data.food_intakes.delete_confirm")) {
		@table.Cell() {
			{ formatReadingDate(ctx, foodIntake.OccurredAt) }
		}
		@table.Cell(table.NumCell) {
			{ orDash(foodIntake.Carbs) }
		}
		@table.Cell() {
			{ orDash(foodIntake.Name) }
		}
		@table.Cell(notesCell) {
			{ orDash(foodIntake.Notes) }
		}
		@table.Cell() {
			{ orDash(foodIntake.CreatedByDeviceName) }
		}
	}
}

templ FoodIntakeModal(foodIntake *sitemodels.SiteFoodIntake) {
	{{ edit := addmodal.Props{ID: "site--food--edit", Path: "/data/food/" + foodIntake.ID, Target: "#site--food--" + foodIntake.ID, Swap: "outerHTML", Submit: i18n.T(ctx, "site.data.common.save"),
		Fields: addmodal.Edit(foodIntakeFields(ctx), foodIntake, nil)} }}
	@modal.Modal(modal.Props{ID: "site--food--details", Title: i18n.T(ctx, "site.data.common.carbs", i18n.Data{"Carbs": orDash(foodIntake.Carbs)}), Subtitle: formatReadingDate(ctx, foodIntake.OccurredAt), Actions: addmodal.SubmitButton(edit)}) {
		@addmodal.Form(edit)
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
			@RecordDetails(Record{ID: foodIntake.ID, UtcOffset: foodIntake.UtcOffsetMinutes, App: foodIntake.CreatedByAppName, Device: foodIntake.CreatedByDeviceName, CreatedBy: foodIntake.CreatedByIdentityName, Created: foodIntake.CreatedAt, Updated: foodIntake.UpdatedAt, UpdatedBy: foodIntake.UpdatedByIdentityName})
		</dl>
	}
}

templ FoodIntakeCreated(foodIntake *sitemodels.SiteFoodIntake) {
	@foodIntakeRow(foodIntake)
}

// FoodIntakeUpdated replaces the food intake's row, closes its details and shows a toast
templ FoodIntakeUpdated(foodIntake *sitemodels.SiteFoodIntake) {
	@foodIntakeRow(foodIntake)
	@modal.CloseOOB()
	@successtoast.OOB(i18n.T(ctx, "site.data.food_intakes.updated"))
}

templ FoodIntakeDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.data.food_intakes.deleted"))
}
