package site_templ

import (
	"context"

	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/dropdown"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/label"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/httputils"
)

templ Base() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>NightTroop </title>
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/logo.png"/>
			<!-- Tailwind CSS -->
			<link href="/style_gen.css" rel="stylesheet"/>
			<script src="/htmx.js"></script>
			<script src="/htmx_sse.js"></script>
			@copybutton.Script()
			@input.Script()
			@label.Script()
			@dropdown.Script()
			@inputotp.Script()
			@checkbox.Script()
			@selectbox.Script()
			@toast.Script()
			<script src="/qrcode.js"></script>
			<script src="/echarts.min.js"></script>
		</head>
		<body hx-ext="response-targets">
			<div id="toaster" class="mb-3"></div>
			{ children... }
		</body>
	</html>
}

templ SiteBase() {
	@Base() {
		<div class="flex min-h-screen flex-col">
			// The header and alarms stay at the top of the window. Scrolling down slides the header up out of the way,
			// leaving the alarms, and scrolling up brings it back.
			<div id="site--top" class="group sticky top-0 z-40 transition-transform duration-300 data-[hidden]:-translate-y-14 motion-reduce:transition-none">
				@Header()
				if identityName(ctx) != "" {
					@Alarms()
				}
			</div>
			@topBarScript()
			<main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
				{ children... }
			</main>
		</div>
	}
}

// identityName is who is signed in, or "" before login
func identityName(ctx context.Context) string {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil && siteContext.IdentityModel != nil {
		return siteContext.IdentityModel.Name
	}
	return ""
}

templ dataMenuItem(id string, path string, label string, itemIcon templ.Component) {
	@dropdown.Item(dropdown.ItemProps{
		ID:   id,
		Href: "#",
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		<span class="flex items-center">
			@itemIcon
			{ label }
		</span>
	}
}

// topBarScript hides the header once the page scrolls down past the top bar, unless its menu is open or it has
// focus, and shows it again on any scroll up or when something in it gets focus. A new page, swapped in or restored by
// the back button, shows it too, and the scroll to its place in the page over the next half second does not hide it.
// Moves under 5px, as a touch scroll settles, change nothing.
templ topBarScript() {
	<script>
		(function () {
			if (window.siteTopBar) return;
			window.siteTopBar = true;
			const bar = () => document.getElementById("site--top");
			let last = window.scrollY, settleUntil = 0;
			window.addEventListener("scroll", () => {
				const y = window.scrollY, top = bar();
				if (!top || (Math.abs(y - last) < 5 && Date.now() >= settleUntil)) return;
				const busy = top.contains(document.activeElement) || top.querySelector('[data-tui-popover-open="true"]');
				if (Date.now() >= settleUntil && y > last && y > top.offsetHeight && !busy) top.setAttribute("data-hidden", "");
				if (y < last) top.removeAttribute("data-hidden");
				last = y;
			}, { passive: true });
			document.addEventListener("focusin", (e) => { if (bar()?.contains(e.target)) bar().removeAttribute("data-hidden"); });
			document.addEventListener("htmx:after:swap", (e) => {
				const target = e.detail?.ctx?.target;
				if (target === document.body || target?.id === "main-content") {
					bar()?.removeAttribute("data-hidden");
					settleUntil = Date.now() + 500;
				}
			});
		})();
	</script>
}

templ Header() {
	<header class="border-b border-white/10 bg-brand-night text-white transition-[visibility] duration-300 group-data-[hidden]:invisible motion-reduce:transition-none">
		<div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
			<a id="site--nav--home" href="/" class="flex items-center gap-2 font-semibold tracking-wide">
				<img id="site--nav--logo" src="/logo.svg" alt="" class="size-8"/>
				Nighttroop
				<span class="rounded-full bg-brand-gold px-2 py-0.5 text-xs font-semibold text-brand-night">Alpha</span>
			</a>
			@dropdown.Dropdown(dropdown.Props{
				ID: "site--settings-menu",
			}) {
				@dropdown.Trigger() {
					<button class="flex items-center gap-2 rounded-full py-1 pl-1 pr-2 text-sm transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold">
						<span class="flex size-7 items-center justify-center rounded-full bg-gray-700">
							@icon.User(icon.Props{Class: "size-4"})
						</span>
						<span class="hidden sm:inline">{ identityName(ctx) }</span>
						@icon.ChevronDown(icon.Props{Class: "size-4 text-gray-400"})
						<span class="sr-only">Open user menu</span>
					</button>
				}
				@dropdown.Content(dropdown.ContentProps{
					Class: "w-56 sm:w-[30rem] sm:max-w-[calc(100vw-2rem)] max-h-[calc(100vh-5rem)]",
				}) {
					if name := identityName(ctx); name != "" {
						<div class="px-2 py-1.5 text-sm text-gray-500">
							Signed in as <span class="font-semibold text-gray-900">{ name }</span>
						</div>
						@dropdown.Separator()
					}
					// Data on the left, and presets, settings and logout on the right, so every item fits in the window
					<div class="sm:grid sm:grid-cols-2 sm:gap-x-1">
						<div>
							@dropdown.Label() {
								Data
							}
							@dropdown.Group() {
								@dataMenuItem("site--data--glucose-button", "/data/glucose", "Glucose Readings", icon.Droplet(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--insulin-button", "/data/insulin", "Insulin Doses", icon.Syringe(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--food-button", "/data/food", "Food Intakes", icon.Utensils(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--temp-targets-button", "/data/temp-targets", "Temp Targets", icon.Target(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--temp-basals-button", "/data/temp-basals", "Temp Basals", icon.Gauge(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--activities-button", "/data/activities", "Activities", icon.Activity(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--component-events-button", "/data/component-events", "Site & Sensor Changes", icon.Wrench(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--notifications-button", "/data/notifications", "Notifications", icon.Bell(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--profile-switches-button", "/data/profile-switches", "Profile Switches", icon.Repeat(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--event-groups-button", "/data/event-groups", "Event Groups", icon.Layers(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--data--device-status-button", "/data/device-status", "Device Status", icon.Smartphone(icon.Props{Class: "size-4 mr-2"}))
							}
						</div>
						<div>
							@dropdown.Separator(dropdown.SeparatorProps{Class: "sm:hidden"})
							@dropdown.Label() {
								Presets
							}
							@dropdown.Group() {
								@dataMenuItem("site--presets--food-button", "/presets/food", "Food Presets", icon.Utensils(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--presets--profiles-button", "/presets/profiles", "Profiles", icon.CalendarClock(icon.Props{Class: "size-4 mr-2"}))
							}
							@dropdown.Separator()
							@dropdown.Label() {
								Settings
							}
							@dropdown.Group() {
								@dataMenuItem("site--settings--settings-button", "/settings", "Settings", icon.SlidersHorizontal(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--settings--alarms-button", "/settings/alarms", "Alarms", icon.BellRing(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--settings--identities-button", "/settings/identities", "Users & Devices", icon.Users(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--settings--sync-button", "/settings/sync", "Sync Settings", icon.FolderSync(icon.Props{Class: "size-4 mr-2"}))
							}
							@dropdown.Separator()
							@dropdown.Label() {
								Logs
							}
							@dropdown.Group() {
								@dataMenuItem("site--logs--events-button", "/logs/events", "Events", icon.Activity(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--logs--errors-button", "/logs/errors", "Errors", icon.TriangleAlert(icon.Props{Class: "size-4 mr-2"}))
								@dataMenuItem("site--logs--logs-button", "/logs/logs", "Logs", icon.ScrollText(icon.Props{Class: "size-4 mr-2"}))
							}
							@dropdown.Separator()
							@dropdown.Item(dropdown.ItemProps{
								ID:   "site--settings--logout-button",
								Href: "#",
								Attributes: templ.Attributes{
									"hx-post":   "/logout",
									"hx-target": "body",
									"hx-swap":   "outerHTML",
								},
							}) {
								<span class="flex items-center">
									@icon.LogOut(icon.Props{Class: "size-4 mr-2"})
									Logout
								</span>
							}
						</div>
					</div>
				}
			}
		</div>
	</header>
}

templ SiteError(message string) {
	@toast.Toast(toast.Props{
		Description: message,
		Variant:     toast.VariantError,
		Position:    toast.PositionTopCenter,
		Dismissible: true,
		Icon:        true,
	})
}

// NotFound is the page for an address the site has nothing at, or for something a collection cannot do
templ NotFound(message string) {
	<div id="site--not-found" class="mx-auto max-w-xl space-y-4 py-16 text-center">
		<h1 class="text-2xl font-semibold text-brand-night">Not found</h1>
		<p id="site--not-found--message" class="text-gray-600">{ message }</p>
		<a id="site--not-found--home" href="/" class="text-primary underline">Back to the summary</a>
	</div>
}

templ FullPage(content templ.Component) {
	@SiteBase() {
		@content
	}
}
