package site_templ

import (
	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/dropdown"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/label"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
)

templ SiteBase() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Nighttroop </title>
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/logo.png"/>
			<!-- Tailwind CSS -->
			<link href="/style_gen.css" rel="stylesheet"/>
			<script src="/d3.js"></script>
			<script src="/htmx.js"></script>
			@copybutton.Script()
			@input.Script()
			@label.Script()
			@dropdown.Script()
			@inputotp.Script()
			@checkbox.Script()
			@selectbox.Script()
			<script src="/qrcode.js"></script>
		</head>
		<body>
			@Header()
			<div
				id="main-content"
				class="container center-container d-flex align-items-center justify-content-center py-4 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
			>
				{ children... }
			</div>
			@Footer()
		</body>
	</html>
}

templ Header() {
	<nav class="bg-gray-900/80 backdrop-blur-md border-b border-white/10 shadow-sm">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex h-16 items-center justify-between">
				<!-- Brand -->
				<a href="/" class="text-white font-bold tracking-wide uppercase">
					NightTroop<span class="ml-2 inline-flex items-center rounded-full bg-amber-200 px-2.5 py-0.5 text-xs font-semibold text-rose-800 align-middle">Alpha</span>
				</a>
				<!-- Right side -->
				<div class="flex items-center gap-4">
					@dropdown.Dropdown() {
						@dropdown.Trigger() {
							<button class="flex items-center justify-center size-9 rounded-full bg-gray-800 hover:bg-gray-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
								<span class="sr-only">Open user menu</span>
								@icon.User(icon.Props{Class: "size-6 text-white"})
							</button>
						}
						@dropdown.Content(dropdown.ContentProps{
							Class: "w-56",
						}) {
							@dropdown.Label() {
								Security
							}
							@dropdown.Group() {
								@dropdown.Item(dropdown.ItemProps{
									Href: "#",
								}) {
									<span class="flex items-center">
										@icon.UserCog(icon.Props{Class: "size-4 mr-2"})
										Account
									</span>
								}
								@dropdown.Item(dropdown.ItemProps{
									Href: "#",
									Attributes: templ.Attributes{
										"hx-get":      "/identities",
										"hx-target":   "#main-content",
										"hx-push-url": "true",
										"hx-swap":     "innerHTML",
									},
								}) {
									<span class="flex items-center">
										@icon.UserPlus(icon.Props{Class: "size-4 mr-2"})
										User/Device Identities
									</span>
								}
							}
							@dropdown.Separator()
							@dropdown.Label() {
								Settings
							}
							@dropdown.Group() {
								@dropdown.Item(dropdown.ItemProps{
									Href: "#",
									Attributes: templ.Attributes{
										"hx-get":      "/sync_settings",
										"hx-target":   "#main-content",
										"hx-push-url": "true",
										"hx-swap":     "innerHTML",
									},
								}) {
									<span class="flex items-center">
										@icon.FolderSync(icon.Props{Class: "size-4 mr-2"})
										Sync Settings
									</span>
								}
								@dropdown.Separator()
								@dropdown.Item(dropdown.ItemProps{
									Href: "#",
									Attributes: templ.Attributes{
										"hx-post":   "/logout",
										"hx-target": "body",

										"hx-swap": "outerHTML",
									},
								}) {
									<span class="flex items-center">
										@icon.LogOut(icon.Props{Class: "size-4 mr-2"})
										Logout
									</span>
								}
							}
						}
					}
				</div>
			</div>
		</div>
	</nav>
}

templ Footer() {
	<div class="mt-16 bottom-0"></div>
	<footer class="fixed bottom-0 left-0 right-0 border-t border-white/10 bg-gray-900/80 backdrop-blur-md">
		<div class="flex w-full flex-col gap-3 py-4 flex-row items-center justify-between">
			<!-- Middle links -->
			<div class="flex  items-center justify-center gap-6 text-sm w-full">
				<a href="#" class="text-gray-400 hover:text-white transition">Privacy </a>
				<a href="#" class="text-gray-400 hover:text-white transition">Terms </a>
				<a href="#" class="text-gray-400 hover:text-white transition">Support </a>
				<a href="#" class="text-gray-400 hover:text-white transition">Contact </a>
			</div>
		</div>
	</footer>
}
