package site_templ

import (
	"context"

	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/dropdown"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/inputotp"
	"nighttroop.t1d.nz/server/components/ui/label"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/httputils"
)

templ Base() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>NightTroop </title>
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" href="/logo.png"/>
			<!-- Tailwind CSS -->
			<link href="/style_gen.css" rel="stylesheet"/>
			<script src="/htmx.js"></script>
			@copybutton.Script()
			@input.Script()
			@label.Script()
			@dropdown.Script()
			@inputotp.Script()
			@checkbox.Script()
			@selectbox.Script()
			@toast.Script()
			<script src="/qrcode.js"></script>
		</head>
		<body hx-ext="response-targets">
			<div id="toaster" class="mb-3"></div>
			{ children... }
		</body>
	</html>
}

templ SiteBase() {
	@Base() {
		<div class="flex min-h-screen flex-col">
			@Header()
			<main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 lg:px-8">
				{ children... }
			</main>
		</div>
	}
}

// identityName is who is signed in, or "" before login
func identityName(ctx context.Context) string {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil && siteContext.IdentityModel != nil {
		return siteContext.IdentityModel.Name
	}
	return ""
}

templ settingsMenuItem(id string, path string, label string) {
	@dropdown.Item(dropdown.ItemProps{
		ID:   id,
		Href: "#",
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		<span class="flex items-center">
			@icon.SlidersHorizontal(icon.Props{Class: "size-4 mr-2"})
			{ label }
		</span>
	}
}

templ dataMenuItem(id string, path string, label string, itemIcon templ.Component) {
	@dropdown.Item(dropdown.ItemProps{
		ID:   id,
		Href: "#",
		Attributes: templ.Attributes{
			"hx-get":      path,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		<span class="flex items-center">
			@itemIcon
			{ label }
		</span>
	}
}

templ Header() {
	<header class="sticky top-0 z-40 border-b border-white/10 bg-brand-night text-white">
		<div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
			<a id="site--nav--home" href="/" class="flex items-center gap-2 font-semibold tracking-wide">
				<img id="site--nav--logo" src="/logo.svg" alt="" class="size-8"/>
				Nighttroop
				<span class="rounded-full bg-brand-gold px-2 py-0.5 text-xs font-semibold text-brand-night">Alpha</span>
			</a>
			@dropdown.Dropdown(dropdown.Props{
				ID: "site--settings-menu",
			}) {
				@dropdown.Trigger() {
					<button class="flex items-center gap-2 rounded-full py-1 pl-1 pr-2 text-sm transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold">
						<span class="flex size-7 items-center justify-center rounded-full bg-gray-700">
							@icon.User(icon.Props{Class: "size-4"})
						</span>
						<span class="hidden sm:inline">{ identityName(ctx) }</span>
						@icon.ChevronDown(icon.Props{Class: "size-4 text-gray-400"})
						<span class="sr-only">Open user menu</span>
					</button>
				}
				@dropdown.Content(dropdown.ContentProps{
					Class: "w-56 max-h-[calc(100vh-5rem)]",
				}) {
					if name := identityName(ctx); name != "" {
						<div class="px-2 py-1.5 text-sm text-gray-500">
							Signed in as <span class="font-semibold text-gray-900">{ name }</span>
						</div>
						@dropdown.Separator()
					}
					@dropdown.Label() {
						Data
					}
					@dropdown.Group() {
						@dataMenuItem("site--data--glucose-button", "/data/glucose", "Glucose Readings", icon.Droplet(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--insulin-button", "/data/insulin", "Insulin Doses", icon.Syringe(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--food-button", "/data/food", "Food Intakes", icon.Utensils(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--temp-targets-button", "/data/temp-targets", "Temp Targets", icon.Target(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--temp-basals-button", "/data/temp-basals", "Temp Basals", icon.Gauge(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--activities-button", "/data/activities", "Activities", icon.Activity(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--component-events-button", "/data/component-events", "Site & Sensor Changes", icon.Wrench(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--profile-switches-button", "/data/profile-switches", "Profile Switches", icon.Repeat(icon.Props{Class: "size-4 mr-2"}))
						@dataMenuItem("site--data--device-status-button", "/data/device-status", "Device Status", icon.Smartphone(icon.Props{Class: "size-4 mr-2"}))
					}
					@dropdown.Separator()
					@dropdown.Label() {
						Settings
					}
					@dropdown.Group() {
						@settingsMenuItem("site--settings--settings-button", "/settings", "Settings")
						@dropdown.Item(dropdown.ItemProps{
							ID:   "site--settings--identities-button",
							Href: "#",
							Attributes: templ.Attributes{
								"hx-get":      "/settings/identities",
								"hx-target":   "#main-content",
								"hx-push-url": "true",
								"hx-swap":     "innerHTML",
							},
						}) {
							<span class="flex items-center">
								@icon.Users(icon.Props{Class: "size-4 mr-2"})
								Users & Devices
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{
							ID:   "site--settings--sync-button",
							Href: "#",
							Attributes: templ.Attributes{
								"hx-get":      "/settings/sync",
								"hx-target":   "#main-content",
								"hx-push-url": "true",
								"hx-swap":     "innerHTML",
							},
						}) {
							<span class="flex items-center">
								@icon.FolderSync(icon.Props{Class: "size-4 mr-2"})
								Sync Settings
							</span>
						}
					}
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{
						ID:   "site--settings--logout-button",
						Href: "#",
						Attributes: templ.Attributes{
							"hx-post":   "/logout",
							"hx-target": "body",
							"hx-swap":   "outerHTML",
						},
					}) {
						<span class="flex items-center">
							@icon.LogOut(icon.Props{Class: "size-4 mr-2"})
							Logout
						</span>
					}
				}
			}
		</div>
	</header>
}

templ SiteError(message string) {
	@toast.Toast(toast.Props{
		Description: message,
		Variant:     toast.VariantError,
		Position:    toast.PositionTopCenter,
		Dismissible: true,
		Icon:        true,
	})
}

templ FullPage(content templ.Component) {
	@SiteBase() {
		@content
	}
}
