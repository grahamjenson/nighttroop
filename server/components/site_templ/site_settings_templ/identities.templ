// roleLabels are the messages of the role names, in the create forms too
var roleLabels = map[consts.IdentityRole]string{
	consts.IdentityRoleAdmin: "site.settings.identities.roles.admin", consts.IdentityRoleUser: "site.settings.identities.roles.user", consts.IdentityRoleUserReadOnly: "site.settings.identities.roles.user_read_only",
	consts.IdentityRoleClinician: "site.settings.identities.roles.clinician", consts.IdentityRoleDeviceRead: "site.settings.identities.roles.device_read",
	consts.IdentityRoleDeviceReadWrite: "site.settings.identities.roles.device_read_write", consts.IdentityRoleDevicePWDPhone: "site.settings.identities.roles.device_pwd_phone",
}

// deviceClient is a Nightscout client a device can be added for, with how to set it up. In a step, *Name* is a menu
// or field in the client, shown in bold, and {url}, {token}, {xdrip} and {nightguard} are values to enter, shown with
// a button to copy them: the site's Nightscout URL, the device's Nightscout token, and the URL with the token in it
// that xDrip+ and Nightguard take. Its Steps are message ids, and its Label its name, which Other's is not.
type deviceClient struct {
	Value, Label string
	Steps        []string
	// MGDL is whether it needs glucose in mg/dL, so the device's own units are set to mg/dL
	MGDL bool
}

// deviceClients are the clients a device can be added for, Other first as the one chosen to start with
var deviceClients = []deviceClient{
	{"other", "", []string{"site.settings.identities.clients.other_client.step_1", "site.settings.identities.clients.other_client.step_2"}, false},
	{"aaps", "AAPS", []string{"site.settings.identities.clients.aaps.step_1", "site.settings.identities.clients.aaps.step_2", "site.settings.identities.clients.aaps.step_3"}, true},
	{"trio", "Trio", []string{"site.settings.identities.clients.trio.step_1", "site.settings.identities.clients.trio.step_2", "site.settings.identities.clients.trio.step_3", "site.settings.identities.clients.trio.step_4"}, true},
	{"loop", "Loop", []string{"site.settings.identities.clients.loop.step_1", "site.settings.identities.clients.loop.step_2", "site.settings.identities.clients.loop.step_3"}, true},
	{"xdrip", "xDrip+", []string{"site.settings.identities.clients.xdrip.step_1", "site.settings.identities.clients.xdrip.step_2"}, true},
	{"xdrip4ios", "xDrip4iOS", []string{"site.settings.identities.clients.xdrip4ios.step_1", "site.settings.identities.clients.xdrip4ios.step_2", "site.settings.identities.clients.xdrip4ios.step_3"}, true},
	{"nightguard", "Nightguard", []string{"site.settings.identities.clients.nightguard.step_1"}, true},
	{"sugarpixel", "SugarPixel", []string{"site.settings.identities.clients.sugarpixel.step_1", "site.settings.identities.clients.sugarpixel.step_2", "site.settings.identities.clients.sugarpixel.step_3"}, true},
	{"t1dcarer", "T1D Carer", []string{"site.settings.identities.clients.t1dcarer.step_1", "site.settings.identities.clients.t1dcarer.step_2", "site.settings.identities.clients.t1dcarer.step_3"}, true},
}

// clientLabel is what the client is called: its name, or Other
func clientLabel(ctx context.Context, client deviceClient) string {
	if client.Value == "other" {
		return i18n.T(ctx, "site.settings.identities.clients.other_client.label")
	}
	return client.Label
}

// valueNames are the messages naming the values in the steps, for their copy buttons
var valueNames = map[string]string{"url": "site.settings.identities.values.url", "token": "site.settings.identities.values.token", "xdrip": "site.settings.identities.values.xdrip",
	"nightguard": "site.settings.identities.values.nightguard"}

// stepPart is a piece of a step: text, in bold when it names a menu or field, or a value to copy, with its name
type stepPart struct {
	Text  string
	Bold  bool
	Value bool
	Name  string
}

// stepParts splits a step into its text, bold names and values, filling the values in
func stepParts(ctx context.Context, step string, values map[string]string) []stepPart {
	parts := []stepPart{}
	bold := false
	for step != "" {
		at := strings.IndexAny(step, "*{")
		if at < 0 {
			parts = append(parts, stepPart{Text: step, Bold: bold})
			break
		}
		if at > 0 {
			parts = append(parts, stepPart{Text: step[:at], Bold: bold})
		}
		if step[at] == '*' {
			bold, step = !bold, step[at+1:]
			continue
		}
		name, rest, _ := strings.Cut(step[at+1:], "}")
		parts = append(parts, stepPart{Text: values[name], Value: true, Name: i18n.T(ctx, valueNames[name])})
		step = rest
	}
	return parts
}

// clientSteps are how to set up the device's client, with its URL and token filled in, or none for a device added
// without one
func clientSteps(ctx context.Context, identity *sitemodels.UserIdentity) (deviceClient, [][]stepPart) {
	index := slices.IndexFunc(deviceClients, func(c deviceClient) bool { return c.Value == identity.Client })
	if index < 0 || identity.NSToken == nil {
		return deviceClient{}, nil
	}
	url, token := identity.NSURL, *identity.NSToken
	host := url
	if _, after, ok := strings.Cut(host, "://"); ok {
		host = after
	}
	values := map[string]string{"url": url, "token": token, "xdrip": "https://" + token + "@" + host + "/api/v1/", "nightguard": url + "/?token=" + token}
	steps := [][]stepPart{}
	for _, step := range deviceClients[index].Steps {
		steps = append(steps, stepParts(ctx, i18n.T(ctx, step), values))
	}
	return deviceClients[index], steps
}

// forceClientRole is the client select's change handler: a client that must have a role sets the role select to it
// and stops it being changed, as the server refuses any other
func forceClientRole(formID string) string {
	roles, _ := json.Marshal(sitemodels.ClientRoles)
	return `const role = ` + string(roles) + `[event.target.value], trigger = document.getElementById("select-form-` + formID + `");
		if (role) { trigger.querySelector("input[type=hidden]").value = role }
		trigger.disabled = !!role`
}

// RoleLabel is how a site identity's role is named, in the context's language, or the role as it is when it has no name
func RoleLabel(ctx context.Context, role string) string {
	if label, ok := roleLabels[consts.IdentityRole(role)]; ok {
		return i18n.T(ctx, label)
	}
	return role
}

func formatIdentityDate(ctx context.Context, ms *int64) string {
	if ms == nil || *ms == 0 {
		return i18n.T(ctx, "site.settings.never")
	}
	return site_data_templ.FormatDate(ctx, *ms)
}

templ IdentitesTable(users []*sitemodels.UserIdentity, devices []*sitemodels.UserIdentity) {
	<div id="identities_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "site.settings.identities.title")) {
			{ i18n.T(ctx, "site.settings.identities.about") }
		}
		<div class="grid gap-4 md:grid-cols-3">
			@roleCard(i18n.T(ctx, "site.settings.identities.admin_card.title"), i18n.T(ctx, "site.settings.identities.admin_card.about"))
			@roleCard(i18n.T(ctx, "site.settings.identities.user_card.title"), i18n.T(ctx, "site.settings.identities.user_card.about"))
			@roleCard(i18n.T(ctx, "site.settings.identities.device_card.title"), i18n.T(ctx, "site.settings.identities.device_card.about"))
		</div>
		@card.Card(card.Props{Title: i18n.T(ctx, "site.settings.identities.users")}) {
			@buildIdentityTable("usersTable", users)
			// The first role is picked to start with, so a user added without choosing one is a User, not an Admin
			@formCreateIdentity("usersTable", false, roleOptions(ctx, consts.IdentityRoleUser, consts.IdentityRoleUserReadOnly, consts.IdentityRoleClinician, consts.IdentityRoleAdmin))
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "site.settings.identities.devices")}) {
			@buildIdentityTable("devicesTable", devices)
			@formCreateIdentity("devicesTable", true, roleOptions(ctx, consts.IdentityRoleDeviceRead, consts.IdentityRoleDeviceReadWrite, consts.IdentityRoleDevicePWDPhone))
		}
		<div id="modal-container"></div>
	</div>
}

// roleCard explains a role, in neutral colours, as no role is a warning or an error
templ roleCard(title string, description string) {
	<div class="rounded-xl border border-gray-200 p-4">
		<h2 class="font-semibold text-brand-night">{ title }</h2>
		<p class="mt-1 text-sm text-gray-700">{ description }</p>
	</div>
}

templ buildIdentityTable(id string, identities []*sitemodels.UserIdentity) {
	@table.Table(table.Props{
		ID:    id,
		Class: "rounded-lg border border-gray-200",
	}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					{ i18n.T(ctx, "site.settings.identities.heads.name") }
				}
				@table.Head() {
					{ i18n.T(ctx, "site.settings.identities.heads.role") }
				}
				@table.Head() {
					{ i18n.T(ctx, "site.settings.identities.heads.created") }
				}
				@table.Head() {
					{ i18n.T(ctx, "site.settings.identities.heads.last_seen") }
				}
				@table.Head() {
					{ i18n.T(ctx, "site.settings.identities.heads.last_write") }
				}
				@table.Head() {
					{ i18n.T(ctx, "site.settings.identities.heads.recent_clients") }
				}
				@table.Head() {
					<span class="sr-only">{ i18n.T(ctx, "site.settings.identities.heads.actions") }</span>
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@IdentityRow(identity)
			}
		}
	}
}

templ IdentityRow(identity *sitemodels.UserIdentity) {
	@table.Row() {
		@table.Cell() {
			{ identity.Name }
			if identity.CurrentIdentity {
				@badge.Badge(badge.Props{Class: "ml-2"}) {
					{ i18n.T(ctx, "site.settings.identities.you") }
				}
			}
		}
		@table.Cell() {
			{ RoleLabel(ctx, identity.Role) }
		}
		@table.Cell() {
			{ formatIdentityDate(ctx, &identity.CreatedAt) }
		}
		@table.Cell() {
			<span title={ formatIdentityDate(ctx, identity.LastSeenAt) }>{ display.Ago(ctx, identity.LastSeenAt, time.Now()) }</span>
		}
		@table.Cell() {
			<span title={ formatIdentityDate(ctx, identity.LastWriteAt) }>{ display.Ago(ctx, identity.LastWriteAt, time.Now()) }</span>
		}
		@table.Cell() {
			@recentClients(identity)
		}
		@table.Cell() {
			@identityActions(identity)
		}
	}
}

// recentClients lists the apps and networks the identity recently authenticated from. A device used by more than one
// app is probably shared, and so are its settings and alarms, so it is marked.
templ recentClients(identity *sitemodels.UserIdentity) {
	{{ id := "site--identities--" + identity.Name + "--clients" }}
	{{ shared := consts.IdentityRole(identity.Role).GetType() == consts.IdentityTypeDevice && authclients.Shared(identity.RecentClients, time.Now()) }}
	if len(identity.RecentClients) == 0 {
		<span id={ id } class="text-sm text-gray-400">{ i18n.T(ctx, "site.settings.identities.clients_none") }</span>
	} else {
		<details id={ id } class="max-w-xs text-sm">
			<summary class={ "cursor-pointer", templ.KV("font-medium text-amber-800", shared) }>
				if shared {
					{ i18n.T(ctx, "site.settings.identities.clients_shared") }
				} else {
					{ i18n.T(ctx, "site.settings.identities.clients_recent", i18n.Data{"Count": len(identity.RecentClients)}) }
				}
			</summary>
			if shared {
				<p class="mt-1 text-xs text-amber-800">{ i18n.T(ctx, "site.settings.identities.clients_shared_help") }</p>
			}
			<ul class="mt-1 space-y-1 text-xs text-gray-600">
				for _, client := range identity.RecentClients {
					<li><span class="break-all">{ client.UserAgent }</span> · { client.Network } · { display.Ago(ctx, &client.LastAt, time.Now()) }</li>
				}
			</ul>
		</details>
	}
}

// identityActions turns an identity on or off, and has a Manage menu, each of its items labelled, to change its
// settings, reset its password or TOTP, or delete it. Your own identity cannot be
// changed here; its password and TOTP are reset from the settings page.
// The toggle's hx-vals keeps its form from being empty when unchecked, and a failed update flips it back.
templ identityActions(identity *sitemodels.UserIdentity) {
	{{ id := "site--identities--" + identity.Name }}
	<div class="flex items-center justify-end gap-2">
		<label id={ id + "--enabled" } title={ i18n.T(ctx, "site.settings.identities.enabled") } class={ "relative inline-flex items-center", templ.KV("cursor-pointer", !identity.CurrentIdentity), templ.KV("opacity-50", identity.CurrentIdentity) }>
			<input
				type="checkbox"
				name="enabled"
				class="peer sr-only"
				checked?={ identity.Enabled }
				disabled?={ identity.CurrentIdentity }
				hx-post={ "/settings/identities/" + strconv.FormatInt(identity.ID, 10) }
				hx-trigger="change"
				hx-vals={ `{"id": ` + strconv.FormatInt(identity.ID, 10) + `}` }
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
				hx-on::after:request="if (ctx.response.status >= 400) this.checked = !this.checked"
			/>
			<span class="h-5 w-9 rounded-full bg-gray-300 transition-colors peer-checked:bg-gray-900 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-4"></span>
		</label>
		@dropdown.Dropdown(dropdown.Props{ID: id + "--menu"}) {
			@dropdown.Trigger() {
				@button.Button(button.Props{ID: id + "--manage", Variant: button.VariantOutline, Size: button.SizeSm}) {
					{ i18n.T(ctx, "site.settings.identities.manage") }
					@icon.ChevronDown(icon.Props{Class: "size-4"})
				}
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-48"}) {
				@dropdown.Item(dropdown.ItemProps{ID: id + "--settings", Attributes: nav.Attributes("/settings/identity-settings/" + strconv.FormatInt(identity.ID, 10))}) {
					@menuLabel(icon.UserCog, i18n.T(ctx, "site.settings.identities.settings"))
				}
				@dropdown.Item(dropdown.ItemProps{ID: id + "--reset-password", Disabled: identity.CurrentIdentity,
					Attributes: resetAttributes(identity.ID, "password", i18n.T(ctx, "site.settings.identities.reset_password_confirm", i18n.Data{"Name": identity.Name}))}) {
					@menuLabel(icon.KeyRound, i18n.T(ctx, "site.settings.identities.reset_password"))
				}
				if identity.HasTotpSecret {
					@dropdown.Item(dropdown.ItemProps{ID: id + "--reset-totp", Disabled: identity.CurrentIdentity,
						Attributes: resetAttributes(identity.ID, "totp", i18n.T(ctx, "site.settings.identities.reset_totp_confirm", i18n.Data{"Name": identity.Name}))}) {
						@menuLabel(icon.RotateCcwKey, i18n.T(ctx, "site.settings.identities.reset_totp"))
					}
				}
				@dropdown.Separator()
				@dropdown.Item(dropdown.ItemProps{ID: id + "--delete", Disabled: identity.CurrentIdentity, Class: "text-red-600 hover:text-red-700",
					Attributes: templ.Attributes{
						"hx-delete":            "/settings/identities/" + strconv.FormatInt(identity.ID, 10),
						"hx-confirm":           i18n.T(ctx, "site.settings.identities.delete_confirm", i18n.Data{"Name": identity.Name}),
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					}}) {
					@menuLabel(icon.Trash2, i18n.T(ctx, "site.settings.identities.delete"))
				}
			}
		}
	</div>
}

// menuLabel is a menu item's icon and words
templ menuLabel(ic func(...icon.Props) templ.Component, label string) {
	<span class="flex items-center gap-2">
		@ic(icon.Props{Class: "size-4"})
		{ label }
	</span>
}

// resetAttributes reset an identity's password or totp after confirming, showing the new one in the page's modal
func resetAttributes(identityID int64, credential string, confirm string) templ.Attributes {
	return templ.Attributes{
		"hx-post":       "/settings/identities/" + strconv.FormatInt(identityID, 10) + "/" + credential,
		"hx-confirm":    confirm,
		"hx-target":     "#modal-container",
		"hx-swap":       "innerHTML",
		"hx-status:4xx": "target:#toaster swap:beforeend",
		"hx-status:5xx": "target:#toaster swap:beforeend",
	}
}

// resetButton resets an identity's password or totp after confirming, showing the new one in the page's modal
templ resetButton(props button.Props, identityID int64, credential string, title string, confirm string) {
	{{
		props.Attributes = resetAttributes(identityID, credential, confirm)
		props.Attributes["title"] = title
	}}
	@button.Button(props) {
		{ children... }
	}
}

// roleOptions are the roles an identity can be added with, named
func roleOptions(ctx context.Context, roles ...consts.IdentityRole) []sitemodels.RoleOption {
	options := []sitemodels.RoleOption{}
	for _, role := range roles {
		options = append(options, sitemodels.RoleOption{Label: RoleLabel(ctx, string(role)), Value: role})
	}
	return options
}

templ formCreateIdentity(tableid string, device bool, roles []sitemodels.RoleOption) {
	{{ formID := "createIdentityForm" + tableid }}
	<div class="flex justify-end items-end mt-4">
		<form
			id={ formID }
			hx-post="/settings/identities"
			hx-target={ "#" + tableid + " tbody" }
			hx-swap="beforeend"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			<div class="flex flex-wrap justify-end items-end gap-2">
				@field.Field("name-"+formID, i18n.T(ctx, "site.settings.identities.heads.name"), "w-24") {
					@input.Input(input.Props{
						ID:          "name-" + formID,
						Type:        "text",
						Name:        "name",
						Placeholder: i18n.T(ctx, "site.settings.identities.heads.name"),
						Required:    true,
					})
				}
				// The client is picked first, as some decide the role
				if device {
					@field.Field("client-"+formID, i18n.T(ctx, "site.settings.identities.client"), "w-36") {
						<div onchange={ templ.JSUnsafeFuncCall(forceClientRole(formID)) }>
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{ID: "client-" + formID, Name: "client", Form: formID}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "site.settings.identities.client")})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
									@selectbox.Group() {
										for i, client := range deviceClients {
											@selectbox.Item(selectbox.ItemProps{Value: client.Value, Selected: i == 0}) {
												{ clientLabel(ctx, client) }
											}
										}
									}
								}
							}
						</div>
					}
				}
				if (len(roles) == 1) {
					<input type="hidden" name="role" value={ string(roles[0].Value) }/>
				} else {
					@field.Field("select-form-"+formID, i18n.T(ctx, "site.settings.identities.heads.role"), "w-40") {
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:   "select-form-" + formID,
								Name: "role",
								Form: formID,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: i18n.T(ctx, "site.settings.identities.heads.role"),
								})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									for i, role := range roles {
										@selectbox.Item(selectbox.ItemProps{
											Value:    string(role.Value),
											Selected: i == 0,
										}) {
											{ role.Label }
										}
									}
								}
							}
						}
					}
				}
				@form.Item(form.ItemProps{
					Class: " items-end",
				}) {
					@button.Button(button.Props{
						Type: "submit",
					}) {
						if device {
							{ i18n.T(ctx, "site.settings.identities.add_device") }
						} else {
							{ i18n.T(ctx, "site.settings.identities.add_user") }
						}
					}
				}
			</div>
		</form>
	</div>
}

templ CreateIdentityResponse(url string, identity *sitemodels.UserIdentity, password string, totpSecret *string, nsToken *string) {
	@IdentityRow(identity)
	<div id="modal-container" class="w-full" hx-swap-oob="innerHTML">
		@CredentialsModal(url, identity.Name, password, totpSecret, nsToken, false) {
			@clientGuide(identity)
		}
	</div>
}

// clientGuide says how to set up the client a device was added for, and that its units are mg/dL when it needs them
templ clientGuide(identity *sitemodels.UserIdentity) {
	{{ client, steps := clientSteps(ctx, identity) }}
	if len(steps) > 0 {
		<div id="site--identities--created--guide" class="mt-4 w-full space-y-2 text-left text-sm">
			<p class="font-semibold">{ i18n.T(ctx, "site.settings.identities.setting_up", i18n.Data{"Client": clientLabel(ctx, client)}) }</p>
			<ol class="list-decimal space-y-2 pl-5">
				for i, step := range steps {
					<li>
						for j, part := range step {
							if part.Value {
								@copyValue(fmt.Sprintf("site--identities--created--guide-%d-%d", i, j), part.Name, part.Text)
							} else if part.Bold {
								<span class="font-semibold">{ part.Text }</span>
							} else {
								{ part.Text }
							}
						}
					</li>
				}
			</ol>
			if client.MGDL {
				<p id="site--identities--created--units" class="text-xs text-gray-500">{ i18n.T(ctx, "site.settings.identities.needs_mgdl", i18n.Data{"Client": clientLabel(ctx, client)}) }</p>
			}
		</div>
	}
}

// copyValue is a value to enter in a client, in a box with a button to copy it, named for the value's name
templ copyValue(id string, name string, value string) {
	<div class="mt-1 flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1">
		<code id={ id } class="flex-1 break-all font-mono text-xs text-slate-800">{ value }</code>
		@copybutton.CopyButton(copybutton.Props{TargetID: id, Label: i18n.T(ctx, "site.settings.identities.copy", i18n.Data{"Name": name})})
	</div>
}

// IdentityReset shows an identity's new credentials once. Resetting your own signed you out, to sign in again with them.
templ IdentityReset(url string, identity *sitemodels.UserIdentity, signedOut bool) {
	@CredentialsModal(url, identity.Name, identity.Password, identity.TotpSecret, identity.NSToken, signedOut)
}

// CredentialsModal is a dialog of an identity's, or a control admin's, new credentials. Escape or pressing beside it
// shows the warning that they are never shown again, as I Have Saved These does, so they are not lost by a slip; once
// signed out it goes to Sign In Again instead.
templ CredentialsModal(url string, name string, password string, totpSecret *string, nsToken *string, signedOut bool) {
	{{ dismiss := "document.getElementById('site--identities--saved-these').click()" }}
	if signedOut {
		{{ dismiss = "document.getElementById('site--identities--sign-in-again').focus()" }}
	}
	@modal.Modal(modal.Props{ID: "site--identities--credentials", Title: i18n.T(ctx, "site.settings.identities.credentials_for", i18n.Data{"Name": name}), Actions: credentialsActions(signedOut), Dismiss: dismiss}) {
		<div class="mt-4 flex flex-col items-center">
			if signedOut {
				@alert.Alert(alert.Props{ID: "site--identities--signed-out", Variant: alert.VariantWarning, Class: "mb-4 w-full"}) {
					{ i18n.T(ctx, "site.settings.identities.signed_out") }
				}
			}
			@createdUserInfo(url, name, password, totpSecret, nsToken)
			{ children... }
		</div>
	}
}

// credentialsActions are Sign In Again once signed out, or else I Have Saved These
templ credentialsActions(signedOut bool) {
	if signedOut {
		@button.Button(button.Props{ID: "site--identities--sign-in-again", Href: "/login"}) {
			{ i18n.T(ctx, "site.settings.identities.sign_in_again") }
		}
	} else {
		@savedThese()
	}
}

// savedThese closes the credentials, after warning that they are not shown again. Each of its buttons gives the focus to
// the one that takes its place, so it stays in the dialog, where Escape is heard
templ savedThese() {
	<div id="site--identities--saved" class="w-full">
		<div class="flex justify-end">
			@button.Button(button.Props{
				ID: "site--identities--saved-these",
				Attributes: templ.Attributes{
					"hx-on:click": templ.JSUnsafeFuncCall("this.parentElement.hidden = true; this.parentElement.nextElementSibling.hidden = false; document.getElementById('site--identities--saved-back').focus()"),
				},
			}) {
				{ i18n.T(ctx, "site.settings.identities.saved_these") }
			}
		</div>
		@alert.Alert(alert.Props{Variant: alert.VariantWarning, Class: "space-y-3", Attributes: templ.Attributes{"hidden": true}}) {
			<p id="site--identities--saved-warning" class="font-medium">
				{ i18n.T(ctx, "site.settings.identities.saved_warning") }
			</p>
			<div class="flex justify-end gap-2">
				@button.Button(button.Props{
					ID:      "site--identities--saved-back",
					Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"hx-on:click": templ.JSUnsafeFuncCall("this.parentElement.parentElement.hidden = true; this.closest('#site--identities--saved').firstElementChild.hidden = false; document.getElementById('site--identities--saved-these').focus()"),
					},
				}) {
					{ i18n.T(ctx, "site.settings.identities.go_back") }
				}
				@button.Button(button.Props{
					ID: "site--identities--close",
					Attributes: templ.Attributes{
						"hx-get":    "/empty",
						"hx-target": "#modal-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					{ i18n.T(ctx, "site.settings.identities.close") }
				}
			</div>
		}
	</div>
}

// credentialsText is the credentials to copy, one a line, leaving out those a reset did not change
func credentialsText(ctx context.Context, url string, username string, password string, totpSecret *string, nsToken *string) string {
	text := i18n.T(ctx, "site.settings.identities.labels.site") + " " + url + "\n" + i18n.T(ctx, "site.settings.identities.labels.username") + " " + username
	if password != "" {
		text += "\n" + i18n.T(ctx, "site.settings.identities.labels.password") + " " + password
	}
	if totpSecret != nil {
		text += "\n" + i18n.T(ctx, "site.settings.identities.labels.totp_secret") + " " + *totpSecret
	}
	if nsToken != nil {
		text += "\n" + i18n.T(ctx, "site.settings.identities.labels.ns_token") + " " + *nsToken
	}
	return text
}

templ createdUserInfo(url string, username string, password string, totpSecret *string, nsToken *string) {
	<div class="text-left w-full max-w-2xl mx-auto space-y-2">
		<div class="flex items-start gap-2 mb-4">
			<p class="font-bold text-green-800">{ i18n.T(ctx, "site.settings.identities.save_securely") }</p>
		</div>
		<div class="relative group rounded-xl border border-slate-200 bg-slate-50 shadow-sm overflow-hidden">
			<div class="flex items-center justify-between border-b border-slate-200 bg-slate-100/70 px-4 py-2.5">
				<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">{ i18n.T(ctx, "site.settings.identities.your_credentials") }</span>
				<textarea id="textToCopy" hidden>{ credentialsText(ctx, url, username, password, totpSecret, nsToken) }</textarea>
				<!-- Clear, High-Visibility Copy Button -->
				<div class="inline-flex shadow-sm rounded-lg">
					@copybutton.CopyButton(copybutton.Props{
						ID:       "site--identities--created--copy-all",
						TargetID: "textToCopy",
						Label:    i18n.T(ctx, "site.settings.identities.copy_all_label"),
						Class:    "h-auto w-auto inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-medium rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/20",
					}) {
						{ i18n.T(ctx, "site.settings.identities.copy_all") }
					}
				</div>
			</div>
			<!-- Monospace Content Area -->
			<div class="p-4 font-mono text-sm text-slate-800 space-y-2 select-all bg-white">
				@credentialRow(i18n.T(ctx, "site.settings.identities.labels.site"), "site--identities--created--site", url)
				@credentialRow(i18n.T(ctx, "site.settings.identities.labels.username"), "site--identities--created--username", username)
				if password != "" {
					@credentialRow(i18n.T(ctx, "site.settings.identities.labels.password"), "site--identities--created--password", password)
				}
				if nsToken != nil {
					@credentialRow(i18n.T(ctx, "site.settings.identities.labels.ns_token"), "site--identities--created--ns-token", *nsToken)
				}
				if totpSecret != nil {
					<div class="flex items-start">
						<span class="w-28 shrink-0 font-medium text-slate-400 select-none">{ i18n.T(ctx, "site.settings.identities.labels.totp_secret") }</span>
						@authenticator.Secret("site--identities--created", security.TOTPURI(username, url, *totpSecret), *totpSecret, 128)
					</div>
				}
			</div>
		</div>
	</div>
}

// credentialRow is one of the credentials, with a button to copy it
templ credentialRow(label string, id string, value string) {
	<div class="flex items-start">
		<span class="w-28 shrink-0 font-medium text-slate-400 select-none">{ label }</span>
		<span id={ id } class="flex-1 break-all">{ value }</span>
		@copybutton.CopyButton(copybutton.Props{TargetID: id, Label: i18n.T(ctx, "site.settings.identities.copy", i18n.Data{"Name": strings.TrimSuffix(label, ":")})})
	</div>
}

templ IdentityUpdated(identity *sitemodels.UserIdentity) {
	if identity.Enabled {
		@successtoast.Toast(i18n.T(ctx, "site.settings.identities.enabled_toast", i18n.Data{"Name": identity.Name}))
	} else {
		@successtoast.Toast(i18n.T(ctx, "site.settings.identities.disabled_toast", i18n.Data{"Name": identity.Name}))
	}
}

templ IdentityDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.settings.identities.deleted"))
}
