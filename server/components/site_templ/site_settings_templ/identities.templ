// roleLabels match the role names in the create forms
var roleLabels = map[consts.IdentityRole]string{
	consts.IdentityRoleAdmin: "Admin", consts.IdentityRoleUser: "User", consts.IdentityRoleUserReadOnly: "Read Only User",
	consts.IdentityRoleDeviceRead: "Read", consts.IdentityRoleDeviceReadWrite: "Read+Write", consts.IdentityRoleDevicePWDPhone: "PWD Phone",
}

// deviceClient is a Nightscout client a device can be added for, with how to set it up. In a step, *Name* is a menu
// or field in the client, shown in bold, and {url}, {token}, {xdrip} and {nightguard} are values to enter, shown with
// a button to copy them: the site's Nightscout URL, the device's Nightscout token, and the URL with the token in it
// that xDrip+ and Nightguard take.
type deviceClient struct {
	Value, Label string
	Steps        []string
	// MGDL is whether it needs glucose in mg/dL, so the device's own units are set to mg/dL
	MGDL bool
}

// deviceClients are the clients a device can be added for, Other first as the one chosen to start with
var deviceClients = []deviceClient{
	{"other", "Other", []string{"Set its *Nightscout URL* to {url}", "Set its *token* or *API secret* to {token}"}, false},
	{"aaps", "AAPS", []string{"Open *Config Builder*, and under *Synchronization* turn on *NSClient*.", "In *NSClient*'s settings, set *Nightscout URL* to {url}", "Set *NS access token* to {token}"}, true},
	{"trio", "Trio", []string{"Open *Settings*, then *Services*, then *Nightscout*.", "Set *URL* to {url}", "Set *API secret* to {token}", "Tap *Connect*."}, true},
	{"loop", "Loop", []string{"Open *Settings*, then *Services*, and add *Nightscout*.", "Set *Site URL* to {url}", "Set *API secret* to {token}"}, true},
	{"xdrip", "xDrip+", []string{"Open *Settings*, then *Cloud Upload*, then *Nightscout Sync (REST-API)*, and turn it on.", "Set *Base URL* to {xdrip}"}, true},
	{"xdrip4ios", "xDrip4iOS", []string{"Open *Settings*, then *Nightscout*, and set *URL* to {url}", "Set *Token*, or *API_SECRET* instead, to {token}", "Keep it the *Master* to upload, as a PWD Phone or Read+Write device, or make it a *Follower* of Nightscout to only read."}, true},
	{"nightguard", "Nightguard", []string{"Open *Configuration*, and set *URL* to {nightguard}"}, true},
	{"sugarpixel", "SugarPixel", []string{"In the SugarPixel app, choose *Nightscout* as its glucose source.", "Set *Nightscout URL* to {url}", "Set its *token* to {token}"}, true},
	{"t1dcarer", "T1D Carer", []string{"In T1D Carer, add a *Nightscout* site.", "Set *Nightscout URL* to {url}", "Set its *token* to {token}"}, true},
}

// stepPart is a piece of a step: text, in bold when it names a menu or field, or a value to copy
type stepPart struct {
	Text  string
	Bold  bool
	Value bool
}

// stepParts splits a step into its text, bold names and values, filling the values in
func stepParts(step string, values map[string]string) []stepPart {
	parts := []stepPart{}
	bold := false
	for step != "" {
		at := strings.IndexAny(step, "*{")
		if at < 0 {
			parts = append(parts, stepPart{Text: step, Bold: bold})
			break
		}
		if at > 0 {
			parts = append(parts, stepPart{Text: step[:at], Bold: bold})
		}
		if step[at] == '*' {
			bold, step = !bold, step[at+1:]
			continue
		}
		name, rest, _ := strings.Cut(step[at+1:], "}")
		parts = append(parts, stepPart{Text: values[name], Value: true})
		step = rest
	}
	return parts
}

// clientSteps are how to set up the device's client, with its URL and token filled in, or none for a device added
// without one
func clientSteps(identity *sitemodels.UserIdentity) (deviceClient, [][]stepPart) {
	index := slices.IndexFunc(deviceClients, func(c deviceClient) bool { return c.Value == identity.Client })
	if index < 0 || identity.NSToken == nil {
		return deviceClient{}, nil
	}
	url, token := identity.NSURL, *identity.NSToken
	host := url
	if _, after, ok := strings.Cut(host, "://"); ok {
		host = after
	}
	values := map[string]string{"url": url, "token": token, "xdrip": "https://" + token + "@" + host + "/api/v1/", "nightguard": url + "/?token=" + token}
	steps := [][]stepPart{}
	for _, step := range deviceClients[index].Steps {
		steps = append(steps, stepParts(step, values))
	}
	return deviceClients[index], steps
}

// forceClientRole is the client select's change handler: a client that must have a role sets the role select to it
// and stops it being changed, as the server refuses any other
func forceClientRole(formID string) string {
	roles, _ := json.Marshal(sitemodels.ClientRoles)
	return `const role = ` + string(roles) + `[event.target.value], trigger = document.getElementById("select-form-` + formID + `");
		if (role) { trigger.querySelector("input[type=hidden]").value = role }
		trigger.disabled = !!role`
}

func roleLabel(role string) string {
	if label, ok := roleLabels[consts.IdentityRole(role)]; ok {
		return label
	}
	return role
}

func formatIdentityDate(ctx context.Context, ms *int64) string {
	if ms == nil || *ms == 0 {
		return "Never"
	}
	return site_data_templ.FormatDate(ctx, *ms)
}

templ IdentitesTable(users []*sitemodels.UserIdentity, devices []*sitemodels.UserIdentity) {
	<div id="identities_table" class="mx-auto max-w-5xl space-y-6">
		@heading.Page("Users & Devices") {
			Nighttroop uses strict role separation to improve security. Each user and device should have its own credentials.
		}
		<div class="grid gap-4 md:grid-cols-3">
			@roleCard("Admin", "Manages users and site settings. Logs in with a password and TOTP, recovers only with the initial backup key, and cannot use the Nightscout API.")
			@roleCard("User", "A person using Nighttroop. Users can log in, view reports and use Nightscout features.")
			@roleCard("Device", "A phone, SugarPixel or display. Devices use the Nightscout API but cannot log in. The PWD phone's credentials go into your loop (AAPS, Trio...).")
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<h2 class="mb-3 text-lg font-semibold">Admins & Users</h2>
			@buildIdentityTable("usersTable", users)
			// The first role is picked to start with, so a user added without choosing one is a User, not an Admin
			@formCreateIdentity("usersTable", "User", []sitemodels.RoleOption{{Label: "User", Value: consts.IdentityRoleUser}, {Label: "Read Only User", Value: consts.IdentityRoleUserReadOnly}, {Label: "Admin", Value: consts.IdentityRoleAdmin}})
		</section>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<h2 class="mb-3 text-lg font-semibold">Devices</h2>
			@buildIdentityTable("devicesTable", devices)
			@formCreateIdentity("devicesTable", "Device", []sitemodels.RoleOption{{Label: "Read", Value: consts.IdentityRoleDeviceRead}, {Label: "Read+Write", Value: consts.IdentityRoleDeviceReadWrite}, {Label: "PWD Phone", Value: consts.IdentityRoleDevicePWDPhone}})
		</section>
		<div id="modal-container"></div>
	</div>
}

// roleCard explains a role, in neutral colours, as no role is a warning or an error
templ roleCard(title string, description string) {
	<div class="rounded-xl border border-gray-200 p-4">
		<h2 class="font-semibold text-brand-night">{ title }</h2>
		<p class="mt-1 text-sm text-gray-700">{ description }</p>
	</div>
}

templ buildIdentityTable(id string, identities []*sitemodels.UserIdentity) {
	@table.Table(table.Props{
		ID:    id,
		Class: "rounded-lg border border-gray-200",
	}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Name 
				}
				@table.Head() {
					Role 
				}
				@table.Head() {
					Created 
				}
				@table.Head() {
					Last Seen 
				}
				@table.Head() {
					Last Write 
				}
				@table.Head() {
					Recent Clients
				}
				@table.Head() {
					<span class="sr-only">Actions</span>
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@IdentityRow(identity)
			}
		}
	}
}

templ IdentityRow(identity *sitemodels.UserIdentity) {
	@table.Row() {
		@table.Cell() {
			{ identity.Name }
			if identity.CurrentIdentity {
				<span class="ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">You</span>
			}
		}
		@table.Cell() {
			{ roleLabel(identity.Role) }
		}
		@table.Cell() {
			{ formatIdentityDate(ctx, &identity.CreatedAt) }
		}
		@table.Cell() {
			<span title={ formatIdentityDate(ctx, identity.LastSeenAt) }>{ display.Ago(identity.LastSeenAt, time.Now()) }</span>
		}
		@table.Cell() {
			<span title={ formatIdentityDate(ctx, identity.LastWriteAt) }>{ display.Ago(identity.LastWriteAt, time.Now()) }</span>
		}
		@table.Cell() {
			@recentClients(identity)
		}
		@table.Cell() {
			@identityActions(identity)
		}
	}
}

// recentClients lists the apps and networks the identity recently authenticated from. A device used by more than one
// app is probably shared, and so are its settings and alarms, so it is marked.
templ recentClients(identity *sitemodels.UserIdentity) {
	{{ id := "site--identities--" + identity.Name + "--clients" }}
	{{ shared := consts.IdentityRole(identity.Role).GetType() == consts.IdentityTypeDevice && authclients.Shared(identity.RecentClients, time.Now()) }}
	if len(identity.RecentClients) == 0 {
		<span id={ id } class="text-sm text-gray-400">None yet</span>
	} else {
		<details id={ id } class="max-w-xs text-sm">
			<summary class={ "cursor-pointer", templ.KV("font-medium text-amber-800", shared) }>
				if shared {
					Used by more than one app
				} else {
					{ strconv.Itoa(len(identity.RecentClients)) } recent
				}
			</summary>
			if shared {
				<p class="mt-1 text-xs text-amber-800">Give each device its own identity, so its settings and alarms are its own.</p>
			}
			<ul class="mt-1 space-y-1 text-xs text-gray-600">
				for _, client := range identity.RecentClients {
					<li><span class="break-all">{ client.UserAgent }</span> · { client.Network } · { display.Ago(&client.LastAt, time.Now()) }</li>
				}
			</ul>
		</details>
	}
}

// identityActions changes an identity's settings, resets its password or TOTP, turns it on or off, or deletes it. Your own identity cannot be
// changed here; its password and TOTP are reset from the settings page.
// The toggle's hx-vals keeps its form from being empty when unchecked, and a failed update flips it back.
templ identityActions(identity *sitemodels.UserIdentity) {
	{{ id := "site--identities--" + identity.Name }}
	<div class="flex items-center justify-end gap-2">
		<label id={ id + "--enabled" } title="Enabled" class={ "relative inline-flex items-center", templ.KV("cursor-pointer", !identity.CurrentIdentity), templ.KV("opacity-50", identity.CurrentIdentity) }>
			<input
				type="checkbox"
				name="enabled"
				class="peer sr-only"
				checked?={ identity.Enabled }
				disabled?={ identity.CurrentIdentity }
				hx-post={ "/settings/identities/" + strconv.FormatInt(identity.ID, 10) }
				hx-trigger="change"
				hx-vals={ `{"id": ` + strconv.FormatInt(identity.ID, 10) + `}` }
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
				hx-on::after:request="if (ctx.response.status >= 400) this.checked = !this.checked"
			/>
			<span class="h-5 w-9 rounded-full bg-gray-300 transition-colors peer-checked:bg-gray-900 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-4"></span>
		</label>
		@button.Button(button.Props{
			ID:      id + "--settings",
			Variant: button.VariantGhost,
			Size:    button.SizeIcon,
			Attributes: templ.Attributes{
				"title":       "Settings",
				"hx-get":      "/settings/identity-settings/" + strconv.FormatInt(identity.ID, 10),
				"hx-target":   "#main-content",
				"hx-push-url": "true",
				"hx-swap":     "innerHTML",
			},
		}) {
			@icon.UserCog(icon.Props{Class: "size-4"})
		}
		@resetButton(button.Props{ID: id + "--reset-password", Variant: button.VariantGhost, Size: button.SizeIcon, Disabled: identity.CurrentIdentity},
			identity.ID, "password", "Reset password", "Reset "+identity.Name+"'s password? Its old password and Nightscout token stop working, and it is signed out.") {
			@icon.KeyRound(icon.Props{Class: "size-4"})
		}
		if identity.HasTotpSecret {
			@resetButton(button.Props{ID: id + "--reset-totp", Variant: button.VariantGhost, Size: button.SizeIcon, Disabled: identity.CurrentIdentity},
				identity.ID, "totp", "Reset TOTP", "Reset "+identity.Name+"'s TOTP? Codes from its old secret stop working, and it is signed out.") {
				@icon.RotateCcwKey(icon.Props{Class: "size-4"})
			}
		}
		@button.Button(button.Props{
			ID:       id + "--delete",
			Variant:  button.VariantGhost,
			Size:     button.SizeIcon,
			Disabled: identity.CurrentIdentity,
			Attributes: templ.Attributes{
				"title":                "Delete",
				"hx-delete":            "/settings/identities/" + strconv.FormatInt(identity.ID, 10),
				"hx-confirm":           "Delete " + identity.Name + "? Its password and tokens will stop working.",
				"hx-target":            "#toaster",
				"hx-swap":              "beforeend",
				"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
				"hx-status:4xx":        "target:#toaster swap:beforeend",
				"hx-status:5xx":        "target:#toaster swap:beforeend",
			},
		}) {
			@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
		}
	</div>
}

// resetButton resets an identity's password or totp after confirming, showing the new one in the page's modal
templ resetButton(props button.Props, identityID int64, credential string, title string, confirm string) {
	{{
		props.Attributes = templ.Attributes{
			"title":         title,
			"hx-post":       "/settings/identities/" + strconv.FormatInt(identityID, 10) + "/" + credential,
			"hx-confirm":    confirm,
			"hx-target":     "#modal-container",
			"hx-swap":       "innerHTML",
			"hx-status:4xx": "target:#toaster swap:beforeend",
			"hx-status:5xx": "target:#toaster swap:beforeend",
		}
	}}
	@button.Button(props) {
		{ children... }
	}
}

templ formCreateIdentity(tableid string, name string, roles []sitemodels.RoleOption) {
	{{ formID := "createIdentityForm" + tableid }}
	<div class="flex justify-end items-end mt-4">
		<form
			id={ formID }
			hx-post="/settings/identities"
			hx-target={ "#" + tableid + " tbody" }
			hx-swap="beforeend"
			hx-status:4xx="target:#toaster"
			hx-status:5xx="target:#toaster"
		>
			<div class="flex flex-wrap justify-end items-end gap-2">
				@field.Field("name-"+formID, "Name", "w-24") {
					@input.Input(input.Props{
						ID:          "name-" + formID,
						Type:        "text",
						Name:        "name",
						Placeholder: "Name",
						Required:    true,
					})
				}
				// The client is picked first, as some decide the role
				if name == "Device" {
					@field.Field("client-"+formID, "Client", "w-36") {
						<div onchange={ templ.JSUnsafeFuncCall(forceClientRole(formID)) }>
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{ID: "client-" + formID, Name: "client", Form: formID}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: "Client"})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
									@selectbox.Group() {
										for i, client := range deviceClients {
											@selectbox.Item(selectbox.ItemProps{Value: client.Value, Selected: i == 0}) {
												{ client.Label }
											}
										}
									}
								}
							}
						</div>
					}
				}
				if (len(roles) == 1) {
					<input type="hidden" name="role" value={ string(roles[0].Value) }/>
				} else {
					@field.Field("select-form-"+formID, "Role", "w-40") {
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:   "select-form-" + formID,
								Name: "role",
								Form: formID,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Role",
								})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									for i, role := range roles {
										@selectbox.Item(selectbox.ItemProps{
											Value:    string(role.Value),
											Selected: i == 0,
										}) {
											{ role.Label }
										}
									}
								}
							}
						}
					}
				}
				@form.Item(form.ItemProps{
					Class: " items-end",
				}) {
					@button.Button(button.Props{
						Type: "submit",
					}) {
						Add { name }
					}
				}
			</div>
		</form>
	</div>
}

templ CreateIdentityResponse(url string, identity *sitemodels.UserIdentity, password string, totpSecret *string, nsToken *string) {
	@IdentityRow(identity)
	<div id="modal-container" class="w-full" hx-swap-oob="innerHTML">
		@credentialsModal(url, identity.Name, password, totpSecret, nsToken, false) {
			@clientGuide(identity)
		}
	</div>
}

// clientGuide says how to set up the client a device was added for, and that its units are mg/dL when it needs them
templ clientGuide(identity *sitemodels.UserIdentity) {
	{{ client, steps := clientSteps(identity) }}
	if len(steps) > 0 {
		<div id="site--identities--created--guide" class="mt-4 w-full space-y-2 text-left text-sm">
			<p class="font-semibold">Setting up { client.Label }</p>
			<ol class="list-decimal space-y-2 pl-5">
				for i, step := range steps {
					<li>
						for j, part := range step {
							if part.Value {
								@copyValue(fmt.Sprintf("site--identities--created--guide-%d-%d", i, j), part.Text)
							} else if part.Bold {
								<span class="font-semibold">{ part.Text }</span>
							} else {
								{ part.Text }
							}
						}
					</li>
				}
			</ol>
			if client.MGDL {
				<p id="site--identities--created--units" class="text-xs text-gray-500">{ client.Label } needs mg/dL, so this device's own units are mg/dL, whatever the site's.</p>
			}
		</div>
	}
}

// copyValue is a value to enter in a client, in a box with a button to copy it
templ copyValue(id string, value string) {
	<div class="mt-1 flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1">
		<code id={ id } class="flex-1 break-all font-mono text-xs text-slate-800">{ value }</code>
		@copybutton.CopyButton(copybutton.Props{TargetID: id})
	</div>
}

// IdentityReset shows an identity's new credentials once. Resetting your own signed you out, to sign in again with them.
templ IdentityReset(url string, identity *sitemodels.UserIdentity, signedOut bool) {
	@credentialsModal(url, identity.Name, identity.Password, identity.TotpSecret, identity.NSToken, signedOut)
}

templ credentialsModal(url string, name string, password string, totpSecret *string, nsToken *string, signedOut bool) {
	// Over the sticky header, which is z-40, with room around it on a phone
	<div id="site--identities--credentials" class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
		// As tall as the window allows, scrolling when a device's set up steps make it taller
		<div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md max-h-full overflow-y-auto flex flex-col items-center">
			if signedOut {
				<p id="site--identities--signed-out" class="mb-4 text-sm font-medium text-amber-800">You have been signed out. Save these, then sign in again with them.</p>
			}
			@createdUserInfo(url, name, password, totpSecret, nsToken)
			{ children... }
			if signedOut {
				@button.Button(button.Props{ID: "site--identities--sign-in-again", Class: "mt-4", Href: "/login"}) {
					Sign In Again
				}
			} else {
				@savedThese()
			}
		</div>
	</div>
}

// savedThese closes the credentials, after warning that they are not shown again
templ savedThese() {
	<div id="site--identities--saved" class="mt-4 w-full">
		<div class="flex justify-center">
			@button.Button(button.Props{
				ID: "site--identities--saved-these",
				Attributes: templ.Attributes{
					"hx-on:click": templ.JSUnsafeFuncCall("this.parentElement.hidden = true; this.parentElement.nextElementSibling.hidden = false"),
				},
			}) {
				I Have Saved These
			}
		</div>
		<div hidden class="space-y-3 rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-sm text-amber-800">
			<p id="site--identities--saved-warning" class="font-medium">
				Once closed, these credentials disappear and are never shown again. If they are lost, they can only be reset.
			</p>
			<div class="flex justify-end gap-2">
				@button.Button(button.Props{
					ID:      "site--identities--saved-back",
					Variant: button.VariantOutline,
					Attributes: templ.Attributes{
						"hx-on:click": templ.JSUnsafeFuncCall("this.parentElement.parentElement.hidden = true; this.closest('#site--identities--saved').firstElementChild.hidden = false"),
					},
				}) {
					Go Back
				}
				@button.Button(button.Props{
					ID: "site--identities--close",
					Attributes: templ.Attributes{
						"hx-get":    "/empty",
						"hx-target": "#modal-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					Close
				}
			</div>
		</div>
	</div>
}

// credentialsText is the credentials to copy, one a line, leaving out those a reset did not change
func credentialsText(url string, username string, password string, totpSecret *string, nsToken *string) string {
	text := "Site: " + url + "\nUsername: " + username
	if password != "" {
		text += "\nPassword: " + password
	}
	if totpSecret != nil {
		text += "\nTOTP Secret: " + *totpSecret
	}
	if nsToken != nil {
		text += "\nNightscout Token: " + *nsToken
	}
	return text
}

templ createdUserInfo(url string, username string, password string, totpSecret *string, nsToken *string) {
	<div class="text-left w-full max-w-2xl mx-auto space-y-2">
		<div class="flex items-start gap-2 mb-4">
			<p class="font-bold text-green-800">Save this information in a secure place</p>
		</div>
		<div class="relative group rounded-xl border border-slate-200 bg-slate-50 shadow-sm overflow-hidden">
			<div class="flex items-center justify-between border-b border-slate-200 bg-slate-100/70 px-4 py-2.5">
				<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your Credentials</span>
				<textarea id="textToCopy" hidden>{ credentialsText(url, username, password, totpSecret, nsToken) }</textarea>
				<!-- Clear, High-Visibility Copy Button -->
				<div class="inline-flex shadow-sm rounded-lg">
					@copybutton.CopyButton(copybutton.Props{
						TargetID: "textToCopy",
						Class:    "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-medium rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/20",
					})
				</div>
			</div>
			<!-- Monospace Content Area -->
			<div class="p-4 font-mono text-sm text-slate-800 space-y-2 select-all bg-white">
				@credentialRow("Site:", "site--identities--created--site", url)
				@credentialRow("Username:", "site--identities--created--username", username)
				if password != "" {
					@credentialRow("Password:", "site--identities--created--password", password)
				}
				if nsToken != nil {
					@credentialRow("Nightscout Token:", "site--identities--created--ns-token", *nsToken)
				}
				if totpSecret != nil {
					<div class="flex items-start">
						<span class="w-28 shrink-0 font-medium text-slate-400 select-none">TOTP Secret:</span>
						@authenticator.Secret("site--identities--created", security.TOTPURI(username, url, *totpSecret), *totpSecret, 128)
					</div>
				}
			</div>
		</div>
	</div>
}

// credentialRow is one of the credentials, with a button to copy it
templ credentialRow(label string, id string, value string) {
	<div class="flex items-start">
		<span class="w-28 shrink-0 font-medium text-slate-400 select-none">{ label }</span>
		<span id={ id } class="flex-1 break-all">{ value }</span>
		@copybutton.CopyButton(copybutton.Props{TargetID: id})
	</div>
}

templ IdentityUpdated(identity *sitemodels.UserIdentity) {
	{{ state := "disabled" }}
	if identity.Enabled {
		{{ state = "enabled" }}
	}
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   identity.Name + " " + state,
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}

templ IdentityDeleted() {
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   "Identity Deleted",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}
