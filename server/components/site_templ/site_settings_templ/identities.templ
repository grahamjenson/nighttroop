package site_settings_templ

import (
	"context"
	"strconv"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/selectbox"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
)

// roleLabels match the role names in the create forms
var roleLabels = map[consts.IdentityRole]string{
	consts.IdentityRoleAdmin: "Admin", consts.IdentityRoleUser: "User", consts.IdentityRoleUserReadOnly: "Read Only User",
	consts.IdentityRoleDeviceRead: "Read", consts.IdentityRoleDeviceReadWrite: "Read+Write", consts.IdentityRoleDevicePWDPhone: "PWD Phone",
}

func roleLabel(role string) string {
	if label, ok := roleLabels[consts.IdentityRole(role)]; ok {
		return label
	}
	return role
}

func formatIdentityDate(ctx context.Context, ms *int64) string {
	if ms == nil || *ms == 0 {
		return "Never"
	}
	return site_data_templ.FormatDate(ctx, *ms)
}

templ IdentitesTable(users []*sitemodels.UserIdentity, devices []*sitemodels.UserIdentity) {
	<div id="identities_table" class="mx-auto max-w-5xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">Users & Devices</h1>
			<p class="mt-1 text-gray-500">
				Nighttroop uses strict role separation to improve security. Each user and device should have its own credentials.
			</p>
		</div>
		<div class="grid gap-4 md:grid-cols-3">
			@roleCard("Admin", "border-red-200 bg-red-50 text-red-700", "Manages users and site settings. Logs in with a password and TOTP, recovers only with the initial backup key, and cannot use the Nightscout API.")
			@roleCard("User", "border-blue-200 bg-blue-50 text-blue-700", "A person using Nighttroop. Users can log in, view reports and use Nightscout features.")
			@roleCard("Device", "border-green-200 bg-green-50 text-green-700", "A phone, SugarPixel or display. Devices use the Nightscout API but cannot log in. The PWD phone's credentials go into your loop (AAPS, Trio...).")
		</div>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<h2 class="mb-3 text-lg font-semibold">Admins & Users</h2>
			@buildIdentityTable("usersTable", users)
			@formCreateIdentity("usersTable", "User", []sitemodels.RoleOption{{Label: "Admin", Value: consts.IdentityRoleAdmin}, {Label: "User", Value: consts.IdentityRoleUser}, {Label: "Read Only User", Value: consts.IdentityRoleUserReadOnly}})
		</section>
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			<h2 class="mb-3 text-lg font-semibold">Devices</h2>
			@buildIdentityTable("devicesTable", devices)
			@formCreateIdentity("devicesTable", "Device", []sitemodels.RoleOption{{Label: "Read", Value: consts.IdentityRoleDeviceRead}, {Label: "Read+Write", Value: consts.IdentityRoleDeviceReadWrite}, {Label: "PWD Phone", Value: consts.IdentityRoleDevicePWDPhone}})
		</section>
		<div id="modal-container"></div>
	</div>
}

templ roleCard(title string, colors string, description string) {
	<div class={ "rounded-xl border p-4", colors }>
		<h2 class="font-semibold">{ title }</h2>
		<p class="mt-1 text-sm text-gray-700">{ description }</p>
	</div>
}

templ buildIdentityTable(id string, identities []*sitemodels.UserIdentity) {
	@table.Table(table.Props{
		ID:    id,
		Class: "rounded-lg border border-gray-200",
	}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					Name 
				}
				@table.Head() {
					Role 
				}
				@table.Head() {
					Created at 
				}
				@table.Head() {
					Last Seen 
				}
				@table.Head() {
					Last Write 
				}
				@table.Head() {
					<span class="sr-only">Actions</span>
				}
			}
		}
		@table.Body() {
			for _, identity := range identities {
				@IdentityRow(identity)
			}
		}
	}
}

templ IdentityRow(identity *sitemodels.UserIdentity) {
	@table.Row() {
		@table.Cell() {
			{ identity.Name }
			if identity.CurrentIdentity {
				<span class="ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">You</span>
			}
		}
		@table.Cell() {
			{ roleLabel(identity.Role) }
		}
		@table.Cell() {
			{ formatIdentityDate(ctx, &identity.CreatedAt) }
		}
		@table.Cell() {
			<span title={ formatIdentityDate(ctx, identity.LastSeenAt) }>{ display.Ago(identity.LastSeenAt, time.Now()) }</span>
		}
		@table.Cell() {
			<span title={ formatIdentityDate(ctx, identity.LastWriteAt) }>{ display.Ago(identity.LastWriteAt, time.Now()) }</span>
		}
		@table.Cell() {
			@identityActions(identity)
		}
	}
}

// identityActions turns an identity on or off, or deletes it. Your own identity cannot be changed here.
// The toggle's hx-vals keeps its form from being empty when unchecked, and a failed update flips it back.
templ identityActions(identity *sitemodels.UserIdentity) {
	{{ id := "site--identities--" + identity.Name }}
	<div class="flex items-center justify-end gap-2">
		<label id={ id + "--enabled" } title="Enabled" class={ "relative inline-flex items-center", templ.KV("cursor-pointer", !identity.CurrentIdentity), templ.KV("opacity-50", identity.CurrentIdentity) }>
			<input
				type="checkbox"
				name="enabled"
				class="peer sr-only"
				checked?={ identity.Enabled }
				disabled?={ identity.CurrentIdentity }
				hx-post={ "/settings/identities/" + strconv.FormatInt(identity.ID, 10) }
				hx-trigger="change"
				hx-vals={ `{"id": ` + strconv.FormatInt(identity.ID, 10) + `}` }
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
				hx-on::after:request="if (ctx.response.status >= 400) this.checked = !this.checked"
			/>
			<span class="h-5 w-9 rounded-full bg-gray-300 transition-colors peer-checked:bg-gray-900 after:absolute after:left-0.5 after:top-0.5 after:size-4 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-4"></span>
		</label>
		@button.Button(button.Props{
			ID:       id + "--delete",
			Variant:  button.VariantGhost,
			Size:     button.SizeIcon,
			Disabled: identity.CurrentIdentity,
			Attributes: templ.Attributes{
				"title":                "Delete",
				"hx-delete":            "/settings/identities/" + strconv.FormatInt(identity.ID, 10),
				"hx-confirm":           "Delete " + identity.Name + "? Its password and tokens will stop working.",
				"hx-target":            "#toaster",
				"hx-swap":              "beforeend",
				"hx-on::after:request": "if (ctx.response.status < 400) this.closest('tr').remove()",
				"hx-status:4xx":        "target:#toaster swap:beforeend",
				"hx-status:5xx":        "target:#toaster swap:beforeend",
			},
		}) {
			@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
		}
	</div>
}

templ formCreateIdentity(tableid string, name string, roles []sitemodels.RoleOption) {
	{{ formID := "createIdentityForm" + tableid }}
	<div class="flex justify-end items-end mt-4">
		<form
			id={ formID }
			hx-post="/settings/identities"
			hx-target={ "#" + tableid + " tbody" }
			hx-swap="beforeend"
			hx-status:4xx="target:#toaster"
			hx-status:5xx="target:#toaster"
		>
			<div class="flex w-x1 justify-end items-end gap-2">
				@form.Item(form.ItemProps{
					Class: "w-24",
				}) {
					@input.Input(input.Props{
						ID:          "name-" + formID,
						Type:        "text",
						Name:        "name",
						Placeholder: "Name",
						Required:    true,
					})
				}
				if (len(roles) == 1) {
					<input type="hidden" name="role" value={ string(roles[0].Value) }/>
				} else {
					@form.Item(form.ItemProps{
						Class: "w-40",
					}) {
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:   "select-form-" + formID,
								Name: "role",
								Form: formID,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Role",
								})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									for i, role := range roles {
										@selectbox.Item(selectbox.ItemProps{
											Value:    string(role.Value),
											Selected: i == 0,
										}) {
											{ role.Label }
										}
									}
								}
							}
						}
					}
				}
				@form.Item(form.ItemProps{
					Class: " items-end",
				}) {
					@button.Button(button.Props{
						Type: "submit",
					}) {
						Add { name }
					}
				}
			</div>
		</form>
	</div>
}

templ CreateIdentityResponse(url string, identity *sitemodels.UserIdentity, password string, totpSecret *string, nsToken *string) {
	@IdentityRow(identity)
	<div id="modal-container" class="w-full" hx-swap-oob="innerHTML">
		@newIdentityModal(url, identity, password, totpSecret, nsToken)
	</div>
}

templ newIdentityModal(url string, identity *sitemodels.UserIdentity, password string, totpSecret *string, nsToken *string) {
	<div class="fixed inset-0 bg-black/50 flex items-center justify-center">
		<div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md flex flex-col items-center justify-center">
			@createdUserInfo(url, identity.Name, password, totpSecret, nsToken)
			@button.Button(button.Props{
				Class:   "mt-4",
				Variant: button.VariantDestructive,
				Attributes: templ.Attributes{
					"hx-get":    "/empty",
					"hx-target": "#modal-container",
					"hx-swap":   "innerHTML",
				},
			}) {
				I Have Saved These
			}
		</div>
	</div>
}

templ createdUserInfo(url string, username string, password string, totpSecret *string, nsToken *string) {
	<div class="text-left w-full max-w-2xl mx-auto space-y-2">
		<div class="flex items-start gap-2 mb-4">
			<p class="font-bold text-green-800">Save this information in a secure place</p>
		</div>
		<div class="relative group rounded-xl border border-slate-200 bg-slate-50 shadow-sm overflow-hidden">
			<div class="flex items-center justify-between border-b border-slate-200 bg-slate-100/70 px-4 py-2.5">
				<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your Credentials</span>
				if totpSecret != nil && nsToken != nil {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password + "\nTOTP Secret: " + *totpSecret + "\nNightscout Token: " + *nsToken }</textarea>
				} else if totpSecret != nil {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password + "\nTOTP Secret: " + *totpSecret }</textarea>
				} else if nsToken != nil {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password + "\nNightscout Token: " + *nsToken }</textarea>
				} else {
					<textarea id="textToCopy" hidden>{ "Site: " + url + "\nUsername: " + username + "\nPassword: " + password }</textarea>
				}
				<!-- Clear, High-Visibility Copy Button -->
				<div class="inline-flex shadow-sm rounded-lg">
					@copybutton.CopyButton(copybutton.Props{
						TargetID: "textToCopy",
						Class:    "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-medium rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/20",
					})
				</div>
			</div>
			<!-- Monospace Content Area -->
			<div class="p-4 font-mono text-sm text-slate-800 space-y-2 select-all bg-white">
				<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Site:</span><span class="break-all">{ url }</span></div>
				<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Username:</span><span>{ username }</span></div>
				<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Password:</span><span class="break-all">{ password }</span></div>
				if nsToken != nil {
					<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Nightscout Token:</span><span class="break-all">{ *nsToken }</span></div>
				}
				if totpSecret != nil {
					<div class="flex">
						<div class="flex items-start gap-6">
							<!-- Left: label + secret -->
							<div class="flex">
								<span class="w-28 shrink-0 font-medium text-slate-400 select-none">
									TOTP Secret:
								</span>
							</div>
							<!-- Right: QR block -->
							<div class="flex flex-col items-center gap-2">
								<div id="qrcode" class="p-2 bg-white rounded-lg shadow-sm border border-slate-200"></div>
								<span class="text-xs text-slate-400">Scan with authenticator</span>
							</div>
						</div>
						<script type="text/javascript">
							var qrcode = new QRCode(document.getElementById("qrcode"), {
								text: "{{ totpSecret }}",
								width: 128,
								height: 128,
								colorDark: "#000000",
								colorLight: "#ffffff",
								correctLevel: QRCode.CorrectLevel.H,
							});
						</script>
					</div>
				}
			</div>
		</div>
	</div>
}

templ IdentityUpdated(identity *sitemodels.UserIdentity) {
	{{ state := "disabled" }}
	if identity.Enabled {
		{{ state = "enabled" }}
	}
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   identity.Name + " " + state,
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}

templ IdentityDeleted() {
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   "Identity Deleted",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}
