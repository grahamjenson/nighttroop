package site_settings_templ

import (
	"strconv"
	"strings"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/pager"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
)

// pushProviders are the services a credential sends pushes through, as people know them
var pushProviders = map[string]string{string(consts.PushProviderAPNs): "Apple (APNs)", string(consts.PushProviderFCM): "Firebase (FCM)"}

// PushCredentialsTable is the site's push credentials, with a button to add one and each one's to delete it
templ PushCredentialsTable(credentials []*sitemodels.PushCredential) {
	<div id="push_credentials_table" class="mx-auto max-w-5xl space-y-6">
		@heading.PageWith("Push Notifications", addmodal.Open("site--push-credential--add", "/settings/push-credentials/new", "Add Push Credential")) {
			The keys pushes are sent to your own builds of apps with, such as an Apple push key (.p8) for the Loop you build
			with your Apple developer account. Only your site uses them, and a key is never shown again once added.
		}
		<section class="rounded-xl border border-gray-200 p-4 shadow-sm">
			@table.Table(table.Props{ID: "pushCredentialsTable", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Name
						}
						@table.Head() {
							Service
						}
						@table.Head() {
							Team or Project
						}
						@table.Head() {
							Apps
						}
						@table.Head() {
							Bundle IDs
						}
						@table.Head() {
							Added By
						}
						@table.Head() {
							<span class="sr-only">Actions</span>
						}
					}
				}
				@table.Body() {
					for _, credential := range credentials {
						@PushCredentialRow(credential)
					}
					@pager.Empty("site--push-credential--empty", 7, "No push credentials yet.")
				}
			}
		</section>
		<div id="modal-container"></div>
	</div>
}

// PushCredentialRow is a credential, without its secret, and a button to delete it
templ PushCredentialRow(credential *sitemodels.PushCredential) {
	{{ id := "site--push-credential--" + strconv.FormatInt(credential.ID, 10) }}
	@table.Row(table.RowProps{ID: id}) {
		@table.Cell() {
			{ credential.Name }
		}
		@table.Cell() {
			{ pushProviders[string(credential.Provider)] }
		}
		@table.Cell() {
			{ credential.TeamOrProjectID }
			if credential.KeyID != nil {
				<span class="block text-xs text-gray-500">Key { *credential.KeyID }</span>
			}
		}
		@table.Cell() {
			{ strings.Join(credential.Apps, ", ") }
		}
		@table.Cell() {
			if len(credential.BundleIDs) == 0 {
				Any
			} else {
				{ strings.Join(credential.BundleIDs, ", ") }
			}
		}
		@table.Cell() {
			{ credential.CreatedByIdentityName }
		}
		@table.Cell() {
			<div class="flex justify-end">
				@button.Button(button.Props{
					ID:      id + "--delete",
					Variant: button.VariantGhost,
					Size:    button.SizeIcon,
					Attributes: templ.Attributes{
						"title":                "Delete",
						"hx-delete":            "/settings/push-credentials/" + strconv.FormatInt(credential.ID, 10),
						"hx-confirm":           "Delete this push credential? Pushes sent with it will stop.",
						"hx-target":            "#toaster",
						"hx-swap":              "beforeend",
						"hx-on::after:request": templ.JSUnsafeFuncCall("if (ctx.response.status < 400) this.closest('tr').remove()"),
						"hx-status:4xx":        "target:#toaster swap:beforeend",
						"hx-status:5xx":        "target:#toaster swap:beforeend",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-4 text-red-600"})
				}
			</div>
		}
	}
}

// pushCredentialForm adds a credential: its fields, then the apps it pushes to and its secret
var pushCredentialForm = addmodal.Props{
	ID: "site--push-credential--create", Title: "Add Push Credential", Path: "/settings/push-credentials",
	Target: "#pushCredentialsTable tbody", Submit: "Add Push Credential",
	Fields: []addmodal.Field{
		{Name: "name", Label: "Name", Help: "What it is for, e.g. My Loop.", Required: true, Kind: addmodal.Text, Max: "64"},
		{Name: "provider", Label: "Service", Help: "Apple for iPhone apps, Firebase for Android apps.", Required: true, Kind: addmodal.Select,
			Options: []string{string(consts.PushProviderAPNs), string(consts.PushProviderFCM)}, Value: string(consts.PushProviderAPNs),
			OptionLabel: func(p string) string { return pushProviders[p] }},
		{Name: "team_or_project_id", Label: "Team or Project ID", Help: "Your Apple developer team ID, or your Firebase project ID.", Required: true, Kind: addmodal.Text, Max: "64"},
		{Name: "key_id", Label: "Key ID", Help: "The Apple push key's 10 character ID; none for Firebase.", Kind: addmodal.Text, Max: "10"},
		{Name: "bundle_ids", Label: "Bundle IDs", Help: "The only apps it pushes to, separated by commas; blank for any of yours.", Kind: addmodal.Text, Max: "2048", Wide: true},
	},
	Extra: pushCredentialExtra("site--push-credential--create"),
}

// pushCredentialExtra are a checkbox for each app it can push to, and its secret, pasted in
templ pushCredentialExtra(formID string) {
	<fieldset class="mb-3">
		<legend class="mb-1 text-sm font-medium text-gray-700">Apps</legend>
		<div class="flex flex-wrap gap-4">
			for _, app := range consts.PushApps {
				<label class="flex items-center gap-2 text-sm">
					@checkbox.Checkbox(checkbox.Props{ID: formID + "--apps--" + string(app), Name: "apps", Value: string(app)})
					{ string(app) }
				</label>
			}
		</div>
		<p class="mt-1 text-xs text-gray-500">The apps it sends pushes to.</p>
	</fieldset>
	<label for={ formID + "--secret" } class="mb-1 flex items-baseline justify-between text-sm font-medium text-gray-700">
		Key
		<span class="text-xs font-semibold text-primary">Required</span>
	</label>
	<textarea id={ formID + "--secret" } name="secret" required rows="6" maxlength="4096" class="w-full rounded-md border border-gray-200 p-2 font-mono text-xs"></textarea>
	<p class="mt-1 text-xs text-gray-500">Paste the whole .p8 file, or the Firebase service account's JSON. It is kept encrypted and never shown again.</p>
}

// PushCredentialNew is the modal to add a credential in, putting its row at the top of the table
templ PushCredentialNew() {
	@addmodal.Modal(pushCredentialForm)
}

templ PushCredentialDeleted() {
	@successtoast.Toast("Push Credential Deleted")
}
