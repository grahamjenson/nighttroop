package site_settings_templ

import (
	"context"
	"strconv"
	"strings"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/addmodal"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/checkbox"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/i18n"
)

// PushProviders are the services a credential sends pushes through, as people know them
var PushProviders = map[string]string{string(consts.PushProviderAPNs): "Apple (APNs)", string(consts.PushProviderFCM): "Firebase (FCM)"}

// PushCredentialsTable is the site's push credentials, with a button to add one and each one's to delete it
templ PushCredentialsTable(credentials []*sitemodels.PushCredential) {
	@listpage.Page(listpage.Props{
		ID:    "push_credentials_table",
		Title:       i18n.T(ctx, "site.settings.push_credentials.title"),
		Modal:       true,
		Description: i18n.T(ctx, "site.settings.push_credentials.about"),
		Action:      addmodal.Open("site--push-credential--add", "/settings/push-credentials/new", i18n.T(ctx, "site.settings.push_credentials.add")),
		Table: listpage.TableProps{
			ID:      "pushCredentialsTable",
			EmptyID: "site--push-credential--empty",
			Empty:   i18n.T(ctx, "site.settings.push_credentials.empty"),
			Columns: []table.Column{
				{Label: i18n.T(ctx, "site.settings.push_credentials.name")}, {Label: i18n.T(ctx, "site.settings.push_credentials.service")}, {Label: i18n.T(ctx, "site.settings.push_credentials.team_or_project")}, {Label: i18n.T(ctx, "site.settings.push_credentials.apps")},
				{Label: i18n.T(ctx, "site.settings.push_credentials.bundle_ids")}, {Label: i18n.T(ctx, "site.settings.push_credentials.added_by")}, {Actions: true},
			},
		},
	}) {
		for _, credential := range credentials {
			@PushCredentialRow(credential)
		}
	}
}

// PushCredentialRow is a credential, without its secret, and a button to delete it
templ PushCredentialRow(credential *sitemodels.PushCredential) {
	{{ id := "site--push-credential--" + strconv.FormatInt(credential.ID, 10) }}
	@table.Row(table.RowProps{ID: id}) {
		@table.Cell() {
			{ credential.Name }
		}
		@table.Cell() {
			{ PushProviders[string(credential.Provider)] }
		}
		@table.Cell() {
			{ credential.TeamOrProjectID }
			if credential.KeyID != nil {
				<span class="block text-xs text-gray-500">{ i18n.T(ctx, "site.settings.push_credentials.key_id_value", i18n.Data{"KeyID": *credential.KeyID}) }</span>
			}
		}
		@table.Cell() {
			{ strings.Join(credential.Apps, ", ") }
		}
		@table.Cell() {
			if len(credential.BundleIDs) == 0 {
				{ i18n.T(ctx, "site.settings.push_credentials.any") }
			} else {
				{ strings.Join(credential.BundleIDs, ", ") }
			}
		}
		@table.Cell() {
			{ credential.CreatedByIdentityName }
		}
		@table.DeleteCell(id+"--delete", "/settings/push-credentials/"+strconv.FormatInt(credential.ID, 10), i18n.T(ctx, "site.settings.push_credentials.delete_confirm"))
	}
}

// PushCredentialFormIn adds a credential, in the context's language: its fields, then the apps it pushes to and its secret
func PushCredentialFormIn(ctx context.Context) addmodal.Props {
	return addmodal.Props{
		ID: "site--push-credential--create", Title: i18n.T(ctx, "site.settings.push_credentials.add"), Path: "/settings/push-credentials",
		Target: "#pushCredentialsTable tbody", Submit: i18n.T(ctx, "site.settings.push_credentials.add"),
		Fields: []addmodal.Field{
			{Name: "name", Column: "push_credentials.Name", Label: i18n.T(ctx, "site.settings.push_credentials.name"), Help: i18n.T(ctx, "site.settings.push_credentials.name_help"), Required: true, Kind: addmodal.Text},
			{Name: "provider", Label: i18n.T(ctx, "site.settings.push_credentials.service"), Help: i18n.T(ctx, "site.settings.push_credentials.service_help"), Required: true, Kind: addmodal.Select,
				Options: []string{string(consts.PushProviderAPNs), string(consts.PushProviderFCM)}, Value: string(consts.PushProviderAPNs),
				OptionLabel: func(p string) string { return PushProviders[p] }},
			{Name: "team_or_project_id", Column: "push_credentials.TeamOrProjectID", Label: i18n.T(ctx, "site.settings.push_credentials.team_or_project_id"), Help: i18n.T(ctx, "site.settings.push_credentials.team_or_project_id_help"), Required: true, Kind: addmodal.Text},
			{Name: "key_id", Column: "push_credentials.KeyID", Label: i18n.T(ctx, "site.settings.push_credentials.key_id"), Help: i18n.T(ctx, "site.settings.push_credentials.key_id_help"), Kind: addmodal.Text},
			{Name: "bundle_ids", Column: "push_credentials.BundleIdsJson", Label: i18n.T(ctx, "site.settings.push_credentials.bundle_ids"), Help: i18n.T(ctx, "site.settings.push_credentials.bundle_ids_help"), Kind: addmodal.Text, Wide: true},
		},
		Extra: PushCredentialExtra("site--push-credential--create"),
	}
}

// PushCredentialExtra are a checkbox for each app it can push to, and its secret, pasted in
templ PushCredentialExtra(formID string) {
	<fieldset class="mb-3">
		<legend class="mb-1 text-sm font-medium text-gray-700">{ i18n.T(ctx, "site.settings.push_credentials.apps") }</legend>
		<div class="flex flex-wrap gap-4">
			for _, app := range consts.PushApps {
				<label class="flex items-center gap-2 text-sm">
					@checkbox.Checkbox(checkbox.Props{ID: formID + "--apps--" + string(app), Name: "apps", Value: string(app)})
					{ string(app) }
				</label>
			}
		</div>
		<p class="mt-1 text-xs text-gray-500">{ i18n.T(ctx, "site.settings.push_credentials.apps_help") }</p>
	</fieldset>
	<label for={ formID + "--secret" } class="mb-1 flex items-baseline justify-between text-sm font-medium text-gray-700">
		{ i18n.T(ctx, "site.settings.push_credentials.key") }
		<span class="text-xs font-semibold text-primary">{ i18n.T(ctx, "site.settings.push_credentials.required") }</span>
	</label>
	<textarea id={ formID + "--secret" } name="secret" required rows="6" maxlength="4096" class="w-full rounded-md border border-gray-200 p-2 font-mono text-xs"></textarea>
	<p class="mt-1 text-xs text-gray-500">{ i18n.T(ctx, "site.settings.push_credentials.key_help") }</p>
}

// PushCredentialNew is the modal to add a credential in, putting its row at the top of the table
templ PushCredentialNew() {
	@addmodal.Modal(PushCredentialFormIn(ctx))
}

templ PushCredentialDeleted() {
	@successtoast.Toast(i18n.T(ctx, "site.settings.push_credentials.deleted"))
}
