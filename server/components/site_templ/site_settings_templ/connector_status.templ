package site_settings_templ

import (
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

func count(n *int64) int64 {
	if n == nil {
		return 0
	}
	return *n
}

// ConnectorStatus shows how a saved source has synced: when it last worked and failed, how long it took, how often it
// syncs and why, its last backfill and how far back it went, and its newest events and errors
templ ConnectorStatus(source *sitemodels.Connector, name string) {
	<div id={ "site--settings--" + name + "-connector--status-live" } data-connectors-live>
		@connectorStatus(source, name)
	</div>
}

templ connectorStatus(source *sitemodels.Connector, name string) {
	if source != nil {
		<div id={ "site--settings--" + name + "-connector--status" } class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm">
			<dl class="grid gap-x-4 gap-y-1 sm:grid-cols-2 md:grid-cols-3">
				@connectorStat(name, "last-success", i18n.T(ctx, "site.settings.connector_status.last_worked")) {
					<span title={ formatIdentityDate(ctx, source.LastSuccessfulSync) }>{ display.Ago(source.LastSuccessfulSync, time.Now()) }</span>
				}
				@connectorStat(name, "last-failure", i18n.T(ctx, "site.settings.connector_status.last_failed")) {
					<span title={ formatIdentityDate(ctx, source.LastFailedSync) }>{ display.Ago(source.LastFailedSync, time.Now()) }</span>
				}
				@connectorStat(name, "duration", i18n.T(ctx, "site.settings.connector_status.last_sync_took")) {
					if source.LastSyncDuration != nil {
						{ display.Duration(*source.LastSyncDuration) }
					} else {
						-
					}
				}
				@connectorStat(name, "interval", i18n.T(ctx, "site.settings.connector_status.syncs_every")) {
					{ fmt.Sprintf("%s (%s)", display.Duration(source.SyncIntervalSeconds*1000), display.Name(source.SyncIntervalSecondsReason)) }
				}
				@connectorStat(name, "totals", i18n.T(ctx, "site.settings.connector_status.syncs")) {
					{ i18n.T(ctx, "site.settings.connector_status.worked_failed", i18n.Data{"Worked": count(source.TotalSuccessfulSyncs), "Failed": count(source.TotalFailedSyncs)}) }
					if count(source.ConsecutiveFailedSyncs) > 0 {
						<span class="text-red-700">{ i18n.T(ctx, "site.settings.connector_status.in_a_row", i18n.Data{"Failed": count(source.ConsecutiveFailedSyncs)}) }</span>
					}
				}
				@connectorStat(name, "records", i18n.T(ctx, "site.settings.connector_status.records_pulled_in")) {
					{ fmt.Sprintf("%d", source.TotalRecords) }
				}
				@connectorStat(name, "last-records", i18n.T(ctx, "site.settings.connector_status.last_sync_pulled_in")) {
					if source.LastSyncRecords != nil {
						{ i18n.T(ctx, "site.settings.connector_status.records", i18n.Data{"Records": *source.LastSyncRecords}) }
					} else {
						-
					}
				}
				@connectorStat(name, "backfill", i18n.T(ctx, "site.settings.connector_status.last_backfill")) {
					if source.TotalBackfills == 0 {
						{ i18n.T(ctx, "site.settings.never") }
					} else {
						<span title={ formatIdentityDate(ctx, source.LastBackfillFinishedAt) }>{ display.Ago(source.LastBackfillFinishedAt, time.Now()) }</span>{ i18n.T(ctx, "site.settings.connector_status.backfill_records", i18n.Data{"Records": count(source.LastBackfillRecords), "Duration": display.Duration(count(source.LastBackfillDuration))}) }
						if source.LastBackfillError != nil {
							<span class="text-red-700">: { *source.LastBackfillError }</span>
						}
					}
				}
				@connectorStat(name, "backfilled-to", i18n.T(ctx, "site.settings.connector_status.backfilled_back_to")) {
					if source.TotalBackfills == 0 || source.LastBackfillFrom == nil {
						-
					} else {
						{ formatIdentityDate(ctx, source.LastBackfillFrom) }<span class="text-gray-500">{ " (" + display.Ago(source.LastBackfillFrom, time.Now()) + ")" }</span>
					}
				}
			</dl>
			if len(source.RecentEvents) > 0 || len(source.RecentErrors) > 0 {
				<details id={ "site--settings--" + name + "-connector--history" } class="mt-3">
					<summary class="cursor-pointer text-gray-600">{ i18n.T(ctx, "site.settings.connector_status.recent") }</summary>
					<ul class="mt-2 space-y-1">
						for _, event := range source.RecentEvents {
							<li><span class="text-gray-500">{ display.Ago(&event.StartedAt, time.Now()) }</span> { display.Name(event.Name) }</li>
						}
						for _, syncError := range source.RecentErrors {
							<li class="text-red-700"><span class="text-gray-500">{ display.Ago(&syncError.CreatedAt, time.Now()) }</span> { syncError.Message }</li>
						}
					</ul>
					<p class="mt-2">
						<a class="text-primary underline" href={ templ.SafeURL("/logs/events?search=" + string(source.Type)) }>{ i18n.T(ctx, "site.settings.connector_status.all_events") }</a> ·
						<a class="text-primary underline" href={ templ.SafeURL("/logs/errors?type=connector&search=" + string(source.Type)) }>{ i18n.T(ctx, "site.settings.connector_status.all_errors") }</a>
					</p>
				</details>
			}
		</div>
	}
}

templ connectorStat(name string, stat string, label string) {
	<div>
		<dt class="text-gray-500">{ label }</dt>
		<dd id={ "site--settings--" + name + "-connector--status--" + stat } class="text-gray-900">{ children... }</dd>
	</div>
}
