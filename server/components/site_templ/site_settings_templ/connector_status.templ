package site_settings_templ

import (
	"context"
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/ui/badge"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

func count(n *int64) int64 {
	if n == nil {
		return 0
	}
	return *n
}

// connectorState is a connector's state, its name in words, the badge's colour for it, and whether to say when it
// last synced
func connectorState(ctx context.Context, source *sitemodels.Connector) (string, string, badge.Variant, bool) {
	switch {
	case source == nil:
		return "not_set_up", i18n.T(ctx, "site.settings.connector_state.not_set_up"), badge.VariantNeutral, false
	case !source.Enabled && len(source.PreviousSyncErrors) > 0:
		return "stopped", i18n.T(ctx, "site.settings.connector_state.stopped"), badge.VariantError, false
	case !source.Enabled:
		return "off", i18n.T(ctx, "site.settings.connector_state.off"), badge.VariantNeutral, false
	case count(source.ConsecutiveFailedSyncs) > 0:
		return "failing", i18n.T(ctx, "site.settings.connector_state.failing"), badge.VariantError, source.LastSuccessfulSync != nil
	case source.LastSuccessfulSync == nil:
		return "waiting", i18n.T(ctx, "site.settings.connector_state.waiting"), badge.VariantWarning, false
	}
	return "working", i18n.T(ctx, "site.settings.connector_state.working"), badge.VariantSuccess, true
}

// ConnectorState is a badge beside a connector's title saying, at a glance, whether it is working: not set up, off,
// stopped by a failed first sync, waiting for its first sync, failing or working, with when it last synced. It is kept
// up to date as the status is.
templ ConnectorState(source *sitemodels.Connector, name string) {
	{{ state, label, variant, synced := connectorState(ctx, source) }}
	<span id={ "site--settings--" + name + "-connector--state-live" } data-connectors-live class="ml-2 inline-flex items-center gap-2 align-middle">
		@badge.Badge(badge.Props{ID: "site--settings--" + name + "-connector--state", Variant: variant, Attributes: templ.Attributes{"data-state": state}}) {
			{ label }
		}
		if synced {
			<span id={ "site--settings--" + name + "-connector--state-synced" } class="text-xs font-normal text-gray-500">
				{ i18n.T(ctx, "site.settings.connector_state.synced", i18n.Data{"Ago": display.Ago(ctx, source.LastSuccessfulSync, time.Now())}) }
			</span>
		}
	</span>
}

// ConnectorStatus shows how a saved source has synced: when it last worked and failed, how long it took, how often it
// syncs and why, its last backfill and how far back it went, and its newest events and errors
templ ConnectorStatus(source *sitemodels.Connector, name string) {
	<div id={ "site--settings--" + name + "-connector--status-live" } data-connectors-live>
		@connectorStatus(source, name)
	</div>
}

templ connectorStatus(source *sitemodels.Connector, name string) {
	if source != nil {
		<div id={ "site--settings--" + name + "-connector--status" } class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm">
			<dl class="grid gap-x-4 gap-y-1 sm:grid-cols-2 md:grid-cols-3">
				@connectorStat(name, "last-success", i18n.T(ctx, "site.settings.connector_status.last_worked")) {
					<span title={ formatIdentityDate(ctx, source.LastSuccessfulSync) }>{ display.Ago(ctx, source.LastSuccessfulSync, time.Now()) }</span>
				}
				@connectorStat(name, "last-failure", i18n.T(ctx, "site.settings.connector_status.last_failed")) {
					<span title={ formatIdentityDate(ctx, source.LastFailedSync) }>{ display.Ago(ctx, source.LastFailedSync, time.Now()) }</span>
				}
				@connectorStat(name, "duration", i18n.T(ctx, "site.settings.connector_status.last_sync_took")) {
					if source.LastSyncDuration != nil {
						{ display.Duration(ctx, *source.LastSyncDuration) }
					} else {
						-
					}
				}
				@connectorStat(name, "interval", i18n.T(ctx, "site.settings.connector_status.syncs_every")) {
					{ fmt.Sprintf("%s (%s)", display.Duration(ctx, source.SyncIntervalSeconds*1000), i18n.Stored(ctx, "sync_reasons", source.SyncIntervalSecondsReason)) }
				}
				@connectorStat(name, "totals", i18n.T(ctx, "site.settings.connector_status.syncs")) {
					{ i18n.T(ctx, "site.settings.connector_status.worked_failed", i18n.Data{"Worked": count(source.TotalSuccessfulSyncs), "Failed": count(source.TotalFailedSyncs)}) }
					if count(source.ConsecutiveFailedSyncs) > 0 {
						<span class="text-red-700">{ i18n.T(ctx, "site.settings.connector_status.in_a_row", i18n.Data{"Failed": count(source.ConsecutiveFailedSyncs)}) }</span>
					}
				}
				@connectorStat(name, "records", i18n.T(ctx, "site.settings.connector_status.records_pulled_in")) {
					{ fmt.Sprintf("%d", source.TotalRecords) }
				}
				@connectorStat(name, "last-records", i18n.T(ctx, "site.settings.connector_status.last_sync_pulled_in")) {
					if source.LastSyncRecords != nil {
						{ i18n.T(ctx, "site.settings.connector_status.records", i18n.Data{"Records": *source.LastSyncRecords}) }
					} else {
						-
					}
				}
				@connectorStat(name, "backfill", i18n.T(ctx, "site.settings.connector_status.last_backfill")) {
					if source.TotalBackfills == 0 {
						{ i18n.T(ctx, "site.settings.never") }
					} else {
						<span title={ formatIdentityDate(ctx, source.LastBackfillFinishedAt) }>{ display.Ago(ctx, source.LastBackfillFinishedAt, time.Now()) }</span>{ i18n.T(ctx, "site.settings.connector_status.backfill_records", i18n.Data{"Records": count(source.LastBackfillRecords), "Duration": display.Duration(ctx, count(source.LastBackfillDuration))}) }
						if source.LastBackfillError != nil {
							<span class="text-red-700">: { *source.LastBackfillError }</span>
						}
					}
				}
				@connectorStat(name, "backfilled-to", i18n.T(ctx, "site.settings.connector_status.backfilled_back_to")) {
					if source.TotalBackfills == 0 || source.LastBackfillFrom == nil {
						-
					} else {
						{ formatIdentityDate(ctx, source.LastBackfillFrom) }<span class="text-gray-500">{ " (" + display.Ago(ctx, source.LastBackfillFrom, time.Now()) + ")" }</span>
					}
				}
			</dl>
			if len(source.RecentEvents) > 0 || len(source.RecentErrors) > 0 {
				<details id={ "site--settings--" + name + "-connector--history" } class="mt-3">
					<summary class="cursor-pointer text-gray-600">{ i18n.T(ctx, "site.settings.connector_status.recent") }</summary>
					<ul class="mt-2 space-y-1">
						for _, event := range source.RecentEvents {
							<li><span class="text-gray-500">{ display.Ago(ctx, &event.StartedAt, time.Now()) }</span> { i18n.Stored(ctx, "events", event.Name) }</li>
						}
						for _, syncError := range source.RecentErrors {
							<li class="text-red-700"><span class="text-gray-500">{ display.Ago(ctx, &syncError.CreatedAt, time.Now()) }</span> { syncError.Message }</li>
						}
					</ul>
					<p class="mt-2">
						<a class="text-primary underline" href={ templ.SafeURL("/logs/events?search=" + string(source.Type)) }>{ i18n.T(ctx, "site.settings.connector_status.all_events") }</a> ·
						<a class="text-primary underline" href={ templ.SafeURL("/logs/errors?type=connector&search=" + string(source.Type)) }>{ i18n.T(ctx, "site.settings.connector_status.all_errors") }</a>
					</p>
				</details>
			}
		</div>
	}
}

templ connectorStat(name string, stat string, label string) {
	<div>
		<dt class="text-gray-500">{ label }</dt>
		<dd id={ "site--settings--" + name + "-connector--status--" + stat } class="text-gray-900">{ children... }</dd>
	</div>
}
