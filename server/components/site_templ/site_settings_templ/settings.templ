package site_settings_templ

import (
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/settings"
)

func settingValue(value *string) string {
	if value == nil {
		return ""
	}
	return *value
}

// SettingsPage is "Change Site Settings" for admins or "Change Settings" for the signed in identity.
// A setting left empty follows the level above: the defaults for the site, the site's for an identity.
templ SettingsPage(model *sitemodels.Settings) {
	{{ title, path, inherited, idPrefix := "Change Settings", "/settings/identity", "Site setting", "site--settings--identity--" }}
	{{ description := "Your own settings. Anything left on the site setting follows the site." }}
	if model.ForSite {
		// Each page has its own ids, so moving between them does not carry a typed value across
		{{ title, path, inherited, idPrefix = "Change Site Settings", "/settings/site", "Default", "site--settings--site--" }}
		{{ description = "The settings for everyone on this site. Each user can still change their own." }}
	}
	<div id="settings_page" class="mx-auto max-w-3xl space-y-6">
		<div>
			<h1 class="text-2xl font-bold">{ title }</h1>
			<p class="mt-1 text-gray-500">{ description }</p>
		</div>
		<form
			id="site--settings--form"
			class="space-y-4 rounded-xl border border-gray-200 p-4 shadow-sm"
			hx-post={ path }
			hx-target="#toaster"
			hx-swap="beforeend"
			hx-status:4xx="target:#toaster swap:beforeend"
			hx-status:5xx="target:#toaster swap:beforeend"
		>
			@settingSelect(idPrefix, "units", "Units", inherited, model, model.Units, []string{"mmol/L", "mg/dL"})
			@settingInput(idPrefix, "timezone", "Timezone", inherited, model, model.Timezone)
			@settingInput(idPrefix, "language", "Language", inherited, model, model.Language)
			@settingSelect(idPrefix, "date_format", "Date Format", inherited, model, model.DateFormat, settings.DateFormats)
			@settingSelect(idPrefix, "time_format", "Time Format", inherited, model, model.TimeFormat, settings.TimeFormats)
			@settingSelect(idPrefix, "week_start_day", "Week Starts On", inherited, model, model.WeekStartDay, settings.WeekStartDays)
			<div class="flex justify-end">
				@button.Button(button.Props{ID: "site--settings--save", Type: button.TypeSubmit}) {
					Save
				}
			</div>
		</form>
	</div>
}

templ settingRow(id string, label string) {
	<div class="grid grid-cols-3 items-center gap-4">
		<label for={ id } class="text-sm font-medium">{ label }</label>
		<div class="col-span-2">
			{ children... }
		</div>
	</div>
}

templ settingSelect(idPrefix string, name string, label string, inherited string, model *sitemodels.Settings, value *string, options []string) {
	@settingRow(idPrefix+name, label) {
		<select id={ idPrefix + name } name={ name } class="h-9 w-full rounded-md border border-gray-200 bg-white px-3 text-sm">
			<option value="" selected?={ value == nil }>{ inherited + " (" + model.Inherited[name] + ")" }</option>
			for _, option := range options {
				<option value={ option } selected?={ value != nil && *value == option }>{ option }</option>
			}
		</select>
	}
}

templ settingInput(idPrefix string, name string, label string, inherited string, model *sitemodels.Settings, value *string) {
	@settingRow(idPrefix+name, label) {
		@input.Input(input.Props{
			ID:          idPrefix + name,
			Name:        name,
			Value:       settingValue(value),
			Placeholder: inherited + " (" + model.Inherited[name] + ")",
		})
	}
}

templ SettingsSaved() {
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   "Settings Saved",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}
