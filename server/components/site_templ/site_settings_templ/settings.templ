package site_settings_templ

import (
	"strings"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/settings"
)

func settingValue(value *string) string {
	if value == nil {
		return ""
	}
	return *value
}

// settingsColumn is one level of settings on the page, saved by its own form
type settingsColumn struct {
	Title     string
	Save      string
	Model     *sitemodels.Settings
	IDPrefix  string
	FormID    string
	Path      string
	Inherited string
}

type settingField struct {
	Name    string
	Label   string
	Options []string
}

// settingFields are the settings the page shows, in order; one without options is typed in
var settingFields = []settingField{
	{Name: "units", Label: "Units", Options: []string{"mmol/L", "mg/dL"}},
	{Name: "timezone", Label: "Timezone"},
	{Name: "language", Label: "Language"},
	{Name: "date_format", Label: "Date Format", Options: settings.DateFormats},
	{Name: "time_format", Label: "Time Format", Options: settings.TimeFormats},
	{Name: "week_start_day", Label: "Week Starts On", Options: settings.WeekStartDays},
}

// optionLabel is how a setting's option reads, the week's days capitalised as names are, its value unchanged
func optionLabel(field settingField, option string) string {
	if field.Name == "week_start_day" && option != "" {
		return strings.ToUpper(option[:1]) + option[1:]
	}
	return option
}

func (c settingsColumn) value(name string) *string {
	return map[string]*string{
		"units": c.Model.Units, "timezone": c.Model.Timezone, "language": c.Model.Language,
		"date_format": c.Model.DateFormat, "time_format": c.Model.TimeFormat, "week_start_day": c.Model.WeekStartDay,
	}[name]
}

// settingsColumns are the site's settings for an admin, then the signed in identity's own
func settingsColumns(site *sitemodels.Settings, yours *sitemodels.Settings) []settingsColumn {
	columns := []settingsColumn{}
	if site != nil {
		columns = append(columns, settingsColumn{"Site", "Save Site Settings", site, "site--settings--site--", "site--settings--site-form", "/settings/site", "Default"})
	}
	if yours != nil {
		columns = append(columns, settingsColumn{"Yours", "Save Your Settings", yours, "site--settings--identity--", "site--settings--identity-form", "/settings/identity", "Site setting"})
	}
	return columns
}

// SettingsPage shows the site's settings beside an admin's own, or just the signed in identity's.
// Each column saves with its own form. A setting left empty follows the level above:
// the defaults for the site, the site's for an identity.
templ SettingsPage(site *sitemodels.Settings, yours *sitemodels.Settings) {
	{{ columns := settingsColumns(site, yours) }}
	<div id="settings_page" class="mx-auto max-w-4xl space-y-6">
		@heading.Page("Settings") {
			if site != nil {
				The site's settings are for everyone on this site. Yours change it just for you; anything left on the site setting follows the site.
			} else {
				Your own settings. Anything left on the site setting follows the site.
			}
		}
		for _, column := range columns {
			<form
				id={ column.FormID }
				hx-post={ column.Path }
				hx-target="#toaster"
				hx-swap="beforeend"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
			></form>
		}
		<div class={ "grid items-center gap-4 rounded-xl border border-gray-200 p-4 shadow-sm", templ.KV("grid-cols-[8rem_minmax(0,1fr)_minmax(0,1fr)]", len(columns) == 2), templ.KV("grid-cols-[8rem_minmax(0,1fr)]", len(columns) == 1) }>
			<span></span>
			for _, column := range columns {
				<span class="text-sm font-semibold">{ column.Title }</span>
			}
			for _, field := range settingFields {
				<span class="text-sm font-medium">{ field.Label }</span>
				for _, column := range columns {
					@settingControl(column, field)
				}
			}
			<span></span>
			for _, column := range columns {
				<div class="flex justify-end">
					@button.Button(button.Props{
						ID:         column.IDPrefix + "save",
						Type:       button.TypeSubmit,
						Attributes: templ.Attributes{"form": column.FormID},
					}) {
						{ column.Save }
					}
				</div>
			}
		</div>
	</div>
}

// settingControl is one setting in one column, a select or a text input, belonging to the column's form
templ settingControl(column settingsColumn, field settingField) {
	{{ value, placeholder := column.value(field.Name), column.Inherited + " (" + optionLabel(field, column.Model.Inherited[field.Name]) + ")" }}
	{{ label := field.Label + " (" + column.Title + ")" }}
	if field.Options != nil {
		<select id={ column.IDPrefix + field.Name } name={ field.Name } form={ column.FormID } aria-label={ label } class="h-9 w-full rounded-md border border-gray-200 bg-white px-3 text-sm">
			<option value="" selected?={ value == nil }>{ placeholder }</option>
			for _, option := range field.Options {
				<option value={ option } selected?={ value != nil && *value == option }>{ optionLabel(field, option) }</option>
			}
		</select>
	} else {
		@input.Input(input.Props{
			ID:          column.IDPrefix + field.Name,
			Name:        field.Name,
			Value:       settingValue(value),
			Placeholder: placeholder,
			Attributes:  templ.Attributes{"form": column.FormID, "aria-label": label},
		})
	}
}

templ SettingsSaved() {
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   "Settings Saved",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}
