package site_settings_templ

import (
	"fmt"
	"time"

	"nighttroop.t1d.nz/data/sql/controldb"
	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/site_templ/site_login_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

// MyAccount is the signed in identity's, or control admin's, own page at path: who it is, and up to most passkeys it
// adds, on its own address, and removes. A site identity's, with guide, also opens the guide to setting the site up.
templ MyAccount(name, role string, passkeys []*controldb.Passkey, most int, path string, guide bool) {
	<div id="site--account" class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "site.settings.account.title")) {
			{ i18n.T(ctx, "site.settings.account.about", i18n.Data{"Name": name, "Role": role}) }
		}
		if guide {
			@card.Card(card.Props{ID: "site--account--getting-started", Title: i18n.T(ctx, "site.settings.account.getting_started"),
				Note:   i18n.T(ctx, "site.settings.account.getting_started_note"),
				Action: labelled(i18n.T(ctx, "site.settings.account.open_guide"), button.Props{ID: "site--getting-started-button", Variant: button.VariantOutline, Size: button.SizeSm,
					Attributes: nav.Attributes("/getting-started")})})
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "site.settings.account.passkeys"), Action: labelled(i18n.T(ctx, "site.settings.account.add_passkey"), button.Props{ID: "site--account--add-passkey", Type: button.TypeButton, Size: button.SizeSm,
			Disabled: len(passkeys) >= most, Attributes: templ.Attributes{"data-passkey-begin": path + "/passkeys/begin", "data-passkey-finish": path + "/passkeys/finish",
				"data-passkey-error": "site--account--passkey-error"}})}) {
			<p id="site--account--passkey-error" class="text-sm text-red-600"></p>
			@table.Table(table.Props{ID: "site--account--passkeys"}) {
				@table.Body() {
					if len(passkeys) == 0 {
						<tr><td class="p-4 text-sm text-gray-500">{ i18n.T(ctx, "site.settings.account.no_passkeys") }</td></tr>
					}
					for _, passkey := range passkeys {
						@table.Row() {
							@table.Cell() {
								{ i18n.T(ctx, "site.settings.account.added") } <span title={ site_data_templ.FormatDate(ctx, passkey.CreatedAt) }>{ display.RoundedAgo(passkey.CreatedAt, time.Now()) }</span>
							}
							@table.Cell(table.CellProps{Class: "text-gray-500"}) {
								if passkey.LastUsedAt != nil {
									{ i18n.T(ctx, "site.settings.account.last_used", i18n.Data{"Ago": display.RoundedAgo(*passkey.LastUsedAt, time.Now())}) }
								} else {
									{ i18n.T(ctx, "site.settings.account.not_used") }
								}
							}
							@table.Cell(table.CellProps{Class: "text-right"}) {
								@button.Button(button.Props{ID: fmt.Sprintf("site--account--remove-passkey-%d", passkey.ID), Variant: button.VariantOutline, Size: button.SizeSm,
									Attributes: templ.Attributes{"hx-delete": fmt.Sprintf("%s/passkeys/%d", path, passkey.ID), "hx-target": "#site--account",
										"hx-swap": "outerHTML", "hx-confirm": i18n.T(ctx, "site.settings.account.remove_confirm"),
										"data-confirm-delete": i18n.T(ctx, "site.settings.account.remove")}}) {
									{ i18n.T(ctx, "site.settings.account.remove") }
								}
							}
						}
					}
				}
			}
		}
		@site_login_templ.PasskeyScript()
	</div>
}

// labelled is a button of a card's action, as its text
templ labelled(text string, p button.Props) {
	@button.Button(p) {
		{ text }
	}
}
