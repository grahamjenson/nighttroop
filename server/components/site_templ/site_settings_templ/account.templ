package site_settings_templ

import (
	"fmt"
	"time"

	"nighttroop.t1d.nz/data/sql/controldb"
	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/field"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/site_templ/site_login_templ"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/badge"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/i18n"
)

// MyAccount is the signed in identity's, or control admin's, own page at path: who it is, and up to most passkeys it
// adds, on its own address, and removes. A site identity's, with guide, also opens the guide to setting the site up.
// SiteEmail is the email a site's admin gave the site, "" for none, and whether they have verified it
type SiteEmail struct {
	Email    string `json:"email"`
	Verified bool   `json:"verified"`
}

// MyAccount also has, with an email, the card a site's admin gives the site's email on.
templ MyAccount(name, role string, passkeys []*controldb.Passkey, most int, path string, guide bool, email *SiteEmail) {
	<div id="site--account" class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "site.settings.account.title")) {
			{ i18n.T(ctx, "site.settings.account.about", i18n.Data{"Name": name, "Role": role}) }
		}
		if guide {
			@card.Card(card.Props{ID: "site--account--getting-started", Title: i18n.T(ctx, "site.settings.account.getting_started"),
				Note:   i18n.T(ctx, "site.settings.account.getting_started_note"),
				Action: labelled(i18n.T(ctx, "site.settings.account.open_guide"), button.Props{ID: "site--getting-started-button", Variant: button.VariantOutline, Size: button.SizeSm,
					Attributes: nav.Attributes("/getting-started")})})
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "site.settings.account.passkeys"), Action: labelled(i18n.T(ctx, "site.settings.account.add_passkey"), button.Props{ID: "site--account--add-passkey", Type: button.TypeButton, Size: button.SizeSm,
			Disabled: len(passkeys) >= most, Attributes: templ.Attributes{"data-passkey-begin": path + "/passkeys/begin", "data-passkey-finish": path + "/passkeys/finish",
				"data-passkey-error": "site--account--passkey-error"}})}) {
			<p id="site--account--passkey-error" class="text-sm text-red-600"></p>
			@table.Table(table.Props{ID: "site--account--passkeys"}) {
				@table.Body() {
					if len(passkeys) == 0 {
						@table.Empty("", 1, i18n.T(ctx, "site.settings.account.no_passkeys"))
					}
					for _, passkey := range passkeys {
						@table.Row() {
							@table.Cell() {
								{ i18n.T(ctx, "site.settings.account.added") } <span title={ site_data_templ.FormatDate(ctx, passkey.CreatedAt) }>{ display.RoundedAgo(ctx, passkey.CreatedAt, time.Now()) }</span>
							}
							@table.Cell(table.CellProps{Class: "text-gray-500"}) {
								if passkey.LastUsedAt != nil {
									{ i18n.T(ctx, "site.settings.account.last_used", i18n.Data{"Ago": display.RoundedAgo(ctx, *passkey.LastUsedAt, time.Now())}) }
								} else {
									{ i18n.T(ctx, "site.settings.account.not_used") }
								}
							}
							@table.Cell(table.CellProps{Class: "text-right"}) {
								@button.Button(button.Props{ID: fmt.Sprintf("site--account--remove-passkey-%d", passkey.ID), Variant: button.VariantOutline, Size: button.SizeSm,
									Attributes: templ.Attributes{"hx-delete": fmt.Sprintf("%s/passkeys/%d", path, passkey.ID), "hx-target": "#site--account",
										"hx-swap": "outerHTML", "hx-confirm": i18n.T(ctx, "site.settings.account.remove_confirm"),
										"data-confirm-delete": i18n.T(ctx, "site.settings.account.remove")}}) {
									{ i18n.T(ctx, "site.settings.account.remove") }
								}
							}
						}
					}
				}
			}
		}
		if email != nil {
			@EmailCard(email)
		}
		@site_login_templ.PasskeyScript()
	</div>
}

// EmailCard is the site's email: the one given, whether it is verified, a form to give or change it, and a button to
// remove it. Saving one sends it a link, and the card swaps itself for the answer.
templ EmailCard(email *SiteEmail) {
	<div id="site--account--email">
		@card.Card(card.Props{Title: i18n.T(ctx, "site.settings.account.email.title"), Note: i18n.T(ctx, "site.settings.account.email.note")}) {
			if email.Email != "" {
				<p class="mb-3 text-sm">
					<span id="site--account--email-current" class="font-medium">{ email.Email }</span>
					if email.Verified {
						@badge.Badge(badge.Props{ID: "site--account--email-verified", Variant: badge.VariantSuccess, Class: "ml-2"}) {
							{ i18n.T(ctx, "site.settings.account.email.verified") }
						}
					} else {
						@badge.Badge(badge.Props{ID: "site--account--email-not-verified", Variant: badge.VariantWarning, Class: "ml-2"}) {
							{ i18n.T(ctx, "site.settings.account.email.not_verified") }
						}
					}
				</p>
			}
			<form
				class="flex flex-wrap items-end gap-2"
				hx-post="/settings/account/email"
				hx-target="#site--account--email"
				hx-swap="outerHTML"
				hx-status:4xx="target:#toaster swap:beforeend"
				hx-status:5xx="target:#toaster swap:beforeend"
			>
				@field.Field("site--account--email-input", i18n.T(ctx, "site.settings.account.email.label"), "w-72") {
					@input.Input(input.Props{ID: "site--account--email-input", Name: "email", Type: input.TypeEmail, Required: true,
						Attributes: templ.Attributes{"maxlength": "254", "autocomplete": "email"}})
				}
				@button.Button(button.Props{ID: "site--account--email-save", Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ i18n.T(ctx, "site.settings.account.email.save") }
				}
				if email.Email != "" {
					@button.Button(button.Props{ID: "site--account--email-remove", Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm,
						Attributes: templ.Attributes{"hx-delete": "/settings/account/email", "hx-target": "#site--account--email", "hx-swap": "outerHTML",
							"hx-confirm": i18n.T(ctx, "site.settings.account.email.remove_confirm"), "data-confirm-delete": i18n.T(ctx, "site.settings.account.remove")}}) {
						{ i18n.T(ctx, "site.settings.account.remove") }
					}
				}
			</form>
		}
	</div>
}

// EmailSaved is the card with the email just given, and that its link was sent
templ EmailSaved(email *SiteEmail) {
	@EmailCard(email)
	@successtoast.OOB(i18n.T(ctx, "site.settings.account.email.sent"))
}

// EmailRemoved is the card with no email, and that it was removed
templ EmailRemoved(email *SiteEmail) {
	@EmailCard(email)
	@successtoast.OOB(i18n.T(ctx, "site.settings.account.email.removed"))
}

// labelled is a button of a card's action, as its text
templ labelled(text string, p button.Props) {
	@button.Button(p) {
		{ text }
	}
}
