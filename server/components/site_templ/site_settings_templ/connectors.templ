templ NightscoutConnectorForm(nightscoutConnectorSettings *sitemodels.Connector) {
	@splitNightscoutURL()
	<form
		hx-post="/settings/connectors/nightscout"
		{ enableOnFirstInput(nightscoutConnectorSettings)... }
		hx-target="#toaster"
		hx-swap="beforeend"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		class="mt-4"
	>
		<div class="rounded-xl border border-gray-200 shadow-sm">
			<div class="p-6">
				<!-- Header -->
				<div class="mb-4 flex items-center justify-between">
					<div>
						<h2 class="text-lg font-semibold">
							Nightscout Connector
						</h2>
						<div class="text-sm text-gray-500">
							Connect your Nightscout instance
						</div>
					</div>
					@form.Item(form.ItemProps{
						Class: "flex items-start gap-2 justify-center",
					}) {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "site--settings--nightscout-connector--enable",
							Name:    "enabled",
							Checked: nightscoutConnectorSettings.IsEnabled(),
							Class:   "h-4 w-4 rounded border-gray-600 bg-white",
						})
						@form.Label(form.LabelProps{
							For:   "site--settings--nightscout-connector--enable",
							Class: "item-center flex cursor-pointer gap-2",
						}) {
							Enable Connector
						}
					}
				</div>
				@ConnectorErrors(nightscoutConnectorSettings, "nightscout")
				<!-- Fields -->
				<div id="ns-fields" class="grid gap-4 md:grid-cols-12">
					<!-- URL -->
					<div class="md:col-span-7">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "site--settings--nightscout-connector--url",
							}) {
								Nightscout URL
							}
							@input.Input(input.Props{
								ID:          "site--settings--nightscout-connector--url",
								Type:        "url",
								Name:        "url_or_username",
								Placeholder: "https://your-nightscout.herokuapp.com",

								Required: true,
								Value:    nightscoutConnectorSettings.GetURL(),
								// The browser reads the pattern with the v flag, which needs the / in its class escaped, or drops it
								Attributes: templ.Attributes{
									"autocomplete":   "new-password",
									"autocapitalize": "none",
									"spellcheck":     "false",
									"pattern":        "https?://[^\\/]+",
									"onchange":       templ.JSUnsafeFuncCall("splitNightscoutURL(this)"),
									"onpaste":        templ.JSUnsafeFuncCall("setTimeout(() => splitNightscoutURL(this))"),
								},
							})
							@form.Description() {
								Base URL only. Paste a link with its token, such as .../api/v1?token=..., and it is split into the URL and token
							}
						}
					</div>
					<!-- API Secret -->
					<div class="md:col-span-5">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "site--settings--nightscout-connector--password",
							}) {
								API Secret or Token
							}
							@input.Input(input.Props{
								ID:       "site--settings--nightscout-connector--password",
								Type:     "password",
								Name:     "password",
								Required: true,
								Value:    nightscoutConnectorSettings.GetPasswordGarbage(),
								Attributes: templ.Attributes{
									"onmousedown":               templ.JSUnsafeFuncCall("event.preventDefault(); this.select();"),
									"data-placeholder-password": "true",
									"autocomplete":              "new-password",
								},
							})
						}
					</div>
				</div>
				<!-- Footer -->
				<div class="mt-6 flex flex-col gap-3 border-t border-gray-100 pt-4 md:flex-row md:items-center md:justify-between">
					@button.Button(button.Props{
						ID:      "site--settings--nightscout-connector--delete",
						Type:    "button",
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-include": "none",
							"hx-delete":  "/settings/connectors/nightscout",
							"hx-confirm": "Are you sure you want to delete this Nightscout connector?",
							"hx-target":  "closest form",
							"hx-swap":    "outerHTML",
						},
					}) {
						Delete
					}
					<div class="flex gap-3">
						@BackfillButton("nightscout")
						@button.Button(button.Props{
							ID:   "site--settings--nightscout-connector--submit",
							Type: button.TypeSubmit,
						}) {
							Save
						}
					</div>
				</div>
				@ConnectorStatus(nightscoutConnectorSettings, "nightscout")
			</div>
		</div>
	</form>
}

var splitNightscoutURLOnce = templ.NewOnceHandle()

// splitNightscoutURL turns a pasted Nightscout link, such as https://site/api/v1?token=..., ?api_secret=... or
// https://secret@site/api/v1, into its base URL, and puts the token or API secret it carries in the secret's box
templ splitNightscoutURL() {
	@splitNightscoutURLOnce.Once() {
		<script>
			function splitNightscoutURL(input) {
				let url;
				try { url = new URL(input.value.trim()); } catch { return; }
				if (url.protocol !== "http:" && url.protocol !== "https:") return;
				const q = url.searchParams;
				const secret = q.get("token") || q.get("api_secret") || q.get("api-secret") || q.get("secret") || decodeURIComponent(url.username);
				input.value = url.origin;
				if (secret) document.getElementById("site--settings--nightscout-connector--password").value = secret;
			}
		</script>
	}
}

