// BackfillButton asks to fetch the named source's older records, saying what it will fetch; it is disabled while its
// request is sent, and the server starts only one backfill at a time
templ BackfillButton(name string) {
	@button.Button(button.Props{
		ID:      "site--settings--" + name + "-connector--backfill",
		Type:    "button",
		Variant: button.VariantOutline,
		Attributes: templ.Attributes{
			"hx-include":      "none",
			"hx-post":         "/settings/connectors/" + name + "/backfill",
			"hx-confirm":      backfillConfirm(name),
			"hx-disabled-elt": "this",
			"hx-sync":         "this:drop",
			"hx-target":       "#toaster",
			"hx-swap":         "beforeend",
			"hx-status:4xx":   "target:#toaster swap:beforeend",
			"hx-status:5xx":   "target:#toaster swap:beforeend",
		},
	}) {
		Backfill
	}
}

func backfillConfirm(name string) string {
	switch name {
	case string(consts.ConnectorTypeDexcom):
		return "Backfill fetches the last 24 hours of readings, which is as far back as Dexcom Share goes. It runs in the background. Continue?"
	case string(consts.ConnectorTypeLibre):
		return "Backfill fetches the last 12 hours of readings, which is as far back as LibreLinkUp goes. It runs in the background. Continue?"
	}
	return "Backfill fetches older records from before your oldest glucose reading, a week of them by default. It runs in the background and can take a minute. Continue?"
}

// BackfillQueued says which records a backfill that has just started will fetch
templ BackfillQueued(sourceType consts.ConnectorType, from int64, to int64) {
	@toast.Toast(toast.Props{
		Title:         "Backfilling " + strings.ToUpper(string(sourceType)[:1]) + string(sourceType)[1:],
		Description:   "Fetching records from " + time.UnixMilli(from).UTC().Format("2 Jan 15:04") + " to " + time.UnixMilli(to).UTC().Format("2 Jan 15:04") + " UTC",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      8000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}

templ SuccessfulUpdate(model *sitemodels.Connector) {
	@successtoast.Toast("Connector Updated")
}

// ConnectorDeleted replaces the deleted source's form with an empty one and shows a toast
templ ConnectorDeleted(sourceType consts.ConnectorType) {
	switch sourceType {
		case consts.ConnectorTypeNightscout:
			@NightscoutConnectorForm(nil)
		case consts.ConnectorTypeDexcom:
			@DexcomConnectorForm(nil)
		case consts.ConnectorTypeLibre:
			@LibreConnectorForm(nil)
		case consts.ConnectorTypeVirtual:
			@VirtualConnectorForm(nil)
	}
	<div hx-swap-oob="beforeend:#toaster">
		@SuccessfulDelete()
	</div>
}

templ SuccessfulDelete() {
	@successtoast.Toast("Connector Deleted")
}
