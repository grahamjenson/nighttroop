package site_settings_templ

import (
	"github.com/templui/templui/components/checkbox"
	"nighttroop.t1d.nz/server/components/site_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/utils/httputils"
)

templ SyncSettings(siteContext *httputils.SiteContext, ns_url string, ns_password_garbage string, ns_enabled bool, ns_id *int64,
	dex_username string, dex_password_garbage string, dex_usa_region bool, dex_enabled bool, dex_id *int64) {
	@site_templ.UserBase(siteContext) {
		@SyncSettingsForm(ns_url, ns_password_garbage, ns_enabled, ns_id, dex_username, dex_password_garbage, dex_usa_region, dex_enabled, dex_id)
	}
}

templ SyncSettingsForm(ns_url string, ns_password_garbage string, ns_enabled bool, ns_id *int64,
	dex_username string, dex_password_garbage string, dex_usa_region bool, dex_enabled bool, dex_id *int64) {
	<div id="mainForm" class="border-0">
		<div class="mb-3 border-bottom pb-2">
			<h3 class="mb-1 font-bold">Sync Settings</h3>
			<div class="small">
				Configure places NightTroop syncs data from.
			</div>
		</div>
		<!-- NIGHTSCOUT -->
		@NightscoutSyncForm(ns_url, ns_password_garbage, ns_enabled, ns_id)
		<!-- DEXCOM -->
		@DexcomSyncForm(dex_username, dex_password_garbage, dex_usa_region, dex_enabled, dex_id)
		<div id="feedback" class="mb-3"></div>
	</div>
}

templ DexcomSyncForm(dex_username string, dex_password_garbage string, dex_usa_region bool, dex_enabled bool, dex_id *int64) {
	<form hx-post="/sync_settings/dexcom" hx-target="#feedback" class="mt-4">
		<div class="rounded-lg border border-gray-900 shadow-sm">
			<div class="p-6">
				<!-- Header -->
				<div class="mb-4 flex items-center justify-between">
					<div>
						<h5 class="font-semibold ">
							Dexcom Share Sync
						</h5>
						<div class="text-sm text-gray-400">
							Connect your Dexcom Account
						</div>
					</div>
					@form.Item(form.ItemProps{
						Class: "flex items-start gap-2 justify-center",
					}) {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "dexcomSync",
							Name:    "dex_enabled",
							Checked: dex_enabled,
							Class:   "h-4 w-4 rounded border-gray-600 bg-white",
						})
						@form.Label(form.LabelProps{
							For:   "dexcomSync",
							Class: "item-center flex cursor-pointer gap-2",
						}) {
							Enable Sync
						}
					}
				</div>
				<!-- Fields -->
				<div id="dex-fields" class="grid gap-4 md:grid-cols-12">
					<!-- Username -->
					<div class="md:col-span-5">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "dex_username",
							}) {
								Dexcom Username
							}
							@input.Input(input.Props{
								Type:  "text",
								Name:  "dex_username",
								Value: dex_username,
								Attributes: templ.Attributes{
									"autocomplete":   "new-password",
									"autocapitalize": "none",
									"spellcheck":     "false",
								},
							})
						}
					</div>
					<!-- Password -->
					<div class="md:col-span-4">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "dex_password",
							}) {
								Dexcom Password
							}
							@input.Input(input.Props{
								Type:  "password",
								Name:  "dex_password",
								Value: dex_password_garbage,
								Attributes: templ.Attributes{
									"onmousedown":               "event.preventDefault(); this.select();",
									"data-placeholder-password": "true",
									"autocomplete":              "new-password",
								},
							})
						}
					</div>
					<!-- Region -->
					<div class="md:col-span-3">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "dex_region",
							}) {
								Dexcom Region
							}
							<div class="flex items-center gap-3 rounded-md border border-gray-300 px-3 py-2 bg-gray-100">
								@checkbox.Checkbox(checkbox.Props{
									ID:      "dex_region",
									Name:    "dex_region",
									Checked: dex_usa_region,
									Class:   "h-4 w-4 rounded border-gray-600 bg-white",
								})
								@form.Label(form.LabelProps{
									For: "dex_region",
								}) {
									USA
								}
							</div>
						}
					</div>
				</div>
				<!-- Footer Actions -->
				<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-4 md:flex-row md:items-center md:justify-between">
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-include": "none",
							"hx-delete":  "/sync_settings/DEXCOM",
							"hx-confirm": "Are you sure you want to delete this Dexcom sync source?",
							"hx-target":  "#mainForm",
							"hx-swap":    "innerHTML",
						},
					}) {
						Delete
					}
					@button.Button(button.Props{
						Type: button.TypeSubmit,
					}) {
						Save
					}
				</div>
			</div>
		</div>
	</form>
}

templ NightscoutSyncForm(ns_url string, ns_password_garbage string, ns_enabled bool, ns_id *int64) {
	<form hx-post="/sync_settings/nightscout" hx-target="#feedback" class="mt-4">
		<div class="rounded-lg border border-gray-900 shadow-sm">
			<div class="p-6">
				<!-- Header -->
				<div class="mb-4 flex items-center justify-between">
					<div>
						<h5 class="font-semibold ">
							Nightscout Sync
						</h5>
						<div class="text-sm text-gray-400">
							Connect your Nightscout instance
						</div>
					</div>
					@form.Item(form.ItemProps{
						Class: "flex items-start gap-2 justify-center",
					}) {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "nightscoutSync",
							Name:    "ns_enabled",
							Checked: ns_enabled,
							Class:   "h-4 w-4 rounded border-gray-600 bg-white",
						})
						@form.Label(form.LabelProps{
							For:   "nightscoutSync",
							Class: "item-center flex cursor-pointer gap-2",
						}) {
							Enable Sync
						}
					}
				</div>
				<!-- Fields -->
				<div id="ns-fields" class="grid gap-4 md:grid-cols-12">
					<!-- URL -->
					<div class="md:col-span-7">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "ns_url",
							}) {
								Nightscout URL
							}
							@input.Input(input.Props{
								Type:        "url",
								Name:        "ns_url",
								Placeholder: "https://your-nightscout.herokuapp.com",

								Required: true,
								Value:    ns_url,
								Attributes: templ.Attributes{
									"autocomplete":   "new-password",
									"autocapitalize": "none",
									"spellcheck":     "false",
									"pattern":        "https?://[^/]+",
								},
							})
							@form.Description() {
								Base URL only (no path or trailing slash)
							}
						}
					</div>
					<!-- API Secret -->
					<div class="md:col-span-5">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "ns_password",
							}) {
								API Secret
							}
							@input.Input(input.Props{
								Type:     "password",
								Name:     "ns_password",
								Required: true,
								Value:    ns_password_garbage,
								Attributes: templ.Attributes{
									"onmousedown":               "event.preventDefault(); this.select();",
									"data-placeholder-password": "true",
									"autocomplete":              "new-password",
								},
							})
						}
					</div>
				</div>
				<!-- Footer -->
				<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-4 md:flex-row md:items-center md:justify-between">
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-include": "none",
							"hx-delete":  "/sync_settings/NIGHTSCOUT",
							"hx-confirm": "Are you sure you want to delete this Nightscout sync source?",
							"hx-target":  "#mainForm",
							"hx-swap":    "innerHTML",
						},
					}) {
						Delete
					}
					@button.Button(button.Props{
						Type: button.TypeSubmit,
					}) {
						Save
					}
				</div>
			</div>
		</div>
	</form>
}
