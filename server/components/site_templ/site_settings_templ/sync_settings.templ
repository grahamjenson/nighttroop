templ SuccessfulUpdate(model *nighttroop.SiteSyncSource) {
	<div class="rounded-lg border border-green-500 bg-green-100 p-4">
		<div class="text-green-800">
			Settings updated { model.Type } successfully.
		</div>
	</div>
}
