package site_settings_templ

import (
	"github.com/templui/templui/components/checkbox"
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/site_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/consts"
)

func findSyncSource(
	syncSettings []*sitemodels.SyncSource,
	sourceType consts.SyncSourceType,
) *sitemodels.SyncSource {
	for _, ss := range syncSettings {
		if ss.Type == sourceType {
			return ss
		}
	}
	return nil
}

templ SyncSettingsFull(syncSettings []*sitemodels.SyncSource) {
	@site_templ.SiteBase() {
		@SyncSettingsPartial(syncSettings)
	}
}

templ SyncSettingsPartial(syncSettings []*sitemodels.SyncSource) {
	<div id="mainForm" class="border-0">
		<div class="mb-3 border-bottom pb-2">
			<h3 class="mb-1 font-bold">Sync Settings</h3>
			<div class="small">
				Configure places NightTroop syncs data from.
			</div>
		</div>
		@NightscoutSyncForm(findSyncSource(syncSettings, consts.SyncSourceTypeNightscout))
		@DexcomSyncForm(findSyncSource(syncSettings, consts.SyncSourceTypeDexcom))
		@VirtualSyncForm(findSyncSource(syncSettings, consts.SyncSourceTypeVirtual))
	</div>
}

templ DexcomSyncForm(dexcomSyncSettings *sitemodels.SyncSource) {
	<form
		hx-post="/settings/sync/dexcom"
		hx-target="#toaster"
		hx-swap="beforeend"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		class="mt-4"
	>
		<div class="rounded-lg border border-gray-900 shadow-sm">
			<div class="p-6">
				<!-- Header -->
				<div class="mb-4 flex items-center justify-between">
					<div>
						<h5 class="font-semibold ">
							Dexcom Share Sync
						</h5>
						<div class="text-sm text-gray-400">
							Connect your Dexcom Account
						</div>
					</div>
					@form.Item(form.ItemProps{
						Class: "flex items-start gap-2 justify-center",
					}) {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "dexcomSync",
							Name:    "enabled",
							Checked: dexcomSyncSettings.IsEnabled(),
							Class:   "h-4 w-4 rounded border-gray-600 bg-white",
						})
						@form.Label(form.LabelProps{
							For:   "dexcomSync",
							Class: "item-center flex cursor-pointer gap-2",
						}) {
							Enable Dexcom
						}
					}
				</div>
				<!-- Fields -->
				<div id="dex-fields" class="grid gap-4 md:grid-cols-12">
					<!-- Username -->
					<div class="md:col-span-5">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "dex_url_or_username",
							}) {
								Dexcom Username
							}
							@input.Input(input.Props{
								ID:       "dex_url_or_username",
								Type:     "text",
								Name:     "url_or_username",
								Required: true,
								Value:    dexcomSyncSettings.GetUsername(),
								Attributes: templ.Attributes{
									"autocomplete":   "new-password",
									"autocapitalize": "none",
									"spellcheck":     "false",
								},
							})
						}
					</div>
					<!-- Password -->
					<div class="md:col-span-4">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "dex_password",
							}) {
								Dexcom Password
							}
							@input.Input(input.Props{
								ID:       "dex_password",
								Type:     "password",
								Name:     "password",
								Required: true,
								Value:    dexcomSyncSettings.GetPasswordGarbage(),
								Attributes: templ.Attributes{
									"onmousedown":               "event.preventDefault(); this.select();",
									"data-placeholder-password": "true",
									"autocomplete":              "new-password",
								},
							})
						}
					</div>
					<!-- Region -->
					<div class="md:col-span-3">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "dex_region",
							}) {
								Dexcom Region
							}
							<div class="flex items-center gap-3 rounded-md border border-gray-300 px-3 py-2 bg-gray-100">
								@checkbox.Checkbox(checkbox.Props{
									ID:      "dex_region",
									Name:    "region",
									Value:   "US",
									Checked: dexcomSyncSettings.IsUSARegion(),
									Class:   "h-4 w-4 rounded border-gray-600 bg-white",
								})
								<!-- first region value wins, so unchecked falls through to OUS -->
								<input type="hidden" name="region" value="OUS"/>
								@form.Label(form.LabelProps{
									For: "dex_region",
								}) {
									USA
								}
							</div>
						}
					</div>
				</div>
				<!-- Footer Actions -->
				<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-4 md:flex-row md:items-center md:justify-between">
					@button.Button(button.Props{
						Type:    "button",
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-include": "none",
							"hx-delete":  "/settings/sync/dexcom",
							"hx-confirm": "Are you sure you want to delete this Dexcom sync source?",
							"hx-target":  "#mainForm",
							"hx-swap":    "innerHTML",
						},
					}) {
						Delete
					}
					@button.Button(button.Props{
						Type: button.TypeSubmit,
					}) {
						Save
					}
				</div>
			</div>
		</div>
	</form>
}

templ NightscoutSyncForm(nightscoutSyncSettings *sitemodels.SyncSource) {
	<form
		hx-post="/settings/sync/nightscout"
		hx-target="#toaster"
		hx-swap="beforeend"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		class="mt-4"
	>
		<div class="rounded-lg border border-gray-900 shadow-sm">
			<div class="p-6">
				<!-- Header -->
				<div class="mb-4 flex items-center justify-between">
					<div>
						<h5 class="font-semibold ">
							Nightscout Sync
						</h5>
						<div class="text-sm text-gray-400">
							Connect your Nightscout instance
						</div>
					</div>
					@form.Item(form.ItemProps{
						Class: "flex items-start gap-2 justify-center",
					}) {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "site--settings--nightscout-sync--enable",
							Name:    "enabled",
							Checked: nightscoutSyncSettings.IsEnabled(),
							Class:   "h-4 w-4 rounded border-gray-600 bg-white",
						})
						@form.Label(form.LabelProps{
							For:   "site--settings--nightscout-sync--enable",
							Class: "item-center flex cursor-pointer gap-2",
						}) {
							Enable Sync
						}
					}
				</div>
				<!-- Fields -->
				<div id="ns-fields" class="grid gap-4 md:grid-cols-12">
					<!-- URL -->
					<div class="md:col-span-7">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "url_or_username",
							}) {
								Nightscout URL
							}
							@input.Input(input.Props{
								ID:          "site--settings--nightscout-sync--url",
								Type:        "url",
								Name:        "url_or_username",
								Placeholder: "https://your-nightscout.herokuapp.com",

								Required: true,
								Value:    nightscoutSyncSettings.GetURL(),
								Attributes: templ.Attributes{
									"autocomplete":   "new-password",
									"autocapitalize": "none",
									"spellcheck":     "false",
									"pattern":        "https?://[^/]+",
								},
							})
							@form.Description() {
								Base URL only (no path or trailing slash)
							}
						}
					</div>
					<!-- API Secret -->
					<div class="md:col-span-5">
						@form.Item(form.ItemProps{}) {
							@form.Label(form.LabelProps{
								For: "password",
							}) {
								API Secret
							}
							@input.Input(input.Props{
								ID:       "site--settings--nightscout-sync--password",
								Type:     "password",
								Name:     "password",
								Required: true,
								Value:    nightscoutSyncSettings.GetPasswordGarbage(),
								Attributes: templ.Attributes{
									"onmousedown":               "event.preventDefault(); this.select();",
									"data-placeholder-password": "true",
									"autocomplete":              "new-password",
								},
							})
						}
					</div>
				</div>
				<!-- Footer -->
				<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-4 md:flex-row md:items-center md:justify-between">
					@button.Button(button.Props{
						ID:      "site--settings--nightscout-sync--delete",
						Type:    "button",
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-include": "none",
							"hx-delete":  "/settings/sync/nightscout",
							"hx-confirm": "Are you sure you want to delete this Nightscout sync source?",
							"hx-target":  "#mainForm",
							"hx-swap":    "innerHTML",
						},
					}) {
						Delete
					}
					@button.Button(button.Props{
						ID:   "site--settings--nightscout-sync--submit",
						Type: button.TypeSubmit,
					}) {
						Save
					}
				</div>
			</div>
		</div>
	</form>
}

templ VirtualSyncForm(synSource *sitemodels.SyncSource) {
	<form
		hx-post="/settings/sync/virtual"
		hx-target="#toaster"
		hx-swap="beforeend"
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		class="mt-4"
	>
		<div class="rounded-lg border border-gray-900 shadow-sm">
			<div class="p-6">
				<!-- Header -->
				<div class="mb-4 flex items-center justify-between">
					<div>
						<h5 class="font-semibold ">
							Virtual Sync
						</h5>
						<div class="text-sm text-gray-400">
							This will create fake data for testing purposes.
						</div>
					</div>
					@form.Item(form.ItemProps{
						Class: "flex items-start gap-2 justify-center",
					}) {
						@checkbox.Checkbox(checkbox.Props{
							ID:      "site--settings--virtual-sync--enable",
							Name:    "enabled",
							Checked: synSource.IsEnabled(),
							Class:   "h-4 w-4 rounded border-gray-600 bg-white",
						})
						@form.Label(form.LabelProps{
							For:   "site--settings--virtual-sync--enable",
							Class: "item-center flex cursor-pointer gap-2",
						}) {
							Enable Sync
						}
					}
				</div>
				<!-- Footer -->
				<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-4 md:flex-row md:items-center md:justify-between">
					@button.Button(button.Props{
						ID:      "site--settings--virtual-sync--delete",
						Type:    "button",
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-include": "none",
							"hx-delete":  "/settings/sync/virtual",
							"hx-confirm": "Are you sure you want to delete this Virtual sync source?",
							"hx-target":  "#mainForm",
							"hx-swap":    "innerHTML",
						},
					}) {
						Delete
					}
					@button.Button(button.Props{
						ID:   "site--settings--virtual-sync--submit",
						Type: button.TypeSubmit,
					}) {
						Save
					}
				</div>
			</div>
		</div>
	</form>
}

templ SuccessfulUpdate(model *sitemodels.SyncSource) {
	@toast.Toast(toast.Props{
		Title:         "Success",
		Description:   "Sync Updated",
		Variant:       toast.VariantSuccess,
		Position:      toast.PositionTopCenter,
		Duration:      5000,
		Dismissible:   true,
		Icon:          true,
		ShowIndicator: true,
	})
}
