package site_settings_templ

import (
	"strconv"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/listpage"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
)

// PushDevices is the apps on devices that pushes are sent to, with whose they are and buttons to test and delete each:
// the site's for an admin, and the identity's own for anyone else
templ PushDevices(registrations []*sitemodels.PushRegistration, admin bool) {
	@listpage.Page(listpage.Props{
		ID:          "push_devices_table",
		Title:       "Push Devices",
		Description: pushDevicesDescription(admin),
		Table: listpage.TableProps{
			ID:      "pushDevicesTable",
			EmptyID: "site--push-device--empty",
			Empty:   "No apps have registered for pushes yet.",
			Columns: []table.Column{
				{Label: "Identity"}, {Label: "App"}, {Label: "Bundle ID"}, {Label: "Registered"}, {Label: "Last Push"},
				{Actions: true},
			},
		},
	}) {
		for _, registration := range registrations {
			@PushDeviceRow(registration)
		}
	}
}

// pushDevicesDescription says whose push devices are shown: the site's for an admin, and the identity's own for anyone
// else
func pushDevicesDescription(admin bool) string {
	if admin {
		return "The apps on your site's phones that pushes are sent to, for every user and device. Test one to send it a " +
			"notification and see it arrives, or delete one to stop pushes to it."
	}
	return "The apps on your phones that pushes are sent to. Test one to send it a notification and see it arrives, or " +
		"delete one to stop pushes to it."
}

// PushDeviceRow is a registration, without its token, and buttons to send it a test push and to delete it
templ PushDeviceRow(registration *sitemodels.PushRegistration) {
	{{ id := "site--push-device--" + strconv.FormatInt(registration.ID, 10) }}
	@table.Row(table.RowProps{ID: id}) {
		@table.Cell() {
			{ registration.IdentityName }
		}
		@table.Cell() {
			{ string(registration.App) }
			<span class="block text-xs text-gray-500">{ PushProviders[string(registration.Provider)] }</span>
		}
		@table.Cell() {
			{ registration.BundleID }
			if !registration.Production {
				<span class="block text-xs text-gray-500">Development build</span>
			}
		}
		@table.Cell() {
			{ formatIdentityDate(ctx, &registration.CreatedAt) }
		}
		@pushDeviceStatus(registration)
		@table.Cell() {
			<div class="flex items-center justify-end gap-2">
				@button.Button(button.Props{
					ID:      id + "--test",
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-post":       "/settings/push-registrations/" + strconv.FormatInt(registration.ID, 10) + "/test",
						"hx-target":     "#" + id + "--status",
						"hx-swap":       "outerHTML",
						"hx-status:4xx": "target:#toaster swap:beforeend",
						"hx-status:5xx": "target:#toaster swap:beforeend",
					},
				}) {
					Test
				}
				@table.DeleteButton(id+"--delete", "/settings/push-registrations/"+strconv.FormatInt(registration.ID, 10),
					"Delete this push device? Pushes to it will stop until its app registers again.")
			</div>
		}
	}
}

// pushDeviceStatus is when the registration was last pushed to, and the push's error, if it had one
templ pushDeviceStatus(registration *sitemodels.PushRegistration) {
	@table.Cell(table.CellProps{ID: "site--push-device--" + strconv.FormatInt(registration.ID, 10) + "--status"}) {
		{ formatIdentityDate(ctx, registration.LastPushedAt) }
		if registration.LastError != nil {
			<span class="block text-xs text-red-600">{ *registration.LastError }</span>
		}
	}
}

// PushDeviceTested is the registration's status after a test push reached its push service, and a toast saying so
templ PushDeviceTested(registration *sitemodels.PushRegistration) {
	@pushDeviceStatus(registration)
	@successtoast.OOB("Test push sent to " + string(registration.App))
}

templ PushDeviceDeleted() {
	@successtoast.Toast("Push Device Deleted")
}
