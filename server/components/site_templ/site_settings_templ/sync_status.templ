package site_settings_templ

import (
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/utils/display"
)

func count(n *int64) int64 {
	if n == nil {
		return 0
	}
	return *n
}

// SyncStatus shows how a saved source has synced: when it last worked and failed, how long it took, how often it
// syncs and why, its last backfill, and its newest events and errors
templ SyncStatus(source *sitemodels.SyncSource, name string) {
	<div id={ "site--settings--" + name + "-sync--status-live" } data-sync-live>
		@syncStatus(source, name)
	</div>
}

templ syncStatus(source *sitemodels.SyncSource, name string) {
	if source != nil {
		<div id={ "site--settings--" + name + "-sync--status" } class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm">
			<dl class="grid gap-x-4 gap-y-1 sm:grid-cols-2 md:grid-cols-3">
				@syncStat(name, "last-success", "Last worked") {
					<span title={ formatIdentityDate(ctx, source.LastSuccessfulSync) }>{ display.Ago(source.LastSuccessfulSync, time.Now()) }</span>
				}
				@syncStat(name, "last-failure", "Last failed") {
					<span title={ formatIdentityDate(ctx, source.LastFailedSync) }>{ display.Ago(source.LastFailedSync, time.Now()) }</span>
				}
				@syncStat(name, "duration", "Last sync took") {
					if source.LastSyncDuration != nil {
						{ display.Duration(*source.LastSyncDuration) }
					} else {
						-
					}
				}
				@syncStat(name, "interval", "Syncs every") {
					{ fmt.Sprintf("%s (%s)", display.Duration(source.SyncIntervalSeconds*1000), display.Name(source.SyncIntervalSecondsReason)) }
				}
				@syncStat(name, "totals", "Syncs") {
					{ fmt.Sprintf("%d worked, %d failed", count(source.TotalSuccessfulSyncs), count(source.TotalFailedSyncs)) }
					if count(source.ConsecutiveFailedSyncs) > 0 {
						<span class="text-red-700">{ fmt.Sprintf("(the last %d in a row)", count(source.ConsecutiveFailedSyncs)) }</span>
					}
				}
				@syncStat(name, "records", "Records pulled in") {
					{ fmt.Sprintf("%d", source.TotalRecords) }
				}
				@syncStat(name, "last-records", "Last sync pulled in") {
					if source.LastSyncRecords != nil {
						{ fmt.Sprintf("%d records", *source.LastSyncRecords) }
					} else {
						-
					}
				}
				@syncStat(name, "backfill", "Last backfill") {
					if source.TotalBackfills == 0 {
						Never
					} else {
						<span title={ formatIdentityDate(ctx, source.LastBackfillFinishedAt) }>{ display.Ago(source.LastBackfillFinishedAt, time.Now()) }</span>{ fmt.Sprintf(", %d records in %s", count(source.LastBackfillRecords), display.Duration(count(source.LastBackfillDuration))) }
						if source.LastBackfillError != nil {
							<span class="text-red-700">: { *source.LastBackfillError }</span>
						}
					}
				}
			</dl>
			if len(source.RecentEvents) > 0 || len(source.RecentErrors) > 0 {
				<details id={ "site--settings--" + name + "-sync--history" } class="mt-3">
					<summary class="cursor-pointer text-gray-600">Recent events and errors</summary>
					<ul class="mt-2 space-y-1">
						for _, event := range source.RecentEvents {
							<li><span class="text-gray-500">{ display.Ago(&event.StartedAt, time.Now()) }</span> { display.Name(event.Name) }</li>
						}
						for _, syncError := range source.RecentErrors {
							<li class="text-red-700"><span class="text-gray-500">{ display.Ago(&syncError.CreatedAt, time.Now()) }</span> { syncError.Message }</li>
						}
					</ul>
					<p class="mt-2">
						<a class="text-primary underline" href={ templ.SafeURL("/logs/events?search=" + string(source.Type)) }>All events</a> ·
						<a class="text-primary underline" href={ templ.SafeURL("/logs/errors?type=sync&search=" + string(source.Type)) }>All errors</a>
					</p>
				</details>
			}
		</div>
	}
}

templ syncStat(name string, stat string, label string) {
	<div>
		<dt class="text-gray-500">{ label }</dt>
		<dd id={ "site--settings--" + name + "-sync--status--" + stat } class="text-gray-900">{ children... }</dd>
	</div>
}
