package site_settings_templ

import (
	"context"
	"fmt"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/dbsize"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/successtoast"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/utils/i18n"
)

// Usage is the site's usage page for its admins: its storage (UsageStorage) and a download of all its data
templ Usage(storage templ.Component) {
	<div id="site--usage" class="mx-auto max-w-5xl space-y-6">
		@heading.Page(i18n.T(ctx, "site.settings.usage.title")) {
			{ i18n.T(ctx, "site.settings.usage.about") }
		}
		@storage
		@card.Card(card.Props{ID: "site--usage--download", Title: i18n.T(ctx, "site.settings.usage.download_data"),
			Note:   i18n.T(ctx, "site.settings.usage.download_note"),
			Action: labelled(i18n.T(ctx, "site.settings.usage.download_data"), button.Props{ID: "site--usage--download-data", Href: "/usage/download", Variant: button.VariantOutline,
				Attributes: templ.Attributes{"download": ""}})})
	</div>
}

// UsageStorage is the site's DB size against its limit and where its data builds up, by table, as the control site
// shows it, with a button to truncate it, which says what truncating removes and keeps
templ UsageStorage(sizeKB, limitKB *int64, tables []*controlmodels.SiteTable) {
	<section id="site--usage--storage" class="space-y-3">
		@dbsize.Panel("site--usage", sizeKB, limitKB, tables)
		@card.Card(card.Props{ID: "site--usage--truncate-card", Title: i18n.T(ctx, "site.settings.usage.truncate"),
			Note:   i18n.T(ctx, "site.settings.usage.truncate_note"),
			Action: labelled(i18n.T(ctx, "site.settings.usage.truncate"), button.Props{ID: "site--usage--truncate", Variant: button.VariantOutline,
				Attributes: templ.Attributes{"hx-post": "/usage/truncate", "hx-target": "#site--usage--storage", "hx-swap": "outerHTML",
					"hx-status:4xx": "target:#toaster swap:beforeend", "hx-status:5xx": "target:#toaster swap:beforeend",
					"hx-confirm": i18n.T(ctx, "site.settings.usage.truncate_confirm")}})})
	</section>
}

// UsageTruncated is a toast saying the site was truncated, and its size now
templ UsageTruncated(sizeKB *int64) {
	@successtoast.TitledOOB(i18n.T(ctx, "site.settings.usage.truncated"), truncatedSize(ctx, sizeKB), 5000)
}

// truncatedSize says the site's DB size after truncating, when it is known
func truncatedSize(ctx context.Context, sizeKB *int64) string {
	if sizeKB == nil {
		return i18n.T(ctx, "site.settings.usage.truncated_reports")
	}
	return i18n.T(ctx, "site.settings.usage.truncated_size", i18n.Data{"Size": fmt.Sprintf("%.2f", float64(*sizeKB)/1024)})
}
