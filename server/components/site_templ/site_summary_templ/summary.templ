package site_summary_templ

import (
	"context"
	"fmt"
	"sort"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/card"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/stat"
	"nighttroop.t1d.nz/server/components/ui/badge"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/display"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// loopValue is a value from the loop's latest status, or a dash when there is none
func loopValue(ctx context.Context, loop *sitemodels.SiteDeviceStatus, get func(*sitemodels.SiteDeviceStatus) *float64, unit string) string {
	if loop == nil {
		return "–"
	}
	return display.Value(ctx, get(loop), unit)
}

// treatment is one row of the summary's treatments, with Path the data page listing its kind
type treatment struct {
	At     int64
	Kind   string
	Path   string
	Detail string
}

// otherTreatments are the summary's treatments besides insulin and carbs, its temp targets and temp basals, in one
// list, newest first
func otherTreatments(ctx context.Context, s *sitemodels.Summary) []treatment {
	list := []treatment{}
	for _, t := range s.TempTargets {
		detail := i18n.T(ctx, "site.summary.treatments.temp_target_detail", i18n.Data{"Low": display.Glucose(ctx, t.LowTarget, t.Units), "High": display.Glucose(ctx, t.HighTarget, t.Units),
			"Units": display.Units(t.Units), "Minutes": t.DurationMinutes})
		// A temp target of no duration cancels the one before, as AAPS's and T1D Carer's cancel send, and has no target
		// of its own
		if t.DurationMinutes == 0 {
			detail = i18n.T(ctx, "site.summary.treatments.temp_target_cancelled")
		}
		list = append(list, treatment{t.OccurredAt, i18n.T(ctx, "site.summary.treatments.temp_target"), "/data/temp-targets", detail})
	}
	for _, b := range s.TempBasals {
		kind, detail := i18n.T(ctx, "site.summary.treatments.temp_basal"), i18n.T(ctx, "site.summary.treatments.temp_basal_detail", i18n.Data{"Rate": display.Value(ctx, b.Rate, " U/hr"), "Minutes": b.DurationMinutes})
		// A suspended pump shows as one, which has not resumed while it has no duration
		if b.Suspend() {
			kind, detail = i18n.T(ctx, "site.summary.treatments.suspended"), i18n.T(ctx, "site.summary.treatments.suspended_detail", i18n.Data{"Minutes": b.DurationMinutes})
			if b.DurationMinutes == 0 {
				detail = i18n.T(ctx, "site.summary.treatments.suspended_until_resumed")
			}
		}
		list = append(list, treatment{b.OccurredAt, kind, "/data/temp-basals", detail})
	}
	sort.SliceStable(list, func(i, j int) bool { return list[i].At > list[j].At })
	return list
}

// intake is a dose of insulin or a meal's carbs, at a time in milliseconds, with SMB set for a loop's small bolus
type intake struct {
	At             int64
	Insulin, Carbs string
	SMB            bool
}

// insulinAndCarbs are the summary's doses and carbs in one list, newest first, each in its own column
func insulinAndCarbs(ctx context.Context, s *sitemodels.Summary) []intake {
	list := []intake{}
	for _, d := range s.InsulinDoses {
		list = append(list, intake{At: d.OccurredAt, Insulin: doseText(ctx, d, " U"), SMB: isSMB(d)})
	}
	for _, f := range s.FoodIntakes {
		if f.Carbs != nil {
			carbs := display.Value(ctx, f.Carbs, " g")
			// Carbs given over a time, as AAPS's extended carbs are, say how long, as an extended dose does
			if f.DurationMinutes != nil {
				carbs = i18n.T(ctx, "site.summary.intake.extended_only", i18n.Data{"Extended": carbs, "Duration": display.Duration(ctx, *f.DurationMinutes*60_000)})
			}
			list = append(list, intake{At: f.OccurredAt, Carbs: carbs})
		}
	}
	sort.SliceStable(list, func(i, j int) bool { return list[i].At > list[j].At })
	return list
}

// doseText is a dose's units, with a combo or extended bolus's extended units and the time they are given over, as
// "1.2 U + 1.8 U over 2 h", or "2 U over 2 h" when none is given at once, each followed by unit, as " U" in a table or
// "U" on the graph. An extended dose with no time is given at once, as the daily dose counts it.
func doseText(ctx context.Context, d *sitemodels.SiteInsulinDose, unit string) string {
	if d.IsBasalInsulin != nil && *d.IsBasalInsulin {
		// Basal insulin, as long acting insulin injected, says so, as it counts as basal, not as a bolus
		return i18n.T(ctx, "site.summary.intake.basal_insulin", i18n.Data{"Dose": doseAmount(ctx, d, unit)})
	}
	return doseAmount(ctx, d, unit)
}

// doseAmount is a dose's units, with its extended dose and how long that is given over
func doseAmount(ctx context.Context, d *sitemodels.SiteInsulinDose, unit string) string {
	dose := display.Value(ctx, &d.Dose, unit)
	if d.ExtendedDose == nil || *d.ExtendedDose <= 0 {
		return dose
	}
	if d.ExtendedDurationMinutes == nil || *d.ExtendedDurationMinutes <= 0 {
		return display.Value(ctx, new(d.Dose+*d.ExtendedDose), unit)
	}
	data := i18n.Data{"Dose": dose, "Extended": display.Value(ctx, d.ExtendedDose, unit),
		"Duration": display.Duration(ctx, *d.ExtendedDurationMinutes*60_000)}
	if d.Dose == 0 {
		return i18n.T(ctx, "site.summary.intake.extended_only", data)
	}
	return i18n.T(ctx, "site.summary.intake.extended", data)
}

// plannedAhead is how far after now an intake is planned, as carbs a loop expects from fat and protein, rather than
// from a phone's clock running fast, which says "just now"
const plannedAhead = 10 * time.Minute

// intakeWhen is when an intake was, or for one planned ahead, how long until it is: "in 58 minutes"
func intakeWhen(ctx context.Context, at int64, now time.Time) string {
	if time.UnixMilli(at).Sub(now) > plannedAhead {
		return display.RoundedIn(ctx, at, now)
	}
	return display.RoundedAgo(ctx, at, now)
}

// ago is how long ago ms was, or a dash when it is not set
func ago(ctx context.Context, ms *int64) string {
	if ms == nil {
		return "–"
	}
	return display.RoundedAgo(ctx, *ms, time.Now())
}

func orDash(v *string) string {
	if v == nil {
		return "–"
	}
	return *v
}

// ranges are the time ranges the summary offers, up to the week it is capped at, with the messages of their names
var ranges = []struct {
	Hours int64
	Label string
}{{6, "site.summary.ranges.six_hours"}, {24, "site.summary.ranges.one_day"}, {48, "site.summary.ranges.two_days"}, {7 * 24, "site.summary.ranges.week"}}

// rangeNames are the messages of the latest glucose's range, as display.GlucoseRange names it, when it is out of range
var rangeNames = map[string]string{"Low": "site.summary.glucose.low", "High": "site.summary.glucose.high"}

// Summary is the site's home page: the latest glucose, IOB and COB, then everything since the summary starts.
// It streams the summary's events, shown Live while connected, and reloads its content a second after changes stop
// arriving, when the stream reconnects, as changes may have been missed while it was not, and once its latest reading
// turns stale, so it greys then rather than at the next change. The header, with the stream, is not reloaded, so the
// stream stays open.
templ Summary(summary *sitemodels.Summary) {
	@heading.Title(i18n.T(ctx, "site.summary.title"))
	<div id="site--summary" class="w-full space-y-4 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<div class="flex items-center gap-2">
					<h1 class="text-2xl font-bold">{ i18n.T(ctx, "site.summary.title") }</h1>
					@badge.Live("site--summary--live", "/data/summary/events")
				</div>
				<span id="site--summary--hours" class="text-sm text-gray-500">{ i18n.T(ctx, "site.summary.last_hours", i18n.Data{"Hours": summary.Hours}) }</span>
			</div>
			<div class="segmented">
				@icon.Clock(icon.Props{Class: "mx-1.5 size-4 text-gray-500"})
				for _, r := range ranges {
					@nav.Toggle(fmt.Sprintf("site--summary--range-%d", r.Hours), fmt.Sprintf("/?hours=%d", r.Hours), button.SizeSm, summary.Hours == r.Hours) {
						{ i18n.T(ctx, r.Label) }
					}
				}
			</div>
		</div>
		<div
			id="site--summary--content"
			class="space-y-4"
			hx-get={ fmt.Sprintf("/?hours=%d", summary.Hours) }
			hx-trigger={ "created from:#site--summary--live delay:1s, updated from:#site--summary--live delay:1s, deleted from:#site--summary--live delay:1s, reconnected from:#site--summary--live" + staleTrigger(ctx, summary, time.Now()) }
			hx-select="#site--summary--content"
			hx-target="this"
			hx-swap="outerHTML"
		>
			if isNew(summary) {
				@GettingStarted()
			} else {
				@summaryContent(summary)
			}
		</div>
		<div id="modal-container"></div>
	</div>
}

// summaryContent is everything in the summary below its header, which reloads as the summary's data changes
templ summaryContent(summary *sitemodels.Summary) {
	// The latest glucose is two tiles wide and, in a wide window, two high, beside the two rows of tiles
	<div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
		@glucoseHero(summary)
		@stat.Tile("site--summary--iob", i18n.T(ctx, "site.summary.iob"), loopValue(ctx, summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopIob }, " U"), icon.Syringe)
		@stat.Tile("site--summary--cob", i18n.T(ctx, "site.summary.cob"), loopValue(ctx, summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopCob }, " g"), icon.Utensils)
		@stat.Tile("site--summary--reservoir", i18n.T(ctx, "site.summary.reservoir"), loopValue(ctx, summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.PumpReservoir }, " U"), icon.Gauge)
		@stat.Tile("site--summary--phone-battery", i18n.T(ctx, "site.summary.phone_battery"), loopValue(ctx, summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.DeviceBatteryPercent }, "%"), icon.Smartphone)
		@stat.Tile("site--summary--time-in-range", i18n.T(ctx, "site.summary.time_in_range"), display.Percent(summary.Today.TimeInRange), icon.Target) {
			@previous("site--summary--time-in-range--yesterday", i18n.T(ctx, "site.summary.yesterday"), display.Percent(summary.Yesterday.TimeInRange))
			@previous("site--summary--time-in-range--last-week", i18n.T(ctx, "site.summary.last_week"), display.Percent(summary.LastWeek.TimeInRange))
			@previous("site--summary--time-in-range--last-fortnight", i18n.T(ctx, "site.summary.last_fortnight"), display.Percent(summary.LastFortnight.TimeInRange))
			@previous("site--summary--time-in-range--last-month", i18n.T(ctx, "site.summary.last_month"), display.Percent(summary.LastMonth.TimeInRange))
		}
		@stat.Tile("site--summary--total-daily-dose", i18n.T(ctx, "site.summary.total_daily_dose"), display.PerDay(ctx, summary.Today.Days, summary.Today.TotalDailyDose, " U"), icon.Droplet) {
			@previous("site--summary--total-daily-dose--yesterday", i18n.T(ctx, "site.summary.yesterday"), display.PerDay(ctx, summary.Yesterday.Days, summary.Yesterday.TotalDailyDose, " U"))
			@previous("site--summary--total-daily-dose--last-week", i18n.T(ctx, "site.summary.last_week"), display.PerDay(ctx, summary.LastWeek.Days, summary.LastWeek.TotalDailyDose, " U"))
			@previous("site--summary--total-daily-dose--last-fortnight", i18n.T(ctx, "site.summary.last_fortnight"), display.PerDay(ctx, summary.LastFortnight.Days, summary.LastFortnight.TotalDailyDose, " U"))
			@previous("site--summary--total-daily-dose--last-month", i18n.T(ctx, "site.summary.last_month"), display.PerDay(ctx, summary.LastMonth.Days, summary.LastMonth.TotalDailyDose, " U"))
		}
		@stat.Tile("site--summary--sensor-started", i18n.T(ctx, "site.summary.sensor_started"), ago(ctx, summary.SensorStartedAt), icon.Activity)
		@stat.Tile("site--summary--site-changed", i18n.T(ctx, "site.summary.site_changed"), ago(ctx, summary.SiteChangedAt), icon.Bandage)
	</div>
	@card.Card(card.Props{Title: i18n.T(ctx, "site.summary.graph.title")}) {
		@Graph(summary)
	}
	<div class="grid gap-4 lg:grid-cols-2">
		@card.Card(card.Props{Title: i18n.T(ctx, "site.summary.insulin_and_carbs"), Scroll: true}) {
			@insulinCarbsTable(insulinAndCarbs(ctx, summary))
		}
		@card.Card(card.Props{Title: i18n.T(ctx, "site.summary.other_treatments"), Scroll: true}) {
			@treatmentsTable(otherTreatments(ctx, summary))
		}
	</div>
	<section id="site--summary--devices" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		if len(summary.DeviceStatuses) > 0 {
			<div class="col-span-full flex items-center justify-between">
				<h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{ i18n.T(ctx, "site.summary.device.title") }</h2>
				@nav.Link("site--summary--all-devices", "/data/device-status", "text-sm text-primary underline") {
					{ i18n.T(ctx, "site.summary.device.all") }
				}
			</div>
		}
		for _, status := range summary.DeviceStatuses {
			@deviceCard(status)
		}
	</section>
}

// staleAfterMinutes is how old the latest reading can be before the summary says there is none: the no data alarm's
// minutes, from the settings in effect, or 15 without them
func staleAfterMinutes(ctx context.Context) int64 {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil {
		if minutes := new(siteContext.GetSettings().Alarms.NoData.Minutes); minutes != nil {
			return *minutes
		}
	}
	return 15
}

// staleFor is how long ago, in whole minutes, a reading older than staleAfterMinutes was taken, and "" for one newer
func staleFor(ctx context.Context, occurredAt int64, now time.Time) string {
	age := now.Sub(time.UnixMilli(occurredAt)).Truncate(time.Minute)
	if age < time.Duration(staleAfterMinutes(ctx))*time.Minute {
		return ""
	}
	return display.Duration(ctx, age.Milliseconds())
}

// staleTrigger is the summary content's trigger to reload once its latest reading turns stale, a second after so the
// reload finds it so, or "" when there is no reading or it already is. A reading from the future waits no longer than
// the stale minutes, as a timer too long for the browser fires at once, which would reload again and again.
func staleTrigger(ctx context.Context, summary *sitemodels.Summary, now time.Time) string {
	if summary.CurrentGlucose == nil || staleFor(ctx, summary.CurrentGlucose.OccurredAt, now) != "" {
		return ""
	}
	after := time.Duration(staleAfterMinutes(ctx)) * time.Minute
	in := min(time.UnixMilli(summary.CurrentGlucose.OccurredAt).Add(after).Sub(now), after) + time.Second
	return fmt.Sprintf(", load delay:%dms", in.Milliseconds())
}

// newerMeter is the newest meter reading newer than the current glucose, shown under it, as a fingerstick is not the
// sensor's glucose and has no trend, or nil when there is none, as when the current glucose is the newest fingerstick
func newerMeter(summary *sitemodels.Summary) *sitemodels.SiteCleanGlucoseReading {
	for _, reading := range summary.GlucoseReadings {
		if summary.CurrentGlucose == nil || reading.OccurredAt <= summary.CurrentGlucose.OccurredAt {
			return nil
		}
		if reading.ReadingType == "mbg" {
			return reading
		}
	}
	return nil
}

// staleHelp says, under a reading that is too old, where to look for why readings stopped: an admin gets links to the
// three pages that say, and anyone else is told to ask an admin, as they cannot open those pages
templ staleHelp() {
	<p id="site--summary--glucose--stale-help" class="mt-2 flex max-w-md flex-wrap gap-x-3 gap-y-1 rounded-lg bg-amber-100 px-3 py-2 text-sm text-amber-800">
		if isAdmin(ctx) {
			<span class="font-medium">{ i18n.T(ctx, "site.summary.glucose.stale_help") }</span>
			@nav.Link("site--summary--stale--connectors", "/settings/connectors", "font-medium underline") {
				{ i18n.T(ctx, "site.settings.connectors.title") }
			}
			@nav.Link("site--summary--stale--identities", "/settings/identities", "font-medium underline") {
				{ i18n.T(ctx, "site.settings.identities.title") }
			}
			@nav.Link("site--summary--stale--errors", "/logs/errors", "font-medium underline") {
				{ i18n.T(ctx, "site.logs.errors.title") }
			}
		} else {
			{ i18n.T(ctx, "site.summary.glucose.stale_ask") }
		}
	</p>
}

templ glucoseHero(summary *sitemodels.Summary) {
	<div id="site--summary--glucose" class="panel col-span-2 flex flex-wrap items-center p-4 sm:col-span-4 lg:col-span-2 lg:row-span-2">
		if summary.CurrentGlucose != nil {
			{{ latest, meter := summary.CurrentGlucose, newerMeter(summary) }}
			{{ outOfRange, stale := display.GlucoseRange(latest.Reading, summary.RangeLow, summary.RangeHigh), staleFor(ctx, latest.OccurredAt, time.Now()) }}
			<div>
				<div class="flex items-center gap-2">
					<span class="text-sm font-semibold uppercase tracking-wide text-gray-500">{ i18n.T(ctx, "site.summary.glucose.title") }</span>
					if stale != "" {
						@badge.Badge(badge.Props{ID: "site--summary--glucose--stale", Variant: badge.VariantWarning}) {
							{ i18n.T(ctx, "site.summary.glucose.stale", i18n.Data{"Duration": stale}) }
						}
					}
				</div>
				<div class="flex flex-wrap items-baseline gap-2">
					// An old reading is grey, as it may no longer be the glucose
					<span id="site--summary--glucose--reading" class={ "text-6xl font-extrabold tracking-tight", templ.KV(site_data_templ.GlucoseColours[outOfRange].Text, stale == ""), templ.KV("text-gray-400", stale != "") }>{ display.Glucose(ctx, latest.Reading, latest.Units) }</span>
					<span class="text-lg text-gray-500">{ display.Units(latest.Units) }</span>
					<span id="site--summary--glucose--arrow" class="ml-2 text-4xl text-gray-700">{ display.Arrow(latest.Direction) }</span>
					if outOfRange != "" {
						<span id="site--summary--glucose--range" class={ "ml-2 text-2xl font-bold", site_data_templ.GlucoseColours[outOfRange].Text }>{ i18n.T(ctx, rangeNames[outOfRange]) }</span>
					}
				</div>
				if meter != nil {
					<div id="site--summary--glucose--meter" class="mt-1 text-sm text-gray-700" title={ site_data_templ.FormatDate(ctx, meter.OccurredAt) }>
						{ i18n.T(ctx, "site.summary.glucose.meter", i18n.Data{"Reading": display.Glucose(ctx, meter.Reading, meter.Units), "Units": display.Units(meter.Units), "Ago": display.RoundedAgo(ctx, meter.OccurredAt, time.Now())}) }
					</div>
				}
				<div class="mt-1 flex gap-3 text-sm">
					<span id="site--summary--glucose--ago" class="text-gray-500" title={ site_data_templ.FormatDate(ctx, latest.OccurredAt) }>{ display.RoundedAgo(ctx, latest.OccurredAt, time.Now()) }</span>
					@nav.Link("site--summary--all-readings", "/data/glucose", "text-primary underline") {
						{ i18n.T(ctx, "site.summary.glucose.all_readings") }
					}
				</div>
				if stale != "" {
					@staleHelp()
				}
			</div>
		} else {
			<div>
				<div class="text-2xl font-bold text-gray-900">{ i18n.T(ctx, "site.summary.glucose.none") }</div>
				<div class="mt-1 text-sm text-gray-500">
					{ i18n.T(ctx, "site.summary.glucose.connect") }
					<a id="site--summary--connectors-link" href="/settings/connectors" { nav.Attributes("/settings/connectors")... } class="text-primary underline">{ i18n.T(ctx, "site.summary.glucose.connectors") }</a>.
				</div>
			</div>
		}
	</div>
}

// previous is a day tile's value for yesterday, or the mean day of last week or month, under today's. A time with no
// data, as each is on a new site, has no line, not four that each say only a dash.
templ previous(id, label, text string) {
	if text != "–" {
		<div id={ id } class="text-xs text-gray-500">{ label } { text }</div>
	}
}

// deviceCard is a device's latest status; clicking it opens all its details
templ deviceCard(status *sitemodels.SiteDeviceStatus) {
	<button
		id={ "site--summary--device--" + status.ID }
		class="panel p-4 text-left hover:border-primary"
		hx-get={ "/data/device-status/" + status.ID }
		hx-target="#modal-container"
		hx-swap="innerHTML"
	>
		<div class="flex items-baseline justify-between gap-2">
			<span class="truncate font-semibold text-brand-night">{ orDash(status.CreatedByDeviceName) }</span>
			// A suspended pump gives no insulin, so the card says so
			if status.PumpState != nil && *status.PumpState == "suspended" {
				@badge.Badge(badge.Props{ID: "site--summary--device--" + status.ID + "--suspended", Variant: badge.VariantWarning}) {
					{ i18n.T(ctx, "site.summary.device.suspended") }
				}
			}
			<span class="ml-auto whitespace-nowrap text-xs text-gray-500" title={ site_data_templ.FormatDate(ctx, status.OccurredAt) }>{ display.RoundedAgo(ctx, status.OccurredAt, time.Now()) }</span>
		</div>
		<dl class="mt-2 grid grid-cols-3 gap-x-3 gap-y-1 text-sm">
			@detail(i18n.T(ctx, "site.summary.device.phone"), display.Value(ctx, status.DeviceBatteryPercent, "%"))
			@detail(i18n.T(ctx, "site.summary.device.reservoir"), display.Value(ctx, status.PumpReservoir, " U"))
			@detail(i18n.T(ctx, "site.summary.device.pump"), display.Value(ctx, status.PumpBatteryPercent, "%"))
			@detail("IOB", display.Value(ctx, status.LoopIob, " U"))
			@detail("COB", display.Value(ctx, status.LoopCob, " g"))
		</dl>
	</button>
}

templ detail(label, text string) {
	<div>
		<dt class="text-xs text-gray-500">{ label }</dt>
		<dd class="font-medium tabular-nums">
			@stat.Numbers(text, "text-xs font-normal text-gray-500")
		</dd>
	</div>
}

templ treatmentsTable(list []treatment) {
	@table.Table(table.Props{ID: "site--summary--treatments"}) {
		@table.Body() {
			if len(list) == 0 {
				@table.Empty("", 1, i18n.T(ctx, "site.summary.treatments.none"))
			}
			for _, t := range list {
				// On a phone its detail is a line of its own under when and what it was, not a column a word wide
				@table.Row(table.RowProps{Class: "max-sm:flex max-sm:flex-wrap"}) {
					@table.Cell() {
						<span title={ site_data_templ.FormatDate(ctx, t.At) }>{ display.RoundedAgo(ctx, t.At, time.Now()) }</span>
					}
					@table.Cell() {
						@nav.Link("", t.Path, "font-medium text-primary underline") {
							{ t.Kind }
						}
					}
					@table.Cell(table.CellProps{Class: "whitespace-normal max-sm:basis-full max-sm:pt-0 max-sm:text-gray-600"}) {
						{ t.Detail }
					}
				}
			}
		}
	}
}

// insulinCarbsTable is each dose and meal's carbs, newest first, with how long ago it was; a loop's SMBs are marked
templ insulinCarbsTable(list []intake) {
	@table.Table(table.Props{ID: "site--summary--insulin-carbs"}) {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					{ i18n.T(ctx, "site.summary.intake.when") }
				}
				@table.Head(table.HeadProps{Class: "text-right"}) {
					{ i18n.T(ctx, "site.summary.intake.insulin") }
				}
				@table.Head(table.HeadProps{Class: "text-right"}) {
					{ i18n.T(ctx, "site.summary.intake.carbs") }
				}
			}
		}
		@table.Body() {
			if len(list) == 0 {
				@table.Empty("", 3, i18n.T(ctx, "site.summary.intake.none"))
			}
			for _, i := range list {
				@table.Row() {
					@table.Cell() {
						<span title={ site_data_templ.FormatDate(ctx, i.At) }>{ intakeWhen(ctx, i.At, time.Now()) }</span>
					}
					@table.Cell(table.CellProps{Class: "text-right font-medium tabular-nums"}) {
						if i.SMB {
							<span class="mr-2 text-xs text-gray-500">SMB</span>
						}
						@stat.Numbers(i.Insulin, "text-xs font-normal text-gray-500")
					}
					@table.Cell(table.CellProps{Class: "text-right font-medium tabular-nums"}) {
						@stat.Numbers(i.Carbs, "text-xs font-normal text-gray-500")
					}
				}
			}
		}
	}
}
