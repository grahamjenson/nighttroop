package site_summary_templ

import (
	"fmt"
	"sort"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
)

// directionArrows are the Nightscout trend directions as arrows
var directionArrows = map[string]string{
	"DoubleUp": "⇈", "SingleUp": "↑", "FortyFiveUp": "↗", "Flat": "→",
	"FortyFiveDown": "↘", "SingleDown": "↓", "DoubleDown": "⇊",
}

func arrow(direction *string) string {
	if direction == nil {
		return ""
	}
	return directionArrows[*direction]
}

func minutesAgo(ms int64) string {
	return fmt.Sprintf("%d min ago", int(time.Since(time.UnixMilli(ms)).Minutes()))
}

// value shows an optional number with its unit, or a dash when it is not set
func value(v *float64, unit string) string {
	if v == nil {
		return "–"
	}
	return fmt.Sprintf("%g%s", consts.Round(*v, 2), unit)
}

func unitsText(units *consts.Units) string {
	if units == nil {
		return ""
	}
	return string(*units)
}

// loopValue is a value from the loop's latest status, or a dash when there is none
func loopValue(loop *sitemodels.SiteDeviceStatus, get func(*sitemodels.SiteDeviceStatus) *float64, unit string) string {
	if loop == nil {
		return "–"
	}
	return value(get(loop), unit)
}

type treatment struct {
	At     int64
	Kind   string
	Detail string
	Device *string
}

// treatments are the summary's insulin, food, temp targets and temp basals in one list, newest first
func treatments(s *sitemodels.Summary) []treatment {
	list := []treatment{}
	for _, d := range s.InsulinDoses {
		list = append(list, treatment{d.OccurredAt, "Insulin", value(&d.Dose, " U"), d.CreatedByDeviceName})
	}
	for _, f := range s.FoodIntakes {
		list = append(list, treatment{f.OccurredAt, "Food", value(f.Carbs, " g carbs"), f.CreatedByDeviceName})
	}
	for _, t := range s.TempTargets {
		detail := fmt.Sprintf("%s–%s %s for %d min", site_data_templ.FormatGlucose(t.LowTarget, t.Units), site_data_templ.FormatGlucose(t.HighTarget, t.Units), unitsText(t.Units), t.DurationMinutes)
		list = append(list, treatment{t.OccurredAt, "Temp Target", detail, t.CreatedByDeviceName})
	}
	for _, b := range s.TempBasals {
		list = append(list, treatment{b.OccurredAt, "Temp Basal", fmt.Sprintf("%s for %d min", value(b.Absolute, " U/hr"), b.DurationMinutes), b.CreatedByDeviceName})
	}
	sort.SliceStable(list, func(i, j int) bool { return list[i].At > list[j].At })
	return list
}

func orDash(v *string) string {
	if v == nil {
		return "–"
	}
	return *v
}

// Summary is the site's home page: the latest glucose, IOB and COB, then everything since the summary starts
templ Summary(summary *sitemodels.Summary) {
	<div id="site--summary" class="w-full space-y-4 py-4">
		<div class="flex items-baseline justify-between">
			<h1 class="text-2xl font-bold">Summary</h1>
			<span id="site--summary--hours" class="text-sm text-gray-500">{ fmt.Sprintf("Last %d hours", summary.Hours) }</span>
		</div>
		@glucoseHero(summary)
		<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
			@tile("site--summary--iob", "Insulin on board", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopIob }, " U"), icon.Syringe)
			@tile("site--summary--cob", "Carbs on board", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopCob }, " g"), icon.Utensils)
			@tile("site--summary--reservoir", "Reservoir", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.PumpReservoir }, " U"), icon.Gauge)
			@tile("site--summary--phone-battery", "Phone battery", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.DeviceBatteryPercent }, "%"), icon.Smartphone)
		</div>
		<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
			@Graph(summary)
		</section>
		<div class="grid gap-4 lg:grid-cols-2">
			@section("Treatments") {
				@treatmentsTable(treatments(summary))
			}
			@section("Glucose Readings") {
				@readingsTable(summary.GlucoseReadings)
			}
		</div>
		<section id="site--summary--devices" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			for _, status := range summary.DeviceStatuses {
				@deviceCard(status)
			}
		</section>
		<div id="modal-container"></div>
	</div>
}

templ glucoseHero(summary *sitemodels.Summary) {
	<div id="site--summary--glucose" class="flex flex-wrap items-end justify-between gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		if len(summary.GlucoseReadings) > 0 {
			{{ latest := summary.GlucoseReadings[0] }}
			<div>
				<div class="text-sm font-semibold uppercase tracking-wide text-gray-500">Glucose</div>
				<div class="flex items-baseline gap-2">
					<span id="site--summary--glucose--reading" class="text-6xl font-extrabold tracking-tight text-brand-night">{ site_data_templ.FormatGlucose(latest.Reading, latest.Units) }</span>
					<span class="text-lg text-gray-500">{ unitsText(latest.Units) }</span>
					<span class="ml-2 text-4xl text-gray-700">{ arrow(latest.Direction) }</span>
				</div>
				<div class="mt-1 text-sm text-gray-500">{ minutesAgo(latest.OccurredAt) }</div>
			</div>
		} else {
			<div>
				<div class="text-2xl font-bold text-gray-900">No glucose readings in this time</div>
				<div class="mt-1 text-sm text-gray-500">Upload from your phone, or connect a source under Settings → Sync.</div>
			</div>
		}
	</div>
}

templ tile(id, label, text string, ic func(...icon.Props) templ.Component) {
	<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
			@ic(icon.Props{Class: "size-4"})
			{ label }
		</div>
		<div id={ id } class="mt-1 text-2xl font-bold tabular-nums text-gray-900">{ text }</div>
	</div>
}

// deviceCard is a device's latest status; clicking it opens all its details
templ deviceCard(status *sitemodels.SiteDeviceStatus) {
	<button
		id={ "site--summary--device--" + status.ID }
		class="rounded-xl border border-gray-200 bg-white p-4 text-left shadow-sm hover:bg-gray-50"
		hx-get={ "/data/device-status/" + status.ID }
		hx-target="#modal-container"
		hx-swap="innerHTML"
	>
		<div class="flex items-baseline justify-between gap-2">
			<span class="truncate font-semibold text-brand-night">{ orDash(status.CreatedByDeviceName) }</span>
			<span class="whitespace-nowrap text-xs text-gray-500">{ minutesAgo(status.OccurredAt) }</span>
		</div>
		<dl class="mt-2 grid grid-cols-3 gap-x-3 gap-y-1 text-sm">
			@detail("Phone", value(status.DeviceBatteryPercent, "%"))
			@detail("Reservoir", value(status.PumpReservoir, " U"))
			@detail("Pump", value(status.PumpBatteryPercent, "%"))
			@detail("IOB", value(status.LoopIob, " U"))
			@detail("COB", value(status.LoopCob, " g"))
		</dl>
	</button>
}

templ detail(label, text string) {
	<div>
		<dt class="text-xs text-gray-500">{ label }</dt>
		<dd class="font-medium tabular-nums">{ text }</dd>
	</div>
}

templ section(title string) {
	<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">{ title }</h2>
		<div class="max-h-96 overflow-y-auto">
			{ children... }
		</div>
	</section>
}

templ treatmentsTable(list []treatment) {
	@table.Table(table.Props{ID: "site--summary--treatments"}) {
		@table.Body() {
			if len(list) == 0 {
				<tr><td class="p-4 text-sm text-gray-500">No treatments in this time.</td></tr>
			}
			for _, t := range list {
				@table.Row() {
					@table.Cell() {
						<span class="whitespace-nowrap">{ site_data_templ.FormatDate(t.At) }</span>
					}
					@table.Cell() {
						<span class="whitespace-nowrap font-medium">{ t.Kind }</span>
					}
					@table.Cell() {
						{ t.Detail }
					}
					@table.Cell() {
						<span class="text-gray-500">{ orDash(t.Device) }</span>
					}
				}
			}
		}
	}
}

templ readingsTable(readings []*sitemodels.SiteGlucoseReading) {
	@table.Table(table.Props{ID: "site--summary--readings"}) {
		@table.Body() {
			if len(readings) == 0 {
				<tr><td class="p-4 text-sm text-gray-500">No glucose readings in this time.</td></tr>
			}
			for _, r := range readings {
				@table.Row() {
					@table.Cell() {
						<span class="whitespace-nowrap">{ site_data_templ.FormatDate(r.OccurredAt) }</span>
					}
					@table.Cell() {
						<span class="font-medium tabular-nums">{ site_data_templ.FormatGlucose(r.Reading, r.Units) }</span> { arrow(r.Direction) }
					}
					@table.Cell() {
						<span class="text-gray-500">{ orDash(r.CreatedByDeviceName) }</span>
					}
				}
			}
		}
	}
}
