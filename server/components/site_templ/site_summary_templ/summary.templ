package site_summary_templ

import (
	"fmt"
	"regexp"
	"sort"
	"strings"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
)

// directionArrows are the Nightscout trend directions as arrows
var directionArrows = map[string]string{
	"DoubleUp": "⇈", "SingleUp": "↑", "FortyFiveUp": "↗", "Flat": "→",
	"FortyFiveDown": "↘", "SingleDown": "↓", "DoubleDown": "⇊",
}

func arrow(direction *string) string {
	if direction == nil {
		return ""
	}
	return directionArrows[*direction]
}

// rangeColours colour a reading below the low alarm, above the high alarm and between them with the theme's glucose
// colours, as the graph colours its dots
var rangeColours = map[string]string{"Low": "text-glucose-low", "High": "text-glucose-high", "": "text-glucose-in-range"}

// value shows an optional number with its unit, or a dash when it is not set
func value(v *float64, unit string) string {
	if v == nil {
		return "–"
	}
	return fmt.Sprintf("%g%s", consts.Round(*v, 2), unit)
}

func unitsText(units *consts.Units) string {
	if units == nil {
		return ""
	}
	return string(*units)
}

// loopValue is a value from the loop's latest status, or a dash when there is none
func loopValue(loop *sitemodels.SiteDeviceStatus, get func(*sitemodels.SiteDeviceStatus) *float64, unit string) string {
	if loop == nil {
		return "–"
	}
	return value(get(loop), unit)
}

// treatment is one row of the summary's treatments, with Path the data page listing its kind
type treatment struct {
	At     int64
	Kind   string
	Path   string
	Detail string
}

// treatments are the summary's insulin, food, temp targets and temp basals in one list, newest first
func treatments(s *sitemodels.Summary) []treatment {
	list := []treatment{}
	for _, d := range s.InsulinDoses {
		list = append(list, treatment{d.OccurredAt, "Insulin", "/data/insulin", value(&d.Dose, " U")})
	}
	for _, f := range s.FoodIntakes {
		list = append(list, treatment{f.OccurredAt, "Food", "/data/food", value(f.Carbs, " g carbs")})
	}
	for _, t := range s.TempTargets {
		detail := fmt.Sprintf("%s–%s %s for %d min", site_data_templ.FormatGlucose(t.LowTarget, t.Units), site_data_templ.FormatGlucose(t.HighTarget, t.Units), unitsText(t.Units), t.DurationMinutes)
		list = append(list, treatment{t.OccurredAt, "Temp Target", "/data/temp-targets", detail})
	}
	for _, b := range s.TempBasals {
		list = append(list, treatment{b.OccurredAt, "Temp Basal", "/data/temp-basals", fmt.Sprintf("%s for %d min", value(b.Rate, " U/hr"), b.DurationMinutes)})
	}
	sort.SliceStable(list, func(i, j int) bool { return list[i].At > list[j].At })
	return list
}

// intake is a dose of insulin or a meal's carbs, at a time in milliseconds, with SMB set for a loop's small bolus
type intake struct {
	At             int64
	Insulin, Carbs string
	SMB            bool
}

// insulinAndCarbs are the summary's doses and carbs in one list, newest first, each in its own column
func insulinAndCarbs(s *sitemodels.Summary) []intake {
	list := []intake{}
	for _, d := range s.InsulinDoses {
		list = append(list, intake{At: d.OccurredAt, Insulin: value(&d.Dose, " U"), SMB: isSMB(d)})
	}
	for _, f := range s.FoodIntakes {
		if f.Carbs != nil {
			list = append(list, intake{At: f.OccurredAt, Carbs: value(f.Carbs, " g")})
		}
	}
	sort.SliceStable(list, func(i, j int) bool { return list[i].At > list[j].At })
	return list
}

// currentMinute is the targets and basal in force now, the summary's last minute up to now
func currentMinute(s *sitemodels.Summary) sitemodels.SummaryMinute {
	if len(s.Minutes) == 0 {
		return sitemodels.SummaryMinute{}
	}
	return s.Minutes[max(0, min(len(s.Minutes)-1, int((time.Now().UnixMilli()-s.Since)/60_000)))]
}

// glucoseSpan is a low to high glucose with its units, as 5.5–6.7 mmol/L, or a dash when either is not set
func glucoseSpan(low, high *float64, units *consts.Units) string {
	if low == nil || high == nil {
		return "–"
	}
	return site_data_templ.FormatGlucose(*low, units) + "–" + site_data_templ.FormatGlucose(*high, units) + " " + unitsText(units)
}

// ago is how long ago ms was, or a dash when it is not set
func ago(ms *int64) string {
	if ms == nil {
		return "–"
	}
	return display.RoundedAgo(*ms, time.Now())
}

// numbersAndUnits splits a tile's text into its numbers and the words between them, as "2", " days ", "1", " hour ago"
var numbersAndUnits = regexp.MustCompile(`[\d.–]+|[^\d.–]+`)

// isUnit is whether a part of a tile's text is words, not a number or a dash
func isUnit(part string) bool {
	return strings.Trim(part, "0123456789.–") != ""
}

func orDash(v *string) string {
	if v == nil {
		return "–"
	}
	return *v
}

// ranges are the time ranges the summary offers, up to the week it is capped at
var ranges = []struct {
	Hours int64
	Label string
}{{6, "6h"}, {24, "24h"}, {48, "48h"}, {7 * 24, "Week"}}

// rangeButton reloads the summary over another range, so back and forward move between them
templ rangeButton(hours int64, label string, selected bool) {
	{{ variant := button.VariantOutline }}
	if selected {
		{{ variant = button.VariantDefault }}
	}
	@button.Button(button.Props{
		ID:      fmt.Sprintf("site--summary--range-%d", hours),
		Variant: variant,
		Size:    button.SizeSm,
		Attributes: templ.Attributes{
			"hx-get":      fmt.Sprintf("/?hours=%d", hours),
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

// Summary is the site's home page: the latest glucose, IOB and COB, then everything since the summary starts.
// It streams the summary's events, shown Live while connected, and reloads its content a second after changes stop
// arriving, and when the stream reconnects, as changes may have been missed while it was not. The header, with the
// stream, is not reloaded, so the stream stays open.
templ Summary(summary *sitemodels.Summary) {
	@heading.Title("Summary")
	<div id="site--summary" class="w-full space-y-4 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<div class="flex items-center gap-2">
					<h1 class="text-2xl font-bold">Summary</h1>
					<span
						id="site--summary--live"
						class="hidden text-sm font-medium text-primary"
						hx-sse:connect="/data/summary/events"
						hx-on::sse:after:connection="this.classList.remove('hidden'); if (this.dataset.connected) htmx.trigger(this, 'reconnected'); this.dataset.connected = 'true'"
						hx-on::sse:close="this.classList.add('hidden')"
						hx-on::sse:error="this.classList.add('hidden')"
					>● Live</span>
				</div>
				<span id="site--summary--hours" class="text-sm text-gray-500">{ fmt.Sprintf("Last %d hours", summary.Hours) }</span>
			</div>
			<div class="flex gap-1">
				for _, r := range ranges {
					@rangeButton(r.Hours, r.Label, summary.Hours == r.Hours)
				}
			</div>
		</div>
		<div
			id="site--summary--content"
			class="space-y-4"
			hx-get={ fmt.Sprintf("/?hours=%d", summary.Hours) }
			hx-trigger="created from:#site--summary--live delay:1s, updated from:#site--summary--live delay:1s, deleted from:#site--summary--live delay:1s, reconnected from:#site--summary--live"
			hx-select="#site--summary--content"
			hx-target="this"
			hx-swap="outerHTML"
		>
			if isNew(summary) {
				@GettingStarted()
			} else {
				@summaryContent(summary)
			}
		</div>
		<div id="modal-container"></div>
	</div>
}

// summaryContent is everything in the summary below its header, which reloads as the summary's data changes: the
// latest glucose and the graph, then two large tables, of the insulin and carbs and of today's and yesterday's
// numbers with those now, as Carer shows them, and under them the smaller tables of every treatment and reading
templ summaryContent(summary *sitemodels.Summary) {
	@glucoseHero(summary)
	<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		@Graph(summary)
	</section>
	<div class="grid gap-4 lg:grid-cols-2">
		@section("Insulin & Carbs", "", "", "", "max-h-[calc(100vh-5rem)]") {
			@insulinCarbsTable(insulinAndCarbs(summary))
		}
		@section("Today & Yesterday", "", "", "", "") {
			@daysTable(summary)
		}
	</div>
	<div class="grid gap-4 lg:grid-cols-2">
		@section("Treatments", "", "", "", "max-h-64") {
			@treatmentsTable(treatments(summary))
		}
		@section("Glucose Readings", "site--summary--all-readings", "All readings", "/data/glucose", "max-h-64") {
			@readingsTable(summary)
		}
	</div>
	<section id="site--summary--devices" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		for _, status := range summary.DeviceStatuses {
			@deviceCard(status)
		}
	</section>
}

// insulinCarbsTable is each dose and meal large, newest first, with how long ago it was; a loop's SMBs are marked
templ insulinCarbsTable(list []intake) {
	@table.Table(table.Props{ID: "site--summary--insulin-carbs", Class: "text-base sm:text-lg"}) {
		@heads("When", "Insulin", "Carbs")
		@table.Body() {
			if len(list) == 0 {
				<tr><td colspan="3" class="p-4 text-sm text-gray-500">No insulin or carbs in this time.</td></tr>
			}
			for _, i := range list {
				@table.Row() {
					@table.Cell(table.CellProps{Class: "whitespace-nowrap text-sm text-gray-600"}) {
						<span title={ site_data_templ.FormatDate(ctx, i.At) }>{ display.RoundedAgo(i.At, time.Now()) }</span>
					}
					@table.Cell(table.CellProps{Class: "text-right font-bold tabular-nums text-primary"}) {
						if i.SMB {
							<span class="mr-2 text-xs font-medium text-gray-500">SMB</span>
						}
						@numbers(i.Insulin, "text-sm font-medium text-gray-500")
					}
					@table.Cell(table.CellProps{Class: "text-right font-bold tabular-nums text-gray-900"}) {
						@numbers(i.Carbs, "text-sm font-medium text-gray-500")
					}
				}
			}
		}
	}
}

// daysTable is today's and yesterday's time in range and total daily dose, then what is in force now: the loop's IOB
// and COB, the basal, target and range, the pump's reservoir, the phone's battery, and the sensor and site's ages
templ daysTable(summary *sitemodels.Summary) {
	{{ minute := currentMinute(summary) }}
	{{ loop := func(get func(*sitemodels.SiteDeviceStatus) *float64, unit string) string { return loopValue(summary.Loop, get, unit) } }}
	@table.Table(table.Props{ID: "site--summary--days", Class: "text-base sm:text-lg"}) {
		@heads("", "Today", "Yesterday")
		@table.Body() {
			@dayRow("time-in-range", "Time in range", value(summary.Today.TimeInRange, "%"), value(summary.Yesterday.TimeInRange, "%"))
			@dayRow("total-daily-dose", "Total daily dose", value(&summary.Today.TotalDailyDose, " U"), value(&summary.Yesterday.TotalDailyDose, " U"))
			<tr class="border-b"><th colspan="3" class="h-10 px-2 pt-4 text-left font-medium text-muted-foreground">Now</th></tr>
			@nowRow("iob", "Insulin on board", loop(func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopIob }, " U"))
			@nowRow("cob", "Carbs on board", loop(func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopCob }, " g"))
			@nowRow("basal", "Basal", value(minute.Basal, " U/hr"))
			@nowRow("target", "Target", glucoseSpan(minute.LowTarget, minute.HighTarget, summary.Units))
			@nowRow("range", "Range", glucoseSpan(&summary.RangeLow, &summary.RangeHigh, summary.Units))
			@nowRow("reservoir", "Reservoir", loop(func(s *sitemodels.SiteDeviceStatus) *float64 { return s.PumpReservoir }, " U"))
			@nowRow("phone-battery", "Phone battery", loop(func(s *sitemodels.SiteDeviceStatus) *float64 { return s.DeviceBatteryPercent }, "%"))
			@nowRow("sensor-started", "Sensor started", ago(summary.SensorStartedAt))
			@nowRow("site-changed", "Site changed", ago(summary.SiteChangedAt))
		}
	}
}

// heads are a large table's column names, the first on the left and the rest, of numbers, on the right
templ heads(labels ...string) {
	@table.Header() {
		@table.Row() {
			for i, label := range labels {
				@table.Head(table.HeadProps{Class: map[bool]string{true: "text-right"}[i > 0]}) {
					{ label }
				}
			}
		}
	}
}

templ dayRow(id, label, today, yesterday string) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "text-sm text-gray-600"}) {
			{ label }
		}
		@table.Cell(table.CellProps{ID: "site--summary--" + id, Class: "text-right font-bold tabular-nums text-gray-900"}) {
			@numbers(today, "text-sm font-medium text-gray-500")
		}
		@table.Cell(table.CellProps{ID: "site--summary--" + id + "--yesterday", Class: "text-right font-bold tabular-nums text-gray-600"}) {
			@numbers(yesterday, "text-sm font-medium text-gray-500")
		}
	}
}

// nowRow is a value in force now, across both days' columns
templ nowRow(id, label, text string) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "text-sm text-gray-600"}) {
			{ label }
		}
		@table.Cell(table.CellProps{ID: "site--summary--" + id, Class: "text-right font-bold tabular-nums text-gray-900", Attributes: templ.Attributes{"colspan": "2"}}) {
			@numbers(text, "text-sm font-medium text-gray-500")
		}
	}
}

templ glucoseHero(summary *sitemodels.Summary) {
	<div id="site--summary--glucose" class="flex flex-wrap items-end justify-between gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		if len(summary.GlucoseReadings) > 0 {
			{{ latest := summary.GlucoseReadings[0] }}
			{{ outOfRange := glucoseRange(summary, latest.Reading) }}
			<div>
				<div class="text-sm font-semibold uppercase tracking-wide text-gray-500">Glucose</div>
				<div class="flex items-baseline gap-2">
					<span id="site--summary--glucose--reading" class={ "text-6xl font-extrabold tracking-tight", rangeColours[outOfRange] }>{ site_data_templ.FormatGlucose(latest.Reading, latest.Units) }</span>
					<span class="text-lg text-gray-500">{ unitsText(latest.Units) }</span>
					<span class="ml-2 text-4xl text-gray-700">{ arrow(latest.Direction) }</span>
					if outOfRange != "" {
						<span id="site--summary--glucose--range" class={ "ml-2 text-2xl font-bold", rangeColours[outOfRange] }>{ outOfRange }</span>
					}
				</div>
				<div id="site--summary--glucose--ago" class="mt-1 text-sm text-gray-500" title={ site_data_templ.FormatDate(ctx, latest.OccurredAt) }>{ display.RoundedAgo(latest.OccurredAt, time.Now()) }</div>
			</div>
		} else {
			<div>
				<div class="text-2xl font-bold text-gray-900">No glucose readings in this time</div>
				<div class="mt-1 text-sm text-gray-500">
					Upload from your phone, or connect a source in
					<a
						id="site--summary--sync-link"
						href="/settings/sync"
						hx-get="/settings/sync"
						hx-target="#main-content"
						hx-push-url="true"
						hx-swap="innerHTML"
						class="text-primary underline"
					>Sync</a>.
				</div>
			</div>
		}
	</div>
}

// numbers shows a value's numbers as they are and its units, as in "0.7 U" or "2 days 1 hour ago", smaller and grey;
// text with no number, as "just now", is shown as it is
templ numbers(text, unitClass string) {
	{{ parts := numbersAndUnits.FindAllString(text, -1) }}
	for _, part := range parts {
		if len(parts) > 1 && isUnit(part) {
			<span class={ unitClass }>{ part }</span>
		} else {
			{ part }
		}
	}
}

// deviceCard is a device's latest status; clicking it opens all its details
templ deviceCard(status *sitemodels.SiteDeviceStatus) {
	<button
		id={ "site--summary--device--" + status.ID }
		class="rounded-xl border border-gray-200 bg-white p-4 text-left shadow-sm hover:bg-gray-50"
		hx-get={ "/data/device-status/" + status.ID }
		hx-target="#modal-container"
		hx-swap="innerHTML"
	>
		<div class="flex items-baseline justify-between gap-2">
			<span class="truncate font-semibold text-brand-night">{ orDash(status.CreatedByDeviceName) }</span>
			<span class="whitespace-nowrap text-xs text-gray-500" title={ site_data_templ.FormatDate(ctx, status.OccurredAt) }>{ display.RoundedAgo(status.OccurredAt, time.Now()) }</span>
		</div>
		<dl class="mt-2 grid grid-cols-3 gap-x-3 gap-y-1 text-sm">
			@detail("Phone", value(status.DeviceBatteryPercent, "%"))
			@detail("Reservoir", value(status.PumpReservoir, " U"))
			@detail("Pump", value(status.PumpBatteryPercent, "%"))
			@detail("IOB", value(status.LoopIob, " U"))
			@detail("COB", value(status.LoopCob, " g"))
		</dl>
	</button>
}

templ detail(label, text string) {
	<div>
		<dt class="text-xs text-gray-500">{ label }</dt>
		<dd class="font-medium tabular-nums">
			@numbers(text, "text-xs font-normal text-gray-500")
		</dd>
	</div>
}

// pageLink opens another of the site's pages in place of this one, so back returns here
templ pageLink(id, path, class string) {
	<a
		if id != "" {
			id={ id }
		}
		href={ templ.SafeURL(path) }
		hx-get={ path }
		hx-target="#main-content"
		hx-push-url="true"
		hx-swap="innerHTML"
		class={ class }
	>
		{ children... }
	</a>
}

// section is a titled list on the summary, with a link to the page of all its records when it has one, scrolling
// past height
templ section(title, linkID, linkText, path, height string) {
	<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<div class="mb-2 flex items-baseline justify-between gap-2">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{ title }</h2>
			if path != "" {
				@pageLink(linkID, path, "text-sm text-primary underline") {
					{ linkText }
				}
			}
		</div>
		<div class={ height, "overflow-y-auto" }>
			{ children... }
		</div>
	</section>
}

templ treatmentsTable(list []treatment) {
	@table.Table(table.Props{ID: "site--summary--treatments", Class: "text-xs"}) {
		@table.Body() {
			if len(list) == 0 {
				<tr><td class="p-4 text-sm text-gray-500">No treatments in this time.</td></tr>
			}
			for _, t := range list {
				@table.Row() {
					@table.Cell() {
						<span class="whitespace-nowrap" title={ site_data_templ.FormatDate(ctx, t.At) }>{ display.RoundedAgo(t.At, time.Now()) }</span>
					}
					@table.Cell() {
						@pageLink("", t.Path, "whitespace-nowrap font-medium text-primary underline") {
							{ t.Kind }
						}
					}
					@table.Cell() {
						{ t.Detail }
					}
				}
			}
		}
	}
}

templ readingsTable(summary *sitemodels.Summary) {
	{{ readings := summary.GlucoseReadings }}
	@table.Table(table.Props{ID: "site--summary--readings", Class: "text-xs"}) {
		@table.Body() {
			if len(readings) == 0 {
				<tr><td class="p-4 text-sm text-gray-500">No glucose readings in this time.</td></tr>
			}
			for _, r := range readings {
				@table.Row() {
					@table.Cell() {
						<span class="whitespace-nowrap" title={ site_data_templ.FormatDate(ctx, r.OccurredAt) }>{ display.RoundedAgo(r.OccurredAt, time.Now()) }</span>
					}
					@table.Cell() {
						<span class={ "font-medium tabular-nums", rangeColours[glucoseRange(summary, r.Reading)] }>{ site_data_templ.FormatGlucose(r.Reading, r.Units) }</span> { arrow(r.Direction) }
					}
				}
			}
		}
	}
}
