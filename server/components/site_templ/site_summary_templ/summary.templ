package site_summary_templ

import (
	"fmt"
	"sort"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/display"
)

// directionArrows are the Nightscout trend directions as arrows
var directionArrows = map[string]string{
	"DoubleUp": "⇈", "SingleUp": "↑", "FortyFiveUp": "↗", "Flat": "→",
	"FortyFiveDown": "↘", "SingleDown": "↓", "DoubleDown": "⇊",
}

func arrow(direction *string) string {
	if direction == nil {
		return ""
	}
	return directionArrows[*direction]
}

// rangeColours colour a reading below the low alarm, above the high alarm and between them with the theme's glucose
// colours, as the graph colours its dots
var rangeColours = map[string]string{"Low": "text-glucose-low", "High": "text-glucose-high", "": "text-glucose-in-range"}

// value shows an optional number with its unit, or a dash when it is not set
func value(v *float64, unit string) string {
	if v == nil {
		return "–"
	}
	return fmt.Sprintf("%g%s", consts.Round(*v, 2), unit)
}

func unitsText(units *consts.Units) string {
	if units == nil {
		return ""
	}
	return string(*units)
}

// loopValue is a value from the loop's latest status, or a dash when there is none
func loopValue(loop *sitemodels.SiteDeviceStatus, get func(*sitemodels.SiteDeviceStatus) *float64, unit string) string {
	if loop == nil {
		return "–"
	}
	return value(get(loop), unit)
}

type treatment struct {
	At     int64
	Kind   string
	Detail string
}

// treatments are the summary's insulin, food, temp targets and temp basals in one list, newest first
func treatments(s *sitemodels.Summary) []treatment {
	list := []treatment{}
	for _, d := range s.InsulinDoses {
		list = append(list, treatment{d.OccurredAt, "Insulin", value(&d.Dose, " U")})
	}
	for _, f := range s.FoodIntakes {
		list = append(list, treatment{f.OccurredAt, "Food", value(f.Carbs, " g carbs")})
	}
	for _, t := range s.TempTargets {
		detail := fmt.Sprintf("%s–%s %s for %d min", site_data_templ.FormatGlucose(t.LowTarget, t.Units), site_data_templ.FormatGlucose(t.HighTarget, t.Units), unitsText(t.Units), t.DurationMinutes)
		list = append(list, treatment{t.OccurredAt, "Temp Target", detail})
	}
	for _, b := range s.TempBasals {
		list = append(list, treatment{b.OccurredAt, "Temp Basal", fmt.Sprintf("%s for %d min", value(b.Absolute, " U/hr"), b.DurationMinutes)})
	}
	sort.SliceStable(list, func(i, j int) bool { return list[i].At > list[j].At })
	return list
}

// ago is how long ago ms was, or a dash when it is not set
func ago(ms *int64) string {
	if ms == nil {
		return "–"
	}
	return display.TimeAgo(*ms, time.Now())
}

func orDash(v *string) string {
	if v == nil {
		return "–"
	}
	return *v
}

// ranges are the time ranges the summary offers, up to the week it is capped at
var ranges = []struct {
	Hours int64
	Label string
}{{6, "6h"}, {24, "24h"}, {48, "48h"}, {7 * 24, "Week"}}

// rangeButton reloads the summary over another range, so back and forward move between them
templ rangeButton(hours int64, label string, selected bool) {
	{{ variant := button.VariantOutline }}
	if selected {
		{{ variant = button.VariantDefault }}
	}
	@button.Button(button.Props{
		ID:      fmt.Sprintf("site--summary--range-%d", hours),
		Variant: variant,
		Size:    button.SizeSm,
		Attributes: templ.Attributes{
			"hx-get":      fmt.Sprintf("/?hours=%d", hours),
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

// Summary is the site's home page: the latest glucose, IOB and COB, then everything since the summary starts.
// It streams the summary's events, shown Live while connected, and reloads its content a second after changes stop
// arriving, and when the stream reconnects, as changes may have been missed while it was not. The header, with the
// stream, is not reloaded, so the stream stays open.
templ Summary(summary *sitemodels.Summary) {
	<div id="site--summary" class="w-full space-y-4 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h1 class="text-2xl font-bold">Summary</h1>
				<span id="site--summary--hours" class="text-sm text-gray-500">{ fmt.Sprintf("Last %d hours", summary.Hours) }</span>
				<span
					id="site--summary--live"
					class="ml-2 hidden text-sm font-medium text-primary"
					hx-sse:connect="/data/summary/events"
					hx-on::sse:after:connection="this.classList.remove('hidden'); if (this.dataset.connected) htmx.trigger(this, 'reconnected'); this.dataset.connected = 'true'"
					hx-on::sse:close="this.classList.add('hidden')"
					hx-on::sse:error="this.classList.add('hidden')"
				>● Live</span>
			</div>
			<div class="flex gap-1">
				for _, r := range ranges {
					@rangeButton(r.Hours, r.Label, summary.Hours == r.Hours)
				}
			</div>
		</div>
		<div
			id="site--summary--content"
			class="space-y-4"
			hx-get={ fmt.Sprintf("/?hours=%d", summary.Hours) }
			hx-trigger="created from:#site--summary--live delay:1s, updated from:#site--summary--live delay:1s, deleted from:#site--summary--live delay:1s, reconnected from:#site--summary--live"
			hx-select="#site--summary--content"
			hx-target="this"
			hx-swap="outerHTML"
		>
			@summaryContent(summary)
		</div>
		<div id="modal-container"></div>
	</div>
}

// summaryContent is everything in the summary below its header, which reloads as the summary's data changes
templ summaryContent(summary *sitemodels.Summary) {
	@glucoseHero(summary)
	<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
		@tile("site--summary--iob", "Insulin on board", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopIob }, " U"), icon.Syringe)
		@tile("site--summary--cob", "Carbs on board", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.LoopCob }, " g"), icon.Utensils)
		@tile("site--summary--reservoir", "Reservoir", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.PumpReservoir }, " U"), icon.Gauge)
		@tile("site--summary--phone-battery", "Phone battery", loopValue(summary.Loop, func(s *sitemodels.SiteDeviceStatus) *float64 { return s.DeviceBatteryPercent }, "%"), icon.Smartphone)
	</div>
	<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
		@tile("site--summary--time-in-range", "Time in range", value(summary.Today.TimeInRange, "%"), icon.Target) {
			@yesterday("site--summary--time-in-range--yesterday", value(summary.Yesterday.TimeInRange, "%"))
		}
		@tile("site--summary--total-daily-dose", "Total daily dose", value(&summary.Today.TotalDailyDose, " U"), icon.Droplet) {
			@yesterday("site--summary--total-daily-dose--yesterday", value(&summary.Yesterday.TotalDailyDose, " U"))
		}
		@tile("site--summary--sensor-started", "Sensor started", ago(summary.SensorStartedAt), icon.Activity)
		@tile("site--summary--site-changed", "Site changed", ago(summary.SiteChangedAt), icon.Bandage)
	</div>
	<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		@Graph(summary)
	</section>
	<div class="grid gap-4 lg:grid-cols-2">
		@section("Treatments") {
			@treatmentsTable(treatments(summary))
		}
		@section("Glucose Readings") {
			@readingsTable(summary)
		}
	</div>
	<section id="site--summary--devices" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		for _, status := range summary.DeviceStatuses {
			@deviceCard(status)
		}
	</section>
}

templ glucoseHero(summary *sitemodels.Summary) {
	<div id="site--summary--glucose" class="flex flex-wrap items-end justify-between gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		if len(summary.GlucoseReadings) > 0 {
			{{ latest := summary.GlucoseReadings[0] }}
			{{ outOfRange := glucoseRange(summary, latest.Reading) }}
			<div>
				<div class="text-sm font-semibold uppercase tracking-wide text-gray-500">Glucose</div>
				<div class="flex items-baseline gap-2">
					<span id="site--summary--glucose--reading" class={ "text-6xl font-extrabold tracking-tight", rangeColours[outOfRange] }>{ site_data_templ.FormatGlucose(latest.Reading, latest.Units) }</span>
					<span class="text-lg text-gray-500">{ unitsText(latest.Units) }</span>
					<span class="ml-2 text-4xl text-gray-700">{ arrow(latest.Direction) }</span>
					if outOfRange != "" {
						<span id="site--summary--glucose--range" class={ "ml-2 text-2xl font-bold", rangeColours[outOfRange] }>{ outOfRange }</span>
					}
				</div>
				<div id="site--summary--glucose--ago" class="mt-1 text-sm text-gray-500" title={ site_data_templ.FormatDate(ctx, latest.OccurredAt) }>{ display.TimeAgo(latest.OccurredAt, time.Now()) }</div>
			</div>
		} else {
			<div>
				<div class="text-2xl font-bold text-gray-900">No glucose readings in this time</div>
				<div class="mt-1 text-sm text-gray-500">
					Upload from your phone, or connect a source in
					<a
						id="site--summary--sync-link"
						href="/settings/sync"
						hx-get="/settings/sync"
						hx-target="#main-content"
						hx-push-url="true"
						hx-swap="innerHTML"
						class="text-primary underline"
					>Sync Settings</a>.
				</div>
			</div>
		}
	</div>
}

templ tile(id, label, text string, ic func(...icon.Props) templ.Component) {
	<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
			@ic(icon.Props{Class: "size-4"})
			{ label }
		</div>
		<div id={ id } class="mt-1 text-2xl font-bold tabular-nums text-gray-900">{ text }</div>
		{ children... }
	</div>
}

// yesterday is a day tile's value for yesterday, under today's
templ yesterday(id, text string) {
	<div id={ id } class="text-xs text-gray-500">Yesterday { text }</div>
}

// deviceCard is a device's latest status; clicking it opens all its details
templ deviceCard(status *sitemodels.SiteDeviceStatus) {
	<button
		id={ "site--summary--device--" + status.ID }
		class="rounded-xl border border-gray-200 bg-white p-4 text-left shadow-sm hover:bg-gray-50"
		hx-get={ "/data/device-status/" + status.ID }
		hx-target="#modal-container"
		hx-swap="innerHTML"
	>
		<div class="flex items-baseline justify-between gap-2">
			<span class="truncate font-semibold text-brand-night">{ orDash(status.CreatedByDeviceName) }</span>
			<span class="whitespace-nowrap text-xs text-gray-500" title={ site_data_templ.FormatDate(ctx, status.OccurredAt) }>{ display.TimeAgo(status.OccurredAt, time.Now()) }</span>
		</div>
		<dl class="mt-2 grid grid-cols-3 gap-x-3 gap-y-1 text-sm">
			@detail("Phone", value(status.DeviceBatteryPercent, "%"))
			@detail("Reservoir", value(status.PumpReservoir, " U"))
			@detail("Pump", value(status.PumpBatteryPercent, "%"))
			@detail("IOB", value(status.LoopIob, " U"))
			@detail("COB", value(status.LoopCob, " g"))
		</dl>
	</button>
}

templ detail(label, text string) {
	<div>
		<dt class="text-xs text-gray-500">{ label }</dt>
		<dd class="font-medium tabular-nums">{ text }</dd>
	</div>
}

templ section(title string) {
	<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">{ title }</h2>
		<div class="max-h-96 overflow-y-auto">
			{ children... }
		</div>
	</section>
}

templ treatmentsTable(list []treatment) {
	@table.Table(table.Props{ID: "site--summary--treatments"}) {
		@table.Body() {
			if len(list) == 0 {
				<tr><td class="p-4 text-sm text-gray-500">No treatments in this time.</td></tr>
			}
			for _, t := range list {
				@table.Row() {
					@table.Cell() {
						<span class="whitespace-nowrap" title={ site_data_templ.FormatDate(ctx, t.At) }>{ display.TimeAgo(t.At, time.Now()) }</span>
					}
					@table.Cell() {
						<span class="whitespace-nowrap font-medium">{ t.Kind }</span>
					}
					@table.Cell() {
						{ t.Detail }
					}
				}
			}
		}
	}
}

templ readingsTable(summary *sitemodels.Summary) {
	{{ readings := summary.GlucoseReadings }}
	@table.Table(table.Props{ID: "site--summary--readings"}) {
		@table.Body() {
			if len(readings) == 0 {
				<tr><td class="p-4 text-sm text-gray-500">No glucose readings in this time.</td></tr>
			}
			for _, r := range readings {
				@table.Row() {
					@table.Cell() {
						<span class="whitespace-nowrap" title={ site_data_templ.FormatDate(ctx, r.OccurredAt) }>{ display.TimeAgo(r.OccurredAt, time.Now()) }</span>
					}
					@table.Cell() {
						<span class={ "font-medium tabular-nums", rangeColours[glucoseRange(summary, r.Reading)] }>{ site_data_templ.FormatGlucose(r.Reading, r.Units) }</span> { arrow(r.Direction) }
					}
				}
			}
		}
	}
}
