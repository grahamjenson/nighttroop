package site_summary_templ

import (
	"fmt"
	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/site_templ"
	"nighttroop.t1d.nz/server/components/ui/icon"
)

func fmtPtr(v *int64, suffix string) string {
	if v == nil {
		return "–"
	}
	return fmt.Sprintf("%d%s", *v, suffix)
}

templ Summary(summary sitemodels.Summary) {
	@site_templ.SiteBase() {
		<div class="w-full py-4 space-y-4">
			@glucoseHero(summary)
			<div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
				@tile("Insulin on board", fmtPtr(summary.IOB, " U"), icon.Syringe)
				@tile("Carbs on board", fmtPtr(summary.COB, " g"), icon.Utensils)
				@tile("Profile", fmtPtr(summary.ProfilePercent, "%"), icon.Activity)
			</div>
			<!-- GRAPH -->
			<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
				<h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Last 24 hours</h2>
				if len(summary.Last24Hours) == 0 {
					<div class="flex h-48 items-center justify-center text-sm text-gray-400">No readings in the last 24 hours</div>
				} else {
					<div id="glucoseGraph" class="mt-2"></div>
					@templ.JSONScript("glucose-data", summary.Last24Hours)
				}
			</div>
			if len(summary.Alerts)+len(summary.Notifications) > 0 {
				<div class="flex flex-wrap gap-2">
					for _, a := range summary.Alerts {
						@pill(a, "bg-amber-100 text-amber-900")
					}
					for _, n := range summary.Notifications {
						@pill(n, "bg-gray-100 text-gray-700")
					}
				</div>
			}
		</div>
		<script>
    document.addEventListener("DOMContentLoaded", function () {
        const el = document.getElementById("glucose-data");
        if (!el) return;
        const points = JSON.parse(el.textContent).filter(p => p.GlucoseReading != null);
        const low = points[0].LowTarget ?? 70, high = points[0].HighTarget ?? 180;
        const width = 1000, height = 260, m = {top: 10, right: 16, bottom: 24, left: 36};
        const svg = d3.select("#glucoseGraph").append("svg")
            .attr("viewBox", `0 0 ${width} ${height}`).attr("class", "w-full h-auto");
        const now = Date.now();
        const x = d3.scaleTime().domain([now - 24 * 3600 * 1000, now]).range([m.left, width - m.right]);
        const y = d3.scaleLinear()
            .domain([Math.min(40, d3.min(points, p => p.GlucoseReading)), Math.max(250, d3.max(points, p => p.GlucoseReading))])
            .nice().range([height - m.bottom, m.top]);
        // target band, then axes, then the trace and readings
        svg.append("rect").attr("x", m.left).attr("width", width - m.left - m.right)
            .attr("y", y(high)).attr("height", y(low) - y(high)).attr("fill", "#dcfce7");
        svg.append("g").attr("transform", `translate(0,${height - m.bottom})`)
            .call(d3.axisBottom(x).ticks(6).tickFormat(d3.timeFormat("%H:%M"))).attr("color", "#9ca3af");
        svg.append("g").attr("transform", `translate(${m.left},0)`)
            .call(d3.axisLeft(y).ticks(5).tickSize(-(width - m.left - m.right))).attr("color", "#9ca3af")
            .call(g => g.selectAll(".tick line").attr("stroke", "#e5e7eb"));
        svg.append("path").datum(points).attr("fill", "none").attr("stroke", "#6b7280").attr("stroke-width", 1.5)
            .attr("d", d3.line().x(p => x(p.Timestamp)).y(p => y(p.GlucoseReading)));
        svg.selectAll("circle").data(points).join("circle")
            .attr("cx", p => x(p.Timestamp)).attr("cy", p => y(p.GlucoseReading)).attr("r", 3)
            .attr("fill", p => p.GlucoseReading > high ? "#f59e0b" : p.GlucoseReading < low ? "#e11d48" : "#16a34a");
    });
</script>
	}
}

templ glucoseHero(summary sitemodels.Summary) {
	<div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm flex flex-wrap items-end justify-between gap-4">
		if summary.Glucose != nil {
			<div>
				<div class="text-sm font-semibold uppercase tracking-wide text-gray-500">Glucose</div>
				<div class="flex items-baseline gap-2">
					<span class="text-6xl font-extrabold tracking-tight text-gray-900">{ summary.Glucose.ValueStr }</span>
					if summary.Units != nil {
						<span class="text-lg text-gray-500">{ string(*summary.Units) }</span>
					}
					<span class="ml-2 text-2xl font-semibold text-gray-700">{ summary.Glucose.Diff }</span>
				</div>
				<div class="mt-1 text-sm text-gray-500">{ summary.Glucose.TimeAgo }</div>
			</div>
		} else {
			<div>
				<div class="text-2xl font-bold text-gray-900">No glucose data yet</div>
				<div class="mt-1 text-sm text-gray-500">Upload from your phone, or connect a source under Settings → Sync.</div>
			</div>
		}
		if summary.Alarm != nil {
			<span class="rounded-full bg-rose-100 px-3 py-1 text-sm font-semibold text-rose-800">{ summary.Alarm.Name }</span>
		}
	</div>
}

templ tile(label, value string, ic func(...icon.Props) templ.Component) {
	<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
			@ic(icon.Props{Class: "size-4"})
			{ label }
		</div>
		<div class="mt-1 text-2xl font-bold tabular-nums text-gray-900">{ value }</div>
	</div>
}

templ pill(n sitemodels.Notification, color string) {
	<span class={ "rounded-full px-3 py-1 text-sm font-medium", color } title={ n.Tooltip }>{ n.Icon } { n.Value }</span>
}
