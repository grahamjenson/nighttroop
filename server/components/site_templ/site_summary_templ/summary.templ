package site_summary_templ

import (
	"nighttroop.t1d.nz/models/nighttroop"
	"nighttroop.t1d.nz/server/components/site_templ"
)

templ Summary(summary nighttroop.Summary) {
	@site_templ.SiteBase() {
		<div class="container-fluid p-4">
			<!-- TOP METRICS -->
			<!-- GRAPH -->
			<div class="card p-3 mb-4">
				<h5>Glucose Graph</h5>
				<div id="glucoseGraph" class="graph-container"></div>
			</div>
			<!-- LOWER METRICS -->
			<div class="row g-3">
				<div class="col-md-2">
					<div class="card p-3">
						<h6>BG</h6>
						<h4>114</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Delta</h6>
						<h4 class="text-danger">-3</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Basal Rate</h6>
						<h4>0.80 U/h</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Bolus</h6>
						<h4>2.0 U</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Carbs</h6>
						<h4>18 g</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Battery</h6>
						<div class="progress">
							<div class="progress-bar" style="width: 85%">85%</div>
						</div>
					</div>
				</div>
			</div>
			<!-- BOTTOM ROW -->
			<div class="row g-3 mt-3">
				<div class="col-md-4">
					<div class="card p-3">
						<h6>Recent Insulin</h6>
						<div>2.0 U, 26 min ago</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card p-3">
						<h6>Last Meal</h6>
						<div>18g carbs, 45 min ago</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card p-3">
						<h6>System Status</h6>
						<div>CGM ✔ PUMP ✔ CAREPORTAL ✔</div>
					</div>
				</div>
			</div>
		</div>
		<!-- D3 Example -->
		<script>
    document.addEventListener("DOMContentLoaded", function () {
        const svg = d3.select("#glucoseGraph")
            .append("svg")
            .attr("width", "100%")
            .attr("height", 300);

        // Placeholder line
        svg.append("line")
            .attr("x1", 0)
            .attr("y1", 150)
            .attr("x2", 1000)
            .attr("y2", 150)
            .attr("stroke", "#22c55e")
            .attr("stroke-width", 2);
    });
</script>
	}
}
