package site_summary_templ

import (
	"context"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/nav"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/utils/can"
	"nighttroop.t1d.nz/utils/httputils"
	"nighttroop.t1d.nz/utils/i18n"
)

// isNew is a summary of a site with no glucose for over a month, or ever, so the summary would be empty and guides
// setting the site up instead
func isNew(summary *sitemodels.Summary) bool {
	for _, day := range []sitemodels.SummaryDay{summary.Today, summary.Yesterday, summary.LastWeek, summary.LastFortnight, summary.LastMonth} {
		if day.TimeInRange != nil {
			return false
		}
	}
	return len(summary.GlucoseReadings) == 0 && len(summary.DeviceStatuses) == 0
}

// isAdmin is whether the identity signed in may set up where the site's data comes from and who can use it
func isAdmin(ctx context.Context) bool {
	siteContext := httputils.GetSiteContext(ctx)
	return siteContext != nil && siteContext.IdentityModel != nil && can.IdentityAdministerSite(siteContext.IdentityModel.Role)
}

// nsURL is the site's Nightscout URL, which phone apps upload to
func nsURL(ctx context.Context) string {
	if siteContext := httputils.GetSiteContext(ctx); siteContext != nil && siteContext.SiteDB != nil {
		return siteContext.SiteDB.NSURL()
	}
	return ""
}

// stepLinkClass is how a step's link to the page it is done on looks
const stepLinkClass = "inline-flex items-center rounded-lg bg-brand-night px-4 py-2 font-medium text-white hover:bg-brand-night/90"

// GettingStartedPage is the guide to setting up the site on a page of its own, from My Account
templ GettingStartedPage() {
	@heading.Title(i18n.T(ctx, "site.summary.getting_started.title"))
	<div class="w-full py-4">
		@GettingStarted()
	</div>
}

// GettingStarted guides setting up the site: getting glucose in, adding people and devices, its settings and alarms.
// An admin sees every step; others the ones they can do.
templ GettingStarted() {
	<div id="site--getting-started" class="space-y-6">
		<section class="rounded-xl bg-brand-night p-6 text-white shadow-sm">
			<h2 class="text-2xl font-bold">{ i18n.T(ctx, "site.summary.getting_started.welcome") }</h2>
			<p class="mt-2 max-w-2xl text-white/80">
				{ i18n.T(ctx, "site.summary.getting_started.intro") }
			</p>
		</section>
		<ol class="grid gap-4 md:grid-cols-2">
			if isAdmin(ctx) {
				@step("site--getting-started--data", "1", icon.Droplet, i18n.T(ctx, "site.summary.getting_started.data")) {
					<p><strong>{ i18n.T(ctx, "site.summary.getting_started.from_phone") }</strong> { i18n.T(ctx, "site.summary.getting_started.set_url") }</p>
					<div class="my-1 flex items-center gap-1 rounded bg-gray-100 py-0.5 pl-2 pr-1">
						<code id="site--getting-started--ns-url" class="min-w-0 flex-1 break-all text-gray-900">{ nsURL(ctx) }</code>
						@copybutton.CopyButton(copybutton.Props{ID: "site--getting-started--ns-url-copy", TargetID: "site--getting-started--ns-url", Label: i18n.T(ctx, "site.summary.getting_started.copy_url")})
					</div>
					<p>{ i18n.T(ctx, "site.summary.getting_started.with_token") }</p>
					<p class="mt-2"><strong>{ i18n.T(ctx, "site.summary.getting_started.from_cloud") }</strong> { i18n.T(ctx, "site.summary.getting_started.pull_from") }</p>
					<div class="mt-auto flex flex-wrap gap-2 pt-4">
						// Opens Users & Devices with its Add Device modal, which it opens when asked to as the page loads
						<a id="site--getting-started--add-device-link" href="/settings/identities" class={ stepLinkClass } onclick="try { sessionStorage.setItem('site--identities--add', 'device') } catch (e) {}" { nav.Attributes("/settings/identities")... }>
							{ i18n.T(ctx, "site.summary.getting_started.add_device_link") }
						</a>
						@nav.Link("site--getting-started--connectors-link", "/settings/connectors", stepLinkClass) {
							{ i18n.T(ctx, "site.summary.getting_started.connectors_link") }
						}
					</div>
				}
				@step("site--getting-started--identities", "2", icon.Users, i18n.T(ctx, "site.summary.getting_started.identities")) {
					<p>{ i18n.T(ctx, "site.summary.getting_started.identities_text") }</p>
					@stepLink("site--getting-started--identities-link", "/settings/identities", i18n.T(ctx, "site.summary.getting_started.identities_link"))
				}
			}
			@step("site--getting-started--settings", "", icon.SlidersHorizontal, i18n.T(ctx, "site.summary.getting_started.settings")) {
				<p>{ i18n.T(ctx, "site.summary.getting_started.settings_text") }</p>
				@stepLink("site--getting-started--settings-link", "/settings", i18n.T(ctx, "site.summary.getting_started.settings_link"))
			}
			@step("site--getting-started--alarms", "", icon.BellRing, i18n.T(ctx, "site.summary.getting_started.alarms")) {
				<p>{ i18n.T(ctx, "site.summary.getting_started.alarms_text") }</p>
				@stepLink("site--getting-started--alarms-link", "/settings/alarms", i18n.T(ctx, "site.summary.getting_started.alarms_link"))
			}
		</ol>
		if !isAdmin(ctx) {
			<p id="site--getting-started--not-admin" class="text-sm text-gray-600">{ i18n.T(ctx, "site.summary.getting_started.not_admin") }</p>
		}
		// Where each kind of page is, each a link to it, as a new user does not know the header's words yet
		<section id="site--getting-started--where" class="panel p-5 text-sm text-gray-700">
			<h3 class="mb-2 text-base font-semibold text-gray-900">{ i18n.T(ctx, "site.summary.getting_started.where") }</h3>
			<ul class="grid gap-x-6 gap-y-2 sm:grid-cols-2">
				@whereItem("site--getting-started--where-data", "/data/glucose", i18n.T(ctx, "site.nav.hubs.data"), i18n.T(ctx, "site.summary.getting_started.where_data"))
				@whereItem("site--getting-started--where-reports", "/reports", i18n.T(ctx, "site.nav.hubs.reports"), i18n.T(ctx, "site.summary.getting_started.where_reports"))
				@whereItem("site--getting-started--where-account", "/settings/account", i18n.T(ctx, "site.base.my_account"), i18n.T(ctx, "site.summary.getting_started.where_menu"))
				<li><strong class="text-gray-900">{ i18n.T(ctx, "site.nav.search_pages") }</strong>{ " " + i18n.T(ctx, "site.summary.getting_started.where_search") }</li>
			</ul>
		</section>
	</div>
}

// whereItem is one place in the site: a link to it, by its name in the header, then what is there
templ whereItem(id, path, name, what string) {
	<li>
		@nav.Link(id, path, "font-semibold text-brand-night underline") {
			{ name }
		}
		{ " " + what }
	</li>
}

// step is one numbered card of the guide, or unnumbered when it can be done in any order
templ step(id, number string, ic func(...icon.Props) templ.Component, title string) {
	<li id={ id } class="panel flex flex-col p-5 text-sm text-gray-700">
		<div class="mb-3 flex items-center gap-3">
			<span class="flex size-9 items-center justify-center rounded-full bg-brand-gold/20 text-brand-night">
				@ic(icon.Props{Class: "size-5"})
			</span>
			<h3 class="text-base font-semibold text-gray-900">
				if number != "" {
					{ number + ". " }
				}
				{ title }
			</h3>
		</div>
		{ children... }
	</li>
}

// stepLink opens the page a step is done on, at the bottom of its card
templ stepLink(id, path, text string) {
	<div class="mt-auto pt-4">
		@nav.Link(id, path, stepLinkClass) {
			{ text }
		}
	</div>
}
