package site_reports_templ

import (
	"context"
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/site_templ/site_data_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/table"
	"nighttroop.t1d.nz/server/components/ui/toast"
	"nighttroop.t1d.nz/utils/display"
)

// periods are what a report can be of
var periods = []struct{ Period, Label string }{{"day", "Day"}, {"week", "Week"}, {"fortnight", "Fortnight"}, {"month", "Month"}}

// days are a report's first and last days, the last no later than today, in the site's timezone
func days(ctx context.Context, p *sitemodels.SiteSummaryPeriod) (time.Time, time.Time) {
	location := site_data_templ.Location(ctx)
	last := time.UnixMilli(p.End).In(location).AddDate(0, 0, -1)
	if now := time.Now().In(location); last.After(now) {
		last = now
	}
	return time.UnixMilli(p.Start).In(location), last
}

// title names the report's day, as Fri 6 Nov 2026, its month, as October 2026, or its first and last days
func title(ctx context.Context, p *sitemodels.SiteSummaryPeriod) string {
	first, _ := days(ctx, p)
	last := time.UnixMilli(p.End).In(first.Location()).AddDate(0, 0, -1)
	switch p.Period {
	case "day":
		return first.Format("Mon 2 Jan 2006")
	case "month":
		return first.Format("January 2006")
	}
	return first.Format("2 Jan") + " – " + last.Format("2 Jan 2006")
}

// link is the path of the report of period with date in it, from today back a year, or "" for one out of that range
func link(period string, date time.Time) string {
	now := time.Now().In(date.Location())
	if day := date.Format(time.DateOnly); day <= now.Format(time.DateOnly) && day >= now.AddDate(0, 0, -366).Format(time.DateOnly) {
		return "/reports/" + period + "-" + day
	}
	return ""
}

// Report is the AGP report of a day, week, fortnight or month: its time in range, daily dose and carbs, and its AGP,
// with buttons to the report of another kind of period ending on the same day, and to the period before and after
templ Report(p *sitemodels.SiteSummaryPeriod) {
	{{ first, last := days(ctx, p) }}
	@heading.Title("AGP")
	<div id="site--reports" class="w-full space-y-4 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h1 class="text-2xl font-bold">AGP</h1>
				<span id="site--reports--title" class="text-sm text-gray-500">{ title(ctx, p) }</span>
			</div>
			<div class="flex flex-wrap gap-1">
				@reportKinds(p.Period, last)
				@reportButton("site--reports--previous", link(p.Period, first.AddDate(0, 0, -1)), false) {
					Previous
				}
				@reportButton("site--reports--next", link(p.Period, time.UnixMilli(p.End).In(first.Location())), false) {
					Next
				}
			</div>
		</div>
		<dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
			@stat("site--reports--days", "Days with data", fmt.Sprint(p.Days))
			@stat("site--reports--time-in-range", "Time in range", display.Value(p.TimeInRange, "%"))
			@stat("site--reports--daily-dose", "Daily dose", display.PerDay(p.Days, p.TotalDailyDose, " U"))
			@stat("site--reports--daily-carbs", "Daily carbs", display.PerDay(p.Days, p.TotalDailyCarbs, " g"))
		</dl>
		<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
			<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Ambulatory glucose profile</h2>
			if hasGlucose(p) {
				{{ low, high := site_data_templ.RangeBounds(ctx) }}
				{{ chart := agp(p, low, high) }}
				<div id="site--reports--agp" class="h-90 w-full text-xs">
					<div id={ chart.ChartID } class="h-full w-full"></div>
					@templ.Raw(chart.RenderSnippet().Script)
				</div>
			} else {
				<p id="site--reports--no-glucose" class="text-sm text-gray-500">No glucose in this { p.Period }.</p>
			}
		</section>
	</div>
}

// reportKinds are buttons to the report of each period ending on last, one selected
templ reportKinds(selected string, last time.Time) {
	for _, kind := range periods {
		@reportButton("site--reports--period-"+kind.Period, link(kind.Period, last), kind.Period == selected) {
			{ kind.Label }
		}
	}
}

// TDDReport is the total daily dose of each day of the week, fortnight or month before today: a bar of each day with
// insulin, how many days had it and their mean, lowest and highest, and a table of every day's dose, newest first
templ TDDReport(rangeName string, days []*sitemodels.SiteSummaryDaily) {
	{{ last := time.Now().In(site_data_templ.Location(ctx)).AddDate(0, 0, -1) }}
	{{ first := last.AddDate(0, 0, 1-TDDRangeDays(rangeName)) }}
	{{ withInsulin := dosed(days) }}
	{{ mean, lowest, highest := tddStats(withInsulin) }}
	@heading.Title("TDD")
	<div id="site--reports" class="w-full space-y-4 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h1 class="text-2xl font-bold">TDD</h1>
				<span id="site--reports--title" class="text-sm text-gray-500">Total daily dose, { first.Format("Mon 2 Jan") } to { last.Format("Mon 2 Jan 2006") }</span>
			</div>
			<div class="flex flex-wrap gap-1">
				for _, r := range tddRanges {
					@reportButton("site--reports--tdd--range-"+r.Name, "/reports/tdd?range="+r.Name, r.Name == rangeName) {
						{ r.Label }
					}
				}
			</div>
		</div>
		<dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
			@stat("site--reports--tdd--days", "Days with insulin", fmt.Sprint(len(withInsulin)))
			@stat("site--reports--tdd--mean", "Daily dose", display.Value(mean, " U"))
			@stat("site--reports--tdd--lowest", "Lowest", display.Value(lowest, " U"))
			@stat("site--reports--tdd--highest", "Highest", display.Value(highest, " U"))
		</dl>
		<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
			<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Total daily dose</h2>
			if len(withInsulin) > 0 {
				{{ chart := tddChart(withInsulin, first, last) }}
				<div id="site--reports--tdd--chart" class="h-90 w-full text-xs">
					<div id={ chart.ChartID } class="h-full w-full"></div>
					@templ.Raw(chart.RenderSnippet().Script)
				</div>
			} else {
				<p id="site--reports--tdd--empty" class="text-sm text-gray-500">No insulin on these days.</p>
			}
		</section>
		<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
			<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">Each day</h2>
			@table.Table(table.Props{ID: "site--reports--tdd--table", Class: "rounded-lg border border-gray-200"}) {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Day
						}
						@table.Head(table.HeadProps{Class: "text-right tabular-nums"}) {
							Total daily dose
						}
					}
				}
				@table.Body() {
					for _, row := range tddRows(days, first, last) {
						{{ date, _ := time.Parse(time.DateOnly, row.Date) }}
						@table.Row(table.RowProps{ID: "site--reports--tdd--day-" + row.Date}) {
							@table.Cell() {
								{ date.Format("Mon 2 Jan 2006") }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ display.Value(row.Dose, " U") }
							}
						}
					}
				}
			}
		</section>
	</div>
}

// reportButton opens the report at path, or is disabled when there is none, so back and forward move between them
templ reportButton(id, path string, selected bool) {
	{{ variant := button.VariantOutline }}
	if selected {
		{{ variant = button.VariantDefault }}
	}
	@button.Button(button.Props{
		ID:         id,
		Variant:    variant,
		Size:       button.SizeSm,
		Disabled:   path == "",
		Attributes: templ.Attributes{"hx-get": path, "hx-target": "#main-content", "hx-push-url": "true", "hx-swap": "innerHTML"},
	}) {
		{ children... }
	}
}

templ stat(id, label, text string) {
	<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
		<dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">{ label }</dt>
		<dd id={ id } class="mt-1 text-2xl font-bold tabular-nums text-gray-900">{ text }</dd>
	</div>
}

// SummariesReport is the site's kept summaries as tables of their numbers, a table for each period, newest first, each
// opening its AGP report. An admin can have them all regenerated from the site's data.
templ SummariesReport(summaries map[string][]*sitemodels.SiteSummaryPeriod, admin bool) {
	@heading.Title("Summaries")
	<div id="site--summaries" class="w-full space-y-4 py-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h1 class="text-2xl font-bold">Summaries</h1>
				<span class="text-sm text-gray-500">Each day, week, fortnight and month kept, built from the site's data</span>
			</div>
			if admin {
				@button.Button(button.Props{ID: "site--summaries--regenerate", Variant: button.VariantOutline,
					Attributes: templ.Attributes{"hx-post": "/reports/summaries/regenerate", "hx-swap": "none", "hx-status:4xx": "target:#toaster swap:beforeend",
						"hx-confirm": "Regenerate the last year of summaries from the site's data? It runs in the background and takes a minute."}}) {
					Regenerate summaries
				}
			}
		</div>
		for _, kind := range periods {
			<section id={ "site--summaries--" + kind.Period } class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
				<h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-500">{ kind.Label }s</h2>
				@table.Table(table.Props{Class: "rounded-lg border border-gray-200 text-sm"}) {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								{ kind.Label }
							}
							for _, column := range []string{"Days with data", "Time in range", "Daily dose", "Daily carbs"} {
								@table.Head(table.HeadProps{Class: "text-right"}) {
									{ column }
								}
							}
						}
					}
					@table.Body() {
						if len(summaries[kind.Period]) == 0 {
							<tr><td colspan="5" class="p-4 text-gray-500">No { kind.Period }s kept yet.</td></tr>
						}
						for _, p := range summaries[kind.Period] {
							@table.Row() {
								@table.Cell() {
									{{ path := link(p.Period, time.UnixMilli(p.Start).In(site_data_templ.Location(ctx))) }}
									<a class="text-primary underline" href={ templ.SafeURL(path) } hx-get={ path } hx-target="#main-content" hx-push-url="true" hx-swap="innerHTML">{ title(ctx, p) }</a>
								}
								for _, value := range []string{fmt.Sprint(p.Days), display.Value(p.TimeInRange, "%"), display.PerDay(p.Days, p.TotalDailyDose, " U"), display.PerDay(p.Days, p.TotalDailyCarbs, " g")} {
									@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
										{ value }
									}
								}
							}
						}
					}
				}
			</section>
		}
	</div>
}

// SummariesRegenerating is a toast saying the summaries are being regenerated
templ SummariesRegenerating() {
	<div hx-swap-oob="beforeend:#toaster">
		@toast.Toast(toast.Props{Title: "Regenerating summaries", Description: "The last year of summaries is being built again from the site's data.",
			Variant: toast.VariantSuccess, Position: toast.PositionTopCenter, Duration: 5000, Dismissible: true, Icon: true})
	</div>
}
