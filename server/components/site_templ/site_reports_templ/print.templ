package site_reports_templ

import (
	"context"
	"fmt"
	"time"

	"nighttroop.t1d.nz/models/sitemodels"
	"nighttroop.t1d.nz/server/components/heading"
	"nighttroop.t1d.nz/server/components/site_templ"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/utils/display"
)

// PrintMonths are how many months the printable report is of: this month so far and the 3 before it
const PrintMonths = 4

// PeriodReport is a report's period, its days, and the period before it to compare with, nil when it has no data
type PeriodReport struct {
	Period   *sitemodels.SiteSummaryPeriod
	Days     []*sitemodels.SiteSummaryDaily
	Previous *sitemodels.SiteSummaryPeriod
}

// Printable is the report to print of months, newest first: each month's overview and AGP on a page of its own, laid
// out as Dexcom Clarity's are, flat under ruled headings, each page saying Nighttroop generated it and, at its foot, its
// number and when. On a screen the pages are sheets on grey, with a button to print them that is not printed.
templ Printable(generated time.Time, months []*PeriodReport) {
	@site_templ.Base() {
		@heading.Title("Report")
		// Printed smaller, so each page's report fits on it, with its colours, as its range bars are backgrounds
		<style>@page { size: A4; margin: 10mm; } @media print { html { font-size: 10px; print-color-adjust: exact; -webkit-print-color-adjust: exact; } }</style>
		<main id="site--print" class="flex-1 bg-gray-100 py-6 print:bg-white print:py-0">
			<div class="mx-auto mb-4 flex max-w-4xl justify-end px-4 print:hidden">
				@button.Button(button.Props{ID: "site--print--print", Attributes: templ.Attributes{"onclick": templ.JSUnsafeFuncCall("window.print()")}}) {
					Print
				}
			</div>
			for i, month := range months {
				@sheet(sheetProps{ID: "site--print--overview-" + month.Period.Date, Name: "Overview", Generated: generated, Period: month.Period, Page: 2*i + 1, Pages: 2 * len(months)}) {
					@overviewCards(month.Period, month.Days, month.Previous, false)
				}
				@sheet(sheetProps{ID: "site--print--agp-" + month.Period.Date, Name: "AGP", Generated: generated, Period: month.Period, Page: 2*i + 2, Pages: 2 * len(months)}) {
					@agpCards(month.Period, month.Days, month.Previous, false)
				}
			}
		</main>
	}
}

// sheetProps are a printed page's: its report's name and period, when it was generated, and its number of how many
type sheetProps struct {
	ID, Name    string
	Generated   time.Time
	Period      *sitemodels.SiteSummaryPeriod
	Page, Pages int
}

// sheet is a printed page: its report's name over its days, Nighttroop's logo at its right, its report's cards flat
// under ruled headings, and at its foot its number and when it was generated. Each page after the first starts a new
// one, and its cards are not split across them.
templ sheet(p sheetProps) {
	<section id={ p.ID } class={ "mx-auto mb-6 flex min-h-[297mm] max-w-[210mm] flex-col bg-white p-[10mm] text-gray-900 shadow print:m-0 print:min-h-[270mm] print:max-w-none print:p-0 print:shadow-none", templ.KV("break-before-page", p.Page > 1) }>
		<header class="flex items-start justify-between gap-3">
			<div>
				<h1 class="text-3xl font-bold">{ p.Name }</h1>
				<p class="site--print--dates text-xs font-semibold">{ sheetDates(ctx, p.Period) }</p>
			</div>
			<span class="flex items-center gap-1.5 text-sm font-semibold text-primary"><img src="/logo.svg" alt="" class="size-6"/>Generated by Nighttroop</span>
		</header>
		<div class="mt-4 flex-1 space-y-5 print:[&_section]:break-inside-avoid [&_section]:rounded-none [&_section]:border-0 [&_section]:p-0 [&_section]:shadow-none [&_section>div:first-child:not(:last-child)]:border-b-2 [&_section>div:first-child:not(:last-child)]:border-gray-900 [&_section>div:first-child:not(:last-child)]:pb-1 [&_section_h2]:text-lg [&_section_h2]:font-bold [&_section_h2]:normal-case [&_section_h2]:tracking-normal [&_section_h2]:text-gray-900">
			{ children... }
		</div>
		<footer class="mt-6 flex justify-between gap-3 border-t border-gray-300 pt-1 text-[0.65rem] text-gray-600">
			<span class="font-semibold">Nighttroop</span>
			<span class="text-right">
				<span class="site--print--page">{ fmt.Sprintf("%d of %d", p.Page, p.Pages) }</span>
				<br/>
				<span class="site--print--generated">Generated at: { p.Generated.In(reportLocation(ctx)).Format(display.DayLayout + " 15:04") }</span>
			</span>
		</footer>
	</section>
}

// sheetDates are a page's report's days, how many and its first and last, as "10 days • Sun 1 Nov 2026 – Tue 10 Nov
// 2026", this month's to today
func sheetDates(ctx context.Context, p *sitemodels.SiteSummaryPeriod) string {
	first, last := days(ctx, p)
	return fmt.Sprintf("%d days • %s – %s", periodDays(p, time.Now(), first.Location()), first.Format(display.DayLayout), last.Format(display.DayLayout))
}
