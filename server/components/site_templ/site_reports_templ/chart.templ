package site_reports_templ

import "nighttroop.t1d.nz/utils/i18n"

// legendItem is one of a graph's key: the classes of its swatch, drawn as it is on the graph, and the message of what it is
type legendItem struct{ Swatch, Label string }

// legend is a graph's key, each swatch beside what it is
templ legend(items []legendItem) {
	<ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-600">
		for _, item := range items {
			<li class="flex items-center gap-1.5"><span class={ item.Swatch }></span>{ i18n.T(ctx, item.Label) }</li>
		}
	</ul>
}

// hourAxis labels a graph's hours of the day along its bottom, midnight and noon in bold, each with a tick when ticked
templ hourAxis(g graph, ticked bool) {
	for _, hour := range g.Hours() {
		{{ x := g.X(float64(hour) * 3_600_000) }}
		if ticked {
			<line class="stroke-gray-300" x1={ f(x) } x2={ f(x) } y1={ f(g.Bottom) } y2={ f(g.Bottom + 5) }></line>
		}
		<text class={ "fill-gray-600", templ.KV("font-semibold", hour%12 == 0) } x={ f(x) } y={ f(g.Bottom + 18) } text-anchor="middle">{ hourLabel(ctx, hour) }</text>
	}
}

// rangeBar is a period's time in each range as a bar of them stacked, very high at the top, its size from class
templ rangeBar(class string, all []band) {
	<div class={ "flex shrink-0 flex-col gap-px overflow-hidden rounded-sm bg-gray-100", class } aria-hidden="true">
		for _, b := range all {
			<div class={ b.Class } style={ "height: " + bandHeight(b.Percent) }></div>
		}
	</div>
}

// noGlucose says a report has no glucose to graph, and why a day's readings are not in it until the day after
templ noGlucose(id, period string) {
	<p id={ id } class="text-sm text-gray-500">
		{ i18n.T(ctx, "site.reports.no_glucose", i18n.Data{"Period": period}) }
	</p>
}
