package site_dashboard_templ

import (
	"nighttroop.t1d.nz/server/components/site_templ"
	"nighttroop.t1d.nz/utils/httputils"
)

templ Dashboard(siteContext *httputils.SiteContext) {
	@site_templ.SiteBase() {
		<div class="container-fluid p-4">
			<!-- TOP METRICS -->
			<div class="row g-3 mb-4">
				<div class="col-md-3">
					<div class="card metric-card p-3" hx-get="/bg" hx-trigger="load, every 30s">
						<h2>114 <small>mg/dL</small></h2>
						<div>Slowly Falling</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="card metric-card p-3" hx-get="/iob" hx-trigger="load, every 60s">
						<h5>Insulin on Board</h5>
						<h3>1.25 U</h3>
					</div>
				</div>
				<div class="col-md-3">
					<div class="card metric-card p-3" hx-get="/cob" hx-trigger="load, every 60s">
						<h5>Active COB</h5>
						<h3>18 g</h3>
					</div>
				</div>
				<div class="col-md-3">
					<div class="card metric-card p-3" hx-get="/pump" hx-trigger="load, every 60s">
						<h5>Pump Status</h5>
						<h3>Normal</h3>
					</div>
				</div>
			</div>
			<!-- GRAPH -->
			<div class="card p-3 mb-4">
				<h5>Glucose Graph</h5>
				<div id="glucoseGraph" class="graph-container" hx-get="/graph" hx-trigger="load" hx-swap="none"></div>
			</div>
			<!-- LOWER METRICS -->
			<div class="row g-3">
				<div class="col-md-2">
					<div class="card p-3">
						<h6>BG</h6>
						<h4>114</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Delta</h6>
						<h4 class="text-danger">-3</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Basal Rate</h6>
						<h4>0.80 U/h</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Bolus</h6>
						<h4>2.0 U</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Carbs</h6>
						<h4>18 g</h4>
					</div>
				</div>
				<div class="col-md-2">
					<div class="card p-3">
						<h6>Battery</h6>
						<div class="progress">
							<div class="progress-bar" style="width: 85%">85%</div>
						</div>
					</div>
				</div>
			</div>
			<!-- BOTTOM ROW -->
			<div class="row g-3 mt-3">
				<div class="col-md-4">
					<div class="card p-3">
						<h6>Recent Insulin</h6>
						<div>2.0 U, 26 min ago</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card p-3">
						<h6>Last Meal</h6>
						<div>18g carbs, 45 min ago</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card p-3">
						<h6>System Status</h6>
						<div>CGM ✔ PUMP ✔ CAREPORTAL ✔</div>
					</div>
				</div>
			</div>
		</div>
		<!-- D3 Example -->
		<script>
    document.addEventListener("DOMContentLoaded", function () {
        const svg = d3.select("#glucoseGraph")
            .append("svg")
            .attr("width", "100%")
            .attr("height", 300);

        // Placeholder line
        svg.append("line")
            .attr("x1", 0)
            .attr("y1", 150)
            .attr("x2", 1000)
            .attr("y2", 150)
            .attr("stroke", "#22c55e")
            .attr("stroke-width", 2);
    });
</script>
	}
}
