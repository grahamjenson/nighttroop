package dbsize

import (
	"fmt"

	"nighttroop.t1d.nz/models/controlmodels"
	"nighttroop.t1d.nz/server/components/ui/icon"
)

// usedPercent is how much of its DB size limit the site uses, when both are known
func usedPercent(sizeKB, limitKB *int64) (int64, bool) {
	if sizeKB == nil || limitKB == nil || *limitKB <= 0 {
		return 0, false
	}
	return *sizeKB * 100 / *limitKB, true
}

// usedClass colours how much of its limit a site uses, by the icon beside it: red over the limit, amber nearing it
func usedClass(percent int64) string {
	switch {
	case percent > 100:
		return "text-red-600"
	case percent >= 80:
		return "text-amber-800"
	}
	return "text-gray-500"
}

// dbPart is a share of a site's DB: one of its largest tables, or the rest of them together, with its records and
// colour
type dbPart struct {
	Name    string
	Bytes   int64
	Records int64
	Percent float64
	Class   string
}

// partClasses shade the largest tables darkest, one hue so the key reads by name, not by colour alone
var partClasses = []string{"bg-brand-night", "bg-brand-night/75", "bg-brand-night/55", "bg-brand-night/40", "bg-brand-night/25"}

// dbParts are the largest tables of a site's DB, largest first, each with its share of the DB, and the rest of them
// together as Other
func dbParts(tables []*controlmodels.SiteTable) []dbPart {
	total, parts := totalBytes(tables), []dbPart{}
	if total <= 0 {
		return parts
	}
	share := func(name string, tables []*controlmodels.SiteTable, class string) dbPart {
		bytes, records := totalBytes(tables), int64(0)
		for _, table := range tables {
			records += table.Records
		}
		return dbPart{Name: name, Bytes: bytes, Records: records, Percent: float64(bytes) * 100 / float64(total), Class: class}
	}
	for i, table := range tables {
		if i == len(partClasses) {
			return append(parts, share("Other", tables[i:], "bg-gray-300"))
		}
		parts = append(parts, share(table.Name, tables[i:i+1], partClasses[i]))
	}
	return parts
}

// measuredBy is the DB's size, or its size from its tables when the resource check has not measured it yet
func measuredBy(sizeKB *int64, tables []*controlmodels.SiteTable) *int64 {
	if sizeKB != nil || len(tables) == 0 {
		return sizeKB
	}
	kb := totalBytes(tables) / 1024
	return &kb
}

// totalBytes are the bytes the tables take together
func totalBytes(tables []*controlmodels.SiteTable) int64 {
	total := int64(0)
	for _, table := range tables {
		total += table.Bytes
	}
	return total
}

// partText is a part's size and share of the DB, as "1.25 MB · 40%"
func partText(part dbPart) string {
	return fmt.Sprintf("%.2f MB · %.0f%%", float64(part.Bytes)/1024/1024, part.Percent)
}

// keyText is a part's records in thousands, then its size and share of the DB, as "7.9k · 1.25 MB · 40%"
func keyText(part dbPart) string {
	return fmt.Sprintf("%.1fk · %s", float64(part.Records)/1000, partText(part))
}

// barWidth is how much of the bar the DB fills: its share of its limit, at most all of it, or all of it with no limit
func barWidth(sizeKB, limitKB *int64) int64 {
	if percent, ok := usedPercent(sizeKB, limitKB); ok {
		return min(percent, 100)
	}
	return 100
}


// Panel is a site's DB size, large, against its limit, with a bar of how much of the limit it uses, split by its
// largest tables, and a key of them under it, so its admins and the control site see where its data builds up. A DB
// the resource check has not measured yet is measured by its tables. Its elements' IDs start with prefix.
templ Panel(prefix string, sizeKB, limitKB *int64, tables []*controlmodels.SiteTable) {
	{{ parts, sizeKB := dbParts(tables), measuredBy(sizeKB, tables) }}
	<div id={ prefix + "--db" } class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		<div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-gray-500">
			@icon.Database(icon.Props{Class: "size-4"})
			DB size
		</div>
		<div class="mt-1 flex flex-wrap items-baseline gap-2">
			if sizeKB != nil {
				<span id={ prefix + "--db-size" } class="text-5xl font-extrabold tracking-tight tabular-nums">{ mb(sizeKB) }</span>
				<span class="text-lg text-gray-500">MB</span>
			} else {
				<span id={ prefix + "--db-size" } class="text-2xl font-bold text-gray-400">Not measured yet</span>
			}
			if limitKB != nil {
				<span id={ prefix + "--db-limit" } class="text-sm text-gray-500">of its { mb(limitKB) } MB limit</span>
			}
		</div>
		{{ percent, measured := usedPercent(sizeKB, limitKB) }}
		if measured || len(parts) > 0 {
			<div class="mt-4 h-3 w-full rounded-full bg-gray-100">
				<div id={ prefix + "--db-used" } class="flex h-full gap-[2px]" style={ fmt.Sprintf("width: %d%%", barWidth(sizeKB, limitKB)) }>
					for i, part := range parts {
						<div id={ prefix + "--db-part--" + part.Name } aria-label={ part.Name + ": " + partText(part) } class={ "group relative h-full min-w-[2px]", part.Class, templ.KV("rounded-l-full", i == 0), templ.KV("rounded-r-full", i == len(parts)-1) } style={ fmt.Sprintf("flex: %d 1 0%%", part.Bytes) }>
							// A tooltip naming the table shows over its part on hover, kept inside the bar at its ends
							<div id={ prefix + "--db-part--" + part.Name + "--tooltip" } class={ "pointer-events-none absolute bottom-full z-10 mb-2 hidden whitespace-nowrap rounded-md border border-gray-200 bg-white px-2 py-1 text-xs text-gray-700 shadow-md group-hover:block", templ.KV("left-0", i == 0), templ.KV("right-0", i > 0 && i == len(parts)-1), templ.KV("left-1/2 -translate-x-1/2", i > 0 && i < len(parts)-1) }>
								<span class="font-mono font-semibold">{ part.Name }</span>
								<span class="tabular-nums text-gray-500">{ partText(part) }</span>
							</div>
						</div>
					}
					if len(parts) == 0 {
						<div class="h-full flex-1 rounded-full bg-brand-night"></div>
					}
				</div>
			</div>
		}
		if measured {
			<div id={ prefix + "--db-percent" } class={ "mt-1 flex items-center gap-1 text-xs", usedClass(percent) }>
				if percent >= 80 {
					@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
				}
				{ fmt.Sprintf("%d%% of its limit used", percent) }
			</div>
		} else if sizeKB == nil {
			<div class="mt-1 text-xs text-gray-500">The resource check measures each site's DB</div>
		}
		if len(parts) > 0 {
			<ul id={ prefix + "--db-tables" } class="mt-4 gap-x-6 space-y-1 text-sm text-gray-700 sm:columns-2">
				for _, part := range parts {
					<li id={ prefix + "--db-table--" + part.Name } class="flex break-inside-avoid items-center gap-2">
						<span class={ "size-3 shrink-0 rounded-sm", part.Class }></span>
						<span class="truncate font-mono text-xs">{ part.Name }</span>
						<span class="ml-auto shrink-0 text-xs tabular-nums text-gray-500">{ keyText(part) }</span>
					</li>
				}
			</ul>
		}
	</div>
}


// mb is a size kept in KB as MB, to two places so a small site's is not 0
func mb(kb *int64) string {
	return fmt.Sprintf("%.2f", float64(*kb)/1024)
}
