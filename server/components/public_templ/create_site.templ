package public_templ

import (
	"nighttroop.t1d.nz/models/public"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
)

templ CreateSite() {
	@PublicBase() {
		<div class="flex h-screen flex-col justify-center items-center px-6 py-12 lg:px-8 bg-slate-50 ">
			<!-- Header -->
			<div class="text-center mb-4">
				<h2 class="text-4xl font-extrabold tracking-tight text-gray-900">
					NightTroop<span class="ml-2 inline-flex items-center rounded-full bg-amber-200 px-2.5 py-0.5 text-sm font-semibold text-rose-800 align-middle">Alpha</span>
				</h2>
			</div>
			<!-- Main Content -->
			<div id="panel-content" class="flex flex-col items-center justify-center">
				<div class="w-full flex flex-col items-center justify-center">
					<!-- Centered & Larger Templ Button -->
					@button.Button(button.Props{
						ID:        "public--create-site-button",
						Size:      button.SizeLg,
						Variant:   button.VariantSecondary,
						Class:     "h-16 w-64 bg-blue-600 shadow-2xl hover:bg-blue-900 transition-all duration-200",
						FullWidth: true,
						Attributes: templ.Attributes{
							"hx-post":       "/site",
							"hx-target":     "#panel-content",
							"hx-swap":       "innerHTML",
							"hx-status:4xx": "target:#error-container",
							"hx-status:5xx": "target:#error-container",
						},
					}) {
						<div class="h-2 w-5"></div>
						<span class="text-2xl font-extrabold tracking-wide text-white">
							Create Site
						</span>
						<div class="h-2 w-5"></div>
					}
					<!-- HTMX Loading Indicator -->
					<div id="error-container" class="h-8 w-full"></div>
				</div>
			</div>
		</div>
	}
}

templ CreateSiteRateLimited(seconds int) {
	<div id="rate-limit-alert" class="mt-3 rounded-xl bg-amber-500/10 p-4 text-amber-800 border border-amber-500/20 shadow-sm" role="alert">
		<div class="flex items-center justify-center">
			<!-- Animated Tailwind Spinner -->
			<div class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-400" role="status"></div>
			<span class="text-sm font-medium">
				Please wait
				<strong id="countdownNum" class="mx-1 font-bold text-rose-400">{ seconds }</strong>
				seconds.
			</span>
		</div>
	</div>
	<script>
    document.span = document.getElementById('countdownNum');

    clearInterval(document._timer);

    document._timer = setInterval(() => {
        let count = parseInt(document.span.innerText);
        if (count <= 1) {
            clearInterval(document._timer);
            document.getElementById('rate-limit-alert').remove();
        } else {
            document.span.innerText = count - 1;
        }
    }, 1000);
</script>
}

templ CreateSiteInfo(newsite public.NewSiteInfo) {
	<div class="text-left w-full">
		<div id="Step1" class="max-w-2xl mx-auto space-y-6">
			<!-- Credentials Display Box -->
			<div class="rounded-xl bg-green-500/10 p-4 text-sm leading-relaxed text-green-600 border border-green-500/20 shadow-sm">
				<div class="flex items-start gap-2 mb-4">
					<span class="font-semibold text-green-900">1.</span>
					<p class="text-green-800">Save this information in a secure location.</p>
				</div>
				<div class="relative group rounded-xl border border-slate-200 bg-slate-50 shadow-sm overflow-hidden">
					<!-- Header bar with Action Button -->
					<div class="flex items-center justify-between border-b border-slate-200 bg-slate-100/70 px-4 py-2.5">
						<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your Credentials</span>
						<textarea id="public--site-info" hidden>{  newsite.AllInfo() }</textarea>
						<!-- Clear, High-Visibility Copy Button -->
						<div class="inline-flex shadow-sm rounded-lg">
							@copybutton.CopyButton(copybutton.Props{
								ID:       "public--copy-button",
								TargetID: "public--site-info",
								Class:    "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-medium rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/20",
							})
						</div>
					</div>
					<!-- Monospace Content Area -->
					<div class="p-4 font-mono text-sm text-slate-800 space-y-2 select-all bg-white">
						<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">
							Site Information
						</h3>
						<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Site:</span><span class="break-all">{ newsite.URL }</span></div>
						<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Backup Key:</span><span class="break-all">{ newsite.BackupKey }</span></div>
						<hr class="my-4"/>
						<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">
							Admin User
						</h3>
						<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Username:</span><span>admin</span></div>
						<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Password:</span><span class="break-all">{ newsite.AdminPassword }</span></div>
						<div class="flex">
							<div class="flex items-start gap-6">
								<!-- Left: label + secret -->
								<div class="flex">
									<span class="w-28 shrink-0 font-medium text-slate-400 select-none">
										TOTP Secret:
									</span>
								</div>
								<!-- Right: QR block -->
								<div class="flex flex-col items-center gap-2">
									<div id="qrcode" class="p-2 bg-white rounded-lg shadow-sm border border-slate-200"></div>
									<span class="text-xs text-slate-400">Scan with authenticator</span>
								</div>
							</div>
							<script type="text/javascript">
							var qrcode = new QRCode(document.getElementById("qrcode"), {
								text: "{{ newsite.AdminTotpSecret }}",
								width: 128,
								height: 128,
								colorDark : "#000000",
								colorLight : "#ffffff",
								correctLevel : QRCode.CorrectLevel.H
							});
							</script>
						</div>
						<hr class="my-4"/>
						<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">
							Person With Diabetes (PWD) Phone Setup
						</h3>
						<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">NSToken:</span><span class="break-all">{ newsite.PwdNSToken }</span></div>
						<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">NSURL:</span><span class="break-all">{ newsite.PwdNSURL }</span></div>
					</div>
				</div>
			</div>
		</div>
		<div class="border-b border-slate-200/60 my-6"></div>
		<div id="Step2">
			<div class="rounded-xl bg-green-500/10 p-4 text-sm leading-relaxed text-green-600 border border-green-500/20 shadow-sm mb-4">
				<div class="flex items-start gap-2 mb-4">
					<span class="font-semibold text-green-900">2.</span>
					<p class=" text-green-800">Login to your new site</p>
				</div>
				<div class="justify-center flex w-full">
					<!-- Action Button: Visit Generated Site -->
					@button.Button(button.Props{
						ID:        "public--login-button",
						Size:      button.SizeLg,
						Class:     "h-16 w-64 bg-blue-600 shadow-2xl hover:bg-blue-900 transition-all duration-200",
						FullWidth: true,
						Href:      newsite.URL,
						Target:    "_blank",
					}) {
						<div class="h-5 w-5"></div>
						<span class="text-2xl font-extrabold tracking-wide text-white">
							Login
						</span>
						<div class="h-5 w-5"></div>
					}
				</div>
			</div>
		</div>
	</div>
}
