package public_templ

import (
	"nighttroop.t1d.nz/models/publicmodels"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
)

// CreateSite is the home page. Once a site is created its two steps are the page: the header shrinks to the logo and
// name beside each other, and the rest of it is hidden
templ CreateSite() {
	@PublicBase() {
		<main class="group min-h-screen flex flex-col items-center justify-center px-6 py-12 bg-gradient-to-b from-slate-100 via-slate-50 to-white has-[#public--site-info]:justify-start has-[#public--site-info]:py-6">
			<div class="w-full max-w-3xl text-center">
				<p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 shadow-sm group-has-[#public--site-info]:hidden">
					@icon.Rocket(icon.Props{Class: "size-3.5 text-brand-gold"})
					Free hosting, Nightscout compatible
					<span class="rounded-full bg-brand-gold px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand-night">Alpha</span>
				</p>
				<div class="flex flex-col items-center group-has-[#public--site-info]:flex-row group-has-[#public--site-info]:justify-center group-has-[#public--site-info]:gap-3">
					<img id="public--logo" src="/logo.svg" alt="" class="mt-8 size-24 group-has-[#public--site-info]:mt-0 group-has-[#public--site-info]:size-10"/>
					<h1 class="mt-4 text-5xl sm:text-6xl font-extrabold tracking-tight text-slate-900 group-has-[#public--site-info]:mt-0 group-has-[#public--site-info]:text-3xl">NightTroop</h1>
				</div>
				<p class="mt-4 text-lg text-slate-600 max-w-xl mx-auto group-has-[#public--site-info]:hidden">
					Your own Nightscout-compatible site in one click. No servers, no databases, no sign-up. Create a site, save your credentials, and start syncing.
				</p>
				<div id="panel-content" class="mt-10 flex flex-col items-center group-has-[#public--site-info]:mt-6">
					@button.Button(button.Props{
						ID:    "public--create-site-button",
						Size:  button.SizeLg,
						Class: "h-14 px-10 rounded-full text-lg font-semibold text-white bg-brand-night hover:bg-brand-night/90 shadow-lg shadow-brand-night/30 hover:shadow-xl transition-all duration-200",
						Attributes: templ.Attributes{
							"hx-post":       "/site",
							"hx-vals":       "js:{timezone: Intl.DateTimeFormat().resolvedOptions().timeZone, language: navigator.language}",
							"hx-target":     "#panel-content",
							"hx-swap":       "innerHTML",
							"hx-status:4xx": "target:#error-container",
							"hx-status:5xx": "target:#error-container",
						},
					}) {
						Create Site
					}
					<div id="error-container" class="h-8 w-full mt-2"></div>
				</div>
				<dl id="public--features" class="mt-12 grid gap-6 sm:grid-cols-3 text-left group-has-[#public--site-info]:hidden">
					@feature(icon.MousePointerClick, "One click", "No account to make. Your site and its credentials are generated instantly.")
					@feature(icon.ShieldCheck, "Private by default", "Each site is isolated with its own admin login, TOTP and backup key.")
					@feature(icon.RefreshCw, "Works with your apps", "Upload from AAPS or Trio like you would to Nightscout, or pull from Dexcom, Libre or a Nightscout site.")
				</dl>
			</div>
		</main>
	}
}

templ feature(ic func(...icon.Props) templ.Component, title, body string) {
	<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<dt class="flex items-center gap-2 font-semibold text-slate-900">
			@ic(icon.Props{Class: "size-5 text-brand-night"})
			{ title }
		</dt>
		<dd class="mt-2 text-sm text-slate-600">{ body }</dd>
	</div>
}

templ CreateSiteRateLimited(seconds int) {
	<div id="rate-limit-alert" class="mt-3 rounded-xl bg-amber-500/10 p-4 text-amber-800 border border-amber-500/20 shadow-sm" role="alert">
		<div class="flex items-center justify-center">
			<!-- Animated Tailwind Spinner -->
			<div class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-400" role="status"></div>
			<span class="text-sm font-medium">
				Please wait
				<strong id="countdownNum" class="mx-1 font-bold text-rose-400">{ seconds }</strong>
				seconds.
			</span>
		</div>
	</div>
	<script>
    document.span = document.getElementById('countdownNum');

    clearInterval(document._timer);

    document._timer = setInterval(() => {
        let count = parseInt(document.span.innerText);
        if (count <= 1) {
            clearInterval(document._timer);
            document.getElementById('rate-limit-alert').remove();
        } else {
            document.span.innerText = count - 1;
        }
    }, 1000);
</script>
}

templ CreateSiteInfo(newsite publicmodels.NewSiteInfo) {
	<div class="w-full max-w-2xl mx-auto text-left space-y-4">
		@step("1", "Save your credentials somewhere safe", "They are shown once") {
			<textarea id="public--site-info" hidden>{ newsite.AllInfo() }</textarea>
			// Copying them all is the one thing to do here, so it is the step's main button
			<div class="mx-5 mb-4 flex flex-col items-center gap-3 rounded-xl border border-brand-gold bg-brand-gold/10 p-4 sm:flex-row">
				@copyButton("public--copy-button", "public--site-info", "Copy all credentials", "h-12 shrink-0 px-6 text-base font-semibold text-white bg-brand-night hover:bg-brand-night/90 shadow-lg shadow-brand-night/30")
				<p id="public--site-info--recover" class="text-sm text-slate-700">
					<strong>Paste them into a password manager.</strong>
					The backup key, with the site ID, is the only way back in on the
					<a id="public--site-info--recover-link" href={ templ.SafeURL(newsite.RecoverURL) } class="font-medium text-brand-night underline">recover page</a>.
				</p>
			</div>
			<div class="font-mono text-sm">
				@group("Site")
				<dl class="grid sm:grid-cols-2">
					@row("url", "URL", newsite.URL, true)
					@row("site-id", "Site ID", newsite.SiteID(), false)
					@row("backup-key", "Backup key", newsite.BackupKey, false)
				</dl>
				@group("Admin login")
				<dl class="grid sm:grid-cols-2">
					@row("username", "Username", "admin", false)
					@row("password", "Password", newsite.AdminPassword, false)
					@row("totp-secret", "TOTP secret", newsite.AdminTotpSecret, true)
				</dl>
				// A recovery leaves the phone's credentials as they were, so there are none to show
				if newsite.PwdNSToken != "" {
					@group("Phone setup (AAPS / Trio)")
					<dl class="grid sm:grid-cols-2">
						@row("ns-url", "NS URL", newsite.PwdNSURL, true)
						// The token is too long to read or type, so it is only copied
						<div class="flex items-center gap-2 px-4 py-1.5 sm:col-span-2">
							<dt class="w-24 shrink-0 text-slate-400">NS token</dt>
							<dd>
								<textarea id="public--site-info--ns-token" hidden>{ newsite.PwdNSToken }</textarea>
								@copyButton("public--copy-ns-token", "public--site-info--ns-token", "Copy token", "h-7 px-2.5 font-sans text-xs font-medium text-slate-700 bg-white border border-slate-200 hover:bg-slate-100")
							</dd>
						</div>
					</dl>
				}
			</div>
		}
		@step("2", "Check your authenticator app", "Scan the QR code, then enter the code it shows") {
			<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 px-5 pb-5">
				<div id="qrcode" class="p-1.5 bg-white rounded-lg border border-slate-200"></div>
				<form
					id="public--totp-check"
					class="flex flex-wrap items-center justify-center gap-3"
					hx-post="/site/totp"
					hx-target="#public--totp-result"
					hx-swap="innerHTML"
				>
					<input type="hidden" name="site" value={ newsite.SiteID() }/>
					<input type="hidden" name="secret" value={ newsite.AdminTotpSecret }/>
					<input
						id="public--site-info--totp"
						name="totp"
						inputmode="numeric"
						autocomplete="one-time-code"
						maxlength="6"
						placeholder="123456"
						class="w-32 rounded-lg border border-slate-200 px-3 py-2 text-center font-mono text-lg tracking-widest"
					/>
					@button.Button(button.Props{ID: "public--totp-check-button", Type: button.TypeSubmit, Class: "bg-brand-night hover:bg-brand-night/90"}) {
						Check code
					}
				</form>
				<div id="public--totp-result" class="w-full text-center text-sm empty:hidden"></div>
			</div>
			<script type="text/javascript">
				new QRCode(document.getElementById("qrcode"), {
					text: "{{ newsite.AdminTotpSecret }}",
					width: 96,
					height: 96,
					correctLevel: QRCode.CorrectLevel.M
				});
			</script>
		}
		@step("3", "Log in to your site", "With the admin password and a code from the app") {
			@loginButton("", false)
		}
	</div>
}

// copyButton copies the text of the element with targetID, with a label beside the copybutton component's icons
templ copyButton(id, targetID, label, class string) {
	<div data-copy-button data-target-id={ targetID } class="inline-block">
		@button.Button(button.Props{ID: id, Type: button.TypeButton, Class: "gap-2 rounded-lg " + class}) {
			<span data-copy-icon-clipboard>
				@icon.Clipboard(icon.Props{Class: "size-4"})
			</span>
			<span data-copy-icon-check class="hidden">
				@icon.Check(icon.Props{Class: "size-4"})
			</span>
			{ label }
		}
	</div>
}

// loginButton opens the new site's login, disabled until the authenticator's code has been checked; oob swaps it into
// the page, from a code's check
templ loginButton(url string, oob bool) {
	<div id="public--login" class="flex justify-center p-6" { oobAttributes(oob)... }>
		@button.Button(button.Props{
			ID:       "public--login-button",
			Size:     button.SizeLg,
			Class:    "h-14 px-10 rounded-full text-lg font-semibold text-white bg-brand-night hover:bg-brand-night/90 shadow-lg shadow-brand-night/30 transition-all duration-200",
			Href:     url,
			Target:   "_blank",
			Disabled: url == "",
		}) {
			Login
			@icon.ExternalLink(icon.Props{Class: "size-5"})
		}
	</div>
}

func oobAttributes(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return nil
}

// TOTPChecked is a code from the authenticator matching the new site's TOTP secret, and its login button enabled
templ TOTPChecked(url string) {
	<p id="public--totp-checked" class="font-medium text-green-700">That code matches: your authenticator app is set up.</p>
	@loginButton(url, true)
}

// TOTPCheckFailed is a code not matching the new site's TOTP secret
templ TOTPCheckFailed() {
	<p id="public--totp-failed" class="font-medium text-red-700">That code does not match. Check the app has the secret above and your phone's time is right, then try its next code.</p>
}

// step is a numbered step, with its hint beside its title
templ step(n, title, hint string) {
	<section class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
		<header class="flex items-center gap-3 px-5 py-3">
			<span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-night text-sm font-bold text-white">{ n }</span>
			<h2 class="font-semibold text-slate-900">
				{ title }
				<span class="text-sm font-normal text-slate-500">{ hint }</span>
			</h2>
		</header>
		{ children... }
	</section>
}

templ group(title string) {
	<h3 class="border-y border-slate-100 bg-slate-50 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-slate-500">{ title }</h3>
}

// row is a credential, with an ID of public--site-info--<id>; a wide one takes both columns
templ row(id, label, value string, wide bool) {
	<div class={ "flex min-w-0 gap-2 px-4 py-1.5", templ.KV("sm:col-span-2", wide) }>
		<dt class="w-24 shrink-0 text-slate-400">{ label }</dt>
		<dd id={ "public--site-info--" + id } class="min-w-0 break-all text-slate-800 select-all">{ value }</dd>
	</div>
}
