package public_templ

import (
	"nighttroop.t1d.nz/models/publicmodels"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
	"nighttroop.t1d.nz/server/components/ui/icon"
)

templ CreateSite() {
	@PublicBase() {
		<main class="min-h-screen flex flex-col items-center justify-center px-6 py-12 bg-gradient-to-b from-slate-100 via-slate-50 to-white">
			<div class="w-full max-w-3xl text-center">
				<p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 shadow-sm">
					@icon.Rocket(icon.Props{Class: "size-3.5 text-amber-500"})
					Free Nightscout hosting
					<span class="rounded-full bg-amber-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-rose-800">Alpha</span>
				</p>
				<h1 class="mt-6 text-5xl sm:text-6xl font-extrabold tracking-tight text-slate-900">NightTroop</h1>
				<p class="mt-4 text-lg text-slate-600 max-w-xl mx-auto">
					Your own Nightscout site in one click. No servers, no databases, no sign-up. Create a site, save your credentials, and start syncing.
				</p>
				<div id="panel-content" class="mt-10 flex flex-col items-center">
					@button.Button(button.Props{
						ID:    "public--create-site-button",
						Size:  button.SizeLg,
						Class: "h-14 px-10 rounded-full text-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-lg shadow-blue-600/30 hover:shadow-xl transition-all duration-200",
						Attributes: templ.Attributes{
							"hx-post":       "/site",
							"hx-target":     "#panel-content",
							"hx-swap":       "innerHTML",
							"hx-status:4xx": "target:#error-container",
							"hx-status:5xx": "target:#error-container",
						},
					}) {
						Create Site
					}
					<div id="error-container" class="h-8 w-full mt-2"></div>
				</div>
				<dl class="mt-12 grid gap-6 sm:grid-cols-3 text-left">
					@feature(icon.MousePointerClick, "One click", "No account to make. Your site and its credentials are generated instantly.")
					@feature(icon.ShieldCheck, "Private by default", "Each site is isolated with its own admin login, TOTP and backup key.")
					@feature(icon.RefreshCw, "Syncs your data", "Upload from AAPS or Trio, or pull from Dexcom, Libre and other Nightscout sites.")
				</dl>
			</div>
		</main>
	}
}

templ feature(ic func(...icon.Props) templ.Component, title, body string) {
	<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<dt class="flex items-center gap-2 font-semibold text-slate-900">
			@ic(icon.Props{Class: "size-5 text-blue-600"})
			{ title }
		</dt>
		<dd class="mt-2 text-sm text-slate-600">{ body }</dd>
	</div>
}

templ CreateSiteRateLimited(seconds int) {
	<div id="rate-limit-alert" class="mt-3 rounded-xl bg-amber-500/10 p-4 text-amber-800 border border-amber-500/20 shadow-sm" role="alert">
		<div class="flex items-center justify-center">
			<!-- Animated Tailwind Spinner -->
			<div class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-400" role="status"></div>
			<span class="text-sm font-medium">
				Please wait
				<strong id="countdownNum" class="mx-1 font-bold text-rose-400">{ seconds }</strong>
				seconds.
			</span>
		</div>
	</div>
	<script>
    document.span = document.getElementById('countdownNum');

    clearInterval(document._timer);

    document._timer = setInterval(() => {
        let count = parseInt(document.span.innerText);
        if (count <= 1) {
            clearInterval(document._timer);
            document.getElementById('rate-limit-alert').remove();
        } else {
            document.span.innerText = count - 1;
        }
    }, 1000);
</script>
}

templ CreateSiteInfo(newsite publicmodels.NewSiteInfo) {
	<div class="w-full max-w-2xl mx-auto text-left space-y-6">
		@step("1", "Save your credentials somewhere safe", "They are shown once and cannot be recovered.") {
			<textarea id="public--site-info" hidden>{ newsite.AllInfo() }</textarea>
			<div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2.5">
				<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your credentials</span>
				@copybutton.CopyButton(copybutton.Props{
					ID:       "public--copy-button",
					TargetID: "public--site-info",
					Class:    "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 text-xs font-medium rounded-lg transition-colors cursor-pointer",
				})
			</div>
			<dl class="divide-y divide-slate-100 font-mono text-sm">
				@group("Site")
				@row("URL", newsite.URL)
				@row("Backup key", newsite.BackupKey)
				@group("Admin login")
				@row("Username", "admin")
				@row("Password", newsite.AdminPassword)
				<div class="grid sm:grid-cols-[8rem_1fr] gap-1 px-4 py-3">
					<dt class="text-slate-400">TOTP secret</dt>
					<dd class="flex flex-wrap items-start gap-4">
						<span class="break-all">{ newsite.AdminTotpSecret }</span>
						<div class="flex flex-col items-center gap-1">
							<div id="qrcode" class="p-2 bg-white rounded-lg border border-slate-200"></div>
							<span class="font-sans text-xs text-slate-400">Scan with an authenticator app</span>
						</div>
					</dd>
				</div>
				@group("Phone setup (AAPS / Trio)")
				@row("NS URL", newsite.PwdNSURL)
				@row("NS token", newsite.PwdNSToken)
			</dl>
			<script type="text/javascript">
				new QRCode(document.getElementById("qrcode"), {
					text: "{{ newsite.AdminTotpSecret }}",
					width: 128,
					height: 128,
					correctLevel: QRCode.CorrectLevel.H
				});
			</script>
		}
		@step("2", "Log in to your new site", "Use the admin password and a code from your authenticator app.") {
			<div class="flex justify-center p-6">
				@button.Button(button.Props{
					ID:     "public--login-button",
					Size:   button.SizeLg,
					Class:  "h-14 px-10 rounded-full text-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-lg shadow-blue-600/30 transition-all duration-200",
					Href:   newsite.URL,
					Target: "_blank",
				}) {
					Login
					@icon.ExternalLink(icon.Props{Class: "size-5"})
				}
			</div>
		}
	</div>
}

templ step(n, title, hint string) {
	<section class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
		<header class="flex items-start gap-3 px-5 py-4">
			<span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white">{ n }</span>
			<div>
				<h2 class="font-semibold text-slate-900">{ title }</h2>
				<p class="text-sm text-slate-500">{ hint }</p>
			</div>
		</header>
		{ children... }
	</section>
}

templ group(title string) {
	<h3 class="bg-slate-50 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-wide text-slate-500">{ title }</h3>
}

templ row(label, value string) {
	<div class="grid sm:grid-cols-[8rem_1fr] gap-1 px-4 py-3">
		<dt class="text-slate-400">{ label }</dt>
		<dd class="break-all text-slate-800 select-all">{ value }</dd>
	</div>
}
