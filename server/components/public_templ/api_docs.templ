package public_templ

import "nighttroop.t1d.nz/server/assets/docs"

// APIDocs is the API's documentation, generated from its OpenAPI schema, /openapi.json, by go generate (gen/docs):
// every endpoint with its parameters, body and responses, then every schema they use
templ APIDocs() {
	@PublicBase() {
		<article
			id="api-docs"
			class="mx-auto w-full max-w-5xl px-4 py-10 text-sm leading-6 text-gray-700 [&_a]:text-primary [&_a]:underline [&_code]:rounded [&_code]:bg-gray-100 [&_code]:px-1 [&_code]:font-mono [&_code]:text-xs [&_h1]:mb-4 [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:text-brand-night [&_h2]:mb-2 [&_h2]:mt-10 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-brand-night [&_h3]:mt-4 [&_h3]:font-semibold [&_h3]:text-brand-night [&_li]:mt-1 [&_p]:mt-3 [&_section]:border-t [&_section]:border-gray-200 [&_small]:text-sm [&_small]:font-normal [&_small]:text-gray-500 [&_table]:mt-2 [&_table]:w-full [&_table]:text-left [&_td]:border-t [&_td]:border-gray-100 [&_td]:py-1 [&_td]:pr-4 [&_td]:align-top [&_th]:pr-4 [&_th]:font-medium [&_th]:text-gray-500 [&_ul]:mt-2"
		>
			@templ.Raw(docs.APIDocs)
		</article>
	}
}
