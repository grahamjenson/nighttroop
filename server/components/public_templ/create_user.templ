package public_templ

import (
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
)

templ CreateUser() {
	@PublicBase() {
		<div class="flex h-screen flex-col justify-center items-center px-6 py-12 lg:px-8 bg-slate-50 ">
			<!-- Header -->
			<div class="text-center mb-4 ">
				<h2 class="text-4xl font-extrabold tracking-tight text-gray-900">
					NightTroop
				</h2>
				<p class="mt-2 text-sm text-slate-500">Your T1D Host</p>
			</div>
			<!-- Main Content -->
			<div id="panel-content" class="flex flex-col items-center justify-center mt-4">
				<div class="w-full flex flex-col items-center justify-center">
					<!-- Centered & Larger Templ Button -->
					@button.Button(button.Props{
						Size:      button.SizeLg,
						Variant:   button.VariantSecondary,
						Class:     "h-16 w-64 bg-blue-600 shadow-2xl hover:bg-blue-900 transition-all duration-200",
						FullWidth: true,
						Attributes: templ.Attributes{
							"hx-post":         "/user",
							"hx-target":       "#panel-content",
							"hx-swap":         "innerHTML",
							"hx-target-error": "#error-container",
						},
					}) {
						<div class="h-2 w-5"></div>
						<span class="text-2xl font-extrabold tracking-wide text-white">
							Get Started
						</span>
						<div class="h-2 w-5"></div>
					}
					<!-- HTMX Loading Indicator -->
					<div id="error-container" class="h-8 w-full"></div>
				</div>
			</div>
		</div>
	}
}

templ CreateUserRateLimited(seconds int) {
	<div id="rate-limit-alert" class="mt-3 rounded-xl bg-amber-500/10 p-4 text-amber-800 border border-amber-500/20 shadow-sm" role="alert">
		<div class="flex items-center justify-center">
			<!-- Animated Tailwind Spinner -->
			<div class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-400" role="status"></div>
			<span class="text-sm font-medium">
				Please wait
				<strong id="countdownNum" class="mx-1 font-bold text-rose-400">{ seconds }</strong>
				seconds.
			</span>
		</div>
	</div>
	<script>
    document.span = document.getElementById('countdownNum');

    clearInterval(document._timer);

    document._timer = setInterval(() => {
        let count = parseInt(document.span.innerText);
        if (count <= 1) {
            clearInterval(document._timer);
            document.getElementById('rate-limit-alert').remove();
        } else {
            document.span.innerText = count - 1;
        }
    }, 1000);
</script>
}

templ CreateUserInfo(url string, password string, totpSecret string, backupKey string) {
	<div class="text-left w-full">
		<div class="border-b border-slate-200/60 my-6"></div>
		<div id="Step1" class="max-w-2xl mx-auto space-y-6">
			<!-- Credentials Display Box -->
			<div class="rounded-xl bg-amber-500/10 p-4 text-sm leading-relaxed text-amber-600 border border-amber-500/20 shadow-sm">
				<div class="flex items-start gap-2">
					<span class="text-amber-700">1.</span>
					<p class="font-semibold text-amber-900">Save this information in a secure location.</p>
				</div>
			</div>
			<div class="relative group rounded-xl border border-slate-200 bg-slate-50 shadow-sm overflow-hidden">
				<!-- Header bar with Action Button -->
				<div class="flex items-center justify-between border-b border-slate-200 bg-slate-100/70 px-4 py-2.5">
					<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your Credentials</span>
					<textarea id="textToCopy" hidden>{ "URL: " + url + "\nUsername: admin\nPassword: " + password + "\nTOTP Secret: " + totpSecret + "\nBackup Key: " + backupKey }</textarea>
					<!-- Clear, High-Visibility Copy Button -->
					<div class="inline-flex shadow-sm rounded-lg">
						@copybutton.CopyButton(copybutton.Props{
							TargetID: "textToCopy",
							Class:    "inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-slate-900 text-xs font-medium rounded-lg transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500/20",
						})
					</div>
				</div>
				<!-- Monospace Content Area -->
				<div class="p-4 font-mono text-sm text-slate-800 space-y-2 select-all bg-white">
					<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">URL:</span><span class="break-all">{ url }</span></div>
					<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Username:</span><span>admin</span></div>
					<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Password:</span><span class="break-all">{ password }</span></div>
					<div class="flex">
						<div class="flex items-start gap-6">
							<!-- Left: label + secret -->
							<div class="flex">
								<span class="w-28 shrink-0 font-medium text-slate-400 select-none">
									TOTP Secret:
								</span>
							</div>
							<!-- Right: QR block -->
							<div class="flex flex-col items-center gap-2">
								<div id="qrcode" class="p-2 bg-white rounded-lg shadow-sm border border-slate-200"></div>
								<span class="text-xs text-slate-400">Scan with authenticator</span>
							</div>
						</div>
						<script type="text/javascript">
							var qrcode = new QRCode(document.getElementById("qrcode"), {
								text: "{{ totpSecret }}",
								width: 128,
								height: 128,
								colorDark : "#000000",
								colorLight : "#ffffff",
								correctLevel : QRCode.CorrectLevel.H
							});
							</script>
					</div>
					<div class="flex"><span class="w-28 shrink-0 font-medium text-slate-400 select-none">Backup Key:</span><span class="break-all">{ backupKey }</span></div>
				</div>
			</div>
		</div>
		<div class="border-b border-slate-200/60 my-6"></div>
		<div id="Step2">
			<div class="rounded-xl bg-amber-500/10 p-4 text-sm leading-relaxed text-amber-600 border border-amber-500/20 shadow-sm mb-4">
				<div class="flex items-start gap-2">
					<span class="text-amber-700">2.</span>
					<p class="font-semibold text-amber-900">Visit the Generated Site to Login.</p>
				</div>
			</div>
			<div class="justify-center flex w-full">
				<!-- Action Button: Visit Generated Site -->
				@button.Button(button.Props{
					Size:      button.SizeLg,
					Class:     "h-16 w-64 bg-blue-600 shadow-2xl hover:bg-blue-900 transition-all duration-200",
					FullWidth: true,
					Href:      url,
					Target:    "_blank",
				}) {
					<div class="h-5 w-5"></div>
					<span class="text-2xl font-extrabold tracking-wide text-white">
						Login
					</span>
					<div class="h-5 w-5"></div>
				}
			</div>
		</div>
	</div>
}
