package public_templ

import (
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/copybutton"
)

templ CreateUser() {
	@PublicBase() {
		<div class="flex h-screen flex-col justify-center items-center px-6 py-12 lg:px-8 bg-slate-50 ">
			<div class="p-8 login-form-target rounded-lg shadow-2xl justify-center flex flex-col items-center w-xl ">
				<!-- Header -->
				<div class="text-center mb-10 ">
					<h2 class="font-bold text-4xl">NightTroop</h2>
				</div>
				<!-- Main Content -->
				<div id="panel-content" class="flex flex-col items-center justify-center">
					<div class="w-full flex flex-col items-center justify-center">
						<!-- Centered & Larger Templ Button -->
						@button.Button(button.Props{
							Size:      button.SizeLg,
							Variant:   button.VariantSecondary,
							Class:     "h-32 w-64 bg-blue-600  shadow-2xl hover:bg-blue-900 transition-all duration-200",
							FullWidth: true,
							Attributes: templ.Attributes{
								"hx-post":         "/user",
								"hx-target":       "#panel-content",
								"hx-swap":         "innerHTML",
								"hx-target-error": "#error-container",
							},
						}) {
							<div class="h-5 w-5"></div>
							<span class="text-2xl font-extrabold tracking-wide text-white">
								Create User
							</span>
							<div class="h-5 w-5"></div>
						}
						<!-- HTMX Loading Indicator -->
						<div id="error-container" class="h-min w-full"></div>
					</div>
				</div>
				<!-- Footer -->
				<div class="mt-8 border-t border-white/5 pt-5 text-center">
					<div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/10 bg-emerald-200/20 px-4 py-2 text-xs font-medium tracking-wide text-emerald-600">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
						</span>
						<span>Secure • Private • Free</span>
					</div>
				</div>
			</div>
		</div>
	}
}

templ CreateUserRateLimited(seconds int) {
	<div id="rate-limit-alert" class="mt-3 rounded-xl bg-amber-500/10 p-4 text-amber-800 border border-amber-500/20 shadow-sm" role="alert">
		<div class="flex items-center justify-center">
			<!-- Animated Tailwind Spinner -->
			<div class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-amber-500/30 border-t-amber-400" role="status"></div>
			<span class="text-sm font-medium">
				Please wait
				<strong id="countdownNum" class="mx-1 font-bold text-rose-400">{ seconds }</strong>
				seconds.
			</span>
		</div>
	</div>
	<script>
    document.span = document.getElementById('countdownNum');

    clearInterval(document._timer);

    document._timer = setInterval(() => {
        let count = parseInt(document.span.innerText);
        if (count <= 1) {
            clearInterval(document._timer);
            document.getElementById('rate-limit-alert').remove();
        } else {
            document.span.innerText = count - 1;
        }
    }, 1000);
</script>
}

templ CreateUserInfo(url string, password string, totpSecret string, backupKey string) {
	<div class="text-left w-full">
		<!-- Warning Alert Box -->
		<div class="mb-4">
			<div class="rounded-2xl bg-amber-500/10 p-5 text-sm leading-relaxed text-amber-500 border border-amber-500/20 shadow-lg">
				<span class="font-semibold text-amber-800">⚠️ Save this information in a secure location.</span>
				<!-- A list of things -->
				<ul class="mt-3 space-y-1.5 list-disc pl-5 text-amber-500">
					<li><strong class="font-bold text-amber-600">URL</strong>: The URL to access your site.</li>
					<li><strong class="font-bold text-amber-600">Token</strong>: The admin secret to manage your site.</li>
					<li><strong class="font-bold text-amber-600">Backup Key</strong>: A key to prove ownership if you lose access.</li>
				</ul>
			</div>
		</div>
		<!-- Code / Credential Textarea Box -->
		<div class="mb-4">
			<div id="resultBox">
				<div><span>URL: </span> { url }</div>
				<div><span>UserName: </span> { "admin" }</div>
				<div><span>Password: </span> { password }</div>
				<div><span>TOTP Secret: </span> { totpSecret }</div>
				<div><span>Backup Key: </span> { backupKey }</div>
			</div>
		</div>
		@copybutton.CopyButton(copybutton.Props{
			TargetID: "resultBox",
		})
		<!-- Decorative Divider Line -->
		<div class="border-b border-white/5 my-6"></div>
		<div class="justify-center flex w-full">
			<!-- Action Button: Visit Generated Site -->
			@button.Button(button.Props{
				Size:      button.SizeLg,
				Class:     "w-full justify-center h-32 w-64 bg-slate-800 border-1 border-slate-900 shadow-2xl shadow-slate-900/50 hover:bg-slate-700/80 transition-all duration-200",
				FullWidth: true,
				Href:      url,
				Target:    "_blank",
			}) {
				<div class="h-5 w-5"></div>
				<span class="text-2xl font-extrabold tracking-wide text-white">
					Login
				</span>
				<div class="h-5 w-5"></div>
			}
		</div>
	</div>
	<script>
    // Copy to Clipboard Functionality
    document.getElementById("copyBtn").addEventListener("click", function () {
        const textarea = document.getElementById("resultBox");
        navigator.clipboard.writeText(textarea.value).then(() => {
            this.innerText = "Copied!";
            setTimeout(() => {
                this.innerText = "Copy All";
            }, 1500);
        });
    });
</script>
}
