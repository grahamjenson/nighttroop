package public_templ

import (
	"nighttroop.t1d.nz/server/components/ui/alert"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/form"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/utils/i18n"
)

// RecoverSite is the page a site's ID and backup key get a new admin login on, shown on the site's own address
templ RecoverSite() {
	@PublicBase() {
		<main class="min-h-screen flex flex-col items-center px-6 py-6 bg-gradient-to-b from-slate-100 via-slate-50 to-white">
			<a href="/" class="flex items-center gap-3">
				<img src="/logo.svg" alt="" class="size-10"/>
				<span class="text-3xl font-extrabold tracking-tight text-slate-900">Nighttroop</span>
			</a>
			<div id="panel-content" class="mt-6 w-full max-w-3xl">
				<form id="public--recover--form" class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4" hx-post="/recover" hx-target="#panel-content" hx-status:4xx="target:#error-container" hx-status:5xx="target:#error-container">
					<h1 class="text-xl font-semibold text-slate-900">{ i18n.T(ctx, "public.recover_site.title") }</h1>
					<p class="text-sm text-slate-500">
						{ i18n.T(ctx, "public.recover_site.intro") }
					</p>
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{For: "public--recover--site-id"}) {
							{ i18n.T(ctx, "public.recover_site.site_id") }
						}
						@input.Input(input.Props{ID: "public--recover--site-id", Name: "site_id", Required: true, Attributes: templ.Attributes{"autocapitalize": "none", "autocomplete": "off"}})
					}
					@form.Item(form.ItemProps{}) {
						@form.Label(form.LabelProps{For: "public--recover--backup-key"}) {
							{ i18n.T(ctx, "public.recover_site.backup_key") }
						}
						@input.Input(input.Props{ID: "public--recover--backup-key", Type: input.TypePassword, Name: "backup_key", Required: true})
					}
					@button.Button(button.Props{ID: "public--recover--submit", Type: button.TypeSubmit, Size: button.SizeXl, FullWidth: true}) {
						{ i18n.T(ctx, "public.recover_site.submit") }
					}
					<div id="error-container"></div>
				</form>
			</div>
		</main>
	}
}

templ RecoverSiteFailed(message string) {
	@alert.Alert(alert.Props{ID: "public--recover--error", Variant: alert.VariantError, Attributes: templ.Attributes{"role": "alert"}}) {
		{ message }
	}
}
