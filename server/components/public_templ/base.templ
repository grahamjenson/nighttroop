package public_templ

import (
	"nighttroop.t1d.nz/server/components/head"
	"nighttroop.t1d.nz/server/components/footer"
	"nighttroop.t1d.nz/server/components/testsite"
)

templ PublicBase() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@head.Common()
			<title>Nighttroop </title>
		</head>
		// As tall as the window, with the page's content filling what the footer leaves, so a page that fits needs no scrolling
		<body class="flex min-h-dvh flex-col">
			@testsite.Banner()
			<div
				id="main-content"
				class="flex flex-1 flex-col"
			>
				{ children... }
			</div>
			@footer.PublicFooter()
		</body>
	</html>
}
