// templui component copybutton - version: v1.11.2 installed by templui v1.11.2
// 📚 Documentation: https://templui.io/docs/components/copy-button
package copybutton

import (
	"maps"

	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/icon"
	"nighttroop.t1d.nz/utils/templui/utils"
)

type Props struct {
	ID       string           // Optional button ID
	Class    string           // Custom CSS classes
	Attrs    templ.Attributes // Additional HTML attributes
	TargetID string           // Required - ID of element to copy from
	// Label is required: what it does, such as "Copy the password", as its accessible name and tooltip, since it may
	// show only an icon. Its children, such as "Copy all", are shown beside the icon.
	Label string
}

templ CopyButton(props Props) {
	{{ var p = props }}
	if p.ID == "" {
		{{ p.ID = "copybutton-" + utils.RandomID() }}
	}
	{{ attributes := templ.Attributes{"aria-label": p.Label, "title": p.Label} }}
	{{ maps.Copy(attributes, p.Attrs) }}
	<div
		data-copy-button
		data-target-id={ p.TargetID }
		class="inline-block"
	>
		@button.Button(button.Props{
			ID:         p.ID,
			Class:      utils.TwMerge("h-7 w-7 text-muted-foreground hover:text-accent-foreground", p.Class),
			Attributes: attributes,
			Size:       button.SizeIcon,
			Variant:    button.VariantGhost,
			Type:       button.TypeButton,
		}) {
			<span data-copy-icon-clipboard>
				@icon.Clipboard(icon.Props{Class: "size-4"})
			</span>
			<span data-copy-icon-check class="hidden">
				@icon.Check(icon.Props{Class: "size-4"})
			</span>
			{ children... }
		}
	</div>
}

var scriptOnce = templ.NewOnceHandle()

templ Script() {
	@scriptOnce.Once() {
		@utils.ComponentScript("copybutton")
	}
}
