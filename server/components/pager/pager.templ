package pager

import (
	"fmt"
	"strconv"
	"strings"

	"nighttroop.t1d.nz/server/components/ui/button"
)

type Props struct {
	// ID names the parts: ID--showing, ID--previous and ID--next
	ID string
	// Path is the page's URL without skip and limit, which may have a query of its own
	Path  string
	Count int
	Skip  int64
	Limit int64
}

// Pager is under a table of one page of rows: which rows it shows, and buttons to the pages either side
templ Pager(p Props) {
	<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
		<span id={ p.ID + "--showing" } data-pager-skip={ strconv.FormatInt(p.Skip, 10) }>
			if p.Count > 0 {
				{ fmt.Sprintf("Showing %d to %d", p.Skip+1, p.Skip+int64(p.Count)) }
			}
		</span>
		<div class="flex gap-2">
			if p.Skip > 0 {
				@pageButton(p.ID+"--previous", "Previous", pageURL(p.Path, max(p.Skip-p.Limit, 0), p.Limit))
			}
			if int64(p.Count) == p.Limit {
				@pageButton(p.ID+"--next", "Next", pageURL(p.Path, p.Skip+p.Limit, p.Limit))
			}
		</div>
	</div>
}

// Empty is the last row of a table's body, saying it has no rows. It is always there, shown only while it is the only
// row, so it goes once a row is added and comes back once the last is deleted.
templ Empty(id string, columns int, text string) {
	<tr id={ id } data-empty class="hidden only:table-row"><td colspan={ strconv.Itoa(columns) } class="p-4 text-sm text-gray-500">{ text }</td></tr>
}

var scriptOnce = templ.NewOnceHandle()

// Script keeps a pager's "Showing" to the rows of the table above it, one with an Empty row, as rows are added or
// deleted without loading the page again
templ Script() {
	@scriptOnce.Once() {
		<script>
			(() => {
				const count = () => document.querySelectorAll("[data-pager-skip]").forEach((showing) => {
					const body = showing.closest("section")?.querySelector("tbody:has(> [data-empty])")
					if (!body) return
					const skip = Number(showing.dataset.pagerSkip), rows = body.querySelectorAll(":scope > tr:not([data-empty])").length
					const text = rows > 0 ? "Showing " + (skip + 1) + " to " + (skip + rows) : ""
					if (showing.textContent.trim() !== text) showing.textContent = text
				})
				// After the request's own handlers, such as one removing a deleted row
				for (const name of ["htmx:after:settle", "htmx:after:request"]) document.addEventListener(name, () => setTimeout(count))
			})()
		</script>
	}
}

templ pageButton(id string, label string, url string) {
	@button.Button(button.Props{
		ID:      id,
		Variant: button.VariantOutline,
		Attributes: templ.Attributes{
			"hx-get":      url,
			"hx-target":   "#main-content",
			"hx-push-url": "true",
			"hx-swap":     "innerHTML",
		},
	}) {
		{ label }
	}
}

func pageURL(path string, skip int64, limit int64) string {
	separator := "?"
	if strings.Contains(path, "?") {
		separator = "&"
	}
	return fmt.Sprintf("%s%sskip=%d&limit=%d", path, separator, skip, limit)
}
