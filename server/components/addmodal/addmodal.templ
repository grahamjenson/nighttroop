package addmodal

import (
	"slices"
	"strconv"
	"strings"

	"nighttroop.t1d.nz/server/components/modal"
	"nighttroop.t1d.nz/server/components/ui/button"
	"nighttroop.t1d.nz/server/components/ui/input"
	"nighttroop.t1d.nz/utils/consts"
	"nighttroop.t1d.nz/utils/i18n"
)

// Kind is how a field is typed in
type Kind int

const (
	Number Kind = iota
	Text
	// Select is one of its options, or none when it is not required
	Select
	// When is a date and time in the timezone times are shown in, or now when left blank
	When
	// Percent is a number typed in as a percent and sent as the fraction its model keeps, e.g. 120 as 1.2
	Percent
)

// MultiplierHelp is the message id of every percent multiplier's help, so they are all explained the same way
const MultiplierHelp = "common.add_modal.multiplier_help"

// percentsToFractions sends each Percent input's value as the fraction its model keeps, e.g. 120 as 1.2
const percentsToFractions = "for (const input of this.querySelectorAll('[data-percent]')) { const value = ctx.request.body.get(input.name); " +
	"if (value) ctx.request.body.set(input.name, Math.round(value * 100) / 10000) } "

// Field is one of a model's fields in its add modal
type Field struct {
	// Name is the model's JSON field, which the input is sent as
	Name  string
	Label string
	// Help says in a few words what it is
	Help     string
	Required bool
	Kind     Kind
	// Column is the table and field it is kept in, e.g. insulin_doses.Dose, whose limits, narrowed by limits.Overrides,
	// its input takes
	Column string
	// Step is a number's
	Step string
	// Units are what a column of glucose in mg/dL is typed in
	Units *consts.Units
	// Options are a select's choices, or a text's suggestions
	Options []string
	// OptionLabel shows a select's option as people read it, e.g. Meter for mbg, when set
	OptionLabel func(string) string
	// Value is what a number, text, select or time starts at
	Value string
	// Wide takes the whole row, for notes
	Wide bool
}

// Props is an add modal, posting its fields to Path and putting the row it answers with at the top of Target
type Props struct {
	// ID is the form's, and with "--" and a field's name, each input's, e.g. site--insulin--create--dose
	ID     string
	Title  string
	Path   string
	Target string
	Submit string
	Fields []Field
	// Swap is how the answer goes in Target, afterbegin when empty, e.g. outerHTML to replace an edited row
	Swap string
	// Extra is more of the form after its fields, such as inputs loaded for what is typed in them
	Extra templ.Component
}

// Open is the button opening the add modal at path in #modal-container, beside its page's title
templ Open(id string, path string, label string) {
	@button.Button(button.Props{ID: id, Attributes: templ.Attributes{"hx-get": path, "hx-target": "#modal-container", "hx-swap": "innerHTML"}}) {
		{ label }
	}
}

// Modal adds a record with all its fields, each saying what it is and whether it is required. It closes once the record
// is added, and an error goes to the toaster, leaving it open to fix.
templ Modal(p Props) {
	@modal.Modal(modal.Props{ID: p.ID + "--modal", Title: p.Title, Subtitle: i18n.T(ctx, "common.add_modal.subtitle"), Actions: SubmitButton(p)}) {
		@Form(p)
	}
}

// Form is the modal's form on its own, to edit a record in its details modal, with its Edit fields, beside a
// SubmitButton
templ Form(p Props) {
	<form
		id={ p.ID }
		class="grid gap-x-4 gap-y-3 py-4 sm:grid-cols-2"
		hx-post={ p.Path }
		hx-target={ p.Target }
		hx-swap={ swap(p) }
		hx-status:4xx="target:#toaster swap:beforeend"
		hx-status:5xx="target:#toaster swap:beforeend"
		{ formHandlers(p)... }
	>
		for _, f := range p.Fields {
			@field(p, f)
		}
		if p.Extra != nil {
			<div class="sm:col-span-2">
				@p.Extra
			</div>
		}
	</form>
}

func swap(p Props) string {
	if p.Swap == "" {
		return "afterbegin"
	}
	return p.Swap
}

// formHandlers leave out the fields left blank, so they are not set rather than empty, but for a text that started
// with a value, so emptying it in an edit form clears it. Then once a record is added, empty the modal container; an
// edit's answer closes its details itself, giving the focus back to its row. Only the form's own request closes it,
// not one of an input's within it, like loading what can be picked. A table's pager.Empty row hides itself once a row
// is added.
func formHandlers(p Props) templ.Attributes {
	handlers := templ.Attributes{
		"hx-on::config:request": templ.JSUnsafeFuncCall(percentsToFractions + "for (const [name, value] of [...ctx.request.body]) { if (value === '' && !this.elements[name]?.defaultValue) ctx.request.body.delete(name) }"),
	}
	if p.Swap == "" {
		handlers["hx-on::after:request"] = templ.JSUnsafeFuncCall("if (event.target === this && ctx.response.status < 400) { document.getElementById('modal-container').innerHTML = '' }")
	}
	return handlers
}

// SubmitButton submits the form, from outside it, as in a modal's actions
templ SubmitButton(p Props) {
	@button.Button(button.Props{ID: p.ID + "--submit", Type: button.TypeSubmit, Attributes: templ.Attributes{"form": p.ID}}) {
		{ p.Submit }
	}
}

// Detail is a record's field, by its JSON name, in its details modal's list below the edit form p, left out when p
// has the field, so each is shown once, or when it has no value
templ Detail(p Props, name string, label string, value string) {
	if !slices.ContainsFunc(p.Fields, func(f Field) bool { return f.Name == name }) {
		@modal.DetailIfSet(label, value)
	}
}

templ field(p Props, f Field) {
	{{ id := p.ID + "--" + strings.ReplaceAll(f.Name, "_", "-") }}
	<div class={ templ.KV("sm:col-span-2", f.Wide) }>
		<label for={ id } class="mb-1 flex items-baseline justify-between text-sm font-medium text-gray-700">
			{ f.Label }
			if f.Required {
				<span class="text-xs font-semibold text-primary">{ i18n.T(ctx, "common.add_modal.required") }</span>
			} else {
				<span class="text-xs font-normal text-gray-400">{ i18n.T(ctx, "common.add_modal.optional") }</span>
			}
		</label>
		switch f.Kind {
			case Select:
				<select id={ id } name={ f.Name } required?={ f.Required } class="h-9 w-full rounded-md border border-gray-200 bg-white px-3 text-sm">
					if !f.Required {
						<option value="">{ i18n.T(ctx, "common.add_modal.none") }</option>
					}
					if f.Value != "" && !slices.Contains(f.Options, f.Value) {
						<option value={ f.Value } selected>{ optionLabel(f, f.Value) }</option>
					}
					for _, option := range f.Options {
						<option value={ option } selected?={ option == f.Value }>{ optionLabel(f, option) }</option>
					}
				</select>
			case When:
				@input.Input(input.Props{ID: id, Name: f.Name, Type: input.TypeDateTime, Value: f.Value})
			case Number, Percent:
				@input.Input(input.Props{ID: id, Name: f.Name, Type: input.TypeNumber, Value: f.Value, Required: f.Required, Attributes: numberAttributes(f)})
			default:
				@input.Input(input.Props{ID: id, Name: f.Name, Value: f.Value, Required: f.Required, Attributes: textAttributes(f, id)})
				if len(f.Options) > 0 {
					<datalist id={ id + "--options" }>
						for _, option := range f.Options {
							<option value={ option }></option>
						}
					</datalist>
				}
		}
		<p class="mt-1 text-xs text-gray-500">{ f.Help }</p>
	</div>
}

// optionLabel is a select's option as people read it, or as it is when the field has no OptionLabel
func optionLabel(f Field, option string) string {
	if f.OptionLabel == nil {
		return option
	}
	return f.OptionLabel(option)
}

// textAttributes limit a text's length, and point it at its suggestions when it has some
func textAttributes(f Field, id string) templ.Attributes {
	attributes, limit := templ.Attributes{}, f.limit()
	if limit.MaxLength > 0 {
		attributes["maxlength"] = strconv.Itoa(limit.MaxLength)
	}
	if limit.MinLength > 0 {
		attributes["minlength"] = strconv.Itoa(limit.MinLength)
	}
	if len(f.Options) > 0 {
		attributes["list"] = id + "--options"
	}
	return attributes
}
