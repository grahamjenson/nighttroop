<div id="rate-limit-alert" class="alert alert-warning border-0 shadow-sm mt-3" role="alert" hx-on:load="
        let span = this.querySelector('.countdown-num');
        let timer = setInterval(() => {
            let count = parseInt(span.innerText);
            if (count <= 1) {
                clearInterval(timer);
                this.remove(); // Auto-remove the error when time is up
            } else {
                span.innerText = count - 1;
            }
        }, 1000);
     ">
    <div class="d-flex align-items-center justify-content-center">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        <span>
            Too many requests. Please wait
            <strong class="countdown-num text-danger">{{ .seconds }}</strong>
            seconds.
        </span>
    </div>
</div>